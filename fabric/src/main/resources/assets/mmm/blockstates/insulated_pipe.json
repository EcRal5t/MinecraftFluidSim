        "south": "none"
      },
      "apply": {
        "model": "mmm:block/insulated_pipe_cap_south"
      }
    },
    {
      "when": {
        "OR": [
          {
            "west": "none"
          },
          {
            "west": "open"
          },
          {
            "west": "connected"
          }
        ]
      },
      "apply": {
        "model": "mmm:block/insulated_pipe_arm_west"
      }
    },
    {
      "when": {
        "west": "sealed"
      },
      "apply": {
