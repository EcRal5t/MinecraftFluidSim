{
  "multipart": [
    {
      "apply": {
        "model": "mmm:block/insulated_pipe_frame"
      }
    },
    {
      "when": {
        "OR": [
          {
            "down": "none"
          },
          {
            "down": "open"
          },
          {
            "down": "connected"
          }
        ]
      },
      "apply": {
        "model": "mmm:block/insulated_pipe_arm_down"
      }
    },
    {
      "when": {
        "down": "sealed"
      },
      "apply": {
        "model": "mmm:block/insulated_pipe_sealed_down"
      }
    },
    {
      "when": {
        "down": "none"
      },
      "apply": {
        "model": "mmm:block/insulated_pipe_cap_down"
      }
    },
    {
      "when": {
        "OR": [
          {
            "up": "none"
          },
          {
            "up": "open"
          },
          {
            "up": "connected"
          }
        ]
      },
      "apply": {
