#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

const int STAGE_MEASURE_CELL_VOLUMES = 0;
const uint ERROR_INVALID_VOLUME = 32u;
const uint ERROR_INSUFFICIENT_CAPACITY = 64u;
// HOST_LAYOUT
const int MEASUREMENT_WORDS = 8;
const int MEASURE_MINIMUM_EXPONENT = 0;
const int MEASURE_FIRST_WORD = 1;
const int MEASURE_LAST_WORD = 2;
const int MEASURE_TRAILING_BITS = 3;
const int MEASURE_LIMIT = 4;
const int MEASURE_SIGNIFICAND_BITS = 5;
const int MEASURE_WORD_COUNT = 6;
const int MEASURE_EXPONENT = 7;
layout(local_size_x=128) in;
layout(binding=0,std430) readonly buffer Source { uint sourceWords[]; };
layout(binding=1,std430) buffer Candidate { uint candidateWords[]; };
layout(binding=2,std430) buffer Errors { uint errors; };
layout(push_constant) uniform Params { int header; int stage; int count; } p;
int h(int index) { return int(candidateWords[p.header+index]); }
struct Volume { int offset; int count; int exponent; };
Volume volume(int stock) {
    int first=int(sourceWords[h(H_SOURCE_VOLUME_OFFSETS)+stock]);
    return Volume(h(H_SOURCE_VOLUME_LIMBS)+first,int(sourceWords[h(H_SOURCE_VOLUME_COUNTS)+stock]),int(sourceWords[h(H_SOURCE_VOLUME_EXPONENTS)+stock]));
}
uint aligned(Volume item,int position,int minimum) {
    int64_t shift=int64_t(item.exponent)-int64_t(minimum);
    int relative=position-int(shift>>5),bits=int(shift&int64_t(31));uint result=0u;
    if(relative>=0&&relative<item.count)result=sourceWords[item.offset+relative]<<bits;
    if(bits!=0&&relative>0&&relative<=item.count)result|=sourceWords[item.offset+relative-1]>>(32-bits);
    return result;
}
// Returns one accumulated word, or jumps across a wholly empty exponent interval.
// At most INT_MAX positive inputs make word sums plus carry strictly smaller than 2^63.
uint nextWord(int first,int last,int minimum,int limit,inout int position,inout uint64_t carry,out int runLength) {
    int next=limit;bool covered=false;uint64_t sum=carry;
    for(int stock=first;stock<last;stock++) {
        if(sourceWords[h(H_SOURCE_VOLUME_COUNTS)+stock]==0u)continue;
        Volume item=volume(stock);int64_t shift=int64_t(item.exponent)-int64_t(minimum);
        int begin=int(shift>>5),end=begin+item.count+((shift&int64_t(31))!=int64_t(0)?1:0);
        if(position<begin)next=min(next,begin);
        else if(position<end){covered=true;sum+=uint64_t(aligned(item,position,minimum));}
    }
    if(!covered&&carry==uint64_t(0)){runLength=next-position;position=next;return 0u;}
    runLength=1;position++;carry=sum>>32;return uint(sum);
}
// Measure the exact sum of stock volumes in one cell before the prefix scan.
void measureCell(int cell) {
    candidateWords[h(H_COUNTS)+cell]=0u;candidateWords[h(H_TOTAL_SIGNS)+cell]=0u;candidateWords[h(H_TOTAL_EXPONENTS)+cell]=0u;
    candidateWords[h(H_QUANTIZED)+2*cell]=0u;candidateWords[h(H_QUANTIZED)+2*cell+1]=0u;
    int metadata=h(H_MEASUREMENTS)+MEASUREMENT_WORDS*cell;candidateWords[metadata+MEASURE_WORD_COUNT]=0u;
    if(errors!=0u)return;
    int first=int(sourceWords[h(H_SOURCE_CELL_OFFSETS)+cell]),last=int(sourceWords[h(H_SOURCE_CELL_OFFSETS)+cell+1]);
    int minimum=2147483647;bool present=false;
    for(int stock=first;stock<last;stock++) {
        int limbCount=int(sourceWords[h(H_SOURCE_VOLUME_COUNTS)+stock]);
        if(limbCount<0){atomicOr(errors,ERROR_INVALID_VOLUME);return;}
        if(limbCount>0){minimum=min(minimum,volume(stock).exponent);present=true;}
    }
    if(!present)return;
    int limit=0;
    for(int stock=first;stock<last;stock++)if(sourceWords[h(H_SOURCE_VOLUME_COUNTS)+stock]!=0u) {
        Volume item=volume(stock);int64_t shift=int64_t(item.exponent)-int64_t(minimum);
        limit=max(limit,int(shift>>5)+item.count+((shift&int64_t(31))!=int64_t(0)?1:0));
    }
    // One extra 32-bit word holds the carry from up to INT_MAX stock summands.
    limit++;int position=0,firstWord=-1,lastWord=-1,trailing=0;uint top=0u;uint64_t carry=uint64_t(0);
    while(position<limit) {
        int at=position,run;uint value=nextWord(first,last,minimum,limit,position,carry,run);
        if(value!=0u){if(firstWord<0){firstWord=at;trailing=findLSB(value);}lastWord=at;top=value;}
    }
    if(firstWord<0)return;
    int64_t bits=int64_t(lastWord-firstWord)*int64_t(32)+int64_t(findMSB(top)-trailing+1);
    int64_t exponent=int64_t(minimum)+int64_t(firstWord)*int64_t(32)+int64_t(trailing);
    if(bits>int64_t(32768)||exponent<int64_t(-2147483647)-int64_t(1)||exponent>int64_t(2147483647)) {
        atomicOr(errors,ERROR_INVALID_VOLUME);return;
    }
    int words=int((bits+int64_t(31))>>5);
    candidateWords[metadata+MEASURE_MINIMUM_EXPONENT]=uint(minimum);candidateWords[metadata+MEASURE_FIRST_WORD]=uint(firstWord);
    candidateWords[metadata+MEASURE_LAST_WORD]=uint(lastWord);candidateWords[metadata+MEASURE_TRAILING_BITS]=uint(trailing);
    candidateWords[metadata+MEASURE_LIMIT]=uint(limit);candidateWords[metadata+MEASURE_SIGNIFICAND_BITS]=uint(bits);candidateWords[metadata+MEASURE_WORD_COUNT]=uint(words);
    candidateWords[metadata+MEASURE_EXPONENT]=uint(exponent);
    candidateWords[h(H_COUNTS)+cell]=uint(words);
}
uint resultWord(int outputOffset,int count,int relative) {
    return relative>=0&&relative<count?candidateWords[outputOffset+relative]:0u;
}
// Round the cell volume up to the capacity quantum; exponents are powers of two.
void quantize(int cell,int outputOffset,int words,int bits,int exponent) {
    int64_t highest=int64_t(exponent)+int64_t(bits)-int64_t(1),quantum=int64_t(h(H_QUANTUM_EXPONENT));
    // The final fractional quantum reserves capacity and travels with its stock.
    if(highest<quantum){candidateWords[h(H_QUANTIZED)+2*cell]=1u;return;}
    if(highest-quantum>=int64_t(63)){atomicOr(errors,ERROR_INVALID_VOLUME);return;}
    int64_t shift=quantum-int64_t(exponent);uint64_t result;
    if(shift<=int64_t(0)) {
        result=uint64_t(resultWord(outputOffset,words,0))|(uint64_t(resultWord(outputOffset,words,1))<<32);
        result<<=int(-shift);
    } else {
        int first=int(shift>>5),offset=int(shift&int64_t(31));
        uint low=resultWord(outputOffset,words,first),middle=resultWord(outputOffset,words,first+1);
        result=(uint64_t(low)|(uint64_t(middle)<<32))>>offset;
        if(offset!=0)result|=uint64_t(resultWord(outputOffset,words,first+2))<<(64-offset);
    }
    if(exponent<h(H_QUANTUM_EXPONENT))result++;
    candidateWords[h(H_QUANTIZED)+2*cell]=uint(result);candidateWords[h(H_QUANTIZED)+2*cell+1]=uint(result>>32);
}
// Write the exact cell volume into the offsets allocated by the prefix scan.
void writeCell(int cell) {
    if(errors!=0u)return;
    if(candidateWords[h(H_TOTAL_OFFSETS)+h(H_CELL_COUNT)]>uint(h(H_LIMB_CAPACITY))){atomicOr(errors,ERROR_INSUFFICIENT_CAPACITY);return;}
    int metadata=h(H_MEASUREMENTS)+MEASUREMENT_WORDS*cell,words=int(candidateWords[metadata+MEASURE_WORD_COUNT]);if(words==0)return;
    int minimum=int(candidateWords[metadata+MEASURE_MINIMUM_EXPONENT]),firstWord=int(candidateWords[metadata+MEASURE_FIRST_WORD]),lastWord=int(candidateWords[metadata+MEASURE_LAST_WORD]);
    int trailing=int(candidateWords[metadata+MEASURE_TRAILING_BITS]),limit=int(candidateWords[metadata+MEASURE_LIMIT]);
    int first=int(sourceWords[h(H_SOURCE_CELL_OFFSETS)+cell]),last=int(sourceWords[h(H_SOURCE_CELL_OFFSETS)+cell+1]);
    int outputOffset=h(H_TOTAL_LIMBS)+int(candidateWords[h(H_TOTAL_OFFSETS)+cell]);
    int position=0;uint previous=0u;uint64_t carry=uint64_t(0);
    while(position<=lastWord) {
        int at=position,run;uint value=nextWord(first,last,minimum,limit,position,carry,run);
        int begin=max(firstWord,at),end=min(lastWord,at+run-1);
        for(int index=begin;index<=end;index++) {
            int relative=index-firstWord;
            if(trailing==0)candidateWords[outputOffset+relative]=value;
            else if(relative>0)candidateWords[outputOffset+relative-1]=(previous>>trailing)|(value<<(32-trailing));
            previous=value;
        }
    }
    if(trailing!=0&&lastWord-firstWord<words)candidateWords[outputOffset+words-1]=previous>>trailing;
    int exponent=int(candidateWords[metadata+MEASURE_EXPONENT]);candidateWords[h(H_TOTAL_SIGNS)+cell]=1u;candidateWords[h(H_TOTAL_EXPONENTS)+cell]=uint(exponent);
    quantize(cell,outputOffset,words,int(candidateWords[metadata+MEASURE_SIGNIFICAND_BITS]),exponent);
}
void main() {
    uint id=(gl_WorkGroupID.y*gl_NumWorkGroups.x+gl_WorkGroupID.x)*128u+gl_LocalInvocationID.x;
    if(id>=uint(p.count))return;
    if(p.stage==STAGE_MEASURE_CELL_VOLUMES)measureCell(int(id));else writeCell(int(id));
}
