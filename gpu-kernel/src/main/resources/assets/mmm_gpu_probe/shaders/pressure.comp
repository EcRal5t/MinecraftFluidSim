#version 450
#extension GL_ARB_gpu_shader_fp64 : require
// HOST_LAYOUT
layout(local_size_x=256) in;
layout(binding=0,std430) readonly buffer Starts { int starts[]; };
layout(binding=1,std430) readonly buffer Columns { int columns[]; };
layout(binding=2,std430) readonly buffer Values { double values[]; };
layout(binding=3,std430) readonly buffer Rows { int rows[]; };
layout(binding=4,std430) buffer Pressure { precise double pressure[]; };
layout(binding=5,std430) buffer Workspace { precise double work[]; };
layout(binding=6,std430) readonly buffer Problem { double problem[]; };
layout(binding=7,std430) buffer Control { double control[]; };
layout(binding=8,std430) buffer Partials { double partials[]; };
layout(binding=9,std430) buffer Completion { uint errors; };
layout(binding=10,std430) buffer StageDispatch { uvec4 stageDispatch[]; };
layout(push_constant) uniform Params { int count; int size; int maximumIterations; int stage; int groups; int externalPreconditioner; int liquidCount; int matrixFreeFromRow; } p;
shared dvec4 scratch[256];
int lane,n,gid,stride,group,groupCount;
#define R(row) work[row]
#define D(row) work[n+(row)]
#define Q(row) work[2*n+(row)]
#define Z(row) work[3*n+(row)]
#define DIAG(row) work[4*n+(row)]
#define RHS(row) problem[row]
#define TARGET problem[2*n]
#define ITER control[CONTROL_ITERATION]
#define RMS control[CONTROL_RESIDUAL_RMS]
#define SUCCESS control[CONTROL_SUCCESS]
#define RUN control[CONTROL_RUN]
#define RZ control[CONTROL_RESIDUAL_DOT_PRECONDITIONED]
#define ALPHA control[CONTROL_STEP_LENGTH]
#define RESTART control[CONTROL_RESTART]
#define REFRESH control[CONTROL_REFRESH]
#define BETA control[CONTROL_DIRECTION_SCALE]
#define TOLERANCE control[CONTROL_TOLERANCE]
#define PMAX control[CONTROL_MAX_PRESSURE]
#define RESIDUAL_REFRESHES control[CONTROL_RESIDUAL_REFRESHES]
void syncAll(){memoryBarrierBuffer();barrier();}
bool finite(double value){return !isnan(value)&&!isinf(value);}
double hypotStable(double a,double b){
    double high=max(abs(a),abs(b)),low=min(abs(a),abs(b));
    if(isinf(high))return high;if(high==0.0)return 0.0;
    precise double ratio=low/high;return high*sqrt(1.0+ratio*ratio);
}
dvec4 reduceStats(dvec4 value){
    scratch[lane]=value;barrier();
    for(int offset=128;offset>0;offset/=2){if(lane<offset){dvec4 a=scratch[lane],b=scratch[lane+offset];
        scratch[lane]=dvec4(a.x+b.x,a.y+b.y,hypotStable(a.z,b.z),max(a.w,b.w));}barrier();}
    dvec4 answer=scratch[0];barrier();return answer;
}
void saveStats(double a,double b,double c,double d){
    dvec4 result=reduceStats(dvec4(a,b,c,d));
    if(lane==0)for(int column=0;column<4;column++)partials[4*group+column]=result[column];
}
dvec4 collectStats(){
    if(groupCount==1)return dvec4(partials[0],partials[1],partials[2],partials[3]);
    precise dvec4 value=dvec4(0.0);
    for(int block=lane;block<groupCount;block+=256){dvec4 next=dvec4(partials[4*block],partials[4*block+1],partials[4*block+2],partials[4*block+3]);
        value=dvec4(value.x+next.x,value.y+next.y,hypotStable(value.z,next.z),max(value.w,next.w));}
    return reduceStats(value);
}
void initializeRows(){
    for(int row=gid;row<n;row+=stride){
        pressure[row]=problem[n+row];R(row)=0.0;D(row)=0.0;Q(row)=0.0;Z(row)=0.0;
        double diagonal=0.0;for(int edge=starts[row];edge<starts[row+1];edge++)if(columns[edge]==row)diagonal+=values[edge];DIAG(row)=diagonal;
    }
    double maximum=0.0;for(int row=gid;row<p.count;row+=stride)if(rows[row]>=0)maximum=max(maximum,abs(pressure[rows[row]]));
    saveStats(0.0,0.0,0.0,maximum);
}
void initializeControl(){
    dvec4 stats=collectStats();if(gid!=0)return;
    ITER=0.0;SUCCESS=0.0;RUN=1.0;RZ=0.0;ALPHA=0.0;RESTART=1.0;REFRESH=1.0;BETA=0.0;
    TOLERANCE=TARGET;PMAX=stats.w;RESIDUAL_REFRESHES=0.0;
}
void refreshResidual(){
    if(REFRESH==0.0)return;
    precise double sum=0.0;double equations=0.0,boundNorm=0.0;
    for(int ordinal=gid;ordinal<p.count;ordinal+=stride){
        int row=rows[ordinal];if(row<0)continue;precise double product=row>=p.matrixFreeFromRow?Q(row):0.0;
        if(row<p.matrixFreeFromRow)for(int edge=starts[row];edge<starts[row+1];edge++)product+=values[edge]*pressure[columns[edge]];
        double value=RHS(row)-product;R(row)=value;equations+=1.0;sum+=value*value;
        boundNorm=hypotStable(boundNorm,abs(RHS(row))+2.0*DIAG(row)*PMAX);
    }
    saveStats(sum,equations,boundNorm,0.0);
}
void finishRefresh(){
    if(REFRESH==0.0)return;dvec4 stats=collectStats();if(gid!=0)return;
    RESIDUAL_REFRESHES+=1.0;RMS=sqrt(stats.x/max(1.0,stats.y));RESTART=1.0;REFRESH=0.0;
    precise double floorValue=(stats.y+8.0)*2.220446049250313e-16*0.5*stats.z/sqrt(max(1.0,stats.y));
    TOLERANCE=finite(floorValue)?max(TARGET,floorValue):TARGET;
    if(RMS<=TOLERANCE){SUCCESS=1.0;RUN=0.0;}
}
void precondition(){
    if(RUN==0.0)return;precise double sum=0.0;
    for(int ordinal=gid;ordinal<p.count;ordinal+=stride){int row=rows[ordinal];if(row<0)continue;
        if(p.externalPreconditioner==0||row>=p.liquidCount)Z(row)=R(row)/DIAG(row);
        if(RESTART!=0.0)D(row)=Z(row);sum+=R(row)*Z(row);}
    saveStats(sum,0.0,0.0,0.0);
}
void finishPrecondition(){
    if(RUN==0.0)return;dvec4 stats=collectStats();if(gid!=0)return;
    double next=stats.x;BETA=RESTART!=0.0?0.0:next/RZ;RZ=next;
}
void updateDirection(){
    if(RUN==0.0||RESTART!=0.0)return;
    for(int ordinal=gid;ordinal<p.count;ordinal+=stride){int row=rows[ordinal];if(row>=0)D(row)=Z(row)+BETA*D(row);}
}
void directionProduct(){
    if(RUN==0.0)return;precise double sum=0.0;
    for(int ordinal=gid;ordinal<p.count;ordinal+=stride){int row=rows[ordinal];if(row<0)continue;
        precise double product=row>=p.matrixFreeFromRow?Q(row):0.0;
        if(row<p.matrixFreeFromRow)for(int edge=starts[row];edge<starts[row+1];edge++)product+=values[edge]*D(columns[edge]);
        Q(row)=product;sum+=D(row)*product;}
    saveStats(sum,0.0,0.0,0.0);
}
void finishProduct(){
    if(RUN==0.0)return;dvec4 stats=collectStats();if(gid!=0)return;double denominator=stats.x;
    if(!(denominator>0.0&&finite(denominator)&&RZ>0.0&&finite(RZ))){atomicOr(errors,4u);RUN=0.0;return;}
    ALPHA=RZ/denominator;
}
void updateSolution(){
    if(RUN==0.0)return;precise double sum=0.0;double equations=0.0,maximum=0.0;
    for(int ordinal=gid;ordinal<p.count;ordinal+=stride){int row=rows[ordinal];if(row<0)continue;
        pressure[row]+=ALPHA*D(row);R(row)-=ALPHA*Q(row);maximum=max(maximum,abs(pressure[row]));
        equations+=1.0;sum+=R(row)*R(row);}
    saveStats(sum,equations,0.0,maximum);
}
void finishUpdate(){
    if(RUN==0.0)return;dvec4 stats=collectStats();if(gid!=0)return;
    ITER+=1.0;RMS=sqrt(stats.x/max(1.0,stats.y));PMAX=stats.w;RESTART=0.0;REFRESH=RMS<=TARGET?1.0:0.0;
    if(ITER>=double(p.maximumIterations)){RUN=0.0;REFRESH=1.0;}
}
void executeStage(int stage){
    if(stage==STAGE_INITIALIZE_ROWS)initializeRows();else if(stage==STAGE_INITIALIZE_CONTROL)initializeControl();
    else if(stage==STAGE_REFRESH_RESIDUAL)refreshResidual();else if(stage==STAGE_FINISH_REFRESH)finishRefresh();
    else if(stage==STAGE_PRECONDITION)precondition();else if(stage==STAGE_FINISH_PRECONDITION)finishPrecondition();
    else if(stage==STAGE_UPDATE_DIRECTION)updateDirection();else if(stage==STAGE_DIRECTION_PRODUCT)directionProduct();
    else if(stage==STAGE_FINISH_PRODUCT)finishProduct();else if(stage==STAGE_UPDATE_SOLUTION)updateSolution();
    else if(stage==STAGE_FINISH_UPDATE)finishUpdate();else if(stage==STAGE_FINALIZE_CONTROL&&gid==0){REFRESH=1.0;SUCCESS=0.0;}
    else if(stage==STAGE_CHECK_SUCCESS&&gid==0&&SUCCESS==0.0)atomicOr(errors,4u);
    else if(stage==STAGE_CHECK_MECHANICAL){for(int ordinal=gid;ordinal<p.count;ordinal+=stride){int row=rows[ordinal];
        if(row>=0&&(!finite(pressure[row])||!finite(RHS(row))||(row<p.matrixFreeFromRow&&(!(DIAG(row)>0.0)||!finite(DIAG(row))))))atomicOr(errors,4u);}
        if(gid==0&&!finite(RMS))atomicOr(errors,4u);}
}
void singleStage(int stage){executeStage(stage);syncAll();}
void publishDispatches(){
    if(gid!=0)return;uint groups=uint(groupCount);
    stageDispatch[STAGE_REFRESH_RESIDUAL]=uvec4(REFRESH!=0.0?groups:0u,1u,1u,0u);
    stageDispatch[STAGE_PRECONDITION]=uvec4(RUN!=0.0?groups:0u,1u,1u,0u);
    stageDispatch[STAGE_UPDATE_DIRECTION]=uvec4(RUN!=0.0&&RESTART==0.0?groups:0u,1u,1u,0u);
    stageDispatch[STAGE_DIRECTION_PRODUCT]=uvec4(RUN!=0.0?groups:0u,1u,1u,0u);
    stageDispatch[STAGE_UPDATE_SOLUTION]=uvec4(RUN!=0.0?groups:0u,1u,1u,0u);
}
void main(){
    lane=int(gl_LocalInvocationID.x);n=p.size;group=int(gl_WorkGroupID.x);groupCount=p.groups;gid=group*256+lane;stride=groupCount*256;
    if(p.stage>=0){executeStage(p.stage);if(p.stage==STAGE_INITIALIZE_CONTROL||p.stage==STAGE_FINISH_REFRESH||p.stage==STAGE_FINISH_PRECONDITION||p.stage==STAGE_FINISH_PRODUCT||p.stage==STAGE_FINISH_UPDATE||p.stage==STAGE_FINALIZE_CONTROL)publishDispatches();return;}
    for(int stage=STAGE_INITIALIZE_ROWS;stage<=STAGE_UPDATE_DIRECTION;stage++)singleStage(stage);
    while(RUN!=0.0&&ITER<double(p.maximumIterations)){
        for(int stage=STAGE_DIRECTION_PRODUCT;stage<=STAGE_FINISH_UPDATE;stage++)singleStage(stage);
        for(int stage=STAGE_REFRESH_RESIDUAL;stage<=STAGE_UPDATE_DIRECTION;stage++)singleStage(stage);
    }
    singleStage(STAGE_FINALIZE_CONTROL);singleStage(STAGE_REFRESH_RESIDUAL);singleStage(STAGE_FINISH_REFRESH);singleStage(STAGE_CHECK_SUCCESS);
}
