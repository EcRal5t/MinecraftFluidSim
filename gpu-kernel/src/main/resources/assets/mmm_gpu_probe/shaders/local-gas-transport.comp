#version 450
#extension GL_ARB_gpu_shader_fp64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_atomic_int64 : require
layout(local_size_x=128) in;
layout(binding=0,std430) buffer Arena { uint words[]; };
layout(binding=0,std430) buffer LongArena { int64_t longs[]; };
layout(binding=1,std430) buffer Errors { uint errors; };
layout(push_constant) uniform Push { int header; int stage; int count; uint valueLow; uint valueHigh; } p;
// HOST_LAYOUT
// LOCAL_GAS_GRID
const uint ERROR_LOCAL_GAS_TRANSPORT=8388608u;
const int H_SOURCE_EOS=3;
const uint64_t SCALE=uint64_t(0x10000000000000UL),LIMIT=uint64_t(0x7fffffffffffffffUL);
int headerWord(int i){return int(words[p.header+i]);}
int sourceEosWord(int i){return int(words[headerWord(3)+i]);}
int field(int i){return headerWord(64+i);}
int gasField(int i){return headerWord(16+i);}
uint64_t quantity(int at){return uint64_t(words[at])|(uint64_t(words[at+1])<<32);}
int64_t signedQuantity(int at){return int64_t(quantity(at));}
void putQuantity(int at,uint64_t x){words[at]=uint(x);words[at+1]=uint(x>>32);}
double readDouble(int at){return packDouble2x32(uvec2(words[at],words[at+1]));}
void putDouble(int at,double x){uvec2 bits=unpackDouble2x32(x);words[at]=bits.x;words[at+1]=bits.y;}
bool isFinite(double x){return !isnan(x)&&!isinf(x);}
void reportInvalid(){atomicOr(errors,ERROR_LOCAL_GAS_TRANSPORT);}
uint64_t plus(uint64_t a,uint64_t b){if(b>LIMIT-a){reportInvalid();return a;}return a+b;}
int64_t signedPlus(int64_t a,int64_t b){int64_t maxValue=int64_t(LIMIT),minValue=-maxValue-int64_t(1);if((b>int64_t(0)&&a>maxValue-b)||(b<int64_t(0)&&a<minValue-b)){reportInvalid();return a;}return a+b;}
// GAS_INTEGER_QUANTITIES
// GAS_CALORIC_MATERIAL
void exactAdd(double a,double b,out double sum,out double remainder){
    precise double next=a+b,virtualValue=next-a;
    precise double error=(a-(next-virtualValue))+(b-virtualValue);
    sum=next;remainder=error;
}
int routePart(int cell,int side){return localGasRouteIndex(cell,0,side,headerWord(0),1);}
int componentPart(int cell,int component,int side){return localGasRouteIndex(cell,component,side,headerWord(0),headerWord(1));}
int speciesPart(int cell,int species,int side){return localGasRouteIndex(cell,species,side,headerWord(0),headerWord(2));}
int routeTarget(int cell,int side,ivec3 size){return int(words[headerWord(4)+6*cell+side]);}
bool sourceClosing(int cell){return headerWord(57)>=0&&headerWord(58)>=0&&
    (int64_t(bitCount((~words[headerWord(57)+cell])&255u))<<21)==signedQuantity(headerWord(58)+2*cell);}
bool externalRoute(int cell,int side,ivec3 size){
    int target=routeTarget(cell,side,size);
    return target==-2 || (target==-1 && localGasNeighbor(cell,side,size)<0 && headerWord(5)==0 && !sourceClosing(cell));
}
int inboundCount(int cell){return int(words[headerWord(14)+cell+1]-words[headerWord(14)+cell]);}
int inboundSource(int cell,int index,ivec3 size){return int(words[headerWord(15)+int(words[headerWord(14)+cell])+index]);}
int inboundSide(int cell,int index){return int(words[headerWord(49)+int(words[headerWord(14)+cell])+index]);}
uint64_t ambientData(int i){return quantity(field(F_AMBIENT_DATA)+2*i);}
uint64_t ambientComponent(uint64_t n,int component){
    int count=headerWord(6);
    for(int i=0;i<count;i++)if(int(ambientData(i))==component)
        return portion(n,ambientData(count+i),quantity(p.header+8));
    return uint64_t(0);
}
int ambientIndex(int component){for(int i=0;i<headerWord(6);i++)if(int(ambientData(i))==component)return i;return -1;}
uint64_t ambientSpecies(uint64_t n,int component,int handle){
    int count=headerWord(6),sc=headerWord(7),a=ambientIndex(component);if(a<0)return uint64_t(0);
    int first=int(ambientData(4*count+a)),last=int(ambientData(4*count+a+1)),base=5*count+1;
    for(int j=first;j<last;j++)if(int(ambientData(base+j))==handle)
        return portion(n,ambientData(base+sc+j),ambientData(base+2*sc+j));
    return uint64_t(0);
}
uint64_t ambientMass(uint64_t n,int component){int count=headerWord(6),a=ambientIndex(component);return a<0?uint64_t(0):portion(n,ambientData(2*count+a),ambientData(3*count+a));}
int64_t ambientResidual(uint64_t n,int component,uint64_t mass){
    int count=headerWord(6),sc=headerWord(7),a=ambientIndex(component);if(a<0)return int64_t(0);
    int first=int(ambientData(4*count+a)),last=int(ambientData(4*count+a+1)),base=5*count+1;int64_t result=int64_t(mass);
    for(int j=first;j<last;j++)result-=int64_t(portion(n,ambientData(base+sc+j),ambientData(base+2*sc+j))*ambientData(base+3*sc+j));
    return result;
}
void split(int cell){
    int cells=headerWord(0),components=headerWord(1),stride=headerWord(2);
    double dt=packDouble2x32(uvec2(p.valueLow,p.valueHigh)),volume=readDouble(headerWord(48)+2*(7*cell+2)),temperature=readDouble(sourceEosWord(GAS_H_STATES)+18*cell);
    putDouble(field(F_OLD_VOLUME)+2*cell,volume);
    ivec3 size=ivec3(headerWord(60),headerWord(61),headerWord(62));
    bool closing=sourceClosing(cell);
    double outflow[6],energy[6],totalOut=0.0;uint64_t weights[6],moved[6];
    for(int side=0;side<6;side++){
        int face=localGasFace(cell,side,size),other=localGasNeighbor(cell,side,size);
        double velocity=readDouble(headerWord(51)+2*face*headerWord(59));
        double h=readDouble(p.header+12),open=readDouble(headerWord(52)+2*(headerWord(59)*face+2));
        double area=open*h*h;
        int target=routeTarget(cell,side,size);
        bool routeEnabled=(other>=0?target>=0:headerWord(5)==0) && ((headerWord(54)<0 || (words[headerWord(54)+cell]!=0u && (other<0 || words[headerWord(54)+other]!=0u))) &&
             (headerWord(55)<0 || words[headerWord(55)+face]!=0u));
        double outward=((side&1)==0?-velocity:velocity);
        double total=readDouble(headerWord(56)+4*face),liquid=readDouble(headerWord(56)+4*face+2);
        double gasSweep=other>=0?max(0.0LF,abs(total)-abs(liquid))*h*h*h:max(0.0LF,outward)*area*dt;
        outflow[side]=!closing && routeEnabled && outward>0.0LF?gasSweep:0.0LF;
        double inStandard=!closing && routeEnabled && other<0?min(max(0.0LF,-outward)*dt,h)*area*1e9LF*293.15LF/readDouble(p.header+10):0.0LF;
        if(!isFinite(inStandard)||inStandard>double(LIMIT)){reportInvalid();return;}
        putQuantity(field(F_INFLOW_NANOS)+2*routePart(cell,side),uint64_t(floor(inStandard)));
        putDouble(field(F_GATHER_ROUNDOFF)+42*headerWord(0)+2*routePart(cell,side),0.0LF);
        if(!isFinite(outflow[side])||area<0.0){reportInvalid();return;}
        totalOut+=outflow[side];energy[side]=0.0;moved[side]=uint64_t(0);
    }
    if(!isFinite(volume)||volume<0.0){reportInvalid();return;}
    if(totalOut>volume&&totalOut>0.0)for(int side=0;side<6;side++)outflow[side]*=volume/totalOut;
    int finalRoute=-1;if(closing&&volume>0.0LF)for(int side=0;side<6;side++)if(routeTarget(cell,side,size)!=-1){finalRoute=side;break;}
    if(closing&&volume>0.0LF&&finalRoute<0){reportInvalid();return;}
    uint64_t remainingWeight=SCALE;
    for(int side=0;side<6;side++){
        uint64_t weight=side==finalRoute?remainingWeight:(volume>0.0?uint64_t(floor(outflow[side]/volume*double(SCALE))):uint64_t(0));
        weights[side]=min(weight,remainingWeight);remainingWeight-=weights[side];
    }
    uint64_t total=uint64_t(0),totalMass=uint64_t(0);
    for(int component=0;component<components;component++){
        int original=cell*components+component;
        uint64_t nanos=quantity(gasField(G_STANDARD_VOLUME_NANOS)+2*original),mass=quantity(gasField(G_MASS_UNITS)+2*original);
        int64_t remainingResidual=signedQuantity(gasField(G_MASS_RESIDUAL_UNITS)+2*original);
        total=plus(total,nanos);totalMass=plus(totalMass,mass);
        uint64_t remainingN=nanos,remainingM=mass;
        int first=int(words[gasField(G_COMPONENT_SPECIES_OFFSETS)+original]),last=int(words[gasField(G_COMPONENT_SPECIES_OFFSETS)+original+1]);
        for(int side=0;side<6;side++){
            uint64_t partN=side==finalRoute?remainingN:min(remainingN,portion(nanos,weights[side],SCALE));
            int64_t partResidual=remainingN==uint64_t(0)?int64_t(0):signedPortion(remainingResidual,partN,remainingN),partMass=partResidual;
            for(int entry=first;entry<last;entry++){
                uint64_t remaining=quantity(gasField(G_SPECIES_AMOUNTS)+2*entry);
                for(int previous=0;previous<side;previous++)remaining-=quantity(field(F_SPECIES)+2*speciesPart(cell,entry-cell*stride,previous));
                uint64_t part=remainingN==uint64_t(0)?uint64_t(0):portion(remaining,partN,remainingN);
                int handle=int(words[gasField(G_SPECIES_HANDLES)+entry]);
                if(handle<0||handle>=sourceEosWord(GAS_H_SPECIES_STRIDE)){reportInvalid();return;}
                uint64_t unit=quantity(field(F_SPECIES_MASS)+2*handle);
                if(unit==uint64_t(0)||(part>uint64_t(0)&&part>LIMIT/unit)){reportInvalid();return;}
                partMass=signedPlus(partMass,int64_t(part*unit));
                putQuantity(field(F_SPECIES)+2*speciesPart(cell,entry-cell*stride,side),part);
            }
            bool accepted=partN>uint64_t(0)&&partMass>int64_t(0)&&uint64_t(partMass)<=remainingM&&
                          (uint64_t(partMass)<remainingM||partN==remainingN);
            if(!accepted){
                partN=uint64_t(0);partMass=int64_t(0);partResidual=int64_t(0);
                for(int entry=first;entry<last;entry++)putQuantity(field(F_SPECIES)+2*speciesPart(cell,entry-cell*stride,side),uint64_t(0));
            }else{
                double specific,capacity;material(component,temperature,specific,capacity);
                energy[side]+=double(partMass)*1e-10LF*specific;
                for(int entry=first;entry<last;entry++){
                    uint64_t part=quantity(field(F_SPECIES)+2*speciesPart(cell,entry-cell*stride,side));if(part==uint64_t(0))continue;
                    int handle=int(words[gasField(G_SPECIES_HANDLES)+entry]);
                    energy[side]+=double(part)*readDouble(sourceEosWord(GAS_H_SPECIES_REFERENCE)+2*(component*sourceEosWord(GAS_H_SPECIES_STRIDE)+handle));
                }
            }
            int at=componentPart(cell,component,side);
            putQuantity(field(F_NANOS)+2*at,partN);putQuantity(field(F_MASS)+2*at,uint64_t(partMass));
            remainingN-=partN;remainingM-=uint64_t(partMass);remainingResidual-=partResidual;
