    putQuantity(field(F_OLD_MASS)+2*cell,totalMass);
    uint64_t movedTotal=uint64_t(0);int last=-1;
    for(int side=0;side<6;side++){
        movedTotal=plus(movedTotal,moved[side]);if(moved[side]>uint64_t(0))last=side;
        putDouble(field(F_ENERGY_ROUNDOFF)+2*routePart(cell,side),0.0LF);
    }
    if(total>uint64_t(0)&&movedTotal==total){
        double remaining=readDouble(gasField(G_INTERNAL_ENERGY)+2*cell);
        for(int side=0;side<last;side++){
            double next,remainder;exactAdd(remaining,-energy[side],next,remainder);
            putDouble(field(F_ENERGY_ROUNDOFF)+2*routePart(cell,side),-remainder);remaining=next;
        }
        energy[last]=remaining;
    }
    for(int side=0;side<6;side++){
        if(!isFinite(energy[side])){reportInvalid();return;}
        putDouble(field(F_ENERGY)+2*routePart(cell,side),energy[side]);
        putDouble(field(F_VOLUME)+2*routePart(cell,side),total==uint64_t(0)?0.0:volume*double(moved[side])/double(total));
    }
}
uint64_t incoming(int fieldId,int cell,int component,int side){return quantity(field(fieldId)+2*componentPart(cell,component,side));}
// The route mass and its species determine the mass residual exactly.
int64_t routeResidual(int cell,int component,int side){
    int original=cell*headerWord(1)+component;
    int first=int(words[gasField(G_COMPONENT_SPECIES_OFFSETS)+original]);
    int last=int(words[gasField(G_COMPONENT_SPECIES_OFFSETS)+original+1]);
    int64_t residual=int64_t(incoming(F_MASS,cell,component,side));
    for(int entry=first;entry<last;entry++){
        int handle=int(words[gasField(G_SPECIES_HANDLES)+entry]);
        uint64_t amount=quantity(field(F_SPECIES)+2*speciesPart(cell,entry-cell*headerWord(2),side));
        residual=signedPlus(residual,-int64_t(amount*quantity(field(F_SPECIES_MASS)+2*handle)));
    }
    return residual;
}
void gather(int cell){
    putDouble(field(F_ENV_OLD_ENERGY)+2*cell,0.0LF);putDouble(field(F_ENV_NEW_ENERGY)+2*cell,0.0LF);
    putDouble(field(F_ENV_OLD_SINK)+2*cell,0.0LF);putDouble(field(F_ENV_NEW_SINK)+2*cell,0.0LF);
    int components=headerWord(1),stride=headerWord(2);ivec3 size=ivec3(headerWord(60),headerWord(61),headerWord(62));uint64_t targetMass=uint64_t(0),outMass=uint64_t(0);
    double externalIn=0.0LF,externalOut=0.0LF,ambientTemperature=readDouble(p.header+10);
    for(int component=0;component<components;component++){
        int i=cell*components+component;uint64_t n=quantity(gasField(G_STANDARD_VOLUME_NANOS)+2*i),m=quantity(gasField(G_MASS_UNITS)+2*i);
        int64_t residual=signedQuantity(gasField(G_MASS_RESIDUAL_UNITS)+2*i);
        for(int side=0;side<6;side++){
            uint64_t outN=incoming(F_NANOS,cell,component,side),outM=incoming(F_MASS,cell,component,side);
            if(outN>n||outM>m){reportInvalid();return;}n-=outN;m-=outM;outMass=plus(outMass,outM);
            residual=signedPlus(residual,-routeResidual(cell,component,side));
            if(externalRoute(cell,side,size)){
                uint64_t added=ambientComponent(quantity(field(F_INFLOW_NANOS)+2*routePart(cell,side)),component),mass=ambientMass(added,component);
                if(mass==uint64_t(0))added=uint64_t(0);
                int64_t extra=ambientResidual(added,component,mass);
                n=plus(n,added);m=plus(m,mass);residual=signedPlus(residual,extra);
                int src=components*(headerWord(0))+component,sink=src+components;
                if(added>uint64_t(0)){
                    atomicAdd(longs[(gasField(G_STANDARD_VOLUME_NANOS)+2*src)/2],int64_t(added));atomicAdd(longs[(gasField(G_MASS_UNITS)+2*src)/2],int64_t(mass));
                    if(extra!=int64_t(0))atomicAdd(longs[(gasField(G_MASS_RESIDUAL_UNITS)+2*src)/2],extra);
                }
                if(outN>uint64_t(0)){
                    atomicAdd(longs[(gasField(G_STANDARD_VOLUME_NANOS)+2*sink)/2],int64_t(outN));atomicAdd(longs[(gasField(G_MASS_UNITS)+2*sink)/2],int64_t(outM));
                    int64_t removed=routeResidual(cell,component,side);
                    if(removed!=int64_t(0))atomicAdd(longs[(gasField(G_MASS_RESIDUAL_UNITS)+2*sink)/2],removed);
                }
                if(mass>uint64_t(0)){double specific,capacity;material(component,ambientTemperature,specific,capacity);externalIn+=double(mass)*1e-10LF*specific;}
            }
        }
        for(int index=0;index<inboundCount(cell);index++){
            int source=inboundSource(cell,index,size);if(source<0)continue;int side=inboundSide(cell,index);
            n=plus(n,incoming(F_NANOS,source,component,side));m=plus(m,incoming(F_MASS,source,component,side));
            residual=signedPlus(residual,routeResidual(source,component,side));
        }
        if((n==uint64_t(0))!=(m==uint64_t(0))){reportInvalid();return;}
        targetMass=plus(targetMass,m);putQuantity(gasField(G_STANDARD_VOLUME_NANOS)+2*i,n);putQuantity(gasField(G_MASS_UNITS)+2*i,m);putQuantity(gasField(G_MASS_RESIDUAL_UNITS)+2*i,uint64_t(residual));
    }
    putQuantity(field(F_NEW_MASS)+2*cell,targetMass);
    for(int local=0;local<stride;local++){
        int i=cell*stride+local;uint64_t q=quantity(gasField(G_SPECIES_AMOUNTS)+2*i);
        for(int side=0;side<6;side++){
            uint64_t sent=quantity(field(F_SPECIES)+2*speciesPart(cell,local,side));if(sent>q){reportInvalid();return;}q-=sent;
            if(externalRoute(cell,side,size)) {
                int component=0;while(component+1<components && local>=int(words[gasField(G_COMPONENT_SPECIES_OFFSETS)+cell*components+component+1])-cell*stride)component++;
                int entry=cell*stride+local,handle=int(words[gasField(G_SPECIES_HANDLES)+entry]);
                uint64_t addedN=ambientComponent(quantity(field(F_INFLOW_NANOS)+2*routePart(cell,side)),component);
                if(ambientMass(addedN,component)==uint64_t(0))addedN=uint64_t(0);
                uint64_t added=ambientSpecies(addedN,component,handle);q=plus(q,added);
                if(added>uint64_t(0))atomicAdd(longs[(gasField(G_SPECIES_AMOUNTS)+2*(headerWord(0)*stride+local))/2],int64_t(added));
                if(sent>uint64_t(0))atomicAdd(longs[(gasField(G_SPECIES_AMOUNTS)+2*((headerWord(0)+1)*stride+local))/2],int64_t(sent));
                externalIn+=double(added)*readDouble(sourceEosWord(GAS_H_SPECIES_REFERENCE)+2*(component*sourceEosWord(GAS_H_SPECIES_STRIDE)+handle));
            }
        }
        for(int index=0;index<inboundCount(cell);index++){
            int source=inboundSource(cell,index,size);if(source<0)continue;
            q=plus(q,quantity(field(F_SPECIES)+2*speciesPart(source,local,inboundSide(cell,index))));
        }
        putQuantity(gasField(G_SPECIES_AMOUNTS)+2*i,q);
    }
    double outEnergy=0.0,inEnergy=0.0;uint64_t oldMass=quantity(field(F_OLD_MASS)+2*cell);
    bool emptied=oldMass>uint64_t(0)&&outMass==oldMass;
    int errorBase=field(F_GATHER_ROUNDOFF)+42*cell;
    for(int side=0;side<6;side++){
        double next,remainder,part=readDouble(field(F_ENERGY)+2*routePart(cell,side));
        exactAdd(outEnergy,part,next,remainder);outEnergy=next;
        putDouble(errorBase+2*side,emptied?0.0LF:remainder);
        putDouble(errorBase+2*(6+side),0.0LF);
        if(externalRoute(cell,side,size)){
            exactAdd(externalOut,part,next,remainder);externalOut=next;
            putDouble(errorBase+2*(12+side),-remainder);
        }else putDouble(errorBase+2*(12+side),0.0LF);
    }
    for(int index=0;index<inboundCount(cell);index++){
        int source=inboundSource(cell,index,size);if(source<0)continue;int side=inboundSide(cell,index);
        double next,remainder;
        exactAdd(inEnergy,readDouble(field(F_ENERGY)+2*routePart(source,side)),next,remainder);inEnergy=next;
        putDouble(field(F_GATHER_ROUNDOFF)+42*headerWord(0)+2*routePart(source,side),-remainder);
    }
    putDouble(field(F_EXTERNAL_SOURCE_ENERGY)+2*cell,externalIn);putDouble(field(F_EXTERNAL_SINK_ENERGY)+2*cell,externalOut);
    double next,remainder;exactAdd(inEnergy,externalIn,next,remainder);inEnergy=next;putDouble(errorBase+36,-remainder);
    double retained=0.0LF;
    if(!emptied){exactAdd(readDouble(gasField(G_INTERNAL_ENERGY)+2*cell),-outEnergy,retained,remainder);putDouble(errorBase+38,-remainder);}
    else putDouble(errorBase+38,0.0LF);
    double energy;exactAdd(retained,inEnergy,energy,remainder);putDouble(errorBase+40,-remainder);
    if(!isFinite(energy)){reportInvalid();return;}
    putDouble(gasField(G_INTERNAL_ENERGY)+2*cell,energy);
}
void primalMass(int face){
    ivec3 size=ivec3(headerWord(60),headerWord(61),headerWord(62)),ends=localGasFaceEndpoints(face,size);
    int64_t amount=int64_t(0);
    if(ends.x>=0&&ends.y>=0)for(int component=0;component<headerWord(1);component++){
        if(!sourceClosing(ends.x)&&routeTarget(ends.x,2*ends.z+1,size)==ends.y)
            amount=signedPlus(amount,signedQuantity(field(F_MASS)+2*componentPart(ends.x,component,2*ends.z+1)));
        if(!sourceClosing(ends.y)&&routeTarget(ends.y,2*ends.z,size)==ends.x)
            amount=signedPlus(amount,-signedQuantity(field(F_MASS)+2*componentPart(ends.y,component,2*ends.z)));
    }
    if(ends.x<0 || ends.y<0){
        int cell=max(ends.x,ends.y),side=2*ends.z+(ends.y<0?1:0);int64_t outward=int64_t(0),inward=int64_t(0);
        uint64_t n=quantity(field(F_INFLOW_NANOS)+2*routePart(cell,side));
        for(int component=0;component<headerWord(1);component++){
            if(!sourceClosing(cell))outward=signedPlus(outward,signedQuantity(field(F_MASS)+2*componentPart(cell,component,side)));
            inward=signedPlus(inward,int64_t(ambientMass(ambientComponent(n,component),component)));
        }
        int direction=ends.y<0?1:-1;amount=int64_t(direction)*(outward-inward);
    }
    putQuantity(field(F_PRIMAL_MASS)+2*face,uint64_t(amount));
}
// Absolute caloric U includes each component and its species reference energy.
double gasEnergyAtTemperature(int cell,double temperature){
    double cold=0.0LF;
    int components=headerWord(1),stride=sourceEosWord(GAS_H_SPECIES_STRIDE);
    for(int component=0;component<components;component++){
        int row=cell*components+component;uint64_t mass=quantity(gasField(G_MASS_UNITS)+2*row);
        if(mass==uint64_t(0))continue;
        double specific,capacity;material(component,temperature,specific,capacity);cold+=double(mass)*1e-10LF*specific;
        int first=int(words[gasField(G_COMPONENT_SPECIES_OFFSETS)+row]),last=int(words[gasField(G_COMPONENT_SPECIES_OFFSETS)+row+1]);
        for(int entry=first;entry<last;entry++){
            uint64_t amount=quantity(gasField(G_SPECIES_AMOUNTS)+2*entry);if(amount==uint64_t(0))continue;
            int handle=int(words[gasField(G_SPECIES_HANDLES)+entry]);
            cold+=double(amount)*readDouble(sourceEosWord(GAS_H_SPECIES_REFERENCE)+2*(component*stride+handle));
        }
    }
    return cold;
}
double gasLogRatio(double numerator,double denominator){
    int exponent;
    double mantissa=frexp(numerator/denominator,exponent);
    if(mantissa<.7071067811865475244LF){mantissa*=2.0LF;exponent--;}
    double z=(mantissa-1.0LF)/(mantissa+1.0LF),square=z*z;
    double series=1.0LF/15.0LF;
    series=1.0LF/13.0LF+square*series;
    series=1.0LF/11.0LF+square*series;
    series=1.0LF/9.0LF+square*series;
    series=1.0LF/7.0LF+square*series;
    series=1.0LF/5.0LF+square*series;
    series=1.0LF/3.0LF+square*series;
    return 2.0LF*z*(1.0LF+square*series)+double(exponent)*.6931471805599453094LF;
}
void applyPressureWork(int cell){
    if(headerWord(54)>=0&&words[headerWord(54)+cell]==0u){
        putDouble(field(F_WORK)+2*cell,0.0LF);
        putDouble(field(F_EXTERNAL_PRESSURE_WORK)+2*cell,0.0LF);
        return;
    }
    ivec3 size=ivec3(headerWord(60),headerWord(61),headerWord(62));double outgoing=0.0,incoming=0.0,externalVolume=0.0;
    for(int side=0;side<6;side++){
        outgoing+=readDouble(field(F_VOLUME)+2*routePart(cell,side));
        if(externalRoute(cell,side,size)) {
            uint64_t offered=quantity(field(F_INFLOW_NANOS)+2*routePart(cell,side)),accepted=uint64_t(0);
            for(int component=0;component<headerWord(1);component++){
                uint64_t part=ambientComponent(offered,component);
                if(ambientMass(part,component)>uint64_t(0))accepted=plus(accepted,part);
            }
            double received=double(accepted)*1e-9LF*readDouble(p.header+10)/293.15LF;
            incoming+=received;
            externalVolume+=received-readDouble(field(F_VOLUME)+2*routePart(cell,side));
        }
    }
    for(int index=0;index<inboundCount(cell);index++){
        int source=inboundSource(cell,index,size);if(source<0)continue;
        incoming+=readDouble(field(F_VOLUME)+2*routePart(source,inboundSide(cell,index)));
    }
    putDouble(field(F_EXTERNAL_PRESSURE_WORK)+2*cell,(MIXTURE_PRESSURE_LIMIT-MIXTURE_BULK)*externalVolume);
    int nextMixture=int(p.valueLow);double oldVolume=readDouble(field(F_OLD_VOLUME)+2*cell),nextVolume=readDouble(nextMixture+2*(7*cell+2));
    uint64_t oldMass=quantity(field(F_OLD_MASS)+2*cell),nextMass=quantity(field(F_NEW_MASS)+2*cell);
    int target=gasField(G_INTERNAL_ENERGY)+2*cell;double energy=readDouble(target),work=0.0LF;
    if(oldMass>uint64_t(0)&&nextMass>uint64_t(0)){
        double advectedVolume=max(0.0LF,oldVolume-outgoing)+incoming;
        int eos=sourceEosWord(GAS_H_STATES)+18*cell;
        double temperature=readDouble(eos),capacity=readDouble(eos+6),constant=readDouble(eos+8);
        if(!(isFinite(capacity)&&capacity>0.0LF&&isFinite(constant)&&constant>0.0LF&&nextVolume>0.0LF&&advectedVolume>0.0LF)){reportInvalid();return;}
        if(advectedVolume!=nextVolume){
            // Solve the same frozen-Cv adiabatic state and mixture EOS together.
            double bulk=MIXTURE_BULK,limit=MIXTURE_PRESSURE_LIMIT;
            double liquidVolume=readDouble(nextMixture+2*(7*cell+1));
            double liquidScale=readDouble(nextMixture+2*(7*cell+3));
            double liquidReference=liquidVolume>0.0LF?liquidVolume/liquidScale:0.0LF;
            double poreVolume=liquidVolume+nextVolume;
            double low=liquidReference>0.0LF?max(0.0LF,limit-bulk*poreVolume/liquidReference):0.0LF,high=limit;
            double pressure=readDouble(nextMixture+2*(7*cell));
            if(!(pressure>low&&pressure<high))pressure=.5LF*(low+high);
            double a=capacity*bulk/(limit*constant);
            double b=capacity*constant/(capacity*bulk+limit*constant);
            double referenceVolume=advectedVolume+b*temperature;
            double finalTemperature=temperature;
            for(int iteration=0;iteration<48;iteration++){
                double scale=(limit-pressure)/bulk;
                double gasVolume=poreVolume-liquidReference*scale;
                finalTemperature=pressure*gasVolume/(constant*scale);
                double residual=gasLogRatio(gasVolume+b*finalTemperature,referenceVolume)
                    +a*gasLogRatio(finalTemperature,temperature);
                if(abs(residual)<=1e-7LF||iteration==47)break;
                if(residual<0.0LF)low=pressure;else high=pressure;
                double dTemperature=finalTemperature*(1.0LF/pressure+liquidReference/(bulk*gasVolume)+1.0LF/(bulk*scale));
                double derivative=(liquidReference/bulk+b*dTemperature)/(gasVolume+b*finalTemperature)+a*dTemperature/finalTemperature;
                double candidate=pressure-residual/derivative;
                pressure=candidate>low&&candidate<high?candidate:.5LF*(low+high);
            }
            if(!(isFinite(finalTemperature)&&finalTemperature>=readDouble(headerWord(H_SOURCE_EOS)+GAS_H_MINIMUM_TEMPERATURE))){reportInvalid();return;}
            double finalEnergy=gasEnergyAtTemperature(cell,finalTemperature);
            work=finalEnergy-energy;energy=finalEnergy;
        }
    }
    if(!isFinite(energy)||!isFinite(work)){reportInvalid();return;}putDouble(target,energy);putDouble(field(F_WORK)+2*cell,work);
}
void main(){int id=int(gl_GlobalInvocationID.y*gl_NumWorkGroups.x*128u+gl_GlobalInvocationID.x);if(id>=p.count||errors!=0u)return;if(p.stage==0)split(id);else if(p.stage==1)gather(id);else if(p.stage==2)primalMass(id);else if(p.stage==6)applyPressureWork(id);}
