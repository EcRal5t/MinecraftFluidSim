#version 450
#extension GL_ARB_gpu_shader_fp64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
const double MASS_UNIT_KG = 1e-10;
const int CONTACT_COMPRESSION = 0;
const int CONTACT_REBOUND = 1;
const int STAGE_INITIALIZE_PARTICLES = 0;
const int STAGE_PREPARE_CONTACTS = 1;
const int STAGE_SCATTER_CONTACTS = 2;
const int STAGE_COUNT_COMPONENTS = 3;
const int STAGE_SCATTER_COMPONENTS = 4;
const int STAGE_PROPOSE_IMPULSES = 5;
const int STAGE_RECONSTRUCT_VELOCITY = 6;
const int STAGE_CAPTURE_COMPRESSION = 7;
const int STAGE_COMPUTE_ENERGY_TERMS = 8;
const int STAGE_BUDGET_REBOUND = 9;
const int STAGE_LIMIT_REBOUND = 10;
const int STAGE_INITIALIZE_INTERVAL = 11;
const int STAGE_RESTORE_VELOCITY = 12;
const int STAGE_ACCUMULATE_INTERVAL = 13;
const int STAGE_RESOLVE_INTERVAL_COMPONENTS = 14;
const uint ERROR_GRANULAR_CONTACTS = 2097152u;
layout(local_size_x = 128) in;
layout(binding = 0, std430) buffer Arena {
    uint words[];
};
layout(binding = 1, std430) buffer Errors {
    uint errors;
};
layout(push_constant) uniform Params {
    int header;
    int stage;
    int count;
    int argument;
}
p;
// HOST_LAYOUT
int headerValue(int i) {
    return int(words[p.header + i]);
}
int fieldOffset(int f) {
    return headerValue(WORK_FIELDS + f);
}
int readFieldInt(int f, int i) {
    return int(words[fieldOffset(f) + i]);
}
void writeFieldInt(int f, int i, int x) {
    words[fieldOffset(f) + i] = uint(x);
}
double readDouble(int a) {
    return packDouble2x32(uvec2(words[a], words[a + 1]));
}
void writeNumber(int a, double x) {
    uvec2 bits = unpackDouble2x32(x);
    words[a] = bits.x;
    words[a + 1] = bits.y;
}
double read(int f, int i) {
    return readDouble(fieldOffset(f) + 2 * i);
}
void write(int f, int i, double x) {
    writeNumber(fieldOffset(f) + 2 * i, x);
}
dvec3 vector(int f, int i) {
    return dvec3(read(f, 3 * i), read(f, 3 * i + 1), read(f, 3 * i + 2));
}
void writeVector(int f, int i, dvec3 x) {
    for (int a = 0; a < 3; a++)
        write(f, 3 * i + a, x[a]);
}
int particleCount() {
    return int(words[headerValue(H_COUNTS)]);
}
int contactCount() {
    return readFieldInt(FIELD_CONTROL, 0);
}
double particleMass(int i) {
    int a = headerValue(H_MASS) + 2 * i;
    return double(int64_t(uint64_t(words[a]) | (uint64_t(words[a + 1]) << 32))) * MASS_UNIT_KG;
}
void reportInvalidState() {
    atomicOr(errors, ERROR_GRANULAR_CONTACTS);
}
bool finite(double x) {
    return !isnan(x) && !isinf(x);
}
uint contactComponentRoot(uint id) {
    for (int pass = 0; pass < headerValue(H_PARTICLE_CAPACITY); pass++) {
        uint next = atomicAdd(words[fieldOffset(FIELD_CONTACT_COMPONENT) + id], 0u);
        if (next == id)
            return id;
        id = next;
    }
    reportInvalidState();
    return id;
}
void joinContactComponents(int first, int second) {
    for (int pass = 0; pass < headerValue(H_PARTICLE_CAPACITY); pass++) {
        uint a = contactComponentRoot(uint(first)), b = contactComponentRoot(uint(second));
        if (a == b)
            return;
        uint high = max(a, b), low = min(a, b), previous = atomicMin(words[fieldOffset(FIELD_CONTACT_COMPONENT) + high], low);
        if (previous == high)
            return;
    }
    reportInvalidState();
}
uint intervalRoot(uint id) {
    for (int pass = 0; pass < headerValue(H_PARTICLE_CAPACITY); pass++) {
        uint next = atomicAdd(words[fieldOffset(FIELD_INTERVAL_COMPONENT) + id], 0u);
        if (next == id)
            return id;
        id = next;
    }
    reportInvalidState();
    return id;
}
void intervalJoin(int first, int second) {
    for (int pass = 0; pass < headerValue(H_PARTICLE_CAPACITY); pass++) {
        uint a = intervalRoot(uint(first)), b = intervalRoot(uint(second));
        if (a == b)
            return;
        uint high = max(a, b), low = min(a, b), previous = atomicMin(words[fieldOffset(FIELD_INTERVAL_COMPONENT) + high], low);
        if (previous == high)
            return;
    }
    reportInvalidState();
}
void initialize(int i) {
    write(FIELD_PARTICLE_EXTERNAL_WORK, i, 0.0);
    writeFieldInt(FIELD_CONTACT_COMPONENT, i, i);
    writeFieldInt(FIELD_COUNTS, i, 0);
    writeFieldInt(FIELD_CURSORS, i, 0);
    writeFieldInt(FIELD_COMPONENT_COUNTS, i, 0);
    writeFieldInt(FIELD_COMPONENT_CURSORS, i, 0);
    write(FIELD_REBOUND_SCALE, i, 1.0);
    dvec3 v = i < particleCount() ? dvec3(readDouble(headerValue(H_VELOCITY) + 6 * i), readDouble(headerValue(H_VELOCITY) + 6 * i + 2),
                                   readDouble(headerValue(H_VELOCITY) + 6 * i + 4))
                           : dvec3(0.0);
    writeVector(FIELD_SOURCE_VELOCITY, i, v);
    writeVector(FIELD_VELOCITY, i, v);
    writeVector(FIELD_COMPRESSED_VELOCITY, i, v);
}
bool validContact(int c) {
    int a = readFieldInt(FIELD_FIRST, c), b = readFieldInt(FIELD_SECOND, c);
    return a >= 0 && a < particleCount() && b >= -1 && b < particleCount() && a != b;
}
void prepareContact(int c) {
    write(FIELD_FIXED_WORK, c, 0.0);
    writeVector(FIELD_FIXED_REACTION, c, dvec3(0.0));
    if (c >= contactCount())
        return;
    if (!validContact(c)) {
        reportInvalidState();
        return;
    }
    int a = readFieldInt(FIELD_FIRST, c), b = readFieldInt(FIELD_SECOND, c);
    dvec3 n = vector(FIELD_NORMAL, c);
    double norm = dot(n, n);
    if (!(norm > .999999 && norm < 1.000001 && particleMass(a) > 0.0 && (b < 0 || particleMass(b) > 0.0) &&
          read(FIELD_RESTITUTION, c) >= 0.0 && read(FIELD_RESTITUTION, c) <= 1.0 &&
          read(FIELD_STATIC_FRICTION, c) >= read(FIELD_DYNAMIC_FRICTION, c) &&
          read(FIELD_DYNAMIC_FRICTION, c) >= 0.0)) {
        reportInvalidState();
        return;
    }
    atomicAdd(words[fieldOffset(FIELD_COUNTS) + a], 1u);
    if (b >= 0) {
        atomicAdd(words[fieldOffset(FIELD_COUNTS) + b], 1u);
        joinContactComponents(a, b);
    }
    write(FIELD_NORMAL_IMPULSE, c, 0.0);
    write(FIELD_COMPRESSED_IMPULSE, c, 0.0);
    writeVector(FIELD_TANGENT_IMPULSE, c, dvec3(0.0));
    write(FIELD_FIXED_WORK, c, 0.0);
    writeVector(FIELD_FIXED_REACTION, c, dvec3(0.0));
}
void scatter(int c) {
    if (c >= contactCount() || !validContact(c))
        return;
    int a = readFieldInt(FIELD_FIRST, c), b = readFieldInt(FIELD_SECOND, c);
    int first = int(atomicAdd(words[fieldOffset(FIELD_CURSORS) + a], 1u));
    writeFieldInt(FIELD_ENTRIES, readFieldInt(FIELD_OFFSETS, a) + first, c);
    if (b >= 0) {
        int second = int(atomicAdd(words[fieldOffset(FIELD_CURSORS) + b], 1u));
        writeFieldInt(FIELD_ENTRIES, readFieldInt(FIELD_OFFSETS, b) + second, c);
    }
}
void componentCount(int i) {
    if (i >= particleCount())
        return;
    int label = int(contactComponentRoot(uint(i)));
    atomicExchange(words[fieldOffset(FIELD_CONTACT_COMPONENT) + i], uint(label));
    atomicAdd(words[fieldOffset(FIELD_COMPONENT_COUNTS) + label], 1u);
}
void componentScatter(int i) {
    if (i >= particleCount())
        return;
    int label = readFieldInt(FIELD_CONTACT_COMPONENT, i), slot = int(atomicAdd(words[fieldOffset(FIELD_COMPONENT_CURSORS) + label], 1u));
    writeFieldInt(FIELD_COMPONENT_MEMBERS, readFieldInt(FIELD_COMPONENT_OFFSETS, label) + slot, i);
}
dvec3 relativeVelocity(int field, int c) {
    int a = readFieldInt(FIELD_FIRST, c), b = readFieldInt(FIELD_SECOND, c);
    return b < 0 ? vector(field, a) - vector(FIELD_WALL_VELOCITY, c) : vector(field, b) - vector(field, a);
}
void proposeContactImpulse(int c) {
    if (c >= contactCount() || !validContact(c))
        return;
    int a = readFieldInt(FIELD_FIRST, c), b = readFieldInt(FIELD_SECOND, c);
    dvec3 n = vector(FIELD_NORMAL, c), v = relativeVelocity(FIELD_VELOCITY, c);
    double inverse = 1.0 / particleMass(a) + (b < 0 ? 0.0 : 1.0 / particleMass(b));
    double relaxation = 1.0 / double(max(readFieldInt(FIELD_COUNTS, a), b < 0 ? 1 : readFieldInt(FIELD_COUNTS, b)));
    double target =
        p.argument == CONTACT_COMPRESSION ? 0.0 : -read(FIELD_RESTITUTION, c) * min(0.0, dot(n, relativeVelocity(FIELD_SOURCE_VELOCITY, c)));
    double old = read(FIELD_NORMAL_IMPULSE, c), next = max(0.0, old + (target - dot(n, v)) / inverse);
    write(FIELD_NORMAL_IMPULSE, c, old + relaxation * (next - old));
    if (p.argument == CONTACT_REBOUND) {
        dvec3 tangent = vector(FIELD_TANGENT_IMPULSE, c), trial = tangent - (v - n * dot(n, v)) / inverse;
        double magnitude = length(trial), load = read(FIELD_NORMAL_IMPULSE, c);
        double scale = magnitude == 0.0 || magnitude <= read(FIELD_STATIC_FRICTION, c) * load
                           ? 1.0
                           : min(1.0, read(FIELD_DYNAMIC_FRICTION, c) * load / magnitude);
        writeVector(FIELD_TANGENT_IMPULSE, c, tangent + relaxation * (scale * trial - tangent));
    }
}
void reconstructParticleVelocity(int i) {
    if (i >= particleCount())
        return;
    dvec3 impulse = dvec3(0.0);
    double externalWork = 0.0;
    for (int j = readFieldInt(FIELD_OFFSETS, i); j < readFieldInt(FIELD_OFFSETS, i + 1); j++) {
        int c = readFieldInt(FIELD_ENTRIES, j), b = readFieldInt(FIELD_SECOND, c);
        double sign = b < 0 || b == i ? 1.0 : -1.0;
        impulse += sign * (read(FIELD_NORMAL_IMPULSE, c) * vector(FIELD_NORMAL, c) + vector(FIELD_TANGENT_IMPULSE, c));
        if (b < 0)
            externalWork += read(FIELD_FIXED_WORK, c);
    }
    dvec3 v = vector(FIELD_SOURCE_VELOCITY, i) + impulse / particleMass(i);
    writeVector(FIELD_VELOCITY, i, v);
    if (p.argument == CONTACT_REBOUND) {
        write(FIELD_PARTICLE_EXTERNAL_WORK, i, externalWork);
        for (int a = 0; a < 3; a++)
            writeNumber(headerValue(H_VELOCITY) + 6 * i + 2 * a, v[a]);
        writeNumber(headerValue(H_FINAL_K) + 2 * i, .5 * particleMass(i) * dot(v, v));
    }
    if (any(isnan(v)) || any(isinf(v)))
        reportInvalidState();
}
void captureCompression(int id) {
    if (id < headerValue(H_PARTICLE_CAPACITY))
        writeVector(FIELD_COMPRESSED_VELOCITY, id, vector(FIELD_VELOCITY, id));
    if (id < contactCount())
        write(FIELD_COMPRESSED_IMPULSE, id, read(FIELD_NORMAL_IMPULSE, id));
}
void energyTerms(int i) {
    if (i >= particleCount())
        return;
    dvec3 source = vector(FIELD_SOURCE_VELOCITY, i), compressed = vector(FIELD_COMPRESSED_VELOCITY, i),
          delta = vector(FIELD_VELOCITY, i) - compressed;
    double m = particleMass(i);
    double available = .5 * m * dot(source - compressed, source + compressed), linear = m * dot(compressed, delta),
           quadratic = .5 * m * dot(delta, delta);
    for (int j = readFieldInt(FIELD_OFFSETS, i); j < readFieldInt(FIELD_OFFSETS, i + 1); j++) {
        int c = readFieldInt(FIELD_ENTRIES, j);
        if (readFieldInt(FIELD_SECOND, c) >= 0)
            continue;
        dvec3 wall = vector(FIELD_WALL_VELOCITY, c), n = vector(FIELD_NORMAL, c);
        available += read(FIELD_COMPRESSED_IMPULSE, c) * dot(wall, n);
        linear -= dot(wall, (read(FIELD_NORMAL_IMPULSE, c) - read(FIELD_COMPRESSED_IMPULSE, c)) * n +
                                vector(FIELD_TANGENT_IMPULSE, c));
    }
    writeVector(FIELD_ENERGY_TERMS, i, dvec3(available, linear, quadratic));
}
void budgetReboundEnergy(int label) {
    if (readFieldInt(FIELD_COMPONENT_COUNTS, label) == 0)
        return;
    dvec3 terms = dvec3(0.0);
    for (int j = readFieldInt(FIELD_COMPONENT_OFFSETS, label); j < readFieldInt(FIELD_COMPONENT_OFFSETS, label + 1); j++)
        terms += vector(FIELD_ENERGY_TERMS, readFieldInt(FIELD_COMPONENT_MEMBERS, j));
    double available = max(0.0, terms.x), linear = terms.y, quadratic = terms.z, scale = 1.0;
    if (linear + quadratic > available && quadratic > 0.0) {
        double rootValue = sqrt(linear * linear + 4.0 * quadratic * available);
        scale = clamp(linear >= 0.0 ? (available <= 0.0 ? 0.0 : 2.0 * available / (linear + rootValue))
                                    : (rootValue - linear) / (2.0 * quadratic),
                      0.0, 1.0);
    }
    if (!finite(scale))
        reportInvalidState();
    write(FIELD_REBOUND_SCALE, label, scale);
}
void limitRebound(int c) {
    if (c >= contactCount() || !validContact(c))
        return;
    double scale = read(FIELD_REBOUND_SCALE, readFieldInt(FIELD_CONTACT_COMPONENT, readFieldInt(FIELD_FIRST, c)));
    double normal = mix(read(FIELD_COMPRESSED_IMPULSE, c), read(FIELD_NORMAL_IMPULSE, c), scale);
    dvec3 tangent = scale * vector(FIELD_TANGENT_IMPULSE, c);
    write(FIELD_NORMAL_IMPULSE, c, normal);
    writeVector(FIELD_TANGENT_IMPULSE, c, tangent);
    if (readFieldInt(FIELD_SECOND, c) < 0) {
        dvec3 impulse = normal * vector(FIELD_NORMAL, c) + tangent;
        writeVector(FIELD_FIXED_REACTION, c, -impulse);
        write(FIELD_FIXED_WORK, c, dot(impulse, vector(FIELD_WALL_VELOCITY, c)));
    }
}
void main() {
    int id = int((gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x) * 128 + gl_LocalInvocationID.x);
    if (id >= p.count || errors != 0u)
        return;
    if (particleCount() < 0 || particleCount() > headerValue(H_PARTICLE_CAPACITY) ||
        (p.stage != STAGE_INITIALIZE_INTERVAL && (contactCount() < 0 || contactCount() > headerValue(H_CONTACT_CAPACITY)))) {
        reportInvalidState();
        return;
    }
    if (p.stage == STAGE_INITIALIZE_PARTICLES)
        initialize(id);
    else if (p.stage == STAGE_PREPARE_CONTACTS)
        prepareContact(id);
    else if (p.stage == STAGE_SCATTER_CONTACTS)
        scatter(id);
    else if (p.stage == STAGE_COUNT_COMPONENTS)
        componentCount(id);
    else if (p.stage == STAGE_SCATTER_COMPONENTS)
        componentScatter(id);
    else if (p.stage == STAGE_PROPOSE_IMPULSES)
        proposeContactImpulse(id);
    else if (p.stage == STAGE_RECONSTRUCT_VELOCITY)
        reconstructParticleVelocity(id);
    else if (p.stage == STAGE_CAPTURE_COMPRESSION)
        captureCompression(id);
    else if (p.stage == STAGE_COMPUTE_ENERGY_TERMS)
        energyTerms(id);
    else if (p.stage == STAGE_BUDGET_REBOUND)
        budgetReboundEnergy(id);
    else if (p.stage == STAGE_LIMIT_REBOUND)
        limitRebound(id);
    else if (p.stage == STAGE_INITIALIZE_INTERVAL) {
        if (id < headerValue(H_PARTICLE_CAPACITY)) {
            writeFieldInt(FIELD_INTERVAL_COMPONENT, id, id);
            write(FIELD_INTERVAL_PARTICLE_WORK, id, 0.0);
        }
        if (id < headerValue(H_CONTACT_CAPACITY))
            write(FIELD_INTERVAL_FIXED_WORK, id, 0.0);
    } else if (p.stage == STAGE_RESTORE_VELOCITY) {
        if (id < particleCount()) {
            dvec3 v = vector(FIELD_SOURCE_VELOCITY, id);
            for (int a = 0; a < 3; a++)
                writeNumber(headerValue(H_VELOCITY) + 6 * id + 2 * a, v[a]);
            writeNumber(headerValue(H_FINAL_K) + 2 * id, .5 * particleMass(id) * dot(v, v));
        }
    } else if (p.stage == STAGE_ACCUMULATE_INTERVAL) {
        if (id < particleCount())
            write(FIELD_INTERVAL_PARTICLE_WORK, id,
                  read(FIELD_INTERVAL_PARTICLE_WORK, id) + read(FIELD_PARTICLE_EXTERNAL_WORK, id));
        if (id < contactCount()) {
            int a = readFieldInt(FIELD_FIRST, id), b = readFieldInt(FIELD_SECOND, id);
            if (b >= 0)
                intervalJoin(a, b);
            write(FIELD_INTERVAL_FIXED_WORK, id, read(FIELD_INTERVAL_FIXED_WORK, id) + read(FIELD_FIXED_WORK, id));
        }
    } else if (p.stage == STAGE_RESOLVE_INTERVAL_COMPONENTS) {
        if (id < particleCount())
            atomicExchange(words[fieldOffset(FIELD_INTERVAL_COMPONENT) + id], intervalRoot(uint(id)));
    }
}
