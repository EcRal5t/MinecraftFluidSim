#version 450
#extension GL_ARB_gpu_shader_fp64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
layout(local_size_x = 128) in;
layout(binding = 0, std430) buffer Arena {
    uint words[];
};
layout(binding = 1, std430) buffer Errors {
    uint errors;
};
layout(push_constant) uniform Params {
    int header;
    int stage;
    int count;
    int argument;
}
p;
// HOST_LAYOUT
int h(int i) {
    return int(words[p.header + i]);
}
int at(int f) {
    return h(WORK_FIELDS + f);
}
int get(int f, int i) {
    return int(words[at(f) + i]);
}
void put(int f, int i, int x) {
    words[at(f) + i] = uint(x);
}
double number(int a) {
    return packDouble2x32(uvec2(words[a], words[a + 1]));
}
void writeNumber(int a, double x) {
    uvec2 bits = unpackDouble2x32(x);
    words[a] = bits.x;
    words[a + 1] = bits.y;
}
double read(int f, int i) {
    return number(at(f) + 2 * i);
}
void write(int f, int i, double x) {
    writeNumber(at(f) + 2 * i, x);
}
dvec3 vector(int f, int i) {
    return dvec3(read(f, 3 * i), read(f, 3 * i + 1), read(f, 3 * i + 2));
}
void writeVector(int f, int i, dvec3 x) {
    for (int a = 0; a < 3; a++)
        write(f, 3 * i + a, x[a]);
}
int actual() {
    return int(words[h(H_COUNTS)]);
}
int contacts() {
    return get(FIELD_CONTROL, 0);
}
double mass(int i) {
    int a = h(H_MASS) + 2 * i;
    return double(int64_t(uint64_t(words[a]) | (uint64_t(words[a + 1]) << 32))) * 1e-10;
}
void invalid() {
    atomicOr(errors, 2097152u);
}
bool finite(double x) {
    return !isnan(x) && !isinf(x);
}
uint root(uint id) {
    for (int pass = 0; pass < h(H_PARTICLE_CAPACITY); pass++) {
        uint next = atomicAdd(words[at(FIELD_CONTACT_COMPONENT) + id], 0u);
        if (next == id)
            return id;
        id = next;
    }
    invalid();
    return id;
}
void join(int first, int second) {
    for (int pass = 0; pass < h(H_PARTICLE_CAPACITY); pass++) {
        uint a = root(uint(first)), b = root(uint(second));
        if (a == b)
            return;
        uint high = max(a, b), low = min(a, b), previous = atomicMin(words[at(FIELD_CONTACT_COMPONENT) + high], low);
        if (previous == high)
            return;
    }
    invalid();
}
uint intervalRoot(uint id) {
    for (int pass = 0; pass < h(H_PARTICLE_CAPACITY); pass++) {
        uint next = atomicAdd(words[at(FIELD_INTERVAL_COMPONENT) + id], 0u);
        if (next == id)
            return id;
        id = next;
    }
    invalid();
    return id;
}
void intervalJoin(int first, int second) {
    for (int pass = 0; pass < h(H_PARTICLE_CAPACITY); pass++) {
        uint a = intervalRoot(uint(first)), b = intervalRoot(uint(second));
        if (a == b)
            return;
        uint high = max(a, b), low = min(a, b), previous = atomicMin(words[at(FIELD_INTERVAL_COMPONENT) + high], low);
        if (previous == high)
            return;
    }
    invalid();
}
void initialize(int i) {
    write(FIELD_PARTICLE_EXTERNAL_WORK, i, 0.0);
    put(FIELD_CONTACT_COMPONENT, i, i);
    put(FIELD_COUNTS, i, 0);
    put(FIELD_CURSORS, i, 0);
    put(FIELD_COMPONENT_COUNTS, i, 0);
    put(FIELD_COMPONENT_CURSORS, i, 0);
    write(FIELD_REBOUND_SCALE, i, 1.0);
    dvec3 v = i < actual() ? dvec3(number(h(H_VELOCITY) + 6 * i), number(h(H_VELOCITY) + 6 * i + 2),
                                   number(h(H_VELOCITY) + 6 * i + 4))
                           : dvec3(0.0);
    writeVector(FIELD_SOURCE_VELOCITY, i, v);
    writeVector(FIELD_VELOCITY, i, v);
    writeVector(FIELD_COMPRESSED_VELOCITY, i, v);
}
bool validContact(int c) {
    int a = get(FIELD_FIRST, c), b = get(FIELD_SECOND, c);
    return a >= 0 && a < actual() && b >= -1 && b < actual() && a != b;
}
void prepareContact(int c) {
    write(FIELD_FIXED_WORK, c, 0.0);
    writeVector(FIELD_FIXED_REACTION, c, dvec3(0.0));
    if (c >= contacts())
        return;
    if (!validContact(c)) {
        invalid();
        return;
    }
    int a = get(FIELD_FIRST, c), b = get(FIELD_SECOND, c);
    dvec3 n = vector(FIELD_NORMAL, c);
    double norm = dot(n, n);
    if (!(norm > .999999 && norm < 1.000001 && mass(a) > 0.0 && (b < 0 || mass(b) > 0.0) &&
          read(FIELD_RESTITUTION, c) >= 0.0 && read(FIELD_RESTITUTION, c) <= 1.0 &&
          read(FIELD_STATIC_FRICTION, c) >= read(FIELD_DYNAMIC_FRICTION, c) &&
          read(FIELD_DYNAMIC_FRICTION, c) >= 0.0)) {
        invalid();
        return;
    }
    atomicAdd(words[at(FIELD_COUNTS) + a], 1u);
    if (b >= 0) {
        atomicAdd(words[at(FIELD_COUNTS) + b], 1u);
        join(a, b);
    }
    write(FIELD_NORMAL_IMPULSE, c, 0.0);
    write(FIELD_COMPRESSED_IMPULSE, c, 0.0);
    writeVector(FIELD_TANGENT_IMPULSE, c, dvec3(0.0));
    write(FIELD_FIXED_WORK, c, 0.0);
    writeVector(FIELD_FIXED_REACTION, c, dvec3(0.0));
}
void scatter(int c) {
    if (c >= contacts() || !validContact(c))
        return;
    int a = get(FIELD_FIRST, c), b = get(FIELD_SECOND, c);
    int first = int(atomicAdd(words[at(FIELD_CURSORS) + a], 1u));
    put(FIELD_ENTRIES, get(FIELD_OFFSETS, a) + first, c);
    if (b >= 0) {
        int second = int(atomicAdd(words[at(FIELD_CURSORS) + b], 1u));
        put(FIELD_ENTRIES, get(FIELD_OFFSETS, b) + second, c);
    }
}
void componentCount(int i) {
    if (i >= actual())
        return;
    int label = int(root(uint(i)));
    atomicExchange(words[at(FIELD_CONTACT_COMPONENT) + i], uint(label));
    atomicAdd(words[at(FIELD_COMPONENT_COUNTS) + label], 1u);
}
void componentScatter(int i) {
    if (i >= actual())
        return;
    int label = get(FIELD_CONTACT_COMPONENT, i), slot = int(atomicAdd(words[at(FIELD_COMPONENT_CURSORS) + label], 1u));
    put(FIELD_COMPONENT_MEMBERS, get(FIELD_COMPONENT_OFFSETS, label) + slot, i);
}
dvec3 relative(int field, int c) {
    int a = get(FIELD_FIRST, c), b = get(FIELD_SECOND, c);
    return b < 0 ? vector(field, a) - vector(FIELD_WALL_VELOCITY, c) : vector(field, b) - vector(field, a);
}
void proposal(int c) {
    if (c >= contacts() || !validContact(c))
        return;
    int a = get(FIELD_FIRST, c), b = get(FIELD_SECOND, c);
    dvec3 n = vector(FIELD_NORMAL, c), v = relative(FIELD_VELOCITY, c);
    double inverse = 1.0 / mass(a) + (b < 0 ? 0.0 : 1.0 / mass(b));
    double relaxation = 1.0 / double(max(get(FIELD_COUNTS, a), b < 0 ? 1 : get(FIELD_COUNTS, b)));
    double target =
        p.argument == 0 ? 0.0 : -read(FIELD_RESTITUTION, c) * min(0.0, dot(n, relative(FIELD_SOURCE_VELOCITY, c)));
    double old = read(FIELD_NORMAL_IMPULSE, c), next = max(0.0, old + (target - dot(n, v)) / inverse);
    write(FIELD_NORMAL_IMPULSE, c, old + relaxation * (next - old));
    if (p.argument == 1) {
        dvec3 tangent = vector(FIELD_TANGENT_IMPULSE, c), trial = tangent - (v - n * dot(n, v)) / inverse;
        double magnitude = length(trial), load = read(FIELD_NORMAL_IMPULSE, c);
        double scale = magnitude == 0.0 || magnitude <= read(FIELD_STATIC_FRICTION, c) * load
                           ? 1.0
                           : min(1.0, read(FIELD_DYNAMIC_FRICTION, c) * load / magnitude);
        writeVector(FIELD_TANGENT_IMPULSE, c, tangent + relaxation * (scale * trial - tangent));
    }
}
void reconstruct(int i) {
    if (i >= actual())
        return;
    dvec3 impulse = dvec3(0.0);
    double externalWork = 0.0;
    for (int j = get(FIELD_OFFSETS, i); j < get(FIELD_OFFSETS, i + 1); j++) {
        int c = get(FIELD_ENTRIES, j), b = get(FIELD_SECOND, c);
        double sign = b < 0 || b == i ? 1.0 : -1.0;
        impulse += sign * (read(FIELD_NORMAL_IMPULSE, c) * vector(FIELD_NORMAL, c) + vector(FIELD_TANGENT_IMPULSE, c));
        if (b < 0)
            externalWork += read(FIELD_FIXED_WORK, c);
    }
    dvec3 v = vector(FIELD_SOURCE_VELOCITY, i) + impulse / mass(i);
    writeVector(FIELD_VELOCITY, i, v);
    if (p.argument == 1) {
        write(FIELD_PARTICLE_EXTERNAL_WORK, i, externalWork);
        for (int a = 0; a < 3; a++)
            writeNumber(h(H_VELOCITY) + 6 * i + 2 * a, v[a]);
        writeNumber(h(H_FINAL_K) + 2 * i, .5 * mass(i) * dot(v, v));
    }
    if (any(isnan(v)) || any(isinf(v)))
        invalid();
}
void captureCompression(int id) {
    if (id < h(H_PARTICLE_CAPACITY))
        writeVector(FIELD_COMPRESSED_VELOCITY, id, vector(FIELD_VELOCITY, id));
    if (id < contacts())
        write(FIELD_COMPRESSED_IMPULSE, id, read(FIELD_NORMAL_IMPULSE, id));
}
void energyTerms(int i) {
    if (i >= actual())
        return;
    dvec3 source = vector(FIELD_SOURCE_VELOCITY, i), compressed = vector(FIELD_COMPRESSED_VELOCITY, i),
          delta = vector(FIELD_VELOCITY, i) - compressed;
    double m = mass(i);
    double available = .5 * m * dot(source - compressed, source + compressed), linear = m * dot(compressed, delta),
           quadratic = .5 * m * dot(delta, delta);
    for (int j = get(FIELD_OFFSETS, i); j < get(FIELD_OFFSETS, i + 1); j++) {
        int c = get(FIELD_ENTRIES, j);
        if (get(FIELD_SECOND, c) >= 0)
            continue;
        dvec3 wall = vector(FIELD_WALL_VELOCITY, c), n = vector(FIELD_NORMAL, c);
        available += read(FIELD_COMPRESSED_IMPULSE, c) * dot(wall, n);
        linear -= dot(wall, (read(FIELD_NORMAL_IMPULSE, c) - read(FIELD_COMPRESSED_IMPULSE, c)) * n +
                                vector(FIELD_TANGENT_IMPULSE, c));
    }
    writeVector(FIELD_ENERGY_TERMS, i, dvec3(available, linear, quadratic));
}
void budget(int label) {
    if (get(FIELD_COMPONENT_COUNTS, label) == 0)
        return;
    dvec3 terms = dvec3(0.0);
    for (int j = get(FIELD_COMPONENT_OFFSETS, label); j < get(FIELD_COMPONENT_OFFSETS, label + 1); j++)
        terms += vector(FIELD_ENERGY_TERMS, get(FIELD_COMPONENT_MEMBERS, j));
    double available = max(0.0, terms.x), linear = terms.y, quadratic = terms.z, scale = 1.0;
    if (linear + quadratic > available && quadratic > 0.0) {
        double rootValue = sqrt(linear * linear + 4.0 * quadratic * available);
        scale = clamp(linear >= 0.0 ? (available <= 0.0 ? 0.0 : 2.0 * available / (linear + rootValue))
                                    : (rootValue - linear) / (2.0 * quadratic),
                      0.0, 1.0);
    }
    if (!finite(scale))
        invalid();
    write(FIELD_REBOUND_SCALE, label, scale);
}
void limitRebound(int c) {
    if (c >= contacts() || !validContact(c))
        return;
    double scale = read(FIELD_REBOUND_SCALE, get(FIELD_CONTACT_COMPONENT, get(FIELD_FIRST, c)));
    double normal = mix(read(FIELD_COMPRESSED_IMPULSE, c), read(FIELD_NORMAL_IMPULSE, c), scale);
    dvec3 tangent = scale * vector(FIELD_TANGENT_IMPULSE, c);
    write(FIELD_NORMAL_IMPULSE, c, normal);
    writeVector(FIELD_TANGENT_IMPULSE, c, tangent);
    if (get(FIELD_SECOND, c) < 0) {
        dvec3 impulse = normal * vector(FIELD_NORMAL, c) + tangent;
        writeVector(FIELD_FIXED_REACTION, c, -impulse);
        write(FIELD_FIXED_WORK, c, dot(impulse, vector(FIELD_WALL_VELOCITY, c)));
    }
}
void main() {
    int id = int((gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x) * 128 + gl_LocalInvocationID.x);
    if (id >= p.count || errors != 0u)
        return;
    if (actual() < 0 || actual() > h(H_PARTICLE_CAPACITY) ||
        (p.stage != 11 && (contacts() < 0 || contacts() > h(H_CONTACT_CAPACITY)))) {
        invalid();
        return;
    }
    if (p.stage == 0)
        initialize(id);
    else if (p.stage == 1)
        prepareContact(id);
    else if (p.stage == 2)
        scatter(id);
    else if (p.stage == 3)
        componentCount(id);
    else if (p.stage == 4)
        componentScatter(id);
    else if (p.stage == 5)
        proposal(id);
    else if (p.stage == 6)
        reconstruct(id);
    else if (p.stage == 7)
        captureCompression(id);
    else if (p.stage == 8)
        energyTerms(id);
    else if (p.stage == 9)
        budget(id);
    else if (p.stage == 10)
        limitRebound(id);
    else if (p.stage == 11) {
        if (id < h(H_PARTICLE_CAPACITY)) {
            put(FIELD_INTERVAL_COMPONENT, id, id);
            write(FIELD_INTERVAL_PARTICLE_WORK, id, 0.0);
        }
        if (id < h(H_CONTACT_CAPACITY))
            write(FIELD_INTERVAL_FIXED_WORK, id, 0.0);
    } else if (p.stage == 12) {
        if (id < actual()) {
            dvec3 v = vector(FIELD_SOURCE_VELOCITY, id);
            for (int a = 0; a < 3; a++)
                writeNumber(h(H_VELOCITY) + 6 * id + 2 * a, v[a]);
            writeNumber(h(H_FINAL_K) + 2 * id, .5 * mass(id) * dot(v, v));
        }
    } else if (p.stage == 13) {
        if (id < actual())
            write(FIELD_INTERVAL_PARTICLE_WORK, id,
                  read(FIELD_INTERVAL_PARTICLE_WORK, id) + read(FIELD_PARTICLE_EXTERNAL_WORK, id));
        if (id < contacts()) {
            int a = get(FIELD_FIRST, id), b = get(FIELD_SECOND, id);
            if (b >= 0)
                intervalJoin(a, b);
            write(FIELD_INTERVAL_FIXED_WORK, id, read(FIELD_INTERVAL_FIXED_WORK, id) + read(FIELD_FIXED_WORK, id));
        }
    } else if (p.stage == 14) {
        if (id < actual())
            atomicExchange(words[at(FIELD_INTERVAL_COMPONENT) + id], intervalRoot(uint(id)));
    }
}
