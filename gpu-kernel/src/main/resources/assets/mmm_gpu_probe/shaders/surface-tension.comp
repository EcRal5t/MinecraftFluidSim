#version 450
#extension GL_ARB_gpu_shader_fp64 : require
layout(local_size_x=128) in;
layout(binding=0,std430) buffer Candidate { uint words[]; };
layout(binding=1,std430) buffer Errors { uint errors; };
layout(push_constant) uniform Params { int header; int stage; int pair; int reserved; float cellSize; float duration; } p;
int h(int i){return int(words[p.header+i]);}int field(int i){return h(32+i);}
double value(int at){return packDouble2x32(uvec2(words[at],words[at+1]));}
void store(int at,double v){if(isnan(v)||isinf(v))atomicOr(errors,262144u);uvec2 b=unpackDouble2x32(v);words[at]=b.x;words[at+1]=b.y;}
ivec3 shape(){return ivec3(h(0),h(1),h(2));}
ivec3 unit(int axis){ivec3 e=ivec3(0);e[axis]=1;return e;}
bool inside(ivec3 q){return all(greaterThanEqual(q,ivec3(0)))&&all(lessThan(q,shape()));}
int cell(ivec3 q){return (q.z*h(1)+q.y)*h(0)+q.x;}
ivec3 position(int c){return ivec3(c%h(0),c/h(0)%h(1),c/(h(0)*h(1)));}
int faceBase(int axis){return axis==0?0:(h(0)+1)*h(1)*h(2)+(axis==2?h(0)*(h(1)+1)*h(2):0);}
int face(ivec3 q,int axis){ivec3 s=shape()+unit(axis);return faceBase(axis)+(q.z*s.y+q.y)*s.x+q.x;}
double geometry(int c,int component){return value(h(5)+8*c+2*component);}
bool solid(int c){return geometry(c,2)<=0.0;}
double fill(int c){return geometry(c,3);}
dvec2 colour(int c,bool smoothed){int at=h(smoothed?16:15)+4*c;return dvec2(value(at),value(at+2));}
double normal(int c,int axis){return value(h(17)+6*c+2*axis);}
double cosine(int c){return value(h(21)+2*c);}
uint mask(int c){return words[h(8)+c];}
int phase(int stock){return int(words[h(10)+int(words[field(2)+stock])]);}
double phaseVolume(int c,int label){double result=0.0;for(int s=int(words[field(1)+c]);s<int(words[field(1)+c+1]);s++)if(phase(s)==label)result+=value(field(15)+2*s);return result;}
double invalid(){return double(uintBitsToFloat(0x7fc00000u));}
bool finiteValue(double x){return !isnan(x)&&!isinf(x);}
void initialise(int c){
    int dominant=-1,material=-1;double largest=-1.0;
    for(int s=int(words[field(1)+c]);s<int(words[field(1)+c+1]);s++){
        int m=int(words[field(2)+s]);if(m<0||m>=h(4)){atomicOr(errors,262144u);return;}
        int label=phase(s);double amount=phaseVolume(c,label);
        if(amount>largest||(amount==largest&&(dominant<0||label<dominant))){largest=amount;dominant=label;}
    }
    for(int m=0;m<h(4);m++)if(int(words[h(10)+m])==dominant){material=m;break;}
    store(h(15)+4*c,solid(c)?0.0:clamp(fill(c),0.0,1.0));store(h(15)+4*c+2,0.0);
    store(h(19)+2*c,0.0);store(h(20)+2*c,material<0?0.0:value(h(11)+2*material));
    store(h(21)+2*c,material<0?0.0:value(h(12)+2*material));
}
void pairColour(int c){
    double total=geometry(c,0);int first=int(words[h(13)+2*p.pair]),second=int(words[h(13)+2*p.pair+1]);
    store(h(15)+4*c,solid(c)||total<=0.0?0.0:phaseVolume(c,first)/total);
    store(h(15)+4*c+2,solid(c)||total<=0.0?0.0:phaseVolume(c,second)/total);
}
void smoothColour(int c){
    ivec3 q=position(c);dvec2 sum=dvec2(0.0);int count=0;
    for(int z=-1;z<=1;z++)for(int y=-1;y<=1;y++)for(int x=-1;x<=1;x++){
        ivec3 peer=q+ivec3(x,y,z);if(!inside(peer))continue;int sampledCell=cell(peer);if(solid(sampledCell))continue;
        sum+=colour(sampledCell,false);count++;
    }
    dvec2 result=count==0?colour(c,false):sum/double(count);store(h(16)+4*c,result.x);store(h(16)+4*c+2,result.y);
}
void normals(int c){
    dvec3 n=dvec3(0.0);ivec3 q=position(c);
    if(!solid(c))for(int axis=0;axis<3;axis++){
        dvec2 plus=colour(cell(clamp(q+unit(axis),ivec3(0),shape()-1)),true),minus=colour(cell(clamp(q-unit(axis),ivec3(0),shape()-1)),true);
        n[axis]=p.pair<0?plus.x-minus.x:minus.x*plus.y-plus.x*minus.y;
    }
    double magnitude=length(n);n=magnitude>0.0?n/magnitude:dvec3(0,0,1);
    for(int axis=0;axis<3;axis++)store(h(17)+6*c+2*axis,n[axis]);
}
vec4 plane(int c){int at=h(7)+8*c;return vec4(value(at),value(at+2),value(at+4),value(at+6));}
// Analytic area of the same source PLIC plane on one fixed open half-face.
float portArea(int c,int axis,int side,int a,int b){
    float wet=float(fill(c));if(wet<=0)return 0;if(wet>=1)return .25;
    vec4 plic=plane(c);int tangent=(axis+1)%3,other=(axis+2)%3;
    vec2 n=vec2(plic[tangent],plic[other]);float offset=plic.w-float(side)*plic[axis]-dot(n,vec2(a,b)*.5);
    offset-=dot(min(n,vec2(0)),vec2(.5));vec2 widths=abs(n)*.5;
    if(widths.x>widths.y){float swap=widths.x;widths.x=widths.y;widths.y=swap;}
    float total=widths.x+widths.y;if(total==0)return offset>=0?.25:0;
    if(offset<=0)return 0;if(offset>=total)return .25;
    bool complement=offset>total*.5;if(complement)offset=total-offset;
    float fraction=widths.x==0?offset/widths.y:offset<=widths.x?.5*(offset/widths.x)*(offset/widths.y):(offset-.5*widths.x)/widths.y;
    return .25*clamp(complement?1-fraction:fraction,0.0,1.0);
}
double wallWet(ivec3 q,int axis,int side){
    int c=cell(q);ivec3 peer=q+unit(axis)*(2*side-1);uint other=inside(peer)?mask(cell(peer)):255u;
    double area=0.0,wet=0.0;int tangent=(axis+1)%3,remaining=(axis+2)%3;
    for(int a=0;a<2;a++)for(int b=0;b<2;b++){
        int bit=(side<<axis)|(a<<tangent)|(b<<remaining);
        if((mask(c)&(1u<<bit))!=0u||(other&(1u<<(bit^(1<<axis))))==0u)continue;
        area+=.25;wet+=double(portArea(c,axis,side,a,b));
    }
    return area>0.0?wet/area:-1.0;
}
bool contactLine(ivec3 q,int axis,int side,double wet){
    if(wet<1.0)return true;
    for(int tangent=0;tangent<3;tangent++)if(tangent!=axis)for(int direction=-1;direction<=1;direction+=2){
        ivec3 peer=q+unit(tangent)*direction;if(!inside(peer))continue;
        int f=face(q+(direction>0?unit(tangent):ivec3(0)),tangent);if(value(h(6)+8*f+4)<=0.0)continue;
        double adjacent=wallWet(peer,axis,side);if(adjacent>=0.0&&adjacent<1.0)return true;
    }
    return false;
}
double neighborNormal(ivec3 q,int axis,int side){
    ivec3 peer=q+unit(axis)*(2*side-1);int c=cell(q),sampledCell=cell(clamp(peer,ivec3(0),shape()-1));double local=normal(c,axis);
    if(p.pair<0){
        int f=face(q+(side==1?unit(axis):ivec3(0)),axis);double open=inside(peer)?value(h(6)+8*f+4):0.0;
        if(open<1.0){double wet=wallWet(q,axis,side),wall=wet<=0.0?0.0:contactLine(q,axis,side,wet)?double(2*side-1)*cosine(c):local;
            return open*normal(sampledCell,axis)+(1.0-open)*(2.0*wall-local);}
    }
    return inside(peer)&&solid(sampledCell)?local:normal(sampledCell,axis);
}
int reflect(int position,int size){int r=((position%(2*size))+2*size)%(2*size);return r<size?r:2*size-1-r;}
ivec3 reflected(ivec3 q){return ivec3(reflect(q.x,h(0)),reflect(q.y,h(1)),reflect(q.z,h(2)));}
double heightSample(ivec3 q,int axis,int offset){
    q+=unit(axis)*offset;bool exterior=!inside(q);int c=cell(reflected(q));
    if(mask(c)!=0u||geometry(c,2)!=1.0)return invalid();
    double result=fill(c);if(exterior&&result>0.0&&cosine(c)!=0.0)return invalid();return result;
}
bool wetFace(ivec3 q,int axis,int offset,int side,int orientation){
    double wet=heightSample(q,axis,offset);if(!(wet>0.0))return false;if(wet==1.0)return true;
    q+=unit(axis)*offset;int r=((q[axis]%(2*shape()[axis]))+2*shape()[axis])%(2*shape()[axis]);
    if(r>=shape()[axis]){side=1-side;orientation=-orientation;}
    int c=cell(reflected(q));if(geometry(c,0)!=wet)return false;vec4 pl=plane(c);double n=double(pl[axis]);
    if(orientation!=0&&n*double(orientation)<=0.0)return false;
    return n*double(side)+max(double(pl[(axis+1)%3]),0.0)+max(double(pl[(axis+2)%3]),0.0)<=double(pl.w);
}
bool wallBase(ivec3 q,int axis,int offset,int side,int target){
    q+=unit(axis)*offset;if(!((side==0&&q[axis]==0)||(side==1&&q[axis]==shape()[axis]-1)))return false;
    int c=cell(reflected(q));if(cosine(target)!=0.0||cosine(c)!=0.0||geometry(c,0)!=fill(c))return false;
    for(int a=0;a<2;a++)for(int b=0;b<2;b++)if(portArea(c,axis,side,a,b)>0.0)return true;
    return false;
}
double heightColumn(ivec3 q,int axis,int orientation,int target){
    int gas=0,base=0;bool gasFound=false,baseFound=false;
    for(int distance=0;distance<=5;distance++){
        if(!gasFound){double wet=heightSample(q,axis,orientation*distance);if(!finiteValue(wet))return invalid();if(wet==0.0){gas=orientation*distance;gasFound=true;}}
        if(!baseFound){int endpoint=-orientation*distance,side=orientation>0?0:1;double wet=heightSample(q,axis,endpoint);if(!finiteValue(wet))return invalid();
            if(wet==1.0||(wet>0.0&&(wallBase(q,axis,endpoint,side,target)||(wetFace(q,axis,endpoint,side,orientation)&&wetFace(q,axis,endpoint-orientation,1-side,0))))){base=endpoint;baseFound=true;}}
        if(gasFound&&baseFound)break;
    }
    if(!gasFound||!baseFound||orientation*(gas-base)<=0)return invalid();
    bool partial=heightSample(q,axis,base)<1.0;double sum=0.0,previous=1.0;
    for(int offset=base+(partial?0:orientation);offset!=gas;offset+=orientation){double wet=heightSample(q,axis,offset);if(!finiteValue(wet)||wet>previous)return invalid();sum+=wet;previous=wet;}
    return double(q[axis]+base+(partial?(orientation>0?0:1):(orientation>0?1:0)))+double(orientation)*sum;
}
double heightCurvature(ivec3 q){
    dvec3 gradient;for(int axis=0;axis<3;axis++){gradient[axis]=heightSample(q,axis,1)-heightSample(q,axis,-1);if(!finiteValue(gradient[axis]))return invalid();}
    int target=cell(q);double wet=fill(target);
    if(all(equal(gradient,dvec3(0.0)))){
        bool same=wet==0.0||wet==1.0;
        for(int a=0;a<3;a++)same=same&&heightSample(q,a,1)==wet&&heightSample(q,a,-1)==wet;
        return same?0.0:invalid();
    }
    int used=0;
    for(int attempt=0;attempt<3;attempt++){
        int axis=-1;double largest=0.0;for(int a=0;a<3;a++)if((used&(1<<a))==0&&abs(gradient[a])>largest){axis=a;largest=abs(gradient[a]);}
        if(axis<0)break;used|=1<<axis;int orientation=gradient[axis]<0.0?1:-1;double heights[9];bool valid=true;
        for(int i=-1;i<=1&&valid;i++)for(int j=-1;j<=1;j++){
            double height=heightColumn(q+unit((axis+1)%3)*i+unit((axis+2)%3)*j,axis,orientation,target);
            heights[(i+1)*3+j+1]=height;if(!finiteValue(height)){valid=false;break;}
        }
        if(!valid)continue;
        double hx=.5*(heights[7]-heights[1]),hy=.5*(heights[5]-heights[3]),hxx=heights[7]-2.0*heights[4]+heights[1];
        double hyy=heights[5]-2.0*heights[4]+heights[3],hxy=.25*(heights[8]+heights[0]-heights[6]-heights[2]),square=1.0+hx*hx+hy*hy;
        return -double(orientation)*(hxx*(1.0+hy*hy)+hyy*(1.0+hx*hx)-2.0*hxy*hx*hy)/(square*sqrt(square)*double(p.cellSize));
    }
    return invalid();
}
void curvature(int c){
    double result=0.0;
    if(!solid(c)&&geometry(c,0)>0.0){
        ivec3 q=position(c);result=p.pair<0?heightCurvature(q):invalid();
        if(!finiteValue(result)){result=0.0;for(int axis=0;axis<3;axis++)result-=neighborNormal(q,axis,1)-neighborNormal(q,axis,0);result*=.5/double(p.cellSize);}
    }
    store(h(18)+2*c,result);if(p.pair<0)store(h(19)+2*c,value(h(20)+2*c)*result);
}
void applyFace(int index){
    int axis=index<faceBase(1)?0:index<faceBase(2)?1:2,local=index-faceBase(axis);ivec3 size=shape()+unit(axis);
    ivec3 right=ivec3(local%size.x,local/size.x%size.y,local/(size.x*size.y)),left=right-unit(axis);
    if(!inside(left)||!inside(right))return;int at=h(6)+8*index;
    if(h(9)>=0&&(int(words[h(9)+index])&3)!=1)return;
    double mass=value(at),open=value(at+4),wet=value(at+6);if(mass<=0.0||open<=0.0||wet<=0.0)return;
    int a=cell(left),b=cell(right);double difference;
    if(p.pair<0){
        double first=fill(a)>0.0?value(h(19)+2*a):value(h(19)+2*b),second=fill(b)>0.0?value(h(19)+2*b):first;
        difference=.5*(fill(a)+fill(b))*(first-second);
    }else{
        if(geometry(a,0)<=0.0||geometry(b,0)<=0.0)return;dvec2 first=colour(a,true),second=colour(b,true);
        difference=value(h(14)+2*p.pair)*.5*(value(h(18)+2*a)+value(h(18)+2*b))*(first.x*second.y-second.x*first.y);
    }
    double length=double(p.cellSize);store(at+2,value(at+2)+double(p.duration)*length*length*wet/mass*difference);
}
void main(){
    int item=int((gl_WorkGroupID.y*gl_NumWorkGroups.x+gl_WorkGroupID.x)*128u+gl_LocalInvocationID.x);if(errors!=0u)return;
    if(p.stage==4){if(item<faceBase(2)+h(0)*h(1)*(h(2)+1))applyFace(item);return;}
    if(item>=h(3))return;
    if(p.stage==0)initialise(item);else if(p.stage==1)smoothColour(item);else if(p.stage==2)normals(item);else if(p.stage==3)curvature(item);else pairColour(item);
}
