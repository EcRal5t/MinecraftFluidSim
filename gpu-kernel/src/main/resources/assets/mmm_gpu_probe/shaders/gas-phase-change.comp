#version 450
#extension GL_ARB_gpu_shader_fp64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_atomic_int64 : require
layout(local_size_x = 128) in;
layout(binding = 0, std430) buffer Arena {
    uint words[];
};
layout(binding = 1, std430) buffer Errors {
    uint errors;
};
layout(binding = 2, std430) buffer AtomicArena {
    int64_t longs[];
};
layout(push_constant) uniform Params {
    int header;
    int stage;
    int count;
    int maximum;
}
p;
bool activeCell(int cell);
bool activeFace(int face);
// PHASE_ROWS_LIBRARY
// HOST_LAYOUT
int h(int i) {
    return int(words[p.header + i]);
}
int f(int i) {
    return h(WORK_FIELDS + i);
}
int eh(int i) {
    return int(words[h(H_GAS_HEADER) + i]);
}
int gh(int i) {
    return int(words[h(H_GEOMETRY_HEADER) + i]);
}
int th(int i) {
    return int(words[h(H_LIQUID_CALORIC) + i]);
}
int gas(int i) {
    return eh(GAS_FIELDS+i);
}
int source(int i) {
    return lpS(h(H_PHASE_ROWS_HEADER), i);
}
int row(int c, int m) {
    return c * h(H_MATERIAL_COUNT) + m;
}
double value(int at) {
    return lpDouble(at);
}
void put(int at, double x) {
    lpDoubleAt(at, x);
}
int64_t quantity(int at) {
    return lpInt(at);
}
void putq(int at, int64_t x) {
    lpIntAt(at, x);
}
bool finite(double x) {
    return !isnan(x) && !isinf(x);
}
void invalid() {
    atomicOr(errors, 33554432u);
}
int64_t addq(int64_t a, int64_t b) {
    const int64_t limit = 0x7fffffffffffffffl;
    if (b > 0l && a > limit - b || b < 0l && a < (-limit - 1l) - b) {
        invalid();
        return a;
    }
    return a + b;
}
u64vec2 mul128(uint64_t a, uint64_t b) {
    uint64_t mask = 0xffffffffUL, low = (a & mask) * (b & mask), t = (a >> 32) * (b & mask) + (low >> 32),
             mid = (t & mask) + (a & mask) * (b >> 32);
    return u64vec2((mid << 32) | (low & mask), (a >> 32) * (b >> 32) + (t >> 32) + (mid >> 32));
}
bool lessEqual(u64vec2 a, u64vec2 b) {
    return a.y < b.y || a.y == b.y && a.x <= b.x;
}
int64_t portion(int64_t a, int64_t b, int64_t total) {
    if (a == 0l || b == 0l)
        return 0l;
    if (b == total)
        return a;
    uint64_t q = min(uint64_t(a), uint64_t(floor(double(a) * (double(b) / double(total)))));
    u64vec2 target = mul128(uint64_t(a), uint64_t(b));
    while (!lessEqual(mul128(q, uint64_t(total)), target))
        q--;
    while (q < uint64_t(a) && lessEqual(mul128(q + 1UL, uint64_t(total)), target))
        q++;
    return int64_t(q);
}
int rule(int c) {
    return f(FIELD_RULES) + 12 * int(words[f(FIELD_RULE) + c]);
}
int component(int node, int m) {
    return node * eh(GAS_H_COMPONENT_COUNT) + m;
}
int gasSpecies(int comp, int s) {
    for (int a = int(words[gas(GAS_COMPONENT_SPECIES_OFFSETS) + comp]); a < int(words[gas(GAS_COMPONENT_SPECIES_OFFSETS) + comp + 1]); a++)
        if (int(words[gas(GAS_SPECIES_HANDLES) + a]) == s)
            return a;
    return -1;
}
double state(int n, int k) {
    return value(eh(GAS_H_STATES) + 18 * n + 2 * k);
}
double massUnit() {
    return 1e-10LF;
}
double specificLiquid(int m, double t) {
    double u = value(th(CAL_MATERIAL_REFERENCE) + 2 * m) + value(th(CAL_COLD_SENSIBLE) + 2 * m), lower = value(h(H_LIQUID_CALORIC) + CAL_MINIMUM_TEMPERATURE);
    int end = int(words[th(CAL_SEGMENT_OFFSETS) + m + 1]);
    for (int a = int(words[th(CAL_SEGMENT_OFFSETS) + m]); a < end && lower < t; a++) {
        double upper = a == end - 1 ? t : min(t, value(th(CAL_SEGMENT_UPPER) + 2 * a));
        u += (upper - lower) * value(th(CAL_SEGMENT_CAPACITY) + 2 * a);
        lower = upper;
    }
    return u;
}
double specificGas(int m, double t) {
    double u = value(eh(GAS_H_ANCHOR_ENERGY) + 2 * m), anchor = 293.15LF, low = min(t, anchor), high = max(t, anchor),
           edge = value(h(H_LIQUID_CALORIC) + CAL_MINIMUM_TEMPERATURE), integral = 0.0;
    int end = int(words[eh(GAS_H_SEGMENT_OFFSETS) + m + 1]);
    for (int a = int(words[eh(GAS_H_SEGMENT_OFFSETS) + m]); a < end && edge < high; a++) {
        double upper = a == end - 1 ? high : min(high, value(eh(GAS_H_SEGMENT_UPPER) + 2 * a));
        integral += max(0.0LF, upper - max(edge, low)) * value(eh(GAS_H_SEGMENT_CAPACITY) + 2 * a);
        edge = upper;
    }
    return u + (t >= anchor ? integral : -integral);
}
double liquidCold(int lr, int material) {
    double u = double(lpMass(h(H_PHASE_ROWS_HEADER), lr)) * massUnit() *
               specificLiquid(material, value(h(H_LIQUID_CALORIC) + CAL_MINIMUM_TEMPERATURE));
    for (int sp = 0; sp < h(H_SPECIES_COUNT); sp++) {
        int64_t q = lpSpecies(h(H_PHASE_ROWS_HEADER), lr, sp);
        if (q > 0l)
            u += double(q) * value(th(CAL_SPECIES_REFERENCE) + 2 * (material * th(CAL_SPECIES_STRIDE) + sp));
    }
    return u;
}
// Check the actual integer species portion, including both phase reference energies.
bool canBoil(int lr, int material, int vapor, int comp, int64_t mass, int64_t available, double t) {
    int64_t original = lpMass(h(H_PHASE_ROWS_HEADER), lr);
    double cold = value(h(H_LIQUID_CALORIC) + CAL_MINIMUM_TEMPERATURE), gasReference = 0.0, liquidReference = 0.0;
    for (int sp = 0; sp < h(H_SPECIES_COUNT); sp++) {
        int64_t q = lpSpecies(h(H_PHASE_ROWS_HEADER), lr, sp),
                moved = gasSpecies(comp, sp) < 0 ? 0l : portion(q, mass, available);
        if (moved > 0l)
            gasReference += double(moved) * value(eh(GAS_H_SPECIES_REFERENCE) + 2 * (vapor * eh(GAS_H_SPECIES_STRIDE) + sp));
        if (q > moved)
            liquidReference += double(q - moved) * value(th(CAL_SPECIES_REFERENCE) + 2 * (material * th(CAL_SPECIES_STRIDE) + sp));
    }
    double before = lpEnergy(h(H_PHASE_ROWS_HEADER), lr);
    if (mass == original)
        return before >= double(mass) * massUnit() * specificGas(vapor, cold) + gasReference;
    double transferred = double(mass) * massUnit() * specificGas(vapor, t) + gasReference;
    return before - transferred >=
           double(original - mass) * massUnit() * specificLiquid(material, cold) + liquidReference;
}
ivec3 shape() {
    return ivec3(lpH(h(H_PHASE_ROWS_HEADER), LP_H_SIZE_X), lpH(h(H_PHASE_ROWS_HEADER), LP_H_SIZE_Y), lpH(h(H_PHASE_ROWS_HEADER), LP_H_SIZE_Z));
}
int cell(ivec3 q) {
    ivec3 s = shape();
    return any(lessThan(q, ivec3(0))) || any(greaterThanEqual(q, s)) ? -1 : (q.z * s.y + q.y) * s.x + q.x;
}
int nodeAt(int c) {
    if (c < 0)
        return -1;
    for (int i = 0; i < 8; i++) {
        int n = int(words[gas(GAS_PIECE_NODE_ORDINAL) + 8 * c + i]);
        if (n > 0)
            return n - 1;
    }
    return -1;
}
int interfaceNode(int c) {
    int n = nodeAt(c);
    if (n >= 0)
        return n;
    ivec3 s = shape(), q = ivec3(c % s.x, c / s.x % s.y, c / (s.x * s.y));
    for (int axis = 0; axis < 3; axis++)
        for (int side = -1; side <= 1; side += 2) {
            ivec3 z = q;
            z[axis] += side;
            int other = cell(z);
            if (other < 0)
                continue;
            int mask = int(words[gh(GEO_H_MASKS) + c]), om = int(words[gh(GEO_H_MASKS) + other]);
            bool open = false;
            for (int micro = 0; micro < 8; micro++)
                if (((micro >> axis) & 1) == (side > 0 ? 1 : 0) && ((mask >> micro) & 1) == 0 &&
                    ((om >> (micro ^ (1 << axis))) & 1) == 0)
                    open = true;
            if (open && (n = nodeAt(other)) >= 0)
                return n;
        }
    return -1;
}
void initialize(int i) {
    if (i < h(H_GROUP_COUNT))
        words[f(FIELD_HEAD) + i] = uint(-1);
    if (i < h(H_CELL_COUNT)) {
        words[f(FIELD_NEXT) + i] = uint(-1);
        words[f(FIELD_RULE) + i] = uint(-1);
        words[f(FIELD_NODE) + i] = uint(-1);
        words[f(FIELD_BIRTH_NODE) + i] = uint(nodeAt(i) + 1);
        words[f(FIELD_DESIRED) + i] = 0u;
        words[f(FIELD_BATCHES) + i] = 0u;
        put(f(FIELD_GAS_TRANSFER) + 2 * i, 0.0);
        put(f(FIELD_PE_WORK) + 2 * i, 0.0);
        int64_t mass = 0l;
        for (int m = 0; m < h(H_MATERIAL_COUNT); m++)
            mass = addq(mass, lpMass(h(H_PHASE_ROWS_HEADER), row(i, m)));
        putq(f(FIELD_OLD_MASS) + 2 * i, mass);
        putq(f(FIELD_NEW_MASS) + 2 * i, mass);
    }
    if (i < eh(GAS_H_NODE_CAPACITY)) {
        double u = i < int(words[gas(GAS_COUNTS)]) ? value(gas(GAS_INTERNAL_ENERGY) + 2 * i) : 0.0LF;
        put(f(FIELD_OLD_GAS_U) + 2 * i, u);
        put(f(FIELD_NEW_GAS_U) + 2 * i, u);
    }
    if (i == 0)
        for (int j = 0; j < 8; j++)
            words[f(FIELD_CONTROL) + j] = 0u;
}
void propose(int c) {
    if (!activeCell(c))
        return;
    if (words[h(H_PHASE_MOTION_CELLS) + c] != 0u || p.maximum <= 0)
        return;
    int node = interfaceNode(c);
    if (node < 0)
        return;
    double best = 0.0;
    int selected = -1;
    bool boil = false;
    int64_t limit = 0l;
    double wanted = 0.0, selectedT = 0.0, selectedSat = 0.0, selectedPartial = 0.0, selectedResponse = 0.0;
    double tg = state(node, 0), volume = value(eh(GAS_H_NODE_VOLUMES) + 2 * node);
    if (!(tg > 0.0 && volume > 0.0))
        return;
    for (int k = 0; k < h(H_RULE_COUNT); k++) {
        int r = f(FIELD_RULES) + 12 * k, m = int(words[r]), comp = component(node, int(words[r + 1])), lr = row(c, m);
        int64_t mass = lpMass(h(H_PHASE_ROWS_HEADER), lr), bm = quantity(r + 2), svq = quantity(r + 4),
                nanos = quantity(r + 6);
        double t = mass > 0l ? value(th(CAL_CELL_TEMPERATURES) + 2 * c) : tg;
        if (!(t > 0.0 && bm > 0l && nanos > 0l))
            continue;
        double saturation = 101325.0LF * exp(float(value(r + 10) * (1.0LF / value(r + 8) - 1.0LF / t)));
        if (!finite(saturation)) {
            invalid();
            return;
        }
        double partial = double(quantity(gas(GAS_STANDARD_VOLUME_NANOS) + 2 * comp)) * 1e-9LF * (101325.0LF / 293.15LF) * tg / volume,
               diff = saturation - partial;
        bool b = diff > 0.0;
        if (diff == 0.0 || !b && nodeAt(c) != node)
            continue;
        double batchVolume = double(svq) * exp2(-27.0),
               normalized = batchVolume / pow(float(value(p.header + H_CELL_SIZE)), 3.0);
        int64_t high = int64_t(p.maximum);
        double carried = specificGas(int(words[r + 1]), b ? t : tg), liquid = specificLiquid(m, t),
               cold = specificLiquid(m, value(h(H_LIQUID_CALORIC) + CAL_MINIMUM_TEMPERATURE));
        if (b) {
            int64_t available = 0l;
            bool all = true;
            for (int sp = 0; sp < h(H_SPECIES_COUNT); sp++) {
                int64_t q = lpSpecies(h(H_PHASE_ROWS_HEADER), lr, sp);
                if (q == 0l)
                    continue;
                int gs = gasSpecies(comp, sp);
                if (gs < 0)
                    all = false;
                else {
                    int d = lpH(h(H_PHASE_ROWS_HEADER), LP_H_DEFINITIONS);
                    available = addq(available, q * quantity(d + int(words[d + 1]) + 5 * sp + 1));
                }
            }
            if (all)
                available = mass;
            high = min(high, available / bm);
            high = min(high, int64_t(max(0.0LF, floor(lpVolume(h(H_PHASE_ROWS_HEADER), lr) / normalized))));
            double budget = lpEnergy(h(H_PHASE_ROWS_HEADER), lr) - liquidCold(lr, m),
                   cost = (carried - cold) * double(bm) * massUnit();
            if (cost > 0.0)
                high = min(high, int64_t(max(0.0LF, floor(budget / cost))));
            while (high > 0l && !canBoil(lr, m, int(words[r + 1]), comp, high * bm, available, t))
                high--;
        } else {
            high = min(high, min(quantity(gas(GAS_MASS_UNITS) + 2 * comp) / bm, quantity(gas(GAS_STANDARD_VOLUME_NANOS) + 2 * comp) / nanos));
            high = min(high, int64_t(max(0.0LF, floor(value(gh(GEO_H_DRY_VOLUMES) + 2 * c) / batchVolume))));
        }
        if (high <= 0l)
            continue;
        double kg = double(bm) * massUnit(), cv = mass > 0l ? value(th(CAL_CELL_HEAT_CAPACITIES) + 2 * c) : state(node, 3),
               latent = max(0.0LF, carried - liquid);
        double response = (double(nanos) * 1e-9LF * (101325.0LF / 293.15LF) * tg - partial * batchVolume) / volume;
        if (cv > 0.0)
            response += saturation * value(r + 10) / (t * t) * latent * kg / cv;
        double demand = response > 0.0 ? min(double(high), abs(diff) / response) : double(high);
        if (demand >= 1.0 && abs(diff) > best) {
            best = abs(diff);
            selected = k;
            boil = b;
            limit = high;
            wanted = demand;
            selectedT = t;
            selectedSat = saturation;
            selectedPartial = partial;
            selectedResponse = max(0.0LF, response);
        }
    }
    if (selected < 0)
        return;
    int group = component(node, int(words[f(FIELD_RULES) + 12 * selected + 1]));
    words[f(FIELD_RULE) + c] = uint(selected);
    words[f(FIELD_NODE) + c] = uint(node);
    words[f(FIELD_BOIL) + c] = boil ? 1u : 0u;
    putq(f(FIELD_LIMIT) + 2 * c, limit);
    put(f(FIELD_KG) + 2 * c, wanted);
    put(f(FIELD_TEMP) + 2 * c, selectedT);
    put(f(FIELD_GAS_TEMP) + 2 * c, tg);
    put(f(FIELD_SATURATION) + 2 * c, selectedSat);
    put(f(FIELD_PARTIAL) + 2 * c, selectedPartial);
    put(f(FIELD_GAS_RESPONSE) + 2 * c, selectedResponse);
    words[f(FIELD_NEXT) + c] = atomicExchange(words[f(FIELD_HEAD) + group], uint(c));
}
// The chamber shares its finite vapor stock and saturation demand across cell proposals.
void limitGroup(int group) {
    int first = int(words[f(FIELD_HEAD) + group]);
    if (first < 0)
        return;
    double positive = 0.0, negative = 0.0, highest = 0.0, lowest = 1.7976931348623157e308,
           initial = value(f(FIELD_PARTIAL) + 2 * first), massNeed = 0.0, nanosNeed = 0.0;
    for (int c = first; c >= 0; c = int(words[f(FIELD_NEXT) + c])) {
        double n = value(f(FIELD_KG) + 2 * c), response = n * value(f(FIELD_GAS_RESPONSE) + 2 * c);
        highest = max(highest, value(f(FIELD_SATURATION) + 2 * c));
        lowest = min(lowest, value(f(FIELD_SATURATION) + 2 * c));
        if (words[f(FIELD_BOIL) + c] != 0u)
            positive += response;
        else {
            negative += response;
            massNeed += n * double(quantity(rule(c) + 2));
            nanosNeed += n * double(quantity(rule(c) + 6));
        }
    }
    double bp = positive > 0.0 ? min(1.0LF, max(0.0LF, highest - initial + negative) / positive) : 1.0LF;
    double cp = negative > 0.0 ? min(1.0LF, max(0.0LF, initial + positive * bp - lowest) / negative) : 1.0LF;
    int64_t stockMass = quantity(gas(GAS_MASS_UNITS) + 2 * group), stockNanos = quantity(gas(GAS_STANDARD_VOLUME_NANOS) + 2 * group),
            batchMass = quantity(rule(first) + 2), batchNanos = quantity(rule(first) + 6);
    bool exhaustible = stockMass % batchMass == 0l && stockNanos % batchNanos == 0l &&
                       stockMass / batchMass == stockNanos / batchNanos;
    for (int c = first; c >= 0; c = int(words[f(FIELD_NEXT) + c]))
        if (words[f(FIELD_BOIL) + c] == 0u) {
            u64vec2 a = mul128(uint64_t(quantity(rule(c) + 2)), uint64_t(batchNanos)),
                    b = mul128(uint64_t(quantity(rule(c) + 6)), uint64_t(batchMass));
            exhaustible = exhaustible && all(equal(a, b));
        }
    // A finite component has both mass and standard volume, or neither.
    int64_t massBudget = max(0l, stockMass - (exhaustible ? 0l : 1l)),
            nanosBudget = max(0l, stockNanos - (exhaustible ? 0l : 1l));
    if (massNeed > 0.0)
        cp = min(cp, double(massBudget) / massNeed);
    if (nanosNeed > 0.0)
        cp = min(cp, double(nanosBudget) / nanosNeed);
    for (int c = first; c >= 0; c = int(words[f(FIELD_NEXT) + c]))
        words[f(FIELD_DESIRED) + c] =
            uint(floor(value(f(FIELD_KG) + 2 * c) * (words[f(FIELD_BOIL) + c] != 0u ? bp : cp)));
}
void budget(int c) {
    uint total = words[f(FIELD_OFFSETS) + h(H_CELL_COUNT)], begin = words[f(FIELD_OFFSETS) + c],
         end = words[f(FIELD_OFFSETS) + c + 1], allowed = min(total, uint(p.maximum));
    words[f(FIELD_BATCHES) + c] = total == 0u ? 0u
                                              : uint(uint64_t(end) * uint64_t(allowed) / uint64_t(total) -
                                                     uint64_t(begin) * uint64_t(allowed) / uint64_t(total));
}
void exchange(int node) {
    if (node >= int(words[gas(GAS_COUNTS)]))
        return;
    double energy = value(gas(GAS_INTERNAL_ENERGY) + 2 * node);
    for (int m = 0; m < eh(GAS_H_COMPONENT_COUNT); m++) {
        int comp = component(node, m);
        for (int c = int(words[f(FIELD_HEAD) + comp]); c >= 0; c = int(words[f(FIELD_NEXT) + c])) {
            int64_t batches = int64_t(words[f(FIELD_BATCHES) + c]);
            if (batches == 0l)
                continue;
            int r = rule(c), material = int(words[r]), lr = row(c, material);
            bool boiling = words[f(FIELD_BOIL) + c] != 0u;
            int64_t mass = batches * quantity(r + 2), nanos = batches * quantity(r + 6),
                    delta = batches * quantity(r + 4), original = lpMass(h(H_PHASE_ROWS_HEADER), lr);
            double t = value(f(FIELD_TEMP) + 2 * c), tg = value(f(FIELD_GAS_TEMP) + 2 * c);
            int64_t available = boiling ? original : quantity(gas(GAS_MASS_UNITS) + 2 * comp);
            if (!boiling && (mass > available || nanos > quantity(gas(GAS_STANDARD_VOLUME_NANOS) + 2 * comp))) {
                invalid();
                return;
            }
            double transferred = double(mass) * massUnit() * specificGas(m, boiling ? t : tg);
            int64_t movedSpeciesMass = 0l;
            int def = lpH(h(H_PHASE_ROWS_HEADER), LP_H_DEFINITIONS);
            if (boiling) {
                bool all = true;
                int64_t selectedMass = 0l;
                for (int sp = 0; sp < h(H_SPECIES_COUNT); sp++) {
                    int64_t q = lpSpecies(h(H_PHASE_ROWS_HEADER), lr, sp);
                    if (q == 0l)
                        continue;
                    if (gasSpecies(comp, sp) < 0)
                        all = false;
                    else
                        selectedMass = addq(selectedMass, q * quantity(def + int(words[def + 1]) + 5 * sp + 1));
                }
                if (!all)
                    available = selectedMass;
            }
            if (available < mass) {
                invalid();
                return;
            }
            for (int a = int(words[gas(GAS_COMPONENT_SPECIES_OFFSETS) + comp]); a < int(words[gas(GAS_COMPONENT_SPECIES_OFFSETS) + comp + 1]); a++) {
                int sp = int(words[gas(GAS_SPECIES_HANDLES) + a]);
                int64_t q = boiling ? lpSpecies(h(H_PHASE_ROWS_HEADER), lr, sp) : quantity(gas(GAS_SPECIES_AMOUNTS) + 2 * a),
                        moved = portion(q, mass, available);
                if (moved == 0l)
                    continue;
                double offset = value(eh(GAS_H_SPECIES_REFERENCE) + 2 * (m * eh(GAS_H_SPECIES_STRIDE) + sp));
                if (!finite(offset)) {
                    invalid();
                    return;
                }
                transferred += double(moved) * offset;
                movedSpeciesMass = addq(movedSpeciesMass, moved * quantity(def + int(words[def + 1]) + 5 * sp + 1));
                lpSpeciesAt(h(H_PHASE_ROWS_HEADER), lr, sp,
                            addq(lpSpecies(h(H_PHASE_ROWS_HEADER), lr, sp), boiling ? -moved : moved));
                putq(gas(GAS_SPECIES_AMOUNTS) + 2 * a, addq(quantity(gas(GAS_SPECIES_AMOUNTS) + 2 * a), boiling ? moved : -moved));
                int auditComp = component(int(words[gas(GAS_COUNTS)]) + (boiling ? 2 : 3), m),
                    auditEntry = gasSpecies(auditComp, sp);
                atomicAdd(longs[(gas(GAS_SPECIES_AMOUNTS) + 2 * auditEntry) / 2], moved);
            }
            int64_t remaining = boiling ? original - mass : original + mass;
            double before = lpEnergy(h(H_PHASE_ROWS_HEADER), lr);
            if (boiling && remaining == 0l)
                transferred = before;
            if (!boiling)
                lpCreate(h(H_PHASE_ROWS_HEADER), c, material, (~int(words[gh(GEO_H_MASKS) + c])) & 255);
            putq(lpF(h(H_PHASE_ROWS_HEADER), LP_FIELD_MASS) + 2 * lr, remaining);
            putq(lpF(h(H_PHASE_ROWS_HEADER), LP_FIELD_DELTA_SVQ) + 2 * lr, boiling ? -delta : delta);
            put(lpF(h(H_PHASE_ROWS_HEADER), LP_FIELD_ENERGY) + 2 * lr, before + (boiling ? -transferred : transferred));
            putq(gas(GAS_MASS_UNITS) + 2 * comp, addq(quantity(gas(GAS_MASS_UNITS) + 2 * comp), boiling ? mass : -mass));
            putq(gas(GAS_STANDARD_VOLUME_NANOS) + 2 * comp, addq(quantity(gas(GAS_STANDARD_VOLUME_NANOS) + 2 * comp), boiling ? nanos : -nanos));
            putq(gas(GAS_MASS_RESIDUAL_UNITS) + 2 * comp,
                 addq(quantity(gas(GAS_MASS_RESIDUAL_UNITS) + 2 * comp), boiling ? mass - movedSpeciesMass : -(mass - movedSpeciesMass)));
            int audit = component(int(words[gas(GAS_COUNTS)]) + (boiling ? 2 : 3), m);
            atomicAdd(longs[(gas(GAS_MASS_UNITS) + 2 * audit) / 2], mass);
            atomicAdd(longs[(gas(GAS_STANDARD_VOLUME_NANOS) + 2 * audit) / 2], nanos);
            atomicAdd(longs[(gas(GAS_MASS_RESIDUAL_UNITS) + 2 * audit) / 2], mass - movedSpeciesMass);
            energy += boiling ? transferred : -transferred;
            putq(f(FIELD_NEW_MASS) + 2 * c, addq(quantity(f(FIELD_OLD_MASS) + 2 * c), boiling ? -mass : mass));
            put(f(FIELD_PE_WORK) + 2 * c, (boiling ? 1.0LF : -1.0LF) * double(mass) * massUnit() *
                                              value(p.header + H_GRAVITY) * (double(c / shape().x % shape().y) + .5LF) *
                                              value(p.header + H_CELL_SIZE));
            words[f(FIELD_BIRTH_NODE) + c] = uint(node + 1);
            words[h(H_PHASE_MOTION_CELLS) + c] = 1u;
            atomicOr(words[h(H_PHASE_PENDING_SUMMARY)], 1u);
            atomicAdd(words[f(FIELD_CONTROL)], uint(batches));
            atomicAdd(words[f(FIELD_CONTROL) + (boiling ? 1 : 2)], 1u);
        }
    }
    put(gas(GAS_INTERNAL_ENERGY) + 2 * node, energy);
}
int faceBase(int axis) {
    ivec3 s = shape();
    return axis == 0 ? 0 : (s.x + 1) * s.y * s.z + (axis == 2 ? s.x * (s.y + 1) * s.z : 0);
}
ivec3 unit(int axis) {
    ivec3 v = ivec3(0);
    v[axis] = 1;
    return v;
}
void faceCells(int id, out int axis, out int a, out int b) {
    axis = id < faceBase(1) ? 0 : id < faceBase(2) ? 1 : 2;
    int local = id - faceBase(axis);
    ivec3 s = shape() + unit(axis), q = ivec3(local % s.x, local / s.x % s.y, local / (s.x * s.y));
    a = cell(q - unit(axis));
    b = cell(q);
}
int cellFace(int c, int axis, int side) {
    ivec3 s = shape(), q = ivec3(c % s.x, c / s.x % s.y, c / (s.x * s.y));
    q[axis] += side;
    s[axis]++;
    return faceBase(axis) + (q.z * s.y + q.y) * s.x + q.x;
}
double cmass(int c, int field) {
    return c < 0 ? 0.0LF : double(quantity(f(field) + 2 * c)) * massUnit();
}
void momentum(int id) {
    int axis, a, b;
    faceCells(id, axis, a, b);
    if (!activeFace(id)) {
        put(f(FIELD_FACE_P) + 2 * id, value(source(16 + axis) + 2 * (id - faceBase(axis))));
        put(f(FIELD_OLD_K) + 2 * id, 0.0LF);
        put(f(FIELD_NEW_K) + 2 * id, 0.0LF);
        put(f(FIELD_FACE_HEAT) + 4 * id, 0.0LF);
        put(f(FIELD_FACE_HEAT) + 4 * id + 2, 0.0LF);
        return;
    }
    double old = .5LF * (cmass(a, FIELD_OLD_MASS) + cmass(b, FIELD_OLD_MASS)),
           now = .5LF * (cmass(a, FIELD_NEW_MASS) + cmass(b, FIELD_NEW_MASS)),
           before = value(source(16 + axis) + 2 * (id - faceBase(axis))), v = old > 0.0 ? before / old : 0.0LF;
    double kept = .5LF * (min(cmass(a, FIELD_OLD_MASS), cmass(a, FIELD_NEW_MASS)) +
                          min(cmass(b, FIELD_OLD_MASS), cmass(b, FIELD_NEW_MASS))),
           after = kept * v, w = now > 0.0 ? after / now : 0.0LF;
    put(f(FIELD_FACE_P) + 2 * id, after);
    put(f(FIELD_OLD_K) + 2 * id, .5LF * old * v * v);
    put(f(FIELD_NEW_K) + 2 * id, .5LF * now * w * w);
    for (int side = 0; side < 2; side++) {
        int c = side == 0 ? a : b;
        double oldc = .5LF * cmass(c, FIELD_OLD_MASS), newc = .5LF * cmass(c, FIELD_NEW_MASS),
               retained = min(oldc, newc),
               heat = .5LF * (retained * (v - w) * (v - w) + max(0.0LF, newc - oldc) * w * w +
                              max(0.0LF, oldc - newc) * v * v);
        put(f(FIELD_FACE_HEAT) + 4 * id + 2 * side, heat);
    }
}
void cellHeat(int c) {
    if (!activeCell(c))
        return;
    double heat = value(f(FIELD_PE_WORK) + 2 * c);
    for (int axis = 0; axis < 3; axis++)
        for (int side = 0; side < 2; side++)
            heat += value(f(FIELD_FACE_HEAT) + 4 * cellFace(c, axis, side) + 2 * (side == 0 ? 1 : 0));
    int64_t total = quantity(f(FIELD_NEW_MASS) + 2 * c);
    double assigned = 0.0;
    if (total > 0l) {
        int last = -1;
        for (int m = 0; m < h(H_MATERIAL_COUNT); m++) {
            int r = row(c, m);
            if (lpMass(h(H_PHASE_ROWS_HEADER), r) > 0l)
                last = r;
        }
        for (int m = 0; m < h(H_MATERIAL_COUNT); m++) {
            int r = row(c, m);
            int64_t mass = lpMass(h(H_PHASE_ROWS_HEADER), r);
            if (mass <= 0l)
                continue;
            double q = r == last ? heat - assigned : heat * double(mass) / double(total);
            put(lpF(h(H_PHASE_ROWS_HEADER), LP_FIELD_ENERGY) + 2 * r, lpEnergy(h(H_PHASE_ROWS_HEADER), r) + q);
            assigned += q;
        }
    } else if (heat != 0.0) {
        int node = int(words[f(FIELD_NODE) + c]);
        if (node < 0) {
            invalid();
            return;
        }
        put(f(FIELD_GAS_TRANSFER) + 2 * c, heat);
    }
}
void finishGas(int node) {
    if (node >= int(words[gas(GAS_COUNTS)]))
        return;
    double u = value(gas(GAS_INTERNAL_ENERGY) + 2 * node);
    int64_t mass = 0l;
    int receiver = -1;
    for (int m = 0; m < eh(GAS_H_COMPONENT_COUNT); m++) {
        mass = addq(mass, quantity(gas(GAS_MASS_UNITS) + 2 * component(node, m)));
        for (int c = int(words[f(FIELD_HEAD) + component(node, m)]); c >= 0; c = int(words[f(FIELD_NEXT) + c])) {
            u += value(f(FIELD_GAS_TRANSFER) + 2 * c);
            if (words[f(FIELD_BATCHES) + c] > 0u && words[f(FIELD_BOIL) + c] == 0u)
                receiver = row(c, int(words[rule(c)]));
        }
    }
    if (mass == 0l && u != 0.0) {
        if (receiver < 0) {
            invalid();
            return;
        }
        put(lpF(h(H_PHASE_ROWS_HEADER), LP_FIELD_ENERGY) + 2 * receiver, lpEnergy(h(H_PHASE_ROWS_HEADER), receiver) + u);
        u = 0.0;
    }
    put(gas(GAS_INTERNAL_ENERGY) + 2 * node, u);
    put(f(FIELD_NEW_GAS_U) + 2 * node, u);
}
void publish(int i) {
    if (i < h(H_FACE_COUNT)) {
        int axis = i < faceBase(1) ? 0 : i < faceBase(2) ? 1 : 2;
        put(source(16 + axis) + 2 * (i - faceBase(axis)), value(f(FIELD_FACE_P) + 2 * i));
    }
}
bool activeCell(int cell) {
    return h(H_ACTIVITY_CELLS) < 0 || words[h(H_ACTIVITY_CELLS) + cell] != 0u;
}
bool activeFace(int face) {
    return h(H_ACTIVITY_FACES) < 0 || words[h(H_ACTIVITY_FACES) + face] != 0u;
}
void main() {
    int i = int((gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x) * 128u + gl_LocalInvocationID.x);
    if (i >= p.count)
        return;
    if (p.stage == 0) {
        initialize(i);
        return;
    }
    if (errors != 0u)
        return;
    if (p.stage == 1)
        propose(i);
    else if (p.stage == 2)
        limitGroup(i);
    else if (p.stage == 3)
        budget(i);
    else if (p.stage == 4)
        exchange(i);
    else if (p.stage == 5)
        momentum(i);
    else if (p.stage == 6)
        cellHeat(i);
    else if (p.stage == 7)
        finishGas(i);
    else if (p.stage == 8)
        publish(i);
}
