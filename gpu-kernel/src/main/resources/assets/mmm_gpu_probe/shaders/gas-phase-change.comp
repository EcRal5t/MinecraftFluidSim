// HOST_LAYOUT
const uint ERROR_INVALID_STATE = 33554432u;
const int STAGE_INITIALIZE = 0;
const int STAGE_PROPOSE = 1;
const int STAGE_LIMIT_GROUP = 2;
const int STAGE_BUDGET = 3;
const int STAGE_EXCHANGE = 4;
const int STAGE_MOMENTUM = 5;
const int STAGE_CELL_HEAT = 6;
const int STAGE_FINISH_GAS = 7;
const int STAGE_PUBLISH = 8;

int headerWord(int i) {
    return int(words[p.header + i]);
}
int workField(int i) {
    return headerWord(WORK_FIELDS + i);
}
int gasHeaderWord(int i) {
    return int(words[headerWord(H_GAS_HEADER) + i]);
}
int geometryHeaderWord(int i) {
    return int(words[headerWord(H_GEOMETRY_HEADER) + i]);
}
int liquidCaloricWord(int i) {
    return int(words[headerWord(H_LIQUID_CALORIC) + i]);
}
int gasField(int i) {
    return gasHeaderWord(GAS_FIELDS+i);
}
int stockField(int i) {
    return phaseStockField(headerWord(H_PHASE_ROWS_HEADER), i);
}
int row(int c, int m) {
    return c * headerWord(H_MATERIAL_COUNT) + m;
}
double readDouble(int at) {
    return readPhaseRowDouble(at);
}
void writeDouble(int at, double x) {
    writePhaseRowDouble(at, x);
}
int64_t readQuantity(int at) {
    return readPhaseRowInteger(at);
}
void writeQuantity(int at, int64_t x) {
    writePhaseRowInteger(at, x);
}
bool isFinite(double x) {
    return !isnan(x) && !isinf(x);
}
void reportInvalid() {
    atomicOr(errors, ERROR_INVALID_STATE);
}
int64_t addq(int64_t a, int64_t b) {
    const int64_t limit = 0x7fffffffffffffffl;
    if (b > 0l && a > limit - b || b < 0l && a < (-limit - 1l) - b) {
        reportInvalid();
        return a;
    }
    return a + b;
}
u64vec2 mul128(uint64_t a, uint64_t b) {
    uint64_t mask = 0xffffffffUL, low = (a & mask) * (b & mask), t = (a >> 32) * (b & mask) + (low >> 32),
             mid = (t & mask) + (a & mask) * (b >> 32);
    return u64vec2((mid << 32) | (low & mask), (a >> 32) * (b >> 32) + (t >> 32) + (mid >> 32));
}
bool lessEqual(u64vec2 a, u64vec2 b) {
    return a.y < b.y || a.y == b.y && a.x <= b.x;
}
int64_t portion(int64_t a, int64_t b, int64_t total) {
    if (a == 0l || b == 0l)
        return 0l;
    if (b == total)
        return a;
    uint64_t q = min(uint64_t(a), uint64_t(floor(double(a) * (double(b) / double(total)))));
    u64vec2 target = mul128(uint64_t(a), uint64_t(b));
    while (!lessEqual(mul128(q, uint64_t(total)), target))
        q--;
    while (q < uint64_t(a) && lessEqual(mul128(q + 1UL, uint64_t(total)), target))
        q++;
    return int64_t(q);
}
int rule(int c) {
    return workField(FIELD_RULES) + 12 * int(words[workField(FIELD_RULE) + c]);
}
int component(int node, int m) {
    return node * gasHeaderWord(GAS_H_COMPONENT_COUNT) + m;
}
int gasSpecies(int comp, int s) {
    for (int a = int(words[gasField(GAS_COMPONENT_SPECIES_OFFSETS) + comp]); a < int(words[gasField(GAS_COMPONENT_SPECIES_OFFSETS) + comp + 1]); a++)
        if (int(words[gasField(GAS_SPECIES_HANDLES) + a]) == s)
            return a;
    return -1;
}
double state(int n, int k) {
    return readDouble(gasHeaderWord(GAS_H_STATES) + 18 * n + 2 * k);
}
double massUnit() {
    return 1e-10LF;
}
double specificLiquid(int m, double t) {
    double specificEnergy = readDouble(liquidCaloricWord(CAL_MATERIAL_REFERENCE) + 2 * m) + readDouble(liquidCaloricWord(CAL_COLD_SENSIBLE) + 2 * m), lower = readDouble(headerWord(H_LIQUID_CALORIC) + CAL_MINIMUM_TEMPERATURE);
    int end = int(words[liquidCaloricWord(CAL_SEGMENT_OFFSETS) + m + 1]);
    for (int a = int(words[liquidCaloricWord(CAL_SEGMENT_OFFSETS) + m]); a < end && lower < t; a++) {
        double upper = a == end - 1 ? t : min(t, readDouble(liquidCaloricWord(CAL_SEGMENT_UPPER) + 2 * a));
        specificEnergy += (upper - lower) * readDouble(liquidCaloricWord(CAL_SEGMENT_CAPACITY) + 2 * a);
        lower = upper;
    }
    return specificEnergy;
}
double specificGas(int m, double t) {
    double specificEnergy = readDouble(gasHeaderWord(GAS_H_ANCHOR_ENERGY) + 2 * m), anchor = 293.15LF, low = min(t, anchor), high = max(t, anchor),
           edge = readDouble(headerWord(H_LIQUID_CALORIC) + CAL_MINIMUM_TEMPERATURE), integral = 0.0;
    int end = int(words[gasHeaderWord(GAS_H_SEGMENT_OFFSETS) + m + 1]);
    for (int a = int(words[gasHeaderWord(GAS_H_SEGMENT_OFFSETS) + m]); a < end && edge < high; a++) {
        double upper = a == end - 1 ? high : min(high, readDouble(gasHeaderWord(GAS_H_SEGMENT_UPPER) + 2 * a));
        integral += max(0.0LF, upper - max(edge, low)) * readDouble(gasHeaderWord(GAS_H_SEGMENT_CAPACITY) + 2 * a);
        edge = upper;
    }
    return specificEnergy + (t >= anchor ? integral : -integral);
}
double liquidCold(int lr, int material) {
    double coldEnergy = double(phaseRowMass(headerWord(H_PHASE_ROWS_HEADER), lr)) * massUnit() *
               specificLiquid(material, readDouble(headerWord(H_LIQUID_CALORIC) + CAL_MINIMUM_TEMPERATURE));
    for (int sp = 0; sp < headerWord(H_SPECIES_COUNT); sp++) {
        int64_t speciesAmount = phaseRowSpecies(headerWord(H_PHASE_ROWS_HEADER), lr, sp);
        if (speciesAmount > 0l)
            coldEnergy += double(speciesAmount) * readDouble(liquidCaloricWord(CAL_SPECIES_REFERENCE) + 2 * (material * liquidCaloricWord(CAL_SPECIES_STRIDE) + sp));
    }
    return coldEnergy;
}
// Check the actual integer species portion, including both phase reference energies.
bool canBoil(int lr, int material, int vapor, int comp, int64_t mass, int64_t available, double t) {
    int64_t original = phaseRowMass(headerWord(H_PHASE_ROWS_HEADER), lr);
    double cold = readDouble(headerWord(H_LIQUID_CALORIC) + CAL_MINIMUM_TEMPERATURE), gasReference = 0.0, liquidReference = 0.0;
    for (int sp = 0; sp < headerWord(H_SPECIES_COUNT); sp++) {
        int64_t q = phaseRowSpecies(headerWord(H_PHASE_ROWS_HEADER), lr, sp),
                moved = gasSpecies(comp, sp) < 0 ? 0l : portion(q, mass, available);
        if (moved > 0l)
            gasReference += double(moved) * readDouble(gasHeaderWord(GAS_H_SPECIES_REFERENCE) + 2 * (vapor * gasHeaderWord(GAS_H_SPECIES_STRIDE) + sp));
        if (q > moved)
            liquidReference += double(q - moved) * readDouble(liquidCaloricWord(CAL_SPECIES_REFERENCE) + 2 * (material * liquidCaloricWord(CAL_SPECIES_STRIDE) + sp));
    }
    double before = phaseRowEnergy(headerWord(H_PHASE_ROWS_HEADER), lr);
    if (mass == original)
        return before >= double(mass) * massUnit() * specificGas(vapor, cold) + gasReference;
    double transferred = double(mass) * massUnit() * specificGas(vapor, t) + gasReference;
    return before - transferred >=
           double(original - mass) * massUnit() * specificLiquid(material, cold) + liquidReference;
}
ivec3 shape() {
    return ivec3(phaseRowHeader(headerWord(H_PHASE_ROWS_HEADER), LP_H_SIZE_X), phaseRowHeader(headerWord(H_PHASE_ROWS_HEADER), LP_H_SIZE_Y), phaseRowHeader(headerWord(H_PHASE_ROWS_HEADER), LP_H_SIZE_Z));
}
int cell(ivec3 q) {
    ivec3 s = shape();
    return any(lessThan(q, ivec3(0))) || any(greaterThanEqual(q, s)) ? -1 : (q.z * s.y + q.y) * s.x + q.x;
}
int nodeAt(int c) {
    if (c < 0)
        return -1;
    for (int i = 0; i < 8; i++) {
        int n = int(words[gasField(GAS_PIECE_NODE_ORDINAL) + 8 * c + i]);
        if (n > 0)
            return n - 1;
    }
    return -1;
}
int interfaceNode(int c) {
    int n = nodeAt(c);
    if (n >= 0)
        return n;
    ivec3 s = shape(), q = ivec3(c % s.x, c / s.x % s.y, c / (s.x * s.y));
    for (int axis = 0; axis < 3; axis++)
        for (int side = -1; side <= 1; side += 2) {
            ivec3 z = q;
            z[axis] += side;
            int other = cell(z);
            if (other < 0)
                continue;
            int mask = int(words[geometryHeaderWord(GEO_H_MASKS) + c]), om = int(words[geometryHeaderWord(GEO_H_MASKS) + other]);
            bool open = false;
            for (int micro = 0; micro < 8; micro++)
                if (((micro >> axis) & 1) == (side > 0 ? 1 : 0) && ((mask >> micro) & 1) == 0 &&
                    ((om >> (micro ^ (1 << axis))) & 1) == 0)
                    open = true;
            if (open && (n = nodeAt(other)) >= 0)
                return n;
        }
    return -1;
}
void initialize(int i) {
    if (i < headerWord(H_GROUP_COUNT))
        words[workField(FIELD_HEAD) + i] = uint(-1);
    if (i < headerWord(H_CELL_COUNT)) {
        words[workField(FIELD_NEXT) + i] = uint(-1);
        words[workField(FIELD_RULE) + i] = uint(-1);
        words[workField(FIELD_NODE) + i] = uint(-1);
        words[workField(FIELD_BIRTH_NODE) + i] = uint(nodeAt(i) + 1);
        words[workField(FIELD_DESIRED) + i] = 0u;
        words[workField(FIELD_BATCHES) + i] = 0u;
        writeDouble(workField(FIELD_GAS_TRANSFER) + 2 * i, 0.0);
        writeDouble(workField(FIELD_PE_WORK) + 2 * i, 0.0);
        int64_t mass = 0l;
        for (int m = 0; m < headerWord(H_MATERIAL_COUNT); m++)
            mass = addq(mass, phaseRowMass(headerWord(H_PHASE_ROWS_HEADER), row(i, m)));
        writeQuantity(workField(FIELD_OLD_MASS) + 2 * i, mass);
        writeQuantity(workField(FIELD_NEW_MASS) + 2 * i, mass);
    }
    if (i < gasHeaderWord(GAS_H_NODE_CAPACITY)) {
        double gasEnergy = i < int(words[gasField(GAS_COUNTS)]) ? readDouble(gasField(GAS_INTERNAL_ENERGY) + 2 * i) : 0.0LF;
        writeDouble(workField(FIELD_OLD_GAS_U) + 2 * i, gasEnergy);
        writeDouble(workField(FIELD_NEW_GAS_U) + 2 * i, gasEnergy);
    }
    if (i == 0)
        for (int j = 0; j < 8; j++)
            words[workField(FIELD_CONTROL) + j] = 0u;
}
void propose(int c) {
    if (!activeCell(c))
        return;
    if (words[headerWord(H_PHASE_MOTION_CELLS) + c] != 0u || p.maximum <= 0)
        return;
    int node = interfaceNode(c);
    if (node < 0)
        return;
    double best = 0.0;
    int selected = -1;
    bool boil = false;
    int64_t limit = 0l;
    double wanted = 0.0, selectedT = 0.0, selectedSat = 0.0, selectedPartial = 0.0, selectedResponse = 0.0;
    double gasTemperature = state(node, 0), volume = readDouble(gasHeaderWord(GAS_H_NODE_VOLUMES) + 2 * node);
    if (!(gasTemperature > 0.0 && volume > 0.0))
        return;
    for (int k = 0; k < headerWord(H_RULE_COUNT); k++) {
        int r = workField(FIELD_RULES) + 12 * k, m = int(words[r]), comp = component(node, int(words[r + 1])), lr = row(c, m);
        int64_t mass = phaseRowMass(headerWord(H_PHASE_ROWS_HEADER), lr), batchMass = readQuantity(r + 2), batchSolidVolume = readQuantity(r + 4),
                batchStandardNanos = readQuantity(r + 6);
        double liquidTemperature = mass > 0l ? readDouble(liquidCaloricWord(CAL_CELL_TEMPERATURES) + 2 * c) : gasTemperature;
        if (!(liquidTemperature > 0.0 && batchMass > 0l && batchStandardNanos > 0l))
            continue;
        double saturation = 101325.0LF * exp(float(readDouble(r + 10) * (1.0LF / readDouble(r + 8) - 1.0LF / liquidTemperature)));
        if (!isFinite(saturation)) {
            reportInvalid();
            return;
        }
        double partialPressure = double(readQuantity(gasField(GAS_STANDARD_VOLUME_NANOS) + 2 * comp)) * 1e-9LF * (101325.0LF / 293.15LF) * gasTemperature / volume,
               pressureDifference = saturation - partialPressure;
        bool boiling = pressureDifference > 0.0;
        if (pressureDifference == 0.0 || !boiling && nodeAt(c) != node)
            continue;
        double batchVolume = double(batchSolidVolume) * exp2(-27.0),
               normalized = batchVolume / pow(float(readDouble(p.header + H_CELL_SIZE)), 3.0);
        int64_t high = int64_t(p.maximum);
        double carried = specificGas(int(words[r + 1]), boiling ? liquidTemperature : gasTemperature), liquid = specificLiquid(m, liquidTemperature),
               cold = specificLiquid(m, readDouble(headerWord(H_LIQUID_CALORIC) + CAL_MINIMUM_TEMPERATURE));
        if (boiling) {
            int64_t available = 0l;
            bool all = true;
            for (int sp = 0; sp < headerWord(H_SPECIES_COUNT); sp++) {
                int64_t speciesAmount = phaseRowSpecies(headerWord(H_PHASE_ROWS_HEADER), lr, sp);
                if (speciesAmount == 0l)
                    continue;
                int gs = gasSpecies(comp, sp);
                if (gs < 0)
                    all = false;
                else {
                    int d = phaseRowHeader(headerWord(H_PHASE_ROWS_HEADER), LP_H_DEFINITIONS);
                    available = addq(available, speciesAmount * readQuantity(d + int(words[d + 1]) + 5 * sp + 1));
                }
            }
            if (all)
                available = mass;
            high = min(high, available / batchMass);
            high = min(high, int64_t(max(0.0LF, floor(phaseRowVolume(headerWord(H_PHASE_ROWS_HEADER), lr) / normalized))));
            double budget = phaseRowEnergy(headerWord(H_PHASE_ROWS_HEADER), lr) - liquidCold(lr, m),
                   cost = (carried - cold) * double(batchMass) * massUnit();
            if (cost > 0.0)
                high = min(high, int64_t(max(0.0LF, floor(budget / cost))));
            while (high > 0l && !canBoil(lr, m, int(words[r + 1]), comp, high * batchMass, available, liquidTemperature))
                high--;
        } else {
            high = min(high, min(readQuantity(gasField(GAS_MASS_UNITS) + 2 * comp) / batchMass, readQuantity(gasField(GAS_STANDARD_VOLUME_NANOS) + 2 * comp) / batchStandardNanos));
            high = min(high, int64_t(max(0.0LF, floor(readDouble(geometryHeaderWord(GEO_H_DRY_VOLUMES) + 2 * c) / batchVolume))));
        }
        if (high <= 0l)
            continue;
        double batchMassKg = double(batchMass) * massUnit(), heatCapacity = mass > 0l ? readDouble(liquidCaloricWord(CAL_CELL_HEAT_CAPACITIES) + 2 * c) : state(node, 3),
               latent = max(0.0LF, carried - liquid);
        double response = (double(batchStandardNanos) * 1e-9LF * (101325.0LF / 293.15LF) * gasTemperature - partialPressure * batchVolume) / volume;
        if (heatCapacity > 0.0)
            response += saturation * readDouble(r + 10) / (liquidTemperature * liquidTemperature) * latent * batchMassKg / heatCapacity;
        double demand = response > 0.0 ? min(double(high), abs(pressureDifference) / response) : double(high);
        if (demand >= 1.0 && abs(pressureDifference) > best) {
            best = abs(pressureDifference);
            selected = k;
            boil = boiling;
            limit = high;
            wanted = demand;
            selectedT = liquidTemperature;
            selectedSat = saturation;
            selectedPartial = partialPressure;
            selectedResponse = max(0.0LF, response);
        }
    }
    if (selected < 0)
        return;
    int group = component(node, int(words[workField(FIELD_RULES) + 12 * selected + 1]));
    words[workField(FIELD_RULE) + c] = uint(selected);
    words[workField(FIELD_NODE) + c] = uint(node);
    words[workField(FIELD_BOIL) + c] = boil ? 1u : 0u;
    writeQuantity(workField(FIELD_LIMIT) + 2 * c, limit);
    writeDouble(workField(FIELD_KG) + 2 * c, wanted);
    writeDouble(workField(FIELD_TEMP) + 2 * c, selectedT);
    writeDouble(workField(FIELD_GAS_TEMP) + 2 * c, gasTemperature);
    writeDouble(workField(FIELD_SATURATION) + 2 * c, selectedSat);
    writeDouble(workField(FIELD_PARTIAL) + 2 * c, selectedPartial);
    writeDouble(workField(FIELD_GAS_RESPONSE) + 2 * c, selectedResponse);
    words[workField(FIELD_NEXT) + c] = atomicExchange(words[workField(FIELD_HEAD) + group], uint(c));
}
// The chamber shares its finite vapor stock and saturation demand across cell proposals.
void limitGroup(int group) {
    int first = int(words[workField(FIELD_HEAD) + group]);
    if (first < 0)
        return;
    double positive = 0.0, negative = 0.0, highest = 0.0, lowest = 1.7976931348623157e308,
           initial = readDouble(workField(FIELD_PARTIAL) + 2 * first), massNeed = 0.0, nanosNeed = 0.0;
    for (int c = first; c >= 0; c = int(words[workField(FIELD_NEXT) + c])) {
        double n = readDouble(workField(FIELD_KG) + 2 * c), response = n * readDouble(workField(FIELD_GAS_RESPONSE) + 2 * c);
        highest = max(highest, readDouble(workField(FIELD_SATURATION) + 2 * c));
        lowest = min(lowest, readDouble(workField(FIELD_SATURATION) + 2 * c));
        if (words[workField(FIELD_BOIL) + c] != 0u)
            positive += response;
        else {
            negative += response;
            massNeed += n * double(readQuantity(rule(c) + 2));
            nanosNeed += n * double(readQuantity(rule(c) + 6));
        }
    }
    double bp = positive > 0.0 ? min(1.0LF, max(0.0LF, highest - initial + negative) / positive) : 1.0LF;
    double cp = negative > 0.0 ? min(1.0LF, max(0.0LF, initial + positive * bp - lowest) / negative) : 1.0LF;
    int64_t stockMass = readQuantity(gasField(GAS_MASS_UNITS) + 2 * group), stockNanos = readQuantity(gasField(GAS_STANDARD_VOLUME_NANOS) + 2 * group),
            batchMass = readQuantity(rule(first) + 2), batchNanos = readQuantity(rule(first) + 6);
    bool exhaustible = stockMass % batchMass == 0l && stockNanos % batchNanos == 0l &&
                       stockMass / batchMass == stockNanos / batchNanos;
    for (int c = first; c >= 0; c = int(words[workField(FIELD_NEXT) + c]))
        if (words[workField(FIELD_BOIL) + c] == 0u) {
            u64vec2 a = mul128(uint64_t(readQuantity(rule(c) + 2)), uint64_t(batchNanos)),
                    b = mul128(uint64_t(readQuantity(rule(c) + 6)), uint64_t(batchMass));
            exhaustible = exhaustible && all(equal(a, b));
        }
    // A finite component has both mass and standard volume, or neither.
    int64_t massBudget = max(0l, stockMass - (exhaustible ? 0l : 1l)),
            nanosBudget = max(0l, stockNanos - (exhaustible ? 0l : 1l));
    if (massNeed > 0.0)
        cp = min(cp, double(massBudget) / massNeed);
    if (nanosNeed > 0.0)
        cp = min(cp, double(nanosBudget) / nanosNeed);
    for (int c = first; c >= 0; c = int(words[workField(FIELD_NEXT) + c]))
        words[workField(FIELD_DESIRED) + c] =
            uint(floor(readDouble(workField(FIELD_KG) + 2 * c) * (words[workField(FIELD_BOIL) + c] != 0u ? bp : cp)));
}
void budget(int c) {
    uint total = words[workField(FIELD_OFFSETS) + headerWord(H_CELL_COUNT)], begin = words[workField(FIELD_OFFSETS) + c],
         end = words[workField(FIELD_OFFSETS) + c + 1], allowed = min(total, uint(p.maximum));
    words[workField(FIELD_BATCHES) + c] = total == 0u ? 0u
                                              : uint(uint64_t(end) * uint64_t(allowed) / uint64_t(total) -
                                                     uint64_t(begin) * uint64_t(allowed) / uint64_t(total));
}
void exchange(int node) {
    if (node >= int(words[gasField(GAS_COUNTS)]))
        return;
    double energy = readDouble(gasField(GAS_INTERNAL_ENERGY) + 2 * node);
    for (int m = 0; m < gasHeaderWord(GAS_H_COMPONENT_COUNT); m++) {
        int comp = component(node, m);
        for (int c = int(words[workField(FIELD_HEAD) + comp]); c >= 0; c = int(words[workField(FIELD_NEXT) + c])) {
            int64_t batches = int64_t(words[workField(FIELD_BATCHES) + c]);
            if (batches == 0l)
                continue;
            int r = rule(c), material = int(words[r]), lr = row(c, material);
            bool boiling = words[workField(FIELD_BOIL) + c] != 0u;
            int64_t mass = batches * readQuantity(r + 2), batchStandardNanos = batches * readQuantity(r + 6),
                    delta = batches * readQuantity(r + 4), original = phaseRowMass(headerWord(H_PHASE_ROWS_HEADER), lr);
            double liquidTemperature = readDouble(workField(FIELD_TEMP) + 2 * c), gasTemperature = readDouble(workField(FIELD_GAS_TEMP) + 2 * c);
            int64_t available = boiling ? original : readQuantity(gasField(GAS_MASS_UNITS) + 2 * comp);
            if (!boiling && (mass > available || batchStandardNanos > readQuantity(gasField(GAS_STANDARD_VOLUME_NANOS) + 2 * comp))) {
                reportInvalid();
                return;
            }
            double transferred = double(mass) * massUnit() * specificGas(m, boiling ? liquidTemperature : gasTemperature);
            int64_t movedSpeciesMass = 0l;
            int def = phaseRowHeader(headerWord(H_PHASE_ROWS_HEADER), LP_H_DEFINITIONS);
            if (boiling) {
                bool all = true;
                int64_t selectedMass = 0l;
                for (int sp = 0; sp < headerWord(H_SPECIES_COUNT); sp++) {
                    int64_t speciesAmount = phaseRowSpecies(headerWord(H_PHASE_ROWS_HEADER), lr, sp);
                    if (speciesAmount == 0l)
                        continue;
                    if (gasSpecies(comp, sp) < 0)
                        all = false;
                    else
                        selectedMass = addq(selectedMass, speciesAmount * readQuantity(def + int(words[def + 1]) + 5 * sp + 1));
                }
                if (!all)
                    available = selectedMass;
            }
            if (available < mass) {
                reportInvalid();
                return;
            }
            for (int a = int(words[gasField(GAS_COMPONENT_SPECIES_OFFSETS) + comp]); a < int(words[gasField(GAS_COMPONENT_SPECIES_OFFSETS) + comp + 1]); a++) {
                int sp = int(words[gasField(GAS_SPECIES_HANDLES) + a]);
                int64_t speciesAmount = boiling ? phaseRowSpecies(headerWord(H_PHASE_ROWS_HEADER), lr, sp) : readQuantity(gasField(GAS_SPECIES_AMOUNTS) + 2 * a),
                        moved = portion(speciesAmount, mass, available);
                if (moved == 0l)
                    continue;
                double offset = readDouble(gasHeaderWord(GAS_H_SPECIES_REFERENCE) + 2 * (m * gasHeaderWord(GAS_H_SPECIES_STRIDE) + sp));
                if (!isFinite(offset)) {
                    reportInvalid();
                    return;
                }
                transferred += double(moved) * offset;
                movedSpeciesMass = addq(movedSpeciesMass, moved * readQuantity(def + int(words[def + 1]) + 5 * sp + 1));
                writePhaseRowSpecies(headerWord(H_PHASE_ROWS_HEADER), lr, sp,
                            addq(phaseRowSpecies(headerWord(H_PHASE_ROWS_HEADER), lr, sp), boiling ? -moved : moved));
                writeQuantity(gasField(GAS_SPECIES_AMOUNTS) + 2 * a, addq(readQuantity(gasField(GAS_SPECIES_AMOUNTS) + 2 * a), boiling ? moved : -moved));
                int auditComp = component(int(words[gasField(GAS_COUNTS)]) + (boiling ? 2 : 3), m),
                    auditEntry = gasSpecies(auditComp, sp);
                atomicAdd(longs[(gasField(GAS_SPECIES_AMOUNTS) + 2 * auditEntry) / 2], moved);
            }
            int64_t remaining = boiling ? original - mass : original + mass;
            double before = phaseRowEnergy(headerWord(H_PHASE_ROWS_HEADER), lr);
            if (boiling && remaining == 0l)
                transferred = before;
            if (!boiling)
                createPhaseRow(headerWord(H_PHASE_ROWS_HEADER), c, material, (~int(words[geometryHeaderWord(GEO_H_MASKS) + c])) & 255);
            writeQuantity(phaseRowField(headerWord(H_PHASE_ROWS_HEADER), LP_FIELD_MASS) + 2 * lr, remaining);
            writeQuantity(phaseRowField(headerWord(H_PHASE_ROWS_HEADER), LP_FIELD_DELTA_SVQ) + 2 * lr, boiling ? -delta : delta);
            writeDouble(phaseRowField(headerWord(H_PHASE_ROWS_HEADER), LP_FIELD_ENERGY) + 2 * lr, before + (boiling ? -transferred : transferred));
            writeQuantity(gasField(GAS_MASS_UNITS) + 2 * comp, addq(readQuantity(gasField(GAS_MASS_UNITS) + 2 * comp), boiling ? mass : -mass));
            writeQuantity(gasField(GAS_STANDARD_VOLUME_NANOS) + 2 * comp, addq(readQuantity(gasField(GAS_STANDARD_VOLUME_NANOS) + 2 * comp), boiling ? batchStandardNanos : -batchStandardNanos));
            writeQuantity(gasField(GAS_MASS_RESIDUAL_UNITS) + 2 * comp,
                 addq(readQuantity(gasField(GAS_MASS_RESIDUAL_UNITS) + 2 * comp), boiling ? mass - movedSpeciesMass : -(mass - movedSpeciesMass)));
            int audit = component(int(words[gasField(GAS_COUNTS)]) + (boiling ? 2 : 3), m);
            atomicAdd(longs[(gasField(GAS_MASS_UNITS) + 2 * audit) / 2], mass);
            atomicAdd(longs[(gasField(GAS_STANDARD_VOLUME_NANOS) + 2 * audit) / 2], batchStandardNanos);
            atomicAdd(longs[(gasField(GAS_MASS_RESIDUAL_UNITS) + 2 * audit) / 2], mass - movedSpeciesMass);
            energy += boiling ? transferred : -transferred;
            writeQuantity(workField(FIELD_NEW_MASS) + 2 * c, addq(readQuantity(workField(FIELD_OLD_MASS) + 2 * c), boiling ? -mass : mass));
            writeDouble(workField(FIELD_PE_WORK) + 2 * c, (boiling ? 1.0LF : -1.0LF) * double(mass) * massUnit() *
                                              readDouble(p.header + H_GRAVITY) * (double(c / shape().x % shape().y) + .5LF) *
                                              readDouble(p.header + H_CELL_SIZE));
            words[workField(FIELD_BIRTH_NODE) + c] = uint(node + 1);
            words[headerWord(H_PHASE_MOTION_CELLS) + c] = 1u;
            atomicOr(words[headerWord(H_PHASE_PENDING_SUMMARY)], 1u);
            atomicAdd(words[workField(FIELD_CONTROL)], uint(batches));
            atomicAdd(words[workField(FIELD_CONTROL) + (boiling ? 1 : 2)], 1u);
        }
    }
    writeDouble(gasField(GAS_INTERNAL_ENERGY) + 2 * node, energy);
}
int faceBase(int axis) {
    ivec3 s = shape();
    return axis == 0 ? 0 : (s.x + 1) * s.y * s.z + (axis == 2 ? s.x * (s.y + 1) * s.z : 0);
}
ivec3 unit(int axis) {
    ivec3 v = ivec3(0);
    v[axis] = 1;
    return v;
}
void faceCells(int id, out int axis, out int a, out int b) {
    axis = id < faceBase(1) ? 0 : id < faceBase(2) ? 1 : 2;
    int local = id - faceBase(axis);
    ivec3 s = shape() + unit(axis), q = ivec3(local % s.x, local / s.x % s.y, local / (s.x * s.y));
    a = cell(q - unit(axis));
    b = cell(q);
}
int cellFace(int c, int axis, int side) {
    ivec3 s = shape(), q = ivec3(c % s.x, c / s.x % s.y, c / (s.x * s.y));
    q[axis] += side;
    s[axis]++;
    return faceBase(axis) + (q.z * s.y + q.y) * s.x + q.x;
}
double cmass(int c, int field) {
    return c < 0 ? 0.0LF : double(readQuantity(workField(field) + 2 * c)) * massUnit();
}
void momentum(int id) {
    int axis, a, b;
    faceCells(id, axis, a, b);
    if (!activeFace(id)) {
        writeDouble(workField(FIELD_FACE_P) + 2 * id, readDouble(stockField(16 + axis) + 2 * (id - faceBase(axis))));
        writeDouble(workField(FIELD_OLD_K) + 2 * id, 0.0LF);
        writeDouble(workField(FIELD_NEW_K) + 2 * id, 0.0LF);
        writeDouble(workField(FIELD_FACE_HEAT) + 4 * id, 0.0LF);
        writeDouble(workField(FIELD_FACE_HEAT) + 4 * id + 2, 0.0LF);
        return;
    }
    double old = .5LF * (cmass(a, FIELD_OLD_MASS) + cmass(b, FIELD_OLD_MASS)),
           now = .5LF * (cmass(a, FIELD_NEW_MASS) + cmass(b, FIELD_NEW_MASS)),
           before = readDouble(stockField(16 + axis) + 2 * (id - faceBase(axis))), v = old > 0.0 ? before / old : 0.0LF;
    double kept = .5LF * (min(cmass(a, FIELD_OLD_MASS), cmass(a, FIELD_NEW_MASS)) +
                          min(cmass(b, FIELD_OLD_MASS), cmass(b, FIELD_NEW_MASS))),
           after = kept * v, w = now > 0.0 ? after / now : 0.0LF;
    writeDouble(workField(FIELD_FACE_P) + 2 * id, after);
    writeDouble(workField(FIELD_OLD_K) + 2 * id, .5LF * old * v * v);
    writeDouble(workField(FIELD_NEW_K) + 2 * id, .5LF * now * w * w);
    for (int side = 0; side < 2; side++) {
        int c = side == 0 ? a : b;
        double oldc = .5LF * cmass(c, FIELD_OLD_MASS), newc = .5LF * cmass(c, FIELD_NEW_MASS),
               retained = min(oldc, newc),
               heat = .5LF * (retained * (v - w) * (v - w) + max(0.0LF, newc - oldc) * w * w +
                              max(0.0LF, oldc - newc) * v * v);
        writeDouble(workField(FIELD_FACE_HEAT) + 4 * id + 2 * side, heat);
    }
}
void cellHeat(int c) {
    if (!activeCell(c))
        return;
    double heat = readDouble(workField(FIELD_PE_WORK) + 2 * c);
    for (int axis = 0; axis < 3; axis++)
        for (int side = 0; side < 2; side++)
            heat += readDouble(workField(FIELD_FACE_HEAT) + 4 * cellFace(c, axis, side) + 2 * (side == 0 ? 1 : 0));
    int64_t total = readQuantity(workField(FIELD_NEW_MASS) + 2 * c);
    double assigned = 0.0;
    if (total > 0l) {
        int last = -1;
        for (int m = 0; m < headerWord(H_MATERIAL_COUNT); m++) {
            int r = row(c, m);
            if (phaseRowMass(headerWord(H_PHASE_ROWS_HEADER), r) > 0l)
                last = r;
        }
        for (int m = 0; m < headerWord(H_MATERIAL_COUNT); m++) {
            int r = row(c, m);
            int64_t mass = phaseRowMass(headerWord(H_PHASE_ROWS_HEADER), r);
            if (mass <= 0l)
                continue;
            double energyShare = r == last ? heat - assigned : heat * double(mass) / double(total);
            writeDouble(phaseRowField(headerWord(H_PHASE_ROWS_HEADER), LP_FIELD_ENERGY) + 2 * r, phaseRowEnergy(headerWord(H_PHASE_ROWS_HEADER), r) + energyShare);
            assigned += energyShare;
        }
    } else if (heat != 0.0) {
        int node = int(words[workField(FIELD_NODE) + c]);
        if (node < 0) {
            reportInvalid();
            return;
        }
        writeDouble(workField(FIELD_GAS_TRANSFER) + 2 * c, heat);
    }
}
void finishGas(int node) {
    if (node >= int(words[gasField(GAS_COUNTS)]))
        return;
    double gasEnergy = readDouble(gasField(GAS_INTERNAL_ENERGY) + 2 * node);
    int64_t mass = 0l;
    int receiver = -1;
    for (int m = 0; m < gasHeaderWord(GAS_H_COMPONENT_COUNT); m++) {
        mass = addq(mass, readQuantity(gasField(GAS_MASS_UNITS) + 2 * component(node, m)));
        for (int c = int(words[workField(FIELD_HEAD) + component(node, m)]); c >= 0; c = int(words[workField(FIELD_NEXT) + c])) {
            gasEnergy += readDouble(workField(FIELD_GAS_TRANSFER) + 2 * c);
            if (words[workField(FIELD_BATCHES) + c] > 0u && words[workField(FIELD_BOIL) + c] == 0u)
                receiver = row(c, int(words[rule(c)]));
        }
    }
    if (mass == 0l && gasEnergy != 0.0) {
        if (receiver < 0) {
            reportInvalid();
            return;
        }
        writeDouble(phaseRowField(headerWord(H_PHASE_ROWS_HEADER), LP_FIELD_ENERGY) + 2 * receiver, phaseRowEnergy(headerWord(H_PHASE_ROWS_HEADER), receiver) + gasEnergy);
        gasEnergy = 0.0;
    }
    writeDouble(gasField(GAS_INTERNAL_ENERGY) + 2 * node, gasEnergy);
    writeDouble(workField(FIELD_NEW_GAS_U) + 2 * node, gasEnergy);
}
void publish(int i) {
    if (i < headerWord(H_FACE_COUNT)) {
        int axis = i < faceBase(1) ? 0 : i < faceBase(2) ? 1 : 2;
        writeDouble(stockField(16 + axis) + 2 * (i - faceBase(axis)), readDouble(workField(FIELD_FACE_P) + 2 * i));
    }
}
bool activeCell(int cell) {
    return headerWord(H_ACTIVITY_CELLS) < 0 || words[headerWord(H_ACTIVITY_CELLS) + cell] != 0u;
}
bool activeFace(int face) {
    return headerWord(H_ACTIVITY_FACES) < 0 || words[headerWord(H_ACTIVITY_FACES) + face] != 0u;
}
void main() {
    int i = int((gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x) * 128u + gl_LocalInvocationID.x);
    if (i >= p.count)
        return;
    if (p.stage == STAGE_INITIALIZE) {
        initialize(i);
        return;
    }
    if (errors != 0u)
        return;
    if (p.stage == STAGE_PROPOSE)
        propose(i);
    else if (p.stage == STAGE_LIMIT_GROUP)
        limitGroup(i);
    else if (p.stage == STAGE_BUDGET)
        budget(i);
    else if (p.stage == STAGE_EXCHANGE)
        exchange(i);
    else if (p.stage == STAGE_MOMENTUM)
        momentum(i);
    else if (p.stage == STAGE_CELL_HEAT)
        cellHeat(i);
    else if (p.stage == STAGE_FINISH_GAS)
        finishGas(i);
    else if (p.stage == STAGE_PUBLISH)
        publish(i);
}
