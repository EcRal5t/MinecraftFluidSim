#version 450
#extension GL_ARB_gpu_shader_fp64 : require
layout(local_size_x = 128) in;
layout(binding = 0, std430) buffer Arena {
    uint words[];
};
layout(binding = 1, std430) buffer Errors {
    uint errors;
};
layout(push_constant) uniform Params {
    int header;
    int stage;
    int count;
    int unused;
    double duration;
    double ambient;
}
p;
// HOST_LAYOUT
shared double tile[272], panel[4352], pivot;
shared int valid;
int h(int i) {
    return int(words[p.header + i]);
}
int f(int i) {
    return h(WORK_FIELDS + i);
}
double number(int at) {
    return packDouble2x32(uvec2(words[at], words[at + 1]));
}
void put(int at, double v) {
    uvec2 b = unpackDouble2x32(v);
    words[at] = b.x;
    words[at + 1] = b.y;
}
int address(int row, int col) {
    return f(FIELD_DENSE) + 2 * (h(H_DENSE_ROWS) * row + col);
}
void main() {
    if (errors != 0u)
        return;
    int lane = int(gl_LocalInvocationID.x), count = int(words[f(FIELD_CORE_OFFSETS) + h(H_NODE_CAPACITY)]);
    for (int base = 0; base < count; base += 16) {
        int width = min(16, count - base);
        for (int entry = lane; entry < width * width; entry += 128) {
            int row = entry / width, col = entry % width;
            tile[17 * row + col] = col <= row ? number(address(base + row, base + col)) : 0.0;
        }
        barrier();
        for (int k = 0; k < width; k++) {
            if (lane == 0) {
                double value = tile[17 * k + k];
                valid = value > 0.0 ? 1 : 0;
                pivot = sqrt(value);
                if (valid == 0)
                    atomicOr(errors, 4u);
            }
            barrier();
            if (valid == 0)
                return;
            for (int row = k + 1 + lane; row < width; row += 128)
                tile[17 * row + k] /= pivot;
            if (lane == 0)
                tile[17 * k + k] = pivot;
            barrier();
            for (int entry = lane; entry < width * width; entry += 128) {
                int row = entry / width, col = entry % width;
                if (row > k && col > k && col <= row)
                    tile[17 * row + col] -= tile[17 * row + k] * tile[17 * col + k];
            }
            barrier();
        }
        for (int entry = lane; entry < width * width; entry += 128) {
            int row = entry / width, col = entry % width;
            if (col <= row)
                put(address(base + row, base + col), tile[17 * row + col]);
        }
        for (int row = base + width + lane; row < count; row += 128) {
            for (int col = 0; col < width; col++) {
                double value = number(address(row, base + col));
                for (int k = 0; k < col; k++)
                    value -= panel[17 * row + k] * tile[17 * col + k];
                value /= tile[17 * col + col];
                panel[17 * row + col] = value;
                put(address(row, base + col), value);
            }
        }
        barrier();
        int remaining = count - base - width;
        for (int entry = lane; entry < remaining * remaining; entry += 128) {
            int row = base + width + entry / remaining, col = base + width + entry % remaining;
            if (col <= row) {
                double sum = 0.0;
                for (int k = 0; k < width; k++)
                    sum += panel[17 * row + k] * panel[17 * col + k];
                put(address(row, col), number(address(row, col)) - sum);
            }
        }
        memoryBarrierBuffer();
        barrier();
    }
}
