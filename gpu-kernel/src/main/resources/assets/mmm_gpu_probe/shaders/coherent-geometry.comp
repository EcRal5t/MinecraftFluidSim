#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
layout(local_size_x=128) in;
layout(binding=0,std430) buffer Arena { uint words[]; };
layout(binding=1,std430) buffer Errors { uint errors; };
layout(push_constant) uniform Params { int header;int stage;int count; } p;
int h(int i){return int(words[p.header+i]);}
void invalid(){atomicOr(errors,524288u);}
int64_t quantity(int address){return int64_t(uint64_t(words[address])|(uint64_t(words[address+1])<<32));}
void main(){
    int id=int((gl_WorkGroupID.y*gl_NumWorkGroups.x+gl_WorkGroupID.x)*128u+gl_LocalInvocationID.x);if(id>=p.count)return;
    int count=int(words[h(2)]);if(count<0||count>h(1)){invalid();return;}
    if(p.stage==0){words[h(5)+id]=0u;words[h(7)+id]=0u;}
    else if(p.stage==1||p.stage==2){
        if(id>=count)return;int cell=int(words[h(3)+id]);if(cell<0||cell>=h(0)){invalid();return;}
        if(p.stage==1)atomicAdd(words[h(5)+cell],1u);
        else{uint cursor=words[h(6)+cell]+atomicAdd(words[h(7)+cell],1u);words[h(8)+cursor]=uint(id);}
    }else{
        int64_t sum=int64_t(0);
        for(int i=int(words[h(6)+id]);i<int(words[h(6)+id+1]);i++){
            int row=int(words[h(8)+i]);int64_t volume=quantity(h(4)+2*row);
            if(volume<=int64_t(0)||sum>int64_t(0x7fffffffffffffffUL)-volume){invalid();return;}sum+=volume;
        }
        words[h(9)+2*id]=uint(sum);words[h(9)+2*id+1]=uint(uint64_t(sum)>>32);
    }
}
