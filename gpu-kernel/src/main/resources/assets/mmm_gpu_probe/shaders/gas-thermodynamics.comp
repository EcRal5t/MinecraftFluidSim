#version 450
#extension GL_ARB_gpu_shader_fp64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
layout(local_size_x = 128) in;
layout(binding = 0, std430) buffer Candidate {
    uint words[];
};
layout(binding = 1, std430) buffer Errors {
    uint errors;
};
layout(push_constant) uniform Params {
    int header;
    int stage;
    int count;
    int memberOffsets;
    int members;
    int dryVolumes;
    int cellNodes;
    int cells;
}
p;
// HOST_LAYOUT
const uint ERROR_INVALID_STATE = 16384u;
const int STAGE_REDUCE_VOLUME = 0;
const int STAGE_CLEAR_VOLUME_DISPATCH = 2;
const int STAGE_SHORT_VOLUME = 3;
const int STAGE_PREPARE_VOLUME_DISPATCH = 4;

shared double volumeParts[128];
shared int volumeBegin, volumeEnd, volumeValid;
int headerWord(int index) {
    return int(words[p.header + index]);
}
int gasField(int field) {
    return headerWord(GAS_FIELDS + field);
}
double readDouble(int at) {
    return packDouble2x32(uvec2(words[at], words[at + 1]));
}
void writeDouble(int at, double value) {
    uvec2 bits = unpackDouble2x32(value);
    words[at] = bits.x;
    words[at + 1] = bits.y;
}
int64_t readInt64(int at) {
    return int64_t(uint64_t(words[at]) | (uint64_t(words[at + 1]) << 32));
}
bool isFinite(double value) {
    return !isnan(value) && !isinf(value);
}
void reportInvalid() {
    atomicOr(errors, ERROR_INVALID_STATE);
}
void addCompensated(inout double sum, inout double correction, double value) {
    precise double adjusted = value - correction;
    precise double next = sum + adjusted;
    correction = (next - sum) - adjusted;
    sum = next;
}
void reduceVolume(int node, int lane) {
    // Uniform exits precede every barrier. Errors arising in one workgroup never strand another.
    if (node >= p.count)
        return;
    if (lane == 0) {
        volumeBegin = 0;
        volumeEnd = 0;
        volumeValid = 0;
        int actual = int(words[gasField(GAS_COUNTS)]);
        if (actual < 0 || actual > headerWord(GAS_H_NODE_CAPACITY))
            reportInvalid();
        else if (node < actual && errors == 0u) {
            int key = int(words[gasField(GAS_TOPOLOGY_KEYS) + node]), cell = key / 8;
            if (key < 0 || cell >= p.cells)
                reportInvalid();
            else {
                int row = int(words[p.cellNodes + cell]);
                if (row <= 0 || row > p.cells)
                    reportInvalid();
                else {
                    volumeBegin = int(words[p.memberOffsets + row]);
                    volumeEnd = int(words[p.memberOffsets + row + 1]);
                    volumeValid = 1;
                }
            }
        }
    }
    barrier();
    double sum = 0.0, correction = 0.0;
    for (int item = volumeBegin + lane; item < volumeEnd; item += 128) {
        int cell = int(words[p.members + item]);
        double volume = readDouble(p.dryVolumes + 2 * cell);
        addCompensated(sum, correction, volume);
    }
    volumeParts[lane] = sum;
    barrier();
    for (int width = 64; width > 0; width >>= 1) {
        if (lane < width)
            volumeParts[lane] += volumeParts[lane + width];
        barrier();
    }
    if (lane == 0) {
        double volume = volumeParts[0];
        if (volumeValid != 0 && (!isFinite(volume) || volume <= 0.0))
            reportInvalid();
        writeDouble(headerWord(GAS_H_NODE_VOLUMES) + 2 * node, volumeValid != 0 ? volume : 0.0);
    }
}
void shortVolume(int node) {
    if (node >= p.count)
        return;
    int actual = int(words[gasField(GAS_COUNTS)]);
    writeDouble(headerWord(GAS_H_NODE_VOLUMES) + 2 * node, 0.0);
    if (actual < 0 || actual > headerWord(GAS_H_NODE_CAPACITY)) {
        reportInvalid();
        return;
    }
    if (node >= actual || errors != 0u)
        return;
    int key = int(words[gasField(GAS_TOPOLOGY_KEYS) + node]), cell = key / 8;
    if (key < 0 || cell >= p.cells) {
        reportInvalid();
        return;
    }
    int row = int(words[p.cellNodes + cell]);
    if (row <= 0 || row > p.cells) {
        reportInvalid();
        return;
    }
    int first = int(words[p.memberOffsets + row]), last = int(words[p.memberOffsets + row + 1]);
    if (last - first > 16) {
        uint slot = atomicAdd(words[headerWord(GAS_H_VOLUME_DISPATCH) + 3], 1u);
        words[headerWord(GAS_H_LONG_VOLUMES) + slot] = uint(node);
        return;
    }
    double sum = 0.0, correction = 0.0;
    for (int at = first; at < last; at++)
        addCompensated(sum, correction, readDouble(p.dryVolumes + 2 * int(words[p.members + at])));
    if (!isFinite(sum) || sum <= 0.0)
        reportInvalid();
    else
        writeDouble(headerWord(GAS_H_NODE_VOLUMES) + 2 * node, sum);
}
bool inventory(int node, out int first, out int last, out double anchor, out double mass, out double r) {
    if (headerWord(GAS_H_SELF_PIVOT) >= 0) {
        int sourceFirst = int(words[gasField(GAS_ROW_COMPONENT_OFFSETS) + node]),
            sourceLast = int(words[gasField(GAS_ROW_COMPONENT_OFFSETS) + node + 1]);
        bool sourcePresent = false;
        for (int c = sourceFirst; c < sourceLast; c++)
            if (readInt64(headerWord(GAS_H_SOURCE_STANDARD_VOLUME) + 2 * c) != int64_t(0) ||
                readInt64(headerWord(GAS_H_SOURCE_MASS) + 2 * c) != int64_t(0)) {
                sourcePresent = true;
                break;
            }
        if (!sourcePresent) {
            first = 0;
            last = 0;
        } else {
            int self = int(words[headerWord(GAS_H_SELF_PIVOT) + node]);
            if (self < 0) {
                reportInvalid();
                return false;
            }
            first = int(words[headerWord(GAS_H_PART_OFFSETS) + self]);
            last = int(words[headerWord(GAS_H_PART_OFFSETS) + self + 1]);
        }
    } else {
        first = int(words[gasField(GAS_ROW_COMPONENT_OFFSETS) + node]);
        last = int(words[gasField(GAS_ROW_COMPONENT_OFFSETS) + node + 1]);
    }
    int components = headerWord(GAS_H_SELF_PIVOT) >= 0 ? headerWord(GAS_H_PART_CAPACITY) : int(words[gasField(GAS_COUNTS) + 1]),
        species = headerWord(GAS_H_SELF_PIVOT) >= 0 ? headerWord(GAS_H_SPECIES_CAPACITY) : int(words[gasField(GAS_COUNTS) + 2]);
    if (first < 0 || last < first || last > components) {
        reportInvalid();
        return false;
    }
    anchor = 0.0;
    double correction = 0.0;
    int64_t totalMass = int64_t(0), totalNanos = int64_t(0);
    for (int component = first; component < last; component++) {
        int64_t componentMass = readInt64(gasField(GAS_MASS_UNITS) + 2 * component),
                nanos = readInt64(gasField(GAS_STANDARD_VOLUME_NANOS) + 2 * component);
        if (componentMass == int64_t(0) && nanos == int64_t(0))
            continue;
        int handle = int(words[gasField(GAS_COMPONENT_HANDLES) + component]);
        if (handle < 0 || handle >= headerWord(GAS_H_COMPONENT_COUNT)) {
            reportInvalid();
            return false;
        }
        int begin = int(words[headerWord(GAS_H_SEGMENT_OFFSETS) + handle]),
            end = int(words[headerWord(GAS_H_SEGMENT_OFFSETS) + handle + 1]);
        double reference = readDouble(headerWord(GAS_H_ANCHOR_ENERGY) + 2 * handle);
        if (begin == end || !isFinite(reference) || componentMass <= int64_t(0) || nanos <= int64_t(0) ||
            componentMass > int64_t(0x7fffffffffffffffUL) - totalMass ||
            nanos > int64_t(0x7fffffffffffffffUL) - totalNanos) {
            reportInvalid();
            return false;
        }
        totalMass += componentMass;
        totalNanos += nanos;
        addCompensated(anchor, correction, double(componentMass) * 1e-10LF * reference);
        int speciesBegin = int(words[gasField(GAS_COMPONENT_SPECIES_OFFSETS) + component]),
            speciesEnd = int(words[gasField(GAS_COMPONENT_SPECIES_OFFSETS) + component + 1]);
        if (speciesBegin < 0 || speciesEnd < speciesBegin || speciesEnd > species) {
            reportInvalid();
            return false;
        }
        for (int entry = speciesBegin; entry < speciesEnd; entry++) {
            int64_t amount = readInt64(gasField(GAS_SPECIES_AMOUNTS) + 2 * entry);
            if (amount == int64_t(0))
                continue;
            int speciesHandle = int(words[gasField(GAS_SPECIES_HANDLES) + entry]);
            if (amount < int64_t(0) || speciesHandle < 0 || speciesHandle >= headerWord(GAS_H_SPECIES_STRIDE)) {
                reportInvalid();
                return false;
            }
            double offset = readDouble(headerWord(GAS_H_SPECIES_REFERENCE) + 2 * (handle * headerWord(GAS_H_SPECIES_STRIDE) + speciesHandle));
            if (!isFinite(offset)) {
                reportInvalid();
                return false;
            }
            addCompensated(anchor, correction, double(amount) * offset);
        }
    }
    if (totalMass == int64_t(0) && totalNanos == int64_t(0))
        first = last;
    mass = double(totalMass) * 1e-10LF;
    r = double(totalNanos) * readDouble(p.header + GAS_H_PRESSURE_FACTOR);
    if (!isFinite(anchor) || !isFinite(mass) || !isFinite(r)) {
        reportInvalid();
        return false;
    }
    return true;
}
// The union of material segment endpoints is traversed implicitly. Each iteration
// advances to the next real caloric endpoint, so there is no numerical iteration cap.
double capacityAndBoundary(int first, int last, double temperature, bool heating, out double boundary) {
    boundary = heating ? packDouble2x32(uvec2(0u, 0x7ff00000u)) : readDouble(p.header + GAS_H_MINIMUM_TEMPERATURE);
    double capacity = 0.0, correction = 0.0;
    for (int component = first; component < last; component++) {
        if (readInt64(gasField(GAS_STANDARD_VOLUME_NANOS) + 2 * component) == int64_t(0))
            continue;
        int handle = int(words[gasField(GAS_COMPONENT_HANDLES) + component]);
        int begin = int(words[headerWord(GAS_H_SEGMENT_OFFSETS) + handle]),
            end = int(words[headerWord(GAS_H_SEGMENT_OFFSETS) + handle + 1]), segment = begin;
        while (segment + 1 < end) {
            double upper = readDouble(headerWord(GAS_H_SEGMENT_UPPER) + 2 * segment);
            if (heating ? temperature < upper : temperature <= upper)
                break;
            segment++;
        }
        double cp = readDouble(headerWord(GAS_H_SEGMENT_CAPACITY) + 2 * segment),
               mass = double(readInt64(gasField(GAS_MASS_UNITS) + 2 * component)) * 1e-10LF;
        addCompensated(capacity, correction, mass * cp);
        if (heating && segment + 1 < end)
            boundary = min(boundary, readDouble(headerWord(GAS_H_SEGMENT_UPPER) + 2 * segment));
        else if (!heating && segment > begin)
            boundary = max(boundary, readDouble(headerWord(GAS_H_SEGMENT_UPPER) + 2 * (segment - 1)));
    }
    return capacity;
}
void derive(int node) {
    if (node >= p.count)
        return;
    int outputOffset = headerWord(GAS_H_STATES) + 18 * node;
    for (int i = 0; i < 9; i++)
        writeDouble(outputOffset + 2 * i, 0.0);
    if (errors != 0u)
        return;
    int actual = int(words[gasField(GAS_COUNTS)]);
    if (actual < 0 || actual > headerWord(GAS_H_NODE_CAPACITY)) {
        reportInvalid();
        return;
    }
    if (node >= actual)
        return;
    double volume = readDouble(headerWord(GAS_H_NODE_VOLUMES) + 2 * node), energy = readDouble(gasField(GAS_INTERNAL_ENERGY) + 2 * node);
    if (!isFinite(volume) || volume < 0.0 || !isFinite(energy)) {
        reportInvalid();
        return;
    }
    int first, last;
    double anchor, mass, r;
    if (!inventory(node, first, last, anchor, mass, r))
        return;
    double temperature = readDouble(p.header + GAS_H_STANDARD_TEMPERATURE);
    if (first == last) {
        if (energy != 0.0) {
            reportInvalid();
            return;
        }
        writeDouble(outputOffset, temperature);
        writeDouble(outputOffset + 10, 1.0);
        return;
    }
    if (words[gasField(GAS_ENERGY_PRESENT)] == 0u || volume <= 0.0) {
        reportInvalid();
        return;
    }
    if (headerWord(GAS_H_ISOTHERMAL) != 0) {
        energy = anchor;
        writeDouble(gasField(GAS_INTERNAL_ENERGY) + 2 * node, anchor);
    }
    double residual = energy - anchor;
    if (!isFinite(residual)) {
        reportInvalid();
        return;
    }
    bool heating = residual >= 0.0;
    double remaining = abs(residual), capacity, boundary;
    while (true) {
        capacity = capacityAndBoundary(first, last, temperature, heating, boundary);
        if (!(isFinite(capacity) && capacity > 0.0)) {
            reportInvalid();
            return;
        }
        double step = remaining / capacity;
        double span = heating ? boundary - temperature : temperature - boundary;
        if (step <= span) {
            temperature += heating ? step : -step;
            break;
        }
        if (!(span > 0.0 && isFinite(span))) {
            reportInvalid();
            return;
        }
        remaining -= span * capacity;
        temperature = boundary;
    }
    if (!isFinite(temperature) || temperature < readDouble(p.header + GAS_H_MINIMUM_TEMPERATURE)) {
        reportInvalid();
        return;
    }
    // At a caloric endpoint, the reported derivative uses the upper-temperature segment.
    capacity = capacityAndBoundary(first, last, temperature, true, boundary);
    double pressure = r * temperature / volume, density = mass / volume,
           gamma = headerWord(GAS_H_ISOTHERMAL) != 0 ? 1.0 : 1.0 + r / capacity;
    double bulk = gamma * pressure, sound = sqrt(bulk / density), compliance = 1.0 / bulk;
    if (!(isFinite(pressure) && pressure > 0.0 && isFinite(density) && density > 0.0 && isFinite(capacity) &&
          capacity > 0.0 && isFinite(r) && r > 0.0 && isFinite(gamma) && gamma >= 1.0 && isFinite(bulk) && bulk > 0.0 &&
          isFinite(sound) && sound > 0.0 && isFinite(compliance) && compliance > 0.0)) {
        reportInvalid();
        return;
    }
    writeDouble(outputOffset, temperature);
    writeDouble(outputOffset + 2, pressure);
    writeDouble(outputOffset + 4, density);
    writeDouble(outputOffset + 6, capacity);
    writeDouble(outputOffset + 8, r);
    writeDouble(outputOffset + 10, gamma);
    writeDouble(outputOffset + 12, bulk);
    writeDouble(outputOffset + 14, sound);
    writeDouble(outputOffset + 16, compliance);
}
void main() {
    int group = int(gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x), lane = int(gl_LocalInvocationID.x);
    if (p.stage == STAGE_CLEAR_VOLUME_DISPATCH) {
        if (group == 0 && lane == 0)
            words[headerWord(GAS_H_VOLUME_DISPATCH) + 3] = 0u;
        return;
    }
    if (p.stage == STAGE_SHORT_VOLUME) {
        shortVolume(group * 128 + lane);
        return;
    }
    if (p.stage == STAGE_PREPARE_VOLUME_DISPATCH) {
        if (group == 0 && lane == 0) {
            int count = errors == 0u ? int(words[headerWord(GAS_H_VOLUME_DISPATCH) + 3]) : 0;
            words[headerWord(GAS_H_VOLUME_DISPATCH)] = uint(min(count, 65535));
            words[headerWord(GAS_H_VOLUME_DISPATCH) + 1] = uint(max(1, (count + 65534) / 65535));
            words[headerWord(GAS_H_VOLUME_DISPATCH) + 2] = 1u;
        }
        return;
    }
    if (p.stage == STAGE_REDUCE_VOLUME) {
        if (group < int(words[headerWord(GAS_H_VOLUME_DISPATCH) + 3]))
            reduceVolume(int(words[headerWord(GAS_H_LONG_VOLUMES) + group]), lane);
    } else
        derive(group * 128 + lane);
}
