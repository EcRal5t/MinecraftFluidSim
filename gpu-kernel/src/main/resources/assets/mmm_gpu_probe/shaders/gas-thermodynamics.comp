#version 450
#extension GL_ARB_gpu_shader_fp64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
layout(local_size_x = 128) in;
layout(binding = 0, std430) buffer Candidate {
    uint words[];
};
layout(binding = 1, std430) buffer Errors {
    uint errors;
};
layout(push_constant) uniform Params {
    int header;
    int stage;
    int count;
    int memberOffsets;
    int members;
    int dryVolumes;
    int cellNodes;
    int cells;
}
p;
// HOST_LAYOUT
const uint ERROR_INVALID_STATE = 128u;
int headerWord(int index) {
    return int(words[p.header + index]);
}
int gasField(int field) {
    return headerWord(GAS_FIELDS + field);
}
double readDouble(int at) {
    return packDouble2x32(uvec2(words[at], words[at + 1]));
}
void writeDouble(int at, double value) {
    uvec2 bits = unpackDouble2x32(value);
    words[at] = bits.x;
    words[at + 1] = bits.y;
}
int64_t readInt64(int at) {
    return int64_t(uint64_t(words[at]) | (uint64_t(words[at + 1]) << 32));
}
bool isFinite(double value) {
    return !isnan(value) && !isinf(value);
}
void reportInvalid() {
    atomicOr(errors, ERROR_INVALID_STATE);
}
int gasCaloricHeader() { return p.header; }
int64_t gasCaloricReadInt64(int at) { return readInt64(at); }
// GAS_CALORIC_LIBRARY
int gasStateHeaderWord(int index){return headerWord(index);}
int gasStateField(int index){return gasField(index);}
void reportGasStateInvalid(){reportInvalid();}
// GAS_THERMODYNAMIC_STATE
void main() {
    int item=int((gl_WorkGroupID.y*gl_NumWorkGroups.x+gl_WorkGroupID.x)*128u+gl_LocalInvocationID.x);
    deriveGasState(item,p.stage,p.count);
}
