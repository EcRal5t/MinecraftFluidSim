#version 450
#extension GL_ARB_gpu_shader_fp64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
// HOST_LAYOUT
// SPATIAL_GRID

// Packed record attributes and fixed grid geometry; numeric values preserve the device layout.
const int GEOMETRY_STRIDE = 4;
const int CELL_LIQUID_VOLUME = 0, CELL_LIQUID_MASS = 1, CELL_PORE_VOLUME = 2;
const int FACE_OPEN_AREA = 2, FACE_LIQUID_AREA = 3;
const int GAS_STATE_STRIDE = 9, GAS_ABSOLUTE_PRESSURE = 1, GAS_COMPRESSIBILITY = 8;
const int BODY_BOUNDS_STRIDE = 6, BOUNDS_MAXIMUM_OFFSET = 3;
const int BODY_VECTOR_STRIDE = 3, CELL_SIDE_COUNT = 6;
const int MICROCELL_COUNT = 8;
const double MICROCELL_SIZE = .5, MICROFACE_AREA = .25;
const double SOLID_QUANTA_PER_CELL = 16777216.0;
const double OCCUPATION_ROUNDOFF_TOLERANCE = 1e-9;
const uint ERROR_INVALID_BODY = 16777216u;

layout(local_size_x = 128) in;
layout(binding = 0, std430) buffer Arena {
    uint arenaWords[];
};
layout(binding = 1, std430) buffer Errors {
    uint errorFlags;
};
layout(push_constant) uniform Params {
    int header;
    int stage;
    int count;
    int unused;
    double cellSize;
    double duration;
    double unusedDouble;
}
params;
int headerWord(int headerField) {
    return int(arenaWords[params.header + headerField]);
}
int fieldWordOffset(int field) {
    return headerWord(H_FIELDS + field);
}
int readIntField(int field, int index) {
    return int(arenaWords[fieldWordOffset(field) + index]);
}
void writeIntField(int field, int index, int value) {
    arenaWords[fieldWordOffset(field) + index] = uint(value);
}
double readDoubleAt(int wordOffset) {
    return packDouble2x32(uvec2(arenaWords[wordOffset], arenaWords[wordOffset + 1]));
}
void writeDoubleAt(int wordOffset, double value) {
    uvec2 bits = unpackDouble2x32(value);
    arenaWords[wordOffset] = bits.x;
    arenaWords[wordOffset + 1] = bits.y;
}
double readDoubleField(int field, int index) {
    return readDoubleAt(fieldWordOffset(field) + 2 * index);
}
void writeDoubleField(int field, int index, double value) {
    writeDoubleAt(fieldWordOffset(field) + 2 * index, value);
}
int64_t readInt64At(int wordOffset) {
    return int64_t(uint64_t(arenaWords[wordOffset]) | (uint64_t(arenaWords[wordOffset + 1]) << 32));
}
void writeInt64At(int wordOffset, int64_t value) {
    arenaWords[wordOffset] = uint(value);
    arenaWords[wordOffset + 1] = uint(uint64_t(value) >> 32);
}
ivec3 gridSize() {
    return ivec3(headerWord(H_SIZE_X), headerWord(H_SIZE_Y), headerWord(H_SIZE_Z));
}
bool isInsideGrid(ivec3 coordinates) { return gridCell(coordinates) >= 0; }
int cellIndexAt(ivec3 coordinates) { return gridCell(coordinates); }
ivec3 cellCoordinates(int cellIndex) { return gridPosition(cellIndex); }
int bodyCount() {
    return readIntField(F_CONTROL, CONTROL_BODY_COUNT);
}
int entryCount() {
    return readIntField(F_CONTROL, CONTROL_ENTRY_COUNT);
}
int contactCount() {
    return readIntField(F_CONTROL, CONTROL_CONTACT_COUNT);
}
bool isFinite(double value) {
    return !isnan(value) && !isinf(value);
}
void reportInvalidBody() {
    atomicOr(errorFlags, ERROR_INVALID_BODY);
}
dvec3 bodyMinimum(int bodyIndex) {
    return dvec3(readDoubleField(F_BOUNDS, BODY_BOUNDS_STRIDE * bodyIndex),
                 readDoubleField(F_BOUNDS, BODY_BOUNDS_STRIDE * bodyIndex + 1),
                 readDoubleField(F_BOUNDS, BODY_BOUNDS_STRIDE * bodyIndex + 2)) /
           params.cellSize;
}
dvec3 bodyMaximum(int bodyIndex) {
    return dvec3(readDoubleField(F_BOUNDS, BODY_BOUNDS_STRIDE * bodyIndex + BOUNDS_MAXIMUM_OFFSET),
                 readDoubleField(F_BOUNDS, BODY_BOUNDS_STRIDE * bodyIndex + BOUNDS_MAXIMUM_OFFSET + 1),
                 readDoubleField(F_BOUNDS, BODY_BOUNDS_STRIDE * bodyIndex + BOUNDS_MAXIMUM_OFFSET + 2)) /
           params.cellSize;
}
int faceAxis(int faceIndex) { return gridFaceEndpoints(faceIndex).z; }
int faceIndexAt(int axis, ivec3 coordinates) { return gridFaceAt(coordinates, axis); }
ivec2 adjacentCells(int faceIndex) { return gridFaceEndpoints(faceIndex).xy; }
double cellGeometry(int cellIndex, int component) {
    return cellIndex < 0 ? 0.0
                         : readDoubleAt(headerWord(H_GEOMETRY_CELLS) + 2 * (GEOMETRY_STRIDE * cellIndex + component));
}
double faceGeometry(int faceIndex, int component) {
    return readDoubleAt(headerWord(H_GEOMETRY_FACES) + 2 * (GEOMETRY_STRIDE * faceIndex + component));
}
bool isMicrocellOpen(ivec3 microCoordinates) {
    ivec3 cellCoordinatesValue = microCoordinates / 2;
    if (any(lessThan(microCoordinates, ivec3(0))) || !isInsideGrid(cellCoordinatesValue))
        return false;
    int microcellBit = (microCoordinates.x & 1) + 2 * (microCoordinates.y & 1) + 4 * (microCoordinates.z & 1);
    return (arenaWords[headerWord(H_MASKS) + cellIndexAt(cellCoordinatesValue)] & (1u << microcellBit)) == 0u;
}
double openFaceArea(int faceIndex) {
    ivec2 adjacent = adjacentCells(faceIndex);
    if (adjacent.x < 0 || adjacent.y < 0)
        return 0.0;
    int axis = faceAxis(faceIndex), openMicrofaces = 0;
    ivec3 faceMicroOrigin = cellCoordinates(adjacent.y) * 2;
    int tangentAxisA = axis == 0 ? 1 : 0, tangentAxisB = axis == 2 ? 1 : 2;
    for (int microface = 0; microface < 4; microface++) {
        ivec3 rightMicrocell = faceMicroOrigin;
        rightMicrocell[tangentAxisA] += microface & 1;
        rightMicrocell[tangentAxisB] += (microface >> 1) & 1;
        ivec3 leftMicrocell = rightMicrocell;
        leftMicrocell[axis]--;
        if (isMicrocellOpen(rightMicrocell) && isMicrocellOpen(leftMicrocell))
            openMicrofaces++;
    }
    return MICROFACE_AREA * double(openMicrofaces);
}
void clipBodyToMicrocell(int body, dvec3 microLow, out dvec3 clippedMinimum, out dvec3 clippedMaximum) {
    clippedMinimum = max(microLow, bodyMinimum(body));
    clippedMaximum = min(microLow + MICROCELL_SIZE, bodyMaximum(body));
}
void enumerateBodyEntry(int entry) {
    writeIntField(F_ENTRY_CELL, entry, -1);
    writeDoubleField(F_ENTRY_VOLUME, entry, 0.0);
    for (int axis = 0; axis < 3; axis++)
        writeDoubleField(F_ENTRY_WET_AREA, BODY_VECTOR_STRIDE * entry + axis, 0.0);
    for (int side = 0; side < CELL_SIDE_COUNT; side++)
        writeIntField(F_ENTRY_CONTACTS, CELL_SIDE_COUNT * entry + side, -1);
    if (entry >= entryCount())
        return;
    int lower = 0, upper = bodyCount();
    while (lower < upper) {
        int middle = (lower + upper) / 2;
        if (readIntField(F_BODY_OFFSETS, middle + 1) <= entry)
            lower = middle + 1;
        else
            upper = middle;
    }
    int body = lower;
    if (body >= bodyCount()) {
        reportInvalidBody();
        return;
    }
    ivec3 first = max(ivec3(0), ivec3(floor(bodyMinimum(body)))),
          last = min(gridSize(), ivec3(ceil(bodyMaximum(body)))), extent = last - first;
    int ordinal = entry - readIntField(F_BODY_OFFSETS, body);
    ivec3 coordinates =
        first + ivec3(ordinal % extent.x, ordinal / extent.x % extent.y, ordinal / (extent.x * extent.y));
    int cellIndex = cellIndexAt(coordinates);
    if (cellIndex < 0) return;
    double volume = 0.0;
    dvec3 wetAreas = dvec3(0.0);
    for (int bit = 0; bit < MICROCELL_COUNT; bit++)
        if ((arenaWords[headerWord(H_MASKS) + cellIndex] & (1u << bit)) == 0u) {
            dvec3 micro = dvec3(coordinates) + MICROCELL_SIZE * dvec3(bit & 1, (bit >> 1) & 1, (bit >> 2) & 1),
                  clippedMinimum, clippedMaximum;
            clipBodyToMicrocell(body, micro, clippedMinimum, clippedMaximum);
            dvec3 clippedSize = max(dvec3(0.0), clippedMaximum - clippedMinimum);
            volume += clippedSize.x * clippedSize.y * clippedSize.z;
            for (int axis = 0; axis < 3; axis++) {
                int tangentAxisA = axis == 0 ? 1 : 0, tangentAxisB = axis == 2 ? 1 : 2;
                if (clippedSize[tangentAxisA] <= 0.0 || clippedSize[tangentAxisB] <= 0.0)
                    continue;
                if (bodyMinimum(body)[axis] >= micro[axis] && bodyMinimum(body)[axis] < micro[axis] + MICROCELL_SIZE)
                    wetAreas[axis] += clippedSize[tangentAxisA] * clippedSize[tangentAxisB];
                if (bodyMaximum(body)[axis] > micro[axis] && bodyMaximum(body)[axis] <= micro[axis] + MICROCELL_SIZE)
                    wetAreas[axis] += clippedSize[tangentAxisA] * clippedSize[tangentAxisB];
            }
        }
    if (volume <= 0.0)
        return;
    writeIntField(F_ENTRY_CELL, entry, cellIndex);
    writeIntField(F_ENTRY_BODY, entry, body);
    writeDoubleField(F_ENTRY_VOLUME, entry, volume);
    for (int axis = 0; axis < 3; axis++)
        writeDoubleField(F_ENTRY_WET_AREA, BODY_VECTOR_STRIDE * entry + axis,
                         wetAreas[axis] * params.cellSize * params.cellSize);
    atomicAdd(arenaWords[fieldWordOffset(F_CELL_COUNTS) + cellIndex], 1u);
}
// Exact clipped box union through sorted coordinate slabs. The local lists contain only
// bodies intersecting this cell; coincident boxes share the same coordinate cuts.
double bodyUnionVolumeInMicrocell(int cellIndex, dvec3 micro) {
    int begin = readIntField(F_CELL_OFFSETS, cellIndex), end = readIntField(F_CELL_OFFSETS, cellIndex + 1);
    double unionVolume = 0.0, x = micro.x;
    while (x < micro.x + MICROCELL_SIZE) {
        double nextX = micro.x + MICROCELL_SIZE;
        for (int member = begin; member < end; member++) {
            int bodyIndex = readIntField(F_ENTRY_BODY, readIntField(F_CELL_ENTRIES, member));
            dvec3 clippedMinimum, clippedMaximum;
            clipBodyToMicrocell(bodyIndex, micro, clippedMinimum, clippedMaximum);
            if (any(lessThanEqual(clippedMaximum, clippedMinimum)))
                continue;
            if (clippedMinimum.x > x)
                nextX = min(nextX, clippedMinimum.x);
            if (clippedMaximum.x > x)
                nextX = min(nextX, clippedMaximum.x);
        }
        if (nextX <= x)
            break;
        double midX = .5 * (x + nextX), y = micro.y;
        while (y < micro.y + MICROCELL_SIZE) {
            double nextY = micro.y + MICROCELL_SIZE;
            for (int member = begin; member < end; member++) {
                int bodyIndex = readIntField(F_ENTRY_BODY, readIntField(F_CELL_ENTRIES, member));
                dvec3 clippedMinimum, clippedMaximum;
                clipBodyToMicrocell(bodyIndex, micro, clippedMinimum, clippedMaximum);
                if (any(lessThanEqual(clippedMaximum, clippedMinimum)) || midX < clippedMinimum.x ||
                    midX >= clippedMaximum.x)
                    continue;
                if (clippedMinimum.y > y)
                    nextY = min(nextY, clippedMinimum.y);
                if (clippedMaximum.y > y)
                    nextY = min(nextY, clippedMaximum.y);
            }
            if (nextY <= y)
                break;
            double midY = .5 * (y + nextY), coveredZ = micro.z, coveredLengthZ = 0.0;
            while (coveredZ < micro.z + MICROCELL_SIZE) {
                double first = micro.z + MICROCELL_SIZE, last = coveredZ;
                for (int member = begin; member < end; member++) {
                    int bodyIndex = readIntField(F_ENTRY_BODY, readIntField(F_CELL_ENTRIES, member));
                    dvec3 clippedMinimum, clippedMaximum;
                    clipBodyToMicrocell(bodyIndex, micro, clippedMinimum, clippedMaximum);
                    if (any(lessThanEqual(clippedMaximum, clippedMinimum)) || midX < clippedMinimum.x ||
                        midX >= clippedMaximum.x || midY < clippedMinimum.y || midY >= clippedMaximum.y ||
                        clippedMaximum.z <= coveredZ)
                        continue;
                    if (clippedMinimum.z <= coveredZ)
                        last = max(last, clippedMaximum.z);
                    else
                        first = min(first, clippedMinimum.z);
                }
                if (last > coveredZ) {
                    coveredLengthZ += last - coveredZ;
                    coveredZ = last;
                } else if (first > coveredZ)
                    coveredZ = first;
                else
                    break;
            }
            unionVolume += (nextX - x) * (nextY - y) * coveredLengthZ;
            y = nextY;
        }
        x = nextX;
    }
    return unionVolume;
}
void gatherCellOccupation(int cellIndex) {
    double summedVolume = 0.0;
    int begin = readIntField(F_CELL_OFFSETS, cellIndex), end = readIntField(F_CELL_OFFSETS, cellIndex + 1);
    for (int member = begin; member < end; member++)
        summedVolume += readDoubleField(F_ENTRY_VOLUME, readIntField(F_CELL_ENTRIES, member));
    double unionVolume = summedVolume;
    if (end - begin > 1) {
        unionVolume = 0.0;
        ivec3 coordinates = cellCoordinates(cellIndex);
        for (int bit = 0; bit < MICROCELL_COUNT; bit++)
            if ((arenaWords[headerWord(H_MASKS) + cellIndex] & (1u << bit)) == 0u)
                unionVolume += bodyUnionVolumeInMicrocell(
                    cellIndex, dvec3(coordinates) + MICROCELL_SIZE * dvec3(bit & 1, (bit >> 1) & 1, (bit >> 2) & 1));
    }
    if (!isFinite(unionVolume) || unionVolume < 0.0 || unionVolume > 1.0 + OCCUPATION_ROUNDOFF_TOLERANCE) {
        reportInvalidBody();
        return;
    }
    if (summedVolume > 0.0)
        for (int member = begin; member < end; member++) {
            int entry = readIntField(F_CELL_ENTRIES, member);
            writeDoubleField(F_ENTRY_VOLUME, entry,
                             readDoubleField(F_ENTRY_VOLUME, entry) * unionVolume / summedVolume);
            for (int axis = 0; axis < 3; axis++)
                writeDoubleField(
                    F_ENTRY_WET_AREA, BODY_VECTOR_STRIDE * entry + axis,
                    readDoubleField(F_ENTRY_WET_AREA, BODY_VECTOR_STRIDE * entry + axis) * unionVolume / summedVolume);
        }
    int64_t occupiedQuanta = int64_t(floor(unionVolume * SOLID_QUANTA_PER_CELL + .5)),
            baseSolidQuanta = headerWord(H_BASE_SOLID) < 0 ? 0l : readInt64At(headerWord(H_BASE_SOLID) + 2 * cellIndex);
    writeInt64At(fieldWordOffset(F_OCCUPIED_SVQ) + 2 * cellIndex, occupiedQuanta);
    writeInt64At(fieldWordOffset(F_COMBINED_SVQ) + 2 * cellIndex, baseSolidQuanta + occupiedQuanta);
}
void buildEntryFaceContacts(int entry, bool scatter) {
    int cellIndex = readIntField(F_ENTRY_CELL, entry);
    if (cellIndex < 0)
        return;
    ivec3 coordinates = cellCoordinates(cellIndex);
    double entryVolume = readDoubleField(F_ENTRY_VOLUME, entry);
    for (int axis = 0; axis < 3; axis++) {
        ivec3 next = coordinates;
        next[axis]++;
        int negativeFace = faceIndexAt(axis, coordinates), positiveFace = faceIndexAt(axis, next);
        double negativeOpenArea = openFaceArea(negativeFace), positiveOpenArea = openFaceArea(positiveFace),
               totalOpenArea = negativeOpenArea + positiveOpenArea;
        if (totalOpenArea == 0.0)
            continue;
        for (int side = 0; side < 2; side++) {
            int faceIndex = side == 0 ? negativeFace : positiveFace;
            double weight = entryVolume * (side == 0 ? negativeOpenArea : positiveOpenArea) / totalOpenArea;
            if (weight == 0.0)
                continue;
            if (!scatter)
                atomicAdd(arenaWords[fieldWordOffset(F_FACE_COUNTS) + faceIndex], 1u);
            else {
                int slot = readIntField(F_FACE_OFFSETS, faceIndex) +
                           int(atomicAdd(arenaWords[fieldWordOffset(F_FACE_CURSORS) + faceIndex], 1u));
                writeIntField(F_CONTACT_BODY, slot, readIntField(F_ENTRY_BODY, entry));
                writeIntField(F_CONTACT_ENTRY, slot, entry);
                writeIntField(F_CONTACT_FACE, slot, faceIndex);
                writeDoubleField(F_CONTACT_SHARE, slot, weight);
                writeIntField(F_ENTRY_CONTACTS, CELL_SIDE_COUNT * entry + 2 * axis + side, slot);
            }
        }
    }
}
void gatherFaceOccupation(int faceIndex) {
    double totalShare = 0.0;
    for (int contact = readIntField(F_FACE_OFFSETS, faceIndex); contact < readIntField(F_FACE_OFFSETS, faceIndex + 1);
         contact++)
        totalShare += readDoubleField(F_CONTACT_SHARE, contact);
    writeDoubleField(F_FACE_AREA, faceIndex, min(openFaceArea(faceIndex), totalShare));
    if (totalShare > 0.0)
        for (int contact = readIntField(F_FACE_OFFSETS, faceIndex);
             contact < readIntField(F_FACE_OFFSETS, faceIndex + 1); contact++)
            writeDoubleField(
                F_CONTACT_SHARE, contact,
                readDoubleField(F_CONTACT_SHARE, contact) * min(openFaceArea(faceIndex), totalShare) / totalShare);
    if (faceIndex == 0)
        writeIntField(F_CONTROL, CONTROL_CONTACT_COUNT, readIntField(F_FACE_OFFSETS, headerWord(H_FACES)));
}
void gatherBodyTotals(int body) {
    for (int component = 0; component < BODY_TOTAL_STRIDE; component++)
        writeDoubleField(F_BODY_TOTALS, BODY_TOTAL_STRIDE * body + component, 0.0);
    if (body >= bodyCount())
        return;
    dvec3 wetAreas = dvec3(0.0), contactVolumes = dvec3(0.0);
    double wetVolume = 0.0;
    for (int entry = readIntField(F_BODY_OFFSETS, body); entry < readIntField(F_BODY_OFFSETS, body + 1); entry++) {
        int cellIndex = readIntField(F_ENTRY_CELL, entry);
        if (cellIndex < 0)
            continue;
        double entryVolume = readDoubleField(F_ENTRY_VOLUME, entry);
        ivec3 coordinates = cellCoordinates(cellIndex);
        if (cellGeometry(cellIndex, CELL_LIQUID_VOLUME) > 0.0)
            wetVolume += entryVolume;
        for (int axis = 0; axis < 3; axis++) {
            wetAreas[axis] += readDoubleField(F_ENTRY_WET_AREA, BODY_VECTOR_STRIDE * entry + axis);
            ivec3 next = coordinates;
            next[axis]++;
            if (openFaceArea(faceIndexAt(axis, coordinates)) + openFaceArea(faceIndexAt(axis, next)) > 0.0)
                contactVolumes[axis] += entryVolume;
        }
    }
    for (int axis = 0; axis < 3; axis++) {
        writeDoubleField(F_BODY_TOTALS, BODY_TOTAL_STRIDE * body + BODY_TOTAL_WET_AREA_X + axis, wetAreas[axis]);
        writeDoubleField(F_BODY_TOTALS, BODY_TOTAL_STRIDE * body + BODY_TOTAL_CONTACT_VOLUME_X + axis,
                         contactVolumes[axis]);
    }
    writeDoubleField(F_BODY_TOTALS, BODY_TOTAL_STRIDE * body + BODY_TOTAL_WET_VOLUME, wetVolume);
}
int coupledHeaderWord(int headerField) {
    return int(arenaWords[headerWord(H_COUPLED_PRESSURE) + headerField]);
}
int coupledFieldWordOffset(int field) {
    return coupledHeaderWord(COUPLED_WORK_FIELDS + field);
}
int pressureRowForCell(int cellIndex) {
    return cellIndex >= 0 && cellGeometry(cellIndex, CELL_LIQUID_MASS) > 0.0 && cellGeometry(cellIndex, CELL_PORE_VOLUME) > 0.0
        ? cellIndex : -1;
}
double physicalRowPressure(int row) {
    return row < 0 ? 0.0 : max(0.0, readDoubleAt(headerWord(H_MIXTURE_STATES) + 2 * (7 * row)) +
        readDoubleAt(coupledHeaderWord(COUPLED_H_PRESSURE) + 2 * row));
}
void buildPressureContacts(int contact) {
    for (int side = 0; side < 2; side++) {
        writeIntField(F_PRESSURE_ROW, 2 * contact + side, -1);
        writeDoubleField(F_PRESSURE_COEFFICIENT, 2 * contact + side, 0.0);
    }
    if (contact >= contactCount())
        return;
    int faceIndex = readIntField(F_CONTACT_FACE, contact);
    if (headerWord(H_ACTIVITY_FACES) >= 0 && arenaWords[headerWord(H_ACTIVITY_FACES) + faceIndex] == 0u)
        return;
    ivec2 cells = adjacentCells(faceIndex);
    if (cells.x < 0)
        return;
    ivec2 pressureRows = ivec2(pressureRowForCell(cells.x), pressureRowForCell(cells.y));
    if (pressureRows.x == pressureRows.y)
        return;
    for (int side = 0; side < 2; side++) {
        int index = 2 * contact + side;
        double coefficient = (side == 0 ? 1.0 : -1.0) * readDoubleField(F_CONTACT_SHARE, contact) / params.cellSize;
        writeIntField(F_PRESSURE_ROW, index, pressureRows[side]);
        writeDoubleField(F_PRESSURE_COEFFICIENT, index, coefficient);
    }
}
void assembleBodyVolumeRate(int row) {
    double bodyVolumeRate = row < headerWord(H_CELLS)
        ? double(readInt64At(headerWord(H_SOURCE_OCCUPATION) + 2 * row) - readInt64At(fieldWordOffset(F_OCCUPIED_SVQ) + 2 * row)) /
              (SOLID_QUANTA_PER_CELL * params.duration)
        : 0.0;
    writeDoubleField(F_ROW_BODY_RATE, row, bodyVolumeRate);
    if (bodyVolumeRate == 0.0 || row >= headerWord(H_CELLS) || pressureRowForCell(row) < 0)
        return;
    writeDoubleAt(
        coupledFieldWordOffset(COUPLED_F_ROW_SOURCE) + 2 * row,
        readDoubleAt(coupledFieldWordOffset(COUPLED_F_ROW_SOURCE) + 2 * row) - bodyVolumeRate / params.duration);
    arenaWords[coupledFieldWordOffset(COUPLED_F_ROW_ENABLED) + row] = 1u;
}
void gatherBodyResult(int body) {
    for (int component = 0; component < BODY_RESULT_STRIDE; component++)
        writeDoubleField(F_BODY_RESULTS, BODY_RESULT_STRIDE * body + component, 0.0);
    if (body >= bodyCount())
        return;
    dvec3 pressureImpulse = dvec3(0.0), shearImpulse = dvec3(0.0);
    double volume = 0.0;
    for (int entry = readIntField(F_BODY_OFFSETS, body); entry < readIntField(F_BODY_OFFSETS, body + 1); entry++)
        for (int slot = 0; slot < CELL_SIDE_COUNT; slot++) {
            int contact = readIntField(F_ENTRY_CONTACTS, CELL_SIDE_COUNT * entry + slot);
            if (contact < 0)
                continue;
            int axis = faceAxis(readIntField(F_CONTACT_FACE, contact));
            double pressureForceDensity = 0.0;
            for (int side = 0; side < 2; side++)
                pressureForceDensity += readDoubleField(F_PRESSURE_COEFFICIENT, 2 * contact + side) *
                                        physicalRowPressure(readIntField(F_PRESSURE_ROW, 2 * contact + side));
            pressureImpulse[axis] -=
                params.duration * params.cellSize * params.cellSize * params.cellSize * pressureForceDensity;
            if (headerWord(H_CONTACT_IMPULSE) >= 0)
                shearImpulse[axis] -= readDoubleAt(headerWord(H_CONTACT_IMPULSE) + 2 * contact);
        }
    for (int entry = readIntField(F_BODY_OFFSETS, body); entry < readIntField(F_BODY_OFFSETS, body + 1); entry++)
        volume += readDoubleField(F_ENTRY_VOLUME, entry) * params.cellSize * params.cellSize * params.cellSize;
    for (int axis = 0; axis < 3; axis++)
        writeDoubleField(F_BODY_RESULTS, BODY_RESULT_STRIDE * body + BODY_RESULT_IMPULSE_X + axis,
                         pressureImpulse[axis] + shearImpulse[axis]);
    writeDoubleField(F_BODY_RESULTS, BODY_RESULT_STRIDE * body + BODY_RESULT_COUPLED_VOLUME, volume);
}
void settleCellExternalWork(int cellIndex) {
    double externalWork =
        headerWord(H_SOURCE_CELL_WORK) < 0 ? 0.0 : readDoubleAt(headerWord(H_SOURCE_CELL_WORK) + 2 * cellIndex);
    externalWork -= params.duration * params.cellSize * params.cellSize * params.cellSize *
                    readDoubleField(F_ROW_BODY_RATE, cellIndex) * physicalRowPressure(pressureRowForCell(cellIndex));
    writeDoubleField(F_SOURCE_WORK, cellIndex, externalWork);
}
void main() {
    int id = int((gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x) * 128 + gl_LocalInvocationID.x);
    if (id >= params.count || errorFlags != 0u)
        return;
    if (params.stage == STAGE_RESET_GEOMETRY) {
        if (id < headerWord(H_CELLS)) {
            writeIntField(F_CELL_COUNTS, id, 0);
            writeIntField(F_CELL_CURSORS, id, 0);
        }
        if (id < headerWord(H_FACES)) {
            writeIntField(F_FACE_COUNTS, id, 0);
            writeIntField(F_FACE_CURSORS, id, 0);
            writeDoubleField(F_FACE_AREA, id, 0.0);
        }
        if (id == 0) {
            writeIntField(F_CONTROL, CONTROL_CONTACT_COUNT, 0);
            writeIntField(F_CONTROL, CONTROL_RESERVED, 0);
        }
        return;
    }
    if (params.stage == STAGE_ENUMERATE_BODY_ENTRIES) {
        enumerateBodyEntry(id);
        return;
    }
    if (params.stage == STAGE_SCATTER_CELL_ENTRIES) {
        int cellIndex = readIntField(F_ENTRY_CELL, id);
        if (cellIndex >= 0) {
            int slot = readIntField(F_CELL_OFFSETS, cellIndex) +
                       int(atomicAdd(arenaWords[fieldWordOffset(F_CELL_CURSORS) + cellIndex], 1u));
            writeIntField(F_CELL_ENTRIES, slot, id);
        }
        return;
    }
    if (params.stage == STAGE_GATHER_CELL_OCCUPATION) {
        gatherCellOccupation(id);
        return;
    }
    if (params.stage == STAGE_COUNT_FACE_CONTACTS) {
        buildEntryFaceContacts(id, false);
        return;
    }
    if (params.stage == STAGE_SCATTER_FACE_CONTACTS) {
        buildEntryFaceContacts(id, true);
        return;
    }
    if (params.stage == STAGE_GATHER_FACE_OCCUPATION) {
        gatherFaceOccupation(id);
        return;
    }
    if (params.stage == STAGE_GATHER_BODY_TOTALS) {
        gatherBodyTotals(id);
        return;
    }
    if (params.stage == STAGE_COMBINE_SOLID_OCCUPATION) {
        writeInt64At(fieldWordOffset(F_COMBINED_SVQ) + 2 * id,
                     (headerWord(H_BASE_SOLID) < 0 ? 0l : readInt64At(headerWord(H_BASE_SOLID) + 2 * id)) +
                         readInt64At(fieldWordOffset(F_OCCUPIED_SVQ) + 2 * id));
        return;
    }
    if (params.stage == STAGE_APPLY_LIQUID_WET_FRACTION) {
        int cellIndex = readIntField(F_ENTRY_CELL, id);
        if (cellIndex >= 0) {
            double fraction =
                cellGeometry(cellIndex, CELL_PORE_VOLUME) > 0.0
                    ? clamp(cellGeometry(cellIndex, CELL_LIQUID_VOLUME) / cellGeometry(cellIndex, CELL_PORE_VOLUME),
                            0.0, 1.0)
                    : 0.0;
            for (int axis = 0; axis < 3; axis++)
                writeDoubleField(F_ENTRY_WET_AREA, BODY_VECTOR_STRIDE * id + axis,
                                 readDoubleField(F_ENTRY_WET_AREA, BODY_VECTOR_STRIDE * id + axis) * fraction);
        }
        return;
    }
    if (params.stage == STAGE_PREPARE_CONTACT_DISTANCES) {
        if (id >= contactCount())
            return;
        int body = readIntField(F_CONTACT_BODY, id), axis = faceAxis(readIntField(F_CONTACT_FACE, id));
        double area = readDoubleField(F_BODY_TOTALS, BODY_TOTAL_STRIDE * body + BODY_TOTAL_WET_AREA_X) +
                      readDoubleField(F_BODY_TOTALS, BODY_TOTAL_STRIDE * body + BODY_TOTAL_WET_AREA_Y) +
                      readDoubleField(F_BODY_TOTALS, BODY_TOTAL_STRIDE * body + BODY_TOTAL_WET_AREA_Z) -
                      readDoubleField(F_BODY_TOTALS, BODY_TOTAL_STRIDE * body + BODY_TOTAL_WET_AREA_X + axis);
        double total = readDoubleField(F_BODY_TOTALS, BODY_TOTAL_STRIDE * body + BODY_TOTAL_CONTACT_VOLUME_X + axis);
        writeDoubleField(F_CONTACT_DISTANCE, id,
                         total > 0.0 ? area / params.cellSize * readDoubleField(F_CONTACT_SHARE, id) / total : 0.0);
        return;
    }
    if (params.stage == STAGE_BUILD_PRESSURE_CONTACTS) {
        buildPressureContacts(id);
        return;
    }
    if (params.stage == STAGE_ASSEMBLE_BODY_VOLUME_RATE) {
        assembleBodyVolumeRate(id);
        return;
    }
    if (params.stage == STAGE_GATHER_BODY_RESULTS) {
        gatherBodyResult(id);
        return;
    }
    if (params.stage == STAGE_SETTLE_CELL_WORK)
        settleCellExternalWork(id);
}
