#version 450
#extension GL_ARB_gpu_shader_fp64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
// HOST_LAYOUT
layout(local_size_x=128) in;
layout(binding=0,std430) buffer Arena { uint words[]; };
layout(binding=1,std430) buffer Errors { uint errors; };
layout(push_constant) uniform Params { int header;int stage;int count;int unused;double cellSize;double duration;double unusedDouble; } p;
#define CONTROL F_CONTROL
#define BOUNDS F_BOUNDS
#define VELOCITIES F_VELOCITIES
#define BODY_OFFSETS F_BODY_OFFSETS
#define ENTRY_CELL F_ENTRY_CELL
#define ENTRY_BODY F_ENTRY_BODY
#define ENTRY_VOLUME F_ENTRY_VOLUME
#define WET_AREA F_ENTRY_WET_AREA
#define CC F_CELL_COUNTS
#define CO F_CELL_OFFSETS
#define CU F_CELL_CURSORS
#define CE F_CELL_ENTRIES
#define OCCUPIED F_OCCUPIED_SVQ
#define COMBINED F_COMBINED_SVQ
#define FC F_FACE_COUNTS
#define FO F_FACE_OFFSETS
#define FU F_FACE_CURSORS
#define CB F_CONTACT_BODY
#define CENTRY F_CONTACT_ENTRY
#define CFACE F_CONTACT_FACE
#define SHARE F_CONTACT_SHARE
#define DISTANCE F_CONTACT_DISTANCE
#define FACE_AREA F_FACE_AREA
#define TOTALS F_BODY_TOTALS
#define PR F_PRESSURE_ROW
#define PC F_PRESSURE_COEFFICIENT
#define RC F_ROW_COUNTS
#define RO F_ROW_OFFSETS
#define RU F_ROW_CURSORS
#define RE F_ROW_ENTRIES
#define RESULT F_BODY_RESULTS
#define WORK F_SOURCE_WORK
#define ENTRY_CONTACTS F_ENTRY_CONTACTS
#define RATE F_ROW_BODY_RATE
#define GAS_WORK F_GAS_EXTERNAL_WORK
int h(int i){return int(words[p.header+i]);}int at(int f){return h(H_FIELDS+f);}int get(int f,int i){return int(words[at(f)+i]);}void put(int f,int i,int x){words[at(f)+i]=uint(x);}
double num(int a){return packDouble2x32(uvec2(words[a],words[a+1]));}void outnum(int a,double x){uvec2 v=unpackDouble2x32(x);words[a]=v.x;words[a+1]=v.y;}
double read(int f,int i){return num(at(f)+2*i);}void write(int f,int i,double x){outnum(at(f)+2*i,x);}
int64_t integer(int a){return int64_t(uint64_t(words[a])|(uint64_t(words[a+1])<<32));}void outint(int a,int64_t x){words[a]=uint(x);words[a+1]=uint(uint64_t(x)>>32);}
ivec3 dims(){return ivec3(h(H_SIZE_X),h(H_SIZE_Y),h(H_SIZE_Z));}bool inside(ivec3 c){return all(greaterThanEqual(c,ivec3(0)))&&all(lessThan(c,dims()));}
int cell(ivec3 c){return inside(c)?(c.z*h(H_SIZE_Y)+c.y)*h(H_SIZE_X)+c.x:-1;}ivec3 coord(int c){return ivec3(c%h(H_SIZE_X),c/h(H_SIZE_X)%h(H_SIZE_Y),c/(h(H_SIZE_X)*h(H_SIZE_Y)));}
int bodies(){return get(CONTROL,0);}int entries(){return get(CONTROL,1);}int contacts(){return get(CONTROL,2);}
bool finite(double x){return !isnan(x)&&!isinf(x);}void invalid(){atomicOr(errors,16777216u);}
dvec3 low(int b){return dvec3(read(BOUNDS,6*b),read(BOUNDS,6*b+1),read(BOUNDS,6*b+2))/p.cellSize;}
dvec3 high(int b){return dvec3(read(BOUNDS,6*b+3),read(BOUNDS,6*b+4),read(BOUNDS,6*b+5))/p.cellSize;}
int nx(){return (h(H_SIZE_X)+1)*h(H_SIZE_Y)*h(H_SIZE_Z);}int ny(){return h(H_SIZE_X)*(h(H_SIZE_Y)+1)*h(H_SIZE_Z);}int faceAxis(int f){return f<nx()?0:f<nx()+ny()?1:2;}
int faceAt(int axis,ivec3 c){ivec3 d=dims();d[axis]++;return (axis==0?0:axis==1?nx():nx()+ny())+(c.z*d.y+c.y)*d.x+c.x;}
ivec2 faceCells(int f){int axis=faceAxis(f),local=f-(axis==0?0:axis==1?nx():nx()+ny());ivec3 d=dims();d[axis]++;
 ivec3 q=ivec3(local%d.x,local/d.x%d.y,local/(d.x*d.y)),a=q;a[axis]--;return ivec2(cell(a),cell(q));}
double liquid(int c,int k){return c<0?0.0:num(h(H_GEOMETRY_CELLS)+2*(4*c+k));}double face(int f,int k){return num(h(H_GEOMETRY_FACES)+2*(4*f+k));}
bool openMicro(ivec3 q){ivec3 c=q/2;if(any(lessThan(q,ivec3(0)))||!inside(c))return false;int bit=(q.x&1)+2*(q.y&1)+4*(q.z&1);return (words[h(H_MASKS)+cell(c)]&(1u<<bit))==0u;}
double openFace(int f){ivec2 adjacent=faceCells(f);if(adjacent.x<0||adjacent.y<0)return 0.0;int axis=faceAxis(f),sum=0;ivec3 c=coord(adjacent.y)*2;
 int a=axis==0?1:0,b=axis==2?1:2;for(int i=0;i<4;i++){ivec3 q=c;q[a]+=i&1;q[b]+=(i>>1)&1;ivec3 left=q;left[axis]--;if(openMicro(q)&&openMicro(left))sum++;}return .25*double(sum);}
void clipped(int body,dvec3 microLow,out dvec3 a,out dvec3 b){a=max(microLow,low(body));b=min(microLow+.5,high(body));}
void enumerate(int entry){
 put(ENTRY_CELL,entry,-1);write(ENTRY_VOLUME,entry,0.0);for(int a=0;a<3;a++)write(WET_AREA,3*entry+a,0.0);for(int k=0;k<6;k++)put(ENTRY_CONTACTS,6*entry+k,-1);if(entry>=entries())return;
 int lower=0,upper=bodies();while(lower<upper){int middle=(lower+upper)/2;if(get(BODY_OFFSETS,middle+1)<=entry)lower=middle+1;else upper=middle;}
 int body=lower;if(body>=bodies()){invalid();return;}ivec3 first=max(ivec3(0),ivec3(floor(low(body)))),last=min(dims(),ivec3(ceil(high(body)))),extent=last-first;
 int ordinal=entry-get(BODY_OFFSETS,body);ivec3 q=first+ivec3(ordinal%extent.x,ordinal/extent.x%extent.y,ordinal/(extent.x*extent.y));int c=cell(q);double volume=0.0;dvec3 wet=dvec3(0.0);
 for(int bit=0;bit<8;bit++)if((words[h(H_MASKS)+c]&(1u<<bit))==0u){dvec3 micro=dvec3(q)+.5*dvec3(bit&1,(bit>>1)&1,(bit>>2)&1),a,b;clipped(body,micro,a,b);dvec3 d=max(dvec3(0.0),b-a);volume+=d.x*d.y*d.z;
  for(int axis=0;axis<3;axis++){int s=axis==0?1:0,t=axis==2?1:2;
   if(d[s]<=0.0||d[t]<=0.0)continue;
   if(low(body)[axis]>=micro[axis]&&low(body)[axis]<micro[axis]+.5)wet[axis]+=d[s]*d[t];
   if(high(body)[axis]>micro[axis]&&high(body)[axis]<=micro[axis]+.5)wet[axis]+=d[s]*d[t];
  }
 }
 if(volume<=0.0)return;put(ENTRY_CELL,entry,c);put(ENTRY_BODY,entry,body);write(ENTRY_VOLUME,entry,volume);
 for(int axis=0;axis<3;axis++)write(WET_AREA,3*entry+axis,wet[axis]*p.cellSize*p.cellSize);
 atomicAdd(words[at(CC)+c],1u);
}
// Exact clipped box union through sorted coordinate slabs. The local lists contain only
// bodies intersecting this cell; coincident boxes share the same coordinate cuts.
double unionMicro(int c,dvec3 micro){
 int begin=get(CO,c),end=get(CO,c+1);double result=0.0,x=micro.x;
 while(x<micro.x+.5){double nextX=micro.x+.5;for(int e=begin;e<end;e++){int b=get(ENTRY_BODY,get(CE,e));dvec3 a,z;clipped(b,micro,a,z);if(any(lessThanEqual(z,a)))continue;
  if(a.x>x)nextX=min(nextX,a.x);if(z.x>x)nextX=min(nextX,z.x);}
  if(nextX<=x)break;double midX=.5*(x+nextX),y=micro.y;
  while(y<micro.y+.5){double nextY=micro.y+.5;for(int e=begin;e<end;e++){int b=get(ENTRY_BODY,get(CE,e));dvec3 a,z;clipped(b,micro,a,z);if(any(lessThanEqual(z,a))||midX<a.x||midX>=z.x)continue;
   if(a.y>y)nextY=min(nextY,a.y);if(z.y>y)nextY=min(nextY,z.y);}
   if(nextY<=y)break;double midY=.5*(y+nextY),covered=micro.z,length=0.0;
   while(covered<micro.z+.5){double first=micro.z+.5,last=covered;
    for(int e=begin;e<end;e++){int b=get(ENTRY_BODY,get(CE,e));dvec3 a,z;clipped(b,micro,a,z);if(any(lessThanEqual(z,a))||midX<a.x||midX>=z.x||midY<a.y||midY>=z.y||z.z<=covered)continue;
     if(a.z<=covered)last=max(last,z.z);else first=min(first,a.z);}
    if(last>covered){length+=last-covered;covered=last;}else if(first>covered)covered=first;else break;
   }
   result+=(nextX-x)*(nextY-y)*length;y=nextY;
  }x=nextX;
 }return result;
}
void gatherCell(int c){
 double sum=0.0;int begin=get(CO,c),end=get(CO,c+1);for(int e=begin;e<end;e++)sum+=read(ENTRY_VOLUME,get(CE,e));double united=sum;
 if(end-begin>1){united=0.0;ivec3 q=coord(c);for(int bit=0;bit<8;bit++)if((words[h(H_MASKS)+c]&(1u<<bit))==0u)united+=unionMicro(c,dvec3(q)+.5*dvec3(bit&1,(bit>>1)&1,(bit>>2)&1));}
 if(!finite(united)||united<0.0||united>1.0+1e-9){invalid();return;}
 if(sum>0.0)for(int e=begin;e<end;e++){int entry=get(CE,e);write(ENTRY_VOLUME,entry,read(ENTRY_VOLUME,entry)*united/sum);for(int axis=0;axis<3;axis++)write(WET_AREA,3*entry+axis,read(WET_AREA,3*entry+axis)*united/sum);}
 int64_t svq=int64_t(floor(united*16777216.0+.5)),base=h(H_BASE_SOLID)<0?0l:integer(h(H_BASE_SOLID)+2*c);outint(at(OCCUPIED)+2*c,svq);outint(at(COMBINED)+2*c,base+svq);
}
void entryFaces(int entry,bool scatter){int c=get(ENTRY_CELL,entry);if(c<0)return;ivec3 q=coord(c);double v=read(ENTRY_VOLUME,entry);
 for(int axis=0;axis<3;axis++){ivec3 next=q;next[axis]++;int a=faceAt(axis,q),b=faceAt(axis,next);double fa=openFace(a),fb=openFace(b),sum=fa+fb;if(sum==0.0)continue;
  for(int side=0;side<2;side++){int f=side==0?a:b;double weight=v*(side==0?fa:fb)/sum;if(weight==0.0)continue;
   if(!scatter)atomicAdd(words[at(FC)+f],1u);
   else{int slot=get(FO,f)+int(atomicAdd(words[at(FU)+f],1u));put(CB,slot,get(ENTRY_BODY,entry));put(CENTRY,slot,entry);put(CFACE,slot,f);write(SHARE,slot,weight);put(ENTRY_CONTACTS,6*entry+2*axis+side,slot);}
  }
 }
}
void gatherFace(int f){double total=0.0;for(int e=get(FO,f);e<get(FO,f+1);e++)total+=read(SHARE,e);write(FACE_AREA,f,min(openFace(f),total));
 if(total>0.0)for(int e=get(FO,f);e<get(FO,f+1);e++)write(SHARE,e,read(SHARE,e)*min(openFace(f),total)/total);
 if(f==0)put(CONTROL,2,get(FO,h(H_FACES)));
}
void bodyTotals(int body){for(int i=0;i<7;i++)write(TOTALS,7*body+i,0.0);if(body>=bodies())return;dvec3 areas=dvec3(0.0),weights=dvec3(0.0);double wetVolume=0.0;
 for(int entry=get(BODY_OFFSETS,body);entry<get(BODY_OFFSETS,body+1);entry++){
  int c=get(ENTRY_CELL,entry);if(c<0)continue;double v=read(ENTRY_VOLUME,entry);ivec3 q=coord(c);if(liquid(c,0)>0.0)wetVolume+=v;
  for(int axis=0;axis<3;axis++){areas[axis]+=read(WET_AREA,3*entry+axis);ivec3 next=q;next[axis]++;if(openFace(faceAt(axis,q))+openFace(faceAt(axis,next))>0.0)weights[axis]+=v;}
 }
 for(int axis=0;axis<3;axis++){write(TOTALS,7*body+axis,areas[axis]);write(TOTALS,7*body+3+axis,weights[axis]);}write(TOTALS,7*body+6,wetVolume);
}
int gh(int i){if(h(H_GAS_PRESSURE)>=0)return int(words[h(H_GAS_PRESSURE)+i]);return i==GAS_H_STARTS?h(H_PRESSURE_STARTS):i==GAS_H_VALUES?h(H_PRESSURE_VALUES):i==GAS_H_ROWS?h(H_PRESSURE_ROW_META):i==GAS_H_PRESSURE?h(H_PRESSURE_VALUES_OUTPUT):i==GAS_H_META?h(H_PRESSURE_META):i==GAS_H_PROBLEM?h(H_PRESSURE_PROBLEM):0;}int ga(int f){return gh(GAS_WORK_FIELDS+f);}int jh(int i){return int(words[h(H_COUPLED_PRESSURE)+i]);}int ja(int f){return jh(COUPLED_WORK_FIELDS+f);}
bool full(int c){return liquid(c,1)>0.0&&liquid(c,2)>0.0&&liquid(c,2)-liquid(c,0)<=4e-5;}
int pressureRow(int c){if(c<0)return -1;if(full(c))return c;if(h(H_GAS_PRESSURE)<0)return -1;int node=int(words[gh(GAS_H_CELL_NODES)+c]);return node>0?h(H_CELLS)+node-1:-1;}
double datum(){return h(H_GAS_PRESSURE)<0?0.0:num(ga(GAS_F_DATUM));}
double rowPressure(int row){return row<0?0.0:(h(H_GAS_PRESSURE)<0?0.0:num(ga(GAS_F_REFERENCE)+2*row))+num(gh(GAS_H_PRESSURE)+2*row)+datum();}
void pressureContacts(int contact){for(int side=0;side<2;side++){put(PR,2*contact+side,-1);write(PC,2*contact+side,0.0);}if(contact>=contacts())return;
 int f=get(CFACE,contact);if(h(H_ACTIVITY_FACES)>=0&&words[h(H_ACTIVITY_FACES)+f]==0u)return;ivec2 c=faceCells(f);if(c.x<0)return;ivec2 r=ivec2(pressureRow(c.x),pressureRow(c.y));if(r.x==r.y)return;
 for(int side=0;side<2;side++){int index=2*contact+side;double coefficient=(side==0?1.0:-1.0)*read(SHARE,contact)/p.cellSize;
  put(PR,index,r[side]);write(PC,index,coefficient);if(r[side]>=0)atomicAdd(words[at(RC)+r[side]],1u);
 }
}
void rowSource(int row){double rate=0.0;for(int e=get(RO,row);e<get(RO,row+1);e++){int term=get(RE,e),contact=term/2,body=get(CB,contact),axis=faceAxis(get(CFACE,contact));rate+=read(PC,term)*read(VELOCITIES,3*body+axis);}
 write(RATE,row,rate);if(rate==0.0)return;
 if(row>=h(H_CELLS)&&row<h(H_CELLS)+gh(GAS_H_GAS_CAPACITY)){int node=row-h(H_CELLS);double pressure=num(gh(GAS_H_THERMODYNAMIC_STATES)+2*(9*node+1));if(pressure<=0.0)return;
  double storage=num(ga(GAS_F_STORAGE)+2*node);if(storage<=0.0){storage=num(gh(GAS_H_NODE_VOLUMES)+2*node)*num(gh(GAS_H_THERMODYNAMIC_STATES)+2*(9*node+8))/(p.duration*p.duration*p.cellSize*p.cellSize*p.cellSize);
   if(!(storage>0.0&&finite(storage))){invalid();return;}outnum(ga(GAS_F_STORAGE)+2*node,storage);words[ga(GAS_F_MECHANICAL_MODE)+node]=1u;
   outnum(ga(GAS_F_DIAGONAL)+2*node,storage);
   if(h(H_COUPLED_PRESSURE)>=0)outnum(ja(COUPLED_F_STORAGE)+2*row,storage);
   else{int diagonal=int(words[gh(GAS_H_STARTS)+row]);outnum(gh(GAS_H_VALUES)+2*diagonal,storage);words[gh(GAS_H_META)+row]=1u;}
  }
 }
 if(h(H_COUPLED_PRESSURE)>=0){outnum(ja(COUPLED_F_ROW_SOURCE)+2*row,num(ja(COUPLED_F_ROW_SOURCE)+2*row)-rate/p.duration);words[ja(COUPLED_F_ROW_ENABLED)+row]=1u;}
 else{outnum(gh(GAS_H_PROBLEM)+2*row,num(gh(GAS_H_PROBLEM)+2*row)-rate/p.duration);words[gh(GAS_H_ROWS)+row]=uint(row);}
}
void bodyResult(int body){for(int k=0;k<8;k++)write(RESULT,8*body+k,0.0);if(body>=bodies())return;
 dvec3 pressureImpulse=dvec3(0.0),shearImpulse=dvec3(0.0);double shearWork=0.0,volume=0.0;
 for(int entry=get(BODY_OFFSETS,body);entry<get(BODY_OFFSETS,body+1);entry++)for(int slot=0;slot<6;slot++){
  int contact=get(ENTRY_CONTACTS,6*entry+slot);if(contact<0)continue;int axis=faceAxis(get(CFACE,contact));double force=0.0;
  for(int side=0;side<2;side++)force+=read(PC,2*contact+side)*rowPressure(get(PR,2*contact+side));pressureImpulse[axis]-=p.duration*p.cellSize*p.cellSize*p.cellSize*force;
  if(h(H_CONTACT_IMPULSE)>=0)shearImpulse[axis]-=num(h(H_CONTACT_IMPULSE)+2*contact);if(h(H_CONTACT_WORK)>=0)shearWork+=num(h(H_CONTACT_WORK)+2*contact);
 }
 for(int entry=get(BODY_OFFSETS,body);entry<get(BODY_OFFSETS,body+1);entry++)volume+=read(ENTRY_VOLUME,entry)*p.cellSize*p.cellSize*p.cellSize;
 dvec3 velocity=dvec3(read(VELOCITIES,3*body),read(VELOCITIES,3*body+1),read(VELOCITIES,3*body+2));
 for(int axis=0;axis<3;axis++)write(RESULT,8*body+axis,pressureImpulse[axis]+shearImpulse[axis]);
 write(RESULT,8*body+3,dot(pressureImpulse,velocity));write(RESULT,8*body+4,shearWork);write(RESULT,8*body+5,volume);
}
void workAtCell(int c){double work=h(H_SOURCE_CELL_WORK)<0?0.0:num(h(H_SOURCE_CELL_WORK)+2*c);
 work-=p.duration*p.cellSize*p.cellSize*p.cellSize*read(RATE,c)*rowPressure(c);write(WORK,c,work);
}
void main(){int id=int((gl_WorkGroupID.y*gl_NumWorkGroups.x+gl_WorkGroupID.x)*128+gl_LocalInvocationID.x);if(id>=p.count||errors!=0u)return;
 if(p.stage==0){if(id<h(H_CELLS)){put(CC,id,0);put(CU,id,0);write(WORK,id,0.0);}if(id<h(H_FACES)){put(FC,id,0);put(FU,id,0);write(FACE_AREA,id,0.0);}if(id==0){put(CONTROL,2,0);put(CONTROL,3,0);}return;}
 if(p.stage==1){enumerate(id);return;}if(p.stage==2){int c=get(ENTRY_CELL,id);if(c>=0){int slot=get(CO,c)+int(atomicAdd(words[at(CU)+c],1u));put(CE,slot,id);}return;}
 if(p.stage==3){gatherCell(id);return;}if(p.stage==4){entryFaces(id,false);return;}if(p.stage==5){entryFaces(id,true);return;}if(p.stage==6){gatherFace(id);return;}
 if(p.stage==7){bodyTotals(id);return;}
 if(p.stage==18){outint(at(COMBINED)+2*id,(h(H_BASE_SOLID)<0?0l:integer(h(H_BASE_SOLID)+2*id))+integer(at(OCCUPIED)+2*id));return;}
 if(p.stage==17){int c=get(ENTRY_CELL,id);if(c>=0){double fraction=liquid(c,2)>0.0?clamp(liquid(c,0)/liquid(c,2),0.0,1.0):0.0;for(int axis=0;axis<3;axis++)write(WET_AREA,3*id+axis,read(WET_AREA,3*id+axis)*fraction);}return;}
 if(p.stage==8){if(id>=contacts())return;int body=get(CB,id),axis=faceAxis(get(CFACE,id));double area=read(TOTALS,7*body)+read(TOTALS,7*body+1)+read(TOTALS,7*body+2)-read(TOTALS,7*body+axis);
  double total=read(TOTALS,7*body+3+axis);write(DISTANCE,id,total>0.0?area/p.cellSize*read(SHARE,id)/total:0.0);return;}
 if(p.stage==9){double area=max(0.0,face(id,2)-read(FACE_AREA,id));outnum(h(H_GEOMETRY_FACES)+2*(4*id+2),area);outnum(h(H_GEOMETRY_FACES)+2*(4*id+3),min(face(id,3),area));return;}
 if(p.stage==10){put(RC,id,0);put(RU,id,0);return;}if(p.stage==11){pressureContacts(id);return;}
 if(p.stage==12){int row=get(PR,id);if(row>=0){int slot=get(RO,row)+int(atomicAdd(words[at(RU)+row],1u));put(RE,slot,id);}return;}
 if(p.stage==13){rowSource(id);return;}if(p.stage==14){bodyResult(id);return;}if(p.stage==15)workAtCell(id);
 if(p.stage==16){write(GAS_WORK,id,0.0);if(id<gh(GAS_H_GAS_CAPACITY)){
  double rate=read(RATE,h(H_CELLS)+id);outnum(ga(GAS_F_NODE_PREDICTED_VOLUME_CHANGE)+2*id,num(ga(GAS_F_NODE_PREDICTED_VOLUME_CHANGE)+2*id)+p.duration*p.cellSize*p.cellSize*p.cellSize*rate);
  write(GAS_WORK,id,-p.duration*p.cellSize*p.cellSize*p.cellSize*rate*rowPressure(h(H_CELLS)+id));
 }}
}
