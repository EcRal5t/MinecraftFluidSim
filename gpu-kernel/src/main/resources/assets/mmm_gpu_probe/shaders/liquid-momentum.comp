#version 450
#extension GL_ARB_gpu_shader_fp64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
layout(local_size_x = 128) in;
layout(binding = 0, std430) readonly buffer Source {
    uint sourceWords[];
};
layout(binding = 1, std430) buffer Candidate {
    uint words[];
};
layout(binding = 2, std430) buffer Errors {
    uint errors;
};
layout(push_constant) uniform Params {
    int header;
    int stage;
    int count;
    int parity;
}
p;
const uint ERROR_INVALID_MOMENTUM = 32u;
const int64_t MAX_LONG = int64_t(0x7fffffffffffffffUL);
// SPATIAL_GRID
// HOST_LAYOUT
int headerWord(int i) {
    return int(words[p.header + i]);
}
int sourceField(int i) {
    return headerWord(SOURCE_FIELDS + i);
}
int targetField(int i) {
    return headerWord(TARGET_FIELDS + i);
}
int64_t getLong(int at) {
    return int64_t(uint64_t(words[at]) | (uint64_t(words[at + 1]) << 32));
}
int64_t sourceLong(int at) {
    return int64_t(uint64_t(sourceWords[at]) | (uint64_t(sourceWords[at + 1]) << 32));
}
void putLong(int at, int64_t v) {
    words[at] = uint(v);
    words[at + 1] = uint(uint64_t(v) >> 32);
}
double getDouble(int at) {
    return packDouble2x32(uvec2(words[at], words[at + 1]));
}
double sourceDouble(int at) {
    return packDouble2x32(uvec2(sourceWords[at], sourceWords[at + 1]));
}
void putDouble(int at, double v) {
    if (isnan(v) || isinf(v))
        atomicOr(errors, ERROR_INVALID_MOMENTUM);
    uvec2 b = unpackDouble2x32(v);
    words[at] = b.x;
    words[at + 1] = b.y;
}
int64_t addPositive(int64_t a, int64_t b) {
    if (b < int64_t(0) || a > MAX_LONG - b) {
        atomicOr(errors, ERROR_INVALID_MOMENTUM);
        return a;
    }
    return a + b;
}
int64_t addSigned(int64_t a, int64_t b) {
    if ((b > int64_t(0) && a > MAX_LONG - b) || (b < int64_t(0) && a < (-MAX_LONG - int64_t(1)) - b)) {
        atomicOr(errors, ERROR_INVALID_MOMENTUM);
        return a;
    }
    return a + b;
}
ivec3 axisUnitVector(int axis) {
    ivec3 direction = ivec3(0);
    direction[axis] = 1;
    return direction;
}
int cellIndex(ivec3 coordinates) {
    return gridCell(coordinates);
}
int faceAxisOffset(int axis) {
    return gridFaceOffset(axis);
}
int faceIndex(ivec3 coordinates, int axis) {
    return gridFaceAt(coordinates,axis);
}
int64_t routeMass(int stock, int slot) {
    uint mask = words[headerWord(H_SOURCE_MASKS) + stock];
    if ((mask & (1u << slot)) == 0u)
        return int64_t(0);
    int routeEntry = int(words[headerWord(H_SOURCE_OFFSETS) + stock]) + bitCount(mask & ((1u << slot) - 1u));
    return getLong(headerWord(H_ROUTE_MASS) + 2 * routeEntry);
}
void decodeFaceCoordinates(int faceId, out int axis, out ivec3 coordinates) {
    axis=gridFaceEndpoints(faceId).z;coordinates=gridFacePosition(faceId);
}
int faceFlags(int faceId) {
    return headerWord(H_ACTIVITY_FACES) >= 0 && words[headerWord(H_ACTIVITY_FACES) + faceId] == 0u
               ? 0
               : (headerWord(H_FLAGS) < 0 ? 1 : int(words[headerWord(H_FLAGS) + faceId]));
}
int64_t cellMassUnits(int cellId, bool target) {
    return cellId < 0 ? int64_t(0) : getLong(headerWord(H_CELL_MASSES) + 4 * cellId + (target ? 2 : 0));
}
int64_t dualMassUnits(int faceId) {
    return getLong(headerWord(H_DUAL_MASS) + 2 * faceId);
}
int64_t primalMassFlux(ivec3 coordinates, int axis) {
    int faceId = faceIndex(coordinates, axis);
    return faceId < 0 ? int64_t(0) : getLong(headerWord(H_PRIMAL_FLUX) + 2 * faceId);
}
// A dual interface sums both primal fluxes before selecting its donor.
int64_t interfaceFlux(ivec3 coordinates, int axis, int component) {
    ivec3 axisDirection = axisUnitVector(axis);
    return addSigned(primalMassFlux(coordinates + axisDirection, axis), primalMassFlux(coordinates + axisDirection - axisUnitVector(component), axis));
}
double projectedVelocity(int faceId) {
    return getDouble(headerWord(H_PROJECTED_FACES) + 8 * faceId + 2);
}
bool openFace(int faceId, ivec3 coordinates, int axis) {
    return getDouble(headerWord(H_TARGET_FACES) + 8 * faceId + 4) > 0;
}
void cellTotals(int cellId) {
    int64_t sourceMass = int64_t(0), targetMass = int64_t(0);
    double volume = 0;
    for (int stock = int(sourceWords[sourceField(STOCK_CELL_OFFSETS) + cellId]); stock < int(sourceWords[sourceField(STOCK_CELL_OFFSETS) + cellId + 1]);
         stock++)
        sourceMass = addPositive(sourceMass, sourceLong(sourceField(STOCK_MASS_UNITS) + 2 * stock));
    for (int stock = int(words[targetField(STOCK_CELL_OFFSETS) + cellId]); stock < int(words[targetField(STOCK_CELL_OFFSETS) + cellId + 1]); stock++) {
        targetMass = addPositive(targetMass, getLong(targetField(STOCK_MASS_UNITS) + 2 * stock));
        volume += getDouble(targetField(STOCK_NUMERIC_VOLUMES) + 2 * stock);
    }
    if(headerWord(H_GAS_OLD_MASS)>=0){
        sourceMass=addPositive(sourceMass,getLong(headerWord(H_GAS_OLD_MASS)+2*cellId));
        targetMass=addPositive(targetMass,getLong(headerWord(H_GAS_NEW_MASS)+2*cellId));
    }
    putLong(headerWord(H_CELL_MASSES) + 4 * cellId, sourceMass);
    putLong(headerWord(H_CELL_MASSES) + 4 * cellId + 2, targetMass);
    putDouble(headerWord(H_CELL_VOLUMES) + 2 * cellId, volume);
}
void faceFlux(int faceId) {
    int axis;
    ivec3 coordinates;
    decodeFaceCoordinates(faceId, axis, coordinates);
    ivec2 endpoints = gridFaceEndpoints(faceId).xy;
    int lowerCell = endpoints.x, upperCell = endpoints.y;
    int64_t forwardMass = int64_t(0), reverseMass = int64_t(0);
    if (lowerCell >= 0 && upperCell >= 0) {
        for (int stock = int(sourceWords[sourceField(STOCK_CELL_OFFSETS) + lowerCell]);
             stock < int(sourceWords[sourceField(STOCK_CELL_OFFSETS) + lowerCell + 1]); stock++)
            forwardMass = addPositive(forwardMass, routeMass(stock, 2 + 2 * axis));
        for (int stock = int(sourceWords[sourceField(STOCK_CELL_OFFSETS) + upperCell]);
             stock < int(sourceWords[sourceField(STOCK_CELL_OFFSETS) + upperCell + 1]); stock++)
            reverseMass = addPositive(reverseMass, routeMass(stock, 1 + 2 * axis));
    }
    int64_t flux=forwardMass-reverseMass;
    if(headerWord(H_GAS_PRIMAL_MASS)>=0)flux=addSigned(flux,getLong(headerWord(H_GAS_PRIMAL_MASS)+2*faceId));
    putLong(headerWord(H_PRIMAL_FLUX) + 2 * faceId, flux);
}
void transport(int faceId) {
    int component;
    ivec3 coordinates;
    decodeFaceCoordinates(faceId, component, coordinates);
    ivec2 endpoints = gridFaceEndpoints(faceId).xy;
    int lowerCell = endpoints.x, upperCell = endpoints.y;
    int64_t sourceMass = addPositive(cellMassUnits(lowerCell, false), cellMassUnits(upperCell, false)), targetMass = addPositive(cellMassUnits(lowerCell, true), cellMassUnits(upperCell, true));
    bool hasAmbient = (lowerCell < 0 || upperCell < 0) && getDouble(headerWord(H_PROJECTED_FACES) + 8 * faceId + 4) > 0.0;
    if (hasAmbient) {
        int64_t ambient = getLong(p.header + H_AMBIENT_MASS);
        sourceMass = addPositive(sourceMass, ambient);
        targetMass = addPositive(targetMass, ambient);
    }
    putLong(headerWord(H_DUAL_MASS) + 2 * faceId, targetMass);
    putDouble(headerWord(H_FACE_HEAT) + 2 * faceId, 0.0);
    if ((faceFlags(faceId) & 1) == 0) {
        putDouble(headerWord(H_TRANSPORTED_MOMENTUM) + 2 * faceId, sourceDouble(sourceField(STOCK_MOMENTUM_X + component) + 2 * (faceId - faceAxisOffset(component))));
        return;
    }
    int64_t outgoingMass = int64_t(0), incomingMass = int64_t(0), externalIncoming = int64_t(0);
    double incomingMomentum = 0;
    int neighborFaces[6];
    int64_t incomingAmounts[6];
    for (int axis = 0; axis < 3; axis++)
        for (int side = 0; side < 2; side++) {
            int neighborSlot = 2 * axis + side;
            ivec3 neighborCoordinates = coordinates + axisUnitVector(axis) * (side == 0 ? -1 : 1);
            neighborFaces[neighborSlot] = faceIndex(neighborCoordinates, component);
            incomingAmounts[neighborSlot] = int64_t(0);
            if (neighborFaces[neighborSlot]<0) {
                int64_t outsideFlux = interfaceFlux(side == 0 ? neighborCoordinates : coordinates, axis, component);
                if (axis == component) outsideFlux = addSigned(outsideFlux, outsideFlux);
                int64_t intoDomain = side == 0 ? outsideFlux : -outsideFlux;
                if (intoDomain > int64_t(0)) {
                    externalIncoming = addPositive(externalIncoming, intoDomain);
                    incomingMass = addPositive(incomingMass, intoDomain);
                } else if (intoDomain < int64_t(0)) outgoingMass = addPositive(outgoingMass, -intoDomain);
                continue;
            }
            int64_t signedFlux = interfaceFlux(side == 0 ? neighborCoordinates : coordinates, axis, component);
            int64_t outflow = side == 0 ? -signedFlux : signedFlux;
            if (outflow > int64_t(0))
                outgoingMass = addPositive(outgoingMass, outflow);
            else if (outflow < int64_t(0)) {
                int64_t incomingAmount = -outflow;
                incomingAmounts[neighborSlot] = incomingAmount;
                incomingMass = addPositive(incomingMass, incomingAmount);
                incomingMomentum += double(incomingAmount) * projectedVelocity(neighborFaces[neighborSlot]);
            }
        }
    // Mix actual incoming momentum with the previous dual mass before removing outgoing mass.
    int64_t available = addPositive(sourceMass, incomingMass);
    if (outgoingMass > available) {
        atomicOr(errors, ERROR_INVALID_MOMENTUM);
        return;
    }
    int64_t remaining = available - outgoingMass;
    if (remaining != targetMass) {
        atomicOr(errors, ERROR_INVALID_MOMENTUM);
        return;
    }
    double retainedFraction = available > int64_t(0) ? double(remaining) / double(available) : 0.0;
    double retainedOld = double(sourceMass) * retainedFraction;
    double retainedAmbient = double(externalIncoming) * retainedFraction;
    double oldVelocity = projectedVelocity(faceId), momentum = retainedOld * oldVelocity + incomingMomentum * retainedFraction;
    double velocity = targetMass > int64_t(0) ? momentum / double(targetMass) : 0, difference = oldVelocity - velocity;
    double heat = 2.5e-11 * (retainedOld * difference * difference + retainedAmbient * velocity * velocity);
    for (int neighborSlot = 0; neighborSlot < 6; neighborSlot++)
        if (incomingAmounts[neighborSlot] > int64_t(0)) {
            difference = projectedVelocity(neighborFaces[neighborSlot]) - velocity;
            heat += 2.5e-11 * double(incomingAmounts[neighborSlot]) * retainedFraction * difference * difference;
        }
    putDouble(headerWord(H_TRANSPORTED_MOMENTUM) + 2 * faceId, momentum * 5e-11);
    putDouble(headerWord(H_FACE_HEAT) + 2 * faceId, heat);
}
void chooseRoot(int faceId) {
    int axis;
    ivec3 coordinates;
    decodeFaceCoordinates(faceId, axis, coordinates);
    ivec2 endpoints = gridFaceEndpoints(faceId).xy;
    int lowerCell = endpoints.x, upperCell = endpoints.y, targetRoot = faceId;
    int64_t largestMass = dualMassUnits(faceId);
    bool moving = (faceFlags(faceId) & 3) == 1 && largestMass > int64_t(0) && openFace(faceId, coordinates, axis);
    bool tiny = lowerCell >= 0 && upperCell >= 0 && getDouble(headerWord(H_CELL_VOLUMES) + 2 * lowerCell) <= 4e-5 &&
                getDouble(headerWord(H_CELL_VOLUMES) + 2 * upperCell) <= 4e-5;
    bool dry = tiny || getDouble(headerWord(H_TARGET_FACES) + 8 * faceId + 6) <= 4e-5;
    if (moving && dry)
        for (int side = 0; side < 2; side++) {
            int cellId = side == 0 ? lowerCell : upperCell;
            if (cellId < 0 || cellMassUnits(cellId, true) <= int64_t(0))
                continue;
            ivec3 neighborCoordinates = coordinates + axisUnitVector(axis) * (side == 0 ? -1 : 1);
            int neighborFace = faceIndex(neighborCoordinates, axis);
            if (neighborFace < 0 || (faceFlags(neighborFace) & 3) != 1 || !openFace(neighborFace, neighborCoordinates, axis))
                continue;
            int64_t neighborMass = dualMassUnits(neighborFace);
            if (neighborMass > largestMass || (neighborMass == largestMass && neighborFace < targetRoot)) {
                targetRoot = neighborFace;
                largestMass = neighborMass;
            }
        }
    words[headerWord(H_ROOTS) + faceId] = uint(targetRoot);
    putDouble(headerWord(H_GROUP_MASS) + 2 * faceId, 0.0);
    putDouble(headerWord(H_GROUP_MOMENTUM) + 2 * faceId, 0.0);
    putDouble(headerWord(H_WALL_IMPULSE) + 2 * faceId, 0.0);
}
void jumpRoot(int faceId) {
    int sourceRoots = headerWord(H_ROOTS + p.parity), targetRoots = headerWord(H_NEXT_ROOTS - p.parity);
    words[targetRoots + faceId] = words[sourceRoots + int(words[sourceRoots + faceId])];
}
void accumulateLine(int line) {
    int axis=gridFaceEndpoints(line).z;ivec3 coordinates=gridFacePosition(line);
    if(faceIndex(coordinates-axisUnitVector(axis),axis)>=0)return;
    int roots=headerWord(H_ROOTS+p.parity);
    for(int faceId=line;faceId>=0;coordinates[axis]++,faceId=faceIndex(coordinates,axis)){
        int rootFace=int(words[roots+faceId]);
        putDouble(headerWord(H_GROUP_MASS)+2*rootFace,getDouble(headerWord(H_GROUP_MASS)+2*rootFace)+5e-11*double(dualMassUnits(faceId)));
        putDouble(headerWord(H_GROUP_MOMENTUM)+2*rootFace,getDouble(headerWord(H_GROUP_MOMENTUM)+2*rootFace)+getDouble(headerWord(H_TRANSPORTED_MOMENTUM)+2*faceId));
    }
}
void finalizeFace(int faceId) {
    int axis;
    ivec3 coordinates;
    decodeFaceCoordinates(faceId, axis, coordinates);
    int momentumAddress = targetField(STOCK_MOMENTUM_X + axis) + 2 * (faceId - faceAxisOffset(axis));
    double momentum = getDouble(headerWord(H_TRANSPORTED_MOMENTUM) + 2 * faceId), heat = getDouble(headerWord(H_FACE_HEAT) + 2 * faceId),
           massKg = 5e-11 * double(dualMassUnits(faceId));
    if ((faceFlags(faceId) & 1) == 0) {
        putDouble(momentumAddress, momentum);
        return;
    }
    int rootFace = int(words[headerWord(H_ROOTS + p.parity) + faceId]);
    double mergedMass = getDouble(headerWord(H_GROUP_MASS) + 2 * rootFace);
    if (massKg > 0 && mergedMass > massKg) {
        double speed = getDouble(headerWord(H_GROUP_MOMENTUM) + 2 * rootFace) / mergedMass, difference = momentum / massKg - speed;
        heat += .5 * massKg * difference * difference;
        momentum = massKg * speed;
    }
    if (!openFace(faceId, coordinates, axis)) {
        if (massKg > 0)
            heat += .5 * momentum * (momentum / massKg);
        putDouble(headerWord(H_WALL_IMPULSE) + 2 * faceId, -momentum);
        momentum = 0;
    }
    putDouble(momentumAddress, momentum);
    putDouble(headerWord(H_FACE_HEAT) + 2 * faceId, heat);
}
void gatherHeat(int cellId) {
    double heat = 0;
    for (int axis = 0; axis < 3; axis++)
        for (int side = 0; side < 2; side++) {
            int faceId = gridFace(cellId, 2*axis+side);
            int64_t dualMass = dualMassUnits(faceId);
            if (dualMass <= int64_t(0))
                continue;
            double faceEnergy = getDouble(headerWord(H_FACE_HEAT) + 2 * faceId);
            int lowerCell = side == 0 ? gridNeighbor(cellId,2*axis) : cellId;
            double lowerShare = faceEnergy * (double(cellMassUnits(lowerCell, true)) / double(dualMass));
            heat += side == 0 && lowerCell < 0
                        ? faceEnergy * (double(cellMassUnits(cellId, true)) / double(dualMass))
                        : side == 0 ? faceEnergy - lowerShare : lowerShare;
        }
    putDouble(headerWord(H_CELL_HEAT) + 2 * cellId, headerWord(H_ACTIVITY_CELLS) >= 0 && words[headerWord(H_ACTIVITY_CELLS) + cellId] == 0u ? 0.0 : heat);
}

void heatTwoSum(double a, double b, out double sum, out double remainder) {
    precise double next = a + b;
    precise double virtualValue = next - a;
    precise double error = (a - (next - virtualValue)) + (b - virtualValue);
    sum = next;
    remainder = error;
}

void clearHeatPosting(int stock) {
    putDouble(headerWord(H_HEAT_POSTING_REMAINDERS) + 4 * stock, 0.0);
    putDouble(headerWord(H_HEAT_POSTING_REMAINDERS) + 4 * stock + 2, 0.0);
}

void postStockHeat(int stock, double share) {
    double before = getDouble(targetField(STOCK_ENERGY_BITS) + 2 * stock), after, error;
    heatTwoSum(before, share, after, error);
    putDouble(targetField(STOCK_ENERGY_BITS) + 2 * stock, after);
    // before + share = after + error: the stored term describes the actual endpoint change.
    putDouble(headerWord(H_HEAT_POSTING_REMAINDERS) + 4 * stock, -error);
}

void postCellHeat(int cellId) {
    int firstStock = int(words[targetField(STOCK_CELL_OFFSETS) + cellId]), stockEnd = int(words[targetField(STOCK_CELL_OFFSETS) + cellId + 1]), remainderStock = -1;
    int64_t largestMass = int64_t(0), totalMass = cellMassUnits(cellId, true);
    double heat = getDouble(headerWord(H_CELL_HEAT) + 2 * cellId);
    for (int i = 0; i < 5; i++)
        putDouble(headerWord(H_HEAT_ALLOCATION_REMAINDERS) + 10 * cellId + 2 * i, 0.0);
    if (headerWord(H_ACTIVITY_CELLS) >= 0 && words[headerWord(H_ACTIVITY_CELLS) + cellId] == 0u)
        return;
    for (int stock = firstStock; stock < stockEnd; stock++) {
        int64_t stockMass = getLong(targetField(STOCK_MASS_UNITS) + 2 * stock);
        if (stockMass > largestMass) {
            largestMass = stockMass;
            remainderStock = stock;
        }
        if (stockMass == int64_t(0)) {
            putDouble(headerWord(H_HEAT_POSTING_REMAINDERS) + 4 * stock, -getDouble(targetField(STOCK_ENERGY_BITS) + 2 * stock));
            putDouble(targetField(STOCK_ENERGY_BITS) + 2 * stock, 0.0);
        }
    }
    int64_t gasMass=headerWord(H_GAS_NEW_MASS)<0?int64_t(0):getLong(headerWord(H_GAS_NEW_MASS)+2*cellId);
    if(gasMass>int64_t(0)){
        double gasShare=remainderStock<0?heat:heat*(double(gasMass)/double(totalMass));
        double after,gasError,liquidHeat,splitError;int gasEnergy=headerWord(H_GAS_ENERGY)+2*cellId;
        heatTwoSum(getDouble(gasEnergy),gasShare,after,gasError);putDouble(gasEnergy,after);
        heatTwoSum(heat,-gasShare,liquidHeat,splitError);heat=liquidHeat;totalMass-=gasMass;
        putDouble(headerWord(H_HEAT_ALLOCATION_REMAINDERS)+10*cellId+6,-gasError);
        putDouble(headerWord(H_HEAT_ALLOCATION_REMAINDERS)+10*cellId+8,-splitError);
    }
    if (remainderStock < 0) {
        if (heat != 0.0)
            atomicOr(errors, ERROR_INVALID_MOMENTUM);
        return;
    }
    precise double ordinary = 0.0, compensated = 0.0, compensation = 0.0;
    for (int stock = firstStock; stock < stockEnd; stock++) {
        int64_t stockMass = getLong(targetField(STOCK_MASS_UNITS) + 2 * stock);
        if (stock == remainderStock || stockMass <= int64_t(0))
            continue;
        precise double share = heat * (double(stockMass) / double(totalMass));
        double next, remainder;
        heatTwoSum(ordinary, share, next, remainder);
        ordinary = next;
        putDouble(headerWord(H_HEAT_POSTING_REMAINDERS) + 4 * stock + 2, remainder);
        precise double corrected = share - compensation;
        precise double nextCompensated = compensated + corrected;
        compensation = (nextCompensated - compensated) - corrected;
        compensated = nextCompensated;
        postStockHeat(stock, share);
    }
    double ownerShare, ownerRemainder, closure, closureRemainder;
    heatTwoSum(heat, -compensated, ownerShare, ownerRemainder);
    heatTwoSum(ordinary, -compensated, closure, closureRemainder);
    postStockHeat(remainderStock, ownerShare);
    // Across arbitrary stock counts, these three terms plus the per-stock terms sum exactly to
    // sum(final U) - sum(previous U) - cellHeat. cellHeat itself remains the mechanical heat ledger.
    putDouble(headerWord(H_HEAT_ALLOCATION_REMAINDERS) + 10 * cellId, closure);
    putDouble(headerWord(H_HEAT_ALLOCATION_REMAINDERS) + 10 * cellId + 2, closureRemainder);
    putDouble(headerWord(H_HEAT_ALLOCATION_REMAINDERS) + 10 * cellId + 4, -ownerRemainder);
}
void main() {
    int id = int(gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * 65535u * 128u);
    if (id >= p.count || errors != 0u)
        return;
    if (p.stage == STAGE_CELL_TOTALS)
        cellTotals(id);
    else if (p.stage == STAGE_FACE_FLUX)
        faceFlux(id);
    else if (p.stage == STAGE_TRANSPORT)
        transport(id);
    else if (p.stage == STAGE_CHOOSE_ROOT)
        chooseRoot(id);
    else if (p.stage == STAGE_JUMP_ROOT)
        jumpRoot(id);
    else if (p.stage == STAGE_ACCUMULATE_LINE)
        accumulateLine(id);
    else if (p.stage == STAGE_FINALIZE_FACE)
        finalizeFace(id);
    else if (p.stage == STAGE_GATHER_HEAT)
        gatherHeat(id);
    else if (p.stage == STAGE_CLEAR_HEAT_POSTING)
        clearHeatPosting(id);
    else
        postCellHeat(id);
}
