#version 450
#extension GL_ARB_gpu_shader_fp64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
layout(local_size_x = 128) in;
layout(binding = 0, std430) buffer Candidate {
    uint words[];
};
layout(binding = 1, std430) buffer Errors {
    uint errors;
};
layout(push_constant) uniform Params {
    int header;
    int count;
    int stage;
}
p;
// HOST_LAYOUT
const double MASS_UNIT_KG = 1e-10;
const int STAGE_STOCK_STATE = 0;

int headerWord(int i) {
    return int(words[p.header + i]);
}
double readDouble(int at) {
    return packDouble2x32(uvec2(words[at], words[at + 1]));
}
int64_t readQuantity(int at) {
    return int64_t(uint64_t(words[at]) | (uint64_t(words[at + 1]) << 32));
}
void writeDouble(int at, double x) {
    if (isnan(x) || isinf(x))
        atomicOr(errors, 16384u);
    uvec2 bits = unpackDouble2x32(x);
    words[at] = bits.x;
    words[at + 1] = bits.y;
}
double ethanolMass(int material,int stock,double mass) {
    if (material != headerWord(CAL_AQUEOUS_MATERIAL) || headerWord(CAL_ETHANOL_SPECIES) < 0) return 0.0;
    for (int item=int(words[headerWord(CAL_SPECIES_OFFSETS)+stock]);item<int(words[headerWord(CAL_SPECIES_OFFSETS)+stock+1]);item++)
        if (int(words[headerWord(CAL_SPECIES_HANDLES)+item])==headerWord(CAL_ETHANOL_SPECIES))
            return caloricEthanolMass(mass,double(readQuantity(headerWord(CAL_SPECIES_AMOUNTS)+2*item)),readDouble(p.header+CAL_ETHANOL_MOLAR_MASS));
    return 0.0;
}
void stockState(int stock) {
    writeDouble(headerWord(CAL_TEMPERATURES) + 2 * stock, 0.0);
    writeDouble(headerWord(CAL_HEAT_CAPACITIES) + 2 * stock, 0.0);
    writeDouble(headerWord(CAL_COLD_ENERGIES) + 2 * stock, 0.0);
    bool live =
        stock < headerWord(CAL_SECONDARY_BEGIN)
            ? stock < int(words[headerWord(CAL_COUNTS)])
            : headerWord(CAL_SECONDARY_COUNTS) >= 0 && stock - headerWord(CAL_SECONDARY_BEGIN) < int(words[headerWord(CAL_SECONDARY_COUNTS)]);
    if (!live)
        return;
    double mass = double(readQuantity(headerWord(CAL_MASSES) + 2 * stock)) * MASS_UNIT_KG;
    if (mass == 0.0)
        return;
    int material = int(words[headerWord(CAL_MATERIALS) + stock]);
    if (mass < 0.0 || material < 0 || material >= headerWord(CAL_MATERIAL_COUNT)) {
        atomicOr(errors, 16384u);
        return;
    }
    double base = mass * readDouble(headerWord(CAL_MATERIAL_REFERENCE) + 2 * material), energy = readDouble(headerWord(CAL_ENERGIES) + 2 * stock);
    for (int item = int(words[headerWord(CAL_SPECIES_OFFSETS) + stock]); item < int(words[headerWord(CAL_SPECIES_OFFSETS) + stock + 1]);
         item++) {
        int species = int(words[headerWord(CAL_SPECIES_HANDLES) + item]);
        if (species < 0 || species >= headerWord(CAL_SPECIES_STRIDE)) {
            atomicOr(errors, 16384u);
            return;
        }
        int64_t amount = readQuantity(headerWord(CAL_SPECIES_AMOUNTS) + 2 * item);
        if (amount != 0l)
            base += double(amount) * readDouble(headerWord(CAL_SPECIES_REFERENCE) + 2 * (material * headerWord(CAL_SPECIES_STRIDE) + species));
    }
    int first = int(words[headerWord(CAL_SEGMENT_OFFSETS) + material]),
        last = int(words[headerWord(CAL_SEGMENT_OFFSETS) + material + 1]) - 1, segment = first;
    if (last < first || isnan(base) || isinf(base)) {
        atomicOr(errors, 16384u);
        return;
    }
    double surfaceIntercept=headerWord(CAL_SURFACE_INTERCEPT)<0?0.0LF:readDouble(headerWord(CAL_SURFACE_INTERCEPT)+2*stock);
    double surfaceCapacity=headerWord(CAL_SURFACE_CAPACITY)<0?0.0LF:readDouble(headerWord(CAL_SURFACE_CAPACITY)+2*stock);
    double referenceTemperature=readDouble(headerWord(CAL_REFERENCE_TEMPERATURE)+2*material);
    base+=surfaceIntercept+surfaceCapacity*referenceTemperature;
    double capacity = 0.0, ethanol = ethanolMass(material,stock,mass);
    double temperature = caloricStateTemperature(p.header,material,mass,ethanol,surfaceCapacity,energy-base,capacity);
    double minimum = readDouble(p.header + CAL_MINIMUM_TEMPERATURE);
    if (temperature < minimum - 1e-7 || capacity <= 0.0) {
        atomicOr(errors, 16384u);
        return;
    }
    writeDouble(headerWord(CAL_TEMPERATURES) + 2 * stock, max(minimum, temperature));
    writeDouble(headerWord(CAL_HEAT_CAPACITIES) + 2 * stock, capacity);
    double waterCold=readDouble(headerWord(CAL_COLD_SENSIBLE)+2*material);
    double ethanolCold=(minimum-readDouble(headerWord(CAL_REFERENCE_TEMPERATURE)+2*material))*readDouble(p.header+CAL_ETHANOL_HEAT_CAPACITY);
    writeDouble(headerWord(CAL_COLD_ENERGIES) + 2 * stock, min(energy, base+(mass-ethanol)*waterCold+ethanol*ethanolCold+surfaceCapacity*(minimum-referenceTemperature)));
}
void cellState(int cell) {
    int begin = int(words[headerWord(CAL_CELL_OFFSETS) + cell]), end = int(words[headerWord(CAL_CELL_OFFSETS) + cell + 1]);
    double remaining = 0.0, temperature = readDouble(p.header + CAL_MINIMUM_TEMPERATURE), capacity = 0.0;
    for (int stock = begin; stock < end; stock++)
        if (readQuantity(headerWord(CAL_MASSES) + 2 * stock) > int64_t(0))
            remaining += readDouble(headerWord(CAL_ENERGIES) + 2 * stock) - readDouble(headerWord(CAL_COLD_ENERGIES) + 2 * stock);
    if (begin == end) {
        writeDouble(headerWord(CAL_CELL_TEMPERATURES) + 2 * cell, 0.0);
        writeDouble(headerWord(CAL_CELL_HEAT_CAPACITIES) + 2 * cell, 0.0);
        return;
    }
    // Each pass crosses one of the actual material knots; terminal segments extend upward.
    for (;;) {
        capacity = 0.0;
        double next = 1.7976931348623157e308;
        for (int stock = begin; stock < end; stock++) {
            double mass = double(readQuantity(headerWord(CAL_MASSES) + 2 * stock)) * MASS_UNIT_KG;
            if (mass <= 0.0)
                continue;
            int material = int(words[headerWord(CAL_MATERIALS) + stock]), first = int(words[headerWord(CAL_SEGMENT_OFFSETS) + material]),
                last = int(words[headerWord(CAL_SEGMENT_OFFSETS) + material + 1]) - 1, segment = first;
            while (segment < last && temperature >= readDouble(headerWord(CAL_SEGMENT_UPPER) + 2 * segment))
                segment++;
            capacity += caloricCapacity(mass,ethanolMass(material,stock,mass),readDouble(headerWord(CAL_SEGMENT_CAPACITY) + 2 * segment),readDouble(p.header+CAL_ETHANOL_HEAT_CAPACITY));
            if (segment < last)
                next = min(next, readDouble(headerWord(CAL_SEGMENT_UPPER) + 2 * segment));
        }
        if (capacity <= 0.0) {
            writeDouble(headerWord(CAL_CELL_TEMPERATURES) + 2 * cell, 0.0);
            writeDouble(headerWord(CAL_CELL_HEAT_CAPACITIES) + 2 * cell, 0.0);
            return;
        }
        double span = (next - temperature) * capacity;
        if (next == 1.7976931348623157e308 || remaining < span) {
            temperature += remaining / capacity;
            break;
        }
        remaining -= span;
        temperature = next;
    }
    writeDouble(headerWord(CAL_CELL_TEMPERATURES) + 2 * cell, temperature);
    writeDouble(headerWord(CAL_CELL_HEAT_CAPACITIES) + 2 * cell, capacity);
}
void main() {
    int item = int((gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x) * 128u + gl_LocalInvocationID.x);
    if (item >= p.count || errors != 0u)
        return;
    if (p.stage == STAGE_STOCK_STATE)
        stockState(item);
    else
        cellState(item);
}
