#version 450
#extension GL_ARB_gpu_shader_fp64 : require

const int STAGE_INITIALIZE = 0;
const int STAGE_COUNT_TERMS = 1;
const int STAGE_SCATTER_TERMS = 2;
const int STAGE_COUNT_BLOCKS = 3;
const int STAGE_MAP_BLOCKS = 4;
const int STAGE_SMALL_VELOCITY_PRODUCT = 5;
const int STAGE_VELOCITY_BLOCK_PRODUCT = 6;
const int STAGE_LARGE_VELOCITY_PRODUCT = 7;
const int STAGE_SMALL_ROW_PRODUCT = 8;
const int STAGE_ROW_BLOCK_PRODUCT = 9;
const int STAGE_LARGE_ROW_PRODUCT = 10;
const int STAGE_MARK_INDUCED_VELOCITY = 11;
const int STAGE_MARK_PRODUCT_ROWS = 12;
const int STAGE_MARK_PRODUCT_VELOCITIES = 13;
const int STAGE_PRODUCT_DISPATCH = 14;
const int STAGE_SPARSE_VELOCITY_PRODUCT = 15;
const int STAGE_SPARSE_ROW_PRODUCT = 16;
const uint ERROR_COUPLED_PRESSURE = 262144u;
const int MODE_PRESSURE = 0;
const int MODE_SEARCH_DIRECTION = 1;
const int MODE_PREPARE = 2;
const int MODE_PROJECT = 3;
const int MODE_DIVERGENCE = 4;
const int CONTROL_RUN = 3;
const int CONTROL_REFRESH = 7;
layout(local_size_x = 128) in;
layout(binding = 0, std430) buffer Arena {
    uint words[];
};
layout(binding = 1, std430) buffer Errors {
    uint errors;
};
layout(push_constant) uniform Params {
    int header;
    int stage;
    int count;
    int argument;
    double duration;
}
p;
// HOST_LAYOUT
shared dvec2 parts[128];
int headerValue(int i) {
    return int(words[p.header + i]);
}
int fieldOffset(int f) {
    return headerValue(WORK_FIELDS + f);
}
int readIntField(int f, int i) {
    return int(words[fieldOffset(f) + i]);
}
void writeIntField(int f, int i, int v) {
    words[fieldOffset(f) + i] = uint(v);
}
double readDoubleWord(int address) {
    return packDouble2x32(uvec2(words[address], words[address + 1]));
}
void writeNumber(int address, double value) {
    uvec2 bits = unpackDouble2x32(value);
    words[address] = bits.x;
    words[address + 1] = bits.y;
}
double readDoubleField(int f, int i) {
    return readDoubleWord(fieldOffset(f) + 2 * i);
}
void writeDoubleField(int f, int i, double value) {
    writeNumber(fieldOffset(f) + 2 * i, value);
}
bool finite(double x) {
    return !isnan(x) && !isinf(x);
}
void invalid() {
    atomicOr(errors, ERROR_COUPLED_PRESSURE);
}
bool termValid(int e) {
    int row = readIntField(FIELD_TERM_ROW, e);
    return row >= 0 && row < headerValue(H_ROW_COUNT) && readIntField(FIELD_ROW_ENABLED, row) != 0 &&
           readDoubleField(FIELD_TERM_COEFFICIENT, e) != 0.0;
}
bool velocityPhase() {
    return p.stage >= STAGE_SMALL_VELOCITY_PRODUCT && p.stage <= STAGE_LARGE_VELOCITY_PRODUCT
        || p.stage == STAGE_SPARSE_VELOCITY_PRODUCT;
}
bool selected(int owner) {
    return velocityPhase() ? owner >= headerValue(H_ROW_COUNT) : owner < headerValue(H_ROW_COUNT);
}
double pressureVector(int row) {
    if (p.argument == MODE_PREPARE)
        return readDoubleField(FIELD_REFERENCE, row);
    double value = p.argument == MODE_SEARCH_DIRECTION ? readDoubleWord(headerValue(H_WORK) + 2 * (headerValue(H_ROW_COUNT) + row)) : readDoubleWord(headerValue(H_PRESSURE) + 2 * row);
    return p.argument == MODE_PROJECT ? value + readDoubleField(FIELD_REFERENCE, row) : value;
}
void reduce(int lane) {
    for (int step = 64; step > 0; step >>= 1) {
        barrier();
        if (lane < step)
            parts[lane] += parts[lane + step];
    }
    barrier();
}
void dispatchCount(int first, int groups) {
    writeIntField(FIELD_DISPATCH, first, min(groups, 65535));
    writeIntField(FIELD_DISPATCH, first + 1, (groups + 65534) / 65535);
    writeIntField(FIELD_DISPATCH, first + 2, 1);
}
void initialize(int id) {
    writeIntField(FIELD_COUNTS, id, 0);
    writeIntField(FIELD_CURSORS, id, 0);
    if (id == 0) {
        words[p.header + H_LARGE_COUNT] = 0u;
        writeIntField(FIELD_PRODUCT_COUNTS, 0, 0);
        writeIntField(FIELD_PRODUCT_COUNTS, 1, 0);
    }
}
void countTerm(int term) {
    int row = readIntField(FIELD_TERM_ROW, term), velocity = readIntField(FIELD_TERM_VELOCITY, term);
    if (row == -1)
        return;
    if (row < 0 || row >= headerValue(H_ROW_COUNT) || velocity < 0 || velocity >= headerValue(H_VELOCITY_COUNT) ||
        !finite(readDoubleField(FIELD_TERM_COEFFICIENT, term))) {
        invalid();
        return;
    }
    if (!termValid(term))
        return;
    atomicAdd(words[fieldOffset(FIELD_COUNTS) + row], 1u);
    atomicAdd(words[fieldOffset(FIELD_COUNTS) + headerValue(H_ROW_COUNT) + velocity], 1u);
}
void scatter(int term) {
    if (!termValid(term))
        return;
    int row = readIntField(FIELD_TERM_ROW, term), velocity = readIntField(FIELD_TERM_VELOCITY, term);
    if (velocity < 0 || velocity >= headerValue(H_VELOCITY_COUNT))
        return;
    int rowSlot = int(atomicAdd(words[fieldOffset(FIELD_CURSORS) + row], 1u)),
        velocitySlot = int(atomicAdd(words[fieldOffset(FIELD_CURSORS) + headerValue(H_ROW_COUNT) + velocity], 1u));
    writeIntField(FIELD_ENTRIES, readIntField(FIELD_OFFSETS, row) + rowSlot, term);
    writeIntField(FIELD_ENTRIES, readIntField(FIELD_OFFSETS, headerValue(H_ROW_COUNT) + velocity) + velocitySlot, term);
}
void countBlocks(int id) {
    int count = readIntField(FIELD_COUNTS, id);
    writeIntField(FIELD_BLOCK_COUNTS, id, count > 128 ? (count + 127) / 128 : 0);
    if (count > 128) {
        int slot = int(atomicAdd(words[p.header + H_LARGE_COUNT], 1u));
        writeIntField(FIELD_LARGE_IDS, slot, id);
    }
}
void mapBlocks(int id) {
    if (id == 0) {
        dispatchCount(0, readIntField(FIELD_BLOCK_OFFSETS, headerValue(H_OWNER_COUNT)));
        dispatchCount(3, headerValue(H_LARGE_COUNT));
    }
    for (int b = readIntField(FIELD_BLOCK_OFFSETS, id); b < readIntField(FIELD_BLOCK_OFFSETS, id + 1); b++)
        writeIntField(FIELD_BLOCK_OWNER, b, id);
}
dvec2 termValue(int term, int owner) {
    double coefficient = readDoubleField(FIELD_TERM_COEFFICIENT, term);
    int row = readIntField(FIELD_TERM_ROW, term), velocity = readIntField(FIELD_TERM_VELOCITY, term);
    if (owner >= headerValue(H_ROW_COUNT))
        return dvec2(coefficient * pressureVector(row), 0.0);
    return dvec2(coefficient * readDoubleField(p.argument == MODE_DIVERGENCE ? FIELD_PROJECTED_VELOCITY : FIELD_RESPONSE, velocity),
                 p.argument == MODE_PREPARE ? coefficient * coefficient * readDoubleField(FIELD_INVERSE_MASS, velocity) : 0.0);
}
void finishOwner(int owner, dvec2 sum) {
    if (owner >= headerValue(H_ROW_COUNT)) {
        int velocityIndex = owner - headerValue(H_ROW_COUNT);
        double inverse = readDoubleField(FIELD_INVERSE_MASS, velocityIndex), force = sum.x;
        if (p.argument >= MODE_PREPARE)
            force += readDoubleField(FIELD_FIXED_REFERENCE_FORCE, velocityIndex);
        double response = inverse * force;
        if (p.argument == MODE_PREPARE)
            response += readDoubleField(FIELD_PREDICTED_VELOCITY, velocityIndex) / p.duration;
        if (p.argument == MODE_PROJECT) {
            double projectedVelocity = readDoubleField(FIELD_PREDICTED_VELOCITY, velocityIndex) + p.duration * response;
            if (!finite(projectedVelocity))
                invalid();
            writeDoubleField(FIELD_PROJECTED_VELOCITY, velocityIndex, projectedVelocity);
        } else
            writeDoubleField(FIELD_RESPONSE, velocityIndex, response);
        if (!(finite(inverse) && inverse >= 0.0 && finite(response)))
            invalid();
        return;
    }
    int row = owner;
    if (p.argument == MODE_DIVERGENCE) {
        writeDoubleField(FIELD_ROW_DIVERGENCE, row, sum.x);
        return;
    }
    if (p.argument == MODE_PREPARE) {
        double storage = readDoubleField(FIELD_STORAGE, row), diagonal = sum.y + storage, rightHandSide = readDoubleField(FIELD_ROW_SOURCE, row) - sum.x;
        bool enabled = readIntField(FIELD_ROW_ENABLED, row) != 0 && diagonal > 0.0;
        if (!(finite(storage) && storage >= 0.0 && finite(diagonal) && finite(rightHandSide)) ||
            (readIntField(FIELD_ROW_ENABLED, row) != 0 && diagonal == 0.0 && rightHandSide != 0.0))
            invalid();
        int entry = int(words[headerValue(H_STARTS) + row]);
        if (int(words[headerValue(H_COLUMNS) + entry]) != row) {
            invalid();
            return;
        }
        writeNumber(headerValue(H_VALUES) + 2 * entry, enabled ? diagonal : 1.0);
        words[headerValue(H_ROWS) + row] = enabled ? uint(row) : uint(-1);
        writeNumber(headerValue(H_PROBLEM) + 2 * row, enabled ? rightHandSide : 0.0);
    } else
        writeNumber(headerValue(H_WORK) + 2 * (2 * headerValue(H_ROW_COUNT) + row), sum.x + readDoubleField(FIELD_STORAGE, row) * pressureVector(row));
}
void shortOwnerProduct(int owner) {
    if (!selected(owner) || readIntField(FIELD_COUNTS, owner) > 128)
        return;
    dvec2 sum = dvec2(0.0);
    for (int i = readIntField(FIELD_OFFSETS, owner); i < readIntField(FIELD_OFFSETS, owner + 1); i++)
        sum += termValue(readIntField(FIELD_ENTRIES, i), owner);
    finishOwner(owner, sum);
}
void blockProduct(int block, int lane) {
    if (block >= readIntField(FIELD_BLOCK_OFFSETS, headerValue(H_OWNER_COUNT)))
        return;
    int owner = readIntField(FIELD_BLOCK_OWNER, block);
    if (!selected(owner))
        return;
    int index = readIntField(FIELD_OFFSETS, owner) + 128 * (block - readIntField(FIELD_BLOCK_OFFSETS, owner)) + lane;
    parts[lane] = index < readIntField(FIELD_OFFSETS, owner + 1) ? termValue(readIntField(FIELD_ENTRIES, index), owner) : dvec2(0.0);
    reduce(lane);
    if (lane == 0) {
        writeDoubleField(FIELD_PARTIALS, 2 * block, parts[0].x);
        writeDoubleField(FIELD_PARTIALS, 2 * block + 1, parts[0].y);
    }
}
void largeProduct(int index, int lane) {
    if (index >= headerValue(H_LARGE_COUNT))
        return;
    int owner = readIntField(FIELD_LARGE_IDS, index);
    if (!selected(owner))
        return;
    dvec2 sum = dvec2(0.0);
    for (int b = readIntField(FIELD_BLOCK_OFFSETS, owner) + lane; b < readIntField(FIELD_BLOCK_OFFSETS, owner + 1); b += 128)
        sum += dvec2(readDoubleField(FIELD_PARTIALS, 2 * b), readDoubleField(FIELD_PARTIALS, 2 * b + 1));
    parts[lane] = sum;
    reduce(lane);
    if (lane == 0)
        finishOwner(owner, parts[0]);
}
// A particle velocity or drag row couples every incident fluid row. The first pass
// marks those velocities; the second marks their rows; the third closes the set of
// velocities required to evaluate each marked row against the complete vector.
void markInducedVelocity(int velocity){
    int rows=headerValue(H_ROW_COUNT),liquid=headerValue(H_LIQUID_COUNT);
    int faces=headerValue(H_FACE_COUNT),owner=rows+velocity;
    bool induced=false;
    for(int i=readIntField(FIELD_OFFSETS,owner);i<readIntField(FIELD_OFFSETS,owner+1);i++){
        int term=readIntField(FIELD_ENTRIES,i),row=readIntField(FIELD_TERM_ROW,term);
        if(velocity>=faces||row>=liquid){induced=true;break;}
    }
    writeIntField(FIELD_INDUCED_VELOCITY,velocity,induced?1:0);
}
void markProductRow(int row){
    if(int(words[headerValue(H_ROWS)+row])<0)return;
    bool affected=false;
    for(int i=readIntField(FIELD_OFFSETS,row);i<readIntField(FIELD_OFFSETS,row+1);i++){
        int term=readIntField(FIELD_ENTRIES,i),velocity=readIntField(FIELD_TERM_VELOCITY,term);
        if(readIntField(FIELD_INDUCED_VELOCITY,velocity)!=0){affected=true;break;}
    }
    if(affected){
        words[headerValue(H_ROWS)+row]=uint(-row-2);
        uint slot=atomicAdd(words[fieldOffset(FIELD_PRODUCT_COUNTS)],1u);
        writeIntField(FIELD_PRODUCT_ROWS,int(slot),row);
    }
}
void markProductVelocity(int velocity){
    int owner=headerValue(H_ROW_COUNT)+velocity;bool needed=false;
    for(int i=readIntField(FIELD_OFFSETS,owner);i<readIntField(FIELD_OFFSETS,owner+1);i++){
        int term=readIntField(FIELD_ENTRIES,i),row=readIntField(FIELD_TERM_ROW,term);
        if(int(words[headerValue(H_ROWS)+row]) < -1){needed=true;break;}
    }
    if(needed){
        uint slot=atomicAdd(words[fieldOffset(FIELD_PRODUCT_COUNTS)+1],1u);
        writeIntField(FIELD_PRODUCT_VELOCITIES,int(slot),velocity);
    }
}
void productDispatch(){
    bool enabled=readDoubleWord(headerValue(H_CONTROL)+2*(p.argument==MODE_PRESSURE?CONTROL_REFRESH:CONTROL_RUN))!=0.0;
    for(int kind=0;kind<2;kind++){
        int count=enabled?readIntField(FIELD_PRODUCT_COUNTS,kind==0?1:0):0,at=fieldOffset(FIELD_PRODUCT_DISPATCH)+3*kind;
        words[at]=uint(min(count,65535));words[at+1]=uint(max(1,(count+65534)/65535));words[at+2]=1u;
    }
}
void sparseProduct(int index,int lane){
    bool velocities=p.stage==STAGE_SPARSE_VELOCITY_PRODUCT;
    int count=readIntField(FIELD_PRODUCT_COUNTS,velocities?1:0);
    if(index>=count)return;
    int owner=velocities?headerValue(H_ROW_COUNT)+readIntField(FIELD_PRODUCT_VELOCITIES,index)
                        :readIntField(FIELD_PRODUCT_ROWS,index);
    dvec2 sum=dvec2(0.0);
    for(int i=readIntField(FIELD_OFFSETS,owner)+lane;i<readIntField(FIELD_OFFSETS,owner+1);i+=128)
        sum+=termValue(readIntField(FIELD_ENTRIES,i),owner);
    parts[lane]=sum;reduce(lane);
    if(lane==0)finishOwner(owner,parts[0]);
}
void main() {
    int block = int(gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x), lane = int(gl_LocalInvocationID.x),
        id = 128 * block + lane;
    bool productStage=(p.stage>=STAGE_SMALL_VELOCITY_PRODUCT && p.stage<=STAGE_LARGE_ROW_PRODUCT)
        ||p.stage==STAGE_SPARSE_VELOCITY_PRODUCT||p.stage==STAGE_SPARSE_ROW_PRODUCT;
    if (productStage && p.argument < MODE_PREPARE && readDoubleWord(headerValue(H_CONTROL) + 2 * (p.argument == MODE_PRESSURE ? CONTROL_REFRESH : CONTROL_RUN)) == 0.0)
        return;
    if(p.stage==STAGE_SPARSE_VELOCITY_PRODUCT||p.stage==STAGE_SPARSE_ROW_PRODUCT){sparseProduct(block,lane);return;}
    if (p.stage == STAGE_VELOCITY_BLOCK_PRODUCT || p.stage == STAGE_ROW_BLOCK_PRODUCT) {
        blockProduct(block, lane);
        return;
    }
    if (p.stage == STAGE_LARGE_VELOCITY_PRODUCT || p.stage == STAGE_LARGE_ROW_PRODUCT) {
        largeProduct(block, lane);
        return;
    }
    if (id >= p.count)
        return;
    if (p.stage == STAGE_INITIALIZE)
        initialize(id);
    else if (p.stage == STAGE_COUNT_TERMS)
        countTerm(id);
    else if (p.stage == STAGE_SCATTER_TERMS)
        scatter(id);
    else if (p.stage == STAGE_COUNT_BLOCKS)
        countBlocks(id);
    else if (p.stage == STAGE_MAP_BLOCKS)
        mapBlocks(id);
    else if (p.stage == STAGE_MARK_INDUCED_VELOCITY)
        markInducedVelocity(id);
    else if (p.stage == STAGE_MARK_PRODUCT_ROWS)
        markProductRow(id);
    else if (p.stage == STAGE_MARK_PRODUCT_VELOCITIES)
        markProductVelocity(id);
    else if (p.stage == STAGE_PRODUCT_DISPATCH && id==0)
        productDispatch();
    else if (p.stage == STAGE_SMALL_VELOCITY_PRODUCT || p.stage == STAGE_SMALL_ROW_PRODUCT)
        shortOwnerProduct(id);
}
