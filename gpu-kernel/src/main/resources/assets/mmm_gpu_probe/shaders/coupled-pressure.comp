#version 450
#extension GL_ARB_gpu_shader_fp64 : require
layout(local_size_x=128) in;
layout(binding=0,std430) buffer Arena { uint words[]; };
layout(binding=1,std430) buffer Errors { uint errors; };
layout(push_constant) uniform Params { int header; int stage; int count; int argument; double duration; } p;
const int TR=0,TV=1,TC=2,IM=3,PRED=4,FIXED=5,REFERENCE=6,STORAGE=7,SOURCE=8,ENABLED=9,
 COUNTS=10,OFFSETS=11,CURSOR=12,ENTRIES=13,BC=14,BO=15,OWNER=16,LARGE=17,PARTIAL=18,RESPONSE=19,PROJECTED=20,DISPATCH=22,DIVERGENCE=23;
shared dvec2 parts[128];
int h(int i){return int(words[p.header+i]);}int at(int f){return h(24+f);}
int get(int f,int i){return int(words[at(f)+i]);}void put(int f,int i,int v){words[at(f)+i]=uint(v);}
double number(int address){return packDouble2x32(uvec2(words[address],words[address+1]));}
void writeNumber(int address,double value){uvec2 bits=unpackDouble2x32(value);words[address]=bits.x;words[address+1]=bits.y;}
double read(int f,int i){return number(at(f)+2*i);}void write(int f,int i,double value){writeNumber(at(f)+2*i,value);}
bool finite(double x){return !isnan(x)&&!isinf(x);}void invalid(){atomicOr(errors,262144u);}
bool termValid(int e){int row=get(TR,e);return row>=0&&row<h(0)&&get(ENABLED,row)!=0&&read(TC,e)!=0.0;}
bool velocityPhase(){return p.stage>=5&&p.stage<=7;}
bool selected(int owner){return velocityPhase()?owner>=h(0):owner<h(0);}
double vector(int row){
 if(p.argument==2)return read(REFERENCE,row);
 double value=p.argument==1?number(h(13)+2*(h(0)+row)):number(h(12)+2*row);
 return p.argument==3?value+read(REFERENCE,row):value;
}
void reduce(int lane){for(int step=64;step>0;step>>=1){barrier();if(lane<step)parts[lane]+=parts[lane+step];}barrier();}
void dispatchCount(int first,int groups){put(DISPATCH,first,min(groups,65535));put(DISPATCH,first+1,(groups+65534)/65535);put(DISPATCH,first+2,1);}
void initialize(int id){put(COUNTS,id,0);put(CURSOR,id,0);if(id==0)words[p.header+6]=0u;}
void countTerm(int e){
 int row=get(TR,e),v=get(TV,e);if(row==-1)return;
 if(row<0||row>=h(0)||v<0||v>=h(1)||!finite(read(TC,e))){invalid();return;}
 if(!termValid(e))return;atomicAdd(words[at(COUNTS)+row],1u);atomicAdd(words[at(COUNTS)+h(0)+v],1u);
}
void scatter(int e){if(!termValid(e))return;int row=get(TR,e),v=get(TV,e);if(v<0||v>=h(1))return;
 int a=int(atomicAdd(words[at(CURSOR)+row],1u)),b=int(atomicAdd(words[at(CURSOR)+h(0)+v],1u));
 put(ENTRIES,get(OFFSETS,row)+a,e);put(ENTRIES,get(OFFSETS,h(0)+v)+b,e);
}
void countBlocks(int id){int count=get(COUNTS,id);put(BC,id,count>128?(count+127)/128:0);
 if(count>128){int slot=int(atomicAdd(words[p.header+6],1u));put(LARGE,slot,id);}}
void mapBlocks(int id){if(id==0){dispatchCount(0,get(BO,h(3)));dispatchCount(3,h(6));}
 for(int b=get(BO,id);b<get(BO,id+1);b++)put(OWNER,b,id);}
dvec2 termValue(int e,int owner){
 double c=read(TC,e);int row=get(TR,e),v=get(TV,e);
 if(owner>=h(0))return dvec2(c*vector(row),0.0);
 return dvec2(c*read(p.argument==4?PROJECTED:RESPONSE,v),p.argument==2?c*c*read(IM,v):0.0);
}
void finishOwner(int owner,dvec2 sum){
 if(owner>=h(0)){
  int v=owner-h(0);double inverse=read(IM,v),force=sum.x;
  if(p.argument>=2)force+=read(FIXED,v);
  double response=inverse*force;
  if(p.argument==2)response+=read(PRED,v)/p.duration;
  if(p.argument==3){double velocity=read(PRED,v)+p.duration*response;if(!finite(velocity))invalid();write(PROJECTED,v,velocity);}
  else write(RESPONSE,v,response);
  if(!(finite(inverse)&&inverse>=0.0&&finite(response)))invalid();
  return;
 }
 int row=owner;
 if(p.argument==4){write(DIVERGENCE,row,sum.x);return;}
 if(p.argument==2){
  double storage=read(STORAGE,row),diag=sum.y+storage,rhs=read(SOURCE,row)-sum.x;
  bool enabled=get(ENABLED,row)!=0&&diag>0.0;
  if(!(finite(storage)&&storage>=0.0&&finite(diag)&&finite(rhs))||(get(ENABLED,row)!=0&&diag==0.0&&rhs!=0.0))invalid();
  int entry=int(words[h(8)+row]);if(int(words[h(9)+entry])!=row){invalid();return;}
  writeNumber(h(10)+2*entry,enabled?diag:1.0);words[h(11)+row]=enabled?uint(row):uint(-1);
  writeNumber(h(15)+2*row,enabled?rhs:0.0);
 }else writeNumber(h(13)+2*(2*h(0)+row),sum.x+read(STORAGE,row)*vector(row));
}
void small(int owner){if(!selected(owner)||get(COUNTS,owner)>128)return;dvec2 sum=dvec2(0.0);
 for(int i=get(OFFSETS,owner);i<get(OFFSETS,owner+1);i++)sum+=termValue(get(ENTRIES,i),owner);finishOwner(owner,sum);}
void blockProduct(int block,int lane){
 if(block>=get(BO,h(3)))return;int owner=get(OWNER,block);if(!selected(owner))return;
 int index=get(OFFSETS,owner)+128*(block-get(BO,owner))+lane;
 parts[lane]=index<get(OFFSETS,owner+1)?termValue(get(ENTRIES,index),owner):dvec2(0.0);reduce(lane);
 if(lane==0){write(PARTIAL,2*block,parts[0].x);write(PARTIAL,2*block+1,parts[0].y);}
}
void largeProduct(int index,int lane){if(index>=h(6))return;int owner=get(LARGE,index);if(!selected(owner))return;
 dvec2 sum=dvec2(0.0);for(int b=get(BO,owner)+lane;b<get(BO,owner+1);b+=128)sum+=dvec2(read(PARTIAL,2*b),read(PARTIAL,2*b+1));
 parts[lane]=sum;reduce(lane);if(lane==0)finishOwner(owner,parts[0]);}
void main(){
 int block=int(gl_WorkGroupID.y*gl_NumWorkGroups.x+gl_WorkGroupID.x),lane=int(gl_LocalInvocationID.x),id=128*block+lane;
 if(p.stage>=5&&p.argument<2&&number(h(16)+2*(p.argument==0?7:3))==0.0)return;
 if(p.stage==6||p.stage==9){blockProduct(block,lane);return;}
 if(p.stage==7||p.stage==10){largeProduct(block,lane);return;}
 if(id>=p.count)return;
 if(p.stage==0)initialize(id);else if(p.stage==1)countTerm(id);else if(p.stage==2)scatter(id);
 else if(p.stage==3)countBlocks(id);else if(p.stage==4)mapBlocks(id);else if(p.stage==5||p.stage==8)small(id);
}
