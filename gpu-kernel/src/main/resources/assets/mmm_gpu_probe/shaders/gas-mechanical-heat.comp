#version 450
#extension GL_ARB_gpu_shader_fp64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
layout(local_size_x=128) in;
layout(binding=0,std430) buffer Candidate { uint words[]; };
layout(binding=1,std430) buffer Errors { uint errors; };
layout(push_constant) uniform Params { int header;int workHeader;int count;int stage; } p;
const int COUNTS=0,ROW_OFFSETS=3,COMPONENTS=4,NANOS=5,MASS=6,SPECIES_OFFSETS=8,SPECIES_HANDLES=9,SPECIES_AMOUNTS=10,ENERGY_PRESENT=11,ENERGY=12;
int h(int i){return int(words[p.header+i]);}int gas(int f){return h(16+f);}int wh(int i){return int(words[p.workHeader+i]);}
double number(int a){return packDouble2x32(uvec2(words[a],words[a+1]));}void putNumber(int a,double x){uvec2 bits=unpackDouble2x32(x);words[a]=bits.x;words[a+1]=bits.y;}
int64_t integer(int a){return int64_t(uint64_t(words[a])|(uint64_t(words[a+1])<<32));}bool finite(double x){return !isnan(x)&&!isinf(x);}void invalid(){atomicOr(errors,65536u);}
void addCompensated(inout double sum,inout double correction,double x){precise double y=x-correction,next=sum+y;correction=(next-sum)-y;sum=next;}
// GAS_CALORIC_FUNCTIONS
double minimumEnergy(int first,int last,double anchor){double t=number(p.header+32),minimum=number(p.header+34),energy=anchor,error=0.0;
 while(t>minimum){double boundary;double capacity=capacityAndBoundary(first,last,t,false,boundary),next=max(minimum,boundary);addCompensated(energy,error,capacity*(next-t));t=next;}return energy;}
void main(){int node=int((gl_WorkGroupID.y*gl_NumWorkGroups.x+gl_WorkGroupID.x)*128+gl_LocalInvocationID.x);if(node>=p.count||errors!=0u)return;
 if(p.stage==0){putNumber(wh(2)+2*node,0.0);putNumber(wh(3)+2*node,0.0);putNumber(wh(4)+4*node,0.0);putNumber(wh(4)+4*node+2,0.0);}
 if(node>=int(words[gas(COUNTS)]))return;int first,last;double anchor,mass,r;if(!inventory(node,first,last,anchor,mass,r)||first==last)return;
 if(p.stage==0){double boundary,temperature=number(wh(1)+2*node),capacity=capacityAndBoundary(first,last,temperature,true,boundary),cold=minimumEnergy(first,last,anchor);
  if(!(finite(capacity)&&capacity>0.0&&finite(cold)&&finite(temperature)&&temperature>=number(p.header+34))){invalid();return;}
  putNumber(wh(2)+2*node,capacity);putNumber(wh(3)+2*node,cold);return;}
 double energy=number(wh(0)+2*node),temperature=number(p.header+32),residual=energy-anchor;if(!finite(residual)){invalid();return;}
 bool heating=residual>=0.0;double remaining=abs(residual);
 for(;;){double boundary,capacity=capacityAndBoundary(first,last,temperature,heating,boundary);if(!(finite(capacity)&&capacity>0.0)){invalid();return;}
  double span=heating?boundary-temperature:temperature-boundary,step=remaining/capacity;if(step<=span){temperature+=heating?step:-step;break;}
  if(!(span>0.0&&finite(span))){invalid();return;}remaining-=span*capacity;temperature=boundary;
 }
 if(!finite(temperature)||temperature<number(p.header+34)){invalid();return;}putNumber(wh(1)+2*node,temperature);
}
