#version 450
#extension GL_ARB_gpu_shader_fp64 : require
layout(local_size_x=128) in;
layout(binding=0,std430) buffer Arena { uint words[]; };
layout(binding=1,std430) buffer Errors { uint errors; };
layout(push_constant) uniform Params { int header; int stage; int count; int argument; float cellSize; float duration; float gravity; float tolerance; } p;
const int SOURCE_K=0,PRE_K=1,POST_K=2,REFERENCE=3,STORAGE=4,DIAGONAL=5,MODE=6,CELL_P=7,NODE_P=8,NODE_DV=9,
 FACE_ROWS=10,FC=11,FO=12,CURSOR=13,NODE_FACES=14,BC=15,BO=16,BN=17,PARTS=18,DATUM=19,DISPATCH=21,LARGE_NODES=22;
shared double part[128],otherPart[128],loadPart[128];
shared int nodePart[128];
int h(int i){return int(words[p.header+i]);}
int at(int field){return h(32+field);}
int n(){return h(0);}int g(){return h(1);}int nf(){return h(2);}int size(){return h(3);}
int get(int f,int i){return int(words[at(f)+i]);}void put(int f,int i,int v){words[at(f)+i]=uint(v);}
double number(int address){return packDouble2x32(uvec2(words[address],words[address+1]));}
void writeNumber(int address,double value){uvec2 bits=unpackDouble2x32(value);words[address]=bits.x;words[address+1]=bits.y;}
double read(int field,int i){return number(at(field)+2*i);}void write(int field,int i,double v){writeNumber(at(field)+2*i,v);}
double state(int node,int quantity){return number(h(8)+2*(9*node+quantity));}
double face(int f,int column){return number(h(5)+2*(4*f+column));}
double cell(int c,int column){return number(h(4)+2*(4*c+column));}
double volume(int node){return number(h(7)+2*node);}
double pressure(int row){return number(h(20)+2*row);}
double reference(int row){return row<0?-read(DATUM,0):read(REFERENCE,row);}
bool finite(double v){return !isnan(v)&&!isinf(v);}
void invalid(){atomicOr(errors,16384u);}
bool populated(int node){return words[h(10)+node]!=words[h(10)+node+1];}
bool full(int c){return cell(c,1)>0.0&&cell(c,2)>0.0&&cell(c,2)-cell(c,0)<=4e-5;}
int xFaces(){return (h(11)+1)*h(12)*h(13);}int yFaces(){return h(11)*(h(12)+1)*h(13);}
ivec2 faceCells(int f){
 int axis=f<xFaces()?0:f<xFaces()+yFaces()?1:2,local=f-(axis==0?0:axis==1?xFaces():xFaces()+yFaces());
 ivec3 shape=ivec3(h(11),h(12),h(13));shape[axis]++;
 ivec3 right=ivec3(local%shape.x,local/shape.x%shape.y,local/(shape.x*shape.y)),left=right;left[axis]--;
 if(left[axis]<0||right[axis]>=ivec3(h(11),h(12),h(13))[axis])return ivec2(-1);
 return ivec2((left.z*h(12)+left.y)*h(11)+left.x,(right.z*h(12)+right.y)*h(11)+right.x);
}
int faceAt(int c,int side){
 int axis=side/2;ivec3 pos=ivec3(c%h(11),c/h(11)%h(12),c/(h(11)*h(12))),shape=ivec3(h(11),h(12),h(13));
 if((side&1)!=0)pos[axis]++;shape[axis]++;
 return (axis==0?0:axis==1?xFaces():xFaces()+yFaces())+(pos.z*shape.y+pos.y)*shape.x+pos.x;
}
int rowOf(int c){
 if(full(c))return c;int node=int(words[h(6)+c]);
 if(node>g()||node>int(words[h(9)])){invalid();return -1;}return node>0?n()+node-1:-1;
}
double b(int f){return face(f,3)/number(p.header+58);}
double inertia(int f){double q=number(p.header+58);return q*q*q/face(f,0);}
double weight(int f){double q=b(f);return q*q*inertia(f);}
ivec2 rowsOf(int f){return ivec2(get(FACE_ROWS,2*f),get(FACE_ROWS,2*f+1));}
int peerRow(int f,int row){ivec2 r=rowsOf(f);return r.x==row?r.y:r.x;}
int gasSign(int f,int row){return rowsOf(f).x==row?1:-1;}
// Range reduction keeps double-precision logarithms/exponentials independent of float shader intrinsics.
double logarithm(double x){int e;double m=frexp(x,e);if(m<0.7071067811865475244LF){m*=2.0;e--;}
 double z=(m-1.0)/(m+1.0),z2=z*z,power=z,result=z;for(int k=3;k<=25;k+=2){power*=z2;result+=power/double(k);}return 2.0*result+double(e)*0.6931471805599453094LF;}
double exponential(double x){int e=int(round(x/0.6931471805599453094LF));double r=x-double(e)*0.6931471805599453094LF,term=1.0,result=1.0;
 for(int k=1;k<=18;k++){term*=r/double(k);result+=term;}return ldexp(result,e);}
double compliance(int node,double load){
 double old=state(node,1),v=volume(node),gamma=state(node,5),d=max(old,load)-old;
 if(d<=old*1e-8)return v*state(node,8);
 return v*(1.0-exponential((logarithm(old)-logarithm(old+d))/gamma))/d;
}
void reduce(int lane){for(int step=64;step>0;step>>=1){barrier();if(lane<step){part[lane]+=part[lane+step];otherPart[lane]+=otherPart[lane+step];loadPart[lane]=max(loadPart[lane],loadPart[lane+step]);}}barrier();}
void capture(int f){double v=face(f,1);write(SOURCE_K,f,.5*face(f,0)*v*v);}
void dispatchCount(int start,int groups){put(DISPATCH,start,min(groups,65535));put(DISPATCH,start+1,(groups+65534)/65535);put(DISPATCH,start+2,1);}
void initialize(int row){
 write(REFERENCE,row,0.0);words[h(19)+row]=uint(-1);words[h(22)+row]=0u;
 writeNumber(h(23)+2*row,0.0);writeNumber(h(23)+2*(size()+row),0.0);writeNumber(h(23)+2*(2*size()+row),0.0);
 if(row<g()){put(FC,row,0);put(CURSOR,row,0);put(MODE,row,0);write(STORAGE,row,0.0);}
 if(row>=n()){int entry=7*n()+row-n();words[h(16)+row]=uint(entry);words[h(17)+entry]=uint(row);writeNumber(h(18)+2*entry,1.0);}
 if(row==size()-1)words[h(16)+size()]=uint(7*n()+g());
 if(row==0){writeNumber(h(23)+6*size(),double(p.tolerance));writeNumber(p.header+58,double(p.cellSize));
  writeNumber(p.header+60,double(p.duration));writeNumber(p.header+62,double(p.gravity));dispatchCount(0,clamp(int(words[h(9)]),0,g()));words[p.header+14]=0u;}
}
void datum(int lane){
 double largest=-1.0;int selected=-1,actual=int(words[h(9)]);if(actual<0||actual>g()){if(lane==0)invalid();actual=0;}
 for(int node=lane;node<actual;node+=128)if(populated(node)&&volume(node)>largest){largest=volume(node);selected=node;}
 part[lane]=largest;nodePart[lane]=selected;
 for(int step=64;step>0;step>>=1){barrier();if(lane<step&&(part[lane+step]>part[lane]||(part[lane+step]==part[lane]&&nodePart[lane+step]<nodePart[lane]))){part[lane]=part[lane+step];nodePart[lane]=nodePart[lane+step];}}
 barrier();if(lane==0)write(DATUM,0,nodePart[0]<0?0.0:state(nodePart[0],1)-number(p.header+56));
}
void prepareFace(int f){
 double v=face(f,1);write(PRE_K,f,.5*face(f,0)*v*v);ivec2 cells=faceCells(f),r=ivec2(-1);
 if(cells.x>=0&&face(f,0)>0.0&&face(f,2)>0.0&&face(f,3)>0.0)r=ivec2(rowOf(cells.x),rowOf(cells.y));
 if(r.x==r.y)r=ivec2(-1);put(FACE_ROWS,2*f,r.x);put(FACE_ROWS,2*f+1,r.y);
 for(int side=0;side<2;side++)if(r[side]>=n())atomicAdd(words[at(FC)+r[side]-n()],1u);
}
void scatter(int f){ivec2 r=rowsOf(f);for(int side=0;side<2;side++)if(r[side]>=n()){
 int node=r[side]-n(),slot=int(atomicAdd(words[at(CURSOR)+node],1u));put(NODE_FACES,get(FO,node)+slot,f);
}}
void gasRow(int node,int lane){
 int row=n()+node,start=get(FO,node),end=get(FO,node+1);double diag=0.0,rhs=0.0,load=0.0;
 double old=node<int(words[h(9)])?state(node,1):0.0,ref=old-number(p.header+56)-read(DATUM,0);
 for(int i=start+lane;i<end;i+=128){
  int f=get(NODE_FACES,i),peer=peerRow(f,row);double a=weight(f),peerRef=peer>=n()?state(peer-n(),1)-number(p.header+56)-read(DATUM,0):peer>=0?0.0:-read(DATUM,0);
  diag+=a;rhs-=double(gasSign(f,row))*b(f)*face(f,1)/double(p.duration)+a*(ref-peerRef);
  if(peer>=0&&peer<n()){double density=cell(peer,0)>0.0?cell(peer,1)/(cell(peer,0)*double(p.cellSize)*double(p.cellSize)*double(p.cellSize)):0.0;load=max(load,number(p.header+56)+read(CELL_P,peer)+density*double(p.gravity)*double(p.cellSize));}
 }
 part[lane]=diag;otherPart[lane]=rhs;loadPart[lane]=load;reduce(lane);
 if(lane==0){
  bool enabledRow=end>start;double storage=0.0,q=double(p.cellSize),factor=1.0/(double(p.duration)*double(p.duration)*q*q*q),r=otherPart[0];
  if(enabledRow){if(populated(node)){storage=factor*compliance(node,loadPart[0]);if(!(finite(storage)&&storage>0.0))invalid();}else r-=factor*volume(node);}
  write(REFERENCE,row,ref);write(STORAGE,node,storage);write(DIAGONAL,node,part[0]+storage);put(MODE,node,enabledRow?1:0);
  int entry=7*n()+node;words[h(16)+row]=uint(entry);words[h(17)+entry]=uint(row);writeNumber(h(18)+2*entry,enabledRow?part[0]+storage:1.0);
  words[h(19)+row]=enabledRow?uint(row):uint(-1);words[h(22)+row]=enabledRow?1u:0u;
  writeNumber(h(23)+2*row,enabledRow?r:0.0);writeNumber(h(23)+2*(size()+row),-old);
  if(node==g()-1)words[h(16)+size()]=uint(entry+1);
 }
}
void liquidRow(int row){
 bool enabled=full(row);int start=7*row;words[h(16)+row]=uint(start);words[h(17)+start]=uint(row);double diagonal=0.0,rhs=0.0;
 for(int side=0;side<6;side++){
  int f=faceAt(row,side);ivec2 r=rowsOf(f);bool present=enabled&&(r.x==row||r.y==row);int peer=present?peerRow(f,row):-1;double a=present?weight(f):0.0;
  words[h(17)+start+1+side]=uint(peer>=0?peer:row);writeNumber(h(18)+2*(start+1+side),peer>=0?-a:0.0);
  if(present){diagonal+=a;rhs-=double((side&1)!=0?1:-1)*b(f)*face(f,1)/double(p.duration)-a*reference(peer);}
 }
 bool enabledRow=enabled&&diagonal>0.0;words[h(19)+row]=enabledRow?uint(row):uint(-1);writeNumber(h(18)+2*start,enabledRow?diagonal:1.0);writeNumber(h(23)+2*row,enabledRow?rhs:0.0);
 writeNumber(h(23)+2*(2*size()+row),enabledRow?read(CELL_P,row)-read(DATUM,0):0.0);
 if(row==0)words[h(16)+n()]=uint(7*n());
}
void countBlocks(int node){int count=get(FC,node);put(BC,node,count>128?(count+127)/128:0);
 if(count>128){int slot=int(atomicAdd(words[p.header+14],1u));put(LARGE_NODES,slot,node);}}
void mapBlocks(int node){if(node==0){dispatchCount(3,get(BO,g()));dispatchCount(6,h(14));}for(int block=get(BO,node);block<get(BO,node+1);block++)put(BN,block,node);}
double vector(int row){return row<0?0.0:p.argument==0?pressure(row):number(h(21)+2*(size()+row));}
void productBlock(int block,int lane){
 if(block>=get(BO,g()))return;int node=get(BN,block),row=n()+node,index=get(FO,node)+128*(block-get(BO,node))+lane;
 double result=0.0;if(index<get(FO,node+1)){int f=get(NODE_FACES,index);result=weight(f)*(vector(row)-vector(peerRow(f,row)));}
 part[lane]=result;otherPart[lane]=0.0;loadPart[lane]=0.0;reduce(lane);if(lane==0)write(PARTS,block,part[0]);
}
void productNode(int node,int lane){
 double result=0.0;for(int block=get(BO,node)+lane;block<get(BO,node+1);block+=128)result+=read(PARTS,block);
 part[lane]=result;otherPart[lane]=0.0;loadPart[lane]=0.0;reduce(lane);
 if(lane==0)writeNumber(h(21)+2*(2*size()+n()+node),part[0]+read(STORAGE,node)*vector(n()+node));
}
// Small rows use a single invocation; only large chambers pay for block reductions.
void productSmall(int node){
 if(node>=int(words[h(9)])||get(FC,node)>128)return;
 int row=n()+node;double own=vector(row),result=read(STORAGE,node)*own;
 for(int i=get(FO,node);i<get(FO,node+1);i++){int f=get(NODE_FACES,i);result+=weight(f)*(own-vector(peerRow(f,row)));}
 writeNumber(h(21)+2*(2*size()+row),result);
}
void project(int f){
 ivec2 r=rowsOf(f);double v=face(f,1);
 if(faceCells(f).x<0||face(f,0)<=0.0||face(f,2)<=0.0)v=0.0;
 if(r.x>=0||r.y>=0){double pa=reference(r.x)+(r.x>=0?pressure(r.x):0.0),pb=reference(r.y)+(r.y>=0?pressure(r.y):0.0);v+=double(p.duration)*inertia(f)*b(f)*(pa-pb);}
 if(!finite(v))invalid();writeNumber(h(5)+2*(4*f+1),v);write(POST_K,f,.5*face(f,0)*v*v);
}
void observeGas(int node,int lane){
 double change=0.0;int row=n()+node;for(int i=get(FO,node)+lane;i<get(FO,node+1);i+=128){int f=get(NODE_FACES,i);change+=double(gasSign(f,row))*b(f)*face(f,1);}
 part[lane]=change;otherPart[lane]=0.0;loadPart[lane]=0.0;reduce(lane);
 if(lane==0){double q=double(p.cellSize);write(NODE_DV,node,double(p.duration)*q*q*q*part[0]);write(NODE_P,node,node<int(words[h(9)])?max(0.0,state(node,1)+(get(MODE,node)!=0?pressure(row):0.0)):0.0);}
}
void main(){
 int block=int(gl_WorkGroupID.y*gl_NumWorkGroups.x+gl_WorkGroupID.x),lane=int(gl_LocalInvocationID.x),id=128*block+lane;
 if((p.stage==9||p.stage==10||p.stage==14)&&number(h(24)+2*(p.argument==0?7:3))==0.0)return;
 if(p.stage==2){datum(lane);return;}
 if(p.stage==5||p.stage==9||p.stage==10||p.stage==12){
  if(block>=(p.stage==9?get(BO,g()):p.stage==10?h(14):int(words[h(9)])))return;
  if(p.stage==5)gasRow(block,lane);else if(p.stage==9)productBlock(block,lane);else if(p.stage==10)productNode(get(LARGE_NODES,block),lane);else observeGas(block,lane);return;
 }
 if(id>=p.count)return;
 if(p.stage==0)capture(id);else if(p.stage==1)initialize(id);else if(p.stage==3)prepareFace(id);else if(p.stage==4)scatter(id);
 else if(p.stage==6)liquidRow(id);else if(p.stage==7)countBlocks(id);else if(p.stage==8)mapBlocks(id);else if(p.stage==11)project(id);
 else if(p.stage==13)write(CELL_P,id,full(id)?read(DATUM,0)+pressure(id):0.0);else if(p.stage==14)productSmall(id);
}