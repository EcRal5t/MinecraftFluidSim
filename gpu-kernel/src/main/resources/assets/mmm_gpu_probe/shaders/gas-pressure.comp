#version 450
#extension GL_ARB_gpu_shader_fp64 : require
layout(local_size_x = 128) in;
layout(binding = 0, std430) buffer Arena {
    uint words[];
};
layout(binding = 1, std430) buffer Errors {
    uint errors;
};
layout(push_constant) uniform Params {
    int header;
    int stage;
    int count;
    int argument;
    float cellSize;
    float duration;
    float gravity;
    float tolerance;
}
p;
// HOST_LAYOUT
const int GAS_STATE_STRIDE = 9;
const int GAS_STATE_PRESSURE = 1;
const int GAS_STATE_GAS_CONSTANT = 4;
const int GAS_STATE_HEAT_CAPACITY_RATIO = 5;
const int GAS_STATE_COMPLIANCE = 8;
const int GEOMETRY_RECORD_STRIDE = 4;
const double FULL_CELL_VOLUME_TOLERANCE = 4e-5;
const uint INVALID_GAS_STATE_ERROR = 16384u;
const int CELL_VOLUME = 0;
const int CELL_MASS = 1;
const int CELL_CAPACITY = 2;
const int FACE_MASS = 0;
const int FACE_VELOCITY = 1;
const int FACE_OPEN_AREA = 2;
const int FACE_LIQUID_AREA = 3;
shared double primaryReductionPart[128], secondaryReductionPart[128], maximumLoadPart[128];
shared int datumNodePart[128];
int headerWord(int i) {
    return int(words[p.header + i]);
}
int fieldOffset(int field) {
    return headerWord(WORK_FIELDS + field);
}
int cellCount() {
    return headerWord(H_LIQUID_COUNT);
}
int gasCapacity() {
    return headerWord(H_GAS_CAPACITY);
}
int faceCount() {
    return headerWord(H_FACE_COUNT);
}
int pressureRowCount() {
    return headerWord(H_PRESSURE_SIZE);
}
int readIntField(int f, int i) {
    return int(words[fieldOffset(f) + i]);
}
void writeIntField(int f, int i, int v) {
    words[fieldOffset(f) + i] = uint(v);
}
double readDoubleAt(int address) {
    return packDouble2x32(uvec2(words[address], words[address + 1]));
}
void writeNumber(int address, double value) {
    uvec2 bits = unpackDouble2x32(value);
    words[address] = bits.x;
    words[address + 1] = bits.y;
}
double readDoubleField(int field, int i) {
    return readDoubleAt(fieldOffset(field) + 2 * i);
}
void writeDoubleField(int field, int i, double v) {
    writeNumber(fieldOffset(field) + 2 * i, v);
}
double nodeState(int node, int quantity) {
    return readDoubleAt(headerWord(H_THERMODYNAMIC_STATES) + 2 * (GAS_STATE_STRIDE * node + quantity));
}
double faceValue(int f, int column) {
    return readDoubleAt(headerWord(H_FACES) + 2 * (GEOMETRY_RECORD_STRIDE * f + column));
}
double cellValue(int c, int column) {
    return readDoubleAt(headerWord(H_CELLS) + 2 * (GEOMETRY_RECORD_STRIDE * c + column));
}
double nodeVolume(int node) {
    return readDoubleAt(headerWord(H_NODE_VOLUMES) + 2 * node);
}
double rowPressure(int row) {
    return readDoubleAt(headerWord(H_PRESSURE) + 2 * row);
}
double rowReference(int row) {
    return row < 0 ? -readDoubleField(FIELD_DATUM, 0) : readDoubleField(FIELD_REFERENCE, row);
}
bool finite(double v) {
    return !isnan(v) && !isinf(v);
}
void invalid() {
    atomicOr(errors, INVALID_GAS_STATE_ERROR);
}
bool populated(int node) {
    return nodeState(node, GAS_STATE_GAS_CONSTANT) > 0.0;
}
bool activeCell(int c) {
    return headerWord(H_ACTIVITY_CELLS) < 0 || words[headerWord(H_ACTIVITY_CELLS) + c] != 0u;
}
bool activeFace(int f) {
    return headerWord(H_ACTIVITY_FACES) < 0 || words[headerWord(H_ACTIVITY_FACES) + f] != 0u;
}
bool isFullLiquidCell(int c) {
    return activeCell(c) && cellValue(c, CELL_MASS) > 0.0 && cellValue(c, CELL_CAPACITY) > 0.0 && cellValue(c, CELL_CAPACITY) - cellValue(c, CELL_VOLUME) <= FULL_CELL_VOLUME_TOLERANCE;
}
int xFaces() {
    return (headerWord(H_SIZE_X) + 1) * headerWord(H_SIZE_Y) * headerWord(H_SIZE_Z);
}
int yFaces() {
    return headerWord(H_SIZE_X) * (headerWord(H_SIZE_Y) + 1) * headerWord(H_SIZE_Z);
}
ivec2 faceCells(int f) {
    int axis = f < xFaces()              ? 0
               : f < xFaces() + yFaces() ? 1
                                         : 2,
        local = f - (axis == 0   ? 0
                     : axis == 1 ? xFaces()
                                 : xFaces() + yFaces());
    ivec3 shape = ivec3(headerWord(H_SIZE_X), headerWord(H_SIZE_Y), headerWord(H_SIZE_Z));
    shape[axis]++;
    ivec3 right = ivec3(local % shape.x, local / shape.x % shape.y, local / (shape.x * shape.y)), left = right;
    left[axis]--;
    if (left[axis] < 0 || right[axis] >= ivec3(headerWord(H_SIZE_X), headerWord(H_SIZE_Y), headerWord(H_SIZE_Z))[axis])
        return ivec2(-1);
    return ivec2((left.z * headerWord(H_SIZE_Y) + left.y) * headerWord(H_SIZE_X) + left.x,
                 (right.z * headerWord(H_SIZE_Y) + right.y) * headerWord(H_SIZE_X) + right.x);
}
int faceAt(int c, int side) {
    int axis = side / 2;
    ivec3 pos = ivec3(c % headerWord(H_SIZE_X), c / headerWord(H_SIZE_X) % headerWord(H_SIZE_Y), c / (headerWord(H_SIZE_X) * headerWord(H_SIZE_Y))),
          shape = ivec3(headerWord(H_SIZE_X), headerWord(H_SIZE_Y), headerWord(H_SIZE_Z));
    if ((side & 1) != 0)
        pos[axis]++;
    shape[axis]++;
    return (axis == 0 ? 0 : axis == 1 ? xFaces() : xFaces() + yFaces()) + (pos.z * shape.y + pos.y) * shape.x + pos.x;
}
int rowOf(int c) {
    if (isFullLiquidCell(c))
        return c;
    int node = int(words[headerWord(H_CELL_NODES) + c]);
    if (node > gasCapacity() || node > int(words[headerWord(H_GAS_COUNTS)])) {
        invalid();
        return -1;
    }
    return node > 0 ? cellCount() + node - 1 : -1;
}
double faceAreaOverCellSize(int f) {
    return faceValue(f, FACE_LIQUID_AREA) / readDoubleAt(p.header + H_CELL_SIZE);
}
double inertia(int f) {
    double q = readDoubleAt(p.header + H_CELL_SIZE);
    return q * q * q / faceValue(f, FACE_MASS);
}
double weight(int f) {
    double q = faceAreaOverCellSize(f);
    return q * q * inertia(f);
}
ivec2 rowsOf(int f) {
    return ivec2(readIntField(FIELD_FACE_ROWS, 2 * f), readIntField(FIELD_FACE_ROWS, 2 * f + 1));
}
int peerRow(int f, int row) {
    ivec2 r = rowsOf(f);
    return r.x == row ? r.y : r.x;
}
int gasSign(int f, int row) {
    return rowsOf(f).x == row ? 1 : -1;
}
// Range reduction keeps double-precision logarithms/exponentials independent of float shader intrinsics.
double logarithm(double x) {
    int e;
    double m = frexp(x, e);
    if (m < 0.7071067811865475244LF) {
        m *= 2.0;
        e--;
    }
    double z = (m - 1.0) / (m + 1.0), z2 = z * z, power = z, result = z;
    for (int k = 3; k <= 25; k += 2) {
        power *= z2;
        result += power / double(k);
    }
    return 2.0 * result + double(e) * 0.6931471805599453094LF;
}
double exponential(double x) {
    int e = int(round(x / 0.6931471805599453094LF));
    double r = x - double(e) * 0.6931471805599453094LF, term = 1.0, result = 1.0;
    for (int k = 1; k <= 18; k++) {
        term *= r / double(k);
        result += term;
    }
    return ldexp(result, e);
}
double compliance(int node, double load) {
    double old = nodeState(node, GAS_STATE_PRESSURE), v = nodeVolume(node), gamma = nodeState(node, GAS_STATE_HEAT_CAPACITY_RATIO), d = max(old, load) - old;
    if (d <= old * 1e-8)
        return v * nodeState(node, GAS_STATE_COMPLIANCE);
    return v * (1.0 - exponential((logarithm(old) - logarithm(old + d)) / gamma)) / d;
}
void reduce(int lane) {
    for (int step = 64; step > 0; step >>= 1) {
        barrier();
        if (lane < step) {
            primaryReductionPart[lane] += primaryReductionPart[lane + step];
            secondaryReductionPart[lane] += secondaryReductionPart[lane + step];
            maximumLoadPart[lane] = max(maximumLoadPart[lane], maximumLoadPart[lane + step]);
        }
    }
    barrier();
}
void capture(int f) {
    double v = faceValue(f, FACE_VELOCITY);
    writeDoubleField(FIELD_SOURCE_FACE_K, f, .5 * faceValue(f, FACE_MASS) * v * v);
}
void dispatchCount(int start, int groups) {
    writeIntField(FIELD_DISPATCH, start, min(groups, 65535));
    writeIntField(FIELD_DISPATCH, start + 1, (groups + 65534) / 65535);
    writeIntField(FIELD_DISPATCH, start + 2, 1);
}
void initialize(int row) {
    writeDoubleField(FIELD_REFERENCE, row, 0.0);
    words[headerWord(H_ROWS) + row] = uint(-1);
    words[headerWord(H_META) + row] = 0u;
    writeNumber(headerWord(H_PROBLEM) + 2 * row, 0.0);
    writeNumber(headerWord(H_PROBLEM) + 2 * (pressureRowCount() + row), 0.0);
    writeNumber(headerWord(H_PROBLEM) + 2 * (2 * pressureRowCount() + row), 0.0);
    if (row < gasCapacity()) {
        writeIntField(FIELD_FACE_COUNTS, row, 0);
        writeIntField(FIELD_FACE_CURSORS, row, 0);
        writeIntField(FIELD_MECHANICAL_MODE, row, 0);
        writeDoubleField(FIELD_STORAGE, row, 0.0);
    }
    if (row >= cellCount()) {
        int entry = 7 * cellCount() + row - cellCount();
        words[headerWord(H_STARTS) + row] = uint(entry);
        words[headerWord(H_COLUMNS) + entry] = uint(row);
        writeNumber(headerWord(H_VALUES) + 2 * entry, 1.0);
    }
    if (row == pressureRowCount() - 1)
        words[headerWord(H_STARTS) + pressureRowCount()] = uint(7 * cellCount() + pressureRowCount() - cellCount());
    if (row == 0) {
        writeNumber(headerWord(H_PROBLEM) + 6 * pressureRowCount(), double(p.tolerance));
        writeNumber(p.header + H_CELL_SIZE, double(p.cellSize));
        writeNumber(p.header + H_DURATION, double(p.duration));
        writeNumber(p.header + H_GRAVITY, double(p.gravity));
        dispatchCount(0, clamp(int(words[headerWord(H_GAS_COUNTS)]), 0, gasCapacity()));
        dispatchCount(3, 0);
        dispatchCount(6, 0);
        dispatchCount(30, 0);
        words[p.header + H_LARGE_COUNT] = 0u;
        words[p.header + H_SOLVE_COUNT] = 0u;
        words[p.header + H_SHORT_COUNT] = 0u;
        words[p.header + H_SCHUR_MODE] = 0u;
    }
}
void appendSolveRow(int row) {
    uint slot = atomicAdd(words[p.header + H_SOLVE_COUNT], 1u);
    writeIntField(FIELD_SOLVE_ROWS, int(slot), row);
}
void datum(int lane) {
    double largest = -1.0;
    int selected = -1, actual = int(words[headerWord(H_GAS_COUNTS)]);
    if (actual < 0 || actual > gasCapacity()) {
        if (lane == 0)
            invalid();
        actual = 0;
    }
    for (int node = lane; node < actual; node += 128)
        if (populated(node) && nodeVolume(node) > largest) {
            largest = nodeVolume(node);
            selected = node;
        }
    primaryReductionPart[lane] = largest;
    datumNodePart[lane] = selected;
    for (int step = 64; step > 0; step >>= 1) {
        barrier();
        if (lane < step && (primaryReductionPart[lane + step] > primaryReductionPart[lane] ||
                            (primaryReductionPart[lane + step] == primaryReductionPart[lane] && datumNodePart[lane + step] < datumNodePart[lane]))) {
            primaryReductionPart[lane] = primaryReductionPart[lane + step];
            datumNodePart[lane] = datumNodePart[lane + step];
        }
    }
    barrier();
    if (lane == 0)
        writeDoubleField(FIELD_DATUM, 0, datumNodePart[0] < 0 ? 0.0 : nodeState(datumNodePart[0], GAS_STATE_PRESSURE) - readDoubleAt(p.header + H_AMBIENT_PRESSURE));
}
// Build pressure incidence only across active faces; preserve kinetic energy for settlement.
void prepareFace(int f) {
    double velocity = faceValue(f, FACE_VELOCITY);
    writeDoubleField(FIELD_PRE_PRESSURE_FACE_K, f, .5 * faceValue(f, FACE_MASS) * velocity * velocity);
    ivec2 cells = faceCells(f);
    ivec2 rows = ivec2(-1);
    if (activeFace(f) && cells.x >= 0 && faceValue(f, FACE_MASS) > 0.0 && faceValue(f, FACE_OPEN_AREA) > 0.0 && faceValue(f, FACE_LIQUID_AREA) > 0.0)
        rows = ivec2(rowOf(cells.x), rowOf(cells.y));
    if (rows.x == rows.y)
        rows = ivec2(-1);
    writeIntField(FIELD_FACE_ROWS, 2 * f, rows.x);
    writeIntField(FIELD_FACE_ROWS, 2 * f + 1, rows.y);
    for (int side = 0; side < 2; side++)
        if (rows[side] >= cellCount())
            atomicAdd(words[fieldOffset(FIELD_FACE_COUNTS) + rows[side] - cellCount()], 1u);
}
void scatter(int f) {
    ivec2 r = rowsOf(f);
    for (int side = 0; side < 2; side++)
        if (r[side] >= cellCount()) {
            int node = r[side] - cellCount(), slot = int(atomicAdd(words[fieldOffset(FIELD_FACE_CURSORS) + node], 1u));
            int entry = readIntField(FIELD_FACE_OFFSETS, node) + slot;
            writeIntField(FIELD_NODE_FACES, entry, f);
            writeIntField(FIELD_PRODUCT_PEERS, entry, r[1 - side]);
            writeDoubleField(FIELD_PRODUCT_WEIGHTS, entry, weight(f));
        }
}
void gasRow(int node, int lane) {
    int row = cellCount() + node, start = readIntField(FIELD_FACE_OFFSETS, node), end = readIntField(FIELD_FACE_OFFSETS, node + 1);
    double diag = 0.0, rhs = 0.0, load = 0.0;
    double old = node < int(words[headerWord(H_GAS_COUNTS)]) ? nodeState(node, GAS_STATE_PRESSURE) : 0.0,
           ref = old - readDoubleAt(p.header + H_AMBIENT_PRESSURE) - readDoubleField(FIELD_DATUM, 0);
    for (int i = start + lane; i < end; i += 128) {
        int f = readIntField(FIELD_NODE_FACES, i), peer = peerRow(f, row);
        double a = weight(f), peerRef = peer >= cellCount() ? nodeState(peer - cellCount(), GAS_STATE_PRESSURE) - readDoubleAt(p.header + H_AMBIENT_PRESSURE) -
                                                          readDoubleField(FIELD_DATUM, 0)
                                        : peer >= 0 ? 0.0
                                                    : -readDoubleField(FIELD_DATUM, 0);
        diag += a;
        rhs -= double(gasSign(f, row)) * faceAreaOverCellSize(f) * faceValue(f, FACE_VELOCITY) / double(p.duration) + a * (ref - peerRef);
        if (peer >= 0 && peer < cellCount()) {
            double density =
                cellValue(peer, CELL_VOLUME) > 0.0
                    ? cellValue(peer, CELL_MASS) / (cellValue(peer, CELL_VOLUME) * double(p.cellSize) * double(p.cellSize) * double(p.cellSize))
                    : 0.0;
            load = max(load, readDoubleAt(p.header + H_AMBIENT_PRESSURE) + readDoubleField(FIELD_CELL_PHYSICAL_PRESSURE, peer) +
                                 density * double(p.gravity) * double(p.cellSize));
        }
    }
    primaryReductionPart[lane] = diag;
    secondaryReductionPart[lane] = rhs;
    maximumLoadPart[lane] = load;
    reduce(lane);
    if (lane == 0) {
        bool enabledRow = end > start;
        double storage = 0.0, q = double(p.cellSize),
               factor = 1.0 / (double(p.duration) * double(p.duration) * q * q * q), r = secondaryReductionPart[0];
        if (enabledRow) {
            if (populated(node)) {
                storage = factor * compliance(node, maximumLoadPart[0]);
                if (!(finite(storage) && storage > 0.0))
                    invalid();
            } else
                r -= factor * nodeVolume(node);
        }
        writeDoubleField(FIELD_REFERENCE, row, ref);
        writeDoubleField(FIELD_STORAGE, node, storage);
        writeDoubleField(FIELD_DIAGONAL, node, primaryReductionPart[0] + storage);
        writeIntField(FIELD_MECHANICAL_MODE, node, enabledRow ? 1 : 0);
        int entry = 7 * cellCount() + node;
        words[headerWord(H_STARTS) + row] = uint(entry);
        words[headerWord(H_COLUMNS) + entry] = uint(row);
        writeNumber(headerWord(H_VALUES) + 2 * entry, enabledRow ? primaryReductionPart[0] + storage : 1.0);
        words[headerWord(H_ROWS) + row] = enabledRow ? uint(row) : uint(-1);
        words[headerWord(H_META) + row] = enabledRow ? 1u : 0u;
        writeNumber(headerWord(H_PROBLEM) + 2 * row, enabledRow ? r : 0.0);
        writeNumber(headerWord(H_PROBLEM) + 2 * (pressureRowCount() + row), -old);
        if (enabledRow)
            appendSolveRow(row);
        if (node == gasCapacity() - 1)
            words[headerWord(H_STARTS) + cellCount() + gasCapacity()] = uint(entry + 1);
    }
}
// Assemble the finite-volume liquid row from the same face incidence used for projection.
void liquidRow(int row) {
    bool enabled = isFullLiquidCell(row);
    int start = 7 * row;
    words[headerWord(H_STARTS) + row] = uint(start);
    words[headerWord(H_COLUMNS) + start] = uint(row);
    double diagonal = 0.0, rhs = 0.0;
    for (int side = 0; side < 6; side++) {
        int faceIndex = faceAt(row, side);
        ivec2 rows = rowsOf(faceIndex);
        bool present = enabled && (rows.x == row || rows.y == row);
        int peer = present ? peerRow(faceIndex, row) : -1;
        double coefficient = present ? weight(faceIndex) : 0.0;
        words[headerWord(H_COLUMNS) + start + 1 + side] = uint(peer >= 0 ? peer : row);
        writeNumber(headerWord(H_VALUES) + 2 * (start + 1 + side), peer >= 0 ? -coefficient : 0.0);
        if (present) {
            diagonal += coefficient;
            rhs -= double((side & 1) != 0 ? 1 : -1) * faceAreaOverCellSize(faceIndex) * faceValue(faceIndex, FACE_VELOCITY) / double(p.duration) -
                   coefficient * rowReference(peer);
        }
    }
    bool enabledRow = enabled && diagonal > 0.0;
    words[headerWord(H_ROWS) + row] = enabledRow ? uint(row) : uint(-1);
    writeNumber(headerWord(H_VALUES) + 2 * start, enabledRow ? diagonal : 1.0);
    writeNumber(headerWord(H_PROBLEM) + 2 * row, enabledRow ? rhs : 0.0);
    writeNumber(headerWord(H_PROBLEM) + 2 * (2 * pressureRowCount() + row),
                enabledRow ? readDoubleField(FIELD_CELL_PHYSICAL_PRESSURE, row) - readDoubleField(FIELD_DATUM, 0) : 0.0);
    if (enabledRow)
        appendSolveRow(row);
    if (row == 0)
        words[headerWord(H_STARTS) + cellCount()] = uint(7 * cellCount());
}
void countBlocks(int node) {
    if (headerWord(H_SCHUR_MODE) != 0 && readIntField(FIELD_SCHUR_ELIMINATED, node) != 0) {
        writeIntField(FIELD_BLOCK_COUNTS, node, 0);
        return;
    }
    int count = readIntField(headerWord(H_SCHUR_MODE) != 0 ? FIELD_CORE_COUNTS : FIELD_FACE_COUNTS, node);
    writeIntField(FIELD_BLOCK_COUNTS, node, count > 128 ? (count + 127) / 128 : 0);
    if (count > 128) {
        int slot = int(atomicAdd(words[p.header + H_LARGE_COUNT], 1u));
        writeIntField(FIELD_LARGE_NODES, slot, node);
    } else if (node < int(words[headerWord(H_GAS_COUNTS)]) && readDoubleField(FIELD_DIAGONAL, node) > 0.0) {
        int slot = int(atomicAdd(words[p.header + H_SHORT_COUNT], 1u));
        writeIntField(FIELD_SHORT_NODES, slot, node);
    }
}
void mapBlocks(int node) {
    if (node == 0) {
        dispatchCount(3, readIntField(FIELD_BLOCK_OFFSETS, gasCapacity()));
        dispatchCount(6, headerWord(H_LARGE_COUNT));
        dispatchCount(30, (headerWord(H_SHORT_COUNT) + 127) / 128);
    }
    for (int block = readIntField(FIELD_BLOCK_OFFSETS, node); block < readIntField(FIELD_BLOCK_OFFSETS, node + 1); block++)
        writeIntField(FIELD_BLOCK_NODES, block, node);
}
// Only certified rows enter the independent elimination set; liquid peers remain explicit.
void schurCandidate(int node) {
    writeIntField(FIELD_SCHUR_CANDIDATE, node, 0);
    writeIntField(FIELD_SCHUR_ELIMINATED, node, 0);
    int row = cellCount() + node;
    writeDoubleField(FIELD_SOURCE_RHS, node, readDoubleAt(headerWord(H_PROBLEM) + 2 * row));
    if (node >= int(words[headerWord(H_GAS_COUNTS)]) || readIntField(FIELD_MECHANICAL_MODE, node) == 0 ||
        !(readDoubleField(FIELD_DIAGONAL, node) > 0.0))
        return;
    int a = -1, b = -1;
    double wa = 0.0, wb = 0.0;
    for (int at = readIntField(FIELD_FACE_OFFSETS, node); at < readIntField(FIELD_FACE_OFFSETS, node + 1); at++) {
        int peer = readIntField(FIELD_PRODUCT_PEERS, at);
        double w = readDoubleField(FIELD_PRODUCT_WEIGHTS, at);
        if (w == 0.0 || peer < 0)
            continue;
        if (!(finite(w) && w > 0.0) || peer < cellCount() || words[headerWord(H_META) + peer] == 0u)
            return;
        if (peer == a)
            wa += w;
        else if (peer == b)
            wb += w;
        else if (a < 0) {
            a = peer;
            wa = w;
        } else if (b < 0) {
            b = peer;
            wb = w;
        } else
            return;
    }
    double margin =
        fma(-readDoubleField(FIELD_DIAGONAL, node), readDoubleAt(headerWord(H_PROBLEM) + 2 * (pressureRowCount() + row)), readDoubleField(FIELD_SOURCE_RHS, node));
    if (a >= 0)
        margin = fma(wa, readDoubleAt(headerWord(H_PROBLEM) + 2 * (pressureRowCount() + a)), margin);
    if (b >= 0)
        margin = fma(wb, readDoubleAt(headerWord(H_PROBLEM) + 2 * (pressureRowCount() + b)), margin);
    if (!finite(margin) || margin < 0.0)
        return;
    writeIntField(FIELD_SCHUR_PEER_A, node, a);
    writeIntField(FIELD_SCHUR_PEER_B, node, b);
    writeDoubleField(FIELD_SCHUR_WEIGHT_A, node, wa);
    writeDoubleField(FIELD_SCHUR_WEIGHT_B, node, wb);
    writeIntField(FIELD_SCHUR_CANDIDATE, node, 1);
}
void schurSelect(int node) {
    if (readIntField(FIELD_SCHUR_CANDIDATE, node) == 0)
        return;
    int a = readIntField(FIELD_SCHUR_PEER_A, node), b = readIntField(FIELD_SCHUR_PEER_B, node), row = cellCount() + node;
    if (a >= cellCount() && a < row && readIntField(FIELD_SCHUR_CANDIDATE, a - cellCount()) != 0)
        return;
    if (b >= cellCount() && b < row && readIntField(FIELD_SCHUR_CANDIDATE, b - cellCount()) != 0)
        return;
    writeIntField(FIELD_SCHUR_ELIMINATED, node, 1);
}
void schurAssemble(int node, int lane) {
    if (node >= int(words[headerWord(H_GAS_COUNTS)]) || readIntField(FIELD_MECHANICAL_MODE, node) == 0 ||
        readIntField(FIELD_SCHUR_ELIMINATED, node) != 0)
        return;
    int row = cellCount() + node;
    double diagonalChange = 0.0, rhsChange = 0.0;
    for (int at = readIntField(FIELD_FACE_OFFSETS, node) + lane; at < readIntField(FIELD_FACE_OFFSETS, node + 1); at += 128) {
        int peer = readIntField(FIELD_PRODUCT_PEERS, at);
        if (peer < cellCount() || readIntField(FIELD_SCHUR_ELIMINATED, peer - cellCount()) == 0)
            continue;
        int e = peer - cellCount();
        double w = readDoubleField(FIELD_PRODUCT_WEIGHTS, at), d = readDoubleField(FIELD_DIAGONAL, e);
        double own = readIntField(FIELD_SCHUR_PEER_A, e) == row   ? readDoubleField(FIELD_SCHUR_WEIGHT_A, e)
                     : readIntField(FIELD_SCHUR_PEER_B, e) == row ? readDoubleField(FIELD_SCHUR_WEIGHT_B, e)
                                                         : 0.0;
        diagonalChange += w * own / d;
        rhsChange += w * readDoubleField(FIELD_SOURCE_RHS, e) / d;
    }
    primaryReductionPart[lane] = diagonalChange;
    secondaryReductionPart[lane] = rhsChange;
    maximumLoadPart[lane] = 0.0;
    reduce(lane);
    if (lane == 0) {
        double diagonal = readDoubleField(FIELD_DIAGONAL, node) - primaryReductionPart[0], rhs = readDoubleField(FIELD_SOURCE_RHS, node) + secondaryReductionPart[0];
        if (!(finite(diagonal) && diagonal > 0.0 && finite(rhs))) {
            invalid();
            return;
        }
        writeDoubleField(FIELD_SCHUR_DIAGONAL, node, diagonal);
        writeNumber(headerWord(H_VALUES) + 2 * (7 * cellCount() + node), diagonal);
        writeNumber(headerWord(H_PROBLEM) + 2 * row, rhs);
        appendSolveRow(row);
    }
}
void schurBackSubstitute(int node) {
    if (headerWord(H_SCHUR_MODE) == 0 || readIntField(FIELD_SCHUR_ELIMINATED, node) == 0)
        return;
    int a = readIntField(FIELD_SCHUR_PEER_A, node), b = readIntField(FIELD_SCHUR_PEER_B, node);
    double rhs = readDoubleField(FIELD_SOURCE_RHS, node);
    if (a >= 0)
        rhs = fma(readDoubleField(FIELD_SCHUR_WEIGHT_A, node), rowPressure(a), rhs);
    if (b >= 0)
        rhs = fma(readDoubleField(FIELD_SCHUR_WEIGHT_B, node), rowPressure(b), rhs);
    double value = rhs / readDoubleField(FIELD_DIAGONAL, node);
    if (!finite(value)) {
        invalid();
        return;
    }
    writeNumber(headerWord(H_PRESSURE) + 2 * (cellCount() + node), value);
}
void restoreRow(int row) {
    if (row >= cellCount() && row < cellCount() + gasCapacity()) {
        int node = row - cellCount();
        writeNumber(headerWord(H_PROBLEM) + 2 * row, readDoubleField(FIELD_SOURCE_RHS, node));
        double diagonal = readIntField(FIELD_MECHANICAL_MODE, node) != 0 ? readDoubleField(FIELD_DIAGONAL, node) : 1.0;
        writeNumber(headerWord(H_VALUES) + 2 * (7 * cellCount() + node), diagonal);
        writeNumber(headerWord(H_WORK) + 2 * (4 * pressureRowCount() + row), diagonal);
    }
    if (int(words[headerWord(H_ROWS) + row]) >= 0)
        appendSolveRow(row);
}
double vector(int row) {
    return row < 0 ? 0.0 : p.argument == 0 ? rowPressure(row) : readDoubleAt(headerWord(H_WORK) + 2 * (pressureRowCount() + row));
}
int productBegin(int node) {
    return readIntField(headerWord(H_SCHUR_MODE) != 0 ? FIELD_CORE_OFFSETS : FIELD_FACE_OFFSETS, node);
}
int productEnd(int node) {
    return readIntField(headerWord(H_SCHUR_MODE) != 0 ? FIELD_CORE_OFFSETS : FIELD_FACE_OFFSETS, node + 1);
}
double edgeProduct(int row, int at) {
    if (headerWord(H_SCHUR_MODE) != 0)
        return -readDoubleField(FIELD_CORE_WEIGHTS, at) * vector(readIntField(FIELD_CORE_PEERS, at));
    return readDoubleField(FIELD_PRODUCT_WEIGHTS, at) * (vector(row) - vector(readIntField(FIELD_PRODUCT_PEERS, at)));
}
void productBlock(int block, int lane) {
    if (block >= readIntField(FIELD_BLOCK_OFFSETS, gasCapacity()))
        return;
    int node = readIntField(FIELD_BLOCK_NODES, block), row = cellCount() + node,
        index = productBegin(node) + 128 * (block - readIntField(FIELD_BLOCK_OFFSETS, node)) + lane;
    double result = 0.0;
    if (index < productEnd(node)) {
        result = edgeProduct(row, index);
    }
    primaryReductionPart[lane] = result;
    secondaryReductionPart[lane] = 0.0;
    maximumLoadPart[lane] = 0.0;
    reduce(lane);
    if (lane == 0)
        writeDoubleField(FIELD_PRODUCT_PARTS, block, primaryReductionPart[0]);
}
void productNode(int node, int lane) {
    double result = 0.0;
    for (int block = readIntField(FIELD_BLOCK_OFFSETS, node) + lane; block < readIntField(FIELD_BLOCK_OFFSETS, node + 1); block += 128)
        result += readDoubleField(FIELD_PRODUCT_PARTS, block);
    primaryReductionPart[lane] = result;
    secondaryReductionPart[lane] = 0.0;
    maximumLoadPart[lane] = 0.0;
    reduce(lane);
    if (lane == 0)
        writeNumber(
            headerWord(H_WORK) + 2 * (2 * pressureRowCount() + cellCount() + node),
            primaryReductionPart[0] + readDoubleField(headerWord(H_SCHUR_MODE) != 0 ? FIELD_SCHUR_DIAGONAL : FIELD_STORAGE, node) * vector(cellCount() + node));
}
// Small rows use a single invocation; only large chambers pay for block reductions.
void productSmall(int node) {
    if (node >= int(words[headerWord(H_GAS_COUNTS)]) ||
        readIntField(headerWord(H_SCHUR_MODE) != 0 ? FIELD_CORE_COUNTS : FIELD_FACE_COUNTS, node) > 128)
        return;
    int row = cellCount() + node;
    double own = vector(row), result = readDoubleField(headerWord(H_SCHUR_MODE) != 0 ? FIELD_SCHUR_DIAGONAL : FIELD_STORAGE, node) * own;
    for (int i = productBegin(node); i < productEnd(node); i++) {
        result += edgeProduct(row, i);
    }
    writeNumber(headerWord(H_WORK) + 2 * (2 * pressureRowCount() + row), result);
}
uint pairHash(uint a, uint b) {
    uint x = a * 0x9e3779b9u + b * 0x85ebca6bu;
    x ^= x >> 16;
    x *= 0x7feb352du;
    return x ^ (x >> 15);
}
void appendPair(int a, int b, double weight) {
    if (a < 0 || b < 0 || a == b || weight <= 0.0)
        return;
    if (!finite(weight)) {
        invalid();
        return;
    }
    if (a > b) {
        int swap = a;
        a = b;
        b = swap;
    }
    int slot = int(atomicAdd(words[fieldOffset(FIELD_PAIR_LIVE) + 1], 1u));
    if (slot >= headerWord(H_PROPOSAL_CAPACITY)) {
        invalid();
        return;
    }
    writeIntField(FIELD_PROPOSAL_A, slot, a);
    writeIntField(FIELD_PROPOSAL_B, slot, b);
    writeDoubleField(FIELD_PROPOSAL_WEIGHT, slot, weight);
}
void reducedClear(int id) {
    if (id < headerWord(H_HASH_CAPACITY))
        writeIntField(FIELD_PAIR_HASH, id, 0);
    if (id < headerWord(H_PROPOSAL_CAPACITY)) {
        writeIntField(FIELD_GROUP_COUNTS, id, 0);
        writeIntField(FIELD_GROUP_CURSORS, id, 0);
    }
    if (id < gasCapacity()) {
        writeIntField(FIELD_CORE_COUNTS, id, 0);
        writeIntField(FIELD_CORE_CURSORS, id, 0);
    }
    if (id == 0) {
        writeIntField(FIELD_PAIR_LIVE, 0, 0);
        writeIntField(FIELD_PAIR_LIVE, 1, 0);
    }
}
void originalPair(int face) {
    ivec2 rows = rowsOf(face);
    if (rows.x < 0 || rows.y < 0 || rows.x == rows.y || max(rows.x, rows.y) < cellCount())
        return;
    if (rows.x >= cellCount() && readIntField(FIELD_SCHUR_ELIMINATED, rows.x - cellCount()) != 0)
        return;
    if (rows.y >= cellCount() && readIntField(FIELD_SCHUR_ELIMINATED, rows.y - cellCount()) != 0)
        return;
    appendPair(rows.x, rows.y, weight(face));
}
void eliminatedPair(int node) {
    if (readIntField(FIELD_SCHUR_ELIMINATED, node) == 0)
        return;
    int a = readIntField(FIELD_SCHUR_PEER_A, node), b = readIntField(FIELD_SCHUR_PEER_B, node);
    if (a >= 0 && b >= 0)
        appendPair(a, b,
                   readDoubleField(FIELD_SCHUR_WEIGHT_A, node) * (readDoubleField(FIELD_SCHUR_WEIGHT_B, node) / readDoubleField(FIELD_DIAGONAL, node)));
}
void insertPair(int proposal) {
    int a = readIntField(FIELD_PROPOSAL_A, proposal), b = readIntField(FIELD_PROPOSAL_B, proposal);
    uint slot = pairHash(uint(a), uint(b)) & uint(headerWord(H_HASH_CAPACITY) - 1);
    for (int probe = 0; probe < headerWord(H_HASH_CAPACITY); probe++) {
        uint rep = atomicCompSwap(words[fieldOffset(FIELD_PAIR_HASH) + int(slot)], 0u, uint(proposal + 1));
        if (rep == 0u || (readIntField(FIELD_PROPOSAL_A, int(rep) - 1) == a && readIntField(FIELD_PROPOSAL_B, int(rep) - 1) == b)) {
            if (rep == 0u) {
                int group = int(atomicAdd(words[fieldOffset(FIELD_PAIR_LIVE)], 1u));
                writeIntField(FIELD_HASH_GROUP, int(slot), group);
                writeIntField(FIELD_GROUP_A, group, a);
                writeIntField(FIELD_GROUP_B, group, b);
            }
            writeIntField(FIELD_PROPOSAL_SLOT, proposal, int(slot));
            return;
        }
        slot = (slot + 1u) & uint(headerWord(H_HASH_CAPACITY) - 1);
    }
    invalid();
}
void countPair(int proposal) {
    int group = readIntField(FIELD_HASH_GROUP, readIntField(FIELD_PROPOSAL_SLOT, proposal));
    atomicAdd(words[fieldOffset(FIELD_GROUP_COUNTS) + group], 1u);
}
void scatterPair(int proposal) {
    int group = readIntField(FIELD_HASH_GROUP, readIntField(FIELD_PROPOSAL_SLOT, proposal)),
        index = readIntField(FIELD_GROUP_OFFSETS, group) + int(atomicAdd(words[fieldOffset(FIELD_GROUP_CURSORS) + group], 1u));
    writeIntField(FIELD_GROUP_PROPOSALS, index, proposal);
}
void sumPair(int group, int lane) {
    if (group >= readIntField(FIELD_PAIR_LIVE, 0))
        return;
    double value = 0.0;
    for (int index = readIntField(FIELD_GROUP_OFFSETS, group) + lane; index < readIntField(FIELD_GROUP_OFFSETS, group + 1); index += 128)
        value += readDoubleField(FIELD_PROPOSAL_WEIGHT, readIntField(FIELD_GROUP_PROPOSALS, index));
    primaryReductionPart[lane] = value;
    secondaryReductionPart[lane] = 0.0;
    maximumLoadPart[lane] = 0.0;
    reduce(lane);
    if (lane == 0) {
        if (!(finite(primaryReductionPart[0]) && primaryReductionPart[0] > 0.0)) {
            invalid();
            return;
        }
        writeDoubleField(FIELD_GROUP_WEIGHT, group, primaryReductionPart[0]);
        int a = readIntField(FIELD_GROUP_A, group), b = readIntField(FIELD_GROUP_B, group);
        if (a >= cellCount())
            atomicAdd(words[fieldOffset(FIELD_CORE_COUNTS) + a - cellCount()], 1u);
        if (b >= cellCount())
            atomicAdd(words[fieldOffset(FIELD_CORE_COUNTS) + b - cellCount()], 1u);
    }
}
void writeCoreEdge(int node, int peer, double value) {
    int index = readIntField(FIELD_CORE_OFFSETS, node) + int(atomicAdd(words[fieldOffset(FIELD_CORE_CURSORS) + node], 1u));
    writeIntField(FIELD_CORE_PEERS, index, peer);
    writeDoubleField(FIELD_CORE_WEIGHTS, index, value);
}
void scatterCorePair(int group) {
    int a = readIntField(FIELD_GROUP_A, group), b = readIntField(FIELD_GROUP_B, group);
    double value = readDoubleField(FIELD_GROUP_WEIGHT, group);
    if (a >= cellCount())
        writeCoreEdge(a - cellCount(), b, value);
    if (b >= cellCount())
        writeCoreEdge(b - cellCount(), a, value);
}
// Pressure difference updates face velocity in m/s; inactive faces retain their previous value.
void project(int f) {
    ivec2 rows = rowsOf(f);
    double velocity = faceValue(f, FACE_VELOCITY);
    if (!activeFace(f)) {
        writeDoubleField(FIELD_POST_PRESSURE_FACE_K, f, .5 * faceValue(f, FACE_MASS) * velocity * velocity);
        return;
    }
    if (faceCells(f).x < 0 || faceValue(f, FACE_MASS) <= 0.0 || faceValue(f, FACE_OPEN_AREA) <= 0.0)
        velocity = 0.0;
    if (rows.x >= 0 || rows.y >= 0) {
        double left = rowReference(rows.x) + (rows.x >= 0 ? rowPressure(rows.x) : 0.0);
        double right = rowReference(rows.y) + (rows.y >= 0 ? rowPressure(rows.y) : 0.0);
        velocity += double(p.duration) * inertia(f) * faceAreaOverCellSize(f) * (left - right);
    }
    if (!finite(velocity))
        invalid();
    writeNumber(headerWord(H_FACES) + 2 * (4 * f + 1), velocity);
    writeDoubleField(FIELD_POST_PRESSURE_FACE_K, f, .5 * faceValue(f, FACE_MASS) * velocity * velocity);
}
void observeGas(int node, int lane) {
    double change = 0.0;
    int row = cellCount() + node;
    for (int i = readIntField(FIELD_FACE_OFFSETS, node) + lane; i < readIntField(FIELD_FACE_OFFSETS, node + 1); i += 128) {
        int f = readIntField(FIELD_NODE_FACES, i);
        change += double(gasSign(f, row)) * faceAreaOverCellSize(f) * faceValue(f, FACE_VELOCITY);
    }
    primaryReductionPart[lane] = change;
    secondaryReductionPart[lane] = 0.0;
    maximumLoadPart[lane] = 0.0;
    reduce(lane);
    if (lane == 0) {
        double q = double(p.cellSize);
        writeDoubleField(FIELD_NODE_PREDICTED_VOLUME_CHANGE, node, double(p.duration) * q * q * q * primaryReductionPart[0]);
        writeDoubleField(FIELD_NODE_ABSOLUTE_PRESSURE, node,
              node < int(words[headerWord(H_GAS_COUNTS)])
                  ? max(0.0, nodeState(node, GAS_STATE_PRESSURE) + (readIntField(FIELD_MECHANICAL_MODE, node) != 0 ? rowPressure(row) : 0.0))
                  : 0.0);
    }
}
void main() {
    int block = int(gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x), lane = int(gl_LocalInvocationID.x),
        id = 128 * block + lane;
    if (p.stage == STAGE_COMPUTE_DATUM) {
        datum(lane);
        return;
    }
    if (p.stage == STAGE_SUM_PAIRS) {
        sumPair(block, lane);
        return;
    }
    if (p.stage == STAGE_ASSEMBLE_GAS_ROWS || p.stage == STAGE_PRODUCT_BLOCKS || p.stage == STAGE_PRODUCT_LARGE_NODES || p.stage == STAGE_OBSERVE_GAS || p.stage == STAGE_ASSEMBLE_SCHUR) {
        if (block >= (p.stage == STAGE_PRODUCT_BLOCKS    ? readIntField(FIELD_BLOCK_OFFSETS, gasCapacity())
                      : p.stage == STAGE_PRODUCT_LARGE_NODES ? headerWord(H_LARGE_COUNT)
                                      : int(words[headerWord(H_GAS_COUNTS)])))
            return;
        if (p.stage == STAGE_ASSEMBLE_SCHUR)
            schurAssemble(block, lane);
        else if (p.stage == STAGE_ASSEMBLE_GAS_ROWS)
            gasRow(block, lane);
        else if (p.stage == STAGE_PRODUCT_BLOCKS)
            productBlock(block, lane);
        else if (p.stage == STAGE_PRODUCT_LARGE_NODES)
            productNode(readIntField(FIELD_LARGE_NODES, block), lane);
        else
            observeGas(block, lane);
        return;
    }
    if (id >= p.count)
        return;
    if (p.stage == STAGE_CLEAR_REDUCED_GRAPH) {
        reducedClear(id);
        return;
    }
    if (p.stage == STAGE_PROPOSE_ORIGINAL_PAIRS) {
        originalPair(id);
        return;
    }
    if (p.stage == STAGE_PROPOSE_ELIMINATED_PAIRS) {
        eliminatedPair(id);
        return;
    }
    if (p.stage == STAGE_PUBLISH_PROPOSAL_DISPATCH) {
        if (id == 0)
            dispatchCount(33, (readIntField(FIELD_PAIR_LIVE, 1) + 127) / 128);
        return;
    }
    if (p.stage == STAGE_INSERT_PAIRS) {
        if (id < readIntField(FIELD_PAIR_LIVE, 1))
            insertPair(id);
        return;
    }
    if (p.stage == STAGE_COUNT_PAIRS) {
        if (id < readIntField(FIELD_PAIR_LIVE, 1))
            countPair(id);
        return;
    }
    if (p.stage == STAGE_PUBLISH_GROUP_DISPATCH) {
        if (id == 0) {
            dispatchCount(36, readIntField(FIELD_PAIR_LIVE, 0));
            dispatchCount(39, (readIntField(FIELD_PAIR_LIVE, 0) + 127) / 128);
        }
        return;
    }
    if (p.stage == STAGE_SCATTER_PAIRS) {
        if (id < readIntField(FIELD_PAIR_LIVE, 1))
            scatterPair(id);
        return;
    }
    if (p.stage == STAGE_SCATTER_CORE_PAIRS) {
        if (id < readIntField(FIELD_PAIR_LIVE, 0))
            scatterCorePair(id);
        return;
    }
    if (p.stage == STAGE_BEGIN_SCHUR) {
        if (id == 0) {
            words[p.header + H_ORIGINAL_SOLVE_COUNT] = words[p.header + H_SOLVE_COUNT];
            words[p.header + H_SOLVE_COUNT] = 0u;
            words[p.header + H_LARGE_COUNT] = 0u;
            words[p.header + H_SHORT_COUNT] = 0u;
            words[p.header + H_SCHUR_MODE] = 1u;
        }
        return;
    }
    if (p.stage == STAGE_FIND_SCHUR_CANDIDATES) {
        schurCandidate(id);
        return;
    }
    if (p.stage == STAGE_SELECT_SCHUR) {
        schurSelect(id);
        return;
    }
    if (p.stage == STAGE_APPEND_LIQUID_ROWS) {
        if (int(words[headerWord(H_ROWS) + id]) >= 0)
            appendSolveRow(id);
        return;
    }
    if (p.stage == STAGE_BACK_SUBSTITUTE) {
        schurBackSubstitute(id);
        return;
    }
    if (p.stage == STAGE_RESTORE_ROWS) {
        restoreRow(id);
        return;
    }
    if (p.stage == STAGE_END_SCHUR) {
        if (id == 0) {
            words[p.header + H_SOLVE_COUNT] = 0u;
            words[p.header + H_LARGE_COUNT] = 0u;
            words[p.header + H_SHORT_COUNT] = 0u;
            words[p.header + H_SCHUR_MODE] = 0u;
        }
        return;
    }
    if (p.stage == STAGE_PUBLISH_SOLVE_DISPATCH) {
        if (id == 0) {
            int count = int(words[p.header + H_SOLVE_COUNT]);
            if (headerWord(H_SCHUR_MODE) != 0)
                words[p.header + H_REDUCED_COUNT] = uint(count);
            writeNumber(headerWord(H_CONTROL) + 28, double(count));
            dispatchCount(9, max(1, (count + 255) / 256));
        }
        return;
    }
    if (p.stage == STAGE_CAPTURE_FACES)
        capture(id);
    else if (p.stage == STAGE_INITIALIZE_ROWS)
        initialize(id);
    else if (p.stage == STAGE_PREPARE_FACES)
        prepareFace(id);
    else if (p.stage == STAGE_SCATTER_FACES)
        scatter(id);
    else if (p.stage == STAGE_ASSEMBLE_LIQUID_ROWS)
        liquidRow(id);
    else if (p.stage == STAGE_COUNT_BLOCKS)
        countBlocks(id);
    else if (p.stage == STAGE_MAP_BLOCKS)
        mapBlocks(id);
    else if (p.stage == STAGE_PROJECT_FACES)
        project(id);
    else if (p.stage == STAGE_OBSERVE_FACE_ENERGY)
        writeDoubleField(FIELD_POST_PRESSURE_FACE_K, id, .5 * faceValue(id, FACE_MASS) * faceValue(id, FACE_VELOCITY) * faceValue(id, FACE_VELOCITY));
    else if (p.stage == STAGE_OBSERVE_LIQUID)
        writeDoubleField(FIELD_CELL_PHYSICAL_PRESSURE, id, isFullLiquidCell(id) ? readDoubleField(FIELD_DATUM, 0) + rowPressure(id) : 0.0);
    else if (p.stage == STAGE_PRODUCT_SHORT_NODES && id < headerWord(H_SHORT_COUNT))
        productSmall(readIntField(FIELD_SHORT_NODES, id));
}
