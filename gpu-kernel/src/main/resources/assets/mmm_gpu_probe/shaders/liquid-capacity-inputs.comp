#version 450
#extension GL_ARB_gpu_shader_fp64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
layout(local_size_x = 128) in;
layout(binding = 0, std430) buffer Arena { uint words[]; };
layout(binding = 1, std430) buffer Errors { uint errors; };
layout(push_constant) uniform Params { int header; } p;
// HOST_LAYOUT

const uint SUBCELL_MASK = 255u;
const int SOLID_QUANTA_PER_SUBCELL_SHIFT = 21;
const int FACE_RECORD_WORDS = 8;
const int FACE_AREA_WORD = 4;
const int FLUX_RECORD_WORDS = 4;
const int FLUX_LIQUID_WORD = 2;
const uint ERROR_INVALID_ROUTE = 32u;
const uint ERROR_ZERO_PORE = 4096u;
int h(int index) { return int(words[p.header + index]); }
int64_t integerAt(int at) { return int64_t(uint64_t(words[at]) | (uint64_t(words[at + 1]) << 32)); }
void putInteger(int at, int64_t value) {
    words[at] = uint(value);
    words[at + 1] = uint(uint64_t(value) >> 32);
}
double numberAt(int at) { return packDouble2x32(uvec2(words[at], words[at + 1])); }
bool finiteNumber(double value) { return !isnan(value) && !isinf(value); }
double referenceVolume(int cell) {
    int begin = int(words[h(H_TOTAL_OFFSETS) + cell]), end = int(words[h(H_TOTAL_OFFSETS) + cell + 1]);
    if (begin == end) return 0.0;
    double head = double(words[h(H_TOTAL_LIMBS) + end - 1]);
    if (end - begin > 1) head += double(words[h(H_TOTAL_LIMBS) + end - 2]) * 2.3283064365386962890625e-10LF;
    return ldexp(head, int(words[h(H_TOTAL_EXPONENTS) + cell]) + 32 * (end - begin - 1));
}
int64_t poreQuanta(int cell) {
    return (int64_t(bitCount((~words[h(H_MASKS) + cell]) & SUBCELL_MASK)) << SOLID_QUANTA_PER_SUBCELL_SHIFT)
        - integerAt(h(H_OCCUPIED) + 2 * cell);
}
int faceIndex(ivec3 pos, int axis, bool positive) {
    ivec3 dims = ivec3(h(H_SIZE_X), h(H_SIZE_Y), h(H_SIZE_Z));
    dims[axis]++;
    if (positive) pos[axis]++;
    int base = axis == 0 ? 0 : (h(H_SIZE_X) + 1) * h(H_SIZE_Y) * h(H_SIZE_Z);
    if (axis == 2) base += h(H_SIZE_X) * (h(H_SIZE_Y) + 1) * h(H_SIZE_Z);
    return base + (pos.z * dims.y + pos.y) * dims.x + pos.x;
}
void main() {
    int cell = int((gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x) * 128u + gl_LocalInvocationID.x);
    if (cell >= h(H_CELL_COUNT) || errors != 0u) return;
    int64_t supply = integerAt(h(H_QUANTIZED) + 2 * cell), pore = poreQuanta(cell);
    double volume = referenceVolume(cell), ratio = numberAt(h(H_PHYSICAL_PER_REFERENCE) + 2 * h(H_PHYSICAL_SCALE_STRIDE) * cell);
    if (supply < 0l || pore < 0l || !finiteNumber(volume) || volume < 0.0 ||
        (supply > 0l && (!(ratio > 0.0) || !finiteNumber(ratio) || !(volume > 0.0)))) {
        atomicOr(errors, ERROR_INVALID_ROUTE);
        return;
    }
    ivec3 dims = ivec3(h(H_SIZE_X), h(H_SIZE_Y), h(H_SIZE_Z));
    ivec3 pos = ivec3(cell % dims.x, cell / dims.x % dims.y, cell / (dims.x * dims.y));
    bool cellEnabled = h(H_ACTIVITY_CELLS) < 0 || words[h(H_ACTIVITY_CELLS) + cell] != 0u;
    double desired[6], total = 0.0;
    for (int side = 0; side < 6; side++) {
        int axis = side / 2;
        bool positive = (side & 1) != 0;
        int face = faceIndex(pos, axis, positive);
        double area = numberAt(h(H_FACES) + FACE_RECORD_WORDS * face + FACE_AREA_WORD);
        double flux = numberAt(h(H_FLUXES) + FLUX_RECORD_WORDS * face + FLUX_LIQUID_WORD);
        if (!finiteNumber(area) || !finiteNumber(flux)) { atomicOr(errors, ERROR_INVALID_ROUTE); return; }
        bool internal = positive ? pos[axis] + 1 < dims[axis] : pos[axis] > 0;
        int stride = axis == 0 ? 1 : axis == 1 ? dims.x : dims.x * dims.y;
        int peer = cell + (positive ? stride : -stride);
        bool connected = cellEnabled && internal && area > 0.0 &&
            (h(H_ACTIVITY_FACES) < 0 || words[h(H_ACTIVITY_FACES) + face] != 0u);
        if (connected) {
            int64_t peerPore = poreQuanta(peer);
            if (peerPore < 0l) { atomicOr(errors, ERROR_INVALID_ROUTE); return; }
            connected = peerPore > 0l && (h(H_ACTIVITY_CELLS) < 0 || words[h(H_ACTIVITY_CELLS) + peer] != 0u);
        }
        desired[side] = connected && supply > 0l ? max(0.0, (positive ? 1.0 : -1.0) * flux) / ratio : 0.0;
        total += desired[side];
    }
    if (!finiteNumber(total)) { atomicOr(errors, ERROR_INVALID_ROUTE); return; }
    double scale = total > 0.0 && volume > 0.0 ? (pore==0l?double(supply)/total:min(1.0, volume / total) * double(supply) / volume) : 0.0;
    int64_t target = pore==0l && total>0.0 ? supply : min(supply, int64_t(min(double(supply), floor(total * scale + 0.5))));
    int64_t amounts[6], allocated = 0l;
    double remainders[6];
    for (int side = 0; side < 6; side++) {
        double preference = desired[side] * scale;
        amounts[side] = min(target - allocated, int64_t(floor(preference)));
        remainders[side] = desired[side] > 0.0 ? preference - floor(preference) : -1.0;
        allocated += amounts[side];
    }
    for (int part = 0; part < 6 && allocated < target; part++) {
        int best = -1;
        for (int side = 0; side < 6; side++)
            if (remainders[side] >= 0.0 && (best < 0 || remainders[side] > remainders[best])) best = side;
        if (best < 0) break;
        amounts[best]++;
        remainders[best] = -1.0;
        allocated++;
    }
    // No liquid can remain in a cell whose future open volume is zero.
    if (pore == 0l && supply > allocated) { atomicOr(errors, ERROR_ZERO_PORE); return; }
    for (int side = 0; side < 6; side++) putInteger(h(H_ACCEPTED) + 2 * (7 * cell + side + 1), amounts[side]);
    putInteger(h(H_ACCEPTED) + 14 * cell, supply - allocated);
}
