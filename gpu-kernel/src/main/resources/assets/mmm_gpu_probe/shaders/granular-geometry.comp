#version 450
#extension GL_ARB_gpu_shader_fp64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
layout(local_size_x = 128) in;
layout(binding = 0, std430) buffer Arena {
    uint words[];
};
layout(binding = 1, std430) buffer Errors {
    uint errors;
};
layout(push_constant) uniform Params {
    int header;
    int stage;
    int count;
    int unused;
    double cellSize;
}
p;
// HOST_LAYOUT
int h(int i) {
    return int(words[p.header + i]);
}
int state(int f) {
    return h(STATE_FIELDS + f);
}
int at(int f) {
    return h(WORK_FIELDS + f);
}
int get(int f, int i) {
    return int(words[at(f) + i]);
}
void put(int f, int i, int v) {
    words[at(f) + i] = uint(v);
}
int64_t integer(int address) {
    return int64_t(uint64_t(words[address]) | (uint64_t(words[address + 1]) << 32));
}
void writeInteger(int address, int64_t v) {
    words[address] = uint(v);
    words[address + 1] = uint(uint64_t(v) >> 32);
}
double number(int address) {
    return packDouble2x32(uvec2(words[address], words[address + 1]));
}
void invalid() {
    atomicOr(errors, 524288u);
}
int64_t add(int64_t a, int64_t b) {
    if (a < 0l || b < 0l || a > 9223372036854775807l - b) {
        invalid();
        return 0l;
    }
    return a + b;
}
int activeCount() {
    return int(words[state(GRANULAR_COUNTS)]);
}
int depositCount() {
    return int(words[state(GRANULAR_COUNTS) + 1]);
}
void supports(int parcel) {
    if (parcel >= activeCount())
        return;
    int64_t volume = integer(state(GRANULAR_SOLID_VOLUME_SVQ) + 2 * parcel);
    if (volume <= 0l || volume > 262144l) {
        invalid();
        return;
    }
    dvec3 position =
        dvec3(number(state(GRANULAR_POSITION) + 6 * parcel), number(state(GRANULAR_POSITION) + 6 * parcel + 2),
              number(state(GRANULAR_POSITION) + 6 * parcel + 4)) /
            p.cellSize -
        .5;
    if (any(isnan(position)) || any(isinf(position))) {
        invalid();
        return;
    }
    ivec3 base = ivec3(floor(position)), dims = ivec3(h(H_SIZE_X), h(H_SIZE_Y), h(H_SIZE_Z));
    dvec3 f = position - dvec3(base);
    double weight[8], remainders[8], sum = 0.0;
    int cell[8];
    int64_t quota[8], used = 0l;
    for (int i = 0; i < 8; i++) {
        ivec3 delta = ivec3(i & 1, (i >> 1) & 1, (i >> 2) & 1), c = base + delta;
        bool valid = all(greaterThanEqual(c, ivec3(0))) && all(lessThan(c, dims));
        cell[i] = valid ? (c.z * dims.y + c.y) * dims.x + c.x : -1;
        dvec3 a = mix(1.0 - f, f, bvec3(delta));
        weight[i] = valid ? a.x * a.y * a.z : 0.0;
        sum += weight[i];
    }
    if (!(sum > 0.0)) {
        invalid();
        return;
    }
    for (int i = 0; i < 8; i++) {
        double scaled = double(volume) * weight[i] / sum;
        quota[i] = int64_t(floor(scaled));
        used += quota[i];
        remainders[i] = weight[i] > 0.0 ? scaled - double(quota[i]) : -1.0;
    }
    int remaining = int(volume - used);
    if (remaining < 0 || remaining > 8) {
        invalid();
        return;
    }
    for (int k = 0; k < remaining; k++) {
        int best = -1;
        for (int i = 0; i < 8; i++)
            if (remainders[i] >= 0.0 && (best < 0 || remainders[i] > remainders[best] ||
                                         (remainders[i] == remainders[best] && cell[i] < cell[best])))
                best = i;
        if (best < 0) {
            invalid();
            return;
        }
        quota[best]++;
        remainders[best] = -1.0;
    }
    for (int i = 0; i < 8; i++) {
        words[state(GRANULAR_SUPPORT_CELLS) + 8 * parcel + i] = uint(cell[i]);
        writeInteger(state(GRANULAR_SUPPORT_QUOTAS) + 2 * (8 * parcel + i), quota[i]);
    }
}
int entryCell(int entry) {
    if (entry < 8 * h(H_PARTICLE_CAPACITY)) {
        if (entry / 8 >= activeCount() || integer(state(GRANULAR_SUPPORT_QUOTAS) + 2 * entry) == 0l)
            return -1;
        return int(words[state(GRANULAR_SUPPORT_CELLS) + entry]);
    }
    int deposit = entry - 8 * h(H_PARTICLE_CAPACITY);
    return deposit < depositCount() ? int(words[state(GRANULAR_DEPOSIT_CELL) + deposit]) : -1;
}
void countEntry(int entry) {
    int c = entryCell(entry);
    if (c == -1)
        return;
    if (c < 0 || c >= h(H_CELL_COUNT)) {
        invalid();
        return;
    }
    atomicAdd(words[at(FIELD_COUNTS) + c], 1u);
}
void scatter(int entry) {
    int c = entryCell(entry);
    if (c < 0 || c >= h(H_CELL_COUNT))
        return;
    int slot = int(atomicAdd(words[at(FIELD_CURSORS) + c], 1u));
    put(3, get(1, c) + slot, entry);
}
void gather(int cell) {
    int64_t fixedVolume = integer(h(H_COHERENT_SVQ) + 2 * cell), activeVolume = 0l;
    for (int i = get(1, cell); i < get(1, cell + 1); i++) {
        int entry = get(3, i);
        if (entry < 8 * h(H_PARTICLE_CAPACITY))
            activeVolume = add(activeVolume, integer(state(GRANULAR_SUPPORT_QUOTAS) + 2 * entry));
        else
            fixedVolume = add(fixedVolume, integer(state(GRANULAR_SOLID_VOLUME_SVQ) +
                                                   2 * (h(H_PARTICLE_CAPACITY) + entry - 8 * h(H_PARTICLE_CAPACITY))));
    }
    writeInteger(at(FIELD_FIXED_SVQ) + 2 * cell, fixedVolume);
    writeInteger(at(FIELD_OCCUPIED_SVQ) + 2 * cell, add(fixedVolume, activeVolume));
}
void main() {
    int id = int((gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x) * 128 + gl_LocalInvocationID.x);
    if (id >= p.count)
        return;
    if (activeCount() < 0 || activeCount() > h(H_PARTICLE_CAPACITY) || depositCount() < 0 ||
        depositCount() > h(H_DEPOSIT_CAPACITY)) {
        invalid();
        return;
    }
    if (p.stage == 0)
        supports(id);
    else if (p.stage == 1) {
        put(0, id, 0);
        put(2, id, 0);
    } else if (p.stage == 2)
        countEntry(id);
    else if (p.stage == 3)
        scatter(id);
    else if (p.stage == 4)
        gather(id);
}
