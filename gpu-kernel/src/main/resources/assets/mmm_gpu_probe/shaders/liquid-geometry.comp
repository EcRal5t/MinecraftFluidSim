#version 450
#extension GL_ARB_gpu_shader_fp64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

const int STAGE_CELL_TOTALS = 0;
const int STAGE_RECONSTRUCT_INTERFACE = 1;
const int STAGE_FACE_GEOMETRY = 2;
const int STAGE_REFRESH_VELOCITY = 4;
const uint ERROR_LIQUID_GEOMETRY = 1u;
const int CELL_LIQUID_VOLUME = 0;
const int CELL_MASS = 1;
const int CELL_PORE_VOLUME = 2;
const int CELL_FILL = 3;
const int FACE_MASS = 0;
const int FACE_VELOCITY = 1;
const int FACE_OPEN_AREA = 2;
const int FACE_WET_AREA = 3;
const double MASS_UNIT_KG = 1e-10;
const double SOLID_VOLUME_UNITS_PER_CELL = 16777216.0;
layout(local_size_x = 128) in;
layout(push_constant) uniform Metadata {
    int sx;
    int sy;
    int sz;
    int stage;
    float h;
    float dt;
    int sealedExterior;
    float ambientCellMass;
}
pc;
// SPATIAL_GRID
// HOST_LAYOUT
// PLIC_FACE_LIBRARY
layout(std430, binding = B_OFFSETS) readonly buffer Offsets {
    int offsets[];
};
layout(std430, binding = B_VOLUMES) readonly buffer Volumes {
    double volumes[];
};
layout(std430, binding = B_MASSES) readonly buffer Masses {
    int64_t masses[];
};
layout(std430, binding = B_MASKS) readonly buffer Masks {
    uint masks[];
};
layout(std430, binding = B_SOLIDS) readonly buffer Solids {
    int64_t occupied[];
};
layout(std430, binding = B_MOMENTUM_X) readonly buffer MomentumX {
    double momentumX[];
};
layout(std430, binding = B_MOMENTUM_Y) readonly buffer MomentumY {
    double momentumY[];
};
layout(std430, binding = B_MOMENTUM_Z) readonly buffer MomentumZ {
    double momentumZ[];
};
layout(std430, binding = B_CELLS) buffer Cells {
    dvec4 cells[];
};
layout(std430, binding = B_PLANES) buffer Planes {
    dvec4 planes[];
};
layout(std430, binding = B_MICRO) buffer Micro {
    double microVolume[];
};
layout(std430, binding = B_FACES) buffer Faces {
    dvec4 faces[];
};
layout(std430, binding = B_SCREEN_FACES) readonly buffer ScreenFaces { dvec2 screenFaces[]; };
layout(std430, binding = B_BED_SOLID) readonly buffer BedSolid { int64_t bedSolid[]; };
layout(std430, binding = B_COHERENT_SOLID) readonly buffer CoherentSolid { int64_t coherentSolid[]; };
layout(std430, binding = B_EXTERIOR_MASKS) readonly buffer ExteriorMasks { uint exteriorMasks[]; };
layout(std430, binding = B_WALL_GEOMETRY) buffer WallGeometry {
    double wallGeometry[];
};
layout(std430, binding = B_ERRORS) buffer Errors {
    uint errors;
};
layout(std430, binding = B_FLUX_PREFERENCES) buffer FluxPreferences {
    dvec2 faceFlux[];
};
float sampleCellFill(int cell, float fallback) {
    return cell >= 0 && cells[cell][CELL_PORE_VOLUME] > 0 ? float(cells[cell][CELL_FILL]) : fallback;
}
void prepareCellTotals(int cell) {
    double liquidVolume = 0;
    int64_t massUnits = 0;
    const int64_t maximumMass = int64_t(0x7fffffffffffffffUL);
    for (int j = offsets[cell]; j < offsets[cell + 1]; j++) {
        liquidVolume += volumes[j];
        if (masses[j] < int64_t(0) || massUnits > maximumMass - masses[j])
            atomicOr(errors, ERROR_LIQUID_GEOMETRY);
        else
            massUnits += masses[j];
    }
    double poreVolume = double(bitCount((~masks[cell]) & 255u)) * .125 - double(occupied[cell]) / SOLID_VOLUME_UNITS_PER_CELL;
    if (liquidVolume < 0 || poreVolume < 0 || massUnits < int64_t(0))
        atomicOr(errors, ERROR_LIQUID_GEOMETRY);
    cells[cell] = dvec4(liquidVolume, double(massUnits) * MASS_UNIT_KG, poreVolume, poreVolume > 0 ? clamp(liquidVolume / poreVolume, 0.0, 1.0) : 0);
}
// Fixed microbox faces share the PLIC used for liquid transport. Each normal/side
// stores wet area and the sum of area divided by effective wall distance, in cell units.
bool solidMicro(int cell, int bit, int axis, int side) {
    int coordinate = (bit >> axis) & 1;
    int neighbor = coordinate == side ? gridNeighbor(cell, 2*axis+side) : cell;
    if (neighbor >= 0) return (masks[neighbor] & (1u << (bit ^ (1 << axis)))) != 0u;
    int a=axis==0?1:0,b=axis==2?1:2,port=((bit>>a)&1)+2*((bit>>b)&1);
    return pc.sealedExterior != 0 || (exteriorMasks[cell] & (1u << (4*(2*axis+side)+port))) != 0u;
}
void prepareWetWalls(int cell, uint support, double porosity, dvec4 plane) {
    for (int face = 0; face < 6; face++) {
        wallGeometry[12 * cell + 2 * face] = 0.0;
        wallGeometry[12 * cell + 2 * face + 1] = 0.0;
    }
    if (cells[cell][CELL_LIQUID_VOLUME] <= 0.0 || support == 0u)
        return;
    bool hasWall = support != 255u;
    if (!hasWall) for (int axis = 0; axis < 3; axis++) for (int side = 0; side < 2; side++) {
        int neighbor = gridNeighbor(cell, 2*axis+side);
        uint low = axis == 0 ? 0x55u : axis == 1 ? 0x33u : 0x0fu;
        uint face = side == 1 ? low : (low ^ 255u);
        if (neighbor >= 0 ? (masks[neighbor] & face) != 0u
                          : pc.sealedExterior != 0 || ((exteriorMasks[cell] >> (4*(2*axis+side))) & 15u) != 0u) hasWall = true;
    }
    if (!hasWall) return;
    bool full = cells[cell][CELL_LIQUID_VOLUME] >= cells[cell][CELL_PORE_VOLUME];
    for (int bit = 0; bit < 8; bit++) {
        if ((support & (1u << bit)) == 0u)
            continue;
        double volume = microVolume[8 * cell + bit];
        if (volume <= 0.0)
            continue;
        ivec3 local = ivec3(bit & 1, (bit >> 1) & 1, (bit >> 2) & 1);
        for (int axis = 0; axis < 3; axis++) {
            int a = (axis + 1) % 3, b = (axis + 2) % 3;
            for (int side = 0; side < 2; side++) {
                if (!solidMicro(cell, bit, axis, side))
                    continue;
                double coordinate = .5LF * double(local[axis] + side);
                int tangentBits = (local[a] << a) | (local[b] << b);
                double area = (full ? .25LF : plicWetPort(plane, axis, coordinate, tangentBits)) * porosity;
                if (area <= 0.0)
                    continue;
                // Extend the column away from the wall through the other open microbox.
                // Its area-equivalent liquid depth preserves the thin-film limit.
                double columnVolume = volume, columnLength = .5LF;
                int away = local[axis] + (side == 0 ? 1 : -1);
                if (away >= 0 && away < 2) {
                    int nextBit = bit ^ (1 << axis);
                    if ((support & (1u << nextBit)) != 0u) {
                        columnVolume += microVolume[8 * cell + nextBit];
                        columnLength = 1.0LF;
                    }
                }
                double distance = min(columnLength, columnVolume / (2.0LF * area));
                int face = 2 * axis + side, offset = 12 * cell + 2 * face;
                wallGeometry[offset] += area;
                wallGeometry[offset + 1] += area / distance;
            }
        }
    }
}
void reconstructInterface(int cell) {
    uint support = (~masks[cell]) & 255u;
    double fill = cells[cell][CELL_FILL], pore = cells[cell][CELL_PORE_VOLUME];
    double geometricCapacity = double(bitCount(support)) * .125LF;
    double porosity = geometricCapacity > 0.0 ? pore / geometricCapacity : 0.0;
    int axis = 1;
    double sign = 1.0, cut = fill <= 0.0 ? 0.0 : 1.0;
    if (fill > 0.0 && fill < 1.0 && support != 0u) {
        vec3 gradient;
        for (int a = 0; a < 3; a++) {
            int lower = gridNeighbor(cell,2*a), upper = gridNeighbor(cell,2*a+1);
            float lowerFill = sampleCellFill(lower, float(fill));
            float upperFill = sampleCellFill(upper, float(fill));
            if (lower < 0) lowerFill = upperFill;
            if (upper < 0) upperFill = lowerFill;
            gradient[a] = -(upperFill - lowerFill);
        }
        if (abs(gradient.x) > abs(gradient.y)) axis = 0;
        if (abs(gradient.z) > abs(gradient[axis])) axis = 2;
        sign = gradient[axis] < 0.0 ? -1.0 : 1.0;
        uint lowBits = axis == 0 ? 0x55u : axis == 1 ? 0x33u : 0x0fu;
        uint firstBits = sign > 0.0 ? lowBits : (lowBits ^ 255u);
        int first = bitCount(support & firstBits), second = bitCount(support & (firstBits ^ 255u));
        double target = fill * geometricCapacity, firstVolume = double(first) * .125LF;
        double depth = target <= firstVolume && first > 0
            ? target / (.25LF * double(first))
            : .5LF + (second > 0 ? (target - firstVolume) / (.25LF * double(second)) : 0.0LF);
        cut = sign > 0.0 ? depth : 1.0LF - depth;
    }
    dvec3 normal = dvec3(0.0); normal[axis] = sign;
    planes[cell] = dvec4(normal, sign * cut);
    for (int bit = 0; bit < 8; bit++) {
        double amount = 0.0;
        if ((support & (1u << bit)) != 0u) {
            double origin = .5LF * double((bit >> axis) & 1);
            double depth = sign > 0.0 ? clamp(cut - origin, 0.0LF, .5LF)
                                      : clamp(origin + .5LF - cut, 0.0LF, .5LF);
            amount = .25LF * depth * porosity;
        }
        microVolume[8 * cell + bit] = amount;
    }
    prepareWetWalls(cell, support, porosity, planes[cell]);
}
double portArea(double fill, dvec4 plane, int axis, int side, int firstPort, int secondPort) {
    if (fill <= 0)
        return 0;
    if (fill >= 1)
        return .25;
    int firstTangent = (axis + 1) % 3, secondTangent = (axis + 2) % 3;
    int bit = (firstPort << firstTangent) | (secondPort << secondTangent);
    return plicWetPort(plane, axis, double(side), bit);
}
void faceGeometry(int face) {
    ivec3 endpoints=gridFaceEndpoints(face);
    int leftCell=endpoints.x, rightCell=endpoints.y, axis=endpoints.z, localFace=face-gridFaceOffset(axis);
    if (leftCell < 0 || rightCell < 0) {
        bool interiorRight = rightCell >= 0;
        int cell = interiorRight ? rightCell : leftCell;
        double endpointMass = cells[cell][CELL_MASS];
        if (pc.sealedExterior != 0 || cells[cell][CELL_PORE_VOLUME] <= 0.0) {
            faces[face] = dvec4(.5 * endpointMass, 0, 0, 0);
            return;
        }
        int firstTangent = (axis + 1) % 3, secondTangent = (axis + 2) % 3;
        int side = interiorRight ? 0 : 1;
        double openArea = 0.0, wetArea = 0.0;
        for (int a = 0; a < 2; a++) for (int b = 0; b < 2; b++) {
            int bit = (side << axis) | (a << firstTangent) | (b << secondTangent);
            int first=axis==0?1:0,second=axis==2?1:2;
            int port=((bit>>first)&1)+2*((bit>>second)&1);
            if ((masks[cell] & (1u << bit)) == 0u &&
                (exteriorMasks[cell] & (1u << (4*(2*axis+side)+port))) == 0u) {
                openArea += .25;
                wetArea += portArea(cells[cell][CELL_FILL], planes[cell], axis, side, a, b);
            }
        }
        openArea = max(0.0LF, openArea - wetArea);
        double mass = .5 * (endpointMass + double(pc.ambientCellMass));
        double momentum = axis == 0 ? momentumX[localFace] : axis == 1 ? momentumY[localFace] : momentumZ[localFace];
        faces[face] = dvec4(mass, openArea > 0.0 && mass > 0.0 ? momentum / mass : 0.0, openArea, 0.0LF);
        return;
    }
    int firstTangent = (axis + 1) % 3, secondTangent = (axis + 2) % 3;
    uint leftMask=masks[leftCell]&255u,rightMask=masks[rightCell]&255u,ports=0u;
    if(leftMask==0u && rightMask==0u)ports=15u;
    else if(leftMask!=255u && rightMask!=255u){
        for(int a=0;a<2;a++)for(int b=0;b<2;b++){
            int bit=(a<<firstTangent)|(b<<secondTangent);
            if(plicOpenPort((~leftMask)&255u,(~rightMask)&255u,bit|(1<<axis),bit))
                ports|=1u<<uint(a+2*b);
        }
    }
    double openArea=.25LF*double(bitCount(ports)),wetArea=0.0LF;
    if(ports!=0u){
        double leftFill=cells[leftCell][CELL_FILL],rightFill=cells[rightCell][CELL_FILL];
        if(cells[leftCell][CELL_LIQUID_VOLUME]<cells[leftCell][CELL_PORE_VOLUME])
            leftFill=min(leftFill,.9999999999999999LF);
        if(cells[rightCell][CELL_LIQUID_VOLUME]<cells[rightCell][CELL_PORE_VOLUME])
            rightFill=min(rightFill,.9999999999999999LF);
        dvec2 lo=dvec2(0.0LF),hi=dvec2(1.0LF);
        bool dry=leftFill<1.0LF && rightFill<1.0LF;
        if(dry && leftFill>0.0LF)dry=plicPortRect(planes[leftCell],axis,1.0LF,0,false,lo,hi);
        if(dry && rightFill>0.0LF)dry=plicPortRect(planes[rightCell],axis,0.0LF,0,false,lo,hi);
        double dryArea=0.0LF;
        if(dry){
            if(ports==15u)dryArea=(hi.x-lo.x)*(hi.y-lo.y);
            else for(int a=0;a<2;a++)for(int b=0;b<2;b++)if((ports&(1u<<uint(a+2*b)))!=0u){
                dvec2 lower=.5LF*dvec2(a,b),upper=lower+dvec2(.5LF);
                dvec2 size=max(dvec2(0.0LF),min(hi,upper)-max(lo,lower));
                dryArea+=size.x*size.y;
            }
        }
        wetArea=openArea-dryArea;
    }
    if (screenFaces[face].x > 0.0) {
        double deposited = double(max(int64_t(0), bedSolid[leftCell] - coherentSolid[leftCell])
                + max(int64_t(0), bedSolid[rightCell] - coherentSolid[rightCell])) / SOLID_VOLUME_UNITS_PER_CELL;
        double openCapacity = .5LF * double(bitCount((~masks[leftCell]) & 255u) + bitCount((~masks[rightCell]) & 255u)) / 8.0LF;
        double remaining = openCapacity > 0.0LF ? max(.01, 1.0 - deposited / (.6LF * openCapacity)) : .01LF;
        double factor = screenFaces[face].y * remaining * remaining;
        openArea *= factor;
        wetArea *= factor;
    }
    double mass = .5 * (cells[leftCell][CELL_MASS] + cells[rightCell][CELL_MASS]), velocity = openArea > 0 && mass > 0 ? (axis == 0   ? momentumX[localFace]
                                                                                  : axis == 1 ? momentumY[localFace]
                                                                                              : momentumZ[localFace]) /
                                                                                     mass
                                                                               : 0;
    faces[face] = dvec4(mass, velocity, openArea, wetArea);
}

// Signed swept volume through the donor's open microboxes and its axis-aligned liquid plane.
void transportPreference(int face) {
    faceFlux[face] = dvec2(0);
    ivec3 endpoints=gridFaceEndpoints(face);
    int leftCell=endpoints.x, rightCell=endpoints.y, axis=endpoints.z;
    if (leftCell < 0 || rightCell < 0) return;
    double faceSpeed=faces[face][FACE_VELOCITY],openArea=faces[face][FACE_OPEN_AREA];
    double depth=min(1.0LF,abs(faceSpeed)*double(pc.dt)/double(pc.h));
    if (depth == 0.0 || openArea <= 0.0)
        return;
    int firstTangent = (axis + 1) % 3, secondTangent = (axis + 2) % 3, openPorts = 0;
    for (int port = 0; port < 4; port++) {
        int bit = ((port & 1) << firstTangent) | ((port >> 1) << secondTangent);
        if (plicOpenPort((~masks[leftCell]) & 255u, (~masks[rightCell]) & 255u, bit | (1 << axis), bit))
            openPorts |= 1 << port;
    }
    if (openPorts == 0)
        return;
    bool positive = faceSpeed > 0.0;
    int source = positive ? leftCell : rightCell;
    double low=positive?1.0LF-depth:0.0LF,high=positive?1.0LF:depth,openVolume=0.0LF,liquidVolume=0.0LF;
    dvec4 plane=planes[source];uint support=(~masks[source])&255u;
    for(int port=0;port<4;port++)if((openPorts&(1<<port))!=0){
        int tangentBits=((port&1)<<firstTangent)|((port>>1)<<secondTangent);
        for(int layer=0;layer<2;layer++){
            int bit=tangentBits|(layer<<axis);if((support&(1u<<bit))==0u)continue;
            double a=max(low,.5LF*double(layer)),b=min(high,.5LF*double(layer+1));if(b<=a)continue;
            openVolume+=.25LF*(b-a);
            if(cells[source][CELL_FILL]>=1.0LF){liquidVolume+=.25LF*(b-a);continue;}
            if(cells[source][CELL_FILL]<=0.0LF)continue;
            if(abs(plane[axis])>.5LF){
                double cut=plane.w*plane[axis];
                double wetDepth=plane[axis]>0.0LF?max(0.0LF,min(b,cut)-a):max(0.0LF,b-max(a,cut));
                liquidVolume+=.25LF*wetDepth;
            }else liquidVolume+=plicWetPort(plane,axis,.5LF*(a+b),tangentBits)*(b-a);
        }
    }
    double geometricArea=.25LF*double(bitCount(openPorts)),factor=openArea/geometricArea;
    double sign=positive?1.0LF:-1.0LF,totalFlux=sign*openVolume*factor,liquidFlux=sign*liquidVolume*factor;
    faceFlux[face]=dvec2(totalFlux,liquidFlux);
}

// Face mass and openings belong to the completed geometry; MAC momentum is current.
void refreshVelocity(int face) {
    int axis=gridFaceEndpoints(face).z,local=face-gridFaceOffset(axis);
    double mass = faces[face][FACE_MASS];
    faces[face][FACE_VELOCITY] = faces[face][FACE_OPEN_AREA] > 0.0 && mass > 0.0 ? (axis == 0   ? momentumX[local]
                                                                     : axis == 1 ? momentumY[local]
                                                                                 : momentumZ[local]) /
                                                                        mass
                                                                  : 0.0;
}

void main() {
    if (errors != 0u)
        return;
    int i = int(gl_GlobalInvocationID.x);
    int count = gridCells();
    if (pc.stage == STAGE_CELL_TOTALS) {
        if (i < count)
            prepareCellTotals(i);
    } else if (pc.stage == STAGE_RECONSTRUCT_INTERFACE) {
        if (i < count)
            reconstructInterface(i);
    } else {
        int countFaces = gridFaces();
        if (i < countFaces) {
            if (pc.stage == STAGE_FACE_GEOMETRY)
                faceGeometry(i);
            else if (pc.stage == STAGE_REFRESH_VELOCITY)
                refreshVelocity(i);
            else
                transportPreference(i);
        }
    }
}
