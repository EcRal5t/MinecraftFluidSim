#version 450
#extension GL_ARB_gpu_shader_fp64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
layout(local_size_x = 128) in;
layout(binding = 0, std430) buffer Candidate {
    uint words[];
};
layout(binding = 1, std430) buffer Errors {
    uint errors;
};
layout(push_constant) uniform Params {
    int header;
    int stage;
    int count;
    int workEnergy;
    int workTemperature;
}
p;
// HOST_LAYOUT
const int ROUTE_COUNT = 0;
const int ROUTE_SOURCES = 1;
const int ROUTE_TARGETS = 2;
const int ROUTE_WEIGHTS = 3;
const int ROUTE_SOURCE_OFFSETS = 4;
const int ROUTE_SOURCE_ROUTES = 5;
const int ROUTE_TARGET_OFFSETS = 6;
const int ROUTE_TARGET_ROUTES = 7;
const int ROUTE_AMBIENT_VOLUMES = 8;
const int ROUTE_FUTURE_COUNT = 9;
const int DISPATCH_LONG_ROW_COUNTS = 24;
const int LONG_RETAINED_ROWS = 0;
const int LONG_FUTURE_ROWS = 1;
const int LONG_SOURCE_ROWS = 2;
const int REQUIREMENT_FUTURE_NODE_COUNT = 6;
const int REQUIREMENT_GROUP_COUNT = 7;
const int REQUIREMENT_READY = 8;
const int SHORT_ROW_STAGE_OFFSET = 100;
const int STAGE_CLEAR_STEP = 0;
const int STAGE_PREPARE_PARTS = 1;
const int STAGE_SPLIT_SOURCE = 2;
const int STAGE_CAPTURE_AMBIENT = 3;
const int STAGE_RETAINED_GROUP_ENERGY = 4;
const int STAGE_RETAINED_CLOSE_SOURCE_ENERGY = 5;
const int STAGE_GATHER_RETAINED = 7;
const int STAGE_FUTURE_GROUP_ENERGY = 9;
const int STAGE_FUTURE_CLOSE_SOURCE_ENERGY = 10;
const int STAGE_GATHER_FUTURE = 12;
const int STAGE_FUTURE_TOPOLOGY = 15;
const int STAGE_PREPARE_DISPATCH = 18;
const int STAGE_MEASURE_TOTAL = 22;
const int STAGE_RETAINED_VOLUMES = 23;
const int STAGE_TRANSPORT_ENERGY = 24;
const int STAGE_CLASSIFY_ROWS = 25;
const int STAGE_LONG_ROW_DISPATCH = 26;
const int STAGE_SNAPSHOT_ROUNDOFF = 27;
const uint ERROR_INVALID_STATE = 131072u;

const uint64_t LIMIT = uint64_t(0x7fffffffffffffffUL), SCALE = uint64_t(0x10000000000000UL);
bool shortRow() {
    return p.stage >= SHORT_ROW_STAGE_OFFSET;
}
int rowStride() {
    return shortRow() ? 1 : 128;
}
void rowBarrier() {
    if (!shortRow())
        barrier();
}
int headerWord(int i) {
    return int(words[p.header + i]);
}
int workField(int i) {
    return headerWord(WORK_FIELDS + i);
}
int sourceGasField(int i) {
    return headerWord(SOURCE_GAS_FIELDS + i);
}
int destinationGasField(int i, bool future) {
    return headerWord((future ? FUTURE_GAS_FIELDS : RETAINED_GAS_FIELDS) + i);
}
int routeField(int i) {
    return headerWord(ROUTE_FIELDS + i);
}
int sourceEosWord(int i) {
    return int(words[headerWord(H_SOURCE_EOS) + i]);
}
uint64_t readUint64(int at) {
    return uint64_t(words[at]) | (uint64_t(words[at + 1]) << 32);
}
int64_t readInt64(int at) {
    return int64_t(readUint64(at));
}
void writeUint64(int at, uint64_t value) {
    words[at] = uint(value);
    words[at + 1] = uint(value >> 32);
}
double readDouble(int at) {
    return packDouble2x32(uvec2(words[at], words[at + 1]));
}
void writeDouble(int at, double v) {
    uvec2 b = unpackDouble2x32(v);
    words[at] = b.x;
    words[at + 1] = b.y;
}
bool isFinite(double v) {
    return !isnan(v) && !isinf(v);
}
void reportInvalid() {
    atomicOr(errors, ERROR_INVALID_STATE);
}
uint64_t plus(uint64_t a, uint64_t b) {
    if (b > LIMIT - a) {
        reportInvalid();
        return a;
    }
    return a + b;
}
int64_t signedPlus(int64_t a, int64_t b) {
    int64_t maximum = int64_t(LIMIT), minimum = -maximum - int64_t(1);
    if ((b > int64_t(0) && a > maximum - b) || (b < int64_t(0) && a < minimum - b)) {
        reportInvalid();
        return a;
    }
    return a + b;
}
void twoSum(double a, double b, out double sum, out double error) {
    precise double s = a + b, back = s - a;
    precise double e = (a - (s - back)) + (b - back);
    sum = s;
    error = e;
}
void product(uint64_t a, uint64_t b, out uint64_t hi, out uint64_t lo) {
    uint64_t x = uint64_t(uint(a)) * uint(b), y = (a >> 32) * uint(b), z = uint64_t(uint(a)) * (b >> 32);
    uint64_t mid = (x >> 32) + uint(y) + uint(z);
    lo = (mid << 32) | uint(x);
    hi = (a >> 32) * (b >> 32) + (y >> 32) + (z >> 32) + (mid >> 32);
}
// Divide one radix-2^32 digit. The floating estimate spans only 32 bits;
// exact wide-product correction determines the final quotient and remainder.
uint64_t divideDigit(uint64_t remainder, uint digit, uint64_t d, out uint64_t next) {
    uint64_t hi = remainder >> 32, lo = (remainder << 32) | uint64_t(digit);
    double estimate = (double(remainder) * 4294967296.0LF + double(digit)) / double(d);
    uint64_t q = uint64_t(clamp(floor(estimate), 0.0LF, 4294967295.0LF)), ph, pl;
    product(q, d, ph, pl);
    while (ph > hi || (ph == hi && pl > lo)) {
        q--;
        uint64_t before = pl;
        pl -= d;
        if (before < d)
            ph--;
    }
    uint64_t rest = lo - pl, restHi = hi - ph - (lo < pl ? uint64_t(1) : uint64_t(0));
    while (restHi != uint64_t(0) || rest >= d) {
        uint64_t before = rest;
        rest -= d;
        if (before < d)
            restHi--;
        q++;
    }
    next = rest;
    return q;
}
uint64_t divide(uint64_t a, uint64_t b, uint64_t d, out uint64_t remainder) {
    if (d == uint64_t(0)) {
        reportInvalid();
        remainder = uint64_t(0);
        return uint64_t(0);
    }
    uint64_t hi, lo;
    product(a, b, hi, lo);
    if (hi == uint64_t(0)) {
        remainder = lo % d;
        return lo / d;
    }
    if (hi >= d) {
        reportInvalid();
        remainder = uint64_t(0);
        return uint64_t(0);
    }
    if (d == SCALE) {
        remainder = lo & (SCALE - uint64_t(1));
        return (hi << 12) | (lo >> 52);
    }
    uint64_t middle, qHi = divideDigit(hi, uint(lo >> 32), d, middle),
                     qLo = divideDigit(middle, uint(lo), d, remainder);
    return (qHi << 32) | qLo;
}
uint64_t portion(uint64_t amount, uint64_t n, uint64_t total) {
    uint64_t remainder;
    return divide(amount, n, total, remainder);
}
int64_t signedPortion(int64_t amount, uint64_t n, uint64_t total) {
    bool negative = amount < int64_t(0);
    uint64_t magnitude = negative ? uint64_t(0) - uint64_t(amount) : uint64_t(amount);
    uint64_t result = portion(magnitude, n, total);
    return negative ? int64_t(uint64_t(0) - result) : int64_t(result);
}
int materials() {
    return headerWord(H_COMPONENT_COUNT);
}
int speciesStride() {
    return headerWord(H_SPECIES_STRIDE);
}
int declaredBegin(int handle) {
    return int(words[workField(FIELD_DECLARED_SPECIES_OFFSETS) + handle]);
}
int declaredEnd(int handle) {
    return int(words[workField(FIELD_DECLARED_SPECIES_OFFSETS) + handle + 1]);
}
int groups() {
    return int(words[routeField(ROUTE_COUNT)]);
}
int source(int g) {
    return int(words[routeField(ROUTE_SOURCES) + g]);
}
int target(int g) {
    return int(words[routeField(ROUTE_TARGETS) + g]);
}
int nodeCount() {
    return int(words[sourceGasField(GAS_COUNTS)]);
}
int futureCount() {
    return int(words[routeField(ROUTE_FUTURE_COUNT)]);
}
int sourceBegin(int node) {
    return int(words[routeField(ROUTE_SOURCE_OFFSETS) + node + 2]);
}
int sourceEnd(int node) {
    return int(words[routeField(ROUTE_SOURCE_OFFSETS) + node + 3]);
}
int sourceGroup(int at) {
    return int(words[routeField(ROUTE_SOURCE_ROUTES) + at]);
}
int partBegin(int g) {
    return g * materials();
}
int partEnd(int g) {
    return (g + 1) * materials();
}
void clearStep(int id) {
    if (id < headerWord(H_ROUTE_CAPACITY)) {
        writeDouble(workField(FIELD_GROUP_ENERGY) + 2 * id, 0.0);
        writeDouble(workField(FIELD_ENERGY_ROUNDOFF) + 4 * id, 0.0);
        writeDouble(workField(FIELD_ENERGY_ROUNDOFF) + 4 * id + 2, 0.0);
        writeDouble(workField(FIELD_MERGE_ROUNDOFF) + 4 * id, 0.0);
        writeDouble(workField(FIELD_MERGE_ROUNDOFF) + 4 * id + 2, 0.0);
    }
    if (id < headerWord(H_FUTURE_NODE_CAPACITY))
        writeDouble(destinationGasField(GAS_INTERNAL_ENERGY, true) + 2 * id, 0.0);
    if (id < headerWord(H_RETAINED_NODE_CAPACITY))
        writeDouble(destinationGasField(GAS_INTERNAL_ENERGY, false) + 2 * id, 0.0);
    if (id < headerWord(H_RETAINED_NODE_CAPACITY)) {
        words[workField(FIELD_SOURCE_PIVOT) + id] = uint(-1);
        words[workField(FIELD_ESCAPE_GROUP) + id] = uint(-1);
        writeDouble(workField(FIELD_SOURCE_ROUNDOFF) + 4 * id, 0.0);
        writeDouble(workField(FIELD_SOURCE_ROUNDOFF) + 4 * id + 2, 0.0);
        writeDouble(workField(FIELD_RETAINED_ROUNDOFF) + 4 * id, 0.0);
        writeDouble(workField(FIELD_RETAINED_ROUNDOFF) + 4 * id + 2, 0.0);
    }
    if (id == 0) {
        writeDouble(workField(FIELD_AUDIT_ENERGY), 0.0);
        writeDouble(workField(FIELD_AUDIT_ENERGY) + 2, 0.0);
    }
}
void prepareParts(int g) {
    if (g >= groups())
        return;
    words[workField(FIELD_PART_OFFSETS) + g] = uint(partBegin(g));
    if (g == groups() - 1)
        words[workField(FIELD_PART_OFFSETS) + groups()] = uint(partEnd(g));
    for (int handle = 0; handle < materials(); handle++) {
        int part = partBegin(g) + handle, begin = g * speciesStride() + declaredBegin(handle),
            end = g * speciesStride() + declaredEnd(handle);
        words[workField(FIELD_PART_HANDLES) + part] = uint(handle);
        words[workField(FIELD_SPECIES_OFFSETS) + part] = uint(begin);
        writeUint64(workField(FIELD_PART_NANOS) + 2 * part, uint64_t(0));
        writeUint64(workField(FIELD_PART_MASS) + 2 * part, uint64_t(0));
        writeUint64(workField(FIELD_PART_RESIDUAL) + 2 * part, uint64_t(0));
        for (int e = begin; e < end; e++) {
            words[workField(FIELD_SPECIES_HANDLES) + e] = words[workField(FIELD_DECLARED_SPECIES_HANDLES) + e - g * speciesStride()];
            writeUint64(workField(FIELD_SPECIES_AMOUNTS) + 2 * e, uint64_t(0));
        }
    }
    if (g == groups() - 1)
        words[workField(FIELD_SPECIES_OFFSETS) + partEnd(g)] = uint(groups() * speciesStride());
}
int ambientSpeciesSlot(int part, int species) {
    int handle = part % materials(), begin = declaredBegin(handle), end = declaredEnd(handle);
    for (int e = begin; e < end; e++)
        if (int(words[workField(FIELD_DECLARED_SPECIES_HANDLES) + e]) == species)
            return (part / materials()) * speciesStride() + e;
    reportInvalid();
    return (part / materials()) * speciesStride() + begin;
}
void splitSource(int node) {
    if (node >= nodeCount())
        return;
    int begin = sourceBegin(node), end = sourceEnd(node), pivot = -1;
    double total = 0.0, largest = -1.0;
    for (int at = begin; at < end; at++) {
        int g = sourceGroup(at);
        double v = readDouble(routeField(ROUTE_WEIGHTS) + 2 * g);
        total += v;
        if (v > largest) {
            largest = v;
            pivot = g;
        }
        if (target(g) == 0)
            words[workField(FIELD_ESCAPE_GROUP) + node] = uint(g);
    }
    words[workField(FIELD_SOURCE_PIVOT) + node] = uint(pivot);
    if (pivot < 0)
        return;
    uint64_t assigned = uint64_t(0);
    for (int at = begin; at < end; at++) {
        int g = sourceGroup(at);
        if (g == pivot)
            continue;
        uint64_t weight = max(uint64_t(1), uint64_t(readDouble(routeField(ROUTE_WEIGHTS) + 2 * g) / total * double(SCALE)));
        assigned = plus(assigned, weight);
        writeUint64(workField(FIELD_WEIGHTS) + 2 * g, weight);
    }
    if (assigned >= SCALE) {
        reportInvalid();
        return;
    }
    writeUint64(workField(FIELD_WEIGHTS) + 2 * pivot, SCALE - assigned);
    int first = int(words[sourceGasField(GAS_ROW_COMPONENT_OFFSETS) + node]),
        last = int(words[sourceGasField(GAS_ROW_COMPONENT_OFFSETS) + node + 1]);
    for (int c = first; c < last; c++) {
        if (readUint64(sourceGasField(GAS_STANDARD_VOLUME_NANOS) + 2 * c) == uint64_t(0))
            continue;
        int local = c - first;
        uint64_t nanos = readUint64(sourceGasField(GAS_STANDARD_VOLUME_NANOS) + 2 * c), mass = readUint64(sourceGasField(GAS_MASS_UNITS) + 2 * c),
                 usedN = uint64_t(0), usedM = uint64_t(0);
        int64_t residual = readInt64(sourceGasField(GAS_MASS_RESIDUAL_UNITS) + 2 * c), usedR = int64_t(0);
        for (int at = begin; at < end; at++) {
            int g = sourceGroup(at);
            if (g == pivot)
                continue;
            int part = partBegin(g) + local;
            uint64_t allocatedNanos = portion(nanos, readUint64(workField(FIELD_WEIGHTS) + 2 * g), SCALE), allocatedMass = portion(mass, allocatedNanos, nanos);
            if (allocatedMass == uint64_t(0))
                allocatedNanos = uint64_t(0);
            int64_t allocatedResidual = allocatedNanos == uint64_t(0) ? int64_t(0) : signedPortion(residual, allocatedNanos, nanos);
            usedN = plus(usedN, allocatedNanos);
            usedM = plus(usedM, allocatedMass);
            usedR = signedPlus(usedR, allocatedResidual);
            writeUint64(workField(FIELD_PART_NANOS) + 2 * part, allocatedNanos);
            writeUint64(workField(FIELD_PART_MASS) + 2 * part, allocatedMass);
            writeUint64(workField(FIELD_PART_RESIDUAL) + 2 * part, uint64_t(allocatedResidual));
        }
        int owner = partBegin(pivot) + local;
        writeUint64(workField(FIELD_PART_NANOS) + 2 * owner, nanos - usedN);
        writeUint64(workField(FIELD_PART_MASS) + 2 * owner, mass - usedM);
        writeUint64(workField(FIELD_PART_RESIDUAL) + 2 * owner, uint64_t(residual - usedR));
        int sb = int(words[sourceGasField(GAS_COMPONENT_SPECIES_OFFSETS) + c]),
            se = int(words[sourceGasField(GAS_COMPONENT_SPECIES_OFFSETS) + c + 1]);
        for (int s = sb; s < se; s++) {
            uint64_t amount = readUint64(sourceGasField(GAS_SPECIES_AMOUNTS) + 2 * s), used = uint64_t(0);
            for (int at = begin; at < end; at++) {
                int g = sourceGroup(at), part = partBegin(g) + local,
                    entry = int(words[workField(FIELD_SPECIES_OFFSETS) + part]) + s - sb;
                words[workField(FIELD_SPECIES_HANDLES) + entry] = words[sourceGasField(GAS_SPECIES_HANDLES) + s];
                if (g == pivot)
                    continue;
                uint64_t quantity = portion(amount, readUint64(workField(FIELD_PART_NANOS) + 2 * part), nanos);
                used = plus(used, quantity);
                writeUint64(workField(FIELD_SPECIES_AMOUNTS) + 2 * entry, quantity);
            }
            writeUint64(workField(FIELD_SPECIES_AMOUNTS) + 2 * (int(words[workField(FIELD_SPECIES_OFFSETS) + owner]) + s - sb),
                  amount - used);
        }
    }
}

bool productGreater(uint64_t a, uint64_t b, uint64_t c, uint64_t d) {
    uint64_t ah, al, ch, cl;
    product(a, b, ah, al);
    product(c, d, ch, cl);
    return ah > ch || (ah == ch && al > cl);
}
void ambientShares(uint64_t total, int outputField) {
    uint64_t assigned = uint64_t(0), den = readUint64(p.header + H_AMBIENT_TOTAL_WEIGHT);
    for (int c = 0; c < headerWord(H_AMBIENT_COUNT); c++) {
        uint64_t n = portion(total, readUint64(workField(FIELD_AMBIENT_WEIGHTS) + 2 * c), den);
        writeUint64(workField(outputField) + 2 * c, n);
        assigned = plus(assigned, n);
    }
    while (assigned < total) {
        int best = 0;
        for (int c = 1; c < headerWord(H_AMBIENT_COUNT); c++)
            if (productGreater(readUint64(workField(FIELD_AMBIENT_WEIGHTS) + 2 * c), readUint64(workField(outputField) + 2 * best) + uint64_t(1),
                               readUint64(workField(FIELD_AMBIENT_WEIGHTS) + 2 * best), readUint64(workField(outputField) + 2 * c) + uint64_t(1)))
                best = c;
        writeUint64(workField(outputField) + 2 * best, readUint64(workField(outputField) + 2 * best) + uint64_t(1));
        assigned++;
    }
}
uint64_t sourceMass(uint64_t nanos, int c) {
    uint64_t rem, den = readUint64(workField(FIELD_AMBIENT_MASS_DEN) + 2 * c),
                  value = divide(nanos, readUint64(workField(FIELD_AMBIENT_MASS_NUM) + 2 * c), den, rem);
    if (rem > den - rem || (rem == den - rem && (value & uint64_t(1)) != uint64_t(0)))
        value++;
    if (value > LIMIT)
        reportInvalid();
    return value;
}
void captureAmbient() {
    int oldNodes = nodeCount(), a = int(words[sourceGasField(GAS_ROW_COMPONENT_OFFSETS) + oldNodes]),
        b = int(words[sourceGasField(GAS_ROW_COMPONENT_OFFSETS) + oldNodes + 1]);
    uint64_t cumulative = uint64_t(0);
    for (int c = a; c < b; c++)
        cumulative = plus(cumulative, readUint64(sourceGasField(GAS_STANDARD_VOLUME_NANOS) + 2 * c));
    int begin = int(words[routeField(ROUTE_SOURCE_OFFSETS) + 1]), end = int(words[routeField(ROUTE_SOURCE_OFFSETS) + 2]);
    for (int at = begin; at < end; at++) {
        int g = int(words[routeField(ROUTE_SOURCE_ROUTES) + at]);
        if (target(g) == 0)
            continue;
        double requested = readDouble(routeField(ROUTE_AMBIENT_VOLUMES) + 2 * g) * 1e9LF * 293.15LF / readDouble(p.header + H_AMBIENT_TEMPERATURE);
        if (!(isFinite(requested) && requested >= 0.0 && requested < double(LIMIT - cumulative))) {
            reportInvalid();
            return;
        }
        uint64_t n = uint64_t(floor(requested + 0.5LF));
        ambientShares(cumulative, FIELD_AMBIENT_BEFORE);
        ambientShares(cumulative + n, FIELD_AMBIENT_AFTER);
        for (int c = 0; c < headerWord(H_AMBIENT_COUNT); c++) {
            int part = partBegin(g) + int(words[workField(FIELD_AMBIENT_HANDLES) + c]);
            uint64_t before = readUint64(workField(FIELD_AMBIENT_BEFORE) + 2 * c), after = readUint64(workField(FIELD_AMBIENT_AFTER) + 2 * c),
                     nanos = after - before, mass = sourceMass(after, c) - sourceMass(before, c),
                     chemical = uint64_t(0);
            writeUint64(workField(FIELD_PART_NANOS) + 2 * part, nanos);
            writeUint64(workField(FIELD_PART_MASS) + 2 * part, mass);
            int sb = int(words[workField(FIELD_AMBIENT_SPECIES_OFFSETS) + c]),
                se = int(words[workField(FIELD_AMBIENT_SPECIES_OFFSETS) + c + 1]);
            for (int s = sb; s < se; s++) {
                int entry = ambientSpeciesSlot(part, int(words[workField(FIELD_AMBIENT_SPECIES_HANDLES) + s]));
                uint64_t numerator = readUint64(workField(FIELD_AMBIENT_SPECIES_NUM) + 2 * s),
                         den = readUint64(workField(FIELD_AMBIENT_SPECIES_DEN) + 2 * s),
                         q = portion(after, numerator, den) - portion(before, numerator, den);
                words[workField(FIELD_SPECIES_HANDLES) + entry] = words[workField(FIELD_AMBIENT_SPECIES_HANDLES) + s];
                writeUint64(workField(FIELD_SPECIES_AMOUNTS) + 2 * entry, q);
                uint64_t massUnit = readUint64(workField(FIELD_AMBIENT_SPECIES_MASS) + 2 * s);
                if (massUnit != uint64_t(0) && q > LIMIT / massUnit) {
                    reportInvalid();
                    return;
                }
                chemical = plus(chemical, q * massUnit);
            }
            if (nanos > uint64_t(0) && mass == uint64_t(0)) {
                reportInvalid();
                return;
            }
            if (nanos == uint64_t(0) && (mass != uint64_t(0) || chemical != uint64_t(0))) {
                reportInvalid();
                return;
            }
            writeUint64(workField(FIELD_PART_RESIDUAL) + 2 * part, uint64_t(int64_t(mass) - int64_t(chemical)));
        }
        cumulative += n;
    }
}
// Material energy and its derivative use the same uploaded caloric endpoints as the EOS.
void material(int handle, double temperature, out double energy, out double capacity) {
    int begin = int(words[sourceEosWord(GAS_H_SEGMENT_OFFSETS) + handle]),
        end = int(words[sourceEosWord(GAS_H_SEGMENT_OFFSETS) + handle + 1]);
    energy = readDouble(sourceEosWord(GAS_H_ANCHOR_ENERGY) + 2 * handle);
    capacity = 0.0;
    if (begin == end || !isFinite(energy)) {
        reportInvalid();
        return;
    }
    double current = readDouble(headerWord(H_SOURCE_EOS) + 32);
    bool heating = temperature >= current;
    while (current != temperature) {
        int segment = begin;
        while (segment + 1 < end && (heating ? current >= readDouble(sourceEosWord(GAS_H_SEGMENT_UPPER) + 2 * segment)
                                             : current > readDouble(sourceEosWord(GAS_H_SEGMENT_UPPER) + 2 * segment)))
            segment++;
        double bound = heating ? (segment + 1 < end ? readDouble(sourceEosWord(GAS_H_SEGMENT_UPPER) + 2 * segment) : temperature)
                               : (segment > begin ? readDouble(sourceEosWord(GAS_H_SEGMENT_UPPER) + 2 * (segment - 1)) : temperature);
        double next = heating ? min(temperature, bound) : max(temperature, bound);
        energy += (next - current) * readDouble(sourceEosWord(GAS_H_SEGMENT_CAPACITY) + 2 * segment);
        current = next;
    }
    int segment = begin;
    while (segment + 1 < end && temperature >= readDouble(sourceEosWord(GAS_H_SEGMENT_UPPER) + 2 * segment))
        segment++;
    capacity = readDouble(sourceEosWord(GAS_H_SEGMENT_CAPACITY) + 2 * segment);
}
void groupEnergy(int g, bool afterWork) {
    if (g >= groups())
        return;
    int s = source(g);
    if (s == 0 || s == 1 && target(g) == 0)
        return;
    if (afterWork && (s < 2 || target(g) == 0))
        return;
    double temperature = s == 1      ? readDouble(p.header + H_AMBIENT_TEMPERATURE)
                         : afterWork ? readDouble(p.workTemperature + 2 * (s - 2))
                                     : readDouble(sourceEosWord(GAS_H_STATES) + 18 * (s - 2));
    double energy = 0.0, capacity = 0.0;
    for (int part = partBegin(g); part < partEnd(g); part++) {
