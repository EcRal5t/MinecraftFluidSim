    double largest = 0.0;
    if (headerWord(H_TRANSPORT) != 0 && !afterWork) {
        int self = int(words[workField(FIELD_SOURCE_PIVOT) + node]);
        writeDouble(destinationGasField(GAS_INTERNAL_ENERGY, false) + 2 * node, self >= 0 ? readDouble(workField(FIELD_GROUP_ENERGY) + 2 * self) : 0.0);
        return;
    }
    for (int at = begin; at < end; at++) {
        int g = sourceGroup(at);
        if (afterWork && target(g) == 0)
            continue;
        double cv = readDouble(workField(FIELD_GROUP_CAPACITY) + 2 * g);
        if (cv > largest) {
            largest = cv;
            pivot = g;
        }
    }
    double energy = afterWork ? readDouble(p.workEnergy + 2 * node) : readDouble(sourceGasField(GAS_INTERNAL_ENERGY) + 2 * node),
           sum = 0.0;
    if (pivot >= 0) {
        for (int at = begin; at < end; at++) {
            int g = sourceGroup(at);
            if (g == pivot || (afterWork && target(g) == 0))
                continue;
            double next, error;
            twoSum(sum, readDouble(workField(FIELD_GROUP_ENERGY) + 2 * g), next, error);
            sum = next;
            writeDouble(workField(FIELD_ENERGY_ROUNDOFF) + 4 * g + (afterWork ? 2 : 0), error);
        }
        double rest, error;
        twoSum(energy, -sum, rest, error);
        if (!isFinite(rest) || !isFinite(error)) {
            reportInvalid();
            return;
        }
        writeDouble(workField(FIELD_GROUP_ENERGY) + 2 * pivot, rest);
        writeDouble(workField(FIELD_SOURCE_ROUNDOFF) + 4 * node + (afterWork ? 2 : 0), -error);
    } else if (energy != 0.0) {
        reportInvalid();
        return;
    }
    if (!afterWork) {
        int escape = int(words[workField(FIELD_ESCAPE_GROUP) + node]);
        double escaped = escape >= 0 ? readDouble(workField(FIELD_GROUP_ENERGY) + 2 * escape) : 0.0, retained, error;
        twoSum(energy, -escaped, retained, error);
        if (!isFinite(retained) || !isFinite(error)) {
            reportInvalid();
            return;
        }
        writeDouble(destinationGasField(GAS_INTERNAL_ENERGY, false) + 2 * node, retained);
        writeDouble(workField(FIELD_RETAINED_ROUNDOFF) + 4 * node, -error);
    }
