int originalSpeciesBegin(int group,int component){return int(words[(source(group)>=2?old(SPO):f(ASO))+component]);}
int originalSpeciesEnd(int group,int component){return int(words[(source(group)>=2?old(SPO):f(ASO))+component+1]);}
