int measureSpecies(int row,int component,int previous,int lane){int result=2147483647;
 for(int at=memberBegin(row,true)+lane;at<memberEnd(row,true);at+=128){int g=memberGroup(row,at,true);if(!memberAllowed(row,g,true))continue;
  for(int c=originalBegin(g);c<originalEnd(g);c++){if(originalHandle(g,c)!=component)continue;for(int e=originalSpeciesBegin(g,c);e<originalSpeciesEnd(g,c);e++){int handle=originalSpeciesHandle(g,e);if(handle>previous)result=min(result,handle);}}}
