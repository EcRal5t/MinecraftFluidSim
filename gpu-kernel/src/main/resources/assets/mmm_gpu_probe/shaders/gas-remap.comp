    if (self < 0 || pivot < 0) {
        if (lane == 0)
            reportInvalid();
        return;
    }
    double retained = readDouble(p.workEnergy + 2 * node), carried, firstError;
    twoSum(original, -retained, carried, firstError);
    double local = 0.0;
    int representative = -1;
    for (int at = begin + lane; at < end; at += rowStride()) {
        int g = sourceGroup(at);
        if (g == self || g == pivot)
            continue;
        double share = carried * (double(groupNanos(g)) / double(totalOut)), next, error;
        writeDouble(workField(FIELD_GROUP_ENERGY) + 2 * g, share);
        twoSum(local, share, next, error);
        local = next;
        writeDouble(workField(FIELD_ENERGY_ROUNDOFF) + 4 * g + 2, error);
        if (representative < 0)
            representative = g;
    }
    if (!shortRow()) {
        energies[lane] = local;
        representatives[lane] = representative;
        barrier();
        for (int width = 64; width > 0; width >>= 1) {
            if (lane < width && representatives[lane + width] >= 0) {
                if (representatives[lane] < 0) {
                    energies[lane] = energies[lane + width];
                    representatives[lane] = representatives[lane + width];
                } else {
                    double next, error;
                    twoSum(energies[lane], energies[lane + width], next, error);
                    energies[lane] = next;
                    writeDouble(workField(FIELD_ENERGY_ROUNDOFF) + 4 * representatives[lane + width] + 2, error);
                }
            }
            barrier();
        }
        local = energies[0];
    }
    if (lane == 0) {
        double remainder, error;
        twoSum(carried, -local, remainder, error);
        if (!isFinite(remainder) || !isFinite(retained))
            reportInvalid();
        writeDouble(workField(FIELD_GROUP_ENERGY) + 2 * self, retained);
        writeDouble(workField(FIELD_GROUP_ENERGY) + 2 * pivot, remainder);
        writeDouble(workField(FIELD_RETAINED_ROUNDOFF) + 4 * node, -firstError);
        writeDouble(workField(FIELD_SOURCE_ROUNDOFF) + 4 * node + 2, -error);
    }
}
void gatherComponents(int row, bool future, int lane) {
    int rows = actualRows(future),
        capacity = future ? headerWord(H_FUTURE_COMPONENT_CAPACITY) : headerWord(H_RETAINED_COMPONENT_CAPACITY),
        required = rows * materials();
    if (required > capacity) {
        if (lane == 0)
            atomicOr(errors, 64u);
        return;
    }
    int destination = row * materials();
    if (lane == 0) {
        words[destinationGasField(GAS_ROW_COMPONENT_OFFSETS, future) + row] = uint(destination);
        if (row == rows - 1) {
            words[destinationGasField(GAS_ROW_COMPONENT_OFFSETS, future) + rows] = uint(rows * materials());
            words[destinationGasField(GAS_COMPONENT_SPECIES_OFFSETS, future) + rows * materials()] = uint(rows * speciesStride());
        }
    }
    for (int handle = 0; handle < materials(); handle++) {
        uint64_t nanos = uint64_t(0), mass = uint64_t(0);
        int64_t residual = int64_t(0);
        for (int at = memberBegin(row, future) + lane; at < memberEnd(row, future); at += rowStride()) {
            int g = memberGroup(row, at, future);
            if (!memberAllowed(row, g, future))
                continue;
            int c = routePart(g, handle);
            if (c < 0 || readUint64(workField(FIELD_PART_NANOS) + 2 * c) == uint64_t(0))
                continue;
            nanos = plus(nanos, readUint64(workField(FIELD_PART_NANOS) + 2 * c));
            mass = plus(mass, readUint64(workField(FIELD_PART_MASS) + 2 * c));
            residual = signedPlus(residual, readInt64(workField(FIELD_PART_RESIDUAL) + 2 * c));
        }
        if (lane == 0) {
            int existing = oldPart(row, handle, future);
            if (existing >= 0) {
                nanos = plus(nanos, readUint64(sourceGasField(GAS_STANDARD_VOLUME_NANOS) + 2 * existing));
                mass = plus(mass, readUint64(sourceGasField(GAS_MASS_UNITS) + 2 * existing));
                residual = signedPlus(residual, readInt64(sourceGasField(GAS_MASS_RESIDUAL_UNITS) + 2 * existing));
            }
        }
        nanos = sumQuantity(lane, nanos);
        mass = sumQuantity(lane, mass);
        residual = sumResidual(lane, residual);
        if (lane == 0) {
            if ((nanos == uint64_t(0)) != (mass == uint64_t(0)) || (nanos == uint64_t(0) && residual != int64_t(0)))
                reportInvalid();
            words[destinationGasField(GAS_COMPONENT_HANDLES, future) + destination] = uint(handle);
            writeUint64(destinationGasField(GAS_STANDARD_VOLUME_NANOS, future) + 2 * destination, nanos);
            writeUint64(destinationGasField(GAS_MASS_UNITS, future) + 2 * destination, mass);
            writeUint64(destinationGasField(GAS_MASS_RESIDUAL_UNITS, future) + 2 * destination, uint64_t(residual));
        }
        if (lane == 0)
            words[destinationGasField(GAS_COMPONENT_SPECIES_OFFSETS, future) + destination] =
                uint(row * speciesStride() + declaredBegin(handle));
        destination++;
    }
}
void gatherEnergy(int row, int lane) {
    double sum = 0.0;
    int representative = -1;
    int correctionLane = row >= futureCount() ? 2 : 0;
    double sign = row == futureCount() ? 1.0LF : -1.0LF;
    for (int at = memberBegin(row, true) + lane; at < memberEnd(row, true); at += rowStride()) {
        int g = memberGroup(row, at, true);
        if (!memberAllowed(row, g, true))
            continue;
        double next, error;
        twoSum(sum, readDouble(workField(FIELD_GROUP_ENERGY) + 2 * g), next, error);
        sum = next;
        writeDouble(workField(FIELD_MERGE_ROUNDOFF) + 4 * g + correctionLane, sign * error);
        if (representative < 0)
            representative = g;
    }
    if (shortRow()) {
        if (!isFinite(sum))
            reportInvalid();
        if (row < futureCount())
            writeDouble(destinationGasField(GAS_INTERNAL_ENERGY, true) + 2 * row, sum);
        else
            writeDouble(workField(FIELD_AUDIT_ENERGY) + 2 * (row - futureCount()), sum);
        return;
    }
    energies[lane] = sum;
    representatives[lane] = representative;
    barrier();
    for (int width = 64; width > 0; width >>= 1) {
        if (lane < width && representatives[lane + width] >= 0) {
            if (representatives[lane] < 0) {
                energies[lane] = energies[lane + width];
                representatives[lane] = representatives[lane + width];
            } else {
                double next, error;
                twoSum(energies[lane], energies[lane + width], next, error);
                energies[lane] = next;
                // A subtree's representative added its first value to zero; its correction slot
                // remains free until that subtree becomes a right operand in this reduction.
                writeDouble(workField(FIELD_MERGE_ROUNDOFF) + 4 * representatives[lane + width] + correctionLane, sign * error);
            }
        }
        barrier();
    }
    if (lane == 0) {
        sum = energies[0];
        if (!isFinite(sum))
            reportInvalid();
        if (row < futureCount())
            writeDouble(destinationGasField(GAS_INTERNAL_ENERGY, true) + 2 * row, sum);
        else
            writeDouble(workField(FIELD_AUDIT_ENERGY) + 2 * (row - futureCount()), sum);
    }
}
void gatherSpeciesAndEnergy(int row, bool future, int lane) {
    int rows = actualRows(future), components = rows * materials(), required = rows * speciesStride();
    for (int handle = 0; handle < materials(); handle++) {
        int begin = declaredBegin(handle), end = declaredEnd(handle);
        for (int local = begin; local < end; local++) {
            uint64_t sum = uint64_t(0);
            for (int at = memberBegin(row, future) + lane; at < memberEnd(row, future); at += rowStride()) {
                int g = memberGroup(row, at, future);
                if (!memberAllowed(row, g, future))
                    continue;
                sum = plus(sum, readUint64(workField(FIELD_SPECIES_AMOUNTS) + 2 * (g * speciesStride() + local)));
            }
            if (lane == 0) {
                int c = oldPart(row, handle, future);
                if (c >= 0)
                    sum = plus(sum, readUint64(sourceGasField(GAS_SPECIES_AMOUNTS) + 2 * ((c / materials()) * speciesStride() + local)));
            }
            sum = sumQuantity(lane, sum);
            if (lane == 0) {
                int outAt = row * speciesStride() + local;
                words[destinationGasField(GAS_SPECIES_HANDLES, future) + outAt] = words[workField(FIELD_DECLARED_SPECIES_HANDLES) + local];
                writeUint64(destinationGasField(GAS_SPECIES_AMOUNTS, future) + 2 * outAt, sum);
            }
        }
    }
    if (future && row < futureCount() + 2)
        gatherEnergy(row, lane);
    if (lane == 0) {
        if (row == 0) {
            words[destinationGasField(GAS_COUNTS, future)] = uint(rows - 4);
            words[destinationGasField(GAS_COUNTS, future) + 1] = uint(components);
            words[destinationGasField(GAS_COUNTS, future) + 2] = uint(required);
            words[destinationGasField(GAS_ENERGY_PRESENT, future)] = words[sourceGasField(GAS_ENERGY_PRESENT)];
        }
        if (!future && row < nodeCount())
            words[destinationGasField(GAS_TOPOLOGY_KEYS, false) + row] = words[sourceGasField(GAS_TOPOLOGY_KEYS) + row];
    }
}
void topology(int cell, bool future) {
    if (!future) {
        for (int m = 0; m < 8; m++)
            words[destinationGasField(GAS_PIECE_NODE_ORDINAL, false) + 8 * cell + m] =
                words[sourceGasField(GAS_PIECE_NODE_ORDINAL) + 8 * cell + m];
        return;
    }
    int node = int(words[headerWord(H_FUTURE_CELL_NODES) + cell]), mask = int(words[headerWord(H_FUTURE_DRY_MASKS) + cell]);
    for (int m = 0; m < 8; m++)
        words[destinationGasField(GAS_PIECE_NODE_ORDINAL, true) + 8 * cell + m] = uint((mask & (1 << m)) != 0 ? node : -1);
    if (node > 0 && int(words[headerWord(H_FUTURE_PARENTS) + cell + 1]) == cell + 1)
        words[destinationGasField(GAS_TOPOLOGY_KEYS, true) + node - 1] = uint(8 * cell + findLSB(mask));
}
// All component/species slots derive from the immutable registry declarations.
void measureTotal() {
    int required[6] = int[6](groups() * materials(), groups() * speciesStride(),
                             headerWord(H_TRANSPORT) == 0 ? (nodeCount() + 4) * materials() : 0,
                             headerWord(H_TRANSPORT) == 0 ? (nodeCount() + 4) * speciesStride() : 0,
                             (futureCount() + 4) * materials(), (futureCount() + 4) * speciesStride());
    int capacities[6] =
        int[6](headerWord(H_PART_CAPACITY), headerWord(H_SPECIES_CAPACITY), headerWord(H_RETAINED_COMPONENT_CAPACITY),
               headerWord(H_RETAINED_SPECIES_CAPACITY), headerWord(H_FUTURE_COMPONENT_CAPACITY), headerWord(H_FUTURE_SPECIES_CAPACITY));
    for (int i = 0; i < 6; i++) {
        words[workField(FIELD_REQUIREMENTS) + i] = uint(required[i]);
        if (required[i] > capacities[i])
            atomicOr(errors, 64u);
    }
    if (futureCount() > headerWord(H_FUTURE_NODE_CAPACITY))
        atomicOr(errors, 64u);
}
void prepareDispatch() {
    for (int i = 0; i < 3; i++)
        words[workField(FIELD_DISPATCH) + DISPATCH_LONG_ROW_COUNTS + i] = 0u;
    int sizes[8] = int[8](groups(), nodeCount(), nodeCount() + 4, futureCount() + 4, nodeCount(), nodeCount() + 4,
                          futureCount() + 4, nodeCount());
    for (int i = 0; i < 8; i++) {
        int total = errors == 0u && !(i >= 2 && i <= 4) ? (i < 2 || i >= 5 ? (sizes[i] + 127) / 128 : sizes[i]) : 0,
            at = workField(FIELD_DISPATCH) + 3 * i;
        words[at] = uint(min(total, 65535));
        words[at + 1] = uint(max(1, (total + 65534) / 65535));
        words[at + 2] = 1u;
    }
}
int longBase(int kind) {
    return workField(FIELD_LONG_ROWS) + (kind == LONG_RETAINED_ROWS   ? 0
                                 : kind == LONG_FUTURE_ROWS ? headerWord(H_DESTINATION_GROUPS)
                                             : headerWord(H_DESTINATION_GROUPS) + headerWord(H_SOURCE_GROUPS));
}
void classifyRows(int row) {
    if (row < nodeCount() + 4 && memberEnd(row, false) - memberBegin(row, false) > 16) {
        uint slot = atomicAdd(words[workField(FIELD_DISPATCH) + DISPATCH_LONG_ROW_COUNTS + LONG_RETAINED_ROWS], 1u);
        words[longBase(LONG_RETAINED_ROWS) + slot] = uint(row);
    }
    if (row < futureCount() + 4 && memberEnd(row, true) - memberBegin(row, true) > 16) {
        uint slot = atomicAdd(words[workField(FIELD_DISPATCH) + DISPATCH_LONG_ROW_COUNTS + LONG_FUTURE_ROWS], 1u);
        words[longBase(LONG_FUTURE_ROWS) + slot] = uint(row);
    }
    if (row < nodeCount() && sourceEnd(row) - sourceBegin(row) > 16) {
        uint slot = atomicAdd(words[workField(FIELD_DISPATCH) + DISPATCH_LONG_ROW_COUNTS + LONG_SOURCE_ROWS], 1u);
        words[longBase(LONG_SOURCE_ROWS) + slot] = uint(row);
    }
}
void main() {
    int row = int(gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x), lane = int(gl_LocalInvocationID.x),
        id = 128 * row + lane;

    if (p.stage == STAGE_CLASSIFY_ROWS) {
        if (errors == 0u && id < p.count)
            classifyRows(id);
        return;
    }
    if (p.stage == STAGE_LONG_ROW_DISPATCH) {
        if (id == 0)
            for (int i = 0; i < 3; i++) {
                int total = int(words[workField(FIELD_DISPATCH) + DISPATCH_LONG_ROW_COUNTS + i]), at = workField(FIELD_DISPATCH) + 3 * (i + 2);
                words[at] = uint(min(total, 65535));
                words[at + 1] = uint(max(1, (total + 65534) / 65535));
                words[at + 2] = 1u;
            }
        return;
    }
    if (!shortRow()) {
        int kind = (p.stage == STAGE_GATHER_RETAINED)                                                              ? LONG_RETAINED_ROWS
                   : ((p.stage == STAGE_GATHER_FUTURE))                                                         ? LONG_FUTURE_ROWS
                   : ((p.stage == STAGE_SPLIT_SOURCE && headerWord(H_TRANSPORT) != 0) || p.stage == STAGE_RETAINED_VOLUMES || p.stage == STAGE_TRANSPORT_ENERGY) ? LONG_SOURCE_ROWS
                                                                                               : -1;
        if (kind >= 0) {
            if (row >= int(words[workField(FIELD_DISPATCH) + DISPATCH_LONG_ROW_COUNTS + kind]))
                return;
            row = int(words[longBase(kind) + row]);
        }
    }
    if (shortRow()) {
        int stage = p.stage - SHORT_ROW_STAGE_OFFSET;
        if (stage == STAGE_SPLIT_SOURCE || stage == STAGE_RETAINED_VOLUMES || stage == STAGE_TRANSPORT_ENERGY) {
            if (errors != 0u || id >= nodeCount() || id >= p.count || sourceEnd(id) - sourceBegin(id) > 16)
                return;
            if (stage == STAGE_SPLIT_SOURCE)
                splitTransport(id, 0);
            else if (stage == STAGE_RETAINED_VOLUMES)
                retainedVolumes(id, 0);
            else
                transportEnergy(id, 0);
            return;
        }
        bool future = stage >= 11;
        if (id >= actualRows(future) || id >= p.count || memberEnd(id, future) - memberBegin(id, future) > 16)
            return;
        if (errors != 0u)
            return;
        gatherComponents(id, future, 0);
        gatherSpeciesAndEnergy(id, future, 0);
        return;
    }
    if (p.stage == STAGE_SNAPSHOT_ROUNDOFF) {
        if (id >= p.count || errors != 0u)
            return;
        if (id < groups())
            writeDouble(workField(FIELD_ENERGY_ROUNDOFF) + 4 * id + 2, readDouble(workField(FIELD_ENERGY_ROUNDOFF) + 4 * id));
        if (id < nodeCount()) {
            writeDouble(workField(FIELD_SOURCE_ROUNDOFF) + 4 * id + 2, readDouble(workField(FIELD_SOURCE_ROUNDOFF) + 4 * id));
            writeDouble(workField(FIELD_RETAINED_ROUNDOFF) + 4 * id, 0.0);
        }
        return;
    }
    if (p.stage == STAGE_PREPARE_DISPATCH) {
        if (id == 0) {
            for (int i = 0; i < 9; i++)
                words[workField(FIELD_REQUIREMENTS) + i] = 0u;
            for (int i = 0; i < 8; i++) {
                words[workField(FIELD_DISPATCH) + 3 * i] = 0u;
                words[workField(FIELD_DISPATCH) + 3 * i + 1] = 1u;
                words[workField(FIELD_DISPATCH) + 3 * i + 2] = 1u;
            }
            if (errors == 0u) {
                words[workField(FIELD_REQUIREMENTS) + REQUIREMENT_FUTURE_NODE_COUNT] = uint(futureCount());
                words[workField(FIELD_REQUIREMENTS) + REQUIREMENT_GROUP_COUNT] = uint(groups());
                words[workField(FIELD_REQUIREMENTS) + REQUIREMENT_READY] = 1u;
                prepareDispatch();
            }
        }
        return;
    }
    if ((p.stage == STAGE_SPLIT_SOURCE && headerWord(H_TRANSPORT) != 0) || p.stage == STAGE_RETAINED_VOLUMES || p.stage == STAGE_TRANSPORT_ENERGY) {
        if (lane == 0)
            rowValid = errors == 0u && row < nodeCount() ? 1 : 0;
        barrier();
        if (rowValid == 0)
            return;
        if (sourceEnd(row) - sourceBegin(row) <= 16)
            return;
        if (p.stage == STAGE_SPLIT_SOURCE)
            splitTransport(row, lane);
        else if (p.stage == STAGE_RETAINED_VOLUMES)
            retainedVolumes(row, lane);
        else
            transportEnergy(row, lane);
        return;
    }
    if (p.stage == STAGE_CAPTURE_AMBIENT && headerWord(H_TRANSPORT) != 0) {
        if (lane == 0)
            rowValid = errors == 0u ? 1 : 0;
        barrier();
        if (rowValid != 0)
            captureAmbientParallel(lane);
        return;
    }
    if (p.stage == STAGE_MEASURE_TOTAL) {
        if (id == 0 && words[workField(FIELD_REQUIREMENTS) + REQUIREMENT_READY] != 0u)
            measureTotal();
        return;
    }
    if ((p.stage == STAGE_GATHER_RETAINED) || (p.stage == STAGE_GATHER_FUTURE)) {
        bool future = p.stage >= 11;
        if (lane == 0)
            rowValid = errors == 0u && row < actualRows(future) && row < p.count ? 1 : 0;
        barrier();
        if (rowValid == 0)
            return;
        if (memberEnd(row, future) - memberBegin(row, future) <= 16)
            return;
        gatherComponents(row, future, lane);
        gatherSpeciesAndEnergy(row, future, lane);
        return;
    }
    if (id >= p.count || errors != 0u)
        return;
    if (p.stage == STAGE_CLEAR_STEP)
        clearStep(id);
    else if (p.stage == STAGE_PREPARE_PARTS)
        prepareParts(id);
    else if (p.stage == STAGE_SPLIT_SOURCE)
        splitSource(id);
    else if (p.stage == STAGE_CAPTURE_AMBIENT)
        captureAmbient();
    else if (p.stage == STAGE_RETAINED_GROUP_ENERGY || p.stage == STAGE_FUTURE_GROUP_ENERGY)
        groupEnergy(id, p.stage == STAGE_FUTURE_GROUP_ENERGY);
    else if (p.stage == STAGE_RETAINED_CLOSE_SOURCE_ENERGY || p.stage == STAGE_FUTURE_CLOSE_SOURCE_ENERGY)
        closeSourceEnergy(id, p.stage == STAGE_FUTURE_CLOSE_SOURCE_ENERGY);
    else
        topology(id, p.stage == STAGE_FUTURE_TOPOLOGY);
}
