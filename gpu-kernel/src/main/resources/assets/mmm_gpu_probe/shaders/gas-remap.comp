  int segment=begin;while(segment+1<end&&(heating?current>=number(th(5)+2*segment):current>number(th(5)+2*segment)))segment++;
  double bound=heating?(segment+1<end?number(th(5)+2*segment):temperature):(segment>begin?number(th(5)+2*(segment-1)):temperature);
