int originalBegin(int group){int s=source(group);return s>=2?int(words[old(ROWS)+s-2]):0;}
int originalEnd(int group){int s=source(group);return s>=2?int(words[old(ROWS)+s-1]):s==1&&target(group)>0?h(11):0;}
