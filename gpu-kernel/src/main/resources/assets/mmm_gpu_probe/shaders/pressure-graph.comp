void assignAggregate(int row){int root=fineWords[fineField(L_SELECT)+row]!=0u?row:-1;double bestStrength=root>=0?1.0:-1.0;
 if(root<0)for(int edge=rowStart(row);edge<rowEnd(row);edge++){int neighbor=edgePeer(edge);if(fineWords[fineField(L_SELECT)+neighbor]==0u)continue;double strength=abs(edgeValue(edge))/sqrt(rowDiagonal(row)*rowDiagonal(neighbor));if(strength>bestStrength||(strength==bestStrength&&(root<0||hasHigherPriority(neighbor,root)))){bestStrength=strength;root=neighbor;}}
