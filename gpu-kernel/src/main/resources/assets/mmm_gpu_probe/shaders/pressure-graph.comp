void prolongRow(int i){float result;if(aggregateParent(i)>=0)result=coarseCorrection(aggregateParent(i));else{result=fineResidual(i);for(int e=rowStart(i);e<rowEnd(i);e++)result-=float(edgeValue(e))*coarseCorrection(aggregateParent(edgePeer(e)));result/=float(rowDiagonal(i));}fineWords[fineField(L_U)+i]=floatBitsToUint(result);}
