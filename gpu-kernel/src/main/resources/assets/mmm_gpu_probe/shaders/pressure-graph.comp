}
void groupProposal(int id){if(id==0)scratchWords[scratchField(S_ACTUAL)]=scratchWords[scratchField(S_PREFIX)+int(scratchWords[1])];if(int(scratchWords[scratchField(S_PAIR_A)+id])<0)return;int slot=int(scratchWords[scratchField(S_SLOT)+id]),group=int(scratchWords[scratchField(S_PREFIX)+slot]);atomicAdd(scratchWords[scratchField(S_COUNTS)+group],1u);if(scratchWords[scratchField(S_HASH)+slot]==uint(id)){scratchWords[scratchField(S_GROUP_A)+group]=scratchWords[scratchField(S_PAIR_A)+id];scratchWords[scratchField(S_GROUP_B)+group]=scratchWords[scratchField(S_PAIR_B)+id];}}
