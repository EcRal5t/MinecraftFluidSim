 for(int j=0;j<count;j++)for(int k=j+1;k<count;k++)writeProposal(slot++,ids[j],ids[k],-weights[j]*weights[k]/rowDiagonal(i));
}
void hashProposal(int id){int x=int(scratchWords[scratchField(S_PAIR_A)+id]);if(x<0)return;int y=int(scratchWords[scratchField(S_PAIR_B)+id]);uint slot=mix(uint(x)*0x9e3779b9u^uint(y))&uint(scratchWords[1]-1u);
