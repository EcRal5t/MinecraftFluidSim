void writeProposal(int slot,int firstRow,int secondRow,double weight){if(firstRow==secondRow||firstRow<0||secondRow<0||weight==0.0){scratchWords[scratchField(S_PAIR_A)+slot]=uint(-1);return;}scratchWords[scratchField(S_PAIR_A)+slot]=uint(min(firstRow,secondRow));scratchWords[scratchField(S_PAIR_B)+slot]=uint(max(firstRow,secondRow));writeScratchDouble(scratchField(S_VALUE)+2*slot,weight);}
