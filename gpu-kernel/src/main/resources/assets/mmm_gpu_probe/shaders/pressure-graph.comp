}
// Read the immutable first-hop assignments, then write a separate final map.
// Every added member has an actual two-edge path to its seed inside the aggregate.
void attachAggregate(int row){int root=aggregateParent(row);double bestStrength=-1.0;
 if(root<0)for(int edge=rowStart(row);edge<rowEnd(row);edge++){int neighbor=edgePeer(edge),candidate=aggregateParent(neighbor);if(candidate<0)continue;
  double strength=abs(edgeValue(edge))/sqrt(rowDiagonal(row)*rowDiagonal(neighbor))*readFineDouble(fineField(L_ROW_DOUBLE)+2*neighbor);
  if(strength>bestStrength||(strength==bestStrength&&(root<0||hasHigherPriority(candidate,root)))){bestStrength=strength;root=candidate;}}
 if(root<0)root=row;fineWords[fineField(L_JOIN)+row]=uint(root);fineWords[fineField(L_FLAGS)+row]=root==row?1u:0u;
}
void proposalCount(int i){int degree=rowEnd(i)-rowStart(i);fineWords[fineField(L_PROPOSAL_COUNTS)+i]=p.mode==0&&fineWords[fineField(L_SELECT)+i]!=0u?uint(degree*(degree-1)/2):0u;}
void edgeFlag(int e){bool valid=false;if(e<int(fineWords[LEVEL_EDGE_COUNT])){int i=int(fineWords[fineField(L_EDGE_ROWS)+e]),j=edgePeer(e);valid=i<j&&(p.mode==0?(fineWords[fineField(L_SELECT)+i]==0u&&fineWords[fineField(L_SELECT)+j]==0u):aggregateParent(i)!=aggregateParent(j));}fineWords[fineField(L_EDGE_FLAGS)+e]=valid?1u:0u;}
