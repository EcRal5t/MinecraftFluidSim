int fineField(int f){return int(fineWords[16+f]);}int coarseField(int f){return int(coarseWords[16+f]);}int scratchField(int f){return int(scratchWords[16+f]);}
int fineRowCount(){return int(fineWords[LEVEL_ROW_COUNT]);}int coarseRowCount(){return int(coarseWords[LEVEL_ROW_COUNT]);}
double readFineDouble(int at){return packDouble2x32(uvec2(fineWords[at],fineWords[at+1]));}double readCoarseDouble(int at){return packDouble2x32(uvec2(coarseWords[at],coarseWords[at+1]));}double readScratchDouble(int at){return packDouble2x32(uvec2(scratchWords[at],scratchWords[at+1]));}
