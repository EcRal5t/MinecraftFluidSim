#version 450
#extension GL_ARB_gpu_shader_fp64 : require
#extension GL_EXT_control_flow_attributes : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
layout(local_size_x=128) in;
layout(binding=0,std430) readonly buffer Source { uint sourceWords[]; };
layout(binding=1,std430) buffer Candidate { uint candidateWords[]; };
layout(binding=2,std430) buffer Errors { uint errors; };
layout(push_constant) uniform Params { int header; int stage; int count; int gravitySign; } p;
// DYADIC_LIBRARY
const int COUNTS=0,CELL_OFFSETS=1,MATERIALS=2,VOLUME_OFFSETS=4,VOLUME_COUNTS=5,
          VOLUME_EXPONENTS=6,VOLUME_LIMBS=7,MASS_UNITS=8;
const int R_DESCRIPTORS=0,R_SOURCE_OFFSETS=7,R_SLOTS=8,R_COUNTS=9,R_SOURCE_MASKS=10;
uvec2 proposalWords;
bool failed=false;
int h(int index) { return int(candidateWords[p.header+index]); }
int src(int field) { return h(16+field); }
int route(int field) { return h(35+field); }
uint dyadicWord(int bank,int index) {
    return bank==0?sourceWords[index]:bank==1?candidateWords[index]:proposalWords[index];
}
void dyadicWrite(int index,uint word) { candidateWords[index]=word; }
double getDouble(int at) { return packDouble2x32(uvec2(candidateWords[at],candidateWords[at+1])); }
void putDouble(int at,double value) { uvec2 bits=unpackDouble2x32(value);candidateWords[at]=bits.x;candidateWords[at+1]=bits.y; }
int64_t getLong(int at) { return int64_t(uint64_t(candidateWords[at])|(uint64_t(candidateWords[at+1])<<32)); }
void putLong(int at,int64_t value) { candidateWords[at]=uint(value);candidateWords[at+1]=uint(uint64_t(value)>>32); }
void fail() { failed=true;atomicOr(errors,32u); }
DyadicTerm zero() { return DyadicTerm(1,0,0,0,0); }
DyadicTerm accepted(int cell,int slot) {
    int at=h(3)+5*(7*cell+slot);
    return DyadicTerm(int(candidateWords[at]),int(candidateWords[at+1]),int(candidateWords[at+2]),
                      int(candidateWords[at+3]),int(candidateWords[at+4]));
}
DyadicTerm sourceVolume(int stock) {
    int first=int(sourceWords[src(VOLUME_OFFSETS)+stock]);
    return DyadicTerm(0,src(VOLUME_LIMBS)+first,int(sourceWords[src(VOLUME_COUNTS)+stock]),
                      int(sourceWords[src(VOLUME_EXPONENTS)+stock]),sourceWords[src(VOLUME_COUNTS)+stock]>0u?1:0);
}
int windowOffset(int window) { return h(10)+int(candidateWords[h(9)+window]); }
int windowCapacity(int window) { return int(candidateWords[h(8)+window]); }
int candidateCount(){return int(candidateWords[route(R_SOURCE_OFFSETS)+h(1)]);}
int routeIndex(int stock,int slot){uint mask=candidateWords[route(R_SOURCE_MASKS)+stock];return (mask&(1u<<slot))==0u?-1:int(candidateWords[route(R_SOURCE_OFFSETS)+stock])+bitCount(mask&((1u<<slot)-1u));}
DyadicTerm routed(int entry) {
    if(entry<0)return zero();int at=route(R_DESCRIPTORS)+5*entry;
    return DyadicTerm(int(candidateWords[at]),int(candidateWords[at+1]),int(candidateWords[at+2]),int(candidateWords[at+3]),int(candidateWords[at+4]));
}
void saveRoute(int entry,DyadicTerm value) {
    int at=route(R_DESCRIPTORS)+5*entry;
    candidateWords[at]=uint(value.bank);candidateWords[at+1]=uint(value.offset);candidateWords[at+2]=uint(value.count);
    candidateWords[at+3]=uint(value.exponent);candidateWords[at+4]=uint(value.sign);
}
int64_t highBit(DyadicTerm value) {
    return int64_t(value.exponent)+int64_t(32)*int64_t(value.count-1)
            +int64_t(findMSB(dyadicWord(value.bank,value.offset+value.count-1)));
}
double head(DyadicTerm value) {
    if(!dyadicPresent(value))return 0.0;
    double result=double(dyadicWord(value.bank,value.offset+value.count-1));
    if(value.count>1)result+=double(dyadicWord(value.bank,value.offset+value.count-2))*2.3283064365386962890625e-10LF;
    if(value.count>2)result+=double(dyadicWord(value.bank,value.offset+value.count-3))*5.4210108624275221700372640043497e-20LF;
    return result;
}
double scaled(DyadicTerm value,int64_t power) {
    if(!dyadicPresent(value))return 0.0;
    int64_t shift=int64_t(value.exponent)+int64_t(32)*int64_t(value.count-1)-power;
    if(shift<int64_t(-1100))return 0.0;
    return ldexp(head(value),int(shift));
}
DyadicTerm copyTo(DyadicTerm value,int window) {
    if(!dyadicPresent(value))return zero();
    if(value.count>windowCapacity(window)){atomicOr(errors,64u);failed=true;return zero();}
    int at=windowOffset(window);
    [[dont_unroll]] for(int i=0;i<value.count;i++)candidateWords[at+i]=dyadicWord(value.bank,value.offset+i);
    return DyadicTerm(1,at,value.count,value.exponent,1);
}
// Most transported volumes fit four aligned words. Compute the same exact integer sum in registers.
// Wider remainders retain the streaming dyadic arithmetic below.
DyadicTerm combineNarrow(DyadicTerm a,DyadicTerm b,int coefficient,int minimum,int window) {
    uvec4 result=uvec4(0u);uint64_t carry=uint64_t(0);
    for(int i=0;i<4;i++){
        uint64_t av=uint64_t(dyadicAlignedWord(a,i,minimum)),bv=uint64_t(dyadicAlignedWord(b,i,minimum));
        if(coefficient>0){uint64_t sum=av+bv+carry;result[i]=uint(sum);carry=sum>>32;}
        else{uint64_t sub=bv+carry;result[i]=uint(av-sub);carry=av<sub?uint64_t(1):uint64_t(0);}
    }
    if(carry!=uint64_t(0)){fail();return zero();}
    int first=0;[[dont_unroll]] while(first<4&&result[first]==0u)first++;
    if(first==4)return zero();int last=3;[[dont_unroll]] while(result[last]==0u)last--;
    int trailing=findLSB(result[first]),bits=32*(last-first)+findMSB(result[last])-trailing+1,count=(bits+31)/32;
    int64_t exponent=int64_t(minimum)+int64_t(32*first+trailing);
    if(exponent>int64_t(2147483647)){fail();return zero();}
    if(count>windowCapacity(window)){atomicOr(errors,64u);failed=true;return zero();}
    int at=windowOffset(window);
    [[dont_unroll]] for(int i=0;i<count;i++){int index=first+i;uint word=result[index]>>trailing;if(trailing!=0&&index<3)word|=result[index+1]<<(32-trailing);candidateWords[at+i]=word;}
    return DyadicTerm(1,at,count,int(exponent),1);
}
DyadicTerm combineWide(DyadicTerm a,DyadicTerm b,int coefficient,int window) {
    DyadicTerm items[7];items[0]=a;items[1]=b;items[1].sign*=coefficient;
    DyadicMeasure measure=dyadicMeasure(items,2);
    if(measure.status==DYADIC_ZERO)return zero();
    if(measure.status!=DYADIC_POSITIVE){fail();return zero();}
    if(measure.words>windowCapacity(window)){atomicOr(errors,64u);failed=true;return zero();}
    dyadicWriteSum(items,2,measure,windowOffset(window));
    return DyadicTerm(1,windowOffset(window),measure.words,measure.exponent,1);
}
DyadicTerm combine(DyadicTerm a,DyadicTerm b,int coefficient,int window) {
    if(!dyadicPresent(b))return copyTo(a,window);
    if(!dyadicPresent(a)){if(coefficient<0){fail();return zero();}return copyTo(b,window);}
    if(coefficient<0&&a.bank==b.bank&&a.offset==b.offset&&a.count==b.count&&a.exponent==b.exponent)return zero();
    int minimum=min(a.exponent,b.exponent);
    if(max(highBit(a),highBit(b))-int64_t(minimum)<int64_t(coefficient>0?127:128))return combineNarrow(a,b,coefficient,minimum,window);
    return combineWide(a,b,coefficient,window);
}
// Positive canonical volumes can be ordered from their leading bit without constructing a difference.
int compareVolume(DyadicTerm a,DyadicTerm b) {
    if(!dyadicPresent(a))return dyadicPresent(b)?-1:0;
    if(!dyadicPresent(b))return 1;
    int64_t ah=highBit(a),bh=highBit(b);if(ah!=bh)return ah<bh?-1:1;
    int minimum=min(a.exponent,b.exponent),last=int((ah-int64_t(minimum))>>5);
    [[dont_unroll]] for(int i=last;i>=0;i--){uint av=dyadicAlignedWord(a,i,minimum),bv=dyadicAlignedWord(b,i,minimum);if(av!=bv)return av<bv?-1:1;}
    return 0;
}
DyadicTerm smaller(DyadicTerm a,DyadicTerm b) { return compareVolume(a,b)<=0?a:b; }

int phase(int stock) { return int(candidateWords[h(4)+int(sourceWords[src(MATERIALS)+stock])]); }
bool densityEqual(int a,int b) {
    return getLong(h(15)+2*a)==getLong(h(15)+2*b)&&getDouble(h(14)+2*a)==getDouble(h(14)+2*b);
}
bool denser(int a,int b) {
    int64_t ea=getLong(h(15)+2*a),eb=getLong(h(15)+2*b);
    return ea==eb?getDouble(h(14)+2*a)>getDouble(h(14)+2*b):ea>eb;
}
bool selected(int stock,int layer) { return layer<0||densityEqual(stock,layer); }

void prepareDensity(int first,int last) {
    [[dont_unroll]] for(int stock=first;stock<last;stock++) {
        int leader=stock;
        [[dont_unroll]] for(int other=first;other<stock;other++)if(phase(other)==phase(stock)){leader=other;break;}
        if(leader!=stock) {
            putDouble(h(14)+2*stock,getDouble(h(14)+2*leader));
            putLong(h(15)+2*stock,getLong(h(15)+2*leader));continue;
        }
        int64_t maximum=int64_t(-9223372036854775807L);double mass=0.0;
        [[dont_unroll]] for(int other=stock;other<last;other++)if(phase(other)==phase(stock)) {
            DyadicTerm volume=sourceVolume(other);if(dyadicPresent(volume))maximum=max(maximum,highBit(volume));
            int at=src(MASS_UNITS)+2*other;
            mass+=double(uint64_t(sourceWords[at])|(uint64_t(sourceWords[at+1])<<32));
        }
        double volumeSum=0.0;
        [[dont_unroll]] for(int other=stock;other<last;other++)if(phase(other)==phase(stock))volumeSum+=scaled(sourceVolume(other),maximum);
        int power=0;double density=mass==0.0?0.0:frexp(mass/volumeSum,power);
        putDouble(h(14)+2*stock,density);
        putLong(h(15)+2*stock,mass==0.0?int64_t(-9223372036854775807L):int64_t(power)-maximum);
    }
}

// Narrow sums load both operands into registers before writing their destination.
// Wide sums retain a disjoint temporary so arbitrary exact descriptors cannot alias.
DyadicTerm storeCombined(DyadicTerm a,DyadicTerm b,int coefficient,int destination,int temporary){
 if(!dyadicPresent(b))return copyTo(a,destination);
 if(!dyadicPresent(a)){if(coefficient<0){fail();return zero();}return copyTo(b,destination);}
 int minimum=min(a.exponent,b.exponent);
 if(max(highBit(a),highBit(b))-int64_t(minimum)<int64_t(coefficient>0?127:128))return combineNarrow(a,b,coefficient,minimum,destination);
 return copyTo(combineWide(a,b,coefficient,temporary),destination);
}
void transfer(int stock,int slot,DyadicTerm part,inout DyadicTerm budget,inout int budgetWindow,int cell) {
 if(!dyadicPresent(part)||failed)return;
 int base=candidateCount()+3*cell,temp=base+2,other=budgetWindow==base?base+1:base,entry=routeIndex(stock,slot);
 // Preserve the old part until both subtraction results have been computed.
 DyadicTerm nextBudget=combine(budget,part,-1,other);if(failed)return;
 DyadicTerm piece=storeCombined(routed(entry),part,1,entry,temp);if(failed)return;saveRoute(entry,piece);
 DyadicTerm remaining=storeCombined(routed(routeIndex(stock,0)),part,-1,routeIndex(stock,0),temp);if(failed)return;saveRoute(routeIndex(stock,0),remaining);
 budget=nextBudget;budgetWindow=other;
}

void partitionLayer(int cell,int first,int last,int slot,int layer,inout DyadicTerm budget,inout int budgetWindow) {
    int sole=-1;
    [[dont_unroll]] for(int stock=first;stock<last;stock++)if(selected(stock,layer)&&dyadicPresent(routed(routeIndex(stock,0)))){if(sole>=0){sole=-2;break;}sole=stock;}
    if(sole>=0){transfer(sole,slot,smaller(routed(routeIndex(sole,0)),budget),budget,budgetWindow,cell);return;}
    int64_t maximum=int64_t(-9223372036854775807L);
    [[dont_unroll]] for(int stock=first;stock<last;stock++)if(selected(stock,layer)) {
        DyadicTerm value=routed(routeIndex(stock,0));if(dyadicPresent(value))maximum=max(maximum,highBit(value));
    }
    double total=0.0;
    [[dont_unroll]] for(int stock=first;stock<last;stock++)if(selected(stock,layer)) {
        double weight=scaled(routed(routeIndex(stock,0)),maximum);putDouble(h(13)+2*stock,weight);total+=weight;
    }
    // Keep this face's original target immutable while the working budget alternates.
    // Its leading three words suffice for preferences; exponent/significand copies are local.
    DyadicTerm initial=budget;
    double initialHead=head(initial);int64_t initialPower=int64_t(initial.exponent)+int64_t(32)*int64_t(initial.count-1);
    [[dont_unroll]] for(int stock=first;stock<last&&dyadicPresent(budget)&&!failed;stock++)if(selected(stock,layer)) {
        double ratio=total>0.0?getDouble(h(13)+2*stock)/total:0.0;
        // Recreate a normalized three-word-free descriptor through the local proposal bank.
        double amount=initialHead*ratio;int power=0;double mantissa=frexp(amount,power);
        uint64_t bits=uint64_t(ldexp(mantissa,53));
        int64_t exponent=initialPower+int64_t(power)-int64_t(53),minimum=int64_t(h(63));
        if(exponent<minimum) { int64_t shift=minimum-exponent;bits=shift>=int64_t(64)?uint64_t(0):bits>>int(shift);exponent=minimum; }
        DyadicTerm wanted=zero();
        if(bits!=uint64_t(0)) {
            int trailing=uint(bits)==0u?32+findLSB(uint(bits>>32)):findLSB(uint(bits));bits>>=trailing;exponent+=int64_t(trailing);
            if(exponent<int64_t(-2147483647)-int64_t(1)||exponent>int64_t(2147483647)){fail();return;}
            proposalWords=uvec2(uint(bits),uint(bits>>32));wanted=DyadicTerm(2,0,proposalWords.y==0u?1:2,int(exponent),1);
        }
        transfer(stock,slot,smaller(smaller(wanted,routed(routeIndex(stock,0))),budget),budget,budgetWindow,cell);
    }
    // At most one linear pass closes the exact remainder, including subnormal or wider inputs.
    [[dont_unroll]] for(int stock=first;stock<last&&dyadicPresent(budget)&&!failed;stock++)if(selected(stock,layer))
        transfer(stock,slot,smaller(routed(routeIndex(stock,0)),budget),budget,budgetWindow,cell);
}

void distributeFace(int cell,int first,int last,int slot,bool layered,bool heavyFirst) {
    DyadicTerm targetVolume=accepted(cell,slot);if(!dyadicPresent(targetVolume))return;
    int budgetWindow=candidateCount()+3*cell;
    DyadicTerm budget=copyTo(targetVolume,budgetWindow);
    [[dont_unroll]] while(dyadicPresent(budget)&&!failed) {
        int layer=-1;
        if(layered) {
            [[dont_unroll]] for(int stock=first;stock<last;stock++)if(dyadicPresent(routed(routeIndex(stock,0))))
                if(layer<0||(heavyFirst?denser(stock,layer):denser(layer,stock)))layer=stock;
            if(layer<0){fail();return;}
        }
        partitionLayer(cell,first,last,slot,layer,budget,budgetWindow);
        if(!layered&&dyadicPresent(budget)){fail();return;}
    }
}

int reserveWidth(int64_t high,int minimum) {
    return int(min(int64_t(1024),max(int64_t(1),(high-int64_t(minimum)+int64_t(32))/int64_t(32))));
}
void prepareCandidates(int cell){
 if(errors!=0u)return;uint mask=1u;
 for(int slot=1;slot<7;slot++)if(dyadicPresent(accepted(cell,slot)))mask|=1u<<slot;
 int first=int(sourceWords[src(CELL_OFFSETS)+cell]),last=int(sourceWords[src(CELL_OFFSETS)+cell+1]);
 [[dont_unroll]] for(int stock=first;stock<last;stock++){uint selected=dyadicPresent(sourceVolume(stock))?mask:0u;
  candidateWords[h(62)+stock]=uint(bitCount(selected));candidateWords[route(R_SOURCE_MASKS)+stock]=selected;}
}
// Candidate masks already encode exact source presence, including fixed empty material slots.
int soleSource(int first,int last){int sole=-1;for(int stock=first;stock<last;stock++)if(candidateWords[route(R_SOURCE_MASKS)+stock]!=0u){if(sole>=0)return -2;sole=stock;}return sole;}
bool hasCrossRoute(int first,int last){for(int stock=first;stock<last;stock++)if((candidateWords[route(R_SOURCE_MASKS)+stock]&~1u)!=0u)return true;return false;}
void reserve(int cell) {
    int count=candidateCount(),base=count+3*cell;
    if(cell==0){candidateWords[route(R_COUNTS)]=uint(count);candidateWords[route(R_COUNTS)+1]=uint(count+3*h(0));}
    for(int i=0;i<3;i++)candidateWords[h(8)+base+i]=0u;
    int first=int(sourceWords[src(CELL_OFFSETS)+cell]),last=int(sourceWords[src(CELL_OFFSETS)+cell+1]);
    [[dont_unroll]] for(int stock=first;stock<last;stock++)for(int slot=0;slot<7;slot++){
        int entry=routeIndex(stock,slot);if(entry<0)continue;
        candidateWords[h(8)+entry]=0u;candidateWords[route(R_SLOTS)+entry]=uint(slot);saveRoute(entry,zero());
    }
    if(errors!=0u||soleSource(first,last)!=-2||!hasCrossRoute(first,last))return;
    int minimum=2147483647;int64_t maximum=int64_t(-9223372036854775807L);
    [[dont_unroll]] for(int stock=first;stock<last;stock++) {
        DyadicTerm value=sourceVolume(stock);if(!dyadicPresent(value))continue;
        minimum=min(minimum,value.exponent);maximum=max(maximum,highBit(value));
    }
    for(int slot=0;slot<7;slot++) {
        DyadicTerm value=accepted(cell,slot);if(value.sign<0){fail();return;}
        if(dyadicPresent(value)){minimum=min(minimum,value.exponent);maximum=max(maximum,highBit(value));}
    }
    if(minimum==2147483647&&maximum==int64_t(-9223372036854775807L))return;
    // Workspace spans existing exact tails and a fixed proportional-allocation lattice.
    // New proportional targets use the same precision on every step.
    minimum=min(minimum,h(63));
    [[dont_unroll]] for(int stock=first;stock<last;stock++) {
        DyadicTerm value=sourceVolume(stock);int width=dyadicPresent(value)?reserveWidth(highBit(value),minimum):1;
        for(int slot=0;slot<7;slot++){int entry=routeIndex(stock,slot);if(entry>=0)candidateWords[h(8)+entry]=uint(width);}
    }
    for(int i=0;i<3;i++)candidateWords[h(8)+base+i]=uint(reserveWidth(maximum+int64_t(32),minimum));
}
void splitCell(int cell) {
    if(candidateWords[h(9)+h(60)]>uint(h(6))){atomicOr(errors,64u);return;}
    int first=int(sourceWords[src(CELL_OFFSETS)+cell]),last=int(sourceWords[src(CELL_OFFSETS)+cell+1]);
    // Capacity already partitions this cell's exact total. One material inherits those seven pieces directly.
    int sole=soleSource(first,last);
    if(sole>=0){for(int slot=0;slot<7;slot++){int entry=routeIndex(sole,slot);if(entry>=0)saveRoute(entry,accepted(cell,slot));}return;}
    if(sole==-1)return;
    [[dont_unroll]] for(int stock=first;stock<last;stock++){int entry=routeIndex(stock,0);if(entry>=0)saveRoute(entry,sourceVolume(stock));}
    if(failed||!hasCrossRoute(first,last))return;
    bool vertical=p.gravitySign!=0&&(dyadicPresent(accepted(cell,3))||dyadicPresent(accepted(cell,4)));
    if(vertical)prepareDensity(first,last);
    int down=p.gravitySign>0?4:3,up=down==3?4:3;
    // Retain the original horizontal/down/up order with one compiled traversal body.
    [[dont_unroll]] for(int face=0;face<6;face++) {
        int slot=face<2?face+1:face<4?face+3:face==4?down:up;
        distributeFace(cell,first,last,slot,face>=4&&vertical,face==4);
    }
    // Exact retained total also detects caller budgets inconsistent with source inventory.
    int base=candidateCount()+3*cell,current=base;DyadicTerm retained=zero();
    [[dont_unroll]] for(int stock=first;stock<last&&!failed;stock++) {
        int next=current==base?base+1:base;
        retained=combine(retained,routed(routeIndex(stock,0)),1,next);current=next;
    }
    if(!failed&&compareVolume(retained,accepted(cell,0))!=0)fail();
}
void main() {
    uint id=(gl_WorkGroupID.y*gl_NumWorkGroups.x+gl_WorkGroupID.x)*128u+gl_LocalInvocationID.x;
    if(id>=uint(p.count))return;int item=int(id);
    if(p.stage==0){candidateWords[h(62)+item]=0u;candidateWords[route(R_SOURCE_MASKS)+item]=0u;}
    else if(p.stage==1)prepareCandidates(item);
    else if(p.stage==5)reserve(item);
    else if(p.stage==2&&errors==0u)splitCell(item);
}
