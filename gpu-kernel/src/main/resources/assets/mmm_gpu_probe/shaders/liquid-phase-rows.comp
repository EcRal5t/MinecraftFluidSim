}}
void measure(int row){
 int64_t mass=lpMass(p.header,row);double energy=lpEnergy(p.header,row);bool speciesPresent=false;
 if(mass<0l||isnan(energy)||isinf(energy)||(mass==0l&&energy!=0.0LF))atomicOr(errors,33554432u);
 for(int s=0;s<h(3);s++){int64_t q=lpSpecies(p.header,row,s);if(q<0l)atomicOr(errors,33554432u);speciesPresent=speciesPresent||q!=0l;}
 DyadicTerm items[7];terms(row,items);DyadicMeasure m=dyadicMeasure(items,7);int at=f(LP_RESULT)+8*row;
 words[at]=uint(m.status);words[at+1]=uint(m.words);words[at+2]=uint(m.exponent);words[at+3]=uint(m.minimumExponent);words[at+4]=uint(m.firstWord);words[at+5]=uint(m.lastWord);words[at+6]=uint(m.trailingBits);
