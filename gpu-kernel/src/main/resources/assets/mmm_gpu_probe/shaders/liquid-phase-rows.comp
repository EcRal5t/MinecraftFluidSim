#version 450
#extension GL_ARB_gpu_shader_fp64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
layout(local_size_x = 128) in;
layout(binding = 0, std430) buffer Arena {
    uint words[];
};
layout(binding = 1, std430) buffer Errors {
    uint errors;
};
layout(push_constant) uniform Params {
    int header;
    int stage;
    int count;
}
p;
// PHASE_ROWS_LIBRARY
// DYADIC_LIBRARY
uint dyadicWord(int bank, int at) {
    return words[at];
}
void dyadicWrite(int at, uint value) {
    words[at] = value;
}
int h(int i) {
    return lpH(p.header, i);
}
int f(int i) {
    return lpF(p.header, i);
}
int src(int i) {
    return lpS(p.header, i);
}
u64vec2 product(uint64_t a, uint64_t b) {
    uint64_t mask = uint64_t(0xffffffffu), low = (a & mask) * (b & mask), t = (a >> 32) * (b & mask) + (low >> 32),
             middle = (t & mask) + (a & mask) * (b >> 32);
    return u64vec2((middle << 32) | (low & mask), (a >> 32) * (b >> 32) + (t >> 32) + (middle >> 32));
}
void terms(int row, out DyadicTerm items[7]) {
    for (int i = 0; i < 7; i++)
        items[i] = DyadicTerm(1, 0, 0, 0, 0);
    if (row < h(LP_H_SLOT_COUNT) && row < int(words[src(LP_STOCK_COUNTS)])) {
        int begin = int(words[src(LP_STOCK_VOLUME_OFFSETS) + row]),
            count = int(words[src(LP_STOCK_VOLUME_COUNTS) + row]);
        items[0] = DyadicTerm(1, src(LP_STOCK_VOLUME_LIMBS) + begin, count,
                              int(words[src(LP_STOCK_VOLUME_EXPONENTS) + row]), count > 0 ? 1 : 0);
    }
    int64_t delta = lpInt(f(LP_FIELD_DELTA_SVQ) + 2 * row);
    if (delta != 0l) {
        u64vec2 q = product((delta < 0l ? uint64_t(0) - uint64_t(delta) : uint64_t(delta)),
                            uint64_t(lpInt(p.header + LP_H_VOLUME_SIGNIFICAND)));
        int at = f(LP_FIELD_DELTA_LIMBS) + 4 * row;
        words[at] = uint(q.x);
        words[at + 1] = uint(q.x >> 32);
        words[at + 2] = uint(q.y);
        words[at + 3] = uint(q.y >> 32);
        int count = q.y != 0UL ? (q.y >> 32 != 0UL ? 4 : 3) : (q.x >> 32 != 0UL ? 2 : 1);
        items[1] = DyadicTerm(1, at, count, h(LP_H_VOLUME_EXPONENT), delta > 0l ? 1 : -1);
    }
}
void initialize(int id) {
    if (id < h(LP_H_ROW_COUNT)) {
        words[f(LP_FIELD_LIVE) + id] = 0u;
        words[f(LP_FIELD_MIXTURE) + id] = 0u;
        words[f(LP_FIELD_CELL) + id] = uint(id / h(LP_H_MATERIAL_COUNT));
        words[f(LP_FIELD_MATERIAL) + id] = uint(id % h(LP_H_MATERIAL_COUNT));
        words[f(LP_FIELD_SUPPORT) + id] = 0u;
        for (int i = 0; i < 8; i++)
            words[f(LP_FIELD_VOLUME_RESULTS) + 8 * id + i] = 0u;
        lpIntAt(f(LP_FIELD_MASS) + 2 * id, 0l);
        lpIntAt(f(LP_FIELD_DELTA_SVQ) + 2 * id, 0l);
        lpDoubleAt(f(LP_FIELD_ENERGY) + 2 * id, 0.0LF);
        lpDoubleAt(f(LP_FIELD_BASE_VOLUME) + 2 * id, 0.0LF);
        for (int s = 0; s < h(LP_H_SPECIES_COUNT); s++)
            lpSpeciesAt(p.header, id, s, 0l);
    }
    if (id < h(LP_H_SLOT_COUNT)) {
        words[f(LP_FIELD_SPECIES_COUNTS) + id] = 0u;
        words[f(LP_FIELD_VOLUME_COUNTS) + id] = 0u;
        lpDoubleAt(f(LP_FIELD_OLD_ENERGY) + 2 * id, 0.0LF);
        lpDoubleAt(f(LP_FIELD_NEW_ENERGY) + 2 * id, 0.0LF);
    }
    if (id == 0) {
        words[f(LP_FIELD_VOLUME_OFFSETS) + h(LP_H_SLOT_COUNT)] = uint(4 * h(LP_H_STOCK_CAPACITY));
        for (int i = 0; i < 8; i++)
            words[f(LP_FIELD_CONTROL) + i] = 0u;
    }
}
void importCell(int cell) {
    int begin = int(words[src(LP_STOCK_CELL_OFFSETS) + cell]), end = int(words[src(LP_STOCK_CELL_OFFSETS) + cell + 1]);
    for (int row = begin; row < end; row++) {
        words[f(LP_FIELD_CELL) + row] = uint(cell);
        words[f(LP_FIELD_MATERIAL) + row] = words[src(LP_STOCK_MATERIALS) + row];
        words[f(LP_FIELD_SUPPORT) + row] = words[src(LP_STOCK_SUPPORT_MASKS) + row];
        words[f(LP_FIELD_MIXTURE) + row] = words[src(LP_STOCK_MIXTURE_PRESENT) + row];
        words[f(LP_FIELD_LIVE) + row] = words[src(LP_STOCK_VOLUME_COUNTS) + row] > 0u ? 1u : 0u;
        lpIntAt(f(LP_FIELD_MASS) + 2 * row, lpInt(src(LP_STOCK_MASS_UNITS) + 2 * row));
        double u = lpDouble(src(LP_STOCK_ENERGY_BITS) + 2 * row);
        lpDoubleAt(f(LP_FIELD_ENERGY) + 2 * row, u);
        lpDoubleAt(f(LP_FIELD_OLD_ENERGY) + 2 * row, u);
        lpDoubleAt(f(LP_FIELD_BASE_VOLUME) + 2 * row, lpDouble(src(LP_STOCK_NUMERIC_VOLUMES) + 2 * row));
        for (int at = int(words[src(LP_STOCK_SPECIES_OFFSETS) + row]);
             at < int(words[src(LP_STOCK_SPECIES_OFFSETS) + row + 1]); at++)
            lpSpeciesAt(p.header, row, int(words[src(LP_STOCK_SPECIES_HANDLES) + at]),
                        lpInt(src(LP_STOCK_SPECIES_AMOUNTS) + 2 * at));
    }
}
void measure(int row) {
    int64_t mass = lpMass(p.header, row);
    double energy = lpEnergy(p.header, row);
    bool speciesPresent = false;
    if (mass < 0l || isnan(energy) || isinf(energy) || (mass == 0l && energy != 0.0LF))
        atomicOr(errors, 33554432u);
    for (int s = 0; s < h(LP_H_SPECIES_COUNT); s++) {
        int64_t q = lpSpecies(p.header, row, s);
        if (q < 0l)
            atomicOr(errors, 33554432u);
        speciesPresent = speciesPresent || q != 0l;
    }
    DyadicTerm items[7];
    terms(row, items);
    DyadicMeasure m = dyadicMeasure(items, 7);
    int at = f(LP_FIELD_VOLUME_RESULTS) + 8 * row;
    words[at] = uint(m.status);
    words[at + 1] = uint(m.words);
    words[at + 2] = uint(m.exponent);
    words[at + 3] = uint(m.minimumExponent);
    words[at + 4] = uint(m.firstWord);
    words[at + 5] = uint(m.lastWord);
    words[at + 6] = uint(m.trailingBits);
    if (m.status == DYADIC_ZERO) {
        if (mass != 0l || energy != 0.0LF || speciesPresent)
            atomicOr(errors, 33554432u);
        words[f(LP_FIELD_LIVE) + row] = 0u;
    } else if (m.status == DYADIC_POSITIVE) {
        uint support = words[f(LP_FIELD_SUPPORT) + row];
        if (support == 0u || support > 255u)
            atomicOr(errors, 33554432u);
        words[f(LP_FIELD_LIVE) + row] = 1u;
    } else
        atomicOr(errors, 33554432u);
}
void countCapacity() {
    words[f(LP_FIELD_CONTROL) + 1] = uint(h(LP_H_SLOT_COUNT));
}
void rowCounts(int outRow) {
    if (words[f(LP_FIELD_CONTROL)] != 0u || outRow >= int(words[f(LP_FIELD_CONTROL) + 1]))
        return;
    int row = outRow, count = 0;
    if (words[f(LP_FIELD_LIVE) + row] == 0u) {
        words[f(LP_FIELD_SPECIES_COUNTS) + outRow] = 0u;
        words[f(LP_FIELD_VOLUME_COUNTS) + outRow] = 0u;
        words[f(LP_FIELD_VOLUME_OFFSETS) + outRow] = uint(4 * outRow);
        return;
    }
    for (int s = 0; s < h(LP_H_SPECIES_COUNT); s++)
        if (lpSpecies(p.header, row, s) > 0l)
            count++;
    words[f(LP_FIELD_SPECIES_COUNTS) + outRow] = uint(count);
    uint countWords = words[f(LP_FIELD_VOLUME_RESULTS) + 8 * row + 1];
    words[f(LP_FIELD_VOLUME_COUNTS) + outRow] = countWords;
    words[f(LP_FIELD_VOLUME_OFFSETS) + outRow] =
        countWords <= 4u ? 4u * uint(outRow)
                         : atomicAdd(words[f(LP_FIELD_VOLUME_OFFSETS) + h(LP_H_SLOT_COUNT)], countWords);
    lpDoubleAt(f(LP_FIELD_NEW_ENERGY) + 2 * outRow, lpEnergy(p.header, row));
}
void storageCapacity() {
    uint species = words[f(LP_FIELD_SPECIES_OFFSETS) + h(LP_H_SLOT_COUNT)],
         limbs = words[f(LP_FIELD_VOLUME_OFFSETS) + h(LP_H_SLOT_COUNT)];
    words[f(LP_FIELD_CONTROL) + 2] = species;
    words[f(LP_FIELD_CONTROL) + 3] = limbs;
    if (species > uint(h(LP_H_SPECIES_CAPACITY)) || limbs > uint(h(LP_H_LIMB_CAPACITY)))
        atomicMax(words[f(LP_FIELD_CONTROL)], 1u);
    if (words[f(LP_FIELD_CONTROL)] == 0u)
        words[f(LP_FIELD_CONTROL)] = 2u;
}
uint volumeWord(int begin, int count, int index) {
    return index >= 0 && index < count ? words[f(LP_FIELD_VOLUME_LIMBS) + begin + index] : 0u;
}
// The numerical view is rounded once from the exact published result, including near-total withdrawal.
double numericVolume(int begin, int count, int exponent) {
    if (count == 0)
        return 0.0LF;
    int bits = 32 * (count - 1) + findMSB(volumeWord(begin, count, count - 1)) + 1;
    int64_t highest = int64_t(exponent) + int64_t(bits - 1);
    if (highest > 1023l) {
        atomicOr(errors, 33554432u);
        return 0.0LF;
    }
    if (highest < -1075l)
        return 0.0LF;
    int unit = int(max(-1074l, highest - 52l));
    int64_t discarded = int64_t(unit) - int64_t(exponent);
    if (discarded <= 0l) {
        uint64_t value = uint64_t(volumeWord(begin, count, 0)) | (uint64_t(volumeWord(begin, count, 1)) << 32);
        return ldexp(double(value), exponent);
    }
    int at = int(discarded >> 5), shift = int(discarded & 31l);
    uint low = volumeWord(begin, count, at) >> shift, high = volumeWord(begin, count, at + 1) >> shift;
    if (shift != 0) {
        low |= volumeWord(begin, count, at + 1) << (32 - shift);
        high |= volumeWord(begin, count, at + 2) << (32 - shift);
    }
    uint64_t rounded = uint64_t(low) | (uint64_t(high) << 32);
    int guard = int(discarded - 1l);
    bool halfway = (volumeWord(begin, count, guard / 32) & (1u << (guard & 31))) != 0u;
    if (halfway && (discarded > 1l || (rounded & 1UL) != 0UL))
        rounded++;
    return ldexp(double(rounded), unit);
}
int64_t massResidual(int row) {
    uint64_t total = 0UL;
    for (int s = 0; s < h(LP_H_SPECIES_COUNT); s++) {
        int64_t amount = lpSpecies(p.header, row, s);
        if (amount == 0l)
            continue;
        int def = h(LP_H_DEFINITIONS), speciesTable = int(words[def + 1]);
        int64_t massUnit = lpInt(def + speciesTable + 5 * s + 1);
        if (amount < 0l || massUnit < 0l) {
            atomicOr(errors, 33554432u);
            return 0l;
        }
        u64vec2 q = product(uint64_t(amount), uint64_t(massUnit));
        if (q.y != 0UL || q.x > ~0UL - total) {
            atomicOr(errors, 33554432u);
            return 0l;
        }
        total += q.x;
    }
    uint64_t mass = uint64_t(lpMass(p.header, row));
    if (total > mass) {
        uint64_t difference = total - mass;
        if (difference > 0x8000000000000000UL) {
            atomicOr(errors, 33554432u);
            return 0l;
        }
        return int64_t(0UL - difference);
    }
    return int64_t(mass - total);
}
void writeRow(int outRow) {
    if (words[f(LP_FIELD_CONTROL)] != 2u || outRow >= int(words[f(LP_FIELD_CONTROL) + 1]))
        return;
    int row = outRow, at = int(words[f(LP_FIELD_SPECIES_OFFSETS) + outRow]);
    if (words[f(LP_FIELD_LIVE) + row] == 0u)
        return;
    for (int s = 0; s < h(LP_H_SPECIES_COUNT); s++) {
        int64_t q = lpSpecies(p.header, row, s);
        if (q > 0l) {
            words[f(LP_FIELD_SPECIES_HANDLES) + at] = uint(s);
            lpIntAt(f(LP_FIELD_SPECIES_AMOUNTS) + 2 * at, q);
            at++;
        }
    }
    int a = f(LP_FIELD_VOLUME_RESULTS) + 8 * row;
    DyadicMeasure m = DyadicMeasure(int(words[a]), int(words[a + 1]), int(words[a + 2]), int(words[a + 3]),
                                    int(words[a + 4]), int(words[a + 5]), int(words[a + 6]));
    DyadicTerm items[7];
    terms(row, items);
    int begin = int(words[f(LP_FIELD_VOLUME_OFFSETS) + outRow]);
    dyadicWriteSum(items, 7, m, f(LP_FIELD_VOLUME_LIMBS) + begin);
    double volume = numericVolume(begin, m.words, m.exponent);
    if (!(volume > 0.0LF) || isnan(volume) || isinf(volume))
        atomicOr(errors, 33554432u);
    lpDoubleAt(f(LP_FIELD_NUMERIC_VOLUME) + 2 * row, volume);
    lpIntAt(f(LP_FIELD_MASS_RESIDUAL) + 2 * row, massResidual(row));
}
void publish(int id) {
    if (words[f(LP_FIELD_CONTROL)] != 2u)
        return;
    if (id <= h(LP_H_SLOT_COUNT)) {
        words[src(LP_STOCK_SPECIES_OFFSETS) + id] = words[f(LP_FIELD_SPECIES_OFFSETS) + id];
        words[src(LP_STOCK_VOLUME_OFFSETS) + id] = words[f(LP_FIELD_VOLUME_OFFSETS) + id];
    }
    if (id <= h(LP_H_CELL_COUNT))
        words[src(LP_STOCK_CELL_OFFSETS) + id] = uint(id * h(LP_H_MATERIAL_COUNT));
    if (id > h(LP_H_SLOT_COUNT) && id <= h(LP_H_STOCK_CAPACITY)) {
        words[src(LP_STOCK_SPECIES_OFFSETS) + id] = words[f(LP_FIELD_CONTROL) + 2];
        words[src(LP_STOCK_VOLUME_OFFSETS) + id] =
            id == h(LP_H_STOCK_CAPACITY) ? words[f(LP_FIELD_CONTROL) + 3] : uint(4 * id);
    }
    if (id >= h(LP_H_SLOT_COUNT) && id < h(LP_H_STOCK_CAPACITY)) {
        words[src(LP_STOCK_MATERIALS) + id] = 0u;
        words[src(LP_STOCK_SUPPORT_MASKS) + id] = 0u;
        words[src(LP_STOCK_VOLUME_COUNTS) + id] = 0u;
        words[src(LP_STOCK_VOLUME_EXPONENTS) + id] = 0u;
        words[src(LP_STOCK_MIXTURE_PRESENT) + id] = 0u;
        lpIntAt(src(LP_STOCK_MASS_UNITS) + 2 * id, 0l);
        lpDoubleAt(src(LP_STOCK_ENERGY_BITS) + 2 * id, 0.0LF);
        lpIntAt(src(LP_STOCK_MASS_RESIDUAL_UNITS) + 2 * id, 0l);
        lpDoubleAt(src(LP_STOCK_NUMERIC_VOLUMES) + 2 * id, 0.0LF);
    }
    if (id < int(words[f(LP_FIELD_CONTROL) + 2])) {
        words[src(LP_STOCK_SPECIES_HANDLES) + id] = words[f(LP_FIELD_SPECIES_HANDLES) + id];
        lpIntAt(src(LP_STOCK_SPECIES_AMOUNTS) + 2 * id, lpInt(f(LP_FIELD_SPECIES_AMOUNTS) + 2 * id));
    }
    if (id < int(words[f(LP_FIELD_CONTROL) + 3]))
        words[src(LP_STOCK_VOLUME_LIMBS) + id] = words[f(LP_FIELD_VOLUME_LIMBS) + id];
    if (id < int(words[f(LP_FIELD_CONTROL) + 1])) {
        int row = id;
        bool live = words[f(LP_FIELD_LIVE) + row] != 0u;
        words[src(LP_STOCK_MATERIALS) + id] = words[f(LP_FIELD_MATERIAL) + row];
        words[src(LP_STOCK_SUPPORT_MASKS) + id] = live ? words[f(LP_FIELD_SUPPORT) + row] : 0u;
        words[src(LP_STOCK_MIXTURE_PRESENT) + id] =
            live ? (words[f(LP_FIELD_SPECIES_COUNTS) + id] > 0u ? 1u : words[f(LP_FIELD_MIXTURE) + row]) : 0u;
        lpIntAt(src(LP_STOCK_MASS_UNITS) + 2 * id, live ? lpMass(p.header, row) : 0l);
        lpDoubleAt(src(LP_STOCK_ENERGY_BITS) + 2 * id, live ? lpEnergy(p.header, row) : 0.0LF);
        lpDoubleAt(src(LP_STOCK_NUMERIC_VOLUMES) + 2 * id,
                   live ? lpDouble(f(LP_FIELD_NUMERIC_VOLUME) + 2 * row) : 0.0LF);
        words[src(LP_STOCK_VOLUME_COUNTS) + id] = words[f(LP_FIELD_VOLUME_COUNTS) + id];
        words[src(LP_STOCK_VOLUME_EXPONENTS) + id] = live ? words[f(LP_FIELD_VOLUME_RESULTS) + 8 * row + 2] : 0u;
        lpIntAt(src(LP_STOCK_MASS_RESIDUAL_UNITS) + 2 * id, live ? lpInt(f(LP_FIELD_MASS_RESIDUAL) + 2 * row) : 0l);
    }

    if (id == 0) {
        words[src(LP_STOCK_COUNTS)] = uint(h(LP_H_SLOT_COUNT));
        words[src(LP_STOCK_COUNTS) + 1] = words[f(LP_FIELD_CONTROL) + 2];
        words[src(LP_STOCK_COUNTS) + 2] = words[f(LP_FIELD_CONTROL) + 3];
    }
}
void main() {
    int id = int((gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x) * 128u + gl_LocalInvocationID.x);
    if (id >= p.count)
        return;
    if (p.stage == 0) {
        initialize(id);
        return;
    }
    if (errors != 0u)
        return;
    if (p.stage == 1)
        importCell(id);
    else if (p.stage == 2)
        measure(id);
    else if (p.stage == 4)
        countCapacity();
    else if (p.stage == 6)
        rowCounts(id);
    else if (p.stage == 7)
        storageCapacity();
    else if (p.stage == 8)
        writeRow(id);
    else if (p.stage == 9)
        publish(id);
}
