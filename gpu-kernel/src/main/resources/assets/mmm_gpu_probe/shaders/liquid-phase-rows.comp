  if(mass!=0l||energy!=0.0LF||speciesPresent)atomicOr(errors,33554432u);words[f(LP_LIVE)+row]=0u;
 }else if(m.status==DYADIC_POSITIVE){
  uint support=words[f(LP_SUPPORT)+row];if(support==0u||support>255u)atomicOr(errors,33554432u);words[f(LP_LIVE)+row]=1u;
 }else atomicOr(errors,33554432u);
}
void countCapacity(){words[f(LP_CONTROL)+1]=uint(h(1));}
void rowCounts(int outRow){if(words[f(LP_CONTROL)]!=0u||outRow>=int(words[f(LP_CONTROL)+1]))return;int row=outRow,count=0;
 if(words[f(LP_LIVE)+row]==0u){words[f(LP_SPEC_COUNT)+outRow]=0u;words[f(LP_VOL_COUNT)+outRow]=0u;words[f(LP_VOL_OFFSET)+outRow]=uint(4*outRow);return;}
