void storageCapacity(){uint species=words[f(LP_SPEC_OFFSET)+h(1)],limbs=words[f(LP_VOL_OFFSET)+h(1)];words[f(LP_CONTROL)+2]=species;words[f(LP_CONTROL)+3]=limbs;
 if(species>uint(h(5))||limbs>uint(h(6)))atomicMax(words[f(LP_CONTROL)],1u);if(words[f(LP_CONTROL)]==0u)words[f(LP_CONTROL)]=2u;}
uint volumeWord(int begin,int count,int index){return index>=0&&index<count?words[f(LP_VOL_LIMBS)+begin+index]:0u;}
// The numerical view is rounded once from the exact published result, including near-total withdrawal.
double numericVolume(int begin,int count,int exponent){
 if(count==0)return 0.0LF;
 int bits=32*(count-1)+findMSB(volumeWord(begin,count,count-1))+1;
 int64_t highest=int64_t(exponent)+int64_t(bits-1);if(highest>1023l){atomicOr(errors,33554432u);return 0.0LF;}
 if(highest< -1075l)return 0.0LF;
 int unit=int(max(-1074l,highest-52l));int64_t discarded=int64_t(unit)-int64_t(exponent);
 if(discarded<=0l){uint64_t value=uint64_t(volumeWord(begin,count,0))|(uint64_t(volumeWord(begin,count,1))<<32);return ldexp(double(value),exponent);}
 int at=int(discarded>>5),shift=int(discarded&31l);uint low=volumeWord(begin,count,at)>>shift,high=volumeWord(begin,count,at+1)>>shift;
 if(shift!=0){low|=volumeWord(begin,count,at+1)<<(32-shift);high|=volumeWord(begin,count,at+2)<<(32-shift);}
 uint64_t rounded=uint64_t(low)|(uint64_t(high)<<32);int guard=int(discarded-1l);
 bool halfway=(volumeWord(begin,count,guard/32)&(1u<<(guard&31)))!=0u;
 if(halfway&&(discarded>1l||(rounded&1UL)!=0UL))rounded++;
 return ldexp(double(rounded),unit);
}
int64_t massResidual(int row){
 uint64_t total=0UL;
 for(int s=0;s<h(3);s++){
  int64_t amount=lpSpecies(p.header,row,s);if(amount==0l)continue;
  int def=h(68),speciesTable=int(words[def+1]);int64_t massUnit=lpInt(def+speciesTable+5*s+1);
  if(amount<0l||massUnit<0l){atomicOr(errors,33554432u);return 0l;}
  u64vec2 q=product(uint64_t(amount),uint64_t(massUnit));
  if(q.y!=0UL||q.x>~0UL-total){atomicOr(errors,33554432u);return 0l;}total+=q.x;
 }
 uint64_t mass=uint64_t(lpMass(p.header,row));
 if(total>mass){uint64_t difference=total-mass;if(difference>0x8000000000000000UL){atomicOr(errors,33554432u);return 0l;}return int64_t(0UL-difference);}
