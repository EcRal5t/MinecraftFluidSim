void updatePositive(int index){if(index<get(STATE,12))countPositive(get(CHANGED_VERTICES,index));}
// Returning a preferred route to its donor keeps all integer supply quotas exact.
// A feasible stationary allocation permits one local withdrawal before residual balancing.
void checkStationaryGroup(int group){if(read(GROUP_BASE,group)>upper(8*n()+group))atomicOr(words[at(STATE)+13],1u);}
void startCorrection(){put(STATE,0,get(STATE,13)==0?3:6);}
void clearRetractions(int id){if(id<7*n())write(PROPOSAL,id,0l);
 if(id<groups()){write(GROUP_INCOMING,id,0l);write(GROUP_WITHDRAW,id,0l);}if(id==0)put(STATE,15,0);
}
void actualIncoming(int cell){int64_t incoming=flow(7*cell);
 for(int side=0;side<6;side++){int donor=neighbor(cell,side);if(donor>=0)incoming=add(incoming,flow(7*donor+1+(side^1)));}
 write(CELL_INCOMING,cell,incoming);atomicAdd(integers[at(GROUP_INCOMING)/2+groupOf(cell)],incoming);
}
void retract(int e,int64_t amount){if(amount>0l)atomicMax(integers[at(PROPOSAL)/2+e],amount);}
void requestRetractions(int cell){
 int64_t incoming=read(CELL_INCOMING,cell),excess=max(0l,incoming-capacityValue(CU,cell)),deficit=max(0l,capacityValue(CL,cell)-incoming);
