  int donor=neighbor(cell,side);if(donor>=0&&excess>0l){int e=7*donor+1+(side^1);int64_t take=min(excess,flow(e));retract(e,take);excess-=take;}
  int own=7*cell+side+1;int64_t take=min(deficit,flow(own));retract(own,take);deficit-=take;
 }
