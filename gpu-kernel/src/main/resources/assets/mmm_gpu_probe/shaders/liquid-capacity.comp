int64_t add(int64_t a,int64_t b){if((b>0l&&a>MAX_VALUE-b)||(b<0l&&a<-MAX_VALUE-b)){invalid();return 0l;}return a+b;}
int neighbor(int cell,int side){int x=cell%ch(0),y=cell/ch(0)%ch(1),z=cell/(ch(0)*ch(1));
