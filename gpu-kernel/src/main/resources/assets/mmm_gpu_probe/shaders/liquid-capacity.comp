#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_atomic_int64 : require
layout(local_size_x = 128) in;
layout(binding = 0, std430) buffer Arena {
    uint words[];
};
layout(binding = 1, std430) buffer Errors {
    uint errors;
};
layout(binding = 2, std430) buffer AtomicArena {
    int64_t integers[];
};
layout(push_constant) uniform Params {
    int header;
    int stage;
    int count;
    int argument;
    int mode;
}
p;
// HOST_LAYOUT

const int LOCAL_WITHDRAWAL_ROUNDS = 32;
const int INFINITY = 0x3fffffff;
const int64_t INF = int64_t(0x3fffffffffffffffUL), MAX_VALUE = int64_t(0x7fffffffffffffffUL);
shared int64_t reduction[128];
int h(int i) {
    return int(words[p.header + i]);
}
int at(int f) {
    return h(WORK_FIELDS + f);
}
int ch(int i) {
    return int(words[h(H_CAPACITY_HEADER) + i]);
}
int ca(int f) {
    return ch(CAPACITY_FIELDS + f);
}
int n() {
    return h(H_CELL_COUNT);
}
int groups() {
    return h(H_GROUP_COUNT);
}
int sink() {
