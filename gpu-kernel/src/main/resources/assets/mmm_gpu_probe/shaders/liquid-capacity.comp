const int INFINITY=0x3fffffff;const int64_t INF=int64_t(0x3fffffffffffffffUL),MAX_VALUE=int64_t(0x7fffffffffffffffUL);
shared int64_t reduction[128];
int h(int i){return int(words[p.header+i]);}int at(int f){return h(16+f);}int ch(int i){return int(words[h(0)+i]);}int ca(int f){return ch(8+f);}
