}
int64_t flow(int e) {
    return e < 7 * n() ? capacityValue(CAPACITY_FLOW, e) : read(FIELD_TAIL_FLOW, e - 7 * n());
}
void writeFlow(int e, int64_t x) {
    if (e < 7 * n())
        writeNumber(ca(CAPACITY_FLOW) + 2 * e, x);
    else
        write(FIELD_TAIL_FLOW, e - 7 * n(), x);
}
int distance(int vertex) {
    return int(atomicAdd(words[at(FIELD_DISTANCE) + vertex], 0u));
}
void initialize(int id) {
    if (id < h(H_VERTEX_COUNT)) {
        put(FIELD_LABEL_CHANGED, id, 0);
        write(FIELD_EXCESS, id, 0l);
        put(FIELD_DISTANCE, id, INFINITY);
    }
    if (id < n())
        put(FIELD_CUT_CELLS, id, 0);
    if (id < groups())
        write(FIELD_GROUP_BASE, id, 0l);
    if (id == 0) {
        for (int i = 0; i < 12; i++)
            putControl(i, 0);
        putControl(5, p.argument);
        for (int i = 0; i < 20; i++)
            put(FIELD_STATE, i, 0);
        put(FIELD_STATE, 8, INFINITY);
        put(FIELD_STATE, 0, -1);
        put(FIELD_STATE, 16, 1);
    }
}
void seedDonor(int cell) {
    int group = int(words[ca(CAPACITY_GROUP_ID) + cell]), open = int(words[ca(CAPACITY_OPEN_NEIGHBORS) + cell]);
    int64_t k = capacityValue(CAPACITY_K, cell), lo = capacityValue(CAPACITY_LOWER, cell),
            hi = capacityValue(CAPACITY_UPPER, cell);
    if (group < -1 || group >= groups() - 1 || k < 0l || k > INF / (8l * int64_t(n())) || lo < 0l || hi < lo ||
        hi > INF / int64_t(n()) || (open & ~63) != 0) {
        invalid();
        return;
    }
    if (group >= 0 &&
        (capacityValue(CAPACITY_GROUP_CAPACITY, group) < 0l || capacityValue(CAPACITY_GROUP_CAPACITY, group) > INF)) {
        invalid();
        return;
    }
    if (lo > k || hi < k)
        atomicOr(words[at(FIELD_STATE) + 13], 1u);
    atomicAdd(integers[at(FIELD_GROUP_BASE) / 2 + groupOf(cell)], k);
    int64_t remaining = k;
    for (int slot = 1; slot < 7; slot++) {
        int other = neighbor(cell, slot - 1);
        if (other < 0 && (open & (1 << (slot - 1))) != 0) {
            invalid();
            return;
        }
        int64_t preferred = capacityValue(CAPACITY_PREFERRED, 7 * cell + slot);
        if (preferred < 0l) {
            invalid();
            return;
        }
        int64_t amount = (open & (1 << (slot - 1))) != 0 ? min(remaining, preferred) : 0l;
        writeFlow(7 * cell + slot, amount);
        remaining -= amount;
    }
    writeFlow(7 * cell, remaining);
}
void prepareGroups(int group) {
    put(FIELD_GROUP_COUNTS, group, 0);
    put(FIELD_GROUP_CURSORS, group, 0);
    write(FIELD_GROUP_INCOMING, group, 0l);
    put(FIELD_LONG_BLOCK_COUNTS, group, 0);
    if (group == 0)
        put(FIELD_LONG_BLOCK_COUNTS, groups(), 0);
    if (group == 0) {
        put(FIELD_STATE, 0, -1);
        put(FIELD_STATE, 4, 0);
        put(FIELD_STATE, 17, 0);
        put(FIELD_STATE, 19, 0);
    }
}
void balanceReceiver(int cell) {
    int64_t incoming = flow(7 * cell);
    for (int side = 0; side < 6; side++) {
        int donor = neighbor(cell, side);
        if (donor >= 0)
            incoming = add(incoming, flow(7 * donor + 1 + (side ^ 1)));
    }
    int64_t tail = clamp(incoming, capacityValue(CAPACITY_LOWER, cell), capacityValue(CAPACITY_UPPER, cell));
    writeFlow(7 * n() + cell, tail);
    int64_t excess = incoming - tail;
    write(FIELD_EXCESS, n() + cell, excess);
    if (excess > 0l)
        atomicAdd(words[at(FIELD_STATE) + 4], 1u);
    int group = groupOf(cell);
    atomicAdd(integers[at(FIELD_GROUP_INCOMING) / 2 + group], tail);
    if (capacityValue(CAPACITY_UPPER, cell) > 0l)
        atomicAdd(words[at(FIELD_GROUP_COUNTS) + group], 1u);
}
void scatterMember(int cell) {
    if (get(FIELD_STATE, 0) != 3 && capacityValue(CAPACITY_UPPER, cell) <= 0l)
        return;
    int group = groupOf(cell);
    int index = int(atomicAdd(words[at(FIELD_GROUP_CURSORS) + group], 1u));
    put(FIELD_GROUP_MEMBERS, get(FIELD_GROUP_OFFSETS, group) + index, cell);
}
void reduce(int lane) {
    for (int step = 64; step > 0; step >>= 1) {
        barrier();
        if (lane < step)
            reduction[lane] = add(reduction[lane], reduction[lane + step]);
    }
    barrier();
}
void totalBlock(int block, int lane) {
    int cell = 128 * block + lane;
    reduction[lane] = cell < n() ? capacityValue(CAPACITY_K, cell) : 0l;
    reduce(lane);
    if (lane == 0)
        write(FIELD_TOTAL_PARTS, block, reduction[0]);
}
void total() {
    int64_t result = 0l;
    for (int block = 0; block < h(H_TOTAL_BLOCKS); block++)
        result = add(result, read(FIELD_TOTAL_PARTS, block));
    write(FIELD_TOTAL, 0, result);
    write(FIELD_EXCESS, sink(), -result);
}
int incidentCount(int vertex) {
    if (vertex < n())
        return 7;
    if (vertex < 2 * n())
        return 8;
    if (vertex == sink())
        return get(FIELD_STATE, 19);
    int group = vertex - 2 * n();
    return get(FIELD_GROUP_OFFSETS, group + 1) - get(FIELD_GROUP_OFFSETS, group) + 1;
}
int incidentEdge(int vertex, int index) {
    int edge;
    if (vertex < n())
        edge = 7 * vertex + index;
    else if (vertex < 2 * n()) {
        int cell = vertex - n();
        if (index == 0)
            edge = 7 * cell;
        else if (index == 7)
            edge = 7 * n() + cell;
        else {
            int side = index - 1, donor = neighbor(cell, side);
            if (donor < 0)
                return -1;
            edge = 7 * donor + 1 + (side ^ 1);
        }
    } else if (vertex == sink())
        edge = get(FIELD_SINK_EDGES, index);
    else {
        int group = vertex - 2 * n(), first = get(FIELD_GROUP_OFFSETS, group),
            count = get(FIELD_GROUP_OFFSETS, group + 1) - first;
        edge = index < count ? 7 * n() + get(FIELD_GROUP_MEMBERS, first + index) : 8 * n() + group;
    }
    return upper(edge) > 0l ? edge : -1;
}
void classifyLong(int vertex) {
    int count = incidentCount(vertex);
    if (count > 128) {
        int slot = int(atomicAdd(words[at(FIELD_STATE) + 17], 1u));
        put(FIELD_LONG_VERTICES, slot, vertex);
        put(FIELD_LONG_BLOCK_COUNTS, slot, (count + 127) / 128);
    }
}
void mapLongBlocks(int index) {
    if (index >= get(FIELD_STATE, 17))
        return;
    for (int block = get(FIELD_LONG_BLOCK_OFFSETS, index); block < get(FIELD_LONG_BLOCK_OFFSETS, index + 1); block++)
        put(FIELD_LONG_BLOCK_OWNER, block, index);
}
void seedGroup(int group) {
    int64_t incoming = read(FIELD_GROUP_INCOMING, group), tail = clamp(incoming, 0l, upper(8 * n() + group));
    writeFlow(8 * n() + group, tail);
    atomicAdd(integers[at(FIELD_EXCESS) / 2 + sink()], tail);
    int64_t excess = incoming - tail;
    write(FIELD_EXCESS, 2 * n() + group, excess);
    if (excess > 0l)
        atomicAdd(words[at(FIELD_STATE) + 4], 1u);
    if (upper(8 * n() + group) > 0l) {
        int index = int(atomicAdd(words[at(FIELD_STATE) + 19], 1u));
        put(FIELD_SINK_EDGES, index, 8 * n() + group);
    }
    classifyLong(2 * n() + group);
}
void balanceSink() {
    if (read(FIELD_EXCESS, sink()) > 0l)
        atomicAdd(words[at(FIELD_STATE) + 4], 1u);
    classifyLong(sink());
}
int vertexColor(int vertex) {
    return vertex < n() || (vertex >= 2 * n() && vertex < sink()) ? 0 : 1;
}
void dispatchSize(int slot, int size) {
    int workgroups = (size + 127) / 128;
    put(FIELD_DISPATCH, 3 * slot, min(workgroups, 65535));
    put(FIELD_DISPATCH, 3 * slot + 1, max(1, (workgroups + 65534) / 65535));
    put(FIELD_DISPATCH, 3 * slot + 2, 1);
}
void updateDispatch() {
    bool running = control(0) == 0 && get(FIELD_STATE, 16) != 0;
    int state = get(FIELD_STATE, 0);
    putControl(2, state);
    dispatchSize(0, running && state == 0 ? h(H_VERTEX_COUNT) : 0);
    dispatchSize(1, running && state == 1 ? h(H_EDGE_COUNT) : 0);
    dispatchSize(2, running && state == 2 ? h(H_VERTEX_COUNT) : 0);
    dispatchSize(3, running && state == 2 ? get(FIELD_STATE, 17) : 0);
    dispatchSize(4, running && state == 2 ? 128 * get(FIELD_STATE, 17) : 0);
    dispatchSize(6, running && state == 2 ? 128 * get(FIELD_LONG_BLOCK_OFFSETS, get(FIELD_STATE, 17)) : 0);
    dispatchSize(5, running ? 1 : 0);
}
void start() {
    if (get(FIELD_STATE, 4) == 0)
        putControl(0, 1);
    else
        put(FIELD_STATE, 0, 0);
}
void seedDistance(int vertex) {
    if (get(FIELD_STATE, 0) != 0)
        return;
    put(FIELD_LABEL_CHANGED, vertex, 0);
    put(FIELD_DISTANCE, vertex, read(FIELD_EXCESS, vertex) < 0l ? 0 : INFINITY);
}
void beginBfs() {
    if (get(FIELD_STATE, 0) == 0) {
        put(FIELD_STATE, 0, 1);
        put(FIELD_STATE, 1, 0);
        put(FIELD_STATE, 2, 0);
        put(FIELD_STATE, 5, 0);
    }
}
void discover(int vertex, int value) {
    if (atomicCompSwap(words[at(FIELD_DISTANCE) + vertex], uint(INFINITY), uint(value)) == uint(INFINITY)) {
        atomicOr(words[at(FIELD_STATE) + 2], 1u);
        if (read(FIELD_EXCESS, vertex) > 0l)
            atomicOr(words[at(FIELD_STATE) + 5], 1u);
    }
}
void bfsEdge(int e) {
    if (get(FIELD_STATE, 0) != 1 || upper(e) == 0l)
        return;
    ivec2 v = endpoints(e);
    int wave = get(FIELD_STATE, 1);
    if (flow(e) < upper(e) && distance(v.y) == wave)
        discover(v.x, wave + 1);
    if (flow(e) > lower(e) && distance(v.x) == wave)
        discover(v.y, wave + 1);
}
void finishBfs() {
    if (get(FIELD_STATE, 0) != 1)
        return;
    put(FIELD_STATE, 6, get(FIELD_STATE, 6) + 1);
    if (get(FIELD_STATE, 2) != 0) {
        put(FIELD_STATE, 1, get(FIELD_STATE, 1) + 1);
        put(FIELD_STATE, 2, 0);
    } else if (get(FIELD_STATE, 5) == 0)
        putControl(0, 2);
    else
        put(FIELD_STATE, 0, 2);
}
void beginDischarge(int e) {
    if (get(FIELD_STATE, 0) != 2)
        return;
    put(FIELD_STATE, 18, 0);
    put(FIELD_STATE, 15, 0);
}
int64_t residualFrom(int vertex, int edge) {
    ivec2 v = endpoints(edge);
    return v.x == vertex ? upper(edge) - flow(edge) : flow(edge) - lower(edge);
}
int peerOf(int vertex, int edge) {
    ivec2 v = endpoints(edge);
    return v.x == vertex ? v.y : v.x;
}
int64_t pushDirect(int vertex, int edge, int64_t amount) {
    if (amount <= 0l)
        return 0l;
    ivec2 v = endpoints(edge);
    bool forward = v.x == vertex;
    int peer = forward ? v.y : v.x;
    int address = at(FIELD_EXCESS) / 2 + peer;
    int64_t old;
    if (distance(peer) == 0) {
        old = atomicAdd(integers[address], 0l);
        for (;;) {
            if (old >= 0l) {
                atomicOr(words[at(FIELD_LABEL_CHANGED) + peer], 1u);
                return 0l;
            }
            int64_t grant = min(amount, -old), prior = atomicCompSwap(integers[address], old, old + grant);
            if (prior == old) {
                amount = grant;
                break;
            }
            old = prior;
        }
        if (old + amount == 0l)
            atomicOr(words[at(FIELD_LABEL_CHANGED) + peer], 1u);
    } else
        old = atomicAdd(integers[address], amount);
    atomicOr(words[at(FIELD_STATE) + 15], 1u);
    writeFlow(edge, flow(edge) + (forward ? amount : -amount));
    if (old + amount > 0l)
        atomicOr(words[at(FIELD_STATE) + 18], 1u);
    return amount;
}
void notifyHeight(int vertex, int edge) {
    ivec2 v = endpoints(edge);
    bool incoming = v.y == vertex;
    if ((incoming ? upper(edge) - flow(edge) : flow(edge) - lower(edge)) > 0l) {
        int peer = incoming ? v.x : v.y;
        atomicOr(words[at(FIELD_LABEL_CHANGED) + peer], 1u);
    }
}
void finishDischarge(int vertex, int64_t remaining, int nearest) {
    write(FIELD_EXCESS, vertex, remaining);
    if (remaining <= 0l)
        return;
    atomicOr(words[at(FIELD_STATE) + 18], 1u);
    if (nearest >= h(H_VERTEX_COUNT) - 1) {
        put(FIELD_DISTANCE, vertex, INFINITY);
        atomicOr(words[at(FIELD_STATE) + 18], 2u);
        return;
    }
    put(FIELD_DISTANCE, vertex, max(distance(vertex), nearest + 1));
}
void dischargeShort(int vertex) {
    if (vertexColor(vertex) != p.mode || incidentCount(vertex) > 128)
        return;
    bool dirty = get(FIELD_LABEL_CHANGED, vertex) != 0;
    if (dirty)
        put(FIELD_LABEL_CHANGED, vertex, 0);
    int64_t remaining = read(FIELD_EXCESS, vertex);
    if (remaining < 0l || (remaining == 0l && !dirty))
        return;
    int height = distance(vertex);
    if (height == INFINITY && remaining > 0l) {
        finishDischarge(vertex, remaining, INFINITY);
        return;
    }
    while (true) {
        int nearest = INFINITY;
        for (int i = 0; i < incidentCount(vertex); i++) {
            int edge = incidentEdge(vertex, i);
            if (edge < 0)
                continue;
            int peer = peerOf(vertex, edge);
            int64_t residual = residualFrom(vertex, edge);
            if (remaining > 0l && residual > 0l && height == distance(peer) + 1) {
                int64_t amount = pushDirect(vertex, edge, min(remaining, residual));
                remaining -= amount;
                residual -= amount;
            }
            if (residual > 0l)
                nearest = min(nearest, distance(peer));
        }
        int next = nearest >= h(H_VERTEX_COUNT) - 1 ? INFINITY : max(height, nearest + 1);
        if (remaining == 0l && !dirty)
            break;
        if (next > height) {
            height = next;
            put(FIELD_DISTANCE, vertex, height);
            for (int i = 0; i < incidentCount(vertex); i++) {
                int edge = incidentEdge(vertex, i);
                if (edge >= 0)
                    notifyHeight(vertex, edge);
            }
        } else if (remaining > 0l) {
            write(FIELD_EXCESS, vertex, remaining);
            atomicOr(words[at(FIELD_STATE) + 18], 1u);
            return;
        }
        if (remaining == 0l)
            break;
        if (height == INFINITY) {
            finishDischarge(vertex, remaining, nearest);
            return;
        }
        dirty = false;
    }
    write(FIELD_EXCESS, vertex, 0l);
}
int64_t claimLong(int vertex, int64_t wanted) {
    int address = at(FIELD_EXCESS) / 2 + vertex;
    int64_t available = atomicAdd(integers[address], 0l);
    while (available > 0l) {
        int64_t amount = min(wanted, available);
        if (amount <= 0l)
            return 0l;
        int64_t prior = atomicCompSwap(integers[address], available, available - amount);
        if (prior == available)
            return amount;
        available = prior;
    }
    return 0l;
}
void pushLong(int vertex, int edge) {
    if (edge < 0 || distance(vertex) != distance(peerOf(vertex, edge)) + 1)
        return;
    int64_t amount = claimLong(vertex, residualFrom(vertex, edge)), grant = pushDirect(vertex, edge, amount);
    if (amount > grant)
        atomicAdd(integers[at(FIELD_EXCESS) / 2 + vertex], amount - grant);
}
void prepareLong(int index) {
    if (index >= get(FIELD_STATE, 17))
        return;
    int vertex = get(FIELD_LONG_VERTICES, index);
    put(FIELD_LONG_WORK, index, 0);
    if (vertexColor(vertex) != p.mode)
        return;
    bool dirty = get(FIELD_LABEL_CHANGED, vertex) != 0;
    if (dirty)
        put(FIELD_LABEL_CHANGED, vertex, 0);
    int64_t balance = read(FIELD_EXCESS, vertex);
    if (balance < 0l || (balance == 0l && !dirty))
        return;
    if (balance > 0l && distance(vertex) == INFINITY) {
        finishDischarge(vertex, balance, INFINITY);
        return;
