}
void apply(int index){if(index>=get(STATE,9))return;int e=get(ACTIVE_EDGES,index);ivec2 ends=endpoints(e);
 int64_t proposed=read(PROPOSAL,e),amount=abs(proposed);int receiver=proposed>0l?ends.y:ends.x;
 int address=at(REMAINING)/2+receiver;int64_t available=atomicAdd(integers[address],0l),grant=amount;
 if(available>=0l){for(;;){grant=min(amount,available);if(grant==0l)break;
   int64_t prior=atomicCompSwap(integers[address],available,available-grant);if(prior==available)break;available=prior;
 }}
