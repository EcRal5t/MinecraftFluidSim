        pushLongBlock(block, lane);
        return;
    }
    if (p.stage == 38) {
        finishLong(block, lane);
        return;
    }
    if (p.stage == 39) {
        notifyLongBlock(block, lane);
        return;
    }
    if (p.stage == 7) {
        if (block < h(H_TOTAL_BLOCKS))
            totalBlock(block, lane);
        return;
    }
    if (id >= p.count)
        return;
    if (p.stage == 1)
        seedDonor(id);
    else if (p.stage == 3)
        balanceReceiver(id);
    else if (p.stage == 4)
        scatterMember(id);
    else if (p.stage == 5)
        mapLongBlocks(id);
    else if (p.stage == 6)
        balanceSink();
    else if (p.stage == 8)
        total();
    else if (p.stage == 9)
        seedGroup(id);
    else if (p.stage == 10)
        start();
    else if (p.stage == 11)
        seedDistance(id);
    else if (p.stage == 12)
        beginBfs();
    else if (p.stage == 13)
        bfsEdge(id);
    else if (p.stage == 14)
        finishBfs();
    else if (p.stage == 15)
        beginDischarge(id);
    else if (p.stage == 24)
        checkStationaryGroup(id);
    else if (p.stage == 25)
        startCorrection();
    else if (p.stage == 27)
        requestStationary(id);
    else if (p.stage == 29)
        applyRetractions(id);
    else if (p.stage == 30)
        prepareGroups(id);
    else if (p.stage == 40)
        stationaryGroups(id);
    else if (p.stage == 41)
        stationaryIncoming(id);
    else if (p.stage == 42)
        stationaryGroupQueue(id);
    else if (p.stage == 47) {
        if (get(FIELD_STATE, 0) == 3)
            scatterMember(id);
    } else if (p.stage == 43) {
        if (get(FIELD_STATE, 0) == 3)
            write(FIELD_PROPOSAL, id, 0l);
    } else if (p.stage == 44)
        stationaryMap(id);
    else if (p.stage == 46)
        prepareStationaryRound();
    else if (p.stage == 35)
        dischargeShort(id);
    else if (p.stage == 36)
        prepareLong(id);
    else if (p.stage == 20)
        finishRound();
    if (p.stage == 25 || p.stage == 10 || p.stage == 12 || p.stage == 14 || p.stage == 20)
        updateDispatch();
}
