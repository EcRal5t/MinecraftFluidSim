void blockAllocate(int block,int lane){
 if(block>=get(BO,h(3)))return;int vertex=get(OWNER,block),index=get(OFFSET,vertex)+128*(block-get(BO,vertex))+lane;
 if(p.mode==3){if(get(LABEL_CHANGED,vertex)!=0&&index<get(OFFSET,vertex+1))notifyPredecessor(vertex,get(ENTRY,index));return;}
