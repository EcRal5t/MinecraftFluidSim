void start(){if(get(STATE,4)==0)putControl(0,1);else put(STATE,0,0);}
void seedDistance(int vertex){if(get(STATE,0)!=0)return;put(LABEL_CHANGED,vertex,0);put(DISTANCE,vertex,read(EXCESS,vertex)<0l?0:INFINITY);}
void beginBfs(){if(get(STATE,0)==0){put(STATE,0,1);put(STATE,1,0);put(STATE,2,0);put(STATE,5,0);}}
void discover(int vertex,int value){if(atomicCompSwap(words[at(DISTANCE)+vertex],uint(INFINITY),uint(value))==uint(INFINITY)){atomicOr(words[at(STATE)+2],1u);if(read(EXCESS,vertex)>0l)atomicOr(words[at(STATE)+5],1u);}}
void bfsEdge(int e){if(get(STATE,0)!=1||upper(e)==0l)return;ivec2 v=endpoints(e);int wave=get(STATE,1);
