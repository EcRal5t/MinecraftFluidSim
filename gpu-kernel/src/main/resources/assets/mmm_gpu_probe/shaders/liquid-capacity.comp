void balanceSink(){if(read(EXCESS,sink())>0l)atomicAdd(words[at(STATE)+4],1u);classifyLong(sink());}
int vertexColor(int vertex){return vertex<n()||(vertex>=2*n()&&vertex<sink())?0:1;}
void dispatchSize(int slot,int size){int workgroups=(size+127)/128;
