}
void blockSum(int block,int lane){
 if(block>=get(BO,h(3)))return;int vertex=get(OWNER,block),index=get(OFFSET,vertex)+128*(block-get(BO,vertex))+lane;
 if(idle(vertex))return;
 reduction[lane]=index<get(OFFSET,vertex+1)?contribution(vertex,get(ENTRY,index)):(p.mode==3?int64_t(INFINITY):0l);reduce(lane);if(lane==0)write(PART,block,reduction[0]);
}
void notifyPredecessor(int vertex,int e){ivec2 ends=endpoints(e);bool forward=ends.y==vertex;
 if((forward?upper(e)-flow(e):flow(e)-lower(e))>0l){int peer=forward?ends.x:ends.y;
  atomicOr(words[at(labelQueue()==LABEL_A?LABEL_B:LABEL_A)+peer],1u);}}
void ownerSum(int vertex){
 if(get(STATE,0)>=0&&p.mode<3){
  int size=p.mode==0?get(STATE,10):p.mode==1?get(STATE,11):get(STATE,12);if(vertex>=size)return;
  vertex=get(p.mode==0?ACTIVE_VERTICES:p.mode==1?RECEIVERS:CHANGED_VERTICES,vertex);
  if(p.mode==0)touch(vertex);
 }
 bool skip=idle(vertex);
 if(p.mode==3){put(LABEL_CHANGED,vertex,0);put(labelQueue(),vertex,0);
  if(read(EXCESS,vertex)>0l&&distance(vertex)==INFINITY)atomicExchange(words[ca(CONTROL)],2u);}
 if(skip){if(p.mode==2)countPositive(vertex);return;}
 int64_t prefix=p.mode==3?int64_t(INFINITY):0l;
 if(get(COUNT,vertex)<=128){for(int i=get(OFFSET,vertex);i<get(OFFSET,vertex+1);i++){
   int e=get(ENTRY,i);int64_t value=contribution(vertex,e);if(p.mode<2)allocate(vertex,e,prefix,value);prefix=p.mode==3?min(prefix,value):add(prefix,value);
   if(p.mode==3&&prefix<int64_t(distance(vertex)))return;
  }}else for(int b=get(BO,vertex);b<get(BO,vertex+1);b++){write(PREFIX,b,prefix);prefix=p.mode==3?min(prefix,read(PART,b)):add(prefix,read(PART,b));}
 if(p.mode==2||p.mode==4)finishBalance(vertex,prefix);
 if(p.mode==3){int next=prefix>=h(3)?INFINITY:int(prefix)+1;
  if(next==INFINITY&&read(EXCESS,vertex)>0l)atomicExchange(words[ca(CONTROL)],2u);
  int old=int(atomicMax(words[at(DISTANCE)+vertex],uint(next)));
  if(next>old){put(LABEL_CHANGED,vertex,1);if(get(COUNT,vertex)<=128)
   for(int i=get(OFFSET,vertex);i<get(OFFSET,vertex+1);i++)notifyPredecessor(vertex,get(ENTRY,i));}}
}
void blockAllocate(int block,int lane){
 if(block>=get(BO,h(3)))return;int vertex=get(OWNER,block),index=get(OFFSET,vertex)+128*(block-get(BO,vertex))+lane;
 if(p.mode==3){if(get(LABEL_CHANGED,vertex)!=0&&index<get(OFFSET,vertex+1))notifyPredecessor(vertex,get(ENTRY,index));return;}
 if(idle(vertex))return;
 int e=index<get(OFFSET,vertex+1)?get(ENTRY,index):-1;int64_t amount=e<0?0l:contribution(vertex,e);reduction[lane]=amount;barrier();
 for(int step=1;step<128;step<<=1){int64_t extra=lane>=step?reduction[lane-step]:0l;barrier();reduction[lane]=add(reduction[lane],extra);barrier();}
 if(e>=0)allocate(vertex,e,add(read(PREFIX,block),reduction[lane]-amount),amount);
}
void seedGroup(int group){writeFlow(8*n()+group,clamp(read(EXCESS,2*n()+group),0l,upper(8*n()+group)));if(group==0){put(STATE,4,0);put(STATE,8,INFINITY);}}
void dispatchSize(int slot,int size){int workgroups=(size+127)/128;
 put(DISPATCH,3*slot,min(workgroups,65535));put(DISPATCH,3*slot+1,max(1,(workgroups+65534)/65535));put(DISPATCH,3*slot+2,1);}
void updateDispatch(){bool running=control(0)==0&&get(STATE,16)!=0;int state=get(STATE,0);putControl(2,state);
 dispatchSize(0,running&&state==0?h(3):0);dispatchSize(1,running&&state==1?h(4):0);
 dispatchSize(2,running&&state==2?h(4):0);dispatchSize(3,running&&state==2?h(3):0);
 dispatchSize(4,running&&state==2?128*get(BO,h(3)):0);dispatchSize(5,running?1:0);
 dispatchSize(6,running&&state==2?get(STATE,4):0);
 dispatchSize(9,running&&state==3?n():0);dispatchSize(13,running&&state==4?n():0);dispatchSize(14,running&&state==5?n():0);dispatchSize(15,running&&state==5?1:0);dispatchSize(10,running&&state==5?groups():0);
 dispatchSize(11,running&&state==5?h(3):0);dispatchSize(12,running&&state==5?128*get(BO,h(3)):0);}
void start(){if(get(STATE,4)==0)putControl(0,1);else put(STATE,0,3);}
void seedDistance(int vertex){if(get(STATE,0)!=0)return;put(CURSOR,vertex,0);put(LABEL_A,vertex,0);put(LABEL_B,vertex,0);put(DISTANCE,vertex,read(EXCESS,vertex)<0l?0:INFINITY);}
void beginBfs(){if(get(STATE,0)==0){put(STATE,0,1);put(STATE,1,0);put(STATE,2,0);put(STATE,5,0);}}
void discover(int vertex,int value){if(atomicCompSwap(words[at(DISTANCE)+vertex],uint(INFINITY),uint(value))==uint(INFINITY)){atomicOr(words[at(STATE)+2],1u);if(read(EXCESS,vertex)>0l)atomicOr(words[at(STATE)+5],1u);}}
void bfsEdge(int e){if(get(STATE,0)!=1||upper(e)==0l)return;ivec2 v=endpoints(e);int wave=get(STATE,1);
 if(flow(e)<upper(e)&&distance(v.y)==wave)discover(v.x,wave+1);
 if(flow(e)>lower(e)&&distance(v.x)==wave)discover(v.y,wave+1);
}
void finishBfs(){if(get(STATE,0)!=1)return;put(STATE,6,get(STATE,6)+1);
 if(get(STATE,2)!=0){put(STATE,1,get(STATE,1)+1);put(STATE,2,0);}else put(STATE,0,2);}
void clearProposal(int e){if(get(STATE,0)!=2)return;
 put(STATE,10,get(STATE,4));put(STATE,3,0);put(STATE,4,0);put(STATE,5,0);put(STATE,8,INFINITY);put(STATE,9,0);put(STATE,11,0);put(STATE,12,0);}
void apply(int index){if(get(STATE,0)!=2||index>=get(STATE,9))return;int e=get(ACTIVE_EDGES,index);
