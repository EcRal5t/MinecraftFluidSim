void countEdge(int e){if(upper(e)==0l)return;ivec2 v=endpoints(e);if(v.x<0||v.y<0||v.x>=h(3)||v.y>=h(3)){invalid();return;}
 atomicAdd(words[at(COUNT)+v.x],1u);atomicAdd(words[at(COUNT)+v.y],1u);}
void scatterEdge(int e){if(upper(e)==0l)return;ivec2 v=endpoints(e);
