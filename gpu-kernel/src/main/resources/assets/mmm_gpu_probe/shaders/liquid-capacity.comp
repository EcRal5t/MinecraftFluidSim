int64_t lower(int e){return e>=7*n()&&e<8*n()?capacityValue(CL,e-7*n()):0l;}
int64_t upper(int e){
 if(e<7*n()){int cell=e/7,slot=e%7;return slot==0||(int(words[ca(COPEN)+cell])&(1<<(slot-1)))!=0?capacityValue(CK,cell):0l;}
 if(e<8*n())return capacityValue(CU,e-7*n());int group=e-8*n();return group==groups()-1?INF:capacityValue(CCAP,group);
}
int64_t flow(int e){return e<7*n()?capacityValue(CFLOW,e):read(TAIL,e-7*n());}
void writeFlow(int e,int64_t x){if(e<7*n())writeNumber(ca(CFLOW)+2*e,x);else write(TAIL,e-7*n(),x);}
int distance(int vertex){return int(atomicAdd(words[at(DISTANCE)+vertex],0u));}
void initialize(int id){
 if(id<h(3)){put(COUNT,id,0);put(CURSOR,id,0);put(TOUCHED,id,0);put(LABEL_A,id,0);put(LABEL_B,id,0);put(LABEL_CHANGED,id,0);write(EXCESS,id,0l);put(DISTANCE,id,INFINITY);}
 if(id<h(4)){writeFlow(id,0l);write(PROPOSAL,id,0l);}
 if(id<n())put(CUT,id,0);if(id<groups())write(GROUP_BASE,id,0l);
 if(id==0){for(int i=0;i<12;i++)putControl(i,0);putControl(5,p.argument);for(int i=0;i<17;i++)put(STATE,i,0);put(STATE,8,INFINITY);put(STATE,0,-1);put(STATE,16,1);}
}
void seedDonor(int cell){
 int group=int(words[ca(CG)+cell]),open=int(words[ca(COPEN)+cell]);int64_t k=capacityValue(CK,cell),lo=capacityValue(CL,cell),hi=capacityValue(CU,cell);
 if(group< -1||group>=groups()-1||k<0l||k>INF/(8l*int64_t(n()))||lo<0l||hi<lo||hi>INF/int64_t(n())||(open&~63)!=0){invalid();return;}
 if(group>=0&&(capacityValue(CCAP,group)<0l||capacityValue(CCAP,group)>INF)){invalid();return;}
 if(lo>k||hi<k)atomicOr(words[at(STATE)+13],1u);atomicAdd(integers[at(GROUP_BASE)/2+groupOf(cell)],k);
