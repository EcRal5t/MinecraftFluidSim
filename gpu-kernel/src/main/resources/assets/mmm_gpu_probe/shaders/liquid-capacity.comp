    for (int block = get(FIELD_LONG_BLOCK_OFFSETS, index) + lane; block < get(FIELD_LONG_BLOCK_OFFSETS, index + 1);
         block += 128)
        nearest = min(nearest, get(FIELD_LONG_PARTIAL, block));
    reduction[lane] = int64_t(nearest);
    barrier();
    for (int step = 64; step > 0; step >>= 1) {
        if (lane < step)
            reduction[lane] = min(reduction[lane], reduction[lane + step]);
        barrier();
    }
    if (lane != 0)
        return;
    nearest = int(reduction[0]);
    int height = distance(vertex), next = nearest >= h(H_VERTEX_COUNT) - 1 ? INFINITY : max(height, nearest + 1);
    if (next > height) {
        put(FIELD_DISTANCE, vertex, next);
        put(FIELD_LONG_WORK, index, work | 4);
    }
    if (remaining > 0l) {
        atomicOr(words[at(FIELD_STATE) + 18], 1u);
        if (next == INFINITY)
            atomicOr(words[at(FIELD_STATE) + 18], 2u);
    }
}
void notifyLongBlock(int block, int lane) {
    if (block >= get(FIELD_LONG_BLOCK_OFFSETS, get(FIELD_STATE, 17)))
        return;
    int index = get(FIELD_LONG_BLOCK_OWNER, block);
    if ((get(FIELD_LONG_WORK, index) & 4) == 0)
        return;
    int vertex = get(FIELD_LONG_VERTICES, index), ordinal = 128 * (block - get(FIELD_LONG_BLOCK_OFFSETS, index)) + lane;
    if (ordinal < incidentCount(vertex)) {
        int edge = incidentEdge(vertex, ordinal);
        if (edge >= 0)
            notifyHeight(vertex, edge);
    }
}
// Returning a preferred route to its donor keeps all integer supply quotas exact.
// A feasible stationary allocation permits monotone withdrawal of conflicting preferences.
void checkStationaryGroup(int group) {
    if (read(FIELD_GROUP_BASE, group) > upper(8 * n() + group))
        atomicOr(words[at(FIELD_STATE) + 13], 1u);
}
void startCorrection() {
    put(FIELD_STATE, 0, get(FIELD_STATE, 13) == 0 ? 3 : 6);
}
// Queue words reuse FIELD_EXCESS while the stationary phase has no residual balances.
// Three cell queues and two group queues fit its (2N+G+1) int64 slots.
int queueAddress(int kind, int index) {
    int base = kind == 0 ? 0 : kind == 1 ? n() : kind == 2 ? 2 * n() : kind == 3 ? 3 * n() : 3 * n() + groups();
    return at(FIELD_EXCESS) + base + index;
}
int queueCounter(int kind) {
    return kind == 0 ? 9 : kind == 1 ? 10 : kind == 2 ? 11 : kind == 3 ? 12 : 14;
}
int currentCellQueue() {
    return control(1) & 1;
}
int currentGroupQueue() {
    return 3 + (control(1) & 1);
}
int epoch() {
    return control(1) + 1;
}
void enqueue(int kind, int vertex, int stamp, int generation) {
    if (atomicExchange(words[at(FIELD_DISTANCE) + stamp], uint(generation)) == uint(generation))
        return;
    uint index = atomicAdd(words[at(FIELD_STATE) + queueCounter(kind)], 1u);
    words[queueAddress(kind, int(index))] = uint(vertex);
    if (kind == 2) {
        // Monotone command dimensions cover the flattened queue, including a second grid dimension.
        uint count = (index + 128u) / 128u;
        atomicMax(words[at(FIELD_DISPATCH) + 33], min(count, 65535u));
        atomicMax(words[at(FIELD_DISPATCH) + 34], (count + 65534u) / 65535u);
    }
}
void enqueueCell(int cell, bool next) {
    enqueue(next ? 1 - currentCellQueue() : currentCellQueue(), cell, cell, epoch() + (next ? 1 : 0));
}
void enqueueGroup(int group, bool next) {
    if (group == groups() - 1)
        return;
    enqueue(next ? 7 - currentGroupQueue() : currentGroupQueue(), group, 2 * n() + group, epoch() + (next ? 1 : 0));
}
void stationaryGroups(int group) {
    if (group < groups()) {
        put(FIELD_GROUP_COUNTS, group, 0);
        put(FIELD_GROUP_CURSORS, group, 0);
        write(FIELD_GROUP_INCOMING, group, 0l);
        write(FIELD_GROUP_WITHDRAW, group, 0l);
    }
    put(FIELD_LONG_BLOCK_COUNTS, group, 0);
}
void stationaryIncoming(int cell) {
    if (get(FIELD_STATE, 0) != 3)
        return;
    int64_t incoming = flow(7 * cell);
    for (int side = 0; side < 6; side++) {
        int donor = neighbor(cell, side);
        if (donor >= 0)
            incoming = add(incoming, flow(7 * donor + 1 + (side ^ 1)));
    }
    write(FIELD_CELL_INCOMING, cell, incoming);
    int group = groupOf(cell);
    atomicAdd(integers[at(FIELD_GROUP_INCOMING) / 2 + group], incoming);
    atomicAdd(words[at(FIELD_GROUP_COUNTS) + group], 1u);
    if (incoming < capacityValue(CAPACITY_LOWER, cell) || incoming > capacityValue(CAPACITY_UPPER, cell))
        enqueueCell(cell, false);
}
void stationaryGroupQueue(int group) {
    if (get(FIELD_STATE, 0) != 3)
        return;
    int count = get(FIELD_GROUP_COUNTS, group);
    put(FIELD_LONG_BLOCK_COUNTS, group, group != groups() - 1 && count > 16 ? (count + 127) / 128 : 0);
    if (read(FIELD_GROUP_INCOMING, group) > upper(8 * n() + group))
        enqueueGroup(group, false);
}
void stationaryMap(int group) {
    if (get(FIELD_STATE, 0) != 3)
        return;
    for (int block = get(FIELD_LONG_BLOCK_OFFSETS, group); block < get(FIELD_LONG_BLOCK_OFFSETS, group + 1); block++)
        put(FIELD_LONG_BLOCK_OWNER, block, group);
}
void prepareStationaryRound() {
    if (get(FIELD_STATE, 0) != 3) {
        dispatchSize(9, 0);
        dispatchSize(11, 0);
        dispatchSize(12, 0);
        dispatchSize(5, 0);
        return;
    }
    put(FIELD_STATE, queueCounter(1 - currentCellQueue()), 0);
    put(FIELD_STATE, queueCounter(7 - currentGroupQueue()), 0);
    put(FIELD_STATE, 11, 0);
    put(FIELD_STATE, 15, 0);
    bool running = control(0) == 0;
    dispatchSize(9, running ? get(FIELD_STATE, queueCounter(currentCellQueue())) +
                                  get(FIELD_STATE, queueCounter(currentGroupQueue()))
                            : 0);
    dispatchSize(11, 0);
    dispatchSize(12, running && get(FIELD_STATE, queueCounter(currentGroupQueue())) > 0
                         ? 128 * get(FIELD_LONG_BLOCK_OFFSETS, groups())
                         : 0);
    dispatchSize(5, running ? 1 : 0);
}
void retract(int edge, int64_t amount) {
    if (amount <= 0l)
        return;
    atomicMax(integers[at(FIELD_PROPOSAL) / 2 + edge], amount);
    int donor = edge / 7;
    enqueue(2, donor, n() + donor, epoch());
}
void requestCell(int index) {
    if (index >= get(FIELD_STATE, queueCounter(currentCellQueue())))
        return;
    int cell = int(words[queueAddress(currentCellQueue(), index)]);
    int64_t incoming = read(FIELD_CELL_INCOMING, cell),
            excess = max(0l, incoming - capacityValue(CAPACITY_UPPER, cell)),
            deficit = max(0l, capacityValue(CAPACITY_LOWER, cell) - incoming);
    for (int side = 0; side < 6; side++) {
        int donor = neighbor(cell, side);
        if (donor >= 0 && excess > 0l) {
            int edge = 7 * donor + 1 + (side ^ 1);
            int64_t take = min(excess, flow(edge));
            retract(edge, take);
            excess -= take;
        }
        int edge = 7 * cell + side + 1;
        int64_t take = min(deficit, flow(edge));
        retract(edge, take);
        deficit -= take;
    }
}
void requestGroupCell(int group, int cell) {
    int64_t over = max(0l, read(FIELD_GROUP_INCOMING, group) - upper(8 * n() + group));
    if (over == 0l)
        return;
    for (int side = 0; side < 6; side++) {
        int donor = neighbor(cell, side);
        if (donor < 0 || groupOf(donor) == group)
            continue;
        int edge = 7 * donor + 1 + (side ^ 1);
        int64_t amount = flow(edge);
        if (amount <= 0l)
            continue;
        int64_t ticket = atomicAdd(integers[at(FIELD_GROUP_WITHDRAW) / 2 + group], amount);
        retract(edge, ticket < over ? min(amount, over - ticket) : 0l);
    }
}
void requestGroup(int index) {
    if (index >= get(FIELD_STATE, queueCounter(currentGroupQueue())))
        return;
    int group = int(words[queueAddress(currentGroupQueue(), index)]);
    write(FIELD_GROUP_WITHDRAW, group, 0l);
    if (get(FIELD_LONG_BLOCK_COUNTS, group) == 0)
        for (int at = get(FIELD_GROUP_OFFSETS, group); at < get(FIELD_GROUP_OFFSETS, group + 1); at++)
            requestGroupCell(group, get(FIELD_GROUP_MEMBERS, at));
}
void requestGroupBlock(int block, int lane) {
    if (block >= get(FIELD_LONG_BLOCK_OFFSETS, groups()))
        return;
    int group = get(FIELD_LONG_BLOCK_OWNER, block);
    if (get(FIELD_DISTANCE, 2 * n() + group) != epoch())
        return;
    int index = get(FIELD_GROUP_OFFSETS, group) + 128 * (block - get(FIELD_LONG_BLOCK_OFFSETS, group)) + lane;
    if (index < get(FIELD_GROUP_OFFSETS, group + 1))
        requestGroupCell(group, get(FIELD_GROUP_MEMBERS, index));
}
void requestStationary(int index) {
    int cells = get(FIELD_STATE, queueCounter(currentCellQueue()));
    if (index < cells)
        requestCell(index);
    else
        requestGroup(index - cells);
}
void applyRetractions(int index) {
    if (index >= get(FIELD_STATE, 11))
        return;
    int cell = int(words[queueAddress(2, index)]), sourceGroup = groupOf(cell);
    int64_t returned = 0l;
    for (int side = 1; side < 7; side++) {
        int edge = 7 * cell + side;
        int64_t amount = read(FIELD_PROPOSAL, edge);
        write(FIELD_PROPOSAL, edge, 0l);
        if (amount <= 0l)
            continue;
        writeFlow(edge, flow(edge) - amount);
        returned += amount;
        int receiver = neighbor(cell, side - 1), targetGroup = groupOf(receiver);
        atomicAdd(integers[at(FIELD_CELL_INCOMING) / 2 + receiver], -amount);
        enqueueCell(receiver, true);
        if (targetGroup != sourceGroup) {
            atomicAdd(integers[at(FIELD_GROUP_INCOMING) / 2 + targetGroup], -amount);
            atomicAdd(integers[at(FIELD_GROUP_INCOMING) / 2 + sourceGroup], amount);
            enqueueGroup(targetGroup, true);
            enqueueGroup(sourceGroup, true);
        }
    }
    if (returned > 0l) {
        writeFlow(7 * cell, flow(7 * cell) + returned);
        atomicAdd(integers[at(FIELD_CELL_INCOMING) / 2 + cell], returned);
        enqueueCell(cell, true);
        atomicOr(words[at(FIELD_STATE) + 15], 1u);
    }
}
void finishRound() {
    if (get(FIELD_STATE, 0) == 6)
        return;
    int round = control(1) + 1;
    putControl(1, round);
    if (get(FIELD_STATE, 0) == 3) {
        if (get(FIELD_STATE, 15) == 0)
            putControl(0, 1);
        else if (round >= LOCAL_WITHDRAWAL_ROUNDS) {
            put(FIELD_STATE, 0, 6);
            dispatchSize(9, 0);
            dispatchSize(11, 0);
            dispatchSize(12, 0);
        }
    }
    if (p.argument == 2 && get(FIELD_STATE, 0) == 2)
        put(FIELD_STATE, 7, get(FIELD_STATE, 7) + 1);
    if (p.argument == 2 && get(FIELD_STATE, 0) == 2) {
        // No positive balance remains; otherwise recompute distances if no flow advanced.
        if (get(FIELD_STATE, 18) == 0) {
            putControl(0, 1);
            return;
        }
        if (get(FIELD_STATE, 15) == 0)
            put(FIELD_STATE, 0, 0);
    }
    if (round >= control(5) && control(0) == 0)
        putControl(0, 3);
    if (get(FIELD_STATE, 0) == 3)
        prepareStationaryRound();
}
void finish(int e) {
    if (control(0) == 1)
        writeNumber(ca(CAPACITY_ACCEPTED) + 2 * e, flow(e));
    else if (control(0) == 2) {
        if (e < n())
            put(FIELD_CUT_CELLS, e,
                distance(n() + e) == INFINITY || distance(2 * n() + groupOf(e)) == INFINITY ? 1 : 0);
    } else if (e == 0)
        atomicOr(errors, 8192u);
}
void main() {
    int block = int(gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x), lane = int(gl_LocalInvocationID.x),
        id = 128 * block + lane;
    if (p.stage == 0) {
        if (id < p.count)
            initialize(id);
        return;
    }
    // Withdrawal queues reuse FIELD_EXCESS and FIELD_DISTANCE; reset them before constructing residual balances.
    if (p.stage == 48) {
        if (id < p.count) {
            write(FIELD_EXCESS, id, 0l);
            put(FIELD_DISTANCE, id, INFINITY);
            put(FIELD_LABEL_CHANGED, id, 0);
        }
        return;
    }
    if (p.stage == 21) {
        if (id < p.count)
            finish(id);
        return;
    }
    if (control(0) != 0)
        return;
