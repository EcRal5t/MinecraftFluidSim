}
int64_t lower(int e) {
    return e >= 7 * n() && e < 8 * n() ? capacityValue(CAPACITY_LOWER, e - 7 * n()) : 0l;
}
int64_t upper(int e) {
    if (e < 7 * n()) {
        int cell = e / 7, slot = e % 7;
        return slot == 0 || (int(words[ca(CAPACITY_OPEN_NEIGHBORS) + cell]) & (1 << (slot - 1))) != 0
                   ? capacityValue(CAPACITY_K, cell)
