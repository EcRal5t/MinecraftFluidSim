void countBlocks(int vertex){int degree=get(COUNT,vertex);put(BC,vertex,degree>128?(degree+127)/128:0);}
void mapBlocks(int vertex){for(int block=get(BO,vertex);block<get(BO,vertex+1);block++)put(OWNER,block,vertex);}
void reduce(int lane){for(int step=64;step>0;step>>=1){barrier();if(lane<step)reduction[lane]=p.mode==3?min(reduction[lane],reduction[lane+step]):add(reduction[lane],reduction[lane+step]);}barrier();}
void totalBlock(int block,int lane){int cell=128*block+lane;reduction[lane]=cell<n()?capacityValue(CK,cell):0l;reduce(lane);if(lane==0)write(TOTAL_PART,block,reduction[0]);}
void total(){int64_t result=0l;for(int block=0;block<h(6);block++)result=add(result,read(TOTAL_PART,block));write(TOTAL,0,result);}
int64_t contribution(int vertex,int e){
 ivec2 ends=endpoints(e);int peer=ends.x==vertex?ends.y:ends.x;
 if(p.mode==2)return ends.x==vertex?-flow(e):flow(e);
 if(p.mode==3)return (ends.x==vertex?upper(e)-flow(e):flow(e)-lower(e))>0l?int64_t(distance(peer)):int64_t(INFINITY);
 if(p.mode==0){
  if(read(EXCESS,vertex)<=0l||distance(vertex)==INFINITY||distance(vertex)==0||distance(peer)!=distance(vertex)-1)return 0l;
  return ends.x==vertex?upper(e)-flow(e):flow(e)-lower(e);
 }
