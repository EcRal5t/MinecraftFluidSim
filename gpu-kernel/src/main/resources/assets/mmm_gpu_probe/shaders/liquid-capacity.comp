}
int labelQueue(){return (control(1)&1)==0?LABEL_A:LABEL_B;}
void touch(int vertex){atomicOr(words[at(labelQueue())+vertex],1u);if(atomicExchange(words[at(TOUCHED)+vertex],uint(control(1)+1))!=uint(control(1)+1)){
 int index=int(atomicAdd(words[at(STATE)+12],1u));put(CHANGED_VERTICES,index,vertex);}}
void allocate(int vertex,int e,int64_t prefix,int64_t amount){
 if(amount==0l)return;int64_t available=max(0l,read(EXCESS,vertex)),keep=prefix<available?min(amount,available-prefix):0l;
 if(keep>0l){ivec2 ends=endpoints(e);write(PROPOSAL,e,ends.x==vertex?keep:-keep);
  int index=int(atomicAdd(words[at(STATE)+9],1u));put(ACTIVE_EDGES,index,e);
  int receiver=ends.x==vertex?ends.y:ends.x;
  if(atomicExchange(words[at(CURSOR)+receiver],uint(control(1)+1))!=uint(control(1)+1)){
   int slot=int(atomicAdd(words[at(STATE)+11],1u));put(RECEIVERS,slot,receiver);}
  touch(receiver);
 }
}
void countPositive(int vertex){if(read(EXCESS,vertex)>0l){int index=int(atomicAdd(words[at(STATE)+4],1u));put(ACTIVE_VERTICES,index,vertex);}}
void finishBalance(int vertex,int64_t sum){
 int64_t supply=vertex<n()?capacityValue(CK,vertex):vertex==sink()?-read(TOTAL,0):0l;int64_t excess=add(supply,sum);write(EXCESS,vertex,excess);
 countPositive(vertex);
}
bool idle(int vertex){
 if(get(STATE,0)<0)return false;
 if(p.mode==0)return read(EXCESS,vertex)<=0l;
 return get(labelQueue(),vertex)==0||read(EXCESS,vertex)<0l||distance(vertex)==INFINITY;
}
void blockSum(int block,int lane){
 if(block>=get(BO,h(3)))return;int vertex=get(OWNER,block),index=get(OFFSET,vertex)+128*(block-get(BO,vertex))+lane;
 if(idle(vertex))return;
 reduction[lane]=index<get(OFFSET,vertex+1)?contribution(vertex,get(ENTRY,index)):(p.mode==3?int64_t(INFINITY):0l);reduce(lane);if(lane==0)write(PART,block,reduction[0]);
}
void notifyPredecessor(int vertex,int e){ivec2 ends=endpoints(e);bool forward=ends.y==vertex;
 if((forward?upper(e)-flow(e):flow(e)-lower(e))>0l){int peer=forward?ends.x:ends.y;
  atomicOr(words[at(labelQueue()==LABEL_A?LABEL_B:LABEL_A)+peer],1u);}}
void ownerSum(int vertex){
 if(get(STATE,0)>=0&&p.mode==0){
  if(vertex>=get(STATE,10))return;vertex=get(ACTIVE_VERTICES,vertex);touch(vertex);
 }
 bool skip=idle(vertex);
 if(p.mode==3){put(LABEL_CHANGED,vertex,0);put(labelQueue(),vertex,0);
  if(read(EXCESS,vertex)>0l&&distance(vertex)==INFINITY)atomicExchange(words[ca(CONTROL)],2u);}
 if(skip)return;
 int64_t prefix=p.mode==3?int64_t(INFINITY):0l;
 if(get(COUNT,vertex)<=128){for(int i=get(OFFSET,vertex);i<get(OFFSET,vertex+1);i++){
   int e=get(ENTRY,i);int64_t value=contribution(vertex,e);if(p.mode<2)allocate(vertex,e,prefix,value);prefix=p.mode==3?min(prefix,value):add(prefix,value);
   if(p.mode==3&&prefix<int64_t(distance(vertex)))return;
  }}else for(int b=get(BO,vertex);b<get(BO,vertex+1);b++){write(PREFIX,b,prefix);prefix=p.mode==3?min(prefix,read(PART,b)):add(prefix,read(PART,b));}
 if(p.mode==2)finishBalance(vertex,prefix);
 if(p.mode==3){int next=prefix>=h(3)?INFINITY:int(prefix)+1;
  if(next==INFINITY&&read(EXCESS,vertex)>0l)atomicExchange(words[ca(CONTROL)],2u);
  int old=int(atomicMax(words[at(DISTANCE)+vertex],uint(next)));
  if(next>old){put(LABEL_CHANGED,vertex,1);if(get(COUNT,vertex)<=128)
   for(int i=get(OFFSET,vertex);i<get(OFFSET,vertex+1);i++)notifyPredecessor(vertex,get(ENTRY,i));}}
