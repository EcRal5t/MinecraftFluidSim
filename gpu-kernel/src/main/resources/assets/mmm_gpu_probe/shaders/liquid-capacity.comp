 }
}
// Signed subtree imbalance removes full-cell divergence while retaining the projected routes.
void seedTree(int cell){put(TREE_DISTANCE,cell,capacityValue(CL,cell)==0l&&flow(7*n()+cell)<capacityValue(CU,cell)?0:INFINITY);put(TREE_PARENT,cell,-1);write(TREE_SUM,cell,0l);}
int treeDistance(int cell){return int(atomicAdd(words[at(TREE_DISTANCE)+cell],0u));}
void treeWave(int cell){if(get(STATE,0)!=3||treeDistance(cell)!=INFINITY)return;
 int open=int(words[ca(COPEN)+cell]);for(int side=0;side<6;side++)if((open&(1<<side))!=0){int peer=neighbor(cell,side);
  if(peer>=0&&(int(words[ca(COPEN)+peer])&(1<<(side^1)))!=0&&treeDistance(peer)==get(STATE,14)){atomicExchange(words[at(TREE_DISTANCE)+cell],uint(get(STATE,14)+1));put(TREE_PARENT,cell,side);atomicOr(words[at(STATE)+15],1u);break;}}
}
void treeGather(int cell){if(get(STATE,0)!=4||get(TREE_DISTANCE,cell)!=get(STATE,14))return;
 int64_t amount=read(EXCESS,n()+cell);for(int side=0;side<6;side++){int peer=neighbor(cell,side);
  if(peer>=0&&get(TREE_PARENT,peer)==(side^1))amount=add(amount,read(TREE_SUM,peer));}write(TREE_SUM,cell,amount);
}
int64_t treeDelta(int cell,int side){int peer=neighbor(cell,side);if(peer<0)return 0l;
 if(get(TREE_PARENT,cell)==side)return read(TREE_SUM,cell);
 return get(TREE_PARENT,peer)==(side^1)?-read(TREE_SUM,peer):0l;
}
void treePropose(int cell){if(get(STATE,0)!=5)return;int64_t retained=flow(7*cell);
 for(int side=0;side<6;side++){int64_t delta=treeDelta(cell,side),old=flow(7*cell+side+1),removed=delta<0l?min(old,-delta):0l;
  retained=add(retained,removed);writeNumber(ca(CACCEPTED)+2*(7*cell+side+1),old-removed);}
 for(int side=0;side<6;side++){int64_t delta=treeDelta(cell,side);if(delta<=0l)continue;
  int peer=neighbor(cell,side);int64_t needed=max(0l,delta-flow(7*peer+(side^1)+1)),amount=min(needed,retained);
  int a=ca(CACCEPTED)+2*(7*cell+side+1);writeNumber(a,number(a)+amount);retained-=amount;}
 writeNumber(ca(CACCEPTED)+14*cell,retained);
}
void treeApply(int cell){if(get(STATE,0)!=5)return;for(int slot=0;slot<7;slot++)writeFlow(7*cell+slot,capacityValue(CACCEPTED,7*cell+slot));}
void treeReceiver(int cell){if(get(STATE,0)==5){seedReceiver(cell);if(cell<groups())writeFlow(8*n()+cell,0l);}}
void treeReset(){if(get(STATE,0)==5){put(STATE,4,0);if(groups()>n())writeFlow(8*n()+groups()-1,0l);}}
void finishRound(){
 int round=control(1)+1;putControl(1,round);
 if(get(STATE,0)==3){if(get(STATE,15)!=0){put(STATE,14,get(STATE,14)+1);put(STATE,15,0);}else put(STATE,0,4);}
 else if(get(STATE,0)==4){if(get(STATE,14)>0)put(STATE,14,get(STATE,14)-1);else put(STATE,0,5);}
 else if(get(STATE,0)==5){if(get(STATE,4)==0)putControl(0,1);else put(STATE,0,0);}if(get(STATE,0)==2)put(STATE,7,get(STATE,7)+1);
 if(get(STATE,0)==2&&get(STATE,4)==0){putControl(0,1);return;}
 if(round>=control(5)&&control(0)==0)putControl(0,3);
}
void finish(int e){
 if(control(0)==1)writeNumber(ca(CACCEPTED)+2*e,flow(e));
 else if(control(0)==2){if(e<n())put(CUT,e,distance(n()+e)==INFINITY||distance(2*n()+groupOf(e))==INFINITY?1:0);}
 else if(e==0)atomicOr(errors,8192u);
}
void main(){
 int block=int(gl_WorkGroupID.y*gl_NumWorkGroups.x+gl_WorkGroupID.x),lane=int(gl_LocalInvocationID.x),id=128*block+lane;
 if(p.stage==0){if(id<p.count)initialize(id);return;}if(p.stage==21){if(id<p.count)finish(id);return;}if(control(0)!=0)return;
 if(p.stage==32){if(id==0){int state=get(STATE,0);put(STATE,16,(p.argument<=1?state<=1:state==p.argument)?1:0);updateDispatch();}return;}
 if(p.stage>=11&&p.stage!=24&&get(STATE,16)==0)return;
 if(p.stage>=16&&p.stage<=18){if(get(STATE,0)>=0&&get(STATE,0)!=(p.mode==4?5:2))return;
  if(p.stage==16){blockSum(block,lane);return;}if(p.stage==18){blockAllocate(block,lane);return;}}
 if(p.stage==7){if(block<h(6))totalBlock(block,lane);return;}if(id>=p.count)return;
 if(p.stage==1)seedDonor(id);else if(p.stage==2)seedReceiver(id);else if(p.stage==3)countEdge(id);else if(p.stage==4)scatterEdge(id);
 else if(p.stage==5)countBlocks(id);else if(p.stage==6)mapBlocks(id);else if(p.stage==8)total();else if(p.stage==9)seedGroup(id);
 else if(p.stage==10)start();else if(p.stage==11)seedDistance(id);else if(p.stage==12)beginBfs();else if(p.stage==13)bfsEdge(id);
 else if(p.stage==14)finishBfs();else if(p.stage==15)clearProposal(id);else if(p.stage==17)ownerSum(id);
 else if(p.stage==24)seedTree(id);else if(p.stage==25)treeWave(id);else if(p.stage==26)treeGather(id);
 else if(p.stage==27)treePropose(id);else if(p.stage==28)treeApply(id);else if(p.stage==29)treeReceiver(id);
 else if(p.stage==30)treeReset();else if(p.stage==31){if(get(STATE,0)==5)seedGroup(id);}
 else if(p.stage==19)apply(id);else if(p.stage==20)finishRound();else if(p.stage==23){bool moving=get(STATE,0)==2;dispatchSize(2,moving?get(STATE,9):0);
 dispatchSize(7,moving?get(STATE,11):0);dispatchSize(8,moving?get(STATE,12):0);}
 if(p.stage==10||p.stage==12||p.stage==14||p.stage==20)updateDispatch();
}

