int64_t flow(int e){return e<7*n()?capacityValue(CFLOW,e):read(TAIL,e-7*n());}
void writeFlow(int e,int64_t x){if(e<7*n())writeNumber(ca(CFLOW)+2*e,x);else write(TAIL,e-7*n(),x);}
int distance(int vertex){return int(atomicAdd(words[at(DISTANCE)+vertex],0u));}
void initialize(int id){
 if(id<h(3)){put(COUNT,id,0);put(CURSOR,id,0);put(TOUCHED,id,0);put(LABEL_A,id,0);put(LABEL_B,id,0);put(LABEL_CHANGED,id,0);write(EXCESS,id,0l);put(DISTANCE,id,INFINITY);}
 if(id<h(4)){writeFlow(id,0l);write(PROPOSAL,id,0l);write(GRANT,id,0l);put(EPOCH,id,0);}
 if(id<n())put(CUT,id,0);
 if(id==0){for(int i=0;i<12;i++)putControl(i,0);putControl(5,p.argument);for(int i=0;i<17;i++)put(STATE,i,0);put(STATE,8,INFINITY);put(STATE,0,-1);put(STATE,16,1);}
}
void seedDonor(int cell){
 int group=int(words[ca(CG)+cell]),open=int(words[ca(COPEN)+cell]);int64_t k=capacityValue(CK,cell),lo=capacityValue(CL,cell),hi=capacityValue(CU,cell);
 if(group< -1||group>=groups()-1||k<0l||k>INF/(8l*int64_t(n()))||lo<0l||hi<lo||hi>INF/int64_t(n())||(open&~63)!=0){invalid();return;}
 if(group>=0&&(capacityValue(CCAP,group)<0l||capacityValue(CCAP,group)>INF)){invalid();return;}
 int64_t remaining=k;
 for(int slot=1;slot<7;slot++){
  int other=neighbor(cell,slot-1);if(other<0&&(open&(1<<(slot-1)))!=0){invalid();return;}
  int64_t preferred=capacityValue(CPREF,7*cell+slot);if(preferred<0l){invalid();return;}
  int64_t amount=(open&(1<<(slot-1)))!=0?min(remaining,preferred):0l;writeFlow(7*cell+slot,amount);remaining-=amount;
 }writeFlow(7*cell,remaining);
}
void seedReceiver(int cell){
 int64_t incoming=flow(7*cell);
 for(int side=0;side<6;side++){int source=neighbor(cell,side);if(source>=0)incoming=add(incoming,flow(7*source+1+(side^1)));}
 writeFlow(7*n()+cell,clamp(incoming,capacityValue(CL,cell),capacityValue(CU,cell)));
}
void countEdge(int e){if(upper(e)==0l)return;ivec2 v=endpoints(e);if(v.x<0||v.y<0||v.x>=h(3)||v.y>=h(3)){invalid();return;}
 atomicAdd(words[at(COUNT)+v.x],1u);atomicAdd(words[at(COUNT)+v.y],1u);}
void scatterEdge(int e){if(upper(e)==0l)return;ivec2 v=endpoints(e);
 int a=int(atomicAdd(words[at(CURSOR)+v.x],1u)),b=int(atomicAdd(words[at(CURSOR)+v.y],1u));
 put(ENTRY,get(OFFSET,v.x)+a,e);put(ENTRY,get(OFFSET,v.y)+b,e);}
void countBlocks(int vertex){int degree=get(COUNT,vertex);put(BC,vertex,degree>128?(degree+127)/128:0);}
void mapBlocks(int vertex){for(int block=get(BO,vertex);block<get(BO,vertex+1);block++)put(OWNER,block,vertex);}
void reduce(int lane){for(int step=64;step>0;step>>=1){barrier();if(lane<step)reduction[lane]=p.mode==3?min(reduction[lane],reduction[lane+step]):add(reduction[lane],reduction[lane+step]);}barrier();}
void totalBlock(int block,int lane){int cell=128*block+lane;reduction[lane]=cell<n()?capacityValue(CK,cell):0l;reduce(lane);if(lane==0)write(TOTAL_PART,block,reduction[0]);}
void total(){int64_t result=0l;for(int block=0;block<h(6);block++)result=add(result,read(TOTAL_PART,block));write(TOTAL,0,result);}
int64_t contribution(int vertex,int e){
 ivec2 ends=endpoints(e);int peer=ends.x==vertex?ends.y:ends.x;
 if(p.mode==2||p.mode==4)return ends.x==vertex?-flow(e):flow(e);
 if(p.mode==3)return (ends.x==vertex?upper(e)-flow(e):flow(e)-lower(e))>0l?int64_t(distance(peer)):int64_t(INFINITY);
 if(p.mode==0){
  if(read(EXCESS,vertex)<=0l||distance(vertex)==INFINITY||distance(vertex)==0||distance(peer)!=distance(vertex)-1)return 0l;
  return ends.x==vertex?upper(e)-flow(e):flow(e)-lower(e);
 }
 if(get(EPOCH,e)!=control(1)+1)return 0l;
 int64_t proposal=read(PROPOSAL,e);bool receiving=proposal>0l?ends.y==vertex:proposal<0l&&ends.x==vertex;
 return receiving?abs(proposal):0l;
}
int64_t budget(int vertex){return p.mode==0?max(0l,read(EXCESS,vertex)):(read(EXCESS,vertex)<0l?-read(EXCESS,vertex):MAX_VALUE);}
int labelQueue(){return (control(1)&1)==0?LABEL_A:LABEL_B;}
void touch(int vertex){atomicOr(words[at(labelQueue())+vertex],1u);if(atomicExchange(words[at(TOUCHED)+vertex],uint(control(1)+1))!=uint(control(1)+1)){
 int index=int(atomicAdd(words[at(STATE)+12],1u));put(CHANGED_VERTICES,index,vertex);}}
void allocate(int vertex,int e,int64_t prefix,int64_t amount){
 if(amount==0l)return;int64_t available=budget(vertex),keep=prefix<available?min(amount,available-prefix):0l;
 if(p.mode==0&&keep>0l){ivec2 ends=endpoints(e);write(PROPOSAL,e,ends.x==vertex?keep:-keep);
  put(EPOCH,e,control(1)+1);int index=int(atomicAdd(words[at(STATE)+9],1u));put(ACTIVE_EDGES,index,e);
  int receiver=ends.x==vertex?ends.y:ends.x;
  if(atomicExchange(words[at(CURSOR)+receiver],uint(control(1)+1))!=uint(control(1)+1)){
   int slot=int(atomicAdd(words[at(STATE)+11],1u));put(RECEIVERS,slot,receiver);}
  touch(receiver);
 }
 else if(p.mode==1){int64_t proposed=read(PROPOSAL,e);write(GRANT,e,proposed>0l?keep:-keep);}
}
void countPositive(int vertex){if(read(EXCESS,vertex)>0l){int index=int(atomicAdd(words[at(STATE)+4],1u));put(ACTIVE_VERTICES,index,vertex);}}
void finishBalance(int vertex,int64_t sum){
 int64_t supply=vertex<n()?capacityValue(CK,vertex):vertex==sink()?-read(TOTAL,0):0l;int64_t excess=add(supply,sum);write(EXCESS,vertex,excess);
 countPositive(vertex);
}
bool idle(int vertex){
 if(get(STATE,0)<0)return false;
 if(p.mode==4)return get(STATE,0)!=5;
 if(p.mode==0)return read(EXCESS,vertex)<=0l;
 if(p.mode==1)return get(CURSOR,vertex)!=control(1)+1;
 if(p.mode==2)return get(TOUCHED,vertex)!=control(1)+1;
