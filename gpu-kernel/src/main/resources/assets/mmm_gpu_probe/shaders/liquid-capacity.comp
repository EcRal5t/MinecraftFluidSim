void beginDischarge(int e){if(get(STATE,0)!=2)return;put(STATE,18,0);}
int64_t residualFrom(int vertex,int edge){ivec2 v=endpoints(edge);return v.x==vertex?upper(edge)-flow(edge):flow(edge)-lower(edge);}
