 for(int slot=1;slot<7;slot++){
  int other=neighbor(cell,slot-1);if(other<0&&(open&(1<<(slot-1)))!=0){invalid();return;}
  int64_t preferred=capacityValue(CPREF,7*cell+slot);if(preferred<0l){invalid();return;}
  int64_t amount=(open&(1<<(slot-1)))!=0?min(remaining,preferred):0l;writeFlow(7*cell+slot,amount);remaining-=amount;
