#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
layout(local_size_x=128) in;
layout(binding=0,std430) buffer Arena { uint words[]; };
layout(binding=1,std430) buffer Errors { uint errors; };
layout(push_constant) uniform Params { int header; int stage; int count; int argument; int mode; } p;
const int STATE=1,TAIL=2,EXCESS=3,DISTANCE=4,COUNT=5,OFFSET=6,CURSOR=7,ENTRY=8,BC=9,BO=10,OWNER=11,
 PART=12,PREFIX=13,PROPOSAL=14,GRANT=15,TOTAL_PART=16,TOTAL=17,CUT=18,DISPATCH=20,EPOCH=21,ACTIVE_EDGES=22,TOUCHED=23,ACTIVE_VERTICES=24,RECEIVERS=25,CHANGED_VERTICES=26,LABEL_A=27,LABEL_B=28,LABEL_CHANGED=29,TREE_DISTANCE=30,TREE_PARENT=31,TREE_SUM=32;
const int CK=0,CL=1,CU=2,CG=3,CCAP=4,CPREF=5,COPEN=6,CACCEPTED=7,CONTROL=8,CFLOW=10;
const int INFINITY=0x3fffffff;const int64_t INF=int64_t(0x3fffffffffffffffUL),MAX_VALUE=int64_t(0x7fffffffffffffffUL);
shared int64_t reduction[128];
int h(int i){return int(words[p.header+i]);}int at(int f){return h(16+f);}int ch(int i){return int(words[h(0)+i]);}int ca(int f){return ch(8+f);}
int n(){return h(1);}int groups(){return h(2);}int sink(){return h(3)-1;}
int get(int f,int i){return int(words[at(f)+i]);}void put(int f,int i,int x){words[at(f)+i]=uint(x);}
int control(int i){return int(atomicAdd(words[ca(CONTROL)+i],0u));}void putControl(int i,int x){words[ca(CONTROL)+i]=uint(x);}
int64_t number(int a){return int64_t(uint64_t(words[a])|(uint64_t(words[a+1])<<32));}
void writeNumber(int a,int64_t x){words[a]=uint(x);words[a+1]=uint(uint64_t(x)>>32);}
int64_t read(int f,int i){return number(at(f)+2*i);}void write(int f,int i,int64_t x){writeNumber(at(f)+2*i,x);}
int64_t capacityValue(int f,int i){return number(ca(f)+2*i);}int groupOf(int cell){int g=int(words[ca(CG)+cell]);return g<0?groups()-1:g;}
void invalid(){atomicExchange(words[ca(CONTROL)],4u);atomicOr(errors,4096u);}
int64_t add(int64_t a,int64_t b){if((b>0l&&a>MAX_VALUE-b)||(b<0l&&a<-MAX_VALUE-b)){invalid();return 0l;}return a+b;}
int neighbor(int cell,int side){int x=cell%ch(0),y=cell/ch(0)%ch(1),z=cell/(ch(0)*ch(1));
 if(side==0)return x>0?cell-1:-1;if(side==1)return x+1<ch(0)?cell+1:-1;
 if(side==2)return y>0?cell-ch(0):-1;if(side==3)return y+1<ch(1)?cell+ch(0):-1;
 if(side==4)return z>0?cell-ch(0)*ch(1):-1;return z+1<ch(2)?cell+ch(0)*ch(1):-1;}
ivec2 endpoints(int e){
 if(e<7*n()){int donor=e/7,slot=e%7;return ivec2(donor,n()+(slot==0?donor:neighbor(donor,slot-1)));}
 if(e<8*n()){int cell=e-7*n();return ivec2(n()+cell,2*n()+groupOf(cell));}
