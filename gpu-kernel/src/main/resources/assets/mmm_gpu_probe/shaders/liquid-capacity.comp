void retract(int edge,int64_t amount){if(amount<=0l)return;atomicMax(integers[at(PROPOSAL)/2+edge],amount);int donor=edge/7;enqueue(2,donor,n()+donor,epoch());}
void requestCell(int index){if(index>=get(STATE,queueCounter(currentCellQueue())))return;int cell=int(words[queueAddress(currentCellQueue(),index)]);
