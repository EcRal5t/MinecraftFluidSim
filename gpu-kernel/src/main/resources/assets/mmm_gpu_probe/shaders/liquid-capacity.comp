int64_t claimLong(int vertex,int64_t wanted){
 int address=at(EXCESS)/2+vertex;int64_t available=atomicAdd(integers[address],0l);
 while(available>0l){int64_t amount=min(wanted,available);if(amount<=0l)return 0l;
  int64_t prior=atomicCompSwap(integers[address],available,available-amount);if(prior==available)return amount;available=prior;
 }return 0l;
