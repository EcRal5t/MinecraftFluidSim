#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_atomic_int64 : require
layout(local_size_x=128) in;
layout(binding=0,std430) buffer Arena { uint words[]; };
layout(binding=1,std430) buffer Errors { uint errors; };
layout(binding=2,std430) buffer AtomicArena { int64_t integers[]; };
layout(push_constant) uniform Params { int header; int stage; int count; int argument; int mode; } p;
const int STATE=1,TAIL=2,EXCESS=3,DISTANCE=4,COUNT=5,OFFSET=6,CURSOR=7,ENTRY=8,BC=9,BO=10,OWNER=11,
 PART=12,PREFIX=13,PROPOSAL=14,REMAINING=15,TOTAL_PART=16,TOTAL=17,CUT=18,DISPATCH=20,ACTIVE_EDGES=21,TOUCHED=22,ACTIVE_VERTICES=23,RECEIVERS=24,CHANGED_VERTICES=25,LABEL_A=26,LABEL_B=27,LABEL_CHANGED=28,CELL_INCOMING=29,GROUP_INCOMING=30,GROUP_WITHDRAW=31,GROUP_BASE=32;
