void writeNumber(int a, int64_t x) {
    words[a] = uint(x);
    words[a + 1] = uint(uint64_t(x) >> 32);
}
int64_t read(int f, int i) {
    return number(at(f) + 2 * i);
}
void write(int f, int i, int64_t x) {
    writeNumber(at(f) + 2 * i, x);
}
int64_t capacityValue(int f, int i) {
    return number(ca(f) + 2 * i);
}
int groupOf(int cell) {
    int g = int(words[ca(CAPACITY_GROUP_ID) + cell]);
