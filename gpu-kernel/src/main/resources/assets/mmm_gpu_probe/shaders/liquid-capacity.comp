    return a + b;
}
int neighbor(int cell, int side) {
    int x = cell % ch(CAP_H_SIZE_X), y = cell / ch(CAP_H_SIZE_X) % ch(CAP_H_SIZE_Y), z = cell / (ch(CAP_H_SIZE_X) * ch(CAP_H_SIZE_Y));
    if (side == 0)
        return x > 0 ? cell - 1 : -1;
    if (side == 1)
        return x + 1 < ch(CAP_H_SIZE_X) ? cell + 1 : -1;
    if (side == 2)
        return y > 0 ? cell - ch(CAP_H_SIZE_X) : -1;
    if (side == 3)
        return y + 1 < ch(CAP_H_SIZE_Y) ? cell + ch(CAP_H_SIZE_X) : -1;
    if (side == 4)
        return z > 0 ? cell - ch(CAP_H_SIZE_X) * ch(CAP_H_SIZE_Y) : -1;
    return z + 1 < ch(CAP_H_SIZE_Z) ? cell + ch(CAP_H_SIZE_X) * ch(CAP_H_SIZE_Y) : -1;
}
ivec2 endpoints(int e) {
    if (e < 7 * n()) {
        int donor = e / 7, slot = e % 7;
        return ivec2(donor, n() + (slot == 0 ? donor : neighbor(donor, slot - 1)));
    }
    if (e < 8 * n()) {
        int cell = e - 7 * n();
        return ivec2(n() + cell, 2 * n() + groupOf(cell));
