void classifyLong(int vertex){int count=incidentCount(vertex);if(count>128){int slot=int(atomicAdd(words[at(STATE)+17],1u));put(LONG_VERTICES,slot,vertex);put(LONG_BLOCK_COUNTS,slot,(count+127)/128);}}
void mapLongBlocks(int index){if(index>=get(STATE,17))return;
