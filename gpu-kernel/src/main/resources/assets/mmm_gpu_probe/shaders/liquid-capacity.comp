}
int get(int f, int i) {
    return int(words[at(f) + i]);
}
void put(int f, int i, int x) {
    words[at(f) + i] = uint(x);
}
int control(int i) {
    return int(atomicAdd(words[ca(CAPACITY_CONTROL) + i], 0u));
}
void putControl(int i, int x) {
    words[ca(CAPACITY_CONTROL) + i] = uint(x);
}
int64_t number(int a) {
    return int64_t(uint64_t(words[a]) | (uint64_t(words[a + 1]) << 32));
