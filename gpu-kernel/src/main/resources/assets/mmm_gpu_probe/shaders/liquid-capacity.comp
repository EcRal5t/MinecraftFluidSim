    int edge = ordinal < incidentCount(vertex) ? incidentEdge(vertex, ordinal) : -1;
    if (edge >= 0)
        pushLong(vertex, edge);
    // Other blocks never write this edge; its post-push residual is ready locally.
    int nearest = edge >= 0 && residualFrom(vertex, edge) > 0l ? distance(peerOf(vertex, edge)) : INFINITY;
    reduction[lane] = int64_t(nearest);
    barrier();
    for (int step = 64; step > 0; step >>= 1) {
        if (lane < step)
            reduction[lane] = min(reduction[lane], reduction[lane + step]);
        barrier();
    }
    if (lane == 0)
        put(FIELD_LONG_PARTIAL, block, int(reduction[0]));
}
void finishLong(int index, int lane) {
