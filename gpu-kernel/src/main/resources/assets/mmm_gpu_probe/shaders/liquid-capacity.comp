void seedGroup(int group){writeFlow(8*n()+group,clamp(read(EXCESS,2*n()+group),0l,upper(8*n()+group)));if(group==0){put(STATE,4,0);put(STATE,8,INFINITY);}}
void dispatchSize(int slot,int size){int workgroups=(size+127)/128;
 put(DISPATCH,3*slot,min(workgroups,65535));put(DISPATCH,3*slot+1,max(1,(workgroups+65534)/65535));put(DISPATCH,3*slot+2,1);}
void updateDispatch(){bool running=control(0)==0&&get(STATE,16)!=0;int state=get(STATE,0);putControl(2,state);
 dispatchSize(0,running&&state==0?h(3):0);dispatchSize(1,running&&state==1?h(4):0);
 dispatchSize(2,running&&state==2?h(4):0);dispatchSize(3,running&&state==2?h(3):0);
 dispatchSize(4,running&&state==2?128*get(BO,h(3)):0);dispatchSize(5,running?1:0);
 dispatchSize(6,running&&state==2?get(STATE,4):0);
 dispatchSize(9,running&&state==3?n():0);dispatchSize(13,running&&state==3?7*n():0);}
void start(){if(get(STATE,4)==0)putControl(0,1);else put(STATE,0,0);}
void seedDistance(int vertex){if(get(STATE,0)!=0)return;put(CURSOR,vertex,0);put(LABEL_A,vertex,0);put(LABEL_B,vertex,0);put(DISTANCE,vertex,read(EXCESS,vertex)<0l?0:INFINITY);}
void beginBfs(){if(get(STATE,0)==0){put(STATE,0,1);put(STATE,1,0);put(STATE,2,0);put(STATE,5,0);}}
void discover(int vertex,int value){if(atomicCompSwap(words[at(DISTANCE)+vertex],uint(INFINITY),uint(value))==uint(INFINITY)){atomicOr(words[at(STATE)+2],1u);if(read(EXCESS,vertex)>0l)atomicOr(words[at(STATE)+5],1u);}}
void bfsEdge(int e){if(get(STATE,0)!=1||upper(e)==0l)return;ivec2 v=endpoints(e);int wave=get(STATE,1);
 if(flow(e)<upper(e)&&distance(v.y)==wave)discover(v.x,wave+1);
 if(flow(e)>lower(e)&&distance(v.x)==wave)discover(v.y,wave+1);
}
void finishBfs(){if(get(STATE,0)!=1)return;put(STATE,6,get(STATE,6)+1);
 if(get(STATE,2)!=0){put(STATE,1,get(STATE,1)+1);put(STATE,2,0);}else put(STATE,0,2);}
void clearProposal(int e){if(get(STATE,0)!=2)return;
 put(STATE,10,get(STATE,4));put(STATE,3,0);put(STATE,4,0);put(STATE,5,0);put(STATE,8,INFINITY);put(STATE,9,0);put(STATE,11,0);put(STATE,12,0);}
// Freeze each receiver's quota before any parallel edge changes its balance.
void prepareReceiver(int index){if(index>=get(STATE,11))return;int vertex=get(RECEIVERS,index);
