        return;
    put(FIELD_LONG_WORK, index, 1 | (dirty ? 2 : 0));
}
void pushLongBlock(int block, int lane) {
    if (block >= get(FIELD_LONG_BLOCK_OFFSETS, get(FIELD_STATE, 17)))
        return;
    int index = get(FIELD_LONG_BLOCK_OWNER, block), work = get(FIELD_LONG_WORK, index);
    if ((work & 1) == 0)
        return;
