  else{int side=index-1,donor=neighbor(cell,side);if(donor<0)return -1;edge=7*donor+1+(side^1);}
 }else if(vertex==sink())edge=get(SINK_EDGES,index);
 else{int group=vertex-2*n(),first=get(GROUP_OFFSETS,group),count=get(GROUP_OFFSETS,group+1)-first;
  edge=index<count?7*n()+get(GROUP_MEMBERS,first+index):8*n()+group;}
