void stationaryMap(int group){if(get(STATE,0)!=3)return;for(int block=get(LONG_BLOCK_OFFSETS,group);block<get(LONG_BLOCK_OFFSETS,group+1);block++)put(LONG_BLOCK_OWNER,block,group);}
