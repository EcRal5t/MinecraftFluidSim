int get(int f,int i){return int(words[at(f)+i]);}void put(int f,int i,int x){words[at(f)+i]=uint(x);}
int control(int i){return int(atomicAdd(words[ca(CONTROL)+i],0u));}void putControl(int i,int x){words[ca(CONTROL)+i]=uint(x);}
int64_t number(int a){return int64_t(uint64_t(words[a])|(uint64_t(words[a+1])<<32));}
void writeNumber(int a,int64_t x){words[a]=uint(x);words[a+1]=uint(uint64_t(x)>>32);}
int64_t read(int f,int i){return number(at(f)+2*i);}void write(int f,int i,int64_t x){writeNumber(at(f)+2*i,x);}
