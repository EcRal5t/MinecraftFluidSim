  ivec3 c=ivec3(x,y,z);uint mask=words[h(11)+cell(c)];for(int bit=0;bit<8;bit++)if((mask&(1u<<bit))!=0u){
   dvec3 lo=(dvec3(c)+.5*dvec3(bit&1,(bit>>1)&1,(bit>>2)&1))*p.cellSize-radius,hi=lo+.5*p.cellSize+2.0*radius;
