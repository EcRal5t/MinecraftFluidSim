#version 450
#extension GL_ARB_gpu_shader_fp64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
const int MATERIAL_RECORD_COMPONENTS = 7;
const int FACE_RECORD_COMPONENTS = 4;
const int LIQUID_RECORD_COMPONENTS = 4;
const int MODE_UNASSIGNED = -1;
const int MATERIAL_REFERENCE_DENSITY = 0;
const int MATERIAL_GRAIN_DIAMETER = 1;
const int MATERIAL_REST_POROSITY = 2;
const int MATERIAL_REPOSE_TANGENT = 3;
const int MATERIAL_CRITICAL_SHIELDS = 4;
const int MATERIAL_EROSION_RATE = 5;
const int MATERIAL_MAX_PARCEL_VOLUME = 6;
const int LIQUID_VOLUME = 0;
const int LIQUID_MASS = 1;
const int LIQUID_OPEN_VOLUME = 2;
const int FACE_MASS = 0;
const int FACE_VELOCITY = 1;
const int FACE_OPEN_FRACTION = 2;
const int MODE_ACTIVE = 0;
const int MODE_SETTLED = 1;
const int MODE_DEPOSIT = 2;
const int MODE_ERODED = 3;
const int MODE_RELOCATED = 4;
const double MASS_UNIT_KG = 1e-10;
const double SOLID_VOLUME_QUANTA_PER_CELL = 16777216.0;
const double SOLID_VOLUME_QUANTA_PER_MICROCELL = 2097152.0;
const uint MICROCELL_BOTTOM_MASK = 0x33u;
const uint MICROCELL_TOP_MASK = 0xccu;
const uint ERROR_INSUFFICIENT_CAPACITY = 64u;
const int STAGE_INITIALIZE = 0;
const int STAGE_COUNT_COLUMNS = 1;
const int STAGE_SCATTER_COLUMNS = 2;
const int STAGE_PREPARE_CELL_STATE = 3;
const int STAGE_SETTLE_COLUMNS = 4;
const int STAGE_RELAX_PAIRS = 5;
const int STAGE_WAKE_COLUMNS = 6;
const int STAGE_COUNT_ACTIVE_ROUTES = 7;
const int STAGE_BUILD_DEPOSIT_HASH = 8;
const int STAGE_COUNT_HASH_ENTRIES = 9;
const int STAGE_PUBLISH_COUNTS = 10;
const int STAGE_COUNT_DESTINATIONS = 11;
const int STAGE_SCATTER_DESTINATIONS = 12;
const int STAGE_GATHER_INVENTORY = 13;
const int STAGE_PUBLISH_SPECIES_COUNT = 14;
const int STAGE_GATHER_SPECIES = 15;
const uint ERROR_GRANULAR_TRANSITIONS = 8388608u;
layout(local_size_x = 128) in;
layout(binding = 0, std430) buffer Arena {
    uint words[];
};
layout(binding = 1, std430) buffer Errors {
    uint errors;
};
layout(push_constant) uniform Params {
    int header;
    int stage;
    int count;
    int color;
    double cellSize;
    double duration;
    double gravity;
}
p;
// HOST_LAYOUT
int headerValue(int i) {
    return int(words[p.header + i]);
}
int targetFieldOffset(int f) {
    return headerValue(TARGET_FIELDS + f);
}
int sourceFieldOffset(int f) {
    return headerValue(SOURCE_FIELDS + f);
}
int fieldOffset(int f) {
    return headerValue(WORK_FIELDS + f);
}
int readFieldInt(int f, int i) {
    return int(words[fieldOffset(f) + i]);
}
void writeFieldInt(int f, int i, int v) {
    words[fieldOffset(f) + i] = uint(v);
}
int64_t readInt64(int a) {
    return int64_t(uint64_t(words[a]) | (uint64_t(words[a + 1]) << 32));
}
void writeInt64(int a, int64_t x) {
    words[a] = uint(x);
    words[a + 1] = uint(uint64_t(x) >> 32);
}
double readDouble(int a) {
    return packDouble2x32(uvec2(words[a], words[a + 1]));
}
void writeDouble(int a, double x) {
    uvec2 q = unpackDouble2x32(x);
    words[a] = q.x;
    words[a + 1] = q.y;
}
double read(int f, int i) {
    return readDouble(fieldOffset(f) + 2 * i);
}
void write(int f, int i, double x) {
    writeDouble(fieldOffset(f) + 2 * i, x);
}
int64_t readQuantity(int f, int i) {
    return readInt64(fieldOffset(f) + 2 * i);
}
void writeQuantity(int f, int i, int64_t x) {
    writeInt64(fieldOffset(f) + 2 * i, x);
}
double materialProperty(int m, int k) {
    return readDouble(fieldOffset(FIELD_MATERIALS) + 2 * (MATERIAL_RECORD_COMPONENTS * m + k));
}
dvec3 readVector(int a, int i) {
    return dvec3(readDouble(a + 6 * i), readDouble(a + 6 * i + 2), readDouble(a + 6 * i + 4));
}
void writeVector(int a, int i, dvec3 v) {
    for (int k = 0; k < 3; k++)
        writeDouble(a + 6 * i + 2 * k, v[k]);
}
ivec3 gridDimensions() {
    return ivec3(headerValue(H_SIZE_X), headerValue(H_SIZE_Y), headerValue(H_SIZE_Z));
}
int cell(ivec3 c) {
    return (c.z * headerValue(H_SIZE_Y) + c.y) * headerValue(H_SIZE_X) + c.x;
}
ivec3 cellCoordinates(int c) {
    return ivec3(c % headerValue(H_SIZE_X), c / headerValue(H_SIZE_X) % headerValue(H_SIZE_Y), c / (headerValue(H_SIZE_X) * headerValue(H_SIZE_Y)));
}
ivec3 positionCell(dvec3 x) {
    return clamp(ivec3(floor(x / p.cellSize)), ivec3(0), gridDimensions() - 1);
}
int columnOf(int c) {
    return c % headerValue(H_SIZE_X) + c / (headerValue(H_SIZE_X) * headerValue(H_SIZE_Y)) * headerValue(H_SIZE_X);
}
int activeCount() {
    return int(words[sourceFieldOffset(GRANULAR_COUNTS)]);
}
int depositCount() {
    return int(words[sourceFieldOffset(GRANULAR_COUNTS) + 1]);
}
bool live(int row) {
    return (row < headerValue(H_PARTICLE_CAPACITY) ? row < activeCount() : row - headerValue(H_PARTICLE_CAPACITY) < depositCount()) &&
           readInt64(sourceFieldOffset(GRANULAR_SOLID_VOLUME_SVQ) + 2 * row) > 0l;
}
int sourceCell(int row) {
    return row < headerValue(H_PARTICLE_CAPACITY) ? cell(positionCell(readVector(sourceFieldOffset(GRANULAR_POSITION), row)))
                                        : int(words[sourceFieldOffset(GRANULAR_DEPOSIT_CELL) + row - headerValue(H_PARTICLE_CAPACITY)]);
}
bool activeCell(int cellIndex) {
    return headerValue(H_ACTIVITY_CELLS) < 0 || words[headerValue(H_ACTIVITY_CELLS) + cellIndex] != 0u;
}
int columnRow(int e) {
    return readFieldInt(FIELD_COLUMN_ENTRIES, e);
}
double particleMass(int row) {
    return double(readInt64(sourceFieldOffset(GRANULAR_MASS_UNITS) + 2 * row)) * MASS_UNIT_KG;
}
int64_t solidVolume(int row) {
    return readInt64(sourceFieldOffset(GRANULAR_SOLID_VOLUME_SVQ) + 2 * row);
}
int materialOf(int row) {
    return int(words[sourceFieldOffset(GRANULAR_MATERIAL) + row]);
}
double depositPorosity(int row) {
    return double(uintBitsToFloat(words[sourceFieldOffset(GRANULAR_DEPOSIT_POROSITY) + row - headerValue(H_PARTICLE_CAPACITY)]));
}
double bulkPortion(int row, int64_t amount) {
    return double(amount) / (1.0 - (row < headerValue(H_PARTICLE_CAPACITY) ? materialProperty(materialOf(row), MATERIAL_REST_POROSITY) : depositPorosity(row)));
}
int64_t portion(int64_t amount, int64_t n, int64_t d) {
    return (amount / d) * n + ((amount % d) * n) / d;
}
bool finite(double x) {
    return !isnan(x) && !isinf(x);
}
void reportInvalidState() {
    atomicOr(errors, ERROR_GRANULAR_TRANSITIONS);
}
double sphereRadius(int64_t svq) {
    return p.cellSize *
           clamp(double(pow(float(3.0 * double(svq) / SOLID_VOLUME_QUANTA_PER_CELL / (4.0 * 3.141592653589793)), 1.0 / 3.0)), .02, .20);
}
double openSvq(int c) {
    return double(bitCount((~words[headerValue(H_MASKS) + c]) & 255u)) * SOLID_VOLUME_QUANTA_PER_MICROCELL;
}
double bedHeight(int cellIndex, double bulkVolume) {
    uint mask = (~words[headerValue(H_MASKS) + cellIndex]) & 255u;
    double lowerCapacity = double(bitCount(mask & 0x33u)) * SOLID_VOLUME_QUANTA_PER_MICROCELL, upperCapacity = double(bitCount(mask & 0xccu)) * SOLID_VOLUME_QUANTA_PER_MICROCELL;
    double height = bulkVolume <= lowerCapacity ? (lowerCapacity > 0.0 ? .5 * bulkVolume / lowerCapacity : 0.0) : .5 + (upperCapacity > 0.0 ? .5 * (bulkVolume - lowerCapacity) / upperCapacity : 0.0);
    return (double(cellCoordinates(cellIndex).y) + clamp(height, 0.0, 1.0)) * p.cellSize;
}
double bedCenter(int cellIndex, double bulkVolume) {
    if (bulkVolume <= 0.0)
        return double(cellCoordinates(cellIndex).y) * p.cellSize;
    uint mask = (~words[headerValue(H_MASKS) + cellIndex]) & 255u;
    double lowerCapacity = double(bitCount(mask & 0x33u)) * SOLID_VOLUME_QUANTA_PER_MICROCELL, upperCapacity = double(bitCount(mask & 0xccu)) * SOLID_VOLUME_QUANTA_PER_MICROCELL;
    double lowerVolume = min(bulkVolume, lowerCapacity), upperVolume = max(0.0, bulkVolume - lowerCapacity),
           moment = (lowerCapacity > 0.0 ? lowerVolume * .25 * lowerVolume / lowerCapacity : 0.0) + (upperCapacity > 0.0 ? upperVolume * (.5 + .25 * upperVolume / upperCapacity) : 0.0);
    return (double(cellCoordinates(cellIndex).y) + moment / bulkVolume) * p.cellSize;
}
bool hasBedAbove(int c) {
    ivec3 q = cellCoordinates(c);
    for (int y = q.y; y + 1 < headerValue(H_SIZE_Y); y++) {
        int lower = cell(ivec3(q.x, y, q.z)), upper = cell(ivec3(q.x, y + 1, q.z));
        uint lowerOpen = (~words[headerValue(H_MASKS) + lower] & MICROCELL_TOP_MASK) >> 2;
        uint upperOpen = ~words[headerValue(H_MASKS) + upper] & MICROCELL_BOTTOM_MASK;
        if ((lowerOpen & upperOpen) == 0u)
            break;
        if (read(FIELD_CELL_BULK, upper) > 0.0)
            return true;
    }
    return false;
}
bool exposedSurface(int c) {
    return read(FIELD_CELL_BULK, c) > 0.0 && !hasBedAbove(c);
}
bool sphereFits(dvec3 position, double radius, int exclude) {
    if (any(lessThan(position, dvec3(radius))) || any(greaterThan(position, dvec3(gridDimensions()) * p.cellSize - radius)))
        return false;
    ivec3 low = positionCell(position - radius), high = positionCell(position + radius);
    for (int z = low.z; z <= high.z; z++)
        for (int y = low.y; y <= high.y; y++)
            for (int x = low.x; x <= high.x; x++) {
                ivec3 c = ivec3(x, y, z);
                uint mask = words[headerValue(H_MASKS) + cell(c)];
                for (int bit = 0; bit < 8; bit++)
                    if ((mask & (1u << bit)) != 0u) {
                        dvec3 lo = (dvec3(c) + .5 * dvec3(bit & 1, (bit >> 1) & 1, (bit >> 2) & 1)) * p.cellSize,
                              hi = lo + .5 * p.cellSize;
                        if (length(position - clamp(position, lo, hi)) < radius - 1e-7 * p.cellSize)
                            return false;
                    }
            }
    // The source spatial list remains immutable. Conservative rejection near an old active sphere
    // avoids simultaneous release overlap across independently processed columns.
    for (int z = max(0, low.z - 1); z <= min(headerValue(H_SIZE_Z) - 1, high.z + 1); z++)
        for (int x = max(0, low.x - 1); x <= min(headerValue(H_SIZE_X) - 1, high.x + 1); x++) {
            int col = z * headerValue(H_SIZE_X) + x;
            for (int e = readFieldInt(FIELD_COLUMN_OFFSETS, col); e < readFieldInt(FIELD_COLUMN_OFFSETS, col + 1); e++) {
                int row = columnRow(e);
                if (row >= headerValue(H_PARTICLE_CAPACITY) || row == exclude)
                    continue;
                if (length(position - readVector(sourceFieldOffset(GRANULAR_POSITION), row)) <
                    radius + sphereRadius(solidVolume(row)) - 1e-7 * p.cellSize)
                    return false;
            }
        }
    return true;
}
bool bedFits(int c, double b, int excluded) {
    if (b > read(FIELD_AVAILABLE_BULK, c) + 1e-6)
        return false;
    ivec3 q = cellCoordinates(c);
    double top = bedHeight(c, b);
    for (int z = max(0, q.z - 1); z <= min(headerValue(H_SIZE_Z) - 1, q.z + 1); z++)
        for (int x = max(0, q.x - 1); x <= min(headerValue(H_SIZE_X) - 1, q.x + 1); x++) {
            int col = z * headerValue(H_SIZE_X) + x;
            for (int e = readFieldInt(FIELD_COLUMN_OFFSETS, col); e < readFieldInt(FIELD_COLUMN_OFFSETS, col + 1); e++) {
                int row = columnRow(e);
                if (row >= headerValue(H_PARTICLE_CAPACITY) || row == excluded)
                    continue;
                dvec3 pos = readVector(sourceFieldOffset(GRANULAR_POSITION), row);
                double r = sphereRadius(solidVolume(row));
                dvec3 lo = dvec3(q) * p.cellSize, hi = lo + p.cellSize;
                hi.y = top;
                if (top > lo.y && length(pos - clamp(pos, lo, hi)) < r - 1e-7 * p.cellSize)
                    return false;
            }
        }
    return true;
}
bool pathOpen(dvec3 a, dvec3 b, double radius) {
    // Walk the fixed microboxes intersected by the swept sphere's axis-aligned enclosure.
    ivec3 low = positionCell(min(a, b) - radius), high = positionCell(max(a, b) + radius);
    dvec3 delta = b - a;
    for (int z = low.z; z <= high.z; z++)
        for (int y = low.y; y <= high.y; y++)
            for (int x = low.x; x <= high.x; x++) {
                ivec3 c = ivec3(x, y, z);
                uint mask = words[headerValue(H_MASKS) + cell(c)];
                for (int bit = 0; bit < 8; bit++)
                    if ((mask & (1u << bit)) != 0u) {
                        dvec3 lo = (dvec3(c) + .5 * dvec3(bit & 1, (bit >> 1) & 1, (bit >> 2) & 1)) * p.cellSize -
                                   radius,
                              hi = lo + .5 * p.cellSize + 2.0 * radius;
                        double near = 0.0, far = 1.0;
                        bool hit = true;
                        for (int axis = 0; axis < 3; axis++) {
                            if (delta[axis] == 0.0) {
                                if (a[axis] < lo[axis] || a[axis] > hi[axis])
                                    hit = false;
                            } else {
                                double t0 = (lo[axis] - a[axis]) / delta[axis], t1 = (hi[axis] - a[axis]) / delta[axis];
                                near = max(near, min(t0, t1));
                                far = min(far, max(t0, t1));
                            }
                        }
                        if (hit && near < far - 1e-9 && far > 1e-9 && near < 1.0 - 1e-9)
                            return false;
                    }
            }
    return true;
}
void cellState(int c, double bulk, double kilograms, double solid) {
    write(FIELD_CELL_BULK, c, max(0.0, bulk));
    write(FIELD_CELL_MASS, c, max(0.0, kilograms));
    write(FIELD_CELL_SOLID, c, max(0.0, solid));
}
void settleColumn(int column) {
    bool changed = false;
    int x = column % headerValue(H_SIZE_X), z = column / headerValue(H_SIZE_X);
    for (int e = readFieldInt(FIELD_COLUMN_OFFSETS, column); e < readFieldInt(FIELD_COLUMN_OFFSETS, column + 1); e++) {
        int row = columnRow(e);
        if (row >= headerValue(H_PARTICLE_CAPACITY) || !activeCell(sourceCell(row)))
            continue;
        dvec3 position = readVector(sourceFieldOffset(GRANULAR_POSITION), row), velocity = readVector(sourceFieldOffset(GRANULAR_VELOCITY), row);
        double radius = sphereRadius(solidVolume(row));
        double support = 0.0;
        int particleCellY = int(floor(position.y / p.cellSize));
        for (int y = 0; y <= min(particleCellY, headerValue(H_SIZE_Y) - 1); y++) {
            int c = cell(ivec3(x, y, z));
            if (read(FIELD_CELL_BULK, c) > 0.0)
                support = max(support, bedHeight(c, read(FIELD_CELL_BULK, c)));
            uint mask = words[headerValue(H_MASKS) + c];
            for (int bit = 0; bit < 8; bit++)
                if ((mask & (1u << bit)) != 0u) {
                    double top = (double(y) + .5 * double((bit >> 1) & 1) + .5) * p.cellSize;
                    dvec2 lo = (dvec2(x, z) + .5 * dvec2(bit & 1, (bit >> 2) & 1)) * p.cellSize;
                    if (top <= position.y + 1e-6 * p.cellSize &&
                        length(position.xz - clamp(position.xz, lo, lo + .5 * p.cellSize)) < radius)
                        support = max(support, top);
                }
        }
        bool supported =
            abs(position.y - radius - support) <= 1e-5 * p.cellSize && velocity.y <= 1e-5 * p.cellSize / p.duration;
        int age = supported ? min(2147483646, int(words[sourceFieldOffset(GRANULAR_CONTACT_AGE) + row])) + 1 : 0;
        words[sourceFieldOffset(GRANULAR_CONTACT_AGE) + row] = uint(age);
        words[sourceFieldOffset(GRANULAR_FLAGS) + row] = supported ? 1u : 0u;
        if (!supported || age < 3)
            continue;
        for (int y = 0; y <= min(particleCellY, headerValue(H_SIZE_Y) - 1); y++) {
            int c = cell(ivec3(x, y, z));
            if (!activeCell(c))
                continue;
            double oldBulk = read(FIELD_CELL_BULK, c), newBulk = oldBulk + bulkPortion(row, solidVolume(row));
            if (!bedFits(c, newBulk, row))
                continue;
            double newCenter = bedCenter(c, newBulk), oldCenter = bedCenter(c, oldBulk), particleMassKg = particleMass(row),
                   oldMass = read(FIELD_CELL_MASS, c);
            double potential = p.gravity * (oldMass * (newCenter - oldCenter) + particleMassKg * (newCenter - position.y));
            if (potential > 0.0)
                continue;
            dvec3 destination = dvec3(position.x, max(newCenter + radius, double(y) * p.cellSize + radius), position.z);
            if (!pathOpen(position, destination, radius))
                continue;
            writeFieldInt(FIELD_MODE, row, MODE_SETTLED);
            writeFieldInt(FIELD_TARGET, row, c);
            write(FIELD_HEAT, row, .5 * particleMassKg * dot(velocity, velocity) - potential);
            writeVector(fieldOffset(FIELD_REACTION_IMPULSE), row, particleMassKg * velocity);
            cellState(c, newBulk, oldMass + particleMassKg, read(FIELD_CELL_SOLID, c) + double(solidVolume(row)));
            changed = true;
            atomicAdd(words[fieldOffset(FIELD_CONTROL) + 3], 1u);
            break;
        }
    }
    bool allActive = true;
    for (int y = 0; y < headerValue(H_SIZE_Y); y++)
        allActive = allActive && activeCell(cell(ivec3(x, y, z)));
    words[targetFieldOffset(GRANULAR_STABLE_AGE) + column] = allActive
                                                ? (changed ? 0u : min(20u, words[sourceFieldOffset(GRANULAR_STABLE_AGE) + column] + 1u))
                                                : words[sourceFieldOffset(GRANULAR_STABLE_AGE) + column];
}
int exposedDeposit(int col, int c) {
    int best = -1;
    for (int e = readFieldInt(FIELD_COLUMN_OFFSETS, col); e < readFieldInt(FIELD_COLUMN_OFFSETS, col + 1); e++) {
        int row = columnRow(e);
        if (row < headerValue(H_PARTICLE_CAPACITY) || readFieldInt(FIELD_MODE, row) != MODE_DEPOSIT || sourceCell(row) != c)
            continue;
        if (best < 0 || solidVolume(row) > solidVolume(best) || solidVolume(row) == solidVolume(best) && row < best)
            best = row;
    }
    return best;
}
void relaxSurface(int from, int to, int sourceCellIndex) {
    if (!exposedSurface(sourceCellIndex) || !activeCell(sourceCellIndex))
        return;
    int row = exposedDeposit(from, sourceCellIndex);
    if (row < 0)
        return;
    int materialIndex = materialOf(row);
    int64_t movedVolume = min(solidVolume(row), 1048576l);
    if (words[sourceFieldOffset(GRANULAR_MIXTURE_PRESENT) + row] != 0u && movedVolume != solidVolume(row))
        return;
    int64_t takenMass = portion(readInt64(sourceFieldOffset(GRANULAR_MASS_UNITS) + 2 * row), movedVolume, solidVolume(row));
    if (takenMass <= 0l)
        return;
    ivec3 sourceCoord = cellCoordinates(sourceCellIndex);
    ivec2 targetColumn = ivec2(to % headerValue(H_SIZE_X), to / headerValue(H_SIZE_X));
    double sourceHeight = bedHeight(sourceCellIndex, read(FIELD_CELL_BULK, sourceCellIndex));
    double radius = sphereRadius(movedVolume), lowestHeight = sourceHeight;
    dvec3 start = (dvec3(sourceCoord) + .5) * p.cellSize;
    start.y = sourceHeight + radius;
    int targetCell = -1;
    for (int y = sourceCoord.y; y >= 0; y--) {
        int c = cell(ivec3(targetColumn.x, y, targetColumn.y));
        double bulk = read(FIELD_CELL_BULK, c), newBulk = bulk + bulkPortion(row, movedVolume);
        if (!activeCell(c) || newBulk > read(FIELD_AVAILABLE_BULK, c) || hasBedAbove(c))
            continue;
        double height = bulk > 0.0 ? bedHeight(c, bulk) : double(y) * p.cellSize;
        if (height >= lowestHeight || sourceHeight - height <= p.cellSize * materialProperty(materialIndex, MATERIAL_REPOSE_TANGENT))
            continue;
        dvec3 end = (dvec3(cellCoordinates(c)) + .5) * p.cellSize;
        end.y = bedHeight(c, newBulk) + radius;
        if (!pathOpen(start, end, radius))
            continue;
        targetCell = c;
        lowestHeight = height;
    }
    if (targetCell < 0)
        return;
    double sourceOldBulk = read(FIELD_CELL_BULK, sourceCellIndex), targetOldBulk = read(FIELD_CELL_BULK, targetCell),
           movedBulk = bulkPortion(row, movedVolume), movedMassKg = double(takenMass) * MASS_UNIT_KG;
    double sourceNewBulk = max(0.0, sourceOldBulk - movedBulk), targetNewBulk = targetOldBulk + movedBulk, sourceMass = read(FIELD_CELL_MASS, sourceCellIndex),
           targetMass = read(FIELD_CELL_MASS, targetCell);
    double potentialChange =
        p.gravity * ((sourceMass - movedMassKg) * bedCenter(sourceCellIndex, sourceNewBulk) + (targetMass + movedMassKg) * bedCenter(targetCell, targetNewBulk) -
                     sourceMass * bedCenter(sourceCellIndex, sourceOldBulk) - targetMass * bedCenter(targetCell, targetOldBulk));
    if (potentialChange > 0.0 || !bedFits(targetCell, targetNewBulk, -1))
        return;
    writeFieldInt(FIELD_MODE, row, MODE_RELOCATED);
    writeFieldInt(FIELD_TARGET, row, targetCell);
    writeQuantity(FIELD_MOVED_VOLUME, row, movedVolume);
    writeQuantity(FIELD_MOVED_MASS, row, takenMass);
    write(FIELD_HEAT, row, -potentialChange);
    cellState(sourceCellIndex, sourceNewBulk, sourceMass - movedMassKg, read(FIELD_CELL_SOLID, sourceCellIndex) - double(movedVolume));
    cellState(targetCell, targetNewBulk, targetMass + movedMassKg, read(FIELD_CELL_SOLID, targetCell) + double(movedVolume));
    words[targetFieldOffset(GRANULAR_STABLE_AGE) + from] = 0u;
    words[targetFieldOffset(GRANULAR_STABLE_AGE) + to] = 0u;
    atomicAdd(words[fieldOffset(FIELD_CONTROL) + 5], 1u);
}
void relaxPair(int column) {
    int axis = p.color / 2, parity = p.color % 2;
    ivec2 a = ivec2(column % headerValue(H_SIZE_X), column / headerValue(H_SIZE_X));
    if ((a[axis] & 1) != parity)
        return;
    ivec2 b = a;
    b[axis]++;
    if (b.x >= headerValue(H_SIZE_X) || b.y >= headerValue(H_SIZE_Z))
        return;
    int other = b.y * headerValue(H_SIZE_X) + b.x;
    for (int y = headerValue(H_SIZE_Y) - 1; y >= 0; y--) {
        relaxSurface(column, other, cell(ivec3(a.x, y, a.y)));
        relaxSurface(other, column, cell(ivec3(b.x, y, b.y)));
    }
}
int nx() {
    return (headerValue(H_SIZE_X) + 1) * headerValue(H_SIZE_Y) * headerValue(H_SIZE_Z);
}
int ny() {
