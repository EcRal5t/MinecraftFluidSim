                if (p.stage == STAGE_COUNT_DESTINATIONS) {
                    writeFieldInt(FIELD_DESTINATIONS, 2 * id + part, row);
                    atomicAdd(words[fieldOffset(FIELD_ROW_COUNTS) + row], 1u);
                } else {
                    int slot = int(atomicAdd(words[fieldOffset(FIELD_ROW_CURSORS) + row], 1u));
                    writeFieldInt(FIELD_ROW_ENTRIES, readFieldInt(FIELD_ROW_OFFSETS, row) + slot, 2 * id + part);
                }
            }
        } else {
            int row = id;
            if (readInt64(sourceFieldOffset(GRANULAR_SOLID_VOLUME_SVQ) + 2 * row) <= 0l)
                return;
            if (p.stage == STAGE_COUNT_DESTINATIONS)
                atomicAdd(words[fieldOffset(FIELD_ROW_COUNTS) + row], 1u);
            else {
                int slot = int(atomicAdd(words[fieldOffset(FIELD_ROW_CURSORS) + row], 1u));
                writeFieldInt(FIELD_ROW_ENTRIES, readFieldInt(FIELD_ROW_OFFSETS, row) + slot, 2 * headerValue(H_INPUT_ROWS) + id - headerValue(H_INPUT_ROWS));
            }
        }
        return;
    }
    if (p.stage == STAGE_GATHER_INVENTORY) {
        writeInt64(targetFieldOffset(GRANULAR_SOLID_VOLUME_SVQ) + 2 * id, 0l);
        writeInt64(targetFieldOffset(GRANULAR_MASS_UNITS) + 2 * id, 0l);
        writeInt64(targetFieldOffset(GRANULAR_MASS_RESIDUAL_UNITS) + 2 * id, 0l);
        writeDouble(targetFieldOffset(GRANULAR_INTERNAL_ENERGY) + 2 * id, 0.0);
        words[targetFieldOffset(GRANULAR_MIXTURE_PRESENT) + id] = 0u;
        gatherRow(id, false);
        write(FIELD_FINAL_ENERGY, id, readDouble(targetFieldOffset(GRANULAR_INTERNAL_ENERGY) + 2 * id));
        return;
    }
    if (p.stage == STAGE_PUBLISH_SPECIES_COUNT) {
        int species = int(words[targetFieldOffset(GRANULAR_SPECIES_OFFSETS) + headerValue(H_ROW_CAPACITY)]);
        writeFieldInt(FIELD_CONTROL, 2, species);
        if (species > headerValue(H_SPECIES_CAPACITY)) {
            atomicOr(errors, ERROR_INSUFFICIENT_CAPACITY);
            return;
        }
        words[targetFieldOffset(GRANULAR_COUNTS) + 2] = uint(species);
        writeInt64(targetFieldOffset(GRANULAR_LOGICAL_STEP), readInt64(sourceFieldOffset(GRANULAR_LOGICAL_STEP)) + (p.duration > 0.0 ? 1l : 0l));
        return;
    }
    if (p.stage == STAGE_GATHER_SPECIES)
        gatherRow(id, true);
}
