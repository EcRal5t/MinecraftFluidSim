#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
layout(local_size_x=128) in;
layout(binding=0,std430) readonly buffer Source { uint sourceWords[]; };
layout(binding=1,std430) buffer Candidate { uint candidateWords[]; };
layout(binding=2,std430) buffer Errors { uint errors; };
layout(push_constant) uniform Params {
    int operations; int termsWordOffset; int resultWordOffset; int countsWordOffset;
    int offsetsWordOffset; int limbsWordOffset; int limbCapacity; int stage;
} p;

// DYADIC_LIBRARY

uint dyadicWord(int bank,int index) { return bank==0?sourceWords[index]:candidateWords[index]; }
void dyadicWrite(int index,uint word) { candidateWords[index]=word; }

void loadTerms(int operation,out DyadicTerm items[7]) {
    int base=p.termsWordOffset+35*operation;
    for(int i=0;i<7;i++) {
        int at=base+5*i;
        items[i]=DyadicTerm(int(candidateWords[at]),int(candidateWords[at+1]),int(candidateWords[at+2]),
                int(candidateWords[at+3]),int(candidateWords[at+4]));
    }
}

// The four-word register sum is exact when the aligned span plus carry headroom fits.
// Cache canonical limbs in the existing result fields; the write pass then reads no terms.
bool cachePositiveSum(int operation,DyadicTerm items[7]) {
    int minimum=2147483647,present=0;int64_t maximum=int64_t(-9223372036854775807L);
    for(int i=0;i<7;i++)if(dyadicPresent(items[i])){
        if(items[i].sign<0)return false;
        minimum=min(minimum,items[i].exponent);present++;
        int top=items[i].count-1;
        maximum=max(maximum,int64_t(items[i].exponent)+int64_t(32)*int64_t(top)+int64_t(findMSB(dyadicWord(items[i].bank,items[i].offset+top))));
    }
    int at=p.resultWordOffset+8*operation;
    if(present==0){
        candidateWords[at]=uint(DYADIC_ZERO);candidateWords[at+1]=0u;candidateWords[at+2]=0u;
        candidateWords[at+7]=1u;candidateWords[p.countsWordOffset+operation]=0u;return true;
    }
    int headroom=present==1?0:findMSB(present-1)+1;
    if(maximum-int64_t(minimum)>=int64_t(128-headroom))return false;
    uvec4 sum=uvec4(0u);
    for(int term=0;term<7;term++)if(dyadicPresent(items[term])){
        uint64_t carry=uint64_t(0);
        for(int word=0;word<4;word++){
            uint64_t value=uint64_t(sum[word])+uint64_t(dyadicAlignedWord(items[term],word,minimum))+carry;
            sum[word]=uint(value);carry=value>>32;
        }
    }
    int first=0;while(first<4&&sum[first]==0u)first++;
    if(first==4)return false;
    int last=3;while(sum[last]==0u)last--;
    int trailing=findLSB(sum[first]),bits=32*(last-first)+findMSB(sum[last])-trailing+1,words=(bits+31)/32;
    int64_t exponent=int64_t(minimum)+int64_t(32*first+trailing);
    if(exponent>int64_t(2147483647)||exponent<int64_t(-2147483647)-int64_t(1))return false;
    candidateWords[at]=uint(DYADIC_POSITIVE);candidateWords[at+1]=uint(words);candidateWords[at+2]=uint(exponent);
    for(int word=0;word<4;word++){
        uint value=0u;
        if(word<words){int index=first+word;value=sum[index]>>trailing;if(trailing!=0&&index<3)value|=sum[index+1]<<(32-trailing);}
        candidateWords[at+3+word]=value;
    }
    candidateWords[at+7]=1u;candidateWords[p.countsWordOffset+operation]=uint(words);return true;
}

void measureOperation(int operation) {
    DyadicTerm items[7];loadTerms(operation,items);
    if(cachePositiveSum(operation,items))return;
    DyadicMeasure result=dyadicMeasure(items,7);
    int at=p.resultWordOffset+8*operation;
    candidateWords[at]=uint(result.status);
    candidateWords[at+1]=uint(result.words);
    candidateWords[at+2]=uint(result.exponent);
    candidateWords[at+3]=uint(result.minimumExponent);
    candidateWords[at+4]=uint(result.firstWord);
    candidateWords[at+5]=uint(result.lastWord);
    candidateWords[at+6]=uint(result.trailingBits);
    candidateWords[at+7]=0u;
    candidateWords[p.countsWordOffset+operation]=result.status==DYADIC_POSITIVE?uint(result.words):0u;
    if(result.status!=DYADIC_ZERO&&result.status!=DYADIC_POSITIVE)atomicOr(errors,32u);
}

void writeOperation(int operation) {
    // Every invocation observes the same completed scan before any limb writes start.
    uint required=candidateWords[p.offsetsWordOffset+p.operations];
    if(required>uint(p.limbCapacity)){atomicOr(errors,64u);return;}
    if((errors&16u)!=0u)return;
    int at=p.resultWordOffset+8*operation;
    if(int(candidateWords[at])!=DYADIC_POSITIVE)return;
    if(candidateWords[at+7]==1u){
        int count=int(candidateWords[at+1]),destination=p.limbsWordOffset+int(candidateWords[p.offsetsWordOffset+operation]);
        for(int word=0;word<count;word++)candidateWords[destination+word]=candidateWords[at+3+word];
        return;
    }
    DyadicMeasure result=DyadicMeasure(int(candidateWords[at]),int(candidateWords[at+1]),
            int(candidateWords[at+2]),int(candidateWords[at+3]),int(candidateWords[at+4]),
            int(candidateWords[at+5]),int(candidateWords[at+6]));
    DyadicTerm items[7];loadTerms(operation,items);
    int outputOffset=p.limbsWordOffset+int(candidateWords[p.offsetsWordOffset+operation]);
    dyadicWriteSum(items,7,result,outputOffset);
}

void main() {
    int operation=int((gl_WorkGroupID.y*gl_NumWorkGroups.x+gl_WorkGroupID.x)*128u+gl_LocalInvocationID.x);
    if(operation>=p.operations)return;
    if(p.stage==2){
        if((errors&~64u)!=0u)return;
        measureOperation(operation);
        uint count=candidateWords[p.countsWordOffset+operation];
        uint offset=count<=4u?4u*uint(operation):atomicAdd(candidateWords[p.offsetsWordOffset+p.operations],count);
        candidateWords[p.offsetsWordOffset+operation]=offset;
        return;
    }
    if(errors!=0u)return;
    if(p.stage==0)measureOperation(operation);else writeOperation(operation);
}
