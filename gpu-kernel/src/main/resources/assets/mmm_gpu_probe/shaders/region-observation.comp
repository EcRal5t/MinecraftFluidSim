#version 450
#extension GL_ARB_gpu_shader_fp64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
const int WORKGROUP_SIZE = 128;
const int STAGE_REDUCE_CELLS = 0;
const int STAGE_REDUCE_GROUPS = 1;
const int PARTIAL_VALUE_OFFSET = 32;
const int PARTIAL_VALUE_STRIDE = 17;
const int THERMAL_PARTIAL_OFFSET = 4;
const int MECHANICAL_PARTIAL_OFFSET = 8;
const int AUDIT_PARTIAL_OFFSET = 12;
const int THERMAL_OUTPUT_OFFSET = 8;
const int MECHANICAL_OUTPUT_OFFSET = 16;
const uint DEPOSIT_QUIET_AGE = 20u;
const uint MAXIMUM_THERMAL_MODE = 8u;
const double KILOGRAMS_PER_MASS_UNIT = 1e-10LF;
// Four-vector reductions: inventory=(volume,mass,maxFaceSpeed,maxParticleSpeed),
// thermal=(maxTemperatureChange,maxEnergyChange,viscousHeat,movingDeposit),
// mechanical=(liquidKineticLoss,grainKineticLoss,potentialChange,gasWork),
// audit=(kineticBefore,kineticAfter,absoluteMechanicalChange,mixingHeat).
layout(local_size_x=128)in;
layout(std430,binding=0)readonly buffer Arena{uint sourceWords[];};
layout(std430,binding=1)buffer Output{double observationValues[];};
layout(push_constant)uniform Params{int stage;int cells;int faces;int groups;int liquidCountsOffset;int cellOffsets;int volumeWords;int massWords;int faceWords;int granularCountsOffset;int particleVelocityWords;int owners;int thermalCountsOffset;int initialTemperatureWords;int finalTemperatureWords;int energyChangeWords;int thermalModeOffset;int viscousHeatOffset;int faceEnergyTermsOffset;int potentialEnergyTermsOffset;int potentialCount;int granularEnergyTermsOffset;int granularCount;int gasWorkOffset;int gasNodes;int mixingHeatOffset;int depositStableAgeOffset;int depositCellsOffset;int particleCapacity;int sizeX;int sizeY;int pad5;}params;
shared dvec4 sharedInventoryAndSpeed[WORKGROUP_SIZE];shared dvec4 sharedThermalSummary[WORKGROUP_SIZE];shared dvec4 sharedMechanicalSummary[WORKGROUP_SIZE];shared dvec4 sharedEnergyAudit[WORKGROUP_SIZE];shared uint sharedViscosityDomain[WORKGROUP_SIZE];
double readDouble(int i){return packDouble2x32(uvec2(sourceWords[i],sourceWords[i+1]));}
void main(){int lane=int(gl_LocalInvocationID.x),elementIndex=int(gl_GlobalInvocationID.x);dvec4 inventoryAndSpeed=dvec4(0),thermalSummary=dvec4(0),mechanicalSummary=dvec4(0),energyAudit=dvec4(0);uint viscosityDomain=0u;
 if(params.stage==STAGE_REDUCE_CELLS){
  if(elementIndex<params.cells)for(int row=int(sourceWords[params.cellOffsets+elementIndex]);row<int(sourceWords[params.cellOffsets+elementIndex+1]);row++){
   inventoryAndSpeed.x+=readDouble(params.volumeWords+2*row);uint64_t massUnits=uint64_t(sourceWords[params.massWords+2*row])|(uint64_t(sourceWords[params.massWords+2*row+1])<<32);inventoryAndSpeed.y+=double(massUnits)*KILOGRAMS_PER_MASS_UNIT;
  }
  if(elementIndex<params.faces)inventoryAndSpeed.z=abs(readDouble(params.faceWords+8*elementIndex+2));
  if(params.granularCountsOffset>=0 && elementIndex<int(sourceWords[params.granularCountsOffset])){
   dvec3 velocity=dvec3(readDouble(params.particleVelocityWords+6*elementIndex),readDouble(params.particleVelocityWords+6*elementIndex+2),readDouble(params.particleVelocityWords+6*elementIndex+4));inventoryAndSpeed.w=sqrt(dot(velocity,velocity));
  }
  if(params.thermalCountsOffset>=0 && elementIndex<int(sourceWords[params.thermalCountsOffset])) {thermalSummary.x=abs(readDouble(params.finalTemperatureWords+2*elementIndex)-readDouble(params.initialTemperatureWords+2*elementIndex));thermalSummary.y=abs(readDouble(params.energyChangeWords+4*elementIndex));}
  if(params.depositStableAgeOffset>=0 && elementIndex<int(sourceWords[params.granularCountsOffset+1])){int cell=int(sourceWords[params.depositCellsOffset+elementIndex]),column=cell%params.sizeX+params.sizeX*(cell/(params.sizeX*params.sizeY));thermalSummary.w=sourceWords[params.depositStableAgeOffset+column]<DEPOSIT_QUIET_AGE?1.0LF:0.0LF;}
  if(params.viscousHeatOffset>=0 && elementIndex<params.cells)thermalSummary.z=readDouble(params.viscousHeatOffset+2*elementIndex);
  if(params.pad5>=0 && elementIndex<params.cells && sourceWords[params.pad5+elementIndex]!=0u)viscosityDomain=1u;

  if(params.faceEnergyTermsOffset>=0){
   if(elementIndex<params.faces){double kineticEnergyBefore=readDouble(params.faceEnergyTermsOffset+4*elementIndex),kineticEnergyAfter=-readDouble(params.faceEnergyTermsOffset+4*elementIndex+2);mechanicalSummary.x=kineticEnergyBefore-kineticEnergyAfter;energyAudit.x=kineticEnergyBefore;energyAudit.y=kineticEnergyAfter;energyAudit.z=abs(mechanicalSummary.x);}
   if(elementIndex<params.potentialCount){double potentialEnergyChange=readDouble(params.potentialEnergyTermsOffset+4*elementIndex)+readDouble(params.potentialEnergyTermsOffset+4*elementIndex+2);mechanicalSummary.z+=potentialEnergyChange;energyAudit.z+=abs(potentialEnergyChange);}
   if(elementIndex<params.granularCount){double kineticEnergyBefore=readDouble(params.granularEnergyTermsOffset+8*elementIndex),kineticEnergyAfter=-readDouble(params.granularEnergyTermsOffset+8*elementIndex+2),potentialEnergyChange=readDouble(params.granularEnergyTermsOffset+8*elementIndex+4)+readDouble(params.granularEnergyTermsOffset+8*elementIndex+6);mechanicalSummary.y=kineticEnergyBefore-kineticEnergyAfter;mechanicalSummary.z+=potentialEnergyChange;energyAudit.x+=kineticEnergyBefore;energyAudit.y+=kineticEnergyAfter;energyAudit.z+=abs(kineticEnergyBefore-kineticEnergyAfter)+abs(potentialEnergyChange);}
   if(params.gasWorkOffset>=0&&elementIndex<params.gasNodes){mechanicalSummary.w=-(readDouble(params.gasWorkOffset+4*elementIndex)+readDouble(params.gasWorkOffset+4*elementIndex+2));energyAudit.z+=abs(mechanicalSummary.w);}
   if(params.mixingHeatOffset>=0&&elementIndex<params.cells)energyAudit.w=readDouble(params.mixingHeatOffset+2*elementIndex);
  }
 }else for(int k=lane;k<params.groups;k+=WORKGROUP_SIZE){int partialOffset=PARTIAL_VALUE_OFFSET+PARTIAL_VALUE_STRIDE*k;inventoryAndSpeed.xy+=dvec2(observationValues[partialOffset],observationValues[partialOffset+1]);inventoryAndSpeed.zw=max(inventoryAndSpeed.zw,dvec2(observationValues[partialOffset+2],observationValues[partialOffset+3]));thermalSummary.xy=max(thermalSummary.xy,dvec2(observationValues[partialOffset+THERMAL_PARTIAL_OFFSET],observationValues[partialOffset+5]));thermalSummary.z+=observationValues[partialOffset+6];thermalSummary.w=max(thermalSummary.w,observationValues[partialOffset+7]);viscosityDomain+=uint(observationValues[partialOffset+16]);for(int j=0;j<4;j++){mechanicalSummary[j]+=observationValues[partialOffset+MECHANICAL_PARTIAL_OFFSET+j];energyAudit[j]+=observationValues[partialOffset+AUDIT_PARTIAL_OFFSET+j];}}

 sharedInventoryAndSpeed[lane]=inventoryAndSpeed;sharedThermalSummary[lane]=thermalSummary;sharedMechanicalSummary[lane]=mechanicalSummary;sharedEnergyAudit[lane]=energyAudit;sharedViscosityDomain[lane]=viscosityDomain;barrier();for(int reductionStride=WORKGROUP_SIZE/2;reductionStride>0;reductionStride>>=1){if(lane<reductionStride){sharedInventoryAndSpeed[lane].xy+=sharedInventoryAndSpeed[lane+reductionStride].xy;sharedInventoryAndSpeed[lane].zw=max(sharedInventoryAndSpeed[lane].zw,sharedInventoryAndSpeed[lane+reductionStride].zw);sharedThermalSummary[lane].xy=max(sharedThermalSummary[lane].xy,sharedThermalSummary[lane+reductionStride].xy);sharedThermalSummary[lane].z+=sharedThermalSummary[lane+reductionStride].z;sharedThermalSummary[lane].w=max(sharedThermalSummary[lane].w,sharedThermalSummary[lane+reductionStride].w);sharedMechanicalSummary[lane]+=sharedMechanicalSummary[lane+reductionStride];sharedEnergyAudit[lane]+=sharedEnergyAudit[lane+reductionStride];sharedViscosityDomain[lane]+=sharedViscosityDomain[lane+reductionStride];}barrier();}
 if(lane==0){int outputOffset=params.stage==STAGE_REDUCE_CELLS?PARTIAL_VALUE_OFFSET+PARTIAL_VALUE_STRIDE*int(gl_WorkGroupID.x):0;for(int k=0;k<4;k++)observationValues[outputOffset+k]=sharedInventoryAndSpeed[0][k];
  observationValues[params.stage==STAGE_REDUCE_CELLS?outputOffset+16:14]=double(sharedViscosityDomain[0]);
  int thermalOutputOffset=params.stage==STAGE_REDUCE_CELLS?outputOffset+THERMAL_PARTIAL_OFFSET:THERMAL_OUTPUT_OFFSET;for(int k=0;k<4;k++)observationValues[thermalOutputOffset+k]=sharedThermalSummary[0][k];
  int mechanicalOutputOffset=params.stage==STAGE_REDUCE_CELLS?outputOffset+MECHANICAL_PARTIAL_OFFSET:MECHANICAL_OUTPUT_OFFSET;for(int k=0;k<4;k++){observationValues[mechanicalOutputOffset+k]=sharedMechanicalSummary[0][k];observationValues[mechanicalOutputOffset+4+k]=sharedEnergyAudit[0][k];}
  if(params.stage==STAGE_REDUCE_GROUPS){observationValues[13]=sharedThermalSummary[0].w;observationValues[4]=double(sourceWords[params.liquidCountsOffset]);observationValues[5]=params.granularCountsOffset<0?0.0LF:double(sourceWords[params.granularCountsOffset]);observationValues[6]=params.granularCountsOffset<0?0.0LF:double(sourceWords[params.granularCountsOffset+1]);observationValues[7]=0.0LF;observationValues[11]=params.thermalCountsOffset<0?0.0LF:double(sourceWords[params.thermalModeOffset]<=MAXIMUM_THERMAL_MODE?sourceWords[params.thermalModeOffset]:1u);observationValues[12]=params.thermalCountsOffset<0?0.0LF:double(sourceWords[params.thermalCountsOffset+2]);}
 }
}
