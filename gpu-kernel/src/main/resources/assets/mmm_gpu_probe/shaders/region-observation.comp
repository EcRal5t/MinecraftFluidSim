#version 450
#extension GL_ARB_gpu_shader_fp64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
layout(local_size_x=128)in;
layout(std430,binding=0)readonly buffer Arena{uint data[];};
layout(std430,binding=1)buffer Output{double result[];};
layout(push_constant)uniform Params{int stage;int cells;int faces;int groups;int counts;int offsets;int volumes;int masses;int faceData;int solidCounts;int velocities;int owners;int thermalCounts;int initialT;int finalT;int energyChange;int thermalMode;int viscousHeat;int faceTerms;int potentialTerms;int potentialCount;int granularTerms;int granularCount;int gasWork;int gasNodes;int mixingHeat;int stableAge;int depositCells;int particleCapacity;int nx;int ny;int pad5;}p;
shared dvec4 partial[128];shared dvec4 heatPartial[128];shared dvec4 mechanicalPartial[128];shared dvec4 auditPartial[128];
double number(int i){return packDouble2x32(uvec2(data[i],data[i+1]));}
void main(){int lane=int(gl_LocalInvocationID.x),id=int(gl_GlobalInvocationID.x);dvec4 value=dvec4(0),heat=dvec4(0),mechanical=dvec4(0),audit=dvec4(0);
 if(p.stage==0){
  if(id<p.cells)for(int row=int(data[p.offsets+id]);row<int(data[p.offsets+id+1]);row++){
   value.x+=number(p.volumes+2*row);uint64_t q=uint64_t(data[p.masses+2*row])|(uint64_t(data[p.masses+2*row+1])<<32);value.y+=double(q)*1e-10LF;
  }
  if(id<p.faces)value.z=abs(number(p.faceData+8*id+2));
  if(p.solidCounts>=0 && id<int(data[p.solidCounts])){
   dvec3 velocity=dvec3(number(p.velocities+6*id),number(p.velocities+6*id+2),number(p.velocities+6*id+4));value.w=sqrt(dot(velocity,velocity));
  }
  if(p.thermalCounts>=0 && id<int(data[p.thermalCounts])) {heat.x=abs(number(p.finalT+2*id)-number(p.initialT+2*id));heat.y=abs(number(p.energyChange+4*id));}
  if(p.stableAge>=0 && id<int(data[p.solidCounts+1])){int cell=int(data[p.depositCells+id]),column=cell%p.nx+p.nx*(cell/(p.nx*p.ny));heat.w=data[p.stableAge+column]<20u?1.0LF:0.0LF;}
  if(p.viscousHeat>=0 && id<p.cells)heat.z=number(p.viscousHeat+2*id);

  if(p.faceTerms>=0){
   if(id<p.faces){double before=number(p.faceTerms+4*id),after=-number(p.faceTerms+4*id+2);mechanical.x=before-after;audit.x=before;audit.y=after;audit.z=abs(mechanical.x);}
   if(id<p.potentialCount){double pe=number(p.potentialTerms+4*id)+number(p.potentialTerms+4*id+2);mechanical.z+=pe;audit.z+=abs(pe);}
   if(id<p.granularCount){double before=number(p.granularTerms+8*id),after=-number(p.granularTerms+8*id+2),pe=number(p.granularTerms+8*id+4)+number(p.granularTerms+8*id+6);mechanical.y=before-after;mechanical.z+=pe;audit.x+=before;audit.y+=after;audit.z+=abs(before-after)+abs(pe);}
   if(p.gasWork>=0&&id<p.gasNodes){mechanical.w=-(number(p.gasWork+4*id)+number(p.gasWork+4*id+2));audit.z+=abs(mechanical.w);}
   if(p.mixingHeat>=0&&id<p.cells)audit.w=number(p.mixingHeat+2*id);
  }
 }else for(int k=lane;k<p.groups;k+=128){int at=32+16*k;value.xy+=dvec2(result[at],result[at+1]);value.zw=max(value.zw,dvec2(result[at+2],result[at+3]));heat.xy=max(heat.xy,dvec2(result[at+4],result[at+5]));heat.z+=result[at+6];heat.w=max(heat.w,result[at+7]);for(int j=0;j<4;j++){mechanical[j]+=result[at+8+j];audit[j]+=result[at+12+j];}}

 partial[lane]=value;heatPartial[lane]=heat;mechanicalPartial[lane]=mechanical;auditPartial[lane]=audit;barrier();for(int step=64;step>0;step>>=1){if(lane<step){partial[lane].xy+=partial[lane+step].xy;partial[lane].zw=max(partial[lane].zw,partial[lane+step].zw);heatPartial[lane].xy=max(heatPartial[lane].xy,heatPartial[lane+step].xy);heatPartial[lane].z+=heatPartial[lane+step].z;heatPartial[lane].w=max(heatPartial[lane].w,heatPartial[lane+step].w);mechanicalPartial[lane]+=mechanicalPartial[lane+step];auditPartial[lane]+=auditPartial[lane+step];}barrier();}
 if(lane==0){int outAt=p.stage==0?32+16*int(gl_WorkGroupID.x):0;for(int k=0;k<4;k++)result[outAt+k]=partial[0][k];
  int heatAt=p.stage==0?outAt+4:8;for(int k=0;k<4;k++)result[heatAt+k]=heatPartial[0][k];
  int mechanicalAt=p.stage==0?outAt+8:16;for(int k=0;k<4;k++){result[mechanicalAt+k]=mechanicalPartial[0][k];result[mechanicalAt+4+k]=auditPartial[0][k];}
  if(p.stage==1){result[13]=heatPartial[0].w;result[4]=double(data[p.counts]);result[5]=p.solidCounts<0?0.0LF:double(data[p.solidCounts]);result[6]=p.solidCounts<0?0.0LF:double(data[p.solidCounts+1]);result[7]=0.0LF;result[11]=p.thermalCounts<0?0.0LF:double(data[p.thermalMode]<=8u?data[p.thermalMode]:1u);result[12]=p.thermalCounts<0?0.0LF:double(data[p.thermalCounts+2]);}
 }
}
