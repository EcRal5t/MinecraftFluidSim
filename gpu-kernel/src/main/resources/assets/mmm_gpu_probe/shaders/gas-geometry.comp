    float l=left<0?0.0:fraction(left,high),r=right<0?0.0:fraction(right,low);
    if(l>=1.0||r>=1.0)return 0.0;if(l<=0.0&&r<=0.0)return .25;
    vec2 polygon[8];polygon[0]=vec2(0);polygon[1]=vec2(.5,0);polygon[2]=vec2(.5);polygon[3]=vec2(0,.5);
    int count=4;if(l>0.0)count=clipCell(polygon,count,left,axis,1,a,b);
    if(r>0.0)count=clipCell(polygon,count,right,axis,0,a,b);
