    float leftFill=left<0?0.0:float(number(h(8)+8*left+6)),rightFill=right<0?0.0:float(number(h(8)+8*right+6));
    vec4 leftPlane=left<0?vec4(0):vec4(number(h(9)+8*left),number(h(9)+8*left+2),number(h(9)+8*left+4),number(h(9)+8*left+6));
