float microArea(int left,int right,int axis,int a,int b) {
    int tangent=(axis+1)%3,other=(axis+2)%3,low=(a<<tangent)|(b<<other),high=low|(1<<axis);
    if(left>=0&&(support(left)&(1u<<high))==0u)return 0.0;
