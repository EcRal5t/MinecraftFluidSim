void scheduleQueues(){for(int i=0;i<3;i++){uint total=words[h(43)+i],groups=(total+127u)/128u;int at=h(43)+3+3*i;words[at]=min(groups,65535u);words[at+1]=max(1u,(groups+65534u)/65535u);words[at+2]=1u;}}
