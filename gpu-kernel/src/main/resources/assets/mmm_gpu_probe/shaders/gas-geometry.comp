  if(internal&&open>0.0&&mass>0.0){int xFaces=(h(0)+1)*h(1)*h(2),yFaces=h(0)*(h(1)+1)*h(2),local=face-(axis==0?0:axis==1?xFaces:xFaces+yFaces);speed=number(h(37+axis)+2*local)/mass;}
