float polygonArea(vec2 polygon[8],int count){
    float twice=0.0;for(int i=1;i+1<count;i++){vec2 x=polygon[i]-polygon[0],y=polygon[i+1]-polygon[0];twice+=x.x*y.y-x.y*y.x;}
    return clamp(abs(twice)*.5,0.0,.25);
