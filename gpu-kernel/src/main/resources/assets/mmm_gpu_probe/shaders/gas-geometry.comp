// Gas may ignore a thin-film plane or a numerically empty microcell. Clip its subset first,
// then finish the physical dry intersection used by the liquid wet union. Each plane is clipped once.
vec2 sharedMicroAreas(float leftFill,float rightFill,vec4 leftPlane,vec4 rightPlane,
                      float leftFraction,float rightFraction,bool gasEnabled,int axis,int a,int b){
    vec2 polygon[8];polygon[0]=vec2(0);polygon[1]=vec2(.5,0);polygon[2]=vec2(.5);polygon[3]=vec2(0,.5);
    bool gasClosed=!gasEnabled||leftFraction>=1.0||rightFraction>=1.0;
    bool gasLeft=!gasClosed&&leftFraction>0.0,gasRight=!gasClosed&&rightFraction>0.0;
    int count=4;
    if(gasLeft)count=clipPort(polygon,count,leftPlane,axis,1,a,b);
    if(gasRight)count=clipPort(polygon,count,rightPlane,axis,0,a,b);
    float gasArea=gasClosed?0.0:polygonArea(polygon,count),physicalDry=0.0;
    if(leftFill<1.0&&rightFill<1.0){
