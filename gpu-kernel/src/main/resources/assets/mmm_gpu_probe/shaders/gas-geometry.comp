#version 450
#extension GL_ARB_gpu_shader_fp64 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_ballot : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
layout(local_size_x = 128) in;
layout(binding = 0, std430) coherent buffer Candidate {
    uint words[];
};
layout(binding = 1, std430) buffer Errors {
    uint errors;
};
layout(push_constant) uniform Params {
    int header;
    int stage;
    int count;
    int gasPieces;
    int gasCounts;
}
p;
// HOST_LAYOUT
// SPATIAL_GRID
// PLIC_FACE_LIBRARY
int headerWord(int index) {
    return int(words[p.header + index]);
}
double readDouble(int at) {
    return packDouble2x32(uvec2(words[at], words[at + 1]));
}
void writeDouble(int at, double value) {
    uvec2 bits = unpackDouble2x32(value);
    words[at] = bits.x;
    words[at + 1] = bits.y;
}
uint support(int cell) {
    return (~words[headerWord(GEO_H_MASKS) + cell]) & 255u;
}
bool present(int cell) {
    return cell >= 0 && words[headerWord(GEO_H_PRESENCE) + cell] != 0u;
}
double cellSize() {
    return readDouble(p.header + GEO_H_CELL_SIZE);
}
// Cell gas inventory row is stable; zero-volume cells have no geometric piece.
void captureLocalCell(int cell) {
    double volume = readDouble(headerWord(GEO_H_MIXTURE_STATES) + 2 * (7 * cell + 2));
    uint open = support(cell), mask = 0u;
    bool hasDry = volume > 0.0 && open != 0u;
    words[headerWord(GEO_H_PRESENCE) + cell] = hasDry ? 1u : 0u;
    words[headerWord(GEO_H_CELL_NODES) + cell] = hasDry ? uint(cell + 1) : uint(-1);
    writeDouble(headerWord(GEO_H_DRY_VOLUMES) + 2 * cell, volume);
    double pore = readDouble(headerWord(GEO_H_CELLS) + 8 * cell + 4);
    double microPore = open != 0u ? pore / double(bitCount(open)) : 0.0;
    for (int micro = 0; micro < 8; micro++) {
        double liquid = readDouble(headerWord(GEO_H_MICRO) + 2 * (8 * cell + micro));
        words[headerWord(GEO_H_MICRO_FRACTIONS) + 8 * cell + micro] = floatBitsToUint(
            microPore > 0.0 ? float(clamp(liquid / microPore, 0.0LF, 1.0LF)) : 1.0);
        if (hasDry && (open & (1u << micro)) != 0u && liquid < microPore)
            mask |= 1u << micro;
    }
    bool compact = hasDry && mask == 0u;
    if (compact) mask = 1u << findLSB(open);
    words[headerWord(GEO_H_DRY_MASKS) + cell] = mask;
}
ivec3 faceEndpoints(int face) { return gridFaceEndpoints(face); }
float fraction(int cell, int micro) {
    return uintBitsToFloat(words[headerWord(GEO_H_MICRO_FRACTIONS) + 8 * cell + micro]);
}
dvec4 cellPlane(int cell) {
    int at = headerWord(GEO_H_PLANES) + 8 * cell;
    return dvec4(readDouble(at), readDouble(at + 2), readDouble(at + 4), readDouble(at + 6));
}
double dryRectangle(dvec4 leftPlane, dvec4 rightPlane, bool leftCut, bool rightCut,
                    int axis, int bit) {
    dvec2 lo, hi; plicPortBounds(axis, bit, lo, hi);
    if (leftCut && !plicPortRect(leftPlane, axis, 1.0LF, bit, false, lo, hi)) return 0.0;
    if (rightCut && !plicPortRect(rightPlane, axis, 0.0LF, bit, false, lo, hi)) return 0.0;
    return (hi.x - lo.x) * (hi.y - lo.y);
}
float microArea(int left, int right, int axis, int a, int b) {
    int tangent = (axis + 1) % 3, other = (axis + 2) % 3, low = (a << tangent) | (b << other), high = low | (1 << axis);
    uint ls = left < 0 ? 255u : support(left), rs = right < 0 ? 255u : support(right);
    if (!plicOpenPort(ls, rs, high, low)) return 0.0;
    float l = left < 0 ? 0.0 : fraction(left, high), r = right < 0 ? 0.0 : fraction(right, low);
    if (l >= 1.0 || r >= 1.0) return 0.0;
    if (l <= 0.0 && r <= 0.0) return .25;
    dvec4 lp = l > 0.0 ? cellPlane(left) : dvec4(0.0);
    dvec4 rp = r > 0.0 ? cellPlane(right) : dvec4(0.0);
    return float(dryRectangle(lp, rp, l > 0.0, r > 0.0, axis, low));
}
void captureFace(int face) {
    writeDouble(headerWord(GEO_H_FACE_AREAS) + 2 * face, 0.0);
    if (errors != 0u)
        return;
    ivec3 ends = faceEndpoints(face);
    int left = ends.x, right = ends.y, axis = ends.z;
    if ((left >= 0 && !present(left)) || (right >= 0 && !present(right)))
        return;
    float area = 0.0;
    for (int a = 0; a < 2; a++)
        for (int b = 0; b < 2; b++)
            area += microArea(left, right, axis, a, b);
    if (area <= 0.0)
        return;
    double scale = cellSize();
    writeDouble(headerWord(GEO_H_FACE_AREAS) + 2 * face, double(area) * scale * scale);
}
void main() {
    uint id=(gl_WorkGroupID.y*gl_NumWorkGroups.x+gl_WorkGroupID.x)*128u+gl_LocalInvocationID.x;
    if(id>=uint(p.count))return;
    if(p.stage==13)captureLocalCell(int(id));
    else if(p.stage==14)captureFace(int(id));
}
