#version 450
#extension GL_ARB_gpu_shader_fp64 : require

const int STAGE_ASSEMBLE_PRESSURE = 1;
const int STAGE_PREDICT_COUPLED = 3;
const uint ERROR_PRESSURE_PROJECTION = 8u;
const int CELL_LIQUID_VOLUME = 0;
const int CELL_MASS = 1;
const int CELL_PORE_VOLUME = 2;
const int CELL_FILL = 3;
const int FACE_MASS = 0;
const int FACE_VELOCITY = 1;
const int FACE_OPEN_AREA = 2;
const int FACE_WET_AREA = 3;
const int MIXTURE_STRIDE = 7;
const int MIXTURE_PRESSURE = 0;
const int MIXTURE_STORAGE = 5;
const int PRESSURE_ROW_ENTRIES = 7;
layout(local_size_x = 128) in;
layout(push_constant) uniform Metadata {
    int sx;
    int sy;
    int sz;
    int stage;
    float h;
    float dt;
    float gravity;
    float tolerance;
    int rows;
}
pc;
layout(std430, binding = 0) readonly buffer Cells {
    dvec4 cells[];
};
layout(std430, binding = 1) buffer Faces {
    dvec4 faces[];
};
layout(std430, binding = 2) buffer Starts {
    int starts[];
};
layout(std430, binding = 3) buffer Columns {
    int columns[];
};
layout(std430, binding = 4) buffer Values {
    double values[];
};
layout(std430, binding = 5) buffer Rows {
    int rows[];
};
layout(std430, binding = 6) buffer Problem {
    double problem[];
};
layout(std430, binding = 7) buffer Pressure {
    double pressure[];
};
layout(std430, binding = 8) buffer Errors {
    uint errors;
};
layout(std430, binding = 9) readonly buffer ActiveCells {
    uint activeCells[];
};
layout(std430, binding = 10) readonly buffer ActiveFaces {
    uint activeFaces[];
};
layout(std430, binding = 11) readonly buffer MixtureStates {
    double mixture[];
};

int cellCount() {
    return pc.sx * pc.sy * pc.sz;
}
int xFaces() {
    return (pc.sx + 1) * pc.sy * pc.sz;
}
int yFaces() {
    return pc.sx * (pc.sy + 1) * pc.sz;
}
int cellIndex(ivec3 p) {
    return (p.z * pc.sy + p.y) * pc.sx + p.x;
}
bool inside(ivec3 p) {
    return all(greaterThanEqual(p, ivec3(0))) && all(lessThan(p, ivec3(pc.sx, pc.sy, pc.sz)));
}
bool pressureCell(int c) {
    return activeCells[c] != 0u && cells[c][CELL_MASS] > 0.0 && cells[c][CELL_PORE_VOLUME] > 0.0;
}
int faceIndex(ivec3 p, int axis) {
    ivec3 shape = ivec3(pc.sx, pc.sy, pc.sz);
    shape[axis]++;
    return (axis == 0 ? 0 : axis == 1 ? xFaces() : xFaces() + yFaces()) + (p.z * shape.y + p.y) * shape.x + p.x;
}
double facePressureCoefficient(int face) {
    return activeFaces[face] != 0u && faces[face][FACE_MASS] > 0.0 ? faces[face][FACE_OPEN_AREA] / double(pc.h) : 0.0;
}
double inverseFaceInertia(int face) {
    double h = double(pc.h);
    return faces[face][FACE_MASS] > 0.0 ? h * h * h / faces[face][FACE_MASS] : 0.0;
}

void predictFaceVelocity(int face) {
    if (activeFaces[face] == 0u)
        return;
    if (faces[face][FACE_OPEN_AREA] <= 0.0 || faces[face][FACE_MASS] <= 0.0) {
        faces[face][FACE_VELOCITY] = 0.0;
        return;
    }
    if (face >= xFaces() && face < xFaces() + yFaces())
        faces[face][FACE_VELOCITY] -= double(pc.gravity) * double(pc.dt);

}

// The regular-grid block supplies the preconditioner for the common pressure operator.
void assemblePressureRow(int row) {
    ivec3 cellPosition = ivec3(row % pc.sx, row / pc.sx % pc.sy, row / (pc.sx * pc.sy));
    int rowStart = PRESSURE_ROW_ENTRIES * row;
    starts[row] = rowStart;
    columns[rowStart] = row;
    double diagonal = 0.0, rightHandSide = 0.0;
    bool enabled = pressureCell(row);
    for (int side = 0; side < 6; side++) {
        int axis = side / 2;
        bool upper = (side & 1) != 0;
        ivec3 adjacent = cellPosition;
        adjacent[axis] += upper ? 1 : -1;
        ivec3 facePosition = cellPosition;
        if (upper)
            facePosition[axis]++;
        int face = faceIndex(facePosition, axis), peer = inside(adjacent) ? cellIndex(adjacent) : row;
        double pressureCoefficient = facePressureCoefficient(face), faceDiagonal = pressureCoefficient * pressureCoefficient * inverseFaceInertia(face);
        columns[rowStart + 1 + side] = peer;
        values[rowStart + 1 + side] = enabled && inside(adjacent) && pressureCell(peer) ? -faceDiagonal : 0.0;
        if (enabled) {
            diagonal += faceDiagonal;
            rightHandSide += (upper ? -1.0 : 1.0) * pressureCoefficient * faces[face][FACE_VELOCITY] / double(pc.dt);
        }
    }
    double storage = enabled ? mixture[MIXTURE_STRIDE * row + MIXTURE_STORAGE] : 0.0;
    if (isnan(storage) || isinf(storage) || storage < 0.0) atomicOr(errors, ERROR_PRESSURE_PROJECTION);
    diagonal += storage;
    bool unknown = enabled && diagonal > 0.0;
    rows[row] = unknown ? row : -1;
    values[rowStart] = unknown ? diagonal : 1.0;
    problem[row] = unknown ? rightHandSide : 0.0;
    problem[pc.rows + row] = unknown ? pressure[row] : 0.0;
    if (row == 0) {
        starts[cellCount()] = PRESSURE_ROW_ENTRIES * cellCount();
        problem[2 * pc.rows] = double(pc.tolerance);
    }
}

void main() {
    int id = int(gl_GlobalInvocationID.x);
    if (pc.stage == STAGE_ASSEMBLE_PRESSURE) {
        if (id < cellCount())
            assemblePressureRow(id);
        return;
    }
    if (id >= xFaces() + yFaces() + pc.sx * pc.sy * (pc.sz + 1))
        return;
    if (pc.stage == STAGE_PREDICT_COUPLED)
        predictFaceVelocity(id);
}
