#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_ballot : require
#extension GL_ARB_gpu_shader_fp64 : require
layout(local_size_x=128) in;
layout(binding=0,std430) buffer Arena { uint words[]; };
layout(binding=1,std430) buffer Errors { uint errors; };
layout(push_constant) uniform Params { int header;int stage;int count;int step;double dt;double fraction; } p;
shared dvec4 scratch[128];
int h(int i){return int(words[p.header+i]);}int at(int field){return h(8+field);}
int get(int field,int i){return int(words[at(field)+i]);}void put(int field,int i,int x){words[at(field)+i]=uint(x);}
// Reserve the first lane's shared destination once for the participating subgroup.
uint reserveIncident(int address){
 uvec4 participants=subgroupBallot(true);uint first=subgroupBallotFindLSB(participants);
 int sharedAddress=subgroupBroadcastFirst(address);uvec4 peers=subgroupBallot(address==sharedAddress);uint base=0u;
 if(gl_SubgroupInvocationID==first)base=atomicAdd(words[address],subgroupBallotBitCount(peers));
 base=subgroupBroadcastFirst(base);
 return address==sharedAddress?base+subgroupBallotExclusiveBitCount(peers):atomicAdd(words[address],1u);
}
double raw(int address){return packDouble2x32(uvec2(words[address],words[address+1]));}
double num(int field,int i){return raw(at(field)+2*i);}
bool finite(double x){return !isnan(x)&&!isinf(x);}void invalid(){atomicOr(errors,16384u);}
void store(int field,int i,double x){if(!finite(x))invalid();uvec2 b=unpackDouble2x32(x);words[at(field)+2*i]=b.x;words[at(field)+2*i+1]=b.y;}
#define COUNTS 0
#define ENERGY 1
#define INITIAL_T 2
#define TERM_OFFSETS 3
#define TERM_MATERIAL 4
#define TERM_MASS 5
#define CONTACT_A 6
#define CONTACT_B 7
#define CONTACT_G 8
#define BATH_T 9
#define KNOTS 10
#define MATERIAL_CP 11
#define MATERIAL_MIN_CP 12
#define MIN_CP 13
#define ROOT_CP 14
#define BEFORE 15
#define TEMP 16
#define TRIAL_T 17
#define DEGREE_COUNTS 18
#define DEGREE_OFFSETS 19
#define CURSORS 20
#define INCIDENT 21
#define DEGREE 22
#define FLUX 23
#define CHANGE 24
#define RESERVOIR 25
#define MODE 26
#define ACCEPTED 27
#define SUMMARY 28
#define PARTIALS 29
#define BATH_PARTIALS 30
#define DISPATCH 31
#define STARTS 33
#define COLUMNS 34
#define VALUES 35
#define ROWS 36
#define PRESSURE 37
#define WORK 38
#define META 39
#define PROBLEM 40
#define CONTROL 41
#define TILE_COUNTS 43
#define TILE_OFFSETS 44
#define TILE_OWNERS 45
#define TILE_PARTIALS 46
#define BATH_INDEX 47
const double HUGE=1.7976931348623157e308LF;
int owners(){return get(COUNTS,0);}int contacts(){return get(COUNTS,2);}
double resolution(){return raw(p.header+72);}double tolerance(){return raw(p.header+74);}
dvec2 twoSum(double a,double b){precise double s=a+b,v=s-a;return dvec2(s,(a-(s-v))+(b-v));}
dvec2 add(dvec2 a,double b){dvec2 x=twoSum(a.x,b);return twoSum(x.x,x.y+a.y);}
double cp(int row,int segment){
    dvec2 sum=dvec2(0.0);for(int t=get(TERM_OFFSETS,row);t<get(TERM_OFFSETS,row+1);t++)
        sum=add(sum,num(TERM_MASS,t)*num(MATERIAL_CP,get(TERM_MATERIAL,t)*h(4)+segment));return sum.x+sum.y;
}
int segmentAt(double temperature){int low=0,high=h(4)-1;while(low<high){int middle=(low+high)/2;
    if(temperature>=num(KNOTS,middle))low=middle+1;else high=middle;}return low;}
double capacity(int row,double temperature){return cp(row,segmentAt(temperature));}
// Integral relative to the captured temperature. Reference/species energy remains in BEFORE.
double integral(int row,double from,double to){
    double lo=min(from,to),hi=max(from,to);dvec2 sum=dvec2(0.0);
    for(int s=segmentAt(lo);s<h(4);s++){
        double a=s==0?lo:max(lo,num(KNOTS,s-1)),b=s+1==h(4)?hi:min(hi,num(KNOTS,s));
        if(b>a)sum=add(sum,(b-a)*cp(row,s));
        if(b>=hi)break;
    }
    double result=sum.x+sum.y;return to<from?-result:result;
}
double invert(int row,double delta){
    double temperature=num(INITIAL_T,row);int s=segmentAt(temperature);
    if(delta>=0.0){
        while(s+1<h(4)){double end=num(KNOTS,s),energy=(end-temperature)*cp(row,s);
            if(delta<=energy)return temperature+delta/cp(row,s);delta-=energy;temperature=end;s++;}
    }else{
        while(s>0){double end=num(KNOTS,s-1),energy=(temperature-end)*cp(row,s);
            if(-delta<=energy)return temperature+delta/cp(row,s);delta+=energy;temperature=end;s--;}
    }
    return temperature+delta/cp(row,s);
}
bool validContact(int edge){
    if(edge>=contacts())return false;int a=get(CONTACT_A,edge),b=get(CONTACT_B,edge);double g=num(CONTACT_G,edge);
    bool valid=a>=0&&a<owners()&&b>=-1&&b<owners()&&a!=b&&g>0.0&&finite(g);
    if(b<0)valid=valid&&num(BATH_T,edge)>0.0&&finite(num(BATH_T,edge));
    if(!valid)invalid();return valid;
}
dvec4 reduce(dvec4 v,int kind){
    int lane=int(gl_LocalInvocationID.x);scratch[lane]=v;barrier();
    for(int width=64;width>0;width/=2){if(lane<width){dvec4 a=scratch[lane],b=scratch[lane+width];
        scratch[lane]=kind==0?dvec4(min(a.x,b.x),max(a.y,b.y),min(a.z,b.z),max(a.w,b.w)):
                dvec4(a.x+b.x,max(a.y,b.y),0.0,0.0);}barrier();}
    dvec4 result=scratch[0];barrier();return result;
}
void savePartial(int field,int block,dvec4 value){for(int i=0;i<4;i++)store(field,4*block+i,value[i]);}
dvec4 loadPartial(int field,int block){return dvec4(num(field,4*block),num(field,4*block+1),num(field,4*block+2),num(field,4*block+3));}
void initialize(int row){
    if(h(7)==0)put(DEGREE_COUNTS,row,0);put(CURSORS,row,0);store(CHANGE,2*row,0.0);store(CHANGE,2*row+1,0.0);
    if(row==0){put(MODE,0,0);if(h(7)==0)put(MODE,1,0);put(ACCEPTED,0,0);}
    if(row>=owners())return;
    double u=num(ENERGY,row),t=num(INITIAL_T,row);if(!finite(u)||!finite(t)||t<=0.0)invalid();
    store(BEFORE,row,u);store(TEMP,row,t);store(TRIAL_T,row,t);
}
dvec4 countContact(int edge){
    dvec4 v=dvec4(HUGE,-HUGE,HUGE,0.0);
    if(h(7)!=0){if(edge>=get(MODE,1))return v;int contact=get(48,edge);v.x=num(BATH_T,contact);v.y=v.x;return v;}
    if(edge>=h(2))return v;
    store(FLUX,edge,0.0);
    if(!validContact(edge))return v;int a=get(CONTACT_A,edge),b=get(CONTACT_B,edge);
    atomicAdd(words[at(DEGREE_COUNTS)+a],1u);if(b>=0)atomicAdd(words[at(DEGREE_COUNTS)+b],1u);
    else{
        int bath=int(atomicAdd(words[at(MODE)+1],1u));put(BATH_INDEX,edge,bath);
        if(bath>=h(6))atomicOr(errors,64u);
        v.x=num(BATH_T,edge);v.y=v.x;
    }return v;
}
void scatter(int edge){
    if(!validContact(edge))return;int a=get(CONTACT_A,edge),b=get(CONTACT_B,edge);
    int slot=int(reserveIncident(at(CURSORS)+a));put(INCIDENT,get(DEGREE_OFFSETS,a)+slot,edge);
    if(b>=0){slot=int(reserveIncident(at(CURSORS)+b));put(INCIDENT,get(DEGREE_OFFSETS,b)+slot,edge);}
}
dvec2 tileSum(int row){
    dvec2 value=dvec2(0.0);for(int tile=get(TILE_OFFSETS,row);tile<get(TILE_OFFSETS,row+1);tile++){
        value=add(value,num(TILE_PARTIALS,2*tile));value=add(value,num(TILE_PARTIALS,2*tile+1));
    }return value;
}
void prepareTile(int tile){
    int count=get(TILE_OFFSETS,h(0));
    if(tile==0){put(DISPATCH,9,min(count,65535));put(DISPATCH,10,count==0?1:(count+65534)/65535);put(DISPATCH,11,1);}
    if(tile>=count)return;int lo=0,hi=owners();
    while(lo<hi){int mid=(lo+hi)/2;if(get(TILE_OFFSETS,mid+1)<=tile)lo=mid+1;else hi=mid;}
    put(TILE_OWNERS,tile,lo);
}
dvec2 sampleData(int point,bool fluxValue){int header=h(76),data=int(words[header+48+31])+8*point+(fluxValue?4:0);return dvec2(raw(data),raw(data+2));}
void reduceTile(int tile,int lane,int operation){
    int row=get(TILE_OWNERS,tile),entry=get(DEGREE_OFFSETS,row)+128*(tile-get(TILE_OFFSETS,row))+lane;
    double value=0.0;dvec2 sampled=dvec2(0.0);
    if(h(7)==2){if(entry<get(DEGREE_OFFSETS,row+1))sampled=sampleData(get(INCIDENT,entry),operation==23);}
    else if(entry<get(DEGREE_OFFSETS,row+1)){
        int edge=get(INCIDENT,entry),a=get(CONTACT_A,edge),b=get(CONTACT_B,edge),other=a==row?b:a;
        double g=num(CONTACT_G,edge);
        if(operation==22)value=g;
        else if(operation==23||operation==26)value=(a==row?1.0:-1.0)*num(FLUX,edge);
        else if(operation==24||operation==25){
            int field=operation==24?TEMP:TRIAL_T;double otherT=other<0?num(BATH_T,edge):num(field,other);
            value=g*(num(field,row)-otherT);
        }else if(other>=0){
            int field=operation==19?WORK:PRESSURE,offset=operation==19?h(0):0;
            value=-p.dt*g*num(field,offset+other)/(num(ROOT_CP,row)*num(ROOT_CP,other));
        }
    }
    scratch[lane]=h(7)==2?dvec4(sampled,0.0,0.0):dvec4(value,0.0,0.0,0.0);barrier();
    for(int width=64;width>0;width/=2){
        if(lane<width){dvec2 a=scratch[lane].xy,b=scratch[lane+width].xy;a=add(a,b.x);a=add(a,b.y);scratch[lane]=dvec4(a,0.0,0.0);}barrier();
    }
    if(lane==0){store(TILE_PARTIALS,2*tile,scratch[0].x);store(TILE_PARTIALS,2*tile+1,scratch[0].y);}
}
dvec4 prepareOwner(int row){
    dvec4 v=dvec4(HUGE,-HUGE,HUGE,0.0);if(row>=owners())return v;
    int first=get(TERM_OFFSETS,row),last=get(TERM_OFFSETS,row+1);
    if(first<0||last<=first||last>get(COUNTS,1)){invalid();return v;}
    dvec2 sum=dvec2(0.0);
    for(int t=first;t<last;t++){int material=get(TERM_MATERIAL,t);double mass=num(TERM_MASS,t);
        if(material<0||material>=h(3)||!(mass>0.0)||!finite(mass)){invalid();continue;}
        sum=add(sum,mass*num(MATERIAL_MIN_CP,material));}
    double minimum=sum.x+sum.y;if(!(minimum>0.0)||!finite(minimum))invalid();
    dvec2 g=dvec2(0.0);
    if(get(DEGREE_COUNTS,row)>128)g=tileSum(row);
    else for(int i=get(DEGREE_OFFSETS,row);i<get(DEGREE_OFFSETS,row+1);i++){
        if(h(7)==2){dvec2 x=sampleData(get(INCIDENT,i),false);g=add(g,x.x);g=add(g,x.y);}
        else g=add(g,num(CONTACT_G,get(INCIDENT,i)));
    }
    double degree=g.x+g.y;store(DEGREE,row,degree);store(MIN_CP,row,minimum);store(ROOT_CP,row,sqrt(minimum));
    v=dvec4(num(INITIAL_T,row),num(INITIAL_T,row),minimum,2.0*p.dt*degree/minimum);return v;
}
void chooseMode(int lane){
    dvec4 v=dvec4(HUGE,-HUGE,HUGE,0.0);
    for(int block=lane;block<(h(0)+127)/128;block+=128){dvec4 b=loadPartial(PARTIALS,block);v=dvec4(min(v.x,b.x),max(v.y,b.y),min(v.z,b.z),max(v.w,b.w));}
    for(int block=lane;block<max(1,((h(7)!=0?get(MODE,1):contacts())+127)/128);block+=128){dvec4 b=loadPartial(BATH_PARTIALS,block);v.x=min(v.x,b.x);v.y=max(v.y,b.y);}
    v=reduce(v,0);if(lane!=0)return;
    store(SUMMARY,0,v.x);store(SUMMARY,1,v.y);store(SUMMARY,2,v.z);
    int mode=owners()==0||(h(7)==2?v.w==0.0:contacts()==0)||v.y-v.x<=resolution()?0:v.w>double(h(5))?9:max(1,int(ceil(v.w)));
    put(MODE,0,mode);
}
void explicitDispatch(int lane){
    if(lane!=0)return;int mode=get(MODE,0);bool run=mode>0&&mode<=h(5)&&p.step<mode;
    int e=run?(contacts()+127)/128:0,n=run?(owners()+127)/128:0;
    put(DISPATCH,0,min(e,65535));put(DISPATCH,1,e==0?1:(e+65534)/65535);put(DISPATCH,2,1);
    put(DISPATCH,3,min(n,65535));put(DISPATCH,4,n==0?1:(n+65534)/65535);put(DISPATCH,5,1);
    int tiles=run?get(TILE_OFFSETS,h(0)):0;put(DISPATCH,6,min(tiles,65535));put(DISPATCH,7,tiles==0?1:(tiles+65534)/65535);put(DISPATCH,8,1);
}
void flux(int edge,double dt,int slot){
    if(edge>=contacts())return;int a=get(CONTACT_A,edge),b=get(CONTACT_B,edge);
    double other=b<0?num(BATH_T,edge):num(TEMP,b);precise double q=num(CONTACT_G,edge)*(other-num(TEMP,a))*dt;
    store(FLUX,edge,q);if(b<0)store(RESERVOIR,get(BATH_INDEX,edge)*h(5)+slot,q);
}
double ownerFlux(int row){
    if(get(DEGREE_COUNTS,row)>128){dvec2 value=tileSum(row);return value.x+value.y;}
    dvec2 delta=dvec2(0.0);for(int i=get(DEGREE_OFFSETS,row);i<get(DEGREE_OFFSETS,row+1);i++){
        int edge=get(INCIDENT,i);if(h(7)==2){dvec2 x=sampleData(edge,true);delta=add(delta,x.x);delta=add(delta,x.y);}
        else delta=add(delta,(get(CONTACT_A,edge)==row?1.0:-1.0)*num(FLUX,edge));}
    return delta.x+delta.y;
}
void explicitUpdate(int row){
    if(row>=owners())return;double u=num(ENERGY,row)+ownerFlux(row);store(ENERGY,row,u);
    double t=invert(row,u-num(BEFORE,row));if(!(t>0.0))invalid();store(TEMP,row,t);
}
double residual(int row,int temperatureField){
    double t=num(temperatureField,row);dvec2 loss=dvec2(0.0);
    if(get(DEGREE_COUNTS,row)>128)loss=tileSum(row);
    else for(int i=get(DEGREE_OFFSETS,row);i<get(DEGREE_OFFSETS,row+1);i++){
        int edge=get(INCIDENT,i),a=get(CONTACT_A,edge),b=get(CONTACT_B,edge),other=a==row?b:a;
        double otherT=other<0?num(BATH_T,edge):num(temperatureField,other);
        loss=add(loss,num(CONTACT_G,edge)*(t-otherT));}
    dvec2 result=add(loss*p.dt,integral(row,num(INITIAL_T,row),t));return result.x+result.y;
}
dvec4 linearize(int row){
    put(STARTS,row,row);if(row==0)put(STARTS,h(0),h(0));put(COLUMNS,row,row);put(ROWS,row,row<owners()?row:-1);
    put(META,row,0);store(PROBLEM,h(0)+row,0.0);store(PROBLEM,2*h(0)+row,0.0);
    if(row>=owners()){store(VALUES,row,1.0);store(PROBLEM,row,0.0);return dvec4(0.0);}
    double r=residual(row,TEMP),c=num(MIN_CP,row),root=num(ROOT_CP,row);
    store(VALUES,row,(capacity(row,num(TEMP,row))+p.dt*num(DEGREE,row))/c);store(PROBLEM,row,-r/root);
    double error=r/c;return dvec4(error*error,abs(error),0.0,0.0);
}
dvec4 collectResidual(int lane){
    dvec4 v=dvec4(0.0);for(int block=lane;block<(h(0)+127)/128;block+=128){dvec4 b=loadPartial(PARTIALS,block);v.x+=b.x;v.y=max(v.y,b.y);}
    return reduce(v,1);
}
void finishLinearize(int lane){
    dvec4 v=collectResidual(lane);if(lane!=0)return;
    store(SUMMARY,3,sqrt(v.x/max(1.0,double(owners()))));store(SUMMARY,5,v.y);
    store(PROBLEM,3*h(0),tolerance()*sqrt(num(SUMMARY,2)/max(1.0,double(owners()))));
    if(v.y<=tolerance())put(MODE,0,10);
}
void trial(int row){
    if(row>=owners())return;
    double t=num(TEMP,row)+p.fraction*num(PRESSURE,row)/num(ROOT_CP,row);
    store(TRIAL_T,row,clamp(t,num(SUMMARY,0),num(SUMMARY,1)));
}
dvec4 trialResidual(int row){if(row>=owners())return dvec4(0.0);double e=residual(row,TRIAL_T)/num(MIN_CP,row);return dvec4(e*e,abs(e),0.0,0.0);}
void acceptTrial(int lane){
    dvec4 v=collectResidual(lane);if(lane!=0)return;double norm=sqrt(v.x/max(1.0,double(owners())));
    bool accept=v.y<=tolerance()||norm<num(SUMMARY,3);put(ACCEPTED,0,accept?1:0);store(SUMMARY,4,norm);
    if(accept){store(SUMMARY,3,norm);store(SUMMARY,5,v.y);if(v.y<=tolerance())put(MODE,0,10);}
}
void finishOwner(int row){
    if(row>=owners())return;int mode=get(MODE,0);if(mode==9){invalid();return;}
    if(mode==10){double u=num(BEFORE,row)+ownerFlux(row);store(ENERGY,row,u);double t=invert(row,u-num(BEFORE,row));if(!(t>0.0))invalid();store(TEMP,row,t);}
    dvec2 change=twoSum(num(ENERGY,row),-num(BEFORE,row));store(CHANGE,2*row,change.x);store(CHANGE,2*row+1,change.y);
}
double inputVector(int row,bool direction){return direction?num(WORK,h(0)+row):num(PRESSURE,row);}
double matrixPart(int row,int from,int stride,bool direction){
    double value=0.0;for(int i=get(DEGREE_OFFSETS,row)+from;i<get(DEGREE_OFFSETS,row+1);i+=stride){
        int edge=get(INCIDENT,i),a=get(CONTACT_A,edge),b=get(CONTACT_B,edge),other=a==row?b:a;
        if(other>=0)value-=p.dt*num(CONTACT_G,edge)*inputVector(other,direction)/(num(ROOT_CP,row)*num(ROOT_CP,other));
    }return value;
}
void product(int row,bool direction){
    if(row>=owners()||get(DEGREE_COUNTS,row)>128)return;
    double result=num(VALUES,row)*inputVector(row,direction)+matrixPart(row,0,1,direction);store(WORK,2*h(0)+row,result);
}
void finishLongProduct(int row,bool direction){
    if(row>=owners()||get(DEGREE_COUNTS,row)<=128)return;
    dvec2 sum=tileSum(row);sum=add(sum,num(VALUES,row)*inputVector(row,direction));store(WORK,2*h(0)+row,sum.x+sum.y);
}
void main(){
    int block=int(gl_WorkGroupID.y*gl_NumWorkGroups.x+gl_WorkGroupID.x),lane=int(gl_LocalInvocationID.x),id=128*block+lane;
    if(p.stage==31){if(id==0){int count=errors==0u?max(1,((h(7)!=0?get(MODE,1):contacts())+127)/128):0;put(DISPATCH,12,min(count,65535));put(DISPATCH,13,max(1,(count+65534)/65535));put(DISPATCH,14,1);}return;}
    if(errors!=0u&&h(7)!=0)return;
    if(owners()<0||owners()>h(0)||get(COUNTS,1)<0||get(COUNTS,1)>h(1)||contacts()<0||contacts()>h(2)){if(id==0)invalid();return;}
    // All bath demand is counted even when a private candidate needs a larger bath column.
    if((errors&64u)!=0u&&p.stage!=0&&p.stage!=1&&p.stage!=31)return;
    if(p.stage==18||p.stage==19||(p.stage>=22&&p.stage<=26)){
        if(block>=get(TILE_OFFSETS,h(0)))return;
        if(p.stage==18||p.stage==19){if(num(CONTROL,p.stage==19?3:7)==0.0)return;}
        if(p.stage==26&&get(MODE,0)!=10)return;
        reduceTile(block,lane,p.stage);return;
    }
    
    if(p.stage==0){if(id<h(0))initialize(id);}
    else if(p.stage==1){dvec4 v=reduce(countContact(id),0);if(lane==0)savePartial(BATH_PARTIALS,block,v);}
    else if(p.stage==2){if(id<h(2))scatter(id);}
    else if(p.stage==3){dvec4 v=reduce(prepareOwner(id),0);if(lane==0)savePartial(PARTIALS,block,v);}
    else if(p.stage==4)chooseMode(lane);
    else if(p.stage==5)explicitDispatch(lane);
    else if(p.stage==6)flux(id,p.dt/double(get(MODE,0)),p.step);
    else if(p.stage==7)explicitUpdate(id);
    else if(p.stage==8){dvec4 v=reduce(id<h(0)?linearize(id):dvec4(0.0),1);if(lane==0)savePartial(PARTIALS,block,v);}
    else if(p.stage==9)finishLinearize(lane);
    else if(p.stage==10)trial(id);
    else if(p.stage==11){dvec4 v=reduce(trialResidual(id),1);if(lane==0)savePartial(PARTIALS,block,v);}
    else if(p.stage==12)acceptTrial(lane);
    else if(p.stage==13){if(id<owners()&&get(ACCEPTED,0)!=0)store(TEMP,id,num(TRIAL_T,id));}
    else if(p.stage==14){if(get(MODE,0)==10)flux(id,p.dt,0);}
    else if(p.stage==15)finishOwner(id);
    else if(p.stage==16||p.stage==17){if(num(CONTROL,p.stage==17?3:7)!=0.0)product(id,p.stage==17);}
    else if(p.stage==20){if(id<p.count)prepareTile(id);}
    else if(p.stage==21){if(id<h(0))put(TILE_COUNTS,id,id<owners()&&get(DEGREE_COUNTS,id)>128?(get(DEGREE_COUNTS,id)+127)/128:0);}
    else if(p.stage==32){if(id<h(6)&&(get(MODE,0)==0||get(MODE,0)>h(5)))for(int slot=0;slot<h(5);slot++)store(RESERVOIR,id*h(5)+slot,0.0);}
    else if(p.stage==30){if(id<h(6))for(int slot=0;slot<h(5);slot++)store(RESERVOIR,id*h(5)+slot,0.0);}
    else if(p.stage==27||p.stage==28){if(num(CONTROL,p.stage==28?3:7)!=0.0)finishLongProduct(id,p.stage==28);}

}
