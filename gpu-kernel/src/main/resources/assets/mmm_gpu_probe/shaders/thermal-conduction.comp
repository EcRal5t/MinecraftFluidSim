#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_ballot : require
#extension GL_ARB_gpu_shader_fp64 : require
layout(local_size_x=128) in;
layout(binding=0,std430) buffer Arena { uint words[]; };
layout(binding=1,std430) buffer Errors { uint errors; };
layout(push_constant) uniform Params { int header;int stage;int count;int step;double dt;double fraction; } p;
// HOST_LAYOUT
const uint ERROR_INVALID_CONDUCTION = 16384u;
const uint ERROR_INSUFFICIENT_CAPACITY = 64u;
shared dvec4 scratch[128];
int headerWord(int i){return int(words[p.header+i]);}int fieldAddress(int field){return headerWord(WORK_FIELDS+field);}
int readInt(int field,int i){return int(words[fieldAddress(field)+i]);}void writeInt(int field,int i,int x){words[fieldAddress(field)+i]=uint(x);}
// Reserve the first lane's shared destination once for the participating subgroup.
uint reserveIncident(int address){
 uvec4 participants=subgroupBallot(true);uint first=subgroupBallotFindLSB(participants);
 int sharedAddress=subgroupBroadcastFirst(address);uvec4 peers=subgroupBallot(address==sharedAddress);uint base=0u;
 if(gl_SubgroupInvocationID==first)base=atomicAdd(words[address],subgroupBallotBitCount(peers));
 base=subgroupBroadcastFirst(base);
 return address==sharedAddress?base+subgroupBallotExclusiveBitCount(peers):atomicAdd(words[address],1u);
}
double readDoubleAt(int address){return packDouble2x32(uvec2(words[address],words[address+1]));}
double readDouble(int field,int i){return readDoubleAt(fieldAddress(field)+2*i);}
bool finite(double x){return !isnan(x)&&!isinf(x);}void invalid(){atomicOr(errors,ERROR_INVALID_CONDUCTION);}
void writeDouble(int field,int i,double x){if(!finite(x))invalid();uvec2 b=unpackDouble2x32(x);words[fieldAddress(field)+2*i]=b.x;words[fieldAddress(field)+2*i+1]=b.y;}

const double HUGE=1.7976931348623157e308LF;
int owners(){return readInt(FIELD_COUNTS,0);}int contacts(){return readInt(FIELD_COUNTS,2);}
double resolution(){return readDoubleAt(p.header+H_RESOLUTION);}double tolerance(){return readDoubleAt(p.header+H_TOLERANCE);}
dvec2 twoSum(double a,double b){precise double s=a+b,v=s-a,error=(a-(s-v))+(b-v);return dvec2(s,error);}
dvec2 add(dvec2 a,double b){dvec2 x=twoSum(a.x,b);return twoSum(x.x,x.y+a.y);}
double cp(int row,int segment){
    dvec2 sum=dvec2(0.0);for(int t=readInt(FIELD_TERM_OFFSETS,row);t<readInt(FIELD_TERM_OFFSETS,row+1);t++)
        sum=add(sum,readDouble(FIELD_TERM_MASS,t)*readDouble(FIELD_MATERIAL_CP,readInt(FIELD_TERM_MATERIAL,t)*headerWord(H_SEGMENT_COUNT)+segment));return sum.x+sum.y;
}
int segmentAt(double temperature){int low=0,high=headerWord(H_SEGMENT_COUNT)-1;while(low<high){int middle=(low+high)/2;
    if(temperature>=readDouble(FIELD_KNOTS,middle))low=middle+1;else high=middle;}return low;}
double capacity(int row,double temperature){return cp(row,segmentAt(temperature));}
// Integral relative to the captured temperature. Reference/species energy remains in FIELD_BEFORE_ENERGY.
double integral(int row,double from,double to){
    double lo=min(from,to),hi=max(from,to);dvec2 sum=dvec2(0.0);
    for(int s=segmentAt(lo);s<headerWord(H_SEGMENT_COUNT);s++){
        double a=s==0?lo:max(lo,readDouble(FIELD_KNOTS,s-1)),b=s+1==headerWord(H_SEGMENT_COUNT)?hi:min(hi,readDouble(FIELD_KNOTS,s));
        if(b>a)sum=add(sum,(b-a)*cp(row,s));
        if(b>=hi)break;
    }
    double result=sum.x+sum.y;return to<from?-result:result;
}
double invert(int row,double delta){
    double temperature=readDouble(FIELD_OWNER_INITIAL_T,row);int s=segmentAt(temperature);
    if(delta>=0.0){
        while(s+1<headerWord(H_SEGMENT_COUNT)){double end=readDouble(FIELD_KNOTS,s),energy=(end-temperature)*cp(row,s);
            if(delta<=energy)return temperature+delta/cp(row,s);delta-=energy;temperature=end;s++;}
    }else{
        while(s>0){double end=readDouble(FIELD_KNOTS,s-1),energy=(temperature-end)*cp(row,s);
            if(-delta<=energy)return temperature+delta/cp(row,s);delta+=energy;temperature=end;s--;}
    }
    return temperature+delta/cp(row,s);
}
bool validContact(int edge){
    if(edge>=contacts())return false;int ownerA=readInt(FIELD_CONTACT_A,edge),ownerB=readInt(FIELD_CONTACT_B,edge);double conductance=readDouble(FIELD_CONTACT_G,edge);
    bool valid=ownerA>=0&&ownerA<owners()&&ownerB>=-1&&ownerB<owners()&&ownerA!=ownerB&&conductance>0.0&&finite(conductance);
    if(ownerB<0)valid=valid&&readDouble(FIELD_CONTACT_BATH_T,edge)>0.0&&finite(readDouble(FIELD_CONTACT_BATH_T,edge));
    if(!valid)invalid();return valid;
}
dvec4 reduce(dvec4 v,int kind){
    int lane=int(gl_LocalInvocationID.x);scratch[lane]=v;barrier();
    for(int width=64;width>0;width/=2){if(lane<width){dvec4 a=scratch[lane],b=scratch[lane+width];
        scratch[lane]=kind==0?dvec4(min(a.x,b.x),max(a.y,b.y),min(a.z,b.z),max(a.w,b.w)):
                dvec4(a.x+b.x,max(a.y,b.y),0.0,0.0);}barrier();}
    dvec4 result=scratch[0];barrier();return result;
}
void savePartial(int field,int block,dvec4 value){for(int i=0;i<4;i++)writeDouble(field,4*block+i,value[i]);}
dvec4 loadPartial(int field,int block){return dvec4(readDouble(field,4*block),readDouble(field,4*block+1),readDouble(field,4*block+2),readDouble(field,4*block+3));}
void initialize(int row){
    if(headerWord(H_CONTACT_MODE)==0)writeInt(FIELD_DEGREE_COUNTS,row,0);writeInt(FIELD_DEGREE_CURSORS,row,0);writeDouble(FIELD_ENERGY_CHANGE,2*row,0.0);writeDouble(FIELD_ENERGY_CHANGE,2*row+1,0.0);
    if(row==0){for(int i=0;i<4;i++)writeInt(FIELD_IMEX_COUNTS,i,0);writeInt(FIELD_MODE,0,0);if(headerWord(H_CONTACT_MODE)==0)writeInt(FIELD_MODE,1,0);writeInt(FIELD_ACCEPTED,0,0);}
    if(row>=owners())return;
    double u=readDouble(FIELD_OWNER_ENERGY,row),t=readDouble(FIELD_OWNER_INITIAL_T,row);if(!finite(u)||!finite(t)||t<=0.0)invalid();
    writeDouble(FIELD_BEFORE_ENERGY,row,u);writeDouble(FIELD_TEMPERATURE,row,t);writeDouble(FIELD_TRIAL_T,row,t);
}
dvec4 countContact(int edge){
    dvec4 bounds=dvec4(HUGE,-HUGE,HUGE,0.0);
    if(headerWord(H_CONTACT_MODE)!=0){if(edge>=readInt(FIELD_MODE,1))return bounds;int contact=readInt(FIELD_BATH_EDGES,edge);bounds.x=readDouble(FIELD_CONTACT_BATH_T,contact);bounds.y=bounds.x;return bounds;}
    if(edge>=headerWord(H_CONTACT_CAPACITY))return bounds;
    writeDouble(FIELD_FLUX,edge,0.0);
    if(!validContact(edge))return bounds;int ownerA=readInt(FIELD_CONTACT_A,edge),ownerB=readInt(FIELD_CONTACT_B,edge);
    atomicAdd(words[fieldAddress(FIELD_DEGREE_COUNTS)+ownerA],1u);if(ownerB>=0)atomicAdd(words[fieldAddress(FIELD_DEGREE_COUNTS)+ownerB],1u);
    else{
        int bath=int(atomicAdd(words[fieldAddress(FIELD_MODE)+1],1u));writeInt(FIELD_BATH_INDEX,edge,bath);
        if(bath>=headerWord(H_BATH_CAPACITY))atomicOr(errors,ERROR_INSUFFICIENT_CAPACITY);
        bounds.x=readDouble(FIELD_CONTACT_BATH_T,edge);bounds.y=bounds.x;
    }return bounds;
}
void scatter(int edge){
    if(!validContact(edge))return;int ownerA=readInt(FIELD_CONTACT_A,edge),ownerB=readInt(FIELD_CONTACT_B,edge);
    int slot=int(reserveIncident(fieldAddress(FIELD_DEGREE_CURSORS)+ownerA));writeInt(FIELD_INCIDENT,readInt(FIELD_DEGREE_OFFSETS,ownerA)+slot,edge);
    if(ownerB>=0){slot=int(reserveIncident(fieldAddress(FIELD_DEGREE_CURSORS)+ownerB));writeInt(FIELD_INCIDENT,readInt(FIELD_DEGREE_OFFSETS,ownerB)+slot,edge);}
}
dvec2 tileSum(int row){
    dvec2 value=dvec2(0.0);for(int tile=readInt(FIELD_TILE_OFFSETS,row);tile<readInt(FIELD_TILE_OFFSETS,row+1);tile++){
        value=add(value,readDouble(FIELD_TILE_PARTIALS,2*tile));value=add(value,readDouble(FIELD_TILE_PARTIALS,2*tile+1));
    }return value;
}
void prepareTile(int tile){
    int count=readInt(FIELD_TILE_OFFSETS,headerWord(H_OWNER_CAPACITY));
    if(tile==0){writeInt(FIELD_DISPATCH,9,min(count,65535));writeInt(FIELD_DISPATCH,10,count==0?1:(count+65534)/65535);writeInt(FIELD_DISPATCH,11,1);}
    if(tile>=count)return;int lo=0,hi=owners();
    while(lo<hi){int mid=(lo+hi)/2;if(readInt(FIELD_TILE_OFFSETS,mid+1)<=tile)lo=mid+1;else hi=mid;}
    writeInt(FIELD_TILE_OWNERS,tile,lo);
}
dvec2 sampleData(int point,bool fluxValue){int header=headerWord(H_CONTACT_HEADER),data=int(words[header+48+31])+8*point+(fluxValue?4:0);return dvec2(readDoubleAt(data),readDoubleAt(data+2));}
void reduceTile(int tile,int lane,int operation){
    int row=readInt(FIELD_TILE_OWNERS,tile),entry=readInt(FIELD_DEGREE_OFFSETS,row)+128*(tile-readInt(FIELD_TILE_OFFSETS,row))+lane;
    double value=0.0;dvec2 sampled=dvec2(0.0);
    if(headerWord(H_CONTACT_MODE)==2){if(entry<readInt(FIELD_DEGREE_OFFSETS,row+1))sampled=sampleData(readInt(FIELD_INCIDENT,entry),operation==23);}
    else if(entry<readInt(FIELD_DEGREE_OFFSETS,row+1)){
        int edge=readInt(FIELD_INCIDENT,entry),a=readInt(FIELD_CONTACT_A,edge),b=readInt(FIELD_CONTACT_B,edge),other=a==row?b:a;
        double g=readDouble(FIELD_CONTACT_G,edge);
        value=operation==22?g:(a==row?1.0:-1.0)*readDouble(FIELD_FLUX,edge);
    }
    scratch[lane]=headerWord(H_CONTACT_MODE)==2?dvec4(sampled,0.0,0.0):dvec4(value,0.0,0.0,0.0);barrier();
    for(int width=64;width>0;width/=2){
        if(lane<width){dvec2 a=scratch[lane].xy,b=scratch[lane+width].xy;a=add(a,b.x);a=add(a,b.y);scratch[lane]=dvec4(a,0.0,0.0);}barrier();
    }
    if(lane==0){writeDouble(FIELD_TILE_PARTIALS,2*tile,scratch[0].x);writeDouble(FIELD_TILE_PARTIALS,2*tile+1,scratch[0].y);}
}
dvec4 prepareOwner(int row){
    dvec4 bounds=dvec4(HUGE,-HUGE,HUGE,0.0);if(row>=owners())return bounds;
    int firstTerm=readInt(FIELD_TERM_OFFSETS,row),termEnd=readInt(FIELD_TERM_OFFSETS,row+1);
    if(firstTerm<0||termEnd<=firstTerm||termEnd>readInt(FIELD_COUNTS,1)){invalid();return bounds;}
    dvec2 sum=dvec2(0.0);
    for(int term=firstTerm;term<termEnd;term++){int material=readInt(FIELD_TERM_MATERIAL,term);double mass=readDouble(FIELD_TERM_MASS,term);
        if(material<0||material>=headerWord(H_MATERIAL_COUNT)||!(mass>0.0)||!finite(mass)){invalid();continue;}
        sum=add(sum,mass*readDouble(FIELD_MATERIAL_MIN_CP,material));}
    double minimumHeatCapacity=sum.x+sum.y;if(!(minimumHeatCapacity>0.0)||!finite(minimumHeatCapacity))invalid();
    dvec2 conductanceSum=dvec2(0.0);
    if(readInt(FIELD_DEGREE_COUNTS,row)>128)conductanceSum=tileSum(row);
    else for(int i=readInt(FIELD_DEGREE_OFFSETS,row);i<readInt(FIELD_DEGREE_OFFSETS,row+1);i++){
        if(headerWord(H_CONTACT_MODE)==2){dvec2 x=sampleData(readInt(FIELD_INCIDENT,i),false);conductanceSum=add(conductanceSum,x.x);conductanceSum=add(conductanceSum,x.y);}
        else conductanceSum=add(conductanceSum,readDouble(FIELD_CONTACT_G,readInt(FIELD_INCIDENT,i)));
    }
    double degree=conductanceSum.x+conductanceSum.y;writeDouble(FIELD_DEGREE,row,degree);writeDouble(FIELD_MIN_CP,row,minimumHeatCapacity);writeDouble(FIELD_ROOT_CP,row,sqrt(minimumHeatCapacity));
    bounds=dvec4(readDouble(FIELD_OWNER_INITIAL_T,row),readDouble(FIELD_OWNER_INITIAL_T,row),minimumHeatCapacity,2.0*p.dt*degree/minimumHeatCapacity);return bounds;
}
void chooseMode(int lane){
    dvec4 v=dvec4(HUGE,-HUGE,HUGE,0.0);
    for(int block=lane;block<(headerWord(H_OWNER_CAPACITY)+127)/128;block+=128){dvec4 b=loadPartial(FIELD_PARTIALS,block);v=dvec4(min(v.x,b.x),max(v.y,b.y),min(v.z,b.z),max(v.w,b.w));}
    for(int block=lane;block<max(1,((headerWord(H_CONTACT_MODE)!=0?readInt(FIELD_MODE,1):contacts())+127)/128);block+=128){dvec4 b=loadPartial(FIELD_BATH_PARTIALS,block);v.x=min(v.x,b.x);v.y=max(v.y,b.y);}
    v=reduce(v,0);if(lane!=0)return;
    writeDouble(FIELD_SUMMARY,0,v.x);writeDouble(FIELD_SUMMARY,1,v.y);writeDouble(FIELD_SUMMARY,2,v.z);
    int mode=owners()==0||(headerWord(H_CONTACT_MODE)==2?v.w==0.0:contacts()==0)||v.y-v.x<=resolution()?0:v.w>1.0?9:1;
    writeInt(FIELD_MODE,0,mode);
}
void flux(int edge,double dt,int slot){
    if(edge>=contacts())return;int ownerA=readInt(FIELD_CONTACT_A,edge),ownerB=readInt(FIELD_CONTACT_B,edge);
    double otherTemperature=ownerB<0?readDouble(FIELD_CONTACT_BATH_T,edge):readDouble(FIELD_TEMPERATURE,ownerB);precise double transferredEnergy=readDouble(FIELD_CONTACT_G,edge)*(otherTemperature-readDouble(FIELD_TEMPERATURE,ownerA))*dt;
    writeDouble(FIELD_FLUX,edge,transferredEnergy);if(ownerB<0)writeDouble(FIELD_RESERVOIR_CHANGE,readInt(FIELD_BATH_INDEX,edge)*headerWord(H_ENABLED)+slot,transferredEnergy);
}
dvec2 ownerFluxPair(int row){
    if(readInt(FIELD_DEGREE_COUNTS,row)>128)return tileSum(row);
    dvec2 delta=dvec2(0.0);for(int i=readInt(FIELD_DEGREE_OFFSETS,row);i<readInt(FIELD_DEGREE_OFFSETS,row+1);i++){
        int edge=readInt(FIELD_INCIDENT,i);if(headerWord(H_CONTACT_MODE)==2){dvec2 x=sampleData(edge,true);delta=add(delta,x.x);delta=add(delta,x.y);}
        else delta=add(delta,(readInt(FIELD_CONTACT_A,edge)==row?1.0:-1.0)*readDouble(FIELD_FLUX,edge));}
    return delta;
}
double ownerFlux(int row){dvec2 delta=ownerFluxPair(row);return delta.x+delta.y;}
void spatialGatherDispatch(){
 int tiles=readInt(FIELD_MODE,0)!=0?readInt(FIELD_TILE_OFFSETS,headerWord(H_OWNER_CAPACITY)):0;
 writeInt(FIELD_DISPATCH,15,min(tiles,65535));writeInt(FIELD_DISPATCH,16,max(1,(tiles+65534)/65535));writeInt(FIELD_DISPATCH,17,1);
}
// Compact fast-owner solve; all pressure columns use nFast rather than arena capacity as stride.
int fastCount(){return readInt(FIELD_IMEX_COUNTS,0);}
double fastSum(int owner){dvec2 sum=dvec2(0.0);for(int i=readInt(FIELD_DEGREE_OFFSETS,owner);i<readInt(FIELD_DEGREE_OFFSETS,owner+1);i++){
 if(headerWord(H_CONTACT_MODE)==2){dvec2 x=sampleData(readInt(FIELD_INCIDENT,i),true);sum=add(sum,x.x);sum=add(sum,x.y);}
 else{int edge=readInt(FIELD_INCIDENT,i),a=readInt(FIELD_CONTACT_A,edge),b=readInt(FIELD_CONTACT_B,edge),other=a==owner?b:a;if(other<0)continue;int index=readInt(FIELD_IMEX_INDEX,other);if(index<0)continue;double value;
  if(p.stage==STAGE_FAST_PRODUCT)value=(p.step==1?readDouble(FIELD_WORK,fastCount()+index):readDouble(FIELD_PRESSURE,index))/readDouble(FIELD_ROOT_CP,other);
  else value=readDouble(p.stage==STAGE_TRIAL_RESIDUAL?FIELD_TRIAL_T:FIELD_TEMPERATURE,other)-readDouble(FIELD_OWNER_INITIAL_T,other);
  sum=add(sum,p.dt*readDouble(FIELD_CONTACT_G,edge)*value);
 }
 }return sum.x+sum.y;}
double fastResidual(int owner,int field){double delta=readDouble(field,owner)-readDouble(FIELD_OWNER_INITIAL_T,owner);return integral(owner,readDouble(FIELD_OWNER_INITIAL_T,owner),readDouble(field,owner))+p.dt*readDouble(FIELD_DEGREE,owner)*delta-readDouble(FIELD_IMEX_SOURCE,owner)-fastSum(owner);}
void fastClassify(int owner){if(owner>=owners())return;if(readInt(FIELD_MODE,0)==0){writeInt(FIELD_IMEX_INDEX,owner,-1);writeInt(FIELD_IMEX_COUPLED,owner,0);writeDouble(FIELD_IMEX_SOURCE,owner,0.0);return;}writeInt(FIELD_IMEX_COUPLED,owner,0);bool fast=2.0*p.dt*readDouble(FIELD_DEGREE,owner)>readDouble(FIELD_MIN_CP,owner);writeDouble(FIELD_IMEX_SOURCE,owner,fast?ownerFlux(owner):0.0);int fastIndex=fast?int(atomicAdd(words[fieldAddress(FIELD_IMEX_COUNTS)],1u)):-1;writeInt(FIELD_IMEX_INDEX,owner,fastIndex);if(fast)writeInt(FIELD_IMEX_OWNERS,fastIndex,owner);}
void fastIsolated(int fastIndex){if(fastIndex>=fastCount())return;int owner=readInt(FIELD_IMEX_OWNERS,fastIndex);if(readInt(FIELD_IMEX_COUPLED,owner)!=0)return;
 double temperature=readDouble(FIELD_OWNER_INITIAL_T,owner),energy=readDouble(FIELD_IMEX_SOURCE,owner),diagonal=p.dt*readDouble(FIELD_DEGREE,owner);int segment=segmentAt(temperature);
 if(energy>=0.0){while(segment+1<headerWord(H_SEGMENT_COUNT)){double end=readDouble(FIELD_KNOTS,segment),segmentEnergy=(end-temperature)*(cp(owner,segment)+diagonal);if(energy<=segmentEnergy)break;energy-=segmentEnergy;temperature=end;segment++;}}
 else{while(segment>0){double end=readDouble(FIELD_KNOTS,segment-1),segmentEnergy=(temperature-end)*(cp(owner,segment)+diagonal);if(-energy<=segmentEnergy)break;energy+=segmentEnergy;temperature=end;segment--;}}
 temperature+=energy/(cp(owner,segment)+diagonal);writeDouble(FIELD_TEMPERATURE,owner,temperature);writeDouble(FIELD_TRIAL_T,owner,temperature);
}
dvec4 fastLinearize(int fastIndex,bool trialValue){if(fastIndex>=fastCount())return dvec4(0.0);int owner=readInt(FIELD_IMEX_OWNERS,fastIndex),fastOwners=fastCount();double residual=fastResidual(owner,trialValue?FIELD_TRIAL_T:FIELD_TEMPERATURE),error=residual/readDouble(FIELD_MIN_CP,owner);
 if(!trialValue){writeInt(FIELD_STARTS,fastIndex,fastIndex);if(fastIndex==0)writeInt(FIELD_STARTS,fastOwners,fastOwners);writeInt(FIELD_COLUMNS,fastIndex,fastIndex);writeInt(FIELD_ROWS,fastIndex,fastIndex);writeInt(FIELD_META,fastIndex,0);writeDouble(FIELD_PROBLEM,fastOwners+fastIndex,0.0);writeDouble(FIELD_PROBLEM,2*fastOwners+fastIndex,0.0);writeDouble(FIELD_VALUES,fastIndex,(capacity(owner,readDouble(FIELD_TEMPERATURE,owner))+p.dt*readDouble(FIELD_DEGREE,owner))/readDouble(FIELD_MIN_CP,owner));writeDouble(FIELD_PROBLEM,fastIndex,-residual/readDouble(FIELD_ROOT_CP,owner));}
