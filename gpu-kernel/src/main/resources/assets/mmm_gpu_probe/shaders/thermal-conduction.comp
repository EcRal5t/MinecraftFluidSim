}
void fastResidualFinish(int lane){dvec4 v=dvec4(0.0);for(int block=lane;block<(fastCount()+127)/128;block+=128){dvec4 b=loadPartial(FIELD_PARTIALS,block);v.x+=b.x;v.y=max(v.y,b.y);}v=reduce(v,1);if(lane!=0)return;double norm=sqrt(v.x/max(1.0,double(fastCount())));
 if(p.step==0){writeDouble(FIELD_SUMMARY,3,norm);writeDouble(FIELD_SUMMARY,5,v.y);writeDouble(FIELD_PROBLEM,3*fastCount(),tolerance()*sqrt(readDouble(FIELD_SUMMARY,2)/max(1.0,double(fastCount()))));writeInt(FIELD_MODE,0,v.y<=tolerance()?10:9);}
 else{bool accepted=v.y<=tolerance()||norm<readDouble(FIELD_SUMMARY,3);writeInt(FIELD_ACCEPTED,0,accepted?1:0);if(accepted){writeDouble(FIELD_SUMMARY,3,norm);writeDouble(FIELD_SUMMARY,5,v.y);if(v.y<=tolerance())writeInt(FIELD_MODE,0,10);}}
}
void fastProduct(int fastIndex){if(fastIndex>=fastCount()||readDouble(FIELD_CONTROL,p.step==1?3:7)==0.0)return;int owner=readInt(FIELD_IMEX_OWNERS,fastIndex),fastOwners=fastCount();double pressureValue=p.step==1?readDouble(FIELD_WORK,fastOwners+fastIndex):readDouble(FIELD_PRESSURE,fastIndex);writeDouble(FIELD_WORK,2*fastOwners+fastIndex,readDouble(FIELD_VALUES,fastIndex)*pressureValue-fastSum(owner)/readDouble(FIELD_ROOT_CP,owner));}
void main(){
    int block=int(gl_WorkGroupID.y*gl_NumWorkGroups.x+gl_WorkGroupID.x),lane=int(gl_LocalInvocationID.x),id=128*block+lane;
    if(p.stage>=STAGE_CLASSIFY_FAST){
      if(p.stage==STAGE_CLASSIFY_FAST_CONTACTS&&id==0)writeInt(FIELD_IMEX_COUNTS,1,readInt(FIELD_MODE,1));
      if(errors!=0u)return;
      if(p.stage==STAGE_CLASSIFY_FAST)fastClassify(id);
      else if(p.stage==STAGE_SOLVE_ISOLATED)fastIsolated(id);
      else if(p.stage==STAGE_LINEARIZE||p.stage==STAGE_TRIAL_RESIDUAL){dvec4 v=reduce(fastLinearize(id,p.stage==STAGE_TRIAL_RESIDUAL),1);if(lane==0)savePartial(FIELD_PARTIALS,block,v);}
      else if(p.stage==STAGE_FINISH_RESIDUAL)fastResidualFinish(lane);
      else if(p.stage==STAGE_TRIAL_TEMPERATURE){if(id<fastCount()){int row=readInt(FIELD_IMEX_OWNERS,id);writeDouble(FIELD_TRIAL_T,row,clamp(readDouble(FIELD_TEMPERATURE,row)+p.fraction*readDouble(FIELD_PRESSURE,id)/readDouble(FIELD_ROOT_CP,row),readDouble(FIELD_SUMMARY,0),readDouble(FIELD_SUMMARY,1)));}}
      else if(p.stage==STAGE_ACCEPT_TRIAL){if(id<fastCount()&&readInt(FIELD_ACCEPTED,0)!=0){int row=readInt(FIELD_IMEX_OWNERS,id);writeDouble(FIELD_TEMPERATURE,row,readDouble(FIELD_TRIAL_T,row));}}
      else if(p.stage==STAGE_FAST_PRODUCT)fastProduct(id);
      else if(p.stage==STAGE_FINISH_ENERGY){if(id<owners()&&readInt(FIELD_MODE,0)!=0){double u=readDouble(FIELD_BEFORE_ENERGY,id)+ownerFlux(id);writeDouble(FIELD_OWNER_ENERGY,id,u);if(headerWord(H_CONTACT_MODE)!=2)writeDouble(FIELD_TEMPERATURE,id,invert(id,u-readDouble(FIELD_BEFORE_ENERGY,id)));dvec2 change=twoSum(u,-readDouble(FIELD_BEFORE_ENERGY,id));writeDouble(FIELD_ENERGY_CHANGE,2*id,change.x);writeDouble(FIELD_ENERGY_CHANGE,2*id+1,change.y);}}
      else if(p.stage==STAGE_CLEAR_IDLE_RESERVOIRS){if(id<headerWord(H_BATH_CAPACITY)&&readInt(FIELD_MODE,0)==0)for(int slot=0;slot<headerWord(H_ENABLED);slot++)writeDouble(FIELD_RESERVOIR_CHANGE,id*headerWord(H_ENABLED)+slot,0.0);}
      else if(p.stage==STAGE_CLASSIFY_FAST_CONTACTS){
        if(id<contacts()&&readInt(FIELD_MODE,0)!=0){int a=readInt(FIELD_CONTACT_A,id),b=readInt(FIELD_CONTACT_B,id);if(b>=0&&readInt(FIELD_IMEX_INDEX,a)>=0&&readInt(FIELD_IMEX_INDEX,b)>=0){atomicOr(words[fieldAddress(FIELD_IMEX_COUPLED)+a],1u);atomicOr(words[fieldAddress(FIELD_IMEX_COUPLED)+b],1u);atomicAdd(words[fieldAddress(FIELD_IMEX_COUNTS)+3],1u);}}
      }
      else if(p.stage==STAGE_INITIAL_FLUX){if(readInt(FIELD_MODE,0)!=0)flux(id,p.dt,0);}
      else if(p.stage==STAGE_FINAL_FAST_FLUX){if(id<contacts()&&readInt(FIELD_MODE,0)!=0){int a=readInt(FIELD_CONTACT_A,id),b=readInt(FIELD_CONTACT_B,id);if(readInt(FIELD_IMEX_INDEX,a)>=0||(b>=0&&readInt(FIELD_IMEX_INDEX,b)>=0))flux(id,p.dt,0);}}
      else if(p.stage==STAGE_FAST_DISPATCH){if(id==0){int groups=(fastCount()+127)/128;writeInt(FIELD_DISPATCH,3,min(groups,65535));writeInt(FIELD_DISPATCH,4,max(1,(groups+65534)/65535));writeInt(FIELD_DISPATCH,5,1);}}
      return;
    }
    if(p.stage==STAGE_SPATIAL_GATHER_DISPATCH){if(id==0)spatialGatherDispatch();return;}
    if(p.stage==STAGE_CONTACT_DISPATCH){if(id==0){int count=errors==0u?max(1,((headerWord(H_CONTACT_MODE)!=0?readInt(FIELD_MODE,1):contacts())+127)/128):0;writeInt(FIELD_DISPATCH,12,min(count,65535));writeInt(FIELD_DISPATCH,13,max(1,(count+65534)/65535));writeInt(FIELD_DISPATCH,14,1);}return;}
    if(errors!=0u&&headerWord(H_CONTACT_MODE)!=0)return;
    if(owners()<0||owners()>headerWord(H_OWNER_CAPACITY)||readInt(FIELD_COUNTS,1)<0||readInt(FIELD_COUNTS,1)>headerWord(H_TERM_CAPACITY)||contacts()<0||contacts()>headerWord(H_CONTACT_CAPACITY)){if(id==0)invalid();return;}
    // All bath demand is counted even when a private candidate needs a larger bath column.
    if((errors&ERROR_INSUFFICIENT_CAPACITY)!=0u&&p.stage!=STAGE_INITIALIZE&&p.stage!=STAGE_COUNT_CONTACTS&&p.stage!=STAGE_CONTACT_DISPATCH)return;
    if(p.stage==STAGE_REDUCE_FLUX_TILES){if(block<readInt(FIELD_TILE_OFFSETS,headerWord(H_OWNER_CAPACITY)))reduceTile(block,lane,23);return;}
    if(p.stage==STAGE_REDUCE_DEGREE_TILES){if(block<readInt(FIELD_TILE_OFFSETS,headerWord(H_OWNER_CAPACITY)))reduceTile(block,lane,22);return;}

    if(p.stage==STAGE_INITIALIZE){if(id<headerWord(H_OWNER_CAPACITY))initialize(id);}
    else if(p.stage==STAGE_COUNT_CONTACTS){dvec4 v=reduce(countContact(id),0);if(lane==0)savePartial(FIELD_BATH_PARTIALS,block,v);}
    else if(p.stage==STAGE_SCATTER_CONTACTS){if(id<headerWord(H_CONTACT_CAPACITY))scatter(id);}
    else if(p.stage==STAGE_PREPARE_OWNERS){dvec4 v=reduce(prepareOwner(id),0);if(lane==0)savePartial(FIELD_PARTIALS,block,v);}
    else if(p.stage==STAGE_CHOOSE_MODE)chooseMode(lane);
    else if(p.stage==STAGE_PREPARE_TILES){if(id<p.count)prepareTile(id);}
    else if(p.stage==STAGE_COUNT_TILES){if(id<headerWord(H_OWNER_CAPACITY))writeInt(FIELD_TILE_COUNTS,id,id<owners()&&readInt(FIELD_DEGREE_COUNTS,id)>128?(readInt(FIELD_DEGREE_COUNTS,id)+127)/128:0);}
    else if(p.stage==STAGE_CLEAR_RESERVOIRS){if(id<headerWord(H_BATH_CAPACITY))for(int slot=0;slot<headerWord(H_ENABLED);slot++)writeDouble(FIELD_RESERVOIR_CHANGE,id*headerWord(H_ENABLED)+slot,0.0);}

}
