#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
layout(local_size_x=128) in;
layout(binding=0,std430) buffer Arena { uint words[]; };
layout(binding=1,std430) buffer Errors { uint errors; };
layout(push_constant) uniform Params { int header; int stage; int count; int argument; int mode; } p;
const int STATE=1,TAIL=2,EXCESS=3,DISTANCE=4,COUNT=5,OFFSET=6,CURSOR=7,ENTRY=8,BC=9,BO=10,OWNER=11,
 PART=12,PREFIX=13,PROPOSAL=14,GRANT=15,TOTAL_PART=16,TOTAL=17,CUT=18;
const int CK=0,CL=1,CU=2,CG=3,CCAP=4,CPREF=5,COPEN=6,CACCEPTED=7,CONTROL=8,CFLOW=24;
const int INFINITY=0x3fffffff;const int64_t INF=int64_t(0x3fffffffffffffffUL),MAX_VALUE=int64_t(0x7fffffffffffffffUL);
shared int64_t reduction[128];
int h(int i){return int(words[p.header+i]);}int at(int f){return h(16+f);}int ch(int i){return int(words[h(0)+i]);}int ca(int f){return ch(8+f);}
int n(){return h(1);}int groups(){return h(2);}int sink(){return h(3)-1;}
int get(int f,int i){return int(words[at(f)+i]);}void put(int f,int i,int x){words[at(f)+i]=uint(x);}
int control(int i){return int(words[ca(CONTROL)+i]);}void putControl(int i,int x){words[ca(CONTROL)+i]=uint(x);}
int64_t number(int a){return int64_t(uint64_t(words[a])|(uint64_t(words[a+1])<<32));}
void writeNumber(int a,int64_t x){words[a]=uint(x);words[a+1]=uint(uint64_t(x)>>32);}
int64_t read(int f,int i){return number(at(f)+2*i);}void write(int f,int i,int64_t x){writeNumber(at(f)+2*i,x);}
int64_t capacityValue(int f,int i){return number(ca(f)+2*i);}int groupOf(int cell){int g=int(words[ca(CG)+cell]);return g<0?groups()-1:g;}
void invalid(){atomicExchange(words[ca(CONTROL)],4u);atomicOr(errors,4096u);}
int64_t add(int64_t a,int64_t b){if((b>0l&&a>MAX_VALUE-b)||(b<0l&&a<-MAX_VALUE-b)){invalid();return 0l;}return a+b;}
int neighbor(int cell,int side){int x=cell%ch(0),y=cell/ch(0)%ch(1),z=cell/(ch(0)*ch(1));
 if(side==0)return x>0?cell-1:-1;if(side==1)return x+1<ch(0)?cell+1:-1;
 if(side==2)return y>0?cell-ch(0):-1;if(side==3)return y+1<ch(1)?cell+ch(0):-1;
 if(side==4)return z>0?cell-ch(0)*ch(1):-1;return z+1<ch(2)?cell+ch(0)*ch(1):-1;}
ivec2 endpoints(int e){
 if(e<7*n()){int donor=e/7,slot=e%7;return ivec2(donor,n()+(slot==0?donor:neighbor(donor,slot-1)));}
 if(e<8*n()){int cell=e-7*n();return ivec2(n()+cell,2*n()+groupOf(cell));}
 return ivec2(2*n()+e-8*n(),sink());
}
int64_t lower(int e){return e>=7*n()&&e<8*n()?capacityValue(CL,e-7*n()):0l;}
int64_t upper(int e){
 if(e<7*n()){int cell=e/7,slot=e%7;return slot==0||(int(words[ca(COPEN)+cell])&(1<<(slot-1)))!=0?capacityValue(CK,cell):0l;}
 if(e<8*n())return capacityValue(CU,e-7*n());int group=e-8*n();return group==groups()-1?INF:capacityValue(CCAP,group);
}
int64_t flow(int e){return e<7*n()?capacityValue(CFLOW,e):read(TAIL,e-7*n());}
void writeFlow(int e,int64_t x){if(e<7*n())writeNumber(ca(CFLOW)+2*e,x);else write(TAIL,e-7*n(),x);}
int distance(int vertex){return int(atomicAdd(words[at(DISTANCE)+vertex],0u));}
void initialize(int id){
 if(id<h(3)){put(COUNT,id,0);put(CURSOR,id,0);write(EXCESS,id,0l);put(DISTANCE,id,INFINITY);}
 if(id<h(4)){writeFlow(id,0l);write(PROPOSAL,id,0l);write(GRANT,id,0l);}
 if(id<n())put(CUT,id,0);
 if(id==0){for(int i=0;i<12;i++)putControl(i,0);putControl(5,p.argument);for(int i=0;i<8;i++)put(STATE,i,0);put(STATE,0,-1);}
}
void seedDonor(int cell){
 int group=int(words[ca(CG)+cell]),open=int(words[ca(COPEN)+cell]);int64_t k=capacityValue(CK,cell),lo=capacityValue(CL,cell),hi=capacityValue(CU,cell);
 if(group< -1||group>=groups()-1||k<0l||k>INF/(8l*int64_t(n()))||lo<0l||hi<lo||hi>INF/int64_t(n())||(open&~63)!=0){invalid();return;}
 if(group>=0&&(capacityValue(CCAP,group)<0l||capacityValue(CCAP,group)>INF)){invalid();return;}
 int64_t remaining=k;
 for(int slot=1;slot<7;slot++){
  int other=neighbor(cell,slot-1);if(other<0&&(open&(1<<(slot-1)))!=0){invalid();return;}
  int64_t preferred=capacityValue(CPREF,7*cell+slot);if(preferred<0l){invalid();return;}
  int64_t amount=(open&(1<<(slot-1)))!=0?min(remaining,preferred):0l;writeFlow(7*cell+slot,amount);remaining-=amount;
 }writeFlow(7*cell,remaining);
}
void seedReceiver(int cell){
 int64_t incoming=flow(7*cell);
 for(int side=0;side<6;side++){int source=neighbor(cell,side);if(source>=0)incoming=add(incoming,flow(7*source+1+(side^1)));}
 writeFlow(7*n()+cell,clamp(incoming,capacityValue(CL,cell),capacityValue(CU,cell)));
}
void countEdge(int e){if(upper(e)==0l)return;ivec2 v=endpoints(e);if(v.x<0||v.y<0||v.x>=h(3)||v.y>=h(3)){invalid();return;}
 atomicAdd(words[at(COUNT)+v.x],1u);atomicAdd(words[at(COUNT)+v.y],1u);}
void scatterEdge(int e){if(upper(e)==0l)return;ivec2 v=endpoints(e);
 int a=int(atomicAdd(words[at(CURSOR)+v.x],1u)),b=int(atomicAdd(words[at(CURSOR)+v.y],1u));
 put(ENTRY,get(OFFSET,v.x)+a,e);put(ENTRY,get(OFFSET,v.y)+b,e);}
void countBlocks(int vertex){int degree=get(COUNT,vertex);put(BC,vertex,degree>128?(degree+127)/128:0);}
void mapBlocks(int vertex){for(int block=get(BO,vertex);block<get(BO,vertex+1);block++)put(OWNER,block,vertex);}
void reduce(int lane){for(int step=64;step>0;step>>=1){barrier();if(lane<step)reduction[lane]=add(reduction[lane],reduction[lane+step]);}barrier();}
void totalBlock(int block,int lane){int cell=128*block+lane;reduction[lane]=cell<n()?capacityValue(CK,cell):0l;reduce(lane);if(lane==0)write(TOTAL_PART,block,reduction[0]);}
void total(){int64_t result=0l;for(int block=0;block<h(6);block++)result=add(result,read(TOTAL_PART,block));write(TOTAL,0,result);}
int64_t contribution(int vertex,int e){
 ivec2 ends=endpoints(e);int peer=ends.x==vertex?ends.y:ends.x;
 if(p.mode==2)return ends.x==vertex?-flow(e):flow(e);
 if(p.mode==0){
  if(read(EXCESS,vertex)<=0l||distance(vertex)==INFINITY||distance(vertex)==0||distance(peer)!=distance(vertex)-1)return 0l;
  return ends.x==vertex?upper(e)-flow(e):flow(e)-lower(e);
 }
 int64_t proposal=read(PROPOSAL,e);bool receiving=proposal>0l?ends.y==vertex:proposal<0l&&ends.x==vertex;
 return receiving?abs(proposal):0l;
}
int64_t budget(int vertex){return p.mode==0?max(0l,read(EXCESS,vertex)):(distance(vertex)==0?max(0l,-read(EXCESS,vertex)):MAX_VALUE);}
void allocate(int vertex,int e,int64_t prefix,int64_t amount){
 if(amount==0l)return;int64_t available=budget(vertex),keep=prefix<available?min(amount,available-prefix):0l;
 if(p.mode==0){ivec2 ends=endpoints(e);write(PROPOSAL,e,ends.x==vertex?keep:-keep);}
 else{int64_t proposed=read(PROPOSAL,e);write(GRANT,e,proposed>0l?keep:-keep);}
}
void finishBalance(int vertex,int64_t sum){
 int64_t supply=vertex<n()?capacityValue(CK,vertex):vertex==sink()?-read(TOTAL,0):0l;int64_t excess=add(supply,sum);write(EXCESS,vertex,excess);
 if(excess>0l)atomicAdd(words[at(STATE)+4],1u);
}
void blockSum(int block,int lane){
 if(block>=get(BO,h(3)))return;int vertex=get(OWNER,block),index=get(OFFSET,vertex)+128*(block-get(BO,vertex))+lane;
 reduction[lane]=index<get(OFFSET,vertex+1)?contribution(vertex,get(ENTRY,index)):0l;reduce(lane);if(lane==0)write(PART,block,reduction[0]);
}
void ownerSum(int vertex){
 if(p.mode==0&&read(EXCESS,vertex)>0l&&distance(vertex)<INFINITY)atomicAdd(words[at(STATE)+5],1u);
 int64_t prefix=0l;
 if(get(COUNT,vertex)<=128){for(int i=get(OFFSET,vertex);i<get(OFFSET,vertex+1);i++){
   int e=get(ENTRY,i);int64_t value=contribution(vertex,e);if(p.mode!=2)allocate(vertex,e,prefix,value);prefix=add(prefix,value);
  }}else for(int b=get(BO,vertex);b<get(BO,vertex+1);b++){write(PREFIX,b,prefix);prefix=add(prefix,read(PART,b));}
 if(p.mode==2)finishBalance(vertex,prefix);
}
void blockAllocate(int block,int lane){
 if(block>=get(BO,h(3)))return;int vertex=get(OWNER,block),index=get(OFFSET,vertex)+128*(block-get(BO,vertex))+lane;
 int e=index<get(OFFSET,vertex+1)?get(ENTRY,index):-1;int64_t amount=e<0?0l:contribution(vertex,e);reduction[lane]=amount;barrier();
 for(int step=1;step<128;step<<=1){int64_t extra=lane>=step?reduction[lane-step]:0l;barrier();reduction[lane]=add(reduction[lane],extra);barrier();}
 if(e>=0)allocate(vertex,e,add(read(PREFIX,block),reduction[lane]-amount),amount);
}
void seedGroup(int group){writeFlow(8*n()+group,clamp(read(EXCESS,2*n()+group),0l,upper(8*n()+group)));if(group==0)put(STATE,4,0);}
void start(){if(get(STATE,4)==0)putControl(0,1);else put(STATE,0,0);}
void seedDistance(int vertex){if(get(STATE,0)!=0)return;put(DISTANCE,vertex,read(EXCESS,vertex)<0l?0:INFINITY);}
void beginBfs(){if(get(STATE,0)==0){put(STATE,0,1);put(STATE,1,0);put(STATE,2,0);}}
void discover(int vertex,int value){if(atomicCompSwap(words[at(DISTANCE)+vertex],uint(INFINITY),uint(value))==uint(INFINITY))atomicOr(words[at(STATE)+2],1u);}
void bfsEdge(int e){if(get(STATE,0)!=1||upper(e)==0l)return;ivec2 v=endpoints(e);int wave=get(STATE,1);
 if(flow(e)<upper(e)&&distance(v.y)==wave)discover(v.x,wave+1);
 if(flow(e)>lower(e)&&distance(v.x)==wave)discover(v.y,wave+1);
}
void finishBfs(){if(get(STATE,0)!=1)return;put(STATE,6,get(STATE,6)+1);
 if(get(STATE,2)!=0){put(STATE,1,get(STATE,1)+1);put(STATE,2,0);}else put(STATE,0,2);}
void clearProposal(int e){if(get(STATE,0)!=2)return;write(PROPOSAL,e,0l);write(GRANT,e,0l);
 if(e==0){put(STATE,3,0);put(STATE,4,0);put(STATE,5,0);}}
void apply(int e){if(get(STATE,0)!=2)return;int64_t grant=read(GRANT,e);if(grant!=0l){int64_t next=add(flow(e),grant);
 if(next<lower(e)||next>upper(e)){invalid();return;}writeFlow(e,next);atomicOr(words[at(STATE)+3],1u);}
 if(e==0)put(STATE,7,get(STATE,7)+1);
}
void finishRound(){
 int round=control(1)+1;putControl(1,round);
 if(get(STATE,0)==2){
  if(get(STATE,4)==0){putControl(0,1);return;}
  if(get(STATE,3)==0){if(get(STATE,5)==0){putControl(0,2);return;}put(STATE,0,0);}
 }
 if(round>=control(5))putControl(0,3);
}
void finish(int e){
 if(control(0)==1)writeNumber(ca(CACCEPTED)+2*e,flow(e));
 else if(control(0)==2){if(e<n())put(CUT,e,distance(n()+e)==INFINITY||distance(2*n()+groupOf(e))==INFINITY?1:0);}
 else if(e==0)atomicOr(errors,8192u);
}
void main(){
 int block=int(gl_WorkGroupID.y*gl_NumWorkGroups.x+gl_WorkGroupID.x),lane=int(gl_LocalInvocationID.x),id=128*block+lane;
 if(p.stage==0){if(id<p.count)initialize(id);return;}if(p.stage==21){if(id<p.count)finish(id);return;}if(control(0)!=0)return;
 if(p.stage>=16&&p.stage<=18){if(get(STATE,0)>=0&&get(STATE,0)!=2)return;
  if(p.stage==16){blockSum(block,lane);return;}if(p.stage==18){blockAllocate(block,lane);return;}}
 if(p.stage==7){if(block<h(6))totalBlock(block,lane);return;}if(id>=p.count)return;
 if(p.stage==1)seedDonor(id);else if(p.stage==2)seedReceiver(id);else if(p.stage==3)countEdge(id);else if(p.stage==4)scatterEdge(id);
 else if(p.stage==5)countBlocks(id);else if(p.stage==6)mapBlocks(id);else if(p.stage==8)total();else if(p.stage==9)seedGroup(id);
 else if(p.stage==10)start();else if(p.stage==11)seedDistance(id);else if(p.stage==12)beginBfs();else if(p.stage==13)bfsEdge(id);
 else if(p.stage==14)finishBfs();else if(p.stage==15)clearProposal(id);else if(p.stage==17)ownerSum(id);
 else if(p.stage==19)apply(id);else if(p.stage==20)finishRound();
}
