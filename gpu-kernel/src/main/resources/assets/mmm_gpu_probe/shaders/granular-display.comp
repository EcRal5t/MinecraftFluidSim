#version 450
#extension GL_ARB_gpu_shader_fp64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
layout(local_size_x=128) in;
layout(binding=0,std430) readonly buffer Arena { uint words[]; };
layout(binding=1,std430) buffer Projection { uint projected[]; };
layout(push_constant) uniform Params { int header;int cells;int samples;int unused;double cellSize; } p;
int h(int i){return int(projected[p.header+i]);}int state(int f){return h(8+f);}
int64_t integer(int a){return int64_t(uint64_t(words[a])|(uint64_t(words[a+1])<<32));}
double number(int a){return packDouble2x32(uvec2(words[a],words[a+1]));}
uint quantize(double x,double maximum){return uint(floor(clamp(x,0.0,1.0)*maximum+.5));}
void main(){int id=int((gl_WorkGroupID.y*gl_NumWorkGroups.x+gl_WorkGroupID.x)*128+gl_LocalInvocationID.x);
 int count=min(p.samples,int(words[state(0)]));if(id==0)projected[h(5)]=uint(count);
 if(id<p.cells){double bulk=0.0,solid=0.0;int bestMaterial=-1;int64_t largest=0l;
  for(int e=int(words[h(6)+id]);e<int(words[h(6)+id+1]);e++){
   int entry=int(words[h(7)+e]),deposit=entry-8*h(3);if(deposit<0)continue;int row=h(3)+deposit;
   int64_t volume=integer(state(4)+2*row);int material=int(words[state(3)+row]);double phi=double(uintBitsToFloat(words[state(17)+deposit]));
   bulk+=double(volume)/(1.0-phi);solid+=double(volume);
   if(volume>largest||volume==largest&&(bestMaterial<0||material<bestMaterial)){largest=volume;bestMaterial=material;}
  }
  uint packed=0xffff0000u;if(bestMaterial>=0){uint fill=max(1u,quantize(bulk/16777216.0,255.0)),phi=max(1u,quantize(1.0-solid/bulk,255.0));packed=fill|(phi<<8)|(uint(bestMaterial)<<16);}
  projected[h(5)+1+id]=packed;
 }
 if(id<count){
  // One sample per equal ordinal interval gives a bounded representative view of the live population.
  int row=int((uint64_t(id)*uint64_t(words[state(0)]))/uint64_t(count));dvec3 extent=dvec3(h(0),h(1),h(2))*p.cellSize;
  uint x=quantize(number(state(1)+6*row)/extent.x,65535.0),y=quantize(number(state(1)+6*row+2)/extent.y,65535.0),z=quantize(number(state(1)+6*row+4)/extent.z,65535.0);
  double diameter=double(pow(float(double(integer(state(4)+2*row))/134217728.0),1.0/3.0))/p.cellSize;
  uint size=min(10u,max(1u,quantize(diameter,255.0))),material=words[state(3)+row];
  projected[h(5)+1+p.cells+2*id]=x|(y<<16);projected[h(5)+2+p.cells+2*id]=z|(size<<16)|(material<<24);
 }
}
