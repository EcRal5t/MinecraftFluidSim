#version 450
#extension GL_ARB_gpu_shader_fp64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
// HOST_LAYOUT
// SPATIAL_GRID
const int CARRIER_LIQUID = 0;
const int CARRIER_GRANULAR = 1;
const int CARRIER_COHERENT = 2;
const int CARRIER_KIND_COUNT = 3;
const int PARTICLE_SUPPORT_COUNT = 8;
const double KILOGRAMS_PER_MASS_UNIT = 1e-10;
const double MAXIMUM_FINITE_DOUBLE = 1.7976931348623157e308;
const double ATMOSPHERIC_PRESSURE_PA = 101325.0LF;
const double STANDARD_TEMPERATURE_K = 293.15LF;
const uint ERROR_INVALID_INVENTORY = 1u;
layout(local_size_x = 128) in;
layout(binding = 0, std430) readonly buffer Source {
    uint words[];
};
layout(binding = 1, std430) buffer Observation {
    uint outWords[];
};
layout(push_constant) uniform Params {
    int materials;
    int species;
    int unused;
    int unused2;
}
params;
int headerWord(int i) {
    return int(outWords[i]);
}
int caloricField(int wordOffset, int i) {
    return int(words[wordOffset + i]);
}
double readDouble(int wordOffset) {
    return packDouble2x32(uvec2(words[wordOffset], words[wordOffset + 1]));
}
double readObservationDouble(int wordOffset) {
    return packDouble2x32(uvec2(outWords[wordOffset], outWords[wordOffset + 1]));
}
void writeDouble(int wordOffset, double storedValue) {
    uvec2 packedValue = unpackDouble2x32(storedValue);
    outWords[wordOffset] = packedValue.x;
    outWords[wordOffset + 1] = packedValue.y;
}
int64_t readInteger(int wordOffset) {
    return int64_t(uint64_t(words[wordOffset]) | (uint64_t(words[wordOffset + 1]) << 32));
}
void writeInteger(int wordOffset, int64_t storedValue) {
    outWords[wordOffset] = uint(storedValue);
    outWords[wordOffset + 1] = uint(uint64_t(storedValue) >> 32);
}
int64_t checkedAddInventory(int64_t firstAmount, int64_t secondAmount) {
    if (firstAmount < 0l || secondAmount < 0l || firstAmount > 9223372036854775807l - secondAmount) {
        atomicOr(outWords[H_ERROR], ERROR_INVALID_INVENTORY);
        return 0l;
    }
    return firstAmount + secondAmount;
}
int firstLiquidRow() {
    return int(words[headerWord(H_CELL_OFFSETS) + headerWord(H_CELL)]);
}
int endLiquidRow() {
    return int(words[headerWord(H_CELL_OFFSETS) + headerWord(H_CELL) + 1]);
}
int thermalHeader(int carrierKind) {
    return carrierKind == CARRIER_LIQUID ? headerWord(H_LIQUID_THERMAL) : carrierKind == CARRIER_GRANULAR ? headerWord(H_GRAIN_THERMAL) : headerWord(H_COHERENT_THERMAL);
}
int firstRow(int carrierKind) {
    return carrierKind == CARRIER_LIQUID ? firstLiquidRow() : 0;
}
int lastRow(int carrierKind) {
    return carrierKind == CARRIER_LIQUID   ? endLiquidRow()
           : carrierKind == CARRIER_GRANULAR ? (headerWord(H_GRAIN_COUNTS) < 0 ? 0 : headerWord(H_GRAIN_CAPACITY) + int(words[headerWord(H_GRAIN_COUNTS) + 1]))
           : headerWord(H_COHERENT_COUNTS) < 0 ? 0
                                      : int(words[headerWord(H_COHERENT_COUNTS)]);
}
bool rowBelongsToCell(int carrierKind, int row) {
    if (carrierKind == CARRIER_LIQUID)
        return true;
    if (carrierKind == CARRIER_COHERENT)
        return int(words[headerWord(H_COHERENT_CELL) + row]) == headerWord(H_CELL);
    if (row >= headerWord(H_GRAIN_CAPACITY))
        return int(words[headerWord(H_DEPOSIT_CELL) + row - headerWord(H_GRAIN_CAPACITY)]) == headerWord(H_CELL);
    if (row >= int(words[headerWord(H_GRAIN_COUNTS)]))
        return false;
    double size = readObservationDouble(H_CELL_SIZE_LOW);
    ivec3 cellCoordinate = clamp(ivec3(floor(dvec3(readDouble(headerWord(H_GRAIN_POSITION) + 6 * row), readDouble(headerWord(H_GRAIN_POSITION) + 6 * row + 2),
                                      readDouble(headerWord(H_GRAIN_POSITION) + 6 * row + 4)) /
                                size)),
                    ivec3(0), ivec3(headerWord(H_SIZE_X), headerWord(H_SIZE_Y), headerWord(H_SIZE_Z)) - 1);
    return gridCell(cellCoordinate) == headerWord(H_CELL);
}
double massKilograms(int header, int row) {
    return double(readInteger(caloricField(header, CAL_MASSES) + 2 * row)) * KILOGRAMS_PER_MASS_UNIT;
}
int materialHandle(int header, int row) {
    return int(words[caloricField(header, CAL_MATERIALS) + row]);
}
double rowEthanolMass(int header,int row,double mass) {
    if (materialHandle(header,row)!=caloricField(header,CAL_AQUEOUS_MATERIAL) || caloricField(header,CAL_ETHANOL_SPECIES)<0) return 0.0;
    for(int i=int(words[caloricField(header,CAL_SPECIES_OFFSETS)+row]);i<int(words[caloricField(header,CAL_SPECIES_OFFSETS)+row+1]);i++)
        if(int(words[caloricField(header,CAL_SPECIES_HANDLES)+i])==caloricField(header,CAL_ETHANOL_SPECIES))
            return caloricEthanolMass(mass,double(readInteger(caloricField(header,CAL_SPECIES_AMOUNTS)+2*i)),readDouble(header+CAL_ETHANOL_MOLAR_MASS));
    return 0.0;
}
double minimumTemperatureEnergy(int header, int row) {
    int m = materialHandle(header, row);
    double energy = massKilograms(header, row) * (readDouble(caloricField(header, CAL_MATERIAL_REFERENCE) + 2 * m) + readDouble(caloricField(header, CAL_COLD_SENSIBLE) + 2 * m));
    double ethanol=rowEthanolMass(header,row,massKilograms(header,row));
    energy+=ethanol*((readDouble(header+CAL_MINIMUM_TEMPERATURE)-readDouble(caloricField(header,CAL_REFERENCE_TEMPERATURE)+2*m))*readDouble(header+CAL_ETHANOL_HEAT_CAPACITY)-readDouble(caloricField(header,CAL_COLD_SENSIBLE)+2*m));
    for (int item = int(words[caloricField(header, CAL_SPECIES_OFFSETS) + row]); item < int(words[caloricField(header, CAL_SPECIES_OFFSETS) + row + 1]); item++) {
        int species = int(words[caloricField(header, CAL_SPECIES_HANDLES) + item]);
        int64_t amount = readInteger(caloricField(header, CAL_SPECIES_AMOUNTS) + 2 * item);
        if (amount != 0l)
            energy += double(amount) * readDouble(caloricField(header, CAL_SPECIES_REFERENCE) + 2 * (m * caloricField(header, CAL_SPECIES_STRIDE) + species));
    }
    return energy;
}
double cellTemperature() {
    double remainingSensibleEnergy = 0.0;
    for (int carrierKind = CARRIER_LIQUID; carrierKind < CARRIER_KIND_COUNT; carrierKind++) {
        int header = thermalHeader(carrierKind);
        if (header < 0)
            continue;
        for (int row = firstRow(carrierKind); row < lastRow(carrierKind); row++)
            if (rowBelongsToCell(carrierKind, row) && massKilograms(header, row) > 0.0)
                remainingSensibleEnergy += readDouble(caloricField(header, CAL_ENERGIES) + 2 * row) - minimumTemperatureEnergy(header, row);
    }
    double temperatureK = readDouble(headerWord(H_LIQUID_THERMAL) + CAL_MINIMUM_TEMPERATURE);
    remainingSensibleEnergy = max(0.0, remainingSensibleEnergy);
    for (;;) {
        double heatCapacity = 0.0, nextSegmentTemperature = MAXIMUM_FINITE_DOUBLE;
        for (int carrierKind = CARRIER_LIQUID; carrierKind < CARRIER_KIND_COUNT; carrierKind++) {
            int header = thermalHeader(carrierKind);
            if (header < 0)
                continue;
            for (int row = firstRow(carrierKind); row < lastRow(carrierKind); row++)
                if (rowBelongsToCell(carrierKind, row)) {
                    double m = massKilograms(header, row);
                    if (m <= 0.0)
                        continue;
                    int thermalMaterial = materialHandle(header, row), first = int(words[caloricField(header, CAL_SEGMENT_OFFSETS) + thermalMaterial]),
                        last = int(words[caloricField(header, CAL_SEGMENT_OFFSETS) + thermalMaterial + 1]) - 1, segment = first;
                    while (segment < last && temperatureK >= readDouble(caloricField(header, CAL_SEGMENT_UPPER) + 2 * segment))
                        segment++;
                    heatCapacity += caloricCapacity(m,rowEthanolMass(header,row,m),readDouble(caloricField(header, CAL_SEGMENT_CAPACITY) + 2 * segment),readDouble(header+CAL_ETHANOL_HEAT_CAPACITY));
                    if (segment < last)
                        nextSegmentTemperature = min(nextSegmentTemperature, readDouble(caloricField(header, CAL_SEGMENT_UPPER) + 2 * segment));
                }
        }
        if (heatCapacity <= 0.0)
            return temperatureK;
        double segmentEnergy = (nextSegmentTemperature - temperatureK) * heatCapacity;
        if (nextSegmentTemperature == MAXIMUM_FINITE_DOUBLE || remainingSensibleEnergy < segmentEnergy)
            return temperatureK + remainingSensibleEnergy / heatCapacity;
        remainingSensibleEnergy -= segmentEnergy;
        temperatureK = nextSegmentTemperature;
    }
}
// Rows are accumulated per stable material identity. One compact result contains liquid,
// active grains, deposits, coherent solids, and the shared gas chamber.
void main() {
    int materialOrSpeciesIndex = int(gl_GlobalInvocationID.x);
    if (materialOrSpeciesIndex == 0) {
        double volume = 0.0;
        int64_t totalMass = 0l;
        for (int row = firstLiquidRow(); row < endLiquidRow(); row++) {
            volume += readDouble(headerWord(H_VOLUMES) + 2 * row);
            totalMass = checkedAddInventory(totalMass, readInteger(headerWord(H_MASS_UNITS) + 2 * row));
        }
        writeDouble(O_LIQUID_VOLUME, volume * readObservationDouble(H_CELL_VOLUME_LOW));
        writeInteger(O_LIQUID_MASS, totalMass);
        writeDouble(O_LIQUID_TEMPERATURE, headerWord(H_LIQUID_THERMAL) < 0 ? 0.0 : cellTemperature());
        bool granularOccupied = false;
        if (headerWord(H_GRAIN_COUNTS) >= 0) {
            for (int row = 0; row < int(words[headerWord(H_GRAIN_COUNTS)]); row++)
                for (int slot = 0; slot < PARTICLE_SUPPORT_COUNT; slot++)
                    if (int(words[headerWord(H_GRAIN_SUPPORT_CELLS) + PARTICLE_SUPPORT_COUNT * row + slot]) == headerWord(H_CELL) &&
                        readInteger(headerWord(H_GRAIN_SUPPORT_QUOTAS) + 2 * (PARTICLE_SUPPORT_COUNT * row + slot)) > 0l)
                        granularOccupied = true;
            for (int row = 0; row < int(words[headerWord(H_GRAIN_COUNTS) + 1]); row++)
                if (int(words[headerWord(H_DEPOSIT_CELL) + row]) == headerWord(H_CELL))
                    granularOccupied = true;
        }
        outWords[O_GRANULAR_OCCUPIED] = granularOccupied ? 1u : 0u;
        int node = headerWord(H_GAS_CELL_NODES) < 0 ? -1 : int(words[headerWord(H_GAS_CELL_NODES) + headerWord(H_CELL)]);
        outWords[O_GAS_NODE] = uint(node);
        if (node == 0) {
            writeDouble(O_GAS_PRESSURE, ATMOSPHERIC_PRESSURE_PA);
            writeDouble(O_GAS_TEMPERATURE, STANDARD_TEMPERATURE_K);
        } else if (node > 0) {
            writeDouble(O_GAS_PRESSURE, readDouble(headerWord(H_GAS_MIXTURE) + 14 * headerWord(H_CELL)));
            writeDouble(O_GAS_TEMPERATURE, readDouble(headerWord(H_GAS_THERMAL) + 2 * (9 * (node - 1))));
        }
    }
    if (materialOrSpeciesIndex < params.materials) {
        double volume = 0.0;
        int64_t totalMass = 0l;
        for (int row = firstLiquidRow(); row < endLiquidRow(); row++)
            if (int(words[headerWord(H_MATERIALS) + row]) == materialOrSpeciesIndex) {
                volume += readDouble(headerWord(H_VOLUMES) + 2 * row);
                totalMass = checkedAddInventory(totalMass, readInteger(headerWord(H_MASS_UNITS) + 2 * row));
            }
        writeDouble(O_MATERIAL_ROWS + 4 * materialOrSpeciesIndex, volume * readObservationDouble(H_CELL_VOLUME_LOW));
        writeInteger(O_MATERIAL_ROWS + 2 + 4 * materialOrSpeciesIndex, totalMass);
    }
    if (materialOrSpeciesIndex < params.species) {
        int64_t amount = 0l;
        for (int row = firstLiquidRow(); row < endLiquidRow(); row++)
            for (int item = int(words[headerWord(H_SPECIES_OFFSETS) + row]); item < int(words[headerWord(H_SPECIES_OFFSETS) + row + 1]);
                 item++)
                if (int(words[headerWord(H_SPECIES_HANDLES) + item]) == materialOrSpeciesIndex)
                    amount = checkedAddInventory(amount, readInteger(headerWord(H_SPECIES_AMOUNTS) + 2 * item));
        writeInteger(O_MATERIAL_ROWS + 4 * params.materials + 2 * materialOrSpeciesIndex, amount);
    }
    if (materialOrSpeciesIndex < headerWord(H_GRAIN_MATERIAL_COUNT)) {
        int64_t activeVolume = 0l, activeMass = 0l, depositVolume = 0l, depositMass = 0l;
        for (int row = 0; row < lastRow(CARRIER_GRANULAR); row++)
            if (rowBelongsToCell(CARRIER_GRANULAR, row) && int(words[headerWord(H_GRAIN_MATERIAL) + row]) == materialOrSpeciesIndex) {
                if (row < headerWord(H_GRAIN_CAPACITY)) {
                    activeVolume = checkedAddInventory(activeVolume, readInteger(headerWord(H_GRAIN_VOLUME) + 2 * row));
                    activeMass = checkedAddInventory(activeMass, readInteger(headerWord(H_GRAIN_MASS) + 2 * row));
                } else {
                    depositVolume = checkedAddInventory(depositVolume, readInteger(headerWord(H_GRAIN_VOLUME) + 2 * row));
                    depositMass = checkedAddInventory(depositMass, readInteger(headerWord(H_GRAIN_MASS) + 2 * row));
                }
            }
        int base = headerWord(H_SOLID_OUTPUT) + 4 * materialOrSpeciesIndex;
        writeInteger(base, activeVolume);
        writeInteger(base + 2, activeMass);
        base = headerWord(H_SOLID_OUTPUT) + 4 * (headerWord(H_GRAIN_MATERIAL_COUNT) + materialOrSpeciesIndex);
        writeInteger(base, depositVolume);
        writeInteger(base + 2, depositMass);
    }
    if (materialOrSpeciesIndex < headerWord(H_COHERENT_MATERIAL_COUNT)) {
        int64_t volume = 0l, massUnits = 0l;
        for (int row = 0; row < lastRow(CARRIER_COHERENT); row++)
            if (rowBelongsToCell(CARRIER_COHERENT, row) && int(words[headerWord(H_COHERENT_MATERIAL) + row]) == materialOrSpeciesIndex) {
                volume = checkedAddInventory(volume, readInteger(headerWord(H_COHERENT_VOLUME) + 2 * row));
                massUnits = checkedAddInventory(massUnits, readInteger(headerWord(H_COHERENT_MASS) + 2 * row));
            }
        int base = headerWord(H_SOLID_OUTPUT) + 4 * (2 * headerWord(H_GRAIN_MATERIAL_COUNT) + materialOrSpeciesIndex);
        writeInteger(base, volume);
        writeInteger(base + 2, massUnits);
    }
    if (materialOrSpeciesIndex < headerWord(H_GAS_COMPONENT_COUNT)) {
        int64_t volume = 0l, massUnits = 0l;
        int node = headerWord(H_GAS_CELL_NODES) < 0 ? -1 : int(words[headerWord(H_GAS_CELL_NODES) + headerWord(H_CELL)]);
        if (node > 0)
            for (int row = int(words[headerWord(H_GAS_COMPONENT_OFFSETS) + node - 1]);
                 row < int(words[headerWord(H_GAS_COMPONENT_OFFSETS) + node]); row++)
                if (int(words[headerWord(H_GAS_COMPONENT) + row]) == materialOrSpeciesIndex) {
                    volume = checkedAddInventory(volume, readInteger(headerWord(H_GAS_VOLUME) + 2 * row));
                    massUnits = checkedAddInventory(massUnits, readInteger(headerWord(H_GAS_MASS) + 2 * row));
                }
        int base = headerWord(H_GAS_OUTPUT) + 4 * materialOrSpeciesIndex;
        writeInteger(base, volume);
        writeInteger(base + 2, massUnits);
    }
}
