#version 450
#extension GL_ARB_gpu_shader_fp64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
layout(local_size_x=128) in;
layout(binding=0,std430) readonly buffer Source { uint words[]; };
layout(binding=1,std430) buffer Observation { uint outWords[]; };
layout(push_constant) uniform Params { int materials;int species;int unused;int unused2; } p;
int h(int i){return int(outWords[i]);}int ch(int a,int i){return int(words[a+i]);}
double num(int a){return packDouble2x32(uvec2(words[a],words[a+1]));}double derived(int a){return packDouble2x32(uvec2(outWords[a],outWords[a+1]));}
void store(int a,double x){uvec2 v=unpackDouble2x32(x);outWords[a]=v.x;outWords[a+1]=v.y;}
int64_t integer(int a){return int64_t(uint64_t(words[a])|(uint64_t(words[a+1])<<32));}void outint(int a,int64_t x){outWords[a]=uint(x);outWords[a+1]=uint(uint64_t(x)>>32);}
int64_t add(int64_t a,int64_t b){if(a<0l||b<0l||a>9223372036854775807l-b){atomicOr(outWords[22],1u);return 0l;}return a+b;}
int begin(){return int(words[h(3)+h(0)]);}int end(){return int(words[h(3)+h(0)+1]);}
int thermalHeader(int type){return type==0?h(10):type==1?h(15):h(18);}
int firstRow(int type){return type==0?begin():0;}
int lastRow(int type){return type==0?end():type==1?(h(11)<0?0:h(12)+int(words[h(11)+1])):h(16)<0?0:int(words[h(16)]);}
bool selected(int type,int row){
 if(type==0)return true;
 if(type==2)return int(words[h(17)+row])==h(0);
 if(row>=h(12))return int(words[h(14)+row-h(12)])==h(0);
 if(row>=int(words[h(11)]))return false;double size=derived(32);ivec3 q=clamp(ivec3(floor(dvec3(num(h(13)+6*row),num(h(13)+6*row+2),num(h(13)+6*row+4))/size)),ivec3(0),ivec3(h(19),h(20),h(21))-1);
 return (q.z*h(20)+q.y)*h(19)+q.x==h(0);
}
double mass(int header,int row){return double(integer(ch(header,24)+2*row))*1e-10;}
int material(int header,int row){return int(words[ch(header,18)+row]);}
double coldEnergy(int header,int row){int m=material(header,row);double energy=mass(header,row)*(num(ch(header,3)+2*m)+num(ch(header,9)+2*m));
 for(int item=int(words[ch(header,27)+row]);item<int(words[ch(header,27)+row+1]);item++){
  int species=int(words[ch(header,28)+item]);energy+=double(integer(ch(header,29)+2*item))*num(ch(header,4)+2*(m*ch(header,2)+species));
 }return energy;
}
double localTemperature(){
 double remaining=0.0;for(int type=0;type<3;type++){int header=thermalHeader(type);if(header<0)continue;
  for(int row=firstRow(type);row<lastRow(type);row++)if(selected(type,row)&&mass(header,row)>0.0)remaining+=num(ch(header,25)+2*row)-coldEnergy(header,row);
 }
 double t=num(h(10)+44);remaining=max(0.0,remaining);
 for(;;){double capacity=0.0,next=1.7976931348623157e308;
  for(int type=0;type<3;type++){int header=thermalHeader(type);if(header<0)continue;
   for(int row=firstRow(type);row<lastRow(type);row++)if(selected(type,row)){
    double m=mass(header,row);if(m<=0.0)continue;int host=material(header,row),first=int(words[ch(header,5)+host]),last=int(words[ch(header,5)+host+1])-1,segment=first;
    while(segment<last&&t>=num(ch(header,6)+2*segment))segment++;capacity+=m*num(ch(header,7)+2*segment);if(segment<last)next=min(next,num(ch(header,6)+2*segment));
   }
  }
  if(capacity<=0.0)return t;double span=(next-t)*capacity;if(next==1.7976931348623157e308||remaining<span)return t+remaining/capacity;
  remaining-=span;t=next;
 }
}
void main(){int id=int(gl_GlobalInvocationID.x);
 if(id==0){double volume=0.0;int64_t totalMass=0l;for(int row=begin();row<end();row++){volume+=num(h(5)+2*row);totalMass=add(totalMass,integer(h(6)+2*row));}
  store(64,volume*derived(34));outint(66,totalMass);store(68,h(10)<0?0.0:localTemperature());
 }
 if(id<p.materials){double volume=0.0;int64_t totalMass=0l;for(int row=begin();row<end();row++)if(int(words[h(4)+row])==id){volume+=num(h(5)+2*row);totalMass=add(totalMass,integer(h(6)+2*row));}
  store(72+4*id,volume*derived(34));outint(74+4*id,totalMass);
 }
 if(id<p.species){int64_t amount=0l;for(int row=begin();row<end();row++)for(int item=int(words[h(7)+row]);item<int(words[h(7)+row+1]);item++)if(int(words[h(8)+item])==id)amount=add(amount,integer(h(9)+2*item));outint(72+4*p.materials+2*id,amount);}
}
