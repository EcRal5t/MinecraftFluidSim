#version 450
#extension GL_ARB_gpu_shader_fp64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
layout(local_size_x=128) in;
layout(binding=0,std430) buffer Candidate { uint words[]; };
layout(binding=1,std430) buffer Errors { uint errors; };
layout(push_constant) uniform Params { int header; int stage; double duration; double gravity; } p;
int h(int i){return int(words[p.header+i]);}int field(int i){return h(16+i);}
double value(int at){return packDouble2x32(uvec2(words[at],words[at+1]));}
int64_t mass(int at){return int64_t(uint64_t(words[at])|(uint64_t(words[at+1])<<32));}
void store(int at,double x){if(isnan(x)||isinf(x))atomicOr(errors,131072u);uvec2 bits=unpackDouble2x32(x);words[at]=bits.x;words[at+1]=bits.y;}
void prepareCell(int cell){
    double temperature=value(h(5)+2*cell),total=0.0,weighted=0.0;
    for(int stock=int(words[field(1)+cell]);stock<int(words[field(1)+cell+1]);stock++){
        double m=double(mass(field(8)+2*stock));if(m==0.0)continue;
        int material=int(words[field(2)+stock]);
        if(m<0.0||material<0||material>=h(4)||temperature<=0.0){atomicOr(errors,131072u);return;}
        double expansion=value(h(9)+2*material)*(temperature-value(h(8)+2*material)),ratio=1.0+expansion;
        if(ratio<=0.0||isnan(ratio)||isinf(ratio)){atomicOr(errors,131072u);return;}
        weighted+=m*(expansion/ratio);total+=m;
    }
    store(h(10)+2*cell,total>0.0?weighted/total:0.0);store(h(11)+2*cell,total);
}
void buoyancyFace(int local){
    int x=local%h(0),y=local/h(0)%(h(1)+1),z=local/(h(0)*(h(1)+1));
    if(y==0||y==h(1))return;
    int face=(h(0)+1)*h(1)*h(2)+local,at=h(6)+8*face;
    if(h(7)>=0&&(int(words[h(7)+face])&3)!=1)return;
    if(value(at)<=0.0||value(at+4)<=0.0||value(at+6)<=0.0)return;
    int above=(z*h(1)+y)*h(0)+x,below=above-h(0);
    double ma=value(h(11)+2*below),mb=value(h(11)+2*above),total=ma+mb;
    if(total<=0.0)return;
    // The prepared MAC face carries half of each adjacent cell's mass.
    double relative=(ma*value(h(10)+2*below)+mb*value(h(10)+2*above))/total;
    store(at+2,value(at+2)+p.duration*p.gravity*relative);
}
void main(){
    int item=int((gl_WorkGroupID.y*gl_NumWorkGroups.x+gl_WorkGroupID.x)*128u+gl_LocalInvocationID.x);
    if(errors!=0u)return;
    if(p.stage==0){if(item<h(3))prepareCell(item);}
    else if(item<h(0)*(h(1)+1)*h(2))buoyancyFace(item);
}
