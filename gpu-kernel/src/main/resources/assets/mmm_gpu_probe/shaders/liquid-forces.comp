#version 450
#extension GL_ARB_gpu_shader_fp64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
// HOST_LAYOUT

layout(local_size_x = 128) in;
layout(binding = 0, std430) buffer Candidate { uint words[]; };
layout(binding = 1, std430) buffer Errors { uint errors; };
layout(push_constant) uniform Params {
    int header;
    int stage;
    double duration; // s
    double gravity;  // m/s^2
} p;

int header(int entry) { return int(words[p.header + entry]); }
int stockField(int entry) { return header(INVENTORY_FIELDS + entry); }
double readDouble(int offset) { return packDouble2x32(uvec2(words[offset], words[offset + 1])); }
int64_t readMassUnits(int offset) {
    return int64_t(uint64_t(words[offset]) | (uint64_t(words[offset + 1]) << 32));
}
void writeDouble(int offset, double value) {
    if (isnan(value) || isinf(value)) atomicOr(errors, 131072u);
    uvec2 bits = unpackDouble2x32(value);
    words[offset] = bits.x;
    words[offset + 1] = bits.y;
}

// Mass-weighted relative density reduction for the cell's actual material inventory.
void prepareCell(int cell) {
    double temperatureK = readDouble(header(H_TEMPERATURE) + 2 * cell);
    double totalMass = 0.0;
    double weightedReduction = 0.0;
    int firstStock = int(words[stockField(STOCK_CELL_OFFSETS) + cell]);
    int lastStock = int(words[stockField(STOCK_CELL_OFFSETS) + cell + 1]);
    for (int stock = firstStock; stock < lastStock; stock++) {
        double mass = double(readMassUnits(stockField(STOCK_MASS_UNITS) + 2 * stock));
        if (mass == 0.0) continue;
        int material = int(words[stockField(STOCK_MATERIALS) + stock]);
        if (mass < 0.0 || material < 0 || material >= header(H_MATERIAL_COUNT) || temperatureK <= 0.0) {
            atomicOr(errors, 131072u);
            return;
        }
        double referenceK = readDouble(header(H_REFERENCE_TEMPERATURE) + 2 * material);
        double expansion = readDouble(header(H_EXPANSION_COEFFICIENT) + 2 * material) * (temperatureK - referenceK);
        double volumeRatio = 1.0 + expansion;
        if (volumeRatio <= 0.0 || isnan(volumeRatio) || isinf(volumeRatio)) {
            atomicOr(errors, 131072u);
            return;
        }
        weightedReduction += mass * (expansion / volumeRatio);
        totalMass += mass;
    }
    writeDouble(header(H_BUOYANCY) + 2 * cell, totalMass > 0.0 ? weightedReduction / totalMass : 0.0);
    writeDouble(header(H_CELL_MASS) + 2 * cell, totalMass);
}

// Add the thermal correction to the prepared vertical MAC velocity (m/s).
void buoyancyFace(int localFace) {
    int sizeX = header(H_SIZE_X), sizeY = header(H_SIZE_Y), sizeZ = header(H_SIZE_Z);
    int x = localFace % sizeX;
    int y = localFace / sizeX % (sizeY + 1);
    int z = localFace / (sizeX * (sizeY + 1));
    if (y == 0 || y == sizeY) return;
    int face = (sizeX + 1) * sizeY * sizeZ + localFace;
    int faceOffset = header(H_FACES) + 8 * face;
    if (header(H_ACTIVITY_FACES) >= 0 && words[header(H_ACTIVITY_FACES) + face] == 0u) return;
    if (header(H_FACE_FLAGS) >= 0 && (int(words[header(H_FACE_FLAGS) + face]) & 3) != 1) return;
    if (readDouble(faceOffset) <= 0.0 || readDouble(faceOffset + 4) <= 0.0 || readDouble(faceOffset + 6) <= 0.0) return;
    int above = (z * sizeY + y) * sizeX + x;
    int below = above - sizeX;
    double belowMass = readDouble(header(H_CELL_MASS) + 2 * below);
    double aboveMass = readDouble(header(H_CELL_MASS) + 2 * above);
    double totalMass = belowMass + aboveMass;
    if (totalMass <= 0.0) return;
    // Each side contributes half its mass; the common factor cancels in the ratio.
    double relativeReduction = (belowMass * readDouble(header(H_BUOYANCY) + 2 * below)
            + aboveMass * readDouble(header(H_BUOYANCY) + 2 * above)) / totalMass;
    double velocity = readDouble(faceOffset + 2) + p.duration * p.gravity * relativeReduction;
    writeDouble(faceOffset + 2, velocity);
}

void main() {
    int item = int((gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x) * 128u + gl_LocalInvocationID.x);
    if (errors != 0u) return;
    if (p.stage == 0) {
        if (item < header(H_CELL_COUNT)) prepareCell(item);
    } else if (item < header(H_SIZE_X) * (header(H_SIZE_Y) + 1) * header(H_SIZE_Z)) {
        buoyancyFace(item);
    }
}
