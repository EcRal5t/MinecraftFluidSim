#version 450
#extension GL_ARB_gpu_shader_fp64 : require
layout(local_size_x=128)in;
layout(binding=0,std430)buffer Arena{uint words[];};layout(binding=1,std430)buffer Errors{uint errors;};
layout(push_constant)uniform Params{int header;int stage;int maximumIterations;int unused;double duration;}p;
shared dvec4 accurate[128];shared vec4 fast[128];shared float tiles[128];
int h(int i){return int(words[p.header+i]);}int f(int i){return int(words[h(0)+16+i]);}int gh(int i){return int(words[h(0)+i]);}
int actual(){int eos=gh(0),counts=int(words[eos+16]);return int(words[counts]);}
double number(int at){return packDouble2x32(uvec2(words[at],words[at+1]));}void put(int at,double v){uvec2 b=unpackDouble2x32(v);words[at]=b.x;words[at+1]=b.y;}
float fp(int at){return uintBitsToFloat(words[at]);}void putf(int at,float v){words[at]=floatBitsToUint(v);}
double control(int i){return number(f(30)+2*i);}void setControl(int i,double v){put(f(30)+2*i,v);}
float vector(int column,int row){return fp(h(2)+column*h(1)+row);}void setVector(int column,int row,float v){putf(h(2)+column*h(1)+row,v);}
float inverseRoot(int row){return fp(h(4)+row);}
void args(int slot,int count){int at=f(30)+32+4*slot;words[at]=uint(min(count,65535));words[at+1]=uint(max(1,(count+65534)/65535));words[at+2]=1u;words[at+3]=0u;}
void publish(){bool run=errors==0u&&control(3)!=0.0,refresh=errors==0u&&control(7)!=0.0;int groups=(actual()+127)/128;
 args(0,run?groups:0);args(1,run?1:0);args(2,refresh?groups:0);args(3,refresh?1:0);args(10,run&&control(6)!=0.0?groups:0);args(11,run&&control(6)!=0.0?1:0);
 for(int i=0;i<3;i++){int count=int(control(40+i));args(4+i,run?count:0);args(7+i,refresh?count:0);}}
double hypotStable(double a,double b){double high=max(abs(a),abs(b)),low=min(abs(a),abs(b));if(high==0.0)return 0.0;double q=low/high;return high*sqrt(1.0+q*q);}
dvec4 reduceAccurate(int lane,dvec4 v){accurate[lane]=v;barrier();for(int k=64;k>0;k/=2){if(lane<k){dvec4 a=accurate[lane],b=accurate[lane+k];accurate[lane]=dvec4(a.x+b.x,hypotStable(a.y,b.y),max(a.z,b.z),max(a.w,b.w));}barrier();}dvec4 outValue=accurate[0];barrier();return outValue;}
vec4 reduceFast(int lane,vec4 v){fast[lane]=v;barrier();for(int k=64;k>0;k/=2){if(lane<k){vec4 a=fast[lane],b=fast[lane+k];fast[lane]=vec4(a.x+b.x,max(a.y,b.y),a.z+b.z,max(a.w,b.w));}barrier();}vec4 outValue=fast[0];barrier();return outValue;}
void save(int group,dvec4 v){for(int i=0;i<4;i++)put(h(6)+8*group+2*i,v[i]);}
dvec4 collectAccurate(int lane){dvec4 v=dvec4(0.0);for(int i=lane;i<(actual()+127)/128;i+=128){dvec4 n=dvec4(number(h(6)+8*i),number(h(6)+8*i+2),number(h(6)+8*i+4),number(h(6)+8*i+6));v=dvec4(v.x+n.x,hypotStable(v.y,n.y),max(v.z,n.z),max(v.w,n.w));}return reduceAccurate(lane,v);}
vec4 collectFast(int lane){vec4 v=vec4(0.0);for(int i=lane;i<(actual()+127)/128;i+=128){vec4 n=vec4(number(h(6)+8*i),number(h(6)+8*i+2),number(h(6)+8*i+4),number(h(6)+8*i+6));v=vec4(v.x+n.x,max(v.y,n.y),v.z+n.z,max(v.w,n.w));}return reduceFast(lane,v);}
void compileEdge(int row,int at){int start=int(words[f(22)+row]);if(at==start){words[h(9)+at]=uint(row);putf(h(10)+at,0.0);return;}
 int pair=int(words[f(17)+int(words[f(15)+row])+at-start-1]),a=int(words[f(6)+pair]),b=int(words[f(7)+pair]),other=(a==row+1?b:a)-1;
 words[h(9)+at]=uint(other);putf(h(10)+at,float(p.duration*number(f(12)+2*pair)));}
float matrixEntry(int row,int at){int start=int(words[f(22)+row]);float d=vector(1,row);if(at==start)return fp(h(4)+h(1)+row)*d;
 int peer=int(words[h(9)+at]);return fp(h(10)+at)*(d-(peer>=0?vector(1,peer):0.0));}
vec4 collectProduct(int lane){float value=0.0;for(int i=lane;i<(actual()+127)/128;i+=128)value+=float(number(h(6)+8*i));
 for(int i=lane;i<int(words[f(54)]);i+=128)value+=vector(3,int(words[f(50)+i]));return reduceFast(lane,vec4(value,0.0,0.0,0.0));}
void main(){int lane=int(gl_LocalInvocationID.x),group=int(gl_WorkGroupID.y*gl_NumWorkGroups.x+gl_WorkGroupID.x),id=128*group+lane,n=actual();
 if(p.stage==0){double maximum=0.0;if(id<n){double initial=number(f(29)+2*(2*h(1)+id)),root=number(f(19)+2*id);put(f(26)+2*id,initial);maximum=abs(initial);
  putf(h(4)+id,float(1.0/root));putf(h(4)+h(1)+id,float(number(f(18)+2*id)));for(int i=0;i<4;i++)setVector(i,id,0.0);int first=int(words[f(22)+id]),last=int(words[f(22)+id+1]);if(last-first<=128)for(int at=first;at<last;at++)compileEdge(id,at);}
  dvec4 sum=reduceAccurate(lane,dvec4(0.0,0.0,0.0,maximum));if(lane==0)save(group,sum);return;}
 if(p.stage==1){dvec4 sum=collectAccurate(lane);if(lane==0){for(int i=0;i<16;i++)setControl(i,0.0);setControl(3,1.0);setControl(6,1.0);setControl(7,1.0);setControl(11,sum.w);publish();}return;}
 if(p.stage==15){if(lane==0){setControl(3,0.0);setControl(7,1.0);publish();}return;}
 if(errors!=0u)return;
 if(p.stage==19){int row=int(words[f(50)+group]);for(int at=int(words[f(22)+row])+lane;at<int(words[f(22)+row+1]);at+=128)compileEdge(row,at);return;}
 if(p.stage==17){double maximum=id<n?abs(number(f(26)+2*id)):0.0;dvec4 sum=reduceAccurate(lane,dvec4(0.0,0.0,0.0,maximum));if(lane==0)save(group,sum);return;}
 if(p.stage==18){dvec4 sum=collectAccurate(lane);if(lane==0)setControl(11,sum.w);return;}
 if(p.stage==2){double r=0.0,physicalResidual=0.0,bound=0.0,maximum=0.0;if(id<n){double rhs=number(f(29)+2*id);r=rhs-number(f(27)+2*(2*h(1)+id));physicalResidual=r*number(f(19)+2*id);put(h(3)+2*id,physicalResidual);bound=abs(rhs)+2.0*control(11);maximum=abs(number(f(26)+2*id));}
  dvec4 sum=reduceAccurate(lane,dvec4(r*r,bound,abs(physicalResidual),maximum));if(lane==0)save(group,sum);return;}
 if(p.stage==3||p.stage==16){dvec4 sum=collectAccurate(lane);if(lane!=0)return;double rms=sqrt(sum.x/max(1,n)),target=number(f(29)+6*h(1)),floorValue=(double(n)+8.0)*1.1102230246251565e-16LF*sum.y/sqrt(double(max(1,n))),tolerance=max(target,floorValue);
  setControl(1,rms);setControl(10,tolerance);setControl(11,sum.w);
  if(p.stage==16){bool success=!isnan(rms)&&!isinf(rms)&&rms<=tolerance;setControl(2,success?1.0:0.0);setControl(3,0.0);setControl(7,0.0);if(!success)atomicOr(errors,4u);publish();return;}
  if(rms<=tolerance){setControl(2,1.0);setControl(3,0.0);}else{put(h(7),sum.z);put(h(7)+2,1.0);setControl(6,1.0);}setControl(7,0.0);publish();return;}
 if(p.stage==4){float value=0.0;if(id<n){setVector(0,id,float(number(h(3)+2*id)/number(h(7))));put(h(3)+2*id,number(h(7))*number(f(19)+2*id));float r=vector(0,id),inv=inverseRoot(id),z=r*inv*inv;setVector(3,id,z);value=r*z;}
  vec4 sum=reduceFast(lane,vec4(value,0.0,0.0,0.0));if(lane==0)save(group,dvec4(sum));return;}
 if(p.stage==6){vec4 sum=collectFast(lane);if(lane==0){setControl(9,control(6)!=0.0?0.0:double(sum.x)/control(4));setControl(4,double(sum.x));}return;}
 if(p.stage==7){if(id<n)setVector(1,id,control(6)!=0.0?vector(3,id):vector(3,id)+float(control(9))*vector(1,id));return;}
 if(p.stage==8){float dotValue=0.0;if(id<n){int first=int(words[f(22)+id]),last=int(words[f(22)+id+1]);if(last-first<=128){float sum=0.0;for(int e=first;e<last;e++)sum+=matrixEntry(id,e);setVector(2,id,sum);dotValue=vector(1,id)*sum;}}vec4 stats=reduceFast(lane,vec4(dotValue,0.0,0.0,0.0));if(lane==0)save(group,dvec4(stats));return;}
 if(p.stage==9){int row=int(words[f(52)+group]),at=int(words[f(22)+row])+128*(group-int(words[f(51)+row]))+lane;tiles[lane]=at<int(words[f(22)+row+1])?matrixEntry(row,at):0.0;barrier();for(int k=64;k>0;k/=2){if(lane<k)tiles[lane]+=tiles[lane+k];barrier();}if(lane==0)putf(h(5)+group,tiles[0]);return;}
 if(p.stage==10){int row=int(words[f(50)+group]),first=int(words[f(51)+row]),count=(int(words[f(22)+row+1])-int(words[f(22)+row])+127)/128;float sum=0.0;for(int i=lane;i<count;i+=128)sum+=fp(h(5)+first+i);tiles[lane]=sum;barrier();for(int k=64;k>0;k/=2){if(lane<k)tiles[lane]+=tiles[lane+k];barrier();}if(lane==0){setVector(2,row,tiles[0]);setVector(3,row,vector(1,row)*tiles[0]);}return;}
 if(p.stage==12){vec4 sum=collectProduct(lane);if(lane==0){double rz=control(4);if(!(sum.x>0.0&&rz>0.0)){setControl(5,0.0);setControl(7,1.0);}else setControl(5,rz/double(sum.x));}return;}
 if(p.stage==13){vec4 v=vec4(0.0);if(id<n){float alpha=float(control(5)),r=vector(0,id)-alpha*vector(2,id);setVector(0,id,r);float inv=inverseRoot(id),z=r*inv*inv;setVector(3,id,z);double pressure=number(f(26)+2*id)+number(h(3)+2*id)*double(alpha*vector(1,id));put(f(26)+2*id,pressure);v=vec4(r*r,abs(r),r*z,0.0);}
  vec4 sum=reduceFast(lane,v);if(lane==0)save(group,dvec4(sum));return;}
 if(p.stage==14){vec4 sum=collectFast(lane);if(lane==0){setControl(0,control(0)+1.0);setControl(9,double(sum.z)/control(4));setControl(4,double(sum.z));setControl(6,0.0);double maximum=max(number(h(7)+2),double(sum.y));put(h(7)+2,maximum);bool refresh=control(7)!=0.0||double(sum.y)<=0.00034526698300124393*maximum||isnan(sum.y)||isinf(sum.y);setControl(7,refresh?1.0:0.0);if(control(0)>=double(p.maximumIterations))setControl(3,0.0);publish();}return;}
}
