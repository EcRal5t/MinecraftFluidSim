#version 450
#extension GL_ARB_gpu_shader_fp64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
layout(local_size_x=128) in;
layout(binding=0,std430) buffer Arena { uint words[]; };
layout(binding=1,std430) buffer Errors { uint errors; };
layout(push_constant) uniform Params { int header;int stage;int count;int unused;double cellSize;double duration; } p;
int h(int i){return int(words[p.header+i]);}int at(int f){return h(16+f);}int ch(int i){return int(words[h(11)+i]);}int ca(int f){return ch(16+f);}
double num(int a){return packDouble2x32(uvec2(words[a],words[a+1]));}
void outnum(int a,double v){uvec2 b=unpackDouble2x32(v);words[a]=b.x;words[a+1]=b.y;}
dvec3 vec(int a,int i){return dvec3(num(a+6*i),num(a+6*i+2),num(a+6*i+4));}
void outvec(int a,int i,dvec3 v){for(int k=0;k<3;k++)outnum(a+6*i+2*k,v[k]);}
int actual(){return int(words[h(6)]);}ivec3 dims(){return ivec3(h(0),h(1),h(2));}
int cell(ivec3 c){return (c.z*h(1)+c.y)*h(0)+c.x;}
ivec3 location(dvec3 x){return clamp(ivec3(floor(x/p.cellSize)),ivec3(0),dims()-1);}
void invalid(){atomicOr(errors,4194304u);}
double radius(int i){return num(at(8)+2*i);}
bool box(ivec3 c,int bit,out dvec3 lo,out dvec3 hi){
 lo=(dvec3(c)+.5*dvec3(bit&1,(bit>>1)&1,(bit>>2)&1))*p.cellSize;hi=lo+.5*p.cellSize;
 int q=cell(c);if((words[h(5)+q]&(1u<<bit))!=0u)return true;
 double top=num(at(11)+2*q);hi.y=min(hi.y,top);return hi.y>lo.y;
}
// Box clipping uses the same eight fixed microboxes as liquid geometry.
bool hit(dvec3 x,dvec3 delta,dvec3 lo,dvec3 hi,out double time,out dvec3 normal){
 double enter=0.0,leave=1.0;normal=dvec3(0.0);bool inside=all(greaterThanEqual(x,lo))&&all(lessThanEqual(x,hi));
 if(inside){double best=1e300;for(int a=0;a<3;a++){double low=x[a]-lo[a],high=hi[a]-x[a];
  if(low<best){best=low;normal=dvec3(0.0);normal[a]=-1.0;}if(high<best){best=high;normal=dvec3(0.0);normal[a]=1.0;}}
  time=0.0;return true;}
 for(int a=0;a<3;a++){
  if(delta[a]==0.0){if(x[a]<lo[a]||x[a]>hi[a])return false;continue;}
  double t0=(lo[a]-x[a])/delta[a],t1=(hi[a]-x[a])/delta[a];double near=min(t0,t1),far=max(t0,t1);
  if(near>enter){enter=near;normal=dvec3(0.0);normal[a]=delta[a]>0.0?-1.0:1.0;}leave=min(leave,far);if(enter>leave)return false;
 }time=enter;return enter<=1.0&&leave>=0.0&&dot(normal,normal)>0.0;
}
void emit(int first,int second,dvec3 n,int slot){
 words[ca(1)+slot]=uint(first);words[ca(2)+slot]=uint(second);outvec(ca(3),slot,n);outvec(ca(4),slot,dvec3(0.0));
 int a=int(words[h(10)+first]),b=second<0?a:int(words[h(10)+second]);
 outnum(ca(5)+2*slot,min(num(at(9)+6*a),num(at(9)+6*b)));
 outnum(ca(6)+2*slot,sqrt(num(at(9)+6*a+2)*num(at(9)+6*b+2)));
 outnum(ca(7)+2*slot,sqrt(num(at(9)+6*a+4)*num(at(9)+6*b+4)));
}
int enumerate(int i,bool writeContacts){
 dvec3 x=vec(h(7),i),v=vec(h(8),i),delta=v*p.duration;double r=radius(i);int count=0,offset=int(words[at(5)+i]);
 ivec3 center=location(x);
 // Parcel radius is capped at .2h. The 27 center buckets cover every touching pair.
 for(int z=-1;z<=1;z++)for(int y=-1;y<=1;y++)for(int a=-1;a<=1;a++){
  ivec3 c=center+ivec3(a,y,z);if(any(lessThan(c,ivec3(0)))||any(greaterThanEqual(c,dims())))continue;int q=cell(c);
  for(int e=int(words[at(1)+q]);e<int(words[at(1)+q+1]);e++){
   int j=int(words[at(3)+e]);if(j<=i)continue;dvec3 difference=vec(h(7),j)-x;double distance=length(difference),reach=r+radius(j);
   dvec3 relative=(vec(h(8),j)-v)*p.duration;double speed=dot(relative,relative),t=speed>0.0?clamp(-dot(difference,relative)/speed,0.0,1.0):0.0;
   if(length(difference+t*relative)>reach+1e-7*p.cellSize)continue;
   dvec3 n=distance>0.0?difference/distance:dvec3(1.0,0.0,0.0);
   if(writeContacts&&offset+count<ch(1))emit(i,j,n,offset+count);count++;
  }
 }
 for(int a=0;a<3;a++)for(int side=0;side<2;side++){
  double wall=side==0?r:double(dims()[a])*p.cellSize-r;
  if(side==0?min(x[a],x[a]+delta[a])>wall+1e-7*p.cellSize:max(x[a],x[a]+delta[a])<wall-1e-7*p.cellSize)continue;
  dvec3 n=dvec3(0.0);n[a]=side==0?1.0:-1.0;if(writeContacts&&offset+count<ch(1))emit(i,-1,n,offset+count);count++;
 }
 ivec3 low=location(min(x,x+delta)-r),high=location(max(x,x+delta)+r);
 for(int z=low.z;z<=high.z;z++)for(int y=low.y;y<=high.y;y++)for(int a=low.x;a<=high.x;a++){
  ivec3 c=ivec3(a,y,z);uint mask=words[h(5)+cell(c)];
  for(int bit=0;bit<8;bit++){dvec3 lo,hi;if(!box(c,bit,lo,hi))continue;
   double t;dvec3 n;if(!hit(x,delta,lo-r,hi+r,t,n))continue;
   if(writeContacts&&offset+count<ch(1))emit(i,-1,n,offset+count);count++;
  }
 }return count;
}
void trial(int i){
 dvec3 x=vec(h(7),i),delta=vec(h(8),i)*p.duration;double r=radius(i),fraction=1.0;
 for(int a=0;a<3;a++)if(delta[a]!=0.0){double wall=delta[a]>0.0?double(dims()[a])*p.cellSize-r:r;fraction=min(fraction,max(0.0,(wall-x[a])/delta[a]));}
 ivec3 low=location(min(x,x+delta)-r),high=location(max(x,x+delta)+r);
 for(int z=low.z;z<=high.z;z++)for(int y=low.y;y<=high.y;y++)for(int a=low.x;a<=high.x;a++){
  ivec3 c=ivec3(a,y,z);uint mask=words[h(5)+cell(c)];for(int bit=0;bit<8;bit++){
   dvec3 lo,hi;if(!box(c,bit,lo,hi))continue;
   double t;dvec3 n;if(hit(x,delta,lo-r,hi+r,t,n)&&dot(delta,n)<0.0)fraction=min(fraction,t);
  }
 }outvec(at(7),i,x+fraction*delta);
}
double mass(int i){int a=ch(4)+2*i;return double(uint64_t(words[a])|(uint64_t(words[a+1])<<32))*1e-10;}
dvec3 fixedCorrection(dvec3 x,double r){
 dvec3 result=dvec3(0.0);double largest=0.0;
 for(int a=0;a<3;a++){
  double c=x[a]<r?r-x[a]:x[a]>double(dims()[a])*p.cellSize-r?double(dims()[a])*p.cellSize-r-x[a]:0.0;
  if(abs(c)>largest){result=dvec3(0.0);result[a]=c;largest=abs(c);}
 }
 ivec3 low=location(x-r),high=location(x+r);
 for(int z=low.z;z<=high.z;z++)for(int y=low.y;y<=high.y;y++)for(int a=low.x;a<=high.x;a++){
  ivec3 c=ivec3(a,y,z);uint mask=words[h(5)+cell(c)];for(int bit=0;bit<8;bit++){
   dvec3 lo,hi;if(!box(c,bit,lo,hi))continue;
   dvec3 difference=x-clamp(x,lo,hi),correction=dvec3(0.0);double distance=length(difference);
   if(distance>0.0){if(distance<r)correction=difference*((r-distance)/distance);}
   else{double best=1e300;for(int axis=0;axis<3;axis++){
    double q=x[axis]-lo[axis]+r;if(q<best){best=q;correction=dvec3(0.0);correction[axis]=-q;}
    q=hi[axis]-x[axis]+r;if(q<best){best=q;correction=dvec3(0.0);correction[axis]=q;}
   }}double depth=length(correction);if(depth>largest){largest=depth;result=correction;}
  }
 }return result;
}
void separate(int i){
 dvec3 x=vec(at(7),i),correction=dvec3(0.0);int degree=0;
 for(int e=int(words[ca(10)+i]);e<int(words[ca(10)+i+1]);e++){
  int c=int(words[ca(12)+e]),first=int(words[ca(1)+c]),second=int(words[ca(2)+c]);if(second<0)continue;int other=first==i?second:first;
  dvec3 d=x-vec(at(7),other);double distance=length(d),depth=radius(i)+radius(other)-distance;if(depth<=0.0)continue;
  dvec3 n=distance>0.0?d/distance:dvec3(i<other?-1.0:1.0,0.0,0.0);
  correction+=n*depth*mass(other)/(mass(i)+mass(other));degree++;
 }
 x+=correction/double(max(1,degree));x+=fixedCorrection(x,radius(i));outvec(at(10),i,x);
}
void main(){int id=int((gl_WorkGroupID.y*gl_NumWorkGroups.x+gl_WorkGroupID.x)*128+gl_LocalInvocationID.x);if(id>=p.count||errors!=0u)return;
 if(p.stage==11){
  double volume=0.0;if(h(13)>=0)for(int e=int(words[h(13)+id]);e<int(words[h(13)+id+1]);e++){
   int entry=int(words[h(14)+e]),deposit=entry-8*h(3);if(deposit<0)continue;
   int row=h(3)+deposit;int a=h(9)+2*row;double v=double(uint64_t(words[a])|(uint64_t(words[a+1])<<32))/16777216.0;
   double porosity=double(uintBitsToFloat(words[h(15)+deposit]));if(!(porosity>=0.0&&porosity<1.0)){invalid();return;}volume+=v/(1.0-porosity);
  }
  uint mask=(~words[h(5)+id])&255u;double low=double(bitCount(mask&0x33u))*.125,high=double(bitCount(mask&0xccu))*.125;
  double height=volume<=low?(low>0.0?.5*volume/low:0.0):.5+(high>0.0?.5*(volume-low)/high:0.0);
  if(volume>low+high+1e-7){invalid();return;}outnum(at(11)+2*id,(double(id/h(0)%h(1))+clamp(height,0.0,1.0))*p.cellSize);return;
 }
 if(p.stage==0){if(id==0){words[ca(0)]=0u;words[ca(0)+1]=0u;words[ca(0)+2]=0u;}if(id<h(4)){words[at(0)+id]=0u;words[at(2)+id]=0u;}if(id<h(3)){
  words[at(4)+id]=0u;double volume=double(uint64_t(words[h(9)+2*id])|(uint64_t(words[h(9)+2*id+1])<<32));
  // cbrt is evaluated in float; collision footprints follow the CPU float geometry.
  outnum(at(8)+2*id,p.cellSize*clamp(double(pow(float(3.0*volume/16777216.0/(4.0*3.141592653589793)),1.0/3.0)),.02,.20));}return;}
 if(p.stage==5){int required=int(words[at(5)+h(3)]);words[ca(0)+1]=uint(required);words[ca(0)]=uint(required<=ch(1)?required:0);return;}
 if(id>=actual())return;
 if(p.stage==1){dvec3 x=vec(h(7),id),v=vec(h(8),id);if(any(isnan(x))||any(isinf(x))||any(isnan(v))||any(isinf(v))){invalid();return;}
  if(length(v)*p.duration>.25*p.cellSize)atomicOr(words[ca(0)+2],1u);
  atomicAdd(words[at(0)+cell(location(x))],1u);}
 else if(p.stage==2){int c=cell(location(vec(h(7),id))),slot=int(atomicAdd(words[at(2)+c],1u));words[at(3)+int(words[at(1)+c])+slot]=uint(id);}
 else if(p.stage==3)words[at(4)+id]=uint(enumerate(id,false));
 else if(p.stage==4)enumerate(id,true);
 else if(p.stage==6)trial(id);
 else if(p.stage==7){dvec3 x=vec(at(7),id);outvec(h(7),id,x);outnum(h(12)+2*id,x.y);}
 else if(p.stage==8)separate(id);
 else if(p.stage==9)outvec(at(7),id,vec(at(10),id));
 else if(p.stage==10){
  dvec3 x=vec(at(7),id);double tolerance=1e-5*p.cellSize;
  if(length(fixedCorrection(x,radius(id)))>tolerance)atomicOr(words[ca(0)+2],2u);
  for(int e=int(words[ca(10)+id]);e<int(words[ca(10)+id+1]);e++){
   int c=int(words[ca(12)+e]),a=int(words[ca(1)+c]),b=int(words[ca(2)+c]);if(b<0)continue;int other=a==id?b:a;
   if(radius(id)+radius(other)-length(x-vec(at(7),other))>tolerance)atomicOr(words[ca(0)+2],2u);
  }
 }
}
