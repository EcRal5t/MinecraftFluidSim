#version 450
#extension GL_ARB_gpu_shader_fp64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
layout(local_size_x = 128) in;
layout(binding = 0, std430) buffer Candidate {
    uint words[];
};
layout(binding = 1, std430) buffer Errors {
    uint errors;
};
layout(push_constant) uniform Params {
    int header;
    int stage;
    int count;
    int unused;
    double dt;
    double cd;
    double ambientP;
    double ambientT;
    double ambientRho;
    uint64_t step;
}
p;
// HOST_LAYOUT
shared double partial[128];
shared int valid;
int h(int i) {
    return int(words[p.header + i]);
}
int f(int i) {
    return h(WORK_FIELDS + i);
}
int eh(int i) {
    return int(words[h(H_EOS_HEADER) + i]);
}
int gh(int i) {
    return int(words[h(H_GEOMETRY_HEADER) + i]);
}
int gas(int i) {
    return eh(GAS_FIELDS + i);
}
int nodes() {
    return int(words[gas(GAS_COUNTS)]);
}
int pairs() {
    return int(words[f(FIELD_HASH_OFFSETS) + h(H_HASH_CAPACITY)]);
}
double number(int at) {
    return packDouble2x32(uvec2(words[at], words[at + 1]));
}
void put(int at, double value) {
    uvec2 b = unpackDouble2x32(value);
    words[at] = b.x;
    words[at + 1] = b.y;
}
uint64_t quantity(int at) {
    return uint64_t(words[at]) | (uint64_t(words[at + 1]) << 32);
}
bool finite(double x) {
    return !isnan(x) && !isinf(x);
}
void invalid() {
    atomicOr(errors, 262144u);
}
double state(int node, int field) {
    return number(eh(GAS_H_STATES) + 18 * node + 2 * field);
}
double standardT() {
    return number(h(H_EOS_HEADER) + 32);
}
double standardP() {
    return number(h(H_EOS_HEADER) + 36) * 1e9LF * standardT();
}
double standardVolume(int node) {
    return state(node, 4) * standardT() / standardP();
}
double nodePressure(int endpoint) {
    return endpoint == 0 ? p.ambientP : state(endpoint - 1, 1);
}
void reduce(int lane, double value) {
    partial[lane] = value;
    barrier();
    for (int k = 64; k > 0; k >>= 1) {
        if (lane < k)
            partial[lane] += partial[lane + k];
        barrier();
    }
}
ivec3 shape() {
    return ivec3(h(H_SIZE_X), h(H_SIZE_Y), h(H_SIZE_Z));
}
int cell(ivec3 q) {
    ivec3 s = shape();
    return any(lessThan(q, ivec3(0))) || any(greaterThanEqual(q, s)) ? -1 : (q.z * s.y + q.y) * s.x + q.x;
}
ivec2 endpoints(int face) {
    ivec3 s = shape();
    int nx = (s.x + 1) * s.y * s.z, ny = s.x * (s.y + 1) * s.z,
        axis = face < nx        ? 0
               : face < nx + ny ? 1
                                : 2,
        local = face - (axis == 0   ? 0
                        : axis == 1 ? nx
                                    : nx + ny);
    s[axis]++;
    ivec3 q = ivec3(local % s.x, local / s.x % s.y, local / (s.x * s.y)), step = ivec3(0);
    step[axis] = 1;
    return ivec2(cell(q - step), cell(q));
}
void initialize(int id) {
    if (id < h(H_HASH_CAPACITY)) {
        words[f(FIELD_HASH) + id] = 0u;
        words[f(FIELD_HASH_FLAGS) + id] = 0u;
    }
    if (id < h(H_PAIR_CAPACITY)) {
        words[f(FIELD_PAIR_COUNTS) + id] = 0u;
        words[f(FIELD_PAIR_CURSORS) + id] = 0u;
    }
    if (id < h(H_NODE_CAPACITY)) {
        words[f(FIELD_NODE_COUNTS) + id] = 0u;
        words[f(FIELD_NODE_CURSORS) + id] = 0u;
        words[f(FIELD_START_COUNTS) + id] = 1u;
        words[f(FIELD_ROWS) + id] = uint(-1);
        words[f(FIELD_META) + id] = 0u;
    }
    if (id < h(H_NODE_CAPACITY) + 2) {
        words[f(FIELD_SOURCE_COUNTS) + id] = 0u;
        words[f(FIELD_SOURCE_CURSORS) + id] = 0u;
    }
    if (id < h(H_NODE_CAPACITY) + 1) {
        words[f(FIELD_TARGET_COUNTS) + id] = 0u;
        words[f(FIELD_TARGET_CURSORS) + id] = 0u;
    }
    if (id == 0) {
        words[f(FIELD_LONG_COUNTS)] = 0u;
        words[f(FIELD_LONG_COUNTS) + 1] = 0u;
        words[f(FIELD_LONG_COUNTS) + 2] = 0u;
        for (int i = 0; i < 8; i++) {
            words[f(FIELD_DISPATCH) + 3 * i] = 0u;
            words[f(FIELD_DISPATCH) + 3 * i + 1] = 1u;
            words[f(FIELD_DISPATCH) + 3 * i + 2] = 1u;
        }
        if (errors == 0u && (nodes() != int(words[gh(GEO_H_COMPONENT_COUNT)]) || nodes() > h(H_NODE_CAPACITY)))
            invalid();
        words[f(FIELD_STEP)] = uint(p.step);
        words[f(FIELD_STEP) + 1] = uint(p.step >> 32);
        put(f(FIELD_PROBLEM) + 6 * h(H_NODE_CAPACITY), 1e-8LF);
    }
}
void faceKeys(int face) {
    words[f(FIELD_FACE_A) + face] = uint(-1);
    words[f(FIELD_FACE_B) + face] = uint(-1);
    words[f(FIELD_FACE_PAIR) + face] = 0u;
    if (number(gh(GEO_H_FACE_AREAS) + 2 * face) <= 0.0 || words[gh(GEO_H_FULL_CONNECTIONS) + face] != 0u)
        return;
    ivec2 cells = endpoints(face);
    if ((cells.x < 0 || cells.y < 0) && gh(GEO_H_SEALED_EXTERIOR) != 0)
        return;
    if (h(H_ACTIVITY_CELLS) >= 0 && ((cells.x >= 0 && words[h(H_ACTIVITY_CELLS) + cells.x] == 0u) ||
                                     (cells.y >= 0 && words[h(H_ACTIVITY_CELLS) + cells.y] == 0u)))
        return;
    int a = cells.x < 0 ? 0 : int(words[gh(GEO_H_CELL_NODES) + cells.x]),
        b = cells.y < 0 ? 0 : int(words[gh(GEO_H_CELL_NODES) + cells.y]);
    if (a < 0 || b < 0 || a == b)
        return;
    words[f(FIELD_FACE_A) + face] = uint(min(a, b));
    words[f(FIELD_FACE_B) + face] = uint(max(a, b));
}
uint hashPair(uint a, uint b) {
    uint x = a * 0x9e3779b9u + b * 0x85ebca6bu;
    x ^= x >> 16;
    x *= 0x7feb352du;
    x ^= x >> 15;
    return x;
}
void insertFace(int face) {
    int a = int(words[f(FIELD_FACE_A) + face]);
    if (a < 0)
        return;
    uint b = words[f(FIELD_FACE_B) + face], slot = hashPair(uint(a), b) & uint(h(H_HASH_CAPACITY) - 1);
    for (int probe = 0; probe < h(H_HASH_CAPACITY); probe++) {
        uint old = atomicCompSwap(words[f(FIELD_HASH) + int(slot)], 0u, uint(face + 1));
        if (old == 0u ||
            (words[f(FIELD_FACE_A) + int(old) - 1] == uint(a) && words[f(FIELD_FACE_B) + int(old) - 1] == b)) {
            words[f(FIELD_FACE_PAIR) + face] = slot;
            atomicOr(words[f(FIELD_HASH_FLAGS) + int(slot)], 1u);
            return;
        }
        slot = (slot + 1u) & uint(h(H_HASH_CAPACITY) - 1);
    }
    invalid();
}
void makePair(int slot) {
    int count = pairs();
    if (count > h(H_PAIR_CAPACITY)) {
        atomicOr(errors, 64u);
        return;
    }
    if (slot == 0) {
        int sizes[5] =
            int[5](count, (count + 127) / 128, nodes(), (nodes() + 127) / 128, (nodes() + count + 127) / 128);
        for (int i = 0; i < 5; i++) {
            int at = f(FIELD_DISPATCH) + 3 * i;
            words[at] = uint(min(sizes[i], 65535));
            words[at + 1] = uint(max(1, (sizes[i] + 65534) / 65535));
            words[at + 2] = 1u;
        }
        words[f(FIELD_ROUTE_COUNT)] = uint(nodes() + count);
    }
    if (words[f(FIELD_HASH_FLAGS) + slot] == 0u)
        return;
    int pair = int(words[f(FIELD_HASH_OFFSETS) + slot]), face = int(words[f(FIELD_HASH) + slot]) - 1,
        a = int(words[f(FIELD_FACE_A) + face]), b = int(words[f(FIELD_FACE_B) + face]);
    words[f(FIELD_PAIR_A) + pair] = uint(a);
    words[f(FIELD_PAIR_B) + pair] = uint(b);
    if (a > 0) {
        atomicAdd(words[f(FIELD_NODE_COUNTS) + a - 1], 1u);
        atomicAdd(words[f(FIELD_START_COUNTS) + a - 1], 1u);
    }
    if (b > 0) {
        atomicAdd(words[f(FIELD_NODE_COUNTS) + b - 1], 1u);
        atomicAdd(words[f(FIELD_START_COUNTS) + b - 1], 1u);
    }
}
void countFace(int face) {
    if (int(words[f(FIELD_FACE_A) + face]) < 0)
        return;
    int pair = int(words[f(FIELD_HASH_OFFSETS) + int(words[f(FIELD_FACE_PAIR) + face])]);
    words[f(FIELD_FACE_PAIR) + face] = uint(pair);
    atomicAdd(words[f(FIELD_PAIR_COUNTS) + pair], 1u);
}
void scatterFace(int face) {
    if (int(words[f(FIELD_FACE_A) + face]) < 0)
        return;
    int pair = int(words[f(FIELD_FACE_PAIR) + face]),
        at = int(words[f(FIELD_PAIR_OFFSETS) + pair] + atomicAdd(words[f(FIELD_PAIR_CURSORS) + pair], 1u));
    words[f(FIELD_PAIR_FACES) + at] = uint(face);
}
void pairConductance(int pair, int lane, int rowStride) {
    int begin = int(words[f(FIELD_PAIR_OFFSETS) + pair]), end = int(words[f(FIELD_PAIR_OFFSETS) + pair + 1]);
    double area = 0.0;
    for (int at = begin + lane; at < end; at += rowStride)
        area += number(gh(GEO_H_FACE_AREAS) + 2 * int(words[f(FIELD_PAIR_FACES) + at]));
    if (rowStride > 1)
        reduce(lane, area);
    if (lane == 0) {
        int a = int(words[f(FIELD_PAIR_A) + pair]), b = int(words[f(FIELD_PAIR_B) + pair]);
        double pa = nodePressure(a), pb = nodePressure(b), drop = abs(pa - pb);
        int donor = pa >= pb ? a : b;
        double rho = donor == 0 ? p.ambientRho : state(donor - 1, 2),
               ratio = donor == 0 ? p.ambientP / standardP() * standardT() / p.ambientT
                                  : standardVolume(donor - 1) / number(eh(GAS_H_NODE_VOLUMES) + 2 * (donor - 1));
        double conductance = rho > 0.0 && ratio > 0.0
                                 ? p.cd * (rowStride > 1 ? partial[0] : area) * sqrt(2.0LF / rho) * ratio /
                                       sqrt(drop > 0.0 ? drop : max(p.ambientP, max(pa, pb)))
                                 : 0.0LF;
        if (!finite(conductance) || conductance < 0.0)
            invalid();
        put(f(FIELD_PAIR_G) + 2 * pair, conductance);
    }
}
void adjacency(int pair) {
    int a = int(words[f(FIELD_PAIR_A) + pair]), b = int(words[f(FIELD_PAIR_B) + pair]);
    if (a > 0) {
        int at = int(words[f(FIELD_NODE_OFFSETS) + a - 1] + atomicAdd(words[f(FIELD_NODE_CURSORS) + a - 1], 1u));
        words[f(FIELD_NODE_PAIRS) + at] = uint(pair);
    }
    if (b > 0) {
        int at = int(words[f(FIELD_NODE_OFFSETS) + b - 1] + atomicAdd(words[f(FIELD_NODE_CURSORS) + b - 1], 1u));
        words[f(FIELD_NODE_PAIRS) + at] = uint(pair);
    }
}
void diagonal(int node, int lane, int rowStride) {
    double sum = 0.0;
    for (int at = int(words[f(FIELD_NODE_OFFSETS) + node]) + lane; at < int(words[f(FIELD_NODE_OFFSETS) + node + 1]);
         at += rowStride)
        sum += p.dt * number(f(FIELD_PAIR_G) + 2 * int(words[f(FIELD_NODE_PAIRS) + at]));
    if (rowStride > 1)
        reduce(lane, sum);
    if (lane == 0) {
        double volume = number(eh(GAS_H_NODE_VOLUMES) + 2 * node), pressure = state(node, 1),
               storage = pressure > 0.0 ? standardVolume(node) / (state(node, 5) * pressure)
                                        : volume * standardT() / (standardP() * p.ambientT);
        double d = storage + (rowStride > 1 ? partial[0] : sum);
        if (!(finite(d) && d > 0.0 && finite(storage) && storage > 0.0))
            invalid();
        put(f(FIELD_STORAGE) + 2 * node, storage);
        put(f(FIELD_DIAGONAL_ROOT) + 2 * node, sqrt(d));
    }
}
void matrix(int node, int lane, int rowStride) {
    int start = int(words[f(FIELD_STARTS) + node]), begin = int(words[f(FIELD_NODE_OFFSETS) + node]),
        end = int(words[f(FIELD_NODE_OFFSETS) + node + 1]);
    double root = number(f(FIELD_DIAGONAL_ROOT) + 2 * node), ambient = 0.0;
    for (int at = begin + lane; at < end; at += rowStride) {
        int pair = int(words[f(FIELD_NODE_PAIRS) + at]), a = int(words[f(FIELD_PAIR_A) + pair]),
            b = int(words[f(FIELD_PAIR_B) + pair]), other = (a == node + 1 ? b : a), outAt = start + 1 + at - begin;
        double g = p.dt * number(f(FIELD_PAIR_G) + 2 * pair);
        words[f(FIELD_COLUMNS) + outAt] = uint(other > 0 ? other - 1 : node);
        put(f(FIELD_VALUES) + 2 * outAt,
            other > 0 ? -g / (root * number(f(FIELD_DIAGONAL_ROOT) + 2 * (other - 1))) : 0.0LF);
        if (other == 0)
            ambient += g * p.ambientP;
    }
    if (rowStride > 1)
        reduce(lane, ambient);
    if (lane == 0) {
        words[f(FIELD_COLUMNS) + start] = uint(node);
        put(f(FIELD_VALUES) + 2 * start, 1.0);
        words[f(FIELD_ROWS) + node] = uint(node);
        double rhs = number(f(FIELD_STORAGE) + 2 * node) * state(node, 1) + (rowStride > 1 ? partial[0] : ambient);
        put(f(FIELD_PROBLEM) + 2 * node, rhs / root);
        put(f(FIELD_PROBLEM) + 2 * (h(H_NODE_CAPACITY) + node), 0.0);
        put(f(FIELD_PROBLEM) + 2 * (2 * h(H_NODE_CAPACITY) + node), root * state(node, 1));
    }
}
void flowPreference(int pair) {
    int a = int(words[f(FIELD_PAIR_A) + pair]), b = int(words[f(FIELD_PAIR_B) + pair]);
    double pa = a == 0 ? p.ambientP
                       : number(f(FIELD_PRESSURE) + 2 * (a - 1)) / number(f(FIELD_DIAGONAL_ROOT) + 2 * (a - 1)),
           pb = b == 0 ? p.ambientP
                       : number(f(FIELD_PRESSURE) + 2 * (b - 1)) / number(f(FIELD_DIAGONAL_ROOT) + 2 * (b - 1));
    double q = p.dt * number(f(FIELD_PAIR_G) + 2 * pair) * (pa - pb);
    if (!finite(q))
        invalid();
    put(f(FIELD_PAIR_FLOW) + 2 * pair, q);
}
// Integrate each registered caloric segment down to the model's minimum temperature.
double sensibleEnergy(int node) {
    double value = 0.0, temperature = state(node, 0), minimum = number(h(H_EOS_HEADER) + 34);
    for (int c = int(words[gas(GAS_ROW_COMPONENT_OFFSETS) + node]);
         c < int(words[gas(GAS_ROW_COMPONENT_OFFSETS) + node + 1]); c++) {
        int handle = int(words[gas(GAS_COMPONENT_HANDLES) + c]), begin = int(words[eh(GAS_H_SEGMENT_OFFSETS) + handle]),
            end = int(words[eh(GAS_H_SEGMENT_OFFSETS) + handle + 1]);
        double lower = minimum, mass = double(quantity(gas(GAS_MASS_UNITS) + 2 * c)) * 1e-10LF;
        for (int s = begin; s < end && lower < temperature; s++) {
            double upper = s + 1 < end ? number(eh(GAS_H_SEGMENT_UPPER) + 2 * s) : temperature;
            value += mass * number(eh(GAS_H_SEGMENT_CAPACITY) + 2 * s) * max(0.0LF, min(temperature, upper) - lower);
            lower = upper;
        }
    }
    return value;
}
void supply(int node, int lane, int rowStride) {
    double outgoing = 0.0;
    for (int at = int(words[f(FIELD_NODE_OFFSETS) + node]) + lane; at < int(words[f(FIELD_NODE_OFFSETS) + node + 1]);
         at += rowStride) {
        int pair = int(words[f(FIELD_NODE_PAIRS) + at]);
        double q = number(f(FIELD_PAIR_FLOW) + 2 * pair);
        outgoing += max(0.0LF, int(words[f(FIELD_PAIR_A) + pair]) == node + 1 ? q : -q);
    }
    if (rowStride > 1)
        reduce(lane, outgoing);
    if (lane == 0) {
        double total = standardVolume(node), sensible = sensibleEnergy(node),
               pressureEnergy = state(node, 4) * state(node, 0),
               margin = 32.0LF * 2.220446049250313e-16LF * abs(number(gas(GAS_INTERNAL_ENERGY) + 2 * node));
        double fraction =
            sensible + pressureEnergy > 0.0 ? max(0.0LF, (sensible - margin) / (sensible + pressureEnergy)) : 0.0LF;
        fraction = eh(GAS_H_ISOTHERMAL) != 0 ? 1.0LF : min(fraction, 1.0LF - 2.220446049250313e-16LF);
        double scale = (rowStride > 1 ? partial[0] : outgoing) > 0.0
                           ? min(1.0LF, total * fraction / (rowStride > 1 ? partial[0] : outgoing))
                           : 1.0LF;
        put(f(FIELD_OUT_SCALE) + 2 * node, scale);
        put(f(FIELD_ROUTE_WEIGHT) + 2 * node, max(0.0LF, total - scale * (rowStride > 1 ? partial[0] : outgoing)));
    }
}
void route(int id) {
    int source = 0, target = 0;
    double weight = 0.0, ambientVolume = 0.0;
    if (id < nodes()) {
        weight = number(f(FIELD_ROUTE_WEIGHT) + 2 * id);
        source = weight > 0.0 ? id + 2 : 0;
        target = id + 1;
    } else {
        int pair = id - nodes();
        if (pair >= pairs())
            return;
        double q = number(f(FIELD_PAIR_FLOW) + 2 * pair);
        int a = int(words[f(FIELD_PAIR_A) + pair]), b = int(words[f(FIELD_PAIR_B) + pair]), donor = q >= 0.0 ? a : b,
            receiver = q >= 0.0 ? b : a;
        weight = abs(q) * (donor > 0 ? number(f(FIELD_OUT_SCALE) + 2 * (donor - 1)) : 1.0LF);
        if (weight > 0.0) {
            source = donor + 1;
            target = receiver;
            if (donor == 0)
                ambientVolume = weight * p.ambientT / standardT();
        }
    }
    words[f(FIELD_ROUTE_SOURCE) + id] = uint(source);
    words[f(FIELD_ROUTE_TARGET) + id] = uint(target);
    put(f(FIELD_ROUTE_WEIGHT) + 2 * id, weight);
    put(f(FIELD_AMBIENT_VOLUME) + 2 * id, ambientVolume);
    atomicAdd(words[f(FIELD_SOURCE_COUNTS) + source], 1u);
    atomicAdd(words[f(FIELD_TARGET_COUNTS) + target], 1u);
}
void scatterRoute(int id) {
    int source = int(words[f(FIELD_ROUTE_SOURCE) + id]), target = int(words[f(FIELD_ROUTE_TARGET) + id]);
    int a = int(words[f(FIELD_SOURCE_OFFSETS) + source] + atomicAdd(words[f(FIELD_SOURCE_CURSORS) + source], 1u)),
        b = int(words[f(FIELD_TARGET_OFFSETS) + target] + atomicAdd(words[f(FIELD_TARGET_CURSORS) + target], 1u));
    words[f(FIELD_SOURCE_ROUTES) + a] = uint(id);
    words[f(FIELD_TARGET_ROUTES) + b] = uint(id);
}
double vector(int row, bool direction) {
    return number((direction ? f(FIELD_WORK) + 2 * h(H_NODE_CAPACITY) : f(FIELD_PRESSURE)) + 2 * row);
}
bool productNeeded(bool direction) {
    return number(f(FIELD_CONTROL) + 2 * (direction ? 3 : 7)) != 0.0LF;
}
void productSmall(int node, bool direction) {
    if (!productNeeded(direction) || node >= nodes())
        return;
    int begin = int(words[f(FIELD_STARTS) + node]), end = int(words[f(FIELD_STARTS) + node + 1]);
    if (end - begin > 128)
        return;
    double result = 0.0;
    for (int at = begin; at < end; at++)
        result += number(f(FIELD_VALUES) + 2 * at) * vector(int(words[f(FIELD_COLUMNS) + at]), direction);
    put(f(FIELD_WORK) + 2 * (2 * h(H_NODE_CAPACITY) + node), result);
}
void classifyLongRow(int node) {
    if (node >= nodes())
        return;
    int begin = int(words[f(FIELD_STARTS) + node]), end = int(words[f(FIELD_STARTS) + node + 1]), length = end - begin;
    if (length <= 128)
        return;
    int row = int(atomicAdd(words[f(FIELD_LONG_COUNTS)], 1u)), count = (length + 127) / 128,
        first = int(atomicAdd(words[f(FIELD_LONG_COUNTS) + 1], uint(count)));
    words[f(FIELD_LONG_ROWS) + row] = uint(node);
    words[f(FIELD_LONG_STARTS) + node] = uint(first);
    for (int tile = 0; tile < count; tile++)
        words[f(FIELD_TILE_OWNER) + first + tile] = uint(node);
}
void classifyLongPair(int pair) {
    if (pair >= pairs())
        return;
    int count = int(words[f(FIELD_PAIR_OFFSETS) + pair + 1] - words[f(FIELD_PAIR_OFFSETS) + pair]);
    if (count > 128) {
        uint at = atomicAdd(words[f(FIELD_LONG_COUNTS) + 2], 1u);
        words[f(FIELD_LONG_PAIRS) + at] = uint(pair);
    }
}
void longDispatch() {
    int pairCount = int(words[f(FIELD_LONG_COUNTS) + 2]), pairAt = f(FIELD_DISPATCH) + 21;
    words[pairAt] = uint(min(pairCount, 65535));
    words[pairAt + 1] = uint(max(1, (pairCount + 65534) / 65535));
    words[pairAt + 2] = 1u;
    for (int slot = 5; slot <= 6; slot++) {
        int count = int(words[f(FIELD_LONG_COUNTS) + (slot == 5 ? 1 : 0)]), at = f(FIELD_DISPATCH) + 3 * slot;
        words[at] = uint(min(count, 65535));
        words[at + 1] = uint(max(1, (count + 65534) / 65535));
        words[at + 2] = 1u;
    }
    put(f(FIELD_CONTROL) + 80, double((nodes() + 127) / 128));
    put(f(FIELD_CONTROL) + 82, double(words[f(FIELD_LONG_COUNTS) + 1]));
    put(f(FIELD_CONTROL) + 84, double(words[f(FIELD_LONG_COUNTS)]));
}
void productTile(int tile, int lane, bool direction) {
    if (tile >= int(words[f(FIELD_LONG_COUNTS) + 1]))
        return;
    int node = int(words[f(FIELD_TILE_OWNER) + tile]);
    int at = int(words[f(FIELD_STARTS) + node]) + 128 * (tile - int(words[f(FIELD_LONG_STARTS) + node])) + lane,
        end = int(words[f(FIELD_STARTS) + node + 1]);
    double result =
        at < end ? number(f(FIELD_VALUES) + 2 * at) * vector(int(words[f(FIELD_COLUMNS) + at]), direction) : 0.0LF;
    reduce(lane, result);
    if (lane == 0)
        put(f(FIELD_TILE_SUMS) + 2 * tile, partial[0]);
}
void finishLongProduct(int row, int lane) {
    if (row >= int(words[f(FIELD_LONG_COUNTS)]))
        return;
    int node = int(words[f(FIELD_LONG_ROWS) + row]), first = int(words[f(FIELD_LONG_STARTS) + node]);
