double state(int node,int field){return number(eh(9)+18*node+2*field);}double standardT(){return number(h(0)+32);}double standardP(){return number(h(0)+36)*1e9LF*standardT();}
double standardVolume(int node){return state(node,4)*standardT()/standardP();}
double nodePressure(int endpoint){return endpoint==0?p.ambientP:state(endpoint-1,1);}
void reduce(int lane,double value){partial[lane]=value;barrier();for(int k=64;k>0;k>>=1){if(lane<k)partial[lane]+=partial[lane+k];barrier();}}
ivec3 shape(){return ivec3(h(7),h(8),h(9));}int cell(ivec3 q){ivec3 s=shape();return any(lessThan(q,ivec3(0)))||any(greaterThanEqual(q,s))?-1:(q.z*s.y+q.y)*s.x+q.x;}
ivec2 endpoints(int face){ivec3 s=shape();int nx=(s.x+1)*s.y*s.z,ny=s.x*(s.y+1)*s.z,axis=face<nx?0:face<nx+ny?1:2,local=face-(axis==0?0:axis==1?nx:nx+ny);s[axis]++;ivec3 q=ivec3(local%s.x,local/s.x%s.y,local/(s.x*s.y)),step=ivec3(0);step[axis]=1;return ivec2(cell(q-step),cell(q));}
void initialize(int id){
 if(id<h(4)){words[f(HASH)+id]=0u;words[f(HF)+id]=0u;}
 if(id<h(3)){words[f(PC)+id]=0u;words[f(PCU)+id]=0u;}
 if(id<h(2)){words[f(NC)+id]=0u;words[f(NCU)+id]=0u;words[f(STARTCOUNT)+id]=1u;words[f(ROWS)+id]=uint(-1);words[f(META)+id]=0u;}
 if(id<h(2)+2){words[f(SC)+id]=0u;words[f(SCU)+id]=0u;}if(id<h(2)+1){words[f(TC)+id]=0u;words[f(TCU)+id]=0u;}
 if(id==0){words[f(LONG_COUNTS)]=0u;words[f(LONG_COUNTS)+1]=0u;for(int i=0;i<7;i++){words[f(DISPATCH)+3*i]=0u;words[f(DISPATCH)+3*i+1]=1u;words[f(DISPATCH)+3*i+2]=1u;}if(nodes()!=int(words[gh(26)])||nodes()>h(2))invalid();words[f(STEP)]=uint(p.step);words[f(STEP)+1]=uint(p.step>>32);put(f(PROBLEM)+6*h(2),1e-8LF);}
}
void faceKeys(int face){
 words[f(FA)+face]=uint(-1);words[f(FB)+face]=uint(-1);words[f(FP)+face]=0u;
 if(number(gh(20)+2*face)<=0.0||words[gh(21)+face]!=0u)return;
 ivec2 cells=endpoints(face);if((cells.x<0||cells.y<0)&&gh(5)!=0)return;
 int a=cells.x<0?0:int(words[gh(24)+cells.x]),b=cells.y<0?0:int(words[gh(24)+cells.y]);
 if(a<0||b<0||a==b)return;words[f(FA)+face]=uint(min(a,b));words[f(FB)+face]=uint(max(a,b));
}
uint hashPair(uint a,uint b){uint x=a*0x9e3779b9u+b*0x85ebca6bu;x^=x>>16;x*=0x7feb352du;x^=x>>15;return x;}
void insertFace(int face){int a=int(words[f(FA)+face]);if(a<0)return;uint b=words[f(FB)+face],slot=hashPair(uint(a),b)&uint(h(4)-1);
 for(int probe=0;probe<h(4);probe++){uint old=atomicCompSwap(words[f(HASH)+int(slot)],0u,uint(face+1));
  if(old==0u||(words[f(FA)+int(old)-1]==uint(a)&&words[f(FB)+int(old)-1]==b)){words[f(FP)+face]=slot;atomicOr(words[f(HF)+int(slot)],1u);return;}slot=(slot+1u)&uint(h(4)-1);
 }invalid();
}
void makePair(int slot){
 int count=pairs();if(count>h(3)){atomicOr(errors,64u);return;}
 if(slot==0){int sizes[5]=int[5](count,(count+127)/128,nodes(),(nodes()+127)/128,(nodes()+count+127)/128);
  for(int i=0;i<5;i++){int at=f(DISPATCH)+3*i;words[at]=uint(min(sizes[i],65535));words[at+1]=uint(max(1,(sizes[i]+65534)/65535));words[at+2]=1u;}words[f(RC)]=uint(nodes()+count);
 }
 if(words[f(HF)+slot]==0u)return;int pair=int(words[f(HO)+slot]),face=int(words[f(HASH)+slot])-1,a=int(words[f(FA)+face]),b=int(words[f(FB)+face]);
 words[f(PA)+pair]=uint(a);words[f(PB)+pair]=uint(b);
 if(a>0){atomicAdd(words[f(NC)+a-1],1u);atomicAdd(words[f(STARTCOUNT)+a-1],1u);}if(b>0){atomicAdd(words[f(NC)+b-1],1u);atomicAdd(words[f(STARTCOUNT)+b-1],1u);}
}
void countFace(int face){if(int(words[f(FA)+face])<0)return;int pair=int(words[f(HO)+int(words[f(FP)+face])]);words[f(FP)+face]=uint(pair);atomicAdd(words[f(PC)+pair],1u);}
void scatterFace(int face){if(int(words[f(FA)+face])<0)return;int pair=int(words[f(FP)+face]),at=int(words[f(PO)+pair]+atomicAdd(words[f(PCU)+pair],1u));words[f(PF)+at]=uint(face);}
void pairConductance(int pair,int lane){
 int begin=int(words[f(PO)+pair]),end=int(words[f(PO)+pair+1]);double area=0.0;for(int at=begin+lane;at<end;at+=128)area+=number(gh(20)+2*int(words[f(PF)+at]));reduce(lane,area);
 if(lane==0){int a=int(words[f(PA)+pair]),b=int(words[f(PB)+pair]);double pa=nodePressure(a),pb=nodePressure(b),drop=abs(pa-pb);int donor=pa>=pb?a:b;
  double rho=donor==0?p.ambientRho:state(donor-1,2),ratio=donor==0?p.ambientP/standardP()*standardT()/p.ambientT:standardVolume(donor-1)/number(eh(3)+2*(donor-1));
  double conductance=rho>0.0&&ratio>0.0?p.cd*partial[0]*sqrt(2.0LF/rho)*ratio/sqrt(drop>0.0?drop:max(p.ambientP,max(pa,pb))):0.0LF;
  if(!finite(conductance)||conductance<0.0)invalid();put(f(PG)+2*pair,conductance);
 }
}
void adjacency(int pair){int a=int(words[f(PA)+pair]),b=int(words[f(PB)+pair]);if(a>0){int at=int(words[f(NO)+a-1]+atomicAdd(words[f(NCU)+a-1],1u));words[f(NP)+at]=uint(pair);}if(b>0){int at=int(words[f(NO)+b-1]+atomicAdd(words[f(NCU)+b-1],1u));words[f(NP)+at]=uint(pair);}}
void diagonal(int node,int lane){
 double sum=0.0;for(int at=int(words[f(NO)+node])+lane;at<int(words[f(NO)+node+1]);at+=128)sum+=p.dt*number(f(PG)+2*int(words[f(NP)+at]));reduce(lane,sum);
 if(lane==0){double volume=number(eh(3)+2*node),pressure=state(node,1),storage=pressure>0.0?standardVolume(node)/(state(node,5)*pressure):volume*standardT()/(standardP()*p.ambientT);
  double d=storage+partial[0];if(!(finite(d)&&d>0.0&&finite(storage)&&storage>0.0))invalid();put(f(STORAGE)+2*node,storage);put(f(ROOT)+2*node,sqrt(d));}
}
void matrix(int node,int lane){
 int start=int(words[f(START)+node]),begin=int(words[f(NO)+node]),end=int(words[f(NO)+node+1]);double root=number(f(ROOT)+2*node),ambient=0.0;
 for(int at=begin+lane;at<end;at+=128){
  int pair=int(words[f(NP)+at]),a=int(words[f(PA)+pair]),b=int(words[f(PB)+pair]),other=(a==node+1?b:a),outAt=start+1+at-begin;double g=p.dt*number(f(PG)+2*pair);
  words[f(COLS)+outAt]=uint(other>0?other-1:node);put(f(VALUES)+2*outAt,other>0?-g/(root*number(f(ROOT)+2*(other-1))):0.0LF);if(other==0)ambient+=g*p.ambientP;
 }
