void main(){int group=int(gl_WorkGroupID.y*gl_NumWorkGroups.x+gl_WorkGroupID.x),lane=int(gl_LocalInvocationID.x),id=128*group+lane;
 if(p.stage==14||p.stage==15||p.stage==20||p.stage==21){if(lane==0)valid=errors==0u&&productNeeded(p.stage==15||p.stage==21)?1:0;barrier();if(valid==0)return;
  if(p.stage==20||p.stage==21)finishLongProduct(group,lane);else productTile(group,lane,p.stage==15);return;}
 if(p.stage==16||p.stage==17){if(id<p.count&&errors==0u)productSmall(id,p.stage==17);return;}
 if(p.stage==6||p.stage==8||p.stage==9||p.stage==11){if(lane==0)valid=errors==0u&&group<(p.stage==6?pairs():nodes())?1:0;barrier();if(valid==0)return;if(p.stage==6)pairConductance(group,lane);else if(p.stage==8)diagonal(group,lane);else if(p.stage==9)matrix(group,lane);else supply(group,lane);return;}
 if(id>=p.count)return;if(p.stage==0){initialize(id);return;}if(errors!=0u)return;
 if(p.stage==1)faceKeys(id);else if(p.stage==2)insertFace(id);else if(p.stage==3)makePair(id);else if(p.stage==4)countFace(id);else if(p.stage==5)scatterFace(id);
 else if(p.stage==7){if(id<pairs())adjacency(id);}else if(p.stage==10){if(id<pairs())flowPreference(id);}
 else if(p.stage==18)classifyLongRow(id);else if(p.stage==19)longDispatch();
 else if(id<int(words[f(RC)])){if(p.stage==12)route(id);else scatterRoute(id);}
}
