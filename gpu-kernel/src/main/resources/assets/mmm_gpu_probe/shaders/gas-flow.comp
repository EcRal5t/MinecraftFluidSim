}
void longDispatch(){
 for(int slot=5;slot<=6;slot++){int count=int(words[f(LONG_COUNTS)+(slot==5?1:0)]),at=f(DISPATCH)+3*slot;
  words[at]=uint(min(count,65535));words[at+1]=uint(max(1,(count+65534)/65535));words[at+2]=1u;}
 put(f(CONTROL)+80,double((nodes()+127)/128));
 put(f(CONTROL)+82,double(words[f(LONG_COUNTS)+1]));
 put(f(CONTROL)+84,double(words[f(LONG_COUNTS)]));
}
void productTile(int tile,int lane,bool direction){
 if(tile>=int(words[f(LONG_COUNTS)+1]))return;int node=int(words[f(TILE_OWNER)+tile]);
 int at=int(words[f(START)+node])+128*(tile-int(words[f(LONG_STARTS)+node]))+lane,end=int(words[f(START)+node+1]);
 double result=at<end?number(f(VALUES)+2*at)*vector(int(words[f(COLS)+at]),direction):0.0LF;
