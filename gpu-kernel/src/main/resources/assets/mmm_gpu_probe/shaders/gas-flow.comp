layout(local_size_x=128)in;
layout(binding=0,std430)buffer Candidate{uint words[];};layout(binding=1,std430)buffer Errors{uint errors;};
layout(push_constant)uniform Params{int header;int stage;int count;int unused;double dt;double cd;double ambientP;double ambientT;double ambientRho;uint64_t step;}p;
const int FA=0,FB=1,FP=2,HASH=3,HF=4,HO=5,PA=6,PB=7,PC=8,PO=9,PCU=10,PF=11,PG=12,PQ=13,
