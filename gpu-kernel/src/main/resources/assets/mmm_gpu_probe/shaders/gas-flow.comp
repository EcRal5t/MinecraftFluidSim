  double rhs=number(f(STORAGE)+2*node)*state(node,1)+partial[0];put(f(PROBLEM)+2*node,rhs/root);put(f(PROBLEM)+2*(h(2)+node),0.0);put(f(PROBLEM)+2*(2*h(2)+node),root*state(node,1));}
}
void flowPreference(int pair){int a=int(words[f(PA)+pair]),b=int(words[f(PB)+pair]);double pa=a==0?p.ambientP:number(f(PRESSURE)+2*(a-1))/number(f(ROOT)+2*(a-1)),pb=b==0?p.ambientP:number(f(PRESSURE)+2*(b-1))/number(f(ROOT)+2*(b-1));double q=p.dt*number(f(PG)+2*pair)*(pa-pb);if(!finite(q))invalid();put(f(PQ)+2*pair,q);}
// Integrate each registered caloric segment down to the model's minimum temperature.
double sensibleEnergy(int node){double value=0.0,temperature=state(node,0),minimum=number(h(0)+34);
 for(int c=int(words[gas(3)+node]);c<int(words[gas(3)+node+1]);c++){int handle=int(words[gas(4)+c]),begin=int(words[eh(4)+handle]),end=int(words[eh(4)+handle+1]);double lower=minimum,mass=double(quantity(gas(6)+2*c))*1e-10LF;
  for(int s=begin;s<end&&lower<temperature;s++){double upper=s+1<end?number(eh(5)+2*s):temperature;value+=mass*number(eh(6)+2*s)*max(0.0LF,min(temperature,upper)-lower);lower=upper;}}
