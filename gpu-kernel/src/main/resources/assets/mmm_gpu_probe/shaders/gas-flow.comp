}
void route(int id){int source=0,target=0;double weight=0.0,ambientVolume=0.0;
 if(id<nodes()){weight=number(f(RW)+2*id);source=weight>0.0?id+2:0;target=id+1;}
 else{int pair=id-nodes();if(pair>=pairs())return;double q=number(f(PQ)+2*pair);int a=int(words[f(PA)+pair]),b=int(words[f(PB)+pair]),donor=q>=0.0?a:b,receiver=q>=0.0?b:a;
  weight=abs(q)*(donor>0?number(f(SCALE)+2*(donor-1)):1.0LF);if(weight>0.0){source=donor+1;target=receiver;if(donor==0)ambientVolume=weight*p.ambientT/standardT();}}
 words[f(RS)+id]=uint(source);words[f(RT)+id]=uint(target);put(f(RW)+2*id,weight);put(f(AV)+2*id,ambientVolume);atomicAdd(words[f(SC)+source],1u);atomicAdd(words[f(TC)+target],1u);
}
void scatterRoute(int id){int source=int(words[f(RS)+id]),target=int(words[f(RT)+id]);int a=int(words[f(SO)+source]+atomicAdd(words[f(SCU)+source],1u)),b=int(words[f(TO)+target]+atomicAdd(words[f(TCU)+target],1u));words[f(SR)+a]=uint(id);words[f(TR)+b]=uint(id);}
double vector(int row,bool direction){return number((direction?f(WORK)+2*h(2):f(PRESSURE))+2*row);}
bool productNeeded(bool direction){return number(f(CONTROL)+2*(direction?3:7))!=0.0LF;}
void productSmall(int node,bool direction){
 if(!productNeeded(direction)||node>=nodes())return;int begin=int(words[f(START)+node]),end=int(words[f(START)+node+1]);if(end-begin>128)return;
 double result=0.0;for(int at=begin;at<end;at++)result+=number(f(VALUES)+2*at)*vector(int(words[f(COLS)+at]),direction);
 put(f(WORK)+2*(2*h(2)+node),result);
}
void classifyLongRow(int node){
 if(node>=nodes())return;int begin=int(words[f(START)+node]),end=int(words[f(START)+node+1]),length=end-begin;if(length<=128)return;
 int row=int(atomicAdd(words[f(LONG_COUNTS)],1u)),count=(length+127)/128,first=int(atomicAdd(words[f(LONG_COUNTS)+1],uint(count)));
 words[f(LONG_ROWS)+row]=uint(node);words[f(LONG_STARTS)+node]=uint(first);
