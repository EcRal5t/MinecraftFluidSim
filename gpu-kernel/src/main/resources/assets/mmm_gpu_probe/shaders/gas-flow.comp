void finishLongProduct(int row,int lane){
 if(row>=int(words[f(LONG_COUNTS)]))return;int node=int(words[f(LONG_ROWS)+row]),first=int(words[f(LONG_STARTS)+node]);
 int length=int(words[f(START)+node+1])-int(words[f(START)+node]),count=(length+127)/128;double sum=0.0;
