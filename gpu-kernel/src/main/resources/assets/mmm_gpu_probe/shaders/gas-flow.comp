int h(int i){return int(words[p.header+i]);}int f(int i){return h(16+i);}int eh(int i){return int(words[h(0)+i]);}int gh(int i){return int(words[h(1)+i]);}
int gas(int i){return eh(16+i);}int nodes(){return int(words[gas(0)]);}int pairs(){return int(words[f(HO)+h(4)]);}
double number(int at){return packDouble2x32(uvec2(words[at],words[at+1]));}void put(int at,double value){uvec2 b=unpackDouble2x32(value);words[at]=b.x;words[at+1]=b.y;}
