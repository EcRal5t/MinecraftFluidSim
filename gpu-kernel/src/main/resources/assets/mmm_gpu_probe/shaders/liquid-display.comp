#version 450
#extension GL_ARB_gpu_shader_fp64 : require
layout(local_size_x=128)in;
layout(binding=0,std430)readonly buffer Source{uint words[];};
layout(binding=1,std430)buffer Display{uint o[];};
layout(push_constant)uniform Params{int cells;int materials;int offsets;int handles;int volumes;int planes;int micro;int masks;int outPlane;int layers;int order;int unused;}p;
double number(int at){return packDouble2x32(uvec2(words[at],words[at+1]));}
float amount(int c,int material){double volume=0.0;for(int r=int(words[p.offsets+c]);r<int(words[p.offsets+c+1]);r++)if(int(words[p.handles+r])==material)volume+=number(p.volumes+2*r);return float(volume);}
float box(vec3 n,float offset){float scale=max(abs(n.x),max(abs(n.y),abs(n.z)));if(scale==0.0)return offset>=0.0?1.0:0.0;n/=scale;float t=offset/scale-min(n.x,0.0)-min(n.y,0.0)-min(n.z,0.0);vec3 a=abs(n);float x=min(a.x,min(a.y,a.z)),z=max(a.x,max(a.y,a.z)),y=a.x+a.y+a.z-x-z,total=x+y+z;if(t<=0.0)return 0.0;if(t>=total)return 1.0;bool complement=t>total*.5;if(complement)t=total-t;float f;
 if(y==0.0)f=t/z;else if(x==0.0)f=t<=y?.5*(t/y)*(t/z):(t-.5*y)/z;
 else if(t<=x)f=(t/x)*(t/y)*(t/z)/6.0;else if(t<=y)f=(3.0*t*(t-x)+x*x)/(6.0*y*z);else if(t>=x+y)f=(t-.5*(x+y))/z;else{float u=t-y,v=max(0.0,t-z);f=(3.0*t*(t-x)+x*x-(u*u*u+v*v*v)/x)/(6.0*y*z);}return clamp(complement?1.0-f:f,0.0,1.0);}
float slab(vec4 plane,int micro,float low,float high){vec3 origin=.5*vec3(micro&1,(micro>>1)&1,(micro>>2)&1);low=max(low,origin.y);high=min(high,origin.y+.5);if(high<=low)return 0.0;origin.y=low;return .25*(high-low)*box(plane.xyz*vec3(.5,high-low,.5),plane.w-dot(plane.xyz,origin));}
void main(){int c=int(gl_GlobalInvocationID.x);if(c>=p.cells)return;vec4 plane;for(int k=0;k<4;k++){plane[k]=float(number(p.planes+8*c+2*k));o[p.outPlane+4*c+k]=floatBitsToUint(plane[k]);}
 float total=0.0;int assigned=0,live=0;for(int m=0;m<p.materials;m++){float v=amount(c,m);total+=v;if(v>0.0)live++;int at=p.layers+4*(m*p.cells+c);o[at]=0u;o[at+1]=floatBitsToUint(1.0);o[at+2]=0u;o[at+3]=0u;}if(total<=0.0)return;
 for(int m=0;m<p.materials;m++)assigned+=int(floor(255.0*amount(c,m)/total));
 int open=0;float geometric=0.0;for(int micro=0;micro<8;micro++)if((words[p.masks+c]&(1u<<micro))==0u&&number(p.micro+16*c+2*micro)>0.0){open|=1<<micro;if(live>1)geometric+=slab(plane,micro,0.0,1.0);}
 float lower=0.0,cumulative=0.0;int done=0;
 for(int rank=0;rank<p.materials;rank++){int m=int(o[p.order+rank]);float v=amount(c,m);if(v<=0.0)continue;done++;cumulative+=v;float upper=1.0;
  if(done<live){float lo=lower,hi=1.0,target=geometric*cumulative/total;for(int i=0;i<24;i++){float mid=.5*(lo+hi),volume=0.0;for(int micro=0;micro<8;micro++)if((open&(1<<micro))!=0)volume+=slab(plane,micro,0.0,mid);if(volume<target)lo=mid;else hi=mid;}upper=.5*(lo+hi);}
  int mask=0;if(live==1)mask=open;else for(int micro=0;micro<8;micro++)if((open&(1<<micro))!=0&&slab(plane,micro,lower,upper)>0.0)mask|=1<<micro;
  float scaled=255.0*v/total,remainder=scaled-floor(scaled);int remainderRank=0;
  for(int peer=0;peer<p.materials;peer++){float f=255.0*amount(c,peer)/total,r=f-floor(f);if(r>remainder||(r==remainder&&peer<m))remainderRank++;}
  int q=int(floor(scaled))+(remainderRank<255-assigned?1:0),at=p.layers+4*(m*p.cells+c);o[at]=floatBitsToUint(lower);o[at+1]=floatBitsToUint(upper);o[at+2]=uint(mask);o[at+3]=uint(q);lower=upper;
 }
}
