#version 450
const uint WORKGROUP_SIZE = 256u;
const uint WORKGROUP_ROW_WIDTH = 65535u;
const uint MAXIMUM_OFFSET = 0x7fffffffu;
const uint NO_OFFSET = 0xffffffffu;
const uint ERROR_OFFSET_OVERFLOW = 16u;
const uint STAGE_ADD_PARENT_OFFSETS = 1u;
layout(local_size_x=256) in;
layout(std430,binding=0) readonly buffer Counts { uint counts[]; };
layout(std430,binding=1) buffer Offsets { uint offsets[]; };
layout(std430,binding=2) buffer Workspace { uint workspaceWords[]; };
layout(std430,binding=3) buffer Errors { uint errors; };
layout(push_constant) uniform Metadata {
    uint stage; uint count; uint levelOffset; uint parentLevelOffset; uint isInputLevel; uint totalOutputIndex;
    uint inputOffset; uint outputOffset; uint workspaceOffset; uint liveCountOffset;
} params;
shared uint scanValues[256];

uint checkedAdd(uint a,uint b) {
    uint result=a+b;
    if(result<a || result>MAXIMUM_OFFSET) atomicOr(errors,ERROR_OFFSET_OVERFLOW);
    return result;
}
void main() {
    if ((errors & 64u) != 0u) return;
    uint workgroupIndex=gl_WorkGroupID.x+gl_WorkGroupID.y*WORKGROUP_ROW_WIDTH;
    if(workgroupIndex>=(params.count+(WORKGROUP_SIZE-1u))/WORKGROUP_SIZE && params.count!=0u)return;
    uint lane=gl_LocalInvocationID.x, elementIndex=workgroupIndex*WORKGROUP_SIZE+lane;
    if(params.stage==STAGE_ADD_PARENT_OFFSETS) {
        if(elementIndex<params.count) {
            uint addend=workspaceWords[params.workspaceOffset+params.parentLevelOffset+workgroupIndex];
            if(params.isInputLevel!=0u)offsets[params.outputOffset+elementIndex]=checkedAdd(offsets[params.outputOffset+elementIndex],addend);
            else workspaceWords[params.workspaceOffset+params.levelOffset+elementIndex]=checkedAdd(workspaceWords[params.workspaceOffset+params.levelOffset+elementIndex],addend);
        }
        return;
    }
    uint inputCount=0u;
    if(elementIndex<params.count){
        if(params.isInputLevel!=0u){uint liveElementCount=params.liveCountOffset==NO_OFFSET?params.count:counts[params.liveCountOffset];if(liveElementCount>params.count)atomicOr(errors,ERROR_OFFSET_OVERFLOW);if(elementIndex<liveElementCount)inputCount=counts[params.inputOffset+elementIndex];}
        else inputCount=workspaceWords[params.workspaceOffset+params.levelOffset+elementIndex];
    }
    if(inputCount>MAXIMUM_OFFSET)atomicOr(errors,ERROR_OFFSET_OVERFLOW);
    scanValues[lane]=inputCount;
    barrier();
    for(uint stride=1u;stride<WORKGROUP_SIZE;stride*=2u) {
        uint target=(lane+1u)*stride*2u-1u;
        if(target<WORKGROUP_SIZE)scanValues[target]=checkedAdd(scanValues[target],scanValues[target-stride]);
        barrier();
    }
    if(lane==0u) {
        uint total=scanValues[WORKGROUP_SIZE-1u];
        if(params.parentLevelOffset==NO_OFFSET)offsets[params.outputOffset+params.totalOutputIndex]=total;
        else workspaceWords[params.workspaceOffset+params.parentLevelOffset+workgroupIndex]=total;
        scanValues[WORKGROUP_SIZE-1u]=0u;
    }
    barrier();
    for(uint stride=WORKGROUP_SIZE/2u;stride>0u;stride/=2u) {
        uint target=(lane+1u)*stride*2u-1u;
        if(target<WORKGROUP_SIZE) {
            uint leftSubtreeSum=scanValues[target-stride];
            scanValues[target-stride]=scanValues[target];
            scanValues[target]=checkedAdd(scanValues[target],leftSubtreeSum);
        }
        barrier();
    }
    if(elementIndex<params.count) {
        if(params.isInputLevel!=0u)offsets[params.outputOffset+elementIndex]=scanValues[lane];
        else workspaceWords[params.workspaceOffset+params.levelOffset+elementIndex]=scanValues[lane];
    }
}
