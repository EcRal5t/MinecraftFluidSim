#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
// HOST_LAYOUT
layout(local_size_x=128) in;
layout(binding=0,std430) buffer Candidate { uint candidateWords[]; };
layout(binding=1,std430) buffer Errors { uint errors; };
layout(push_constant) uniform Params { int header; int stage; int count; } p;
// DYADIC_LIBRARY
uvec2 integerWords;
int h(int index) { return int(candidateWords[p.header+index]); }
uint dyadicWord(int bank,int index) { return bank==2?integerWords[index]:candidateWords[index]; }
void dyadicWrite(int index,uint value) { candidateWords[index]=value; }
int64_t getLong(int at) { return int64_t(uint64_t(candidateWords[at])|(uint64_t(candidateWords[at+1])<<32)); }
DyadicTerm totalVolume(int cell) {
    int begin=int(candidateWords[h(H_SOURCE_OFFSETS)+cell]),end=int(candidateWords[h(H_SOURCE_OFFSETS)+cell+1]);
    return DyadicTerm(1,h(H_SOURCE_LIMBS)+begin,end-begin,int(candidateWords[h(H_SOURCE_EXPONENTS)+cell]),int(candidateWords[h(H_SOURCE_SIGNS)+cell]));
}
DyadicTerm integerVolume(uint64_t value) {
    if(value==uint64_t(0))return DyadicTerm(2,0,0,0,0);
    int trailing=uint(value)==0u?32+findLSB(uint(value>>32)):findLSB(uint(value));
    value>>=trailing;integerWords=uvec2(uint(value),uint(value>>32));
    int64_t exponent=int64_t(h(H_QUANTUM_EXPONENT))+int64_t(trailing);
    if(exponent>int64_t(2147483647)){atomicOr(errors,32u);return DyadicTerm(2,0,0,0,0);}
    return DyadicTerm(2,0,integerWords.y==0u?1:2,int(exponent),1);
}
bool acceptedTotal(int cell,out uint64_t moving) {
    uint64_t sum=uint64_t(0);moving=uint64_t(0);
    for(int slot=0;slot<7;slot++) {
        int64_t amount=getLong(h(H_ACCEPTED)+2*(7*cell+slot));
        if(amount<int64_t(0)||uint64_t(amount)>uint64_t(0x7fffffffffffffffUL)-sum){atomicOr(errors,32u);return false;}
        sum+=uint64_t(amount);if(slot!=0)moving+=uint64_t(amount);
    }
    int64_t supply=getLong(h(H_SOURCE_QUANTIZED)+2*cell);
    if(supply<int64_t(0)||sum!=uint64_t(supply)){atomicOr(errors,32u);return false;}
    return true;
}
void putMeasure(int cell,DyadicMeasure value) {
    int at=h(H_MEASUREMENTS)+8*cell;
    candidateWords[at]=uint(value.status);candidateWords[at+1]=uint(value.words);
    candidateWords[at+2]=uint(value.exponent);candidateWords[at+3]=uint(value.minimumExponent);
    candidateWords[at+4]=uint(value.firstWord);candidateWords[at+5]=uint(value.lastWord);candidateWords[at+6]=uint(value.trailingBits);
    candidateWords[at+7]=0u;
}
DyadicMeasure getMeasure(int cell) {
    int at=h(H_MEASUREMENTS)+8*cell;
    return DyadicMeasure(int(candidateWords[at]),int(candidateWords[at+1]),int(candidateWords[at+2]),
                         int(candidateWords[at+3]),int(candidateWords[at+4]),int(candidateWords[at+5]),int(candidateWords[at+6]));
}
// Assign each donor volume to retained and accepted routes before allocating exact limbs.
void measureCell(int cell) {
    candidateWords[h(H_MEASUREMENTS)+8*cell+7]=0u;
    for(int slot=0;slot<7;slot++) {
        int entry=7*cell+slot;candidateWords[h(H_COUNTS)+entry]=0u;candidateWords[h(H_ROUTE_SIGNS)+entry]=0u;candidateWords[h(H_ROUTE_EXPONENTS)+entry]=0u;
    }
    if(errors!=0u)return;
    uint64_t moving;if(!acceptedTotal(cell,moving))return;
    // Assign the final fractional quantum to the retained route, or to one
    // accepted outgoing route when the donor is emptied.
    int owner=0;
    if(getLong(h(H_ACCEPTED)+14*cell)==int64_t(0)) {
        owner=-1;for(int slot=1;slot<7;slot++)if(getLong(h(H_ACCEPTED)+2*(7*cell+slot))>int64_t(0)){owner=slot;break;}
    }
    if(owner<0)return;
    uint64_t owned=uint64_t(getLong(h(H_ACCEPTED)+2*(7*cell+owner)));
    uint64_t supply=uint64_t(getLong(h(H_SOURCE_QUANTIZED)+2*cell));
    DyadicTerm items[7];items[0]=totalVolume(cell);items[1]=integerVolume(supply-owned);items[1].sign=-items[1].sign;
    if(errors!=0u)return;
    DyadicMeasure remainder=dyadicMeasure(items,2);
    if(remainder.status!=DYADIC_ZERO&&remainder.status!=DYADIC_POSITIVE){atomicOr(errors,32u);return;}
    putMeasure(cell,remainder);candidateWords[h(H_MEASUREMENTS)+8*cell+7]=uint(owner);
    for(int slot=0;slot<7;slot++) {
        int entry=7*cell+slot;DyadicTerm value=integerVolume(uint64_t(getLong(h(H_ACCEPTED)+2*entry)));
        candidateWords[h(H_COUNTS)+entry]=uint(slot==owner?remainder.words:value.count);
        candidateWords[h(H_ROUTE_SIGNS)+entry]=uint(slot==owner?(remainder.status==DYADIC_POSITIVE?1:0):value.sign);
        candidateWords[h(H_ROUTE_EXPONENTS)+entry]=uint(slot==owner?remainder.exponent:value.exponent);
    }
}
// Write exact route volumes into the offsets produced by the prefix scan.
void writeCell(int cell) {
    if(errors!=0u)return;
    if(candidateWords[h(H_ROUTE_OFFSETS)+7*h(H_CELL_COUNT)]>uint(h(H_LIMB_CAPACITY))){atomicOr(errors,64u);return;}
    int owner=int(candidateWords[h(H_MEASUREMENTS)+8*cell+7]);
    uint64_t supply=uint64_t(getLong(h(H_SOURCE_QUANTIZED)+2*cell));
    uint64_t owned=uint64_t(getLong(h(H_ACCEPTED)+2*(7*cell+owner)));
    DyadicTerm items[7];items[0]=totalVolume(cell);items[1]=integerVolume(supply-owned);items[1].sign=-items[1].sign;
    DyadicMeasure remainder=getMeasure(cell);
    if(supply>uint64_t(0))dyadicWriteSum(items,2,remainder,h(H_ROUTE_LIMBS)+int(candidateWords[h(H_ROUTE_OFFSETS)+7*cell+owner]));
    for(int slot=0;slot<7;slot++) {
        int entry=7*cell+slot,at=h(H_DESCRIPTORS)+5*entry,outputOffset=h(H_ROUTE_LIMBS)+int(candidateWords[h(H_ROUTE_OFFSETS)+entry]);
        int count=int(candidateWords[h(H_COUNTS)+entry]);
        if(slot!=owner&&count!=0) {
            DyadicTerm value=integerVolume(uint64_t(getLong(h(H_ACCEPTED)+2*entry)));
            candidateWords[outputOffset]=integerWords.x;if(value.count==2)candidateWords[outputOffset+1]=integerWords.y;
        }
        candidateWords[at]=1u;candidateWords[at+1]=uint(outputOffset);candidateWords[at+2]=uint(count);
        candidateWords[at+3]=candidateWords[h(H_ROUTE_EXPONENTS)+entry];candidateWords[at+4]=candidateWords[h(H_ROUTE_SIGNS)+entry];
    }
}
void main() {
    uint id=(gl_WorkGroupID.y*gl_NumWorkGroups.x+gl_WorkGroupID.x)*128u+gl_LocalInvocationID.x;
    if(id>=uint(p.count))return;
    if(p.stage==0)measureCell(int(id));else writeCell(int(id));
}
