#version 450
#extension GL_ARB_gpu_shader_fp64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
const int STAGE_INITIALIZE = 0;
const int STAGE_CLEAR_CHANGED = 1;
const int STAGE_JOIN_FACES = 2;
const int STAGE_JOIN_CELLS = 3;
const int STAGE_COMPRESS_PARENTS = 4;
const int STAGE_COUNT_MEMBERS = 5;
const int STAGE_JOIN_PARTICLES = 7;
const uint ERROR_MECHANICAL_BODY = 32u;
// HOST_LAYOUT
layout(local_size_x=128) in;
layout(binding=0,std430) readonly buffer Source { uint sourceWords[]; };
layout(binding=1,std430) buffer Candidate { uint words[]; };
layout(binding=2,std430) buffer Errors { uint errors; };
layout(push_constant) uniform Params { int header; int stage; int count; } p;
int headerValue(int i){return int(words[p.header+i]);}
int gasCount(){return headerValue(H_GAS_COUNTS)<0?0:int(words[headerValue(H_GAS_COUNTS)]);}
int particleCount(){return headerValue(H_PARTICLE_CAPACITY)==0?0:int(words[headerValue(H_GRAIN_COUNTS)]);}
bool liveVertex(int index){if(index<headerValue(H_CELLS))return true;if(index<headerValue(H_CELLS)+headerValue(H_GAS_CAPACITY))return index<headerValue(H_CELLS)+gasCount();return index<headerValue(H_CELLS)+headerValue(H_GAS_CAPACITY)+particleCount();}
double value(int at){return packDouble2x32(uvec2(words[at],words[at+1]));}
int64_t mass(int at){return int64_t(uint64_t(words[at])|(uint64_t(words[at+1])<<32));}
int64_t routeMass(int stock,int slot){uint mask=words[headerValue(H_ROUTE_MASKS)+stock];if((mask&(1u<<slot))==0u)return int64_t(0);int r=int(words[headerValue(H_ROUTE_OFFSETS)+stock])+bitCount(mask&((1u<<slot)-1u));return mass(headerValue(H_ROUTE_MASS)+2*r);}
int componentRoot(int vertex){
    int next=int(atomicAdd(words[headerValue(H_PARENTS)+vertex],0u));
    while(next!=vertex){
        int parent=int(atomicAdd(words[headerValue(H_PARENTS)+next],0u));
        atomicCompSwap(words[headerValue(H_PARENTS)+vertex],uint(next),uint(parent));
        vertex=next;next=parent;
    }return vertex;
}
void joinComponents(int first,int second){
    for(;;){
        int a=componentRoot(first),b=componentRoot(second);if(a==b)return;
        int high=max(a,b),low=min(a,b);
        // Only roots are linked; every successful link strictly decreases the parent.
        if(atomicCompSwap(words[headerValue(H_PARENTS)+high],uint(high),uint(low))==uint(high))return;
    }
}
int cellIndex(ivec3 pos){return (pos.z*headerValue(H_SIZE_Y)+pos.y)*headerValue(H_SIZE_X)+pos.x;}
void joinFace(int index){
    int nx=(headerValue(H_SIZE_X)+1)*headerValue(H_SIZE_Y)*headerValue(H_SIZE_Z),ny=headerValue(H_SIZE_X)*(headerValue(H_SIZE_Y)+1)*headerValue(H_SIZE_Z);
    int axis=index<nx?0:index<nx+ny?1:2,local=index-(axis==0?0:axis==1?nx:nx+ny);
    ivec3 dims=ivec3(headerValue(H_SIZE_X),headerValue(H_SIZE_Y),headerValue(H_SIZE_Z));dims[axis]++;
    ivec3 pos=ivec3(local%dims.x,local/dims.x%dims.y,local/(dims.x*dims.y));
    if(pos[axis]==0||pos[axis]==ivec3(headerValue(H_SIZE_X),headerValue(H_SIZE_Y),headerValue(H_SIZE_Z))[axis])return;
    int at=headerValue(H_PROJECTED_FACES)+8*index;
    if(value(at)<=0.0||value(at+4)<=0.0)return;
    ivec3 previous=pos;previous[axis]--;joinComponents(cellIndex(previous),cellIndex(pos));
}
void joinCell(int index){
    if(headerValue(H_GAS_COUNTS)>=0){if(gasCount()>headerValue(H_GAS_CAPACITY)||gasCount()!=headerValue(H_CELLS)){atomicOr(errors,ERROR_MECHANICAL_BODY);return;}joinComponents(index,headerValue(H_CELLS)+index);}
    ivec3 pos=ivec3(index%headerValue(H_SIZE_X),index/headerValue(H_SIZE_X)%headerValue(H_SIZE_Y),index/(headerValue(H_SIZE_X)*headerValue(H_SIZE_Y)));
    int first=int(sourceWords[headerValue(H_SOURCE_CELL_OFFSETS)+index]),last=int(sourceWords[headerValue(H_SOURCE_CELL_OFFSETS)+index+1]);
    for(int side=0;side<6;side++){
        bool moving=false;
        for(int stock=first;stock<last;stock++)if(routeMass(stock,side+1)>int64_t(0)){moving=true;break;}
        if(!moving)continue;
        ivec3 target=pos;target[side/2]+=(side&1)==0?-1:1;
        if(any(lessThan(target,ivec3(0)))||any(greaterThanEqual(target,ivec3(headerValue(H_SIZE_X),headerValue(H_SIZE_Y),headerValue(H_SIZE_Z))))){atomicOr(errors,ERROR_MECHANICAL_BODY);return;}
        joinComponents(index,cellIndex(target));
    }
}
void joinParticle(int index){
    if(index>=particleCount())return;int vertex=headerValue(H_CELLS)+headerValue(H_GAS_CAPACITY)+index;
    if(headerValue(H_CONTACT_COMPONENTS)>=0){int component=int(words[headerValue(H_CONTACT_COMPONENTS)+index]);if(component<0||component>=particleCount()){atomicOr(errors,ERROR_MECHANICAL_BODY);return;}joinComponents(vertex,headerValue(H_CELLS)+headerValue(H_GAS_CAPACITY)+component);}
    for(int slot=0;slot<8;slot++)if(mass(headerValue(H_GRAIN_SUPPORT_QUOTAS)+2*(8*index+slot))>int64_t(0))joinComponents(vertex,int(words[headerValue(H_GRAIN_SUPPORT_CELLS)+8*index+slot]));
    for(int entry=24*index;entry<24*(index+1);entry++){
        if(value(headerValue(H_GRAIN_FACE_SHARES)+2*entry)<=0.0&&(value(headerValue(H_GRAIN_DRAG_RESISTANCE)+2*index)<=0.0||value(headerValue(H_GRAIN_DRAG_WEIGHTS)+2*entry)<=0.0))continue;
        int f=int(words[headerValue(H_GRAIN_FACE_IDS)+entry]);if(f<0)continue;
        int nx=(headerValue(H_SIZE_X)+1)*headerValue(H_SIZE_Y)*headerValue(H_SIZE_Z),ny=headerValue(H_SIZE_X)*(headerValue(H_SIZE_Y)+1)*headerValue(H_SIZE_Z);
        int axis=f<nx?0:f<nx+ny?1:2,local=f-(axis==0?0:axis==1?nx:nx+ny);
        ivec3 dims=ivec3(headerValue(H_SIZE_X),headerValue(H_SIZE_Y),headerValue(H_SIZE_Z));dims[axis]++;
        ivec3 pos=ivec3(local%dims.x,local/dims.x%dims.y,local/(dims.x*dims.y));
        if(pos[axis]<ivec3(headerValue(H_SIZE_X),headerValue(H_SIZE_Y),headerValue(H_SIZE_Z))[axis])joinComponents(vertex,cellIndex(pos));
        if(pos[axis]>0){pos[axis]--;joinComponents(vertex,cellIndex(pos));}
    }
}
void main(){
    int item=int((gl_WorkGroupID.y*gl_NumWorkGroups.x+gl_WorkGroupID.x)*128u+gl_LocalInvocationID.x);
    if(item>=p.count||errors!=0u)return;
    if(p.stage==STAGE_INITIALIZE){words[headerValue(H_PARENTS)+item]=uint(item);words[headerValue(H_COUNTS)+item]=0u;words[headerValue(H_CURSORS)+item]=0u;if(item==0)words[headerValue(H_CHANGED)]=1u;}
    else if(p.stage==STAGE_CLEAR_CHANGED)words[headerValue(H_CHANGED)]=0u;
    else if(p.stage==STAGE_JOIN_FACES)joinFace(item);
    else if(p.stage==STAGE_JOIN_CELLS)joinCell(item);
    else if(p.stage==STAGE_JOIN_PARTICLES)joinParticle(item);
    else if(!liveVertex(item))return;
    else if(p.stage==STAGE_COMPRESS_PARENTS){int parent=componentRoot(item);atomicExchange(words[headerValue(H_PARENTS)+item],uint(parent));}
    else if(p.stage==STAGE_COUNT_MEMBERS){if(words[headerValue(H_CHANGED)]!=0u){atomicOr(errors,8192u);return;}atomicAdd(words[headerValue(H_COUNTS)+int(words[headerValue(H_PARENTS)+item])],1u);}
    else {int parent=int(words[headerValue(H_PARENTS)+item]);uint offset=atomicAdd(words[headerValue(H_CURSORS)+parent],1u);words[headerValue(H_MEMBERS)+int(words[headerValue(H_OFFSETS)+parent]+offset)]=uint(item);}
}
