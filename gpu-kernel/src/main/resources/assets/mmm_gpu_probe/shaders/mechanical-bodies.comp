#version 450
#extension GL_ARB_gpu_shader_fp64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
layout(local_size_x=128) in;
layout(binding=0,std430) readonly buffer Source { uint sourceWords[]; };
layout(binding=1,std430) buffer Candidate { uint words[]; };
layout(binding=2,std430) buffer Errors { uint errors; };
layout(push_constant) uniform Params { int header; int stage; int count; } p;
int h(int i){return int(words[p.header+i]);}
int gasCount(){return h(17)<0?0:int(words[h(17)]);}
double value(int at){return packDouble2x32(uvec2(words[at],words[at+1]));}
int64_t mass(int at){return int64_t(uint64_t(words[at])|(uint64_t(words[at+1])<<32));}
int root(int vertex){int next=int(words[h(11)+vertex]);while(next!=vertex){vertex=next;next=int(words[h(11)+vertex]);}return vertex;}
void join(int first,int second){
    int a=root(first),b=root(second);if(a==b)return;
    uint old=atomicMin(words[h(11)+max(a,b)],uint(min(a,b)));
    if(old>uint(min(a,b)))atomicOr(words[h(12)],1u);
}
int cellIndex(ivec3 pos){return (pos.z*h(1)+pos.y)*h(0)+pos.x;}
void face(int index){
    int nx=(h(0)+1)*h(1)*h(2),ny=h(0)*(h(1)+1)*h(2);
    int axis=index<nx?0:index<nx+ny?1:2,local=index-(axis==0?0:axis==1?nx:nx+ny);
    ivec3 dims=ivec3(h(0),h(1),h(2));dims[axis]++;
    ivec3 pos=ivec3(local%dims.x,local/dims.x%dims.y,local/(dims.x*dims.y));
    if(pos[axis]==0||pos[axis]==ivec3(h(0),h(1),h(2))[axis])return;
    int at=h(8)+8*index;
    if(value(at)<=0.0||value(at+4)<=0.0||value(at+6)<=0.0)return;
    ivec3 previous=pos;previous[axis]--;join(cellIndex(previous),cellIndex(pos));
}
void cell(int index){
    if(h(9)>=0){int gas=int(words[h(9)+index]);if(gas>gasCount()||gasCount()>h(10)){atomicOr(errors,32u);return;}if(gas>0)join(index,h(3)+gas-1);}
    ivec3 pos=ivec3(index%h(0),index/h(0)%h(1),index/(h(0)*h(1)));
    int first=int(sourceWords[h(6)+index]),last=int(sourceWords[h(6)+index+1]);
    for(int side=0;side<6;side++){
        bool moving=false;
        for(int stock=first;stock<last;stock++)if(mass(h(7)+2*(7*stock+side+1))>int64_t(0)){moving=true;break;}
        if(!moving)continue;
        ivec3 target=pos;target[side/2]+=(side&1)==0?-1:1;
        if(any(lessThan(target,ivec3(0)))||any(greaterThanEqual(target,ivec3(h(0),h(1),h(2))))){atomicOr(errors,32u);return;}
        join(index,cellIndex(target));
    }
}
void main(){
    int item=int((gl_WorkGroupID.y*gl_NumWorkGroups.x+gl_WorkGroupID.x)*128u+gl_LocalInvocationID.x);
    if(item>=p.count||errors!=0u)return;
    if(p.stage==0){words[h(11)+item]=uint(item);words[h(13)+item]=0u;words[h(15)+item]=0u;if(item==0)words[h(12)]=1u;}
    else if(p.stage==1)words[h(12)]=0u;
    else if(p.stage==2)face(item);
    else if(p.stage==3)cell(item);
    else if(item>=h(3)+gasCount())return;
    else if(p.stage==4){int parent=root(item);uint old=atomicMin(words[h(11)+item],uint(parent));if(old!=uint(parent))atomicOr(words[h(12)],1u);}
    else if(p.stage==5){if(words[h(12)]!=0u){atomicOr(errors,8192u);return;}atomicAdd(words[h(13)+int(words[h(11)+item])],1u);}
    else {int parent=int(words[h(11)+item]);uint offset=atomicAdd(words[h(15)+parent],1u);words[h(16)+int(words[h(14)+parent]+offset)]=uint(item);}
}
