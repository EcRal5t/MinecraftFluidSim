// Evaluate the exact liquid reference volume after removing whole phase-change batches.
int remainingVolumeStatus(int lr, int64_t batches) {
    int header = headerWord(H_PHASE_ROWS_HEADER);
    DyadicTerm items[7];
    for (int i = 0; i < 7; i++) items[i] = DyadicTerm(1, 0, 0, 0, 0);
    if (lr < phaseRowHeader(header, LP_H_SLOT_COUNT) && lr < int(words[stockField(LP_STOCK_COUNTS)])) {
        int count = int(words[stockField(LP_STOCK_VOLUME_COUNTS) + lr]);
        items[0] = DyadicTerm(1, stockField(LP_STOCK_VOLUME_LIMBS) + int(words[stockField(LP_STOCK_VOLUME_OFFSETS) + lr]),
                              count, int(words[stockField(LP_STOCK_VOLUME_EXPONENTS) + lr]), count > 0 ? 1 : 0);
    }
    int64_t delta = readQuantity(phaseRowField(header, LP_FIELD_DELTA_SVQ) + 2 * lr) - batches;
    if (delta != 0l) {
        u64vec2 value = mul128(delta < 0l ? 0UL - uint64_t(delta) : uint64_t(delta),
                                uint64_t(readQuantity(header + LP_H_VOLUME_SIGNIFICAND)));
        int at = phaseRowField(header, LP_FIELD_DELTA_LIMBS) + 4 * lr;
        words[at] = uint(value.x); words[at + 1] = uint(value.x >> 32);
        words[at + 2] = uint(value.y); words[at + 3] = uint(value.y >> 32);
        int count = value.y != 0UL ? (value.y >> 32 != 0UL ? 4 : 3) : (value.x >> 32 != 0UL ? 2 : 1);
        items[1] = DyadicTerm(1, at, count, phaseRowHeader(header, LP_H_VOLUME_EXPONENT), delta > 0l ? 1 : -1);
    }
    return dyadicMeasure(items, 7).status;
}

bool vaporBatchesFit(int lr, int species, int64_t batches, int64_t quantum, int64_t unit, int64_t oldMass) {
    int status = remainingVolumeStatus(lr, batches);
    if (status == DYADIC_POSITIVE) return true;
    if (status == DYADIC_ZERO) {
        int64_t q = batches * quantum;
        if (q * unit != oldMass) return false;
        int header = headerWord(H_PHASE_ROWS_HEADER);
        for (int s = 0; s < headerWord(H_SPECIES_COUNT); s++)
            if (phaseRowSpecies(header, lr, s) != (s == species ? q : 0l)) return false;
        return true;
    }
    if (status != DYADIC_NEGATIVE) reportInvalid();
    return false;
}

int64_t limitVaporByVolume(int lr, int species, int64_t q, int64_t quantum, int64_t unit, int64_t oldMass) {
    int64_t upper = q / quantum;
    if (upper == 0l || vaporBatchesFit(lr, species, upper, quantum, unit, oldMass)) return upper * quantum;
    int64_t lower = 0l;
    while (lower < upper) {
        int64_t mid = lower + (upper - lower + 1l) / 2l;
        if (vaporBatchesFit(lr, species, mid, quantum, unit, oldMass)) lower = mid;
        else upper = mid - 1l;
    }
    return lower * quantum;
}
bool lessEqual(u64vec2 a, u64vec2 b) {
    return a.y < b.y || a.y == b.y && a.x <= b.x;
}
int64_t portion(int64_t a, int64_t b, int64_t total) {
    if (a == 0l || b == 0l)
        return 0l;
    if (b == total)
        return a;
    uint64_t q = min(uint64_t(a), uint64_t(floor(double(a) * (double(b) / double(total)))));
    u64vec2 target = mul128(uint64_t(a), uint64_t(b));
    while (!lessEqual(mul128(q, uint64_t(total)), target))
        q--;
    while (q < uint64_t(a) && lessEqual(mul128(q + 1UL, uint64_t(total)), target))
        q++;
    return int64_t(q);
}
int component(int node, int m) {
    return node * gasHeaderWord(GAS_H_COMPONENT_COUNT) + m;
}
int gasSpecies(int comp, int s) {
    for (int a = int(words[gasField(GAS_COMPONENT_SPECIES_OFFSETS) + comp]); a < int(words[gasField(GAS_COMPONENT_SPECIES_OFFSETS) + comp + 1]); a++)
        if (int(words[gasField(GAS_SPECIES_HANDLES) + a]) == s)
            return a;
    return -1;
}
double massUnit() {
    return 1e-10LF;
}
double specificLiquid(int m, double t) {
    double specificEnergy = readDouble(liquidCaloricWord(CAL_MATERIAL_REFERENCE) + 2 * m) + readDouble(liquidCaloricWord(CAL_COLD_SENSIBLE) + 2 * m), lower = readDouble(headerWord(H_LIQUID_CALORIC) + CAL_MINIMUM_TEMPERATURE);
    int end = int(words[liquidCaloricWord(CAL_SEGMENT_OFFSETS) + m + 1]);
    for (int a = int(words[liquidCaloricWord(CAL_SEGMENT_OFFSETS) + m]); a < end && lower < t; a++) {
        double upper = a == end - 1 ? t : min(t, readDouble(liquidCaloricWord(CAL_SEGMENT_UPPER) + 2 * a));
        specificEnergy += (upper - lower) * readDouble(liquidCaloricWord(CAL_SEGMENT_CAPACITY) + 2 * a);
        lower = upper;
    }
    return specificEnergy;
}
double specificGas(int m, double t) {
    double specificEnergy = readDouble(gasHeaderWord(GAS_H_ANCHOR_ENERGY) + 2 * m), anchor = 293.15LF, low = min(t, anchor), high = max(t, anchor),
           edge = readDouble(headerWord(H_LIQUID_CALORIC) + CAL_MINIMUM_TEMPERATURE), integral = 0.0;
    int end = int(words[gasHeaderWord(GAS_H_SEGMENT_OFFSETS) + m + 1]);
    for (int a = int(words[gasHeaderWord(GAS_H_SEGMENT_OFFSETS) + m]); a < end && edge < high; a++) {
        double upper = a == end - 1 ? high : min(high, readDouble(gasHeaderWord(GAS_H_SEGMENT_UPPER) + 2 * a));
        integral += max(0.0LF, upper - max(edge, low)) * readDouble(gasHeaderWord(GAS_H_SEGMENT_CAPACITY) + 2 * a);
        edge = upper;
    }
    return specificEnergy + (t >= anchor ? integral : -integral);
}
double liquidCold(int lr, int material) {
    double minimum=readDouble(headerWord(H_LIQUID_CALORIC)+CAL_MINIMUM_TEMPERATURE);
    double kg=double(phaseRowMass(headerWord(H_PHASE_ROWS_HEADER),lr))*massUnit();
    double coldEnergy=kg*specificLiquid(material,minimum);

    for (int sp = 0; sp < headerWord(H_SPECIES_COUNT); sp++) {
        int64_t speciesAmount = phaseRowSpecies(headerWord(H_PHASE_ROWS_HEADER), lr, sp);
        if (speciesAmount > 0l)
            coldEnergy += double(speciesAmount) * readDouble(liquidCaloricWord(CAL_SPECIES_REFERENCE) + 2 * (material * liquidCaloricWord(CAL_SPECIES_STRIDE) + sp));
    }
    return coldEnergy;
}

ivec3 shape() { return gridShape(); }
