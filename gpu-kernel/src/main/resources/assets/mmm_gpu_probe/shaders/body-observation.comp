#version 450
#extension GL_ARB_gpu_shader_fp64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
layout(local_size_x=128) in;
layout(binding=0,std430) readonly buffer Source { uint words[]; };
layout(binding=1,std430) buffer Observation { uint outputWords[]; };
layout(push_constant) uniform Params { int stage;int count;int groups;int unused; } p;
shared double sums[1664];
int h(int i){return int(outputWords[i]);}
double num(int a){return packDouble2x32(uvec2(words[a],words[a+1]));}
double outvalue(int a){return packDouble2x32(uvec2(outputWords[a],outputWords[a+1]));}
void store(int a,double x){uvec2 bits=unpackDouble2x32(x);outputWords[a]=bits.x;outputWords[a+1]=bits.y;}
int64_t integer(int a){return int64_t(uint64_t(words[a])|(uint64_t(words[a+1])<<32));}
double liquid(int c,int k){return num(h(12)+2*(4*c+k));}
double cellSize(){return outvalue(44);}double gravity(){return outvalue(46);}
dvec3 bodyLow(){return dvec3(outvalue(32),outvalue(34),outvalue(36));}dvec3 bodyHigh(){return dvec3(outvalue(38),outvalue(40),outvalue(42));}
ivec3 dims(){return ivec3(h(0),h(1),h(2));}int cell(ivec3 c){return (c.z*h(1)+c.y)*h(0)+c.x;}
int nx(){return (h(0)+1)*h(1)*h(2);}int ny(){return h(0)*(h(1)+1)*h(2);}
int faceAt(int axis,ivec3 c){ivec3 d=dims();d[axis]++;return (axis==0?0:axis==1?nx():nx()+ny())+(c.z*d.y+c.y)*d.x+c.x;}
double faceVelocity(int f){return num(h(14)+2*(4*f+1));}
double power(double x,int n){double result=1.0;for(int i=0;i<n;i++)result*=x;return result;}
// Fraction and first moments of a unit box below one plane. Inclusion-exclusion is evaluated
// on the smaller cut; inactive axes use their exact half-box moment.
double cut(dvec3 coefficients,double offset,out dvec3 moment){
 double scale=max(abs(coefficients.x),max(abs(coefficients.y),abs(coefficients.z)));
 if(scale==0.0){double fraction=offset>=0.0?1.0:0.0;moment=dvec3(.5*fraction);return fraction;}
 dvec3 original=coefficients/scale,w=abs(original);double t=offset/scale-dot(min(original,dvec3(0.0)),dvec3(1.0));
 int axes[3],d=0;double product=1.0,total=0.0;for(int a=0;a<3;a++)if(w[a]>1e-12){axes[d++]=a;product*=w[a];total+=w[a];}
 if(t<=0.0){moment=dvec3(0.0);return 0.0;}if(t>=total){moment=dvec3(.5);return 1.0;}
 bool complement=t>.5*total;if(complement)t=total-t;double factorial=d==3?6.0:d==2?2.0:1.0,fraction=0.0;dvec3 raw=dvec3(0.0);
 for(int bits=0;bits<(1<<d);bits++){
  double shift=0.0;for(int i=0;i<d;i++)if((bits&(1<<i))!=0)shift+=w[axes[i]];
  double tail=max(0.0,t-shift),sign=(bitCount(uint(bits))&1)==0?1.0:-1.0;
  double volume=power(tail,d)/factorial,first=power(tail,d+1)/(factorial*double(d+1));fraction+=sign*volume;
  for(int i=0;i<d;i++){int axis=axes[i];raw[axis]+=sign*(first+(((bits&(1<<i))!=0)?w[axis]*volume:0.0))/w[axis];}
 }
 fraction=clamp(fraction/product,0.0,1.0);moment=dvec3(.5*fraction);for(int i=0;i<d;i++)moment[axes[i]]=clamp(raw[axes[i]]/product,0.0,fraction);
 if(complement){moment=dvec3(.5-fraction)+moment;fraction=1.0-fraction;}
 for(int axis=0;axis<3;axis++)if(original[axis]<0.0)moment[axis]=fraction-moment[axis];return fraction;
}
double clippedVolume(dvec4 plane,dvec3 lo,dvec3 hi,out dvec3 centerOut){
 dvec3 extent=max(dvec3(0.0),hi-lo),moment;double fraction=cut(plane.xyz*extent,plane.w-dot(plane.xyz,lo),moment);
 centerOut=fraction>0.0?lo+extent*(moment/fraction):.5*(lo+hi);return fraction*extent.x*extent.y*extent.z;
}
double below(int c,double y,dvec4 plane,double pore){double volume=0.0;uint mask=words[h(11)+c];
 for(int bit=0;bit<8;bit++)if((mask&(1u<<bit))==0u){dvec3 lo=.5*dvec3(bit&1,(bit>>1)&1,(bit>>2)&1),hi=lo+.5;hi.y=min(hi.y,y);dvec3 center;
  if(hi.y>lo.y)volume+=clippedVolume(plane,lo,hi,center)*pore;
 }return volume;
}
double layerHeight(int c,double volume,dvec4 plane,double pore){if(volume<=0.0)return 0.0;if(volume>=liquid(c,0))return 1.0;double lo=0.0,hi=1.0;
 for(int i=0;i<16;i++){double middle=.5*(lo+hi);if(below(c,middle,plane,pore)<volume)lo=middle;else hi=middle;}return .5*(lo+hi);
}
double gasPressure(int c){if(h(21)<0||h(22)<0)return 0.0;int node=int(words[h(22)+c])-1;return node<0?0.0:num(h(21)+2*(9*node+1))-101325.0;}
void sampleCell(int c,ivec3 coord,out double value[13]){
 for(int i=0;i<13;i++)value[i]=0.0;double volume=liquid(c,0),available=liquid(c,2);if(available<=0.0)return;
 double size=cellSize(),h3=size*size*size,h2=size*size,density=volume>0.0?liquid(c,1)/(volume*h3):0.0;uint mask=words[h(11)+c];
 double open=double(bitCount((~mask)&255u))*.125,pore=open>0.0?available/open:0.0;if(pore<=0.0)return;
 dvec4 plane=dvec4(num(h(13)+8*c),num(h(13)+8*c+2),num(h(13)+8*c+4),num(h(13)+8*c+6));
 dvec3 boundLow=bodyLow()-dvec3(coord),boundHigh=bodyHigh()-dvec3(coord),flow=dvec3(0.0);
 for(int axis=0;axis<3;axis++){ivec3 next=coord;next[axis]++;flow[axis]=.5*(faceVelocity(faceAt(axis,coord))+faceVelocity(faceAt(axis,next)));}
 double waterVolume=0.0,waterMass=0.0,denserVolume=0.0;
 int first=int(words[h(15)+c]),last=int(words[h(15)+c+1]);
 for(int row=first;row<last;row++)if(int(words[h(17)+row])==h(19)){waterVolume+=num(h(16)+2*row);waterMass+=double(integer(h(18)+2*row))*1e-10;}
 double waterDensity=waterVolume>0.0?waterMass/(waterVolume*h3):0.0;
 if(waterVolume>0.0)for(int row=first;row<last;row++)if(int(words[h(17)+row])!=h(19)){
  double v=num(h(16)+2*row);double rho=v>0.0?double(integer(h(18)+2*row))*1e-10/(v*h3):0.0;if(rho>waterDensity)denserVolume+=v;
 }
 double waterLo=waterVolume>0.0?layerHeight(c,denserVolume,plane,pore):0.0,waterHi=waterVolume>0.0?layerHeight(c,denserVolume+waterVolume,plane,pore):0.0;
 double liquidMoment=0.0;for(int bit=0;bit<8;bit++)if((mask&(1u<<bit))==0u){dvec3 lo=.5*dvec3(bit&1,(bit>>1)&1,(bit>>2)&1),hi=lo+.5,center;double v=clippedVolume(plane,lo,hi,center)*pore;liquidMoment+=v*center.y;}
 double liquidY=volume>0.0?liquidMoment/volume:.5,basePressure=available-volume<=4e-5&&h(20)>=0?num(h(20)+2*c):gasPressure(c);
 if(available-volume>4e-5){double surfaceY=abs(plane.y)>1e-12?clamp((plane.w-.5*plane.x-.5*plane.z)/plane.y,0.0,1.0):liquidY;basePressure+=density*gravity()*size*(surfaceY-liquidY);}
 for(int bit=0;bit<8;bit++)if((mask&(1u<<bit))==0u){
  dvec3 micro=.5*dvec3(bit&1,(bit>>1)&1,(bit>>2)&1),lo=max(micro,boundLow),hi=min(micro+.5,boundHigh),center;
  if(any(lessThanEqual(hi,lo)))continue;double overlap=clippedVolume(plane,lo,hi,center)*pore*h3;
  value[0]+=overlap;for(int axis=0;axis<3;axis++){value[1+axis]+=(double(coord[axis])+center[axis])*size*overlap;value[4+axis]+=flow[axis]*overlap;}value[8]+=density*overlap;
  if(waterVolume>0.0){dvec3 waterLow=lo,waterHigh=hi;waterLow.y=max(waterLow.y,waterLo);waterHigh.y=min(waterHigh.y,waterHi);if(waterHigh.y>waterLow.y)value[12]+=clippedVolume(plane,waterLow,waterHigh,center)*pore*h3;}
  for(int axis=0;axis<3;axis++)for(int side=0;side<2;side++){
   double point=side==0?boundLow[axis]:boundHigh[axis];bool within=side==0?point>=micro[axis]&&point<micro[axis]+.5:point>micro[axis]&&point<=micro[axis]+.5;
   if(!within)continue;dvec3 faceLow=lo,faceHigh=hi;faceLow[axis]=point;faceHigh[axis]=point;dvec3 extent=faceHigh-faceLow,moment;
   int a=(axis+1)%3,b=(axis+2)%3;double fraction=cut(plane.xyz*extent,plane.w-dot(plane.xyz,faceLow),moment),area=extent[a]*extent[b]*pore*h2;
   double wetArea=area*fraction,faceY=fraction>0.0?faceLow.y+extent.y*moment.y/fraction:point;
   double pressure=basePressure+density*gravity()*size*(liquidY-faceY);value[7]+=wetArea;
   value[9+axis]-=(side==0?-1.0:1.0)*(pressure*wetArea+gasPressure(c)*(area-wetArea));
  }
 }
}
void main(){int lane=int(gl_LocalInvocationID.x),group=int(gl_WorkGroupID.x),id=128*group+lane;
 if(p.stage==0){double values[13];for(int i=0;i<13;i++)values[i]=0.0;
  if(id<p.count){ivec3 q=ivec3(h(3),h(4),h(5))+ivec3(id%h(6),id/h(6)%h(7),id/(h(6)*h(7)));sampleCell(cell(q),q,values);}
  for(int i=0;i<13;i++)sums[128*i+lane]=values[i];barrier();
  for(int stride=64;stride>0;stride>>=1){if(lane<stride)for(int i=0;i<13;i++)sums[128*i+lane]+=sums[128*i+lane+stride];barrier();}
  if(lane==0)for(int i=0;i<13;i++)store(96+26*group+2*i,sums[128*i]);return;
 }
 if(lane<13){double total=0.0,error=0.0;for(int g=0;g<p.groups;g++){double term=outvalue(96+26*g+2*lane)-error,next=total+term;error=(next-total)-term;total=next;}sums[lane]=total;}barrier();
 if(lane==0){double volume=sums[0];for(int i=0;i<13;i++){double value=volume>0.0?sums[i]:0.0;if(i>=1&&i<=6&&volume>0.0)value/=volume;store(64+2*i,value);}}
}
