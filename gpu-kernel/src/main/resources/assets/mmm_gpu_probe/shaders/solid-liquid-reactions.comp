#version 450
#extension GL_ARB_gpu_shader_fp64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_atomic_int64 : require
layout(local_size_x = 128) in;
layout(binding = 0, std430) buffer Arena {
    uint words[];
};
layout(binding = 1, std430) buffer Errors {
    uint errors;
};
layout(binding = 2, std430) buffer AtomicArena {
    int64_t integers[];
};
layout(push_constant) uniform Params {
    int header;
    int stage;
    int count;
    int padding;
    double duration;
}
p;
bool activeCell(int cell);
bool activeFace(int face);
// SPATIAL_GRID
// HOST_LAYOUT
const uint ERROR_INVALID_STATE = 536870912u;
const double MASS_UNIT_KG = 1e-10;
const int STAGE_INITIALIZE = 0;
const int STAGE_IMPORT_ROWS = 1;
const int STAGE_REACT_CELL = 2;
const int STAGE_MEASURE = 3;
const int STAGE_CAPACITY_STATUS = 4;
const int STAGE_SCATTER = 5;
const int STAGE_PUBLISH = 7;
const int STAGE_PHASE_FACE = 8;
const int STAGE_POST_MECHANICAL = 9;
const int STAGE_SNAPSHOT_SOLID = 10;
const int STAGE_PHASE_STATUS = 11;
const int STAGE_IMPORT_PENDING = 12;

const int64_t LIMIT = int64_t(0x7fffffffffffffffUL);
int headerWord(int i) {
    return int(words[p.header + i]);
}
int workField(int i) {
    return headerWord(WORK_FIELDS + i);
}
int liquidField(int i) {
    return headerWord(LIQUID_FIELDS + i);
}
int granularField(int i) {
    return headerWord(GRANULAR_FIELDS + i);
}
int progress(int i) {
    return headerWord(PROGRESS_FIELDS + i);
}
int definitionWord(int i) {
    return int(words[headerWord(H_DEFINITIONS) + i]);
}
int caloricHeaderWord(int kind, int i) {
    return int(words[headerWord(kind == 0 ? H_LIQUID_CALORIC : H_SOLID_CALORIC) + i]);
}
int64_t readInt64(int a) {
    return int64_t(uint64_t(words[a]) | (uint64_t(words[a + 1]) << 32));
}
void writeInt64(int a, int64_t q) {
    words[a] = uint(q);
    words[a + 1] = uint(uint64_t(q) >> 32);
}
double readDouble(int a) {
    return packDouble2x32(uvec2(words[a], words[a + 1]));
}
void writeDouble(int a, double q) {
    uvec2 b = unpackDouble2x32(q);
    words[a] = b.x;
    words[a + 1] = b.y;
}
void reportInvalid() {
    atomicOr(errors, ERROR_INVALID_STATE);
}
int64_t add(int64_t a, int64_t b) {
    if ((b > 0l && a > LIMIT - b) || (b < 0l && a < -LIMIT - b)) {
        reportInvalid();
        return 0l;
    }
    return a + b;
}
int64_t mass(int kind, int row) {
    return readInt64((kind == 0 ? workField(FIELD_LIQUID_MASS) : granularField(GRANULAR_MASS_UNITS)) + 2 * row);
}
int material(int kind, int row) {
    return int(words[(kind == 0 ? liquidField(LIQUID_MATERIALS) : granularField(GRANULAR_MATERIAL)) + row]);
}
int64_t species(int kind, int row, int s) {
    return readInt64(workField(kind == 0 ? FIELD_LIQUID_SPECIES : FIELD_SOLID_SPECIES) + 2 * (row * headerWord(H_SPECIES_COUNT) + s));
}
void speciesAt(int kind, int row, int s, int64_t q) {
    writeInt64(workField(kind == 0 ? FIELD_LIQUID_SPECIES : FIELD_SOLID_SPECIES) + 2 * (row * headerWord(H_SPECIES_COUNT) + s), q);
}
bool same(int a, int b) {
    return words[liquidField(LIQUID_SUPPORT_MASKS) + a] == words[liquidField(LIQUID_SUPPORT_MASKS) + b] &&
           words[workField(FIELD_PHASES) + int(words[liquidField(LIQUID_MATERIALS) + a])] ==
               words[workField(FIELD_PHASES) + int(words[liquidField(LIQUID_MATERIALS) + b])];
}
u64vec2 product(uint64_t a, uint64_t b) {
    uint64_t mask = uint64_t(0xffffffffu), a0 = a & mask, a1 = a >> 32, b0 = b & mask, b1 = b >> 32;
    uint64_t low = a0 * b0, t = a1 * b0 + (low >> 32), middle = (t & mask) + a0 * b1;
    return u64vec2((middle << 32) | (low & mask), a1 * b1 + (t >> 32) + (middle >> 32));
}
bool le(u64vec2 a, u64vec2 b) {
    return a.y < b.y || (a.y == b.y && a.x <= b.x);
}
int64_t portion(int64_t a, int64_t b, int64_t total) {
    if (a == 0l || b == 0l)
        return 0l;
    if (b == total)
        return a;
    uint64_t q = min(uint64_t(a), uint64_t(floor(double(a) * (double(b) / double(total)))));
    u64vec2 target = product(uint64_t(a), uint64_t(b));
    while (!le(product(q, uint64_t(total)), target))
        q--;
    while (q < uint64_t(a) && le(product(q + 1UL, uint64_t(total)), target))
        q++;
    return int64_t(q);
}
double rational(int at) {
    int ns = definitionWord(at + 1);
    if (ns == 0)
        return 0.0LF;
    int dp = at + 2 + ns, ds = definitionWord(dp + 1);
    double a = 0.0, b = 0.0;
    for (int i = max(0, ns - 2); i < ns; i++)
        a += ldexp(double(uint(words[headerWord(H_DEFINITIONS) + at + 2 + i])), 32 * (i - max(0, ns - 2)));
    for (int i = max(0, ds - 2); i < ds; i++)
        b += ldexp(double(uint(words[headerWord(H_DEFINITIONS) + dp + 2 + i])), 32 * (i - max(0, ds - 2)));
    return ldexp(a / b, 32 * (max(0, ns - 2) - max(0, ds - 2)));
}
double specificCold(int kind, int row) {
    int m = material(kind, row);
    return readDouble(caloricHeaderWord(kind, CAL_MATERIAL_REFERENCE) + 2 * m) + readDouble(caloricHeaderWord(kind, CAL_COLD_SENSIBLE) + 2 * m);
}
double reference(int kind, int row, int s) {
    return readDouble(caloricHeaderWord(kind, CAL_SPECIES_REFERENCE) + 2 * (material(kind, row) * caloricHeaderWord(kind, CAL_SPECIES_STRIDE) + s));
}

double cold(int kind, int row) {
    if (mass(kind, row) == 0l)
        return 0.0LF;
    double result=double(mass(kind,row))*MASS_UNIT_KG*specificCold(kind,row);

    for (int s = 0; s < headerWord(H_SPECIES_COUNT); s++) {
        int64_t speciesAmount = species(kind, row, s);
        if (speciesAmount != 0l)
            result += double(speciesAmount) * reference(kind, row, s);
    }
    return result;
}
double capacity(int kind, int row, double t) {
    int m = material(kind, row), at = int(words[caloricHeaderWord(kind, CAL_SEGMENT_OFFSETS) + m]),
        last = int(words[caloricHeaderWord(kind, CAL_SEGMENT_OFFSETS) + m + 1]) - 1;
    while (at < last && t >= readDouble(caloricHeaderWord(kind, CAL_SEGMENT_UPPER) + 2 * at))
        at++;
    return double(mass(kind,row))*MASS_UNIT_KG*readDouble(caloricHeaderWord(kind,CAL_SEGMENT_CAPACITY)+2*at);
}
double sensible(int kind, int row, double t) {
    int m = material(kind, row), at = int(words[caloricHeaderWord(kind, CAL_SEGMENT_OFFSETS) + m]),
        last = int(words[caloricHeaderWord(kind, CAL_SEGMENT_OFFSETS) + m + 1]) - 1;
    double lower = readDouble(headerWord(kind == 0 ? H_LIQUID_CALORIC : H_SOLID_CALORIC) + CAL_MINIMUM_TEMPERATURE), result = 0.0;
    for (; at <= last && lower < t; at++) {
        double upper = at == last ? t : min(t, readDouble(caloricHeaderWord(kind, CAL_SEGMENT_UPPER) + 2 * at));
        if (upper > lower) {
            result += (upper - lower) * readDouble(caloricHeaderWord(kind, CAL_SEGMENT_CAPACITY) + 2 * at);
            lower = upper;
        }
    }
    return double(mass(kind,row))*MASS_UNIT_KG*result;
}
// DYADIC_LIBRARY
uint dyadicWord(int bank, int at) {
    return words[at];
}
void dyadicWrite(int at, uint x) {
    words[at] = x;
}
void volumeTerms(int row, int64_t delta, out DyadicTerm items[7]) {
    for (int i = 0; i < 7; i++)
        items[i] = DyadicTerm(1, 0, 0, 0, 0);
    int begin = int(words[liquidField(LIQUID_VOLUME_OFFSETS) + row]), count = int(words[liquidField(LIQUID_VOLUME_COUNTS) + row]);
    items[0] = DyadicTerm(1, liquidField(LIQUID_VOLUME_LIMBS) + begin, count, int(words[liquidField(LIQUID_VOLUME_EXPONENTS) + row]),
                          count > 0 ? 1 : 0);
    if (delta != 0l) {
        u64vec2 q = product(uint64_t(abs(delta)), uint64_t(readInt64(p.header + H_VOLUME_SIGNIFICAND)));
        int at = workField(FIELD_DELTA_LIMBS) + 4 * row;
        words[at] = uint(q.x);
        words[at + 1] = uint(q.x >> 32);
        words[at + 2] = uint(q.y);
        words[at + 3] = uint(q.y >> 32);
        int count = q.y != 0UL ? (q.y >> 32 != 0UL ? 4 : 3) : (q.x >> 32 != 0UL ? 2 : 1);
        items[1] = DyadicTerm(1, at, count, headerWord(H_VOLUME_EXPONENT), delta > 0l ? 1 : -1);
    }
}
bool volumeFits(int row, int64_t delta) {
    DyadicTerm items[7];
    volumeTerms(row, delta, items);
    DyadicMeasure m = dyadicMeasure(items, 7);
    return m.status == DYADIC_POSITIVE || m.status == DYADIC_ZERO;
}
void initialize(int id) {
    if(id<headerWord(H_CELL_COUNT)*headerWord(H_MATERIAL_COUNT)*headerWord(H_SOLID_RULE_COUNT))words[workField(FIELD_PENDING_SLOTS)+id]=uint(-1);
    if (id < headerWord(H_CELL_COUNT)) {
        words[workField(FIELD_HEAD) + id] = uint(-1);
        words[workField(FIELD_PROPOSAL_HEAD) + id] = uint(-1);
        writeDouble(workField(FIELD_POTENTIAL_WORK) + 2 * id, 0.0LF);
    }
    if (id < headerWord(H_LIQUID_SLOTS)) {
        writeInt64(workField(FIELD_LIQUID_DELTA) + 2 * id, 0l);
        writeDouble(workField(FIELD_LIQUID_OLD_ENERGY) + 2 * id, 0.0LF);
        writeDouble(workField(FIELD_LIQUID_ENERGY) + 2 * id, 0.0LF);
    }
    if (id < headerWord(H_SOLID_CAPACITY)) {
        words[workField(FIELD_NEXT) + id] = uint(-1);
        words[workField(FIELD_CELL) + id] = uint(-1);
        writeDouble(workField(FIELD_SOLID_OLD_ENERGY) + 2 * id, 0.0LF);
        writeDouble(workField(FIELD_SOLID_NEW_ENERGY) + 2 * id, 0.0LF);
        writeDouble(workField(FIELD_SOLID_OLD_K) + 2 * id, 0.0LF);
        writeDouble(workField(FIELD_SOLID_NEW_K) + 2 * id, 0.0LF);
        words[workField(FIELD_SOLID_COUNTS) + id] = 0u;
        writeInt64(workField(FIELD_SOLID_SOURCE_MASS) + 2 * id, 0l);
        writeInt64(workField(FIELD_SOLID_WITHDRAWN_MASS) + 2 * id, 0l);
    }
    if (id == 0)
        for (int i = 0; i < 12; i++)
            words[workField(FIELD_CONTROL) + i] = 0u;
}
void importPending(int id){
    if(id>=int(words[progress(PROGRESS_PENDING_COUNT)]))return;
    int cell=int(words[progress(PROGRESS_PENDING_CELL)+id]),rule=int(words[progress(PROGRESS_PENDING_RULE)+id]),material=int(words[progress(PROGRESS_PENDING_MATERIAL)+id]);
    if(cell<0||cell>=headerWord(H_CELL_COUNT)||material<0||material>=headerWord(H_MATERIAL_COUNT)||rule<0||rule>=definitionWord(4))return;
    int localRule=rule-headerWord(H_SOLID_RULE_FIRST);
    if(localRule<0 || localRule>=headerWord(H_SOLID_RULE_COUNT))return;
    words[workField(FIELD_PENDING_SLOTS)+(cell*headerWord(H_MATERIAL_COUNT)+material)*headerWord(H_SOLID_RULE_COUNT)+localRule]=uint(id);
}
int pendingSlot(int cell,int rule,int material,int support){
    int at=workField(FIELD_PENDING_SLOTS)+(cell*headerWord(H_MATERIAL_COUNT)+material)*headerWord(H_SOLID_RULE_COUNT)+rule-headerWord(H_SOLID_RULE_FIRST),slot=int(words[at]);
    if(slot>=0){words[progress(PROGRESS_PENDING_MATERIAL)+slot]=uint(material);words[progress(PROGRESS_PENDING_SUPPORT)+slot]=uint(support);return slot;}
    uint next=atomicAdd(words[progress(PROGRESS_PENDING_COUNT)],1u);
    if(next>=uint(headerWord(H_PENDING_CAPACITY))){reportInvalid();return -1;}
    slot=int(next);words[at]=next;
    words[progress(PROGRESS_PENDING_CELL)+slot]=uint(cell);words[progress(PROGRESS_PENDING_RULE)+slot]=uint(rule);
    words[progress(PROGRESS_PENDING_MATERIAL)+slot]=uint(material);words[progress(PROGRESS_PENDING_SUPPORT)+slot]=uint(support);
    writeDouble(progress(PROGRESS_PENDING_SECONDS)+2*slot,0.0LF);writeDouble(progress(PROGRESS_RESIDUAL_MOLES)+2*slot,0.0LF);
    return slot;
}
void importRows(int row) {
    if (row < headerWord(H_SOLID_CAPACITY)) {
        for (int s = 0; s < headerWord(H_SPECIES_COUNT); s++)
            speciesAt(1, row, s, 0l);
        for (int at = int(words[granularField(GRANULAR_SPECIES_OFFSETS) + row]);
             at < int(words[granularField(GRANULAR_SPECIES_OFFSETS) + row + 1]); at++)
            speciesAt(1, row, int(words[granularField(GRANULAR_SPECIES_HANDLES) + at]),
                      readInt64(granularField(GRANULAR_SPECIES_AMOUNTS) + 2 * at));
        bool liveParticle = row < int(words[granularField(GRANULAR_COUNTS)]),
             deposit =
                 row >= headerWord(H_PARTICLE_CAPACITY) && row - headerWord(H_PARTICLE_CAPACITY) < int(words[granularField(GRANULAR_COUNTS) + 1]),
             audit = row >= headerWord(H_PARTICLE_CAPACITY) + headerWord(H_DEPOSIT_CAPACITY);
        if (liveParticle || deposit || audit) {
            writeDouble(workField(FIELD_SOLID_OLD_ENERGY) + 2 * row, readDouble(granularField(GRANULAR_INTERNAL_ENERGY) + 2 * row));
            writeDouble(workField(FIELD_SOLID_NEW_ENERGY) + 2 * row, readDouble(granularField(GRANULAR_INTERNAL_ENERGY) + 2 * row));
            writeInt64(workField(FIELD_SOLID_SOURCE_MASS) + 2 * row, mass(1, row));
        }
        if (!liveParticle && !deposit)
            return;
        int cell;
        if (liveParticle) {
            double size = readDouble(p.header + H_CELL_SIZE);
            ivec3 q = ivec3(floor(readDouble(granularField(GRANULAR_POSITION) + 6 * row) / size),
                            floor(readDouble(granularField(GRANULAR_POSITION) + 6 * row + 2) / size),
                            floor(readDouble(granularField(GRANULAR_POSITION) + 6 * row + 4) / size));
            cell = gridCell(q);
            if (cell < 0) { atomicOr(errors, ERROR_INVALID_STATE); return; }
        } else
            cell = int(words[granularField(GRANULAR_DEPOSIT_CELL) + row - headerWord(H_PARTICLE_CAPACITY)]);
        words[workField(FIELD_CELL) + row] = uint(cell);
        words[workField(FIELD_NEXT) + row] = atomicExchange(words[workField(FIELD_HEAD) + cell], uint(row));
        if (liveParticle) {
            double v2 = 0.0;
            for (int axis = 0; axis < 3; axis++) {
                double v = readDouble(granularField(GRANULAR_VELOCITY) + 6 * row + 2 * axis);
                v2 += v * v;
            }
            writeDouble(workField(FIELD_SOLID_OLD_K) + 2 * row, .5LF * double(mass(1, row)) * MASS_UNIT_KG * v2);
        }
    }
}
int64_t solidExtent(int row, int rule) {
    int64_t result = LIMIT;
    int start = definitionWord(rule + 12), count = definitionWord(rule + 13);
    for (int at = 0; at < count; at++)
        result = min(result, species(1, row, definitionWord(start + 2 * at)) / int64_t(definitionWord(start + 2 * at + 1)));
    return result == LIMIT ? 0l : result;
}
int selectedSolid(int c, int material, bool depositOnly) {
    int result = -1;
    for (int row = int(words[workField(FIELD_HEAD) + c]); row >= 0; row = int(words[workField(FIELD_NEXT) + row]))
        if ((!depositOnly || row >= headerWord(H_PARTICLE_CAPACITY)) && int(words[granularField(GRANULAR_MATERIAL) + row]) == material &&
            readInt64(granularField(GRANULAR_SOLID_VOLUME_SVQ) + 2 * row) > 0l && (result < 0 || row < result))
            result = row;
    return result;
}
double transferCold(int first, int end, int solid, int rule, int64_t batches, bool precip, int64_t totalMass) {
    int64_t extent = batches * readInt64(headerWord(H_DEFINITIONS) + rule + 3),
            moved = batches * readInt64(headerWord(H_DEFINITIONS) + definitionWord(rule + 14)), prefix = 0l;
    int sm = definitionWord(rule + 1);
    double result = double(moved) * MASS_UNIT_KG *
                    (readDouble(caloricHeaderWord(1, CAL_MATERIAL_REFERENCE) + 2 * sm) + readDouble(caloricHeaderWord(1, CAL_COLD_SENSIBLE) + 2 * sm));
    for (int row = first; row < end; row++)
        if (same(first, row)) {
            int64_t next = add(prefix, mass(0, row)),
                    part = portion(moved, next, totalMass) - portion(moved, prefix, totalMass);
            result -= double(part) * MASS_UNIT_KG * specificCold(0, row);
            prefix = next;
        }
    int side = definitionWord(rule + 10), terms = definitionWord(rule + 11);
    for (int t = 0; t < terms; t++) {
        int s = definitionWord(side + 2 * t), coefficient = definitionWord(side + 2 * t + 1);
        int64_t q = extent * int64_t(coefficient), weight = 0l;
        if (precip) {
            for (int row = first; row < end; row++)
                if (same(first, row))
                    weight += species(0, row, s);
        } else
            weight = totalMass;
        prefix = 0l;
        for (int row = first; row < end; row++)
            if (same(first, row)) {
                int64_t next = prefix + (precip ? species(0, row, s) : mass(0, row)),
                        part = portion(q, next, weight) - portion(q, prefix, weight);
                if (part > 0l) {
                    result -= double(part)*reference(0,row,s);

                }
                prefix = next;
            }
    }
    side = definitionWord(rule + 12);
    terms = definitionWord(rule + 13);
    for (int t = 0; t < terms; t++)
        result += double(extent * int64_t(definitionWord(side + 2 * t + 1))) *
                  readDouble(caloricHeaderWord(1, CAL_SPECIES_REFERENCE) + 2 * (sm * caloricHeaderWord(1, CAL_SPECIES_STRIDE) + definitionWord(side + 2 * t)));
    return precip ? result : -result;
}
int newDeposit(int c, int material) {
    int ordinal = int(atomicAdd(words[granularField(GRANULAR_COUNTS) + 1], 1u));
    atomicMax(words[workField(FIELD_CONTROL) + 1], uint(ordinal + 1));
    if (ordinal >= headerWord(H_DEPOSIT_CAPACITY)) {
        atomicMax(words[workField(FIELD_CONTROL)], 1u);
        return -1;
    }
    int row = headerWord(H_PARTICLE_CAPACITY) + ordinal;
    words[granularField(GRANULAR_MATERIAL) + row] = uint(material);
    writeInt64(granularField(GRANULAR_SOLID_VOLUME_SVQ) + 2 * row, 0l);
    writeInt64(granularField(GRANULAR_MASS_UNITS) + 2 * row, 0l);
    writeInt64(granularField(GRANULAR_MASS_RESIDUAL_UNITS) + 2 * row, 0l);
    writeDouble(granularField(GRANULAR_INTERNAL_ENERGY) + 2 * row, 0.0LF);
    words[granularField(GRANULAR_MIXTURE_PRESENT) + row] = 1u;
    words[granularField(GRANULAR_DEPOSIT_CELL) + ordinal] = uint(c);
    words[granularField(GRANULAR_DEPOSIT_POROSITY) + ordinal] = words[workField(FIELD_POROSITIES) + material];
    words[workField(FIELD_CELL) + row] = uint(c);
    words[workField(FIELD_NEXT) + row] = words[workField(FIELD_HEAD) + c];
    words[workField(FIELD_HEAD) + c] = uint(row);
    return row;
}
double centerY(int c) {
    return (double(gridPosition(c).y) + .5LF) * readDouble(p.header + H_CELL_SIZE);
}
dvec2 bed(int c) {
    double m = 0.0, bulk = 0.0;
    for (int row = int(words[workField(FIELD_HEAD) + c]); row >= 0; row = int(words[workField(FIELD_NEXT) + row]))
        if (row >= headerWord(H_PARTICLE_CAPACITY)) {
            m += double(mass(1, row)) * MASS_UNIT_KG;
            bulk +=
                double(readInt64(granularField(GRANULAR_SOLID_VOLUME_SVQ) + 2 * row)) /
                (1.0LF - double(uintBitsToFloat(words[granularField(GRANULAR_DEPOSIT_POROSITY) + row - headerWord(H_PARTICLE_CAPACITY)])));
        }
    return dvec2(m, bulk);
}
double bedY(int c, double bulk) {
    return (double(gridPosition(c).y) +
            .5LF * bulk * ldexp(double(readInt64(p.header + H_VOLUME_SIGNIFICAND)), headerWord(H_VOLUME_EXPONENT))) *
           readDouble(p.header + H_CELL_SIZE);
}
double potential(int c, double liquidMass) {
    dvec2 b = bed(c);
    double value = liquidMass * centerY(c) + b.x * bedY(c, b.y);
    for (int row = int(words[workField(FIELD_HEAD) + c]); row >= 0; row = int(words[workField(FIELD_NEXT) + row]))
        if (row < headerWord(H_PARTICLE_CAPACITY))
            value += double(mass(1, row)) * MASS_UNIT_KG * readDouble(granularField(GRANULAR_POSITION) + 6 * row + 2);
    return value * readDouble(p.header + H_GRAVITY);
}
double potentialWork(int c, int solid, int rule, int64_t batches, bool precip) {
    double moved = double(batches * readInt64(headerWord(H_DEFINITIONS) + definitionWord(rule + 14))) * MASS_UNIT_KG,
           gravity = readDouble(p.header + H_GRAVITY);
    if (!precip && solid < headerWord(H_PARTICLE_CAPACITY))
        return moved * gravity * (readDouble(granularField(GRANULAR_POSITION) + 6 * solid + 2) - centerY(c));
    dvec2 before = bed(c);
    double porosity =
        solid < 0 ? double(uintBitsToFloat(words[workField(FIELD_POROSITIES) + definitionWord(rule + 1)]))
                  : double(uintBitsToFloat(words[granularField(GRANULAR_DEPOSIT_POROSITY) + solid - headerWord(H_PARTICLE_CAPACITY)]));
    double change = double(batches * readInt64(headerWord(H_DEFINITIONS) + rule + 5)) / (1.0LF - porosity);
    dvec2 after = before + dvec2(precip ? moved : -moved, precip ? change : -change);
    return gravity *
           (before.x * bedY(c, before.y) - after.x * bedY(c, after.y) + (precip ? moved : -moved) * centerY(c));
}
void postLTE(int c, double energy) {
    int begin = c * headerWord(H_MATERIAL_COUNT), end = begin + headerWord(H_MATERIAL_COUNT);
    double baselineCold = 0.0;
    for (int row = begin; row < end; row++)
        baselineCold += cold(0, row);
    for (int row = int(words[workField(FIELD_HEAD) + c]); row >= 0; row = int(words[workField(FIELD_NEXT) + row]))
        baselineCold += cold(1, row);
    double temperature = readDouble(headerWord(H_LIQUID_CALORIC) + CAL_MINIMUM_TEMPERATURE), remaining = energy - baselineCold;
    if (remaining < 0.0LF) {
        reportInvalid();
        return;
    }
    for (;;) {
        double cv = 0.0, next = 1.7976931348623157e308;
        for (int kind = 0; kind < 2; kind++) {
            int row = kind == 0 ? begin : int(words[workField(FIELD_HEAD) + c]);
            for (; kind == 0 ? row < end : row >= 0; row = kind == 0 ? row + 1 : int(words[workField(FIELD_NEXT) + row]))
                if (mass(kind, row) > 0l) {
                    cv += capacity(kind, row, temperature);
                    int m = material(kind, row), at = int(words[caloricHeaderWord(kind, CAL_SEGMENT_OFFSETS) + m]),
                        last = int(words[caloricHeaderWord(kind, CAL_SEGMENT_OFFSETS) + m + 1]) - 1;
                    while (at < last && temperature >= readDouble(caloricHeaderWord(kind, CAL_SEGMENT_UPPER) + 2 * at))
                        at++;
                    if (at < last)
                        next = min(next, readDouble(caloricHeaderWord(kind, CAL_SEGMENT_UPPER) + 2 * at));
                }
        }
        if (cv <= 0.0)
            break;
        double cost = (next - temperature) * cv;
        if (next == 1.7976931348623157e308 || remaining < cost) {
            temperature += remaining / cv;
            break;
        }
        remaining -= cost;
        temperature = next;
    }
    for (int row = begin; row < end; row++)
        writeDouble(workField(FIELD_LIQUID_ENERGY) + 2 * row, mass(0, row) > 0l ? cold(0, row) + sensible(0, row, temperature) : 0.0LF);
    for (int row = int(words[workField(FIELD_HEAD) + c]); row >= 0; row = int(words[workField(FIELD_NEXT) + row]))
        writeDouble(granularField(GRANULAR_INTERNAL_ENERGY) + 2 * row, mass(1, row) > 0l ? cold(1, row) + sensible(1, row, temperature) : 0.0LF);
}
void cell(int c) {
    int begin = c * headerWord(H_MATERIAL_COUNT), end = begin + headerWord(H_MATERIAL_COUNT);
    int64_t oldMass = 0l;
    for (int row = begin; row < end; row++)
        oldMass = add(oldMass, readInt64(liquidField(LIQUID_MASS_UNITS) + 2 * row));
    int64_t gasMass = 0l;
    for (int component = 0; component < headerWord(H_GAS_COMPONENTS); component++)
        gasMass = add(gasMass, readInt64(headerWord(H_GAS_MASS) + 2 * (c * headerWord(H_GAS_COMPONENTS) + component)));
    writeInt64(workField(FIELD_CELL_OLD_MASS) + 2 * c, add(oldMass, gasMass));
    writeInt64(workField(FIELD_CELL_NEW_MASS) + 2 * c, add(oldMass, gasMass));
    double pe = potential(c, double(oldMass) * MASS_UNIT_KG);
    writeDouble(workField(FIELD_CELL_OLD_PE) + 2 * c, pe);
    writeDouble(workField(FIELD_CELL_NEW_PE) + 2 * c, pe);
    if (!activeCell(c) || begin == end)
        return;
    bool changed = false;
    double totalEnergy = 0.0;
    int64_t withdrawnMass = 0l;
    for (int row = begin; row < end; row++)
        totalEnergy += readDouble(workField(FIELD_LIQUID_ENERGY) + 2 * row);
    for (int row = int(words[workField(FIELD_HEAD) + c]); row >= 0; row = int(words[workField(FIELD_NEXT) + row]))
        totalEnergy += readDouble(granularField(GRANULAR_INTERNAL_ENERGY) + 2 * row);
    for (int first = begin; first < end; first++) {
        if (mass(0, first) <= 0l)
            continue;
        bool representative = true;
        for (int row = begin; row < first; row++)
            if (same(first, row)) {
                representative = false;
                break;
            }
        if (!representative)
            continue;
        int phase = int(words[workField(FIELD_PHASES) + int(words[liquidField(LIQUID_MATERIALS) + first])]);
        if (phase < 0)
            continue;
        for (int directory = 0; directory < definitionWord(4); directory++) {
            int entry = definitionWord(5) + 2 * directory;
            if (definitionWord(entry) != 1)
                continue;
            int rule = definitionWord(entry + 1);
            if (definitionWord(rule) != phase)
                continue;
            atomicAdd(words[workField(FIELD_CONTROL) + 4], 1u);
            int64_t totalMass = 0l, aqueous = LIMIT;
            double volume = 0.0;
            for (int row = first; row < end; row++)
                if (same(first, row)) {
                    totalMass = add(totalMass, mass(0, row));
                    volume += readDouble(liquidField(LIQUID_NUMERIC_VOLUMES) + 2 * row) +
                              double(readInt64(workField(FIELD_LIQUID_DELTA) + 2 * row)) *
                                  ldexp(double(readInt64(p.header + H_VOLUME_SIGNIFICAND)), headerWord(H_VOLUME_EXPONENT));
                }
            if (totalMass <= 0l || volume <= 0.0)
                continue;
            int terms = definitionWord(rule + 10), count = definitionWord(rule + 11);
            for (int t = 0; t < count; t++) {
                int s = definitionWord(terms + 2 * t);
                int64_t amount = 0l;
                for (int row = first; row < end; row++)
                    if (same(first, row))
                        amount = add(amount, species(0, row, s));
                aqueous = min(aqueous, amount / int64_t(definitionWord(terms + 2 * t + 1)));
            }
            double size = readDouble(p.header + H_CELL_SIZE),
                   capacity = rational(definitionWord(rule + 9)) * volume * size * size * size * 1e6LF;
            int solvent=definitionWord(rule+15);
            if(solvent<0)continue;
            if(solvent>=0){
                int definition=headerWord(H_DEFINITIONS)+rule;
                double temperature=readDouble(caloricHeaderWord(0,CAL_CELL_TEMPERATURES)+2*c);
                if(temperature<readDouble(definition+22)||temperature>readDouble(definition+24))continue;
                int64_t water=0l;for(int row=first;row<end;row++)if(same(first,row))water=add(water,species(0,row,solvent));
                double ratio=readDouble(definition+18)+readDouble(definition+20)*(temperature-readDouble(definition+16));
                capacity=double(water)*max(0.0LF,ratio)/double(definitionWord(terms+1));
            }
            int64_t saturation = capacity >= double(LIMIT) ? LIMIT : max(0l, int64_t(floor(capacity))),
                    desired = aqueous - saturation;
            bool precip = desired > 0l;
            if (desired == 0l || (precip && headerWord(H_PRECIPITATION_ENABLED) == 0) || (!precip && definitionWord(rule + 2) == 0))
                continue;
            int sm = definitionWord(rule + 1), solid = selectedSolid(c, sm, precip);
            if (!precip && solid < 0)
                continue;
            int64_t batchExtent = readInt64(headerWord(H_DEFINITIONS) + rule + 3),
                    batchVolume = readInt64(headerWord(H_DEFINITIONS) + rule + 5),
                    batchMass = readInt64(headerWord(H_DEFINITIONS) + definitionWord(rule + 14));
            // Spherical primary grains share one physical surface, independent of representative parcel count.
            double diameter=readDouble(workField(FIELD_MATERIAL_DIAMETER)+2*sm),solidVolume=0.0LF;
            for(int grain=int(words[workField(FIELD_HEAD)+c]);grain>=0;grain=int(words[workField(FIELD_NEXT)+grain]))
                if(int(words[granularField(GRANULAR_MATERIAL)+grain])==sm)
                    solidVolume+=double(max(0l,readInt64(granularField(GRANULAR_SOLID_VOLUME_SVQ)+2*grain)))*(1.0LF/16777216.0LF)*size*size*size;
            double area=diameter>0.0LF?6.0LF*solidVolume/diameter:0.0LF;
            // The diffusion film has thickness d/2; liquid wets only the area it can fill.
            double liquidVolume=volume*size*size*size;
            if(area>0.0LF)area*=min(1.0LF,liquidVolume/(area*diameter*0.5LF));
            if(precip && area==0.0LF)area=size*size*clamp(volume,0.0LF,1.0LF);
            if(!(area>0.0LF && diameter>0.0LF && p.duration>0.0LF))continue;
            int slot=pendingSlot(c,directory,int(words[liquidField(LIQUID_MATERIALS)+first]),int(words[liquidField(LIQUID_SUPPORT_MASKS)+first]));
            if(slot<0)return;
            // Molecular diffusion through a grain-scale film.
            double diffusivity=readDouble(headerWord(H_DEFINITIONS)+rule+26);
            double rateStep=2.0LF*diffusivity*area*p.duration/(diameter*volume*size*size*size);
            double transferFraction=rateStep<1e-4LF?rateStep*(1.0LF-rateStep*.5LF+rateStep*rateStep/6.0LF):1.0LF-double(exp(float(-rateStep)));
            double wanted=double(desired)*transferFraction+readDouble(progress(PROGRESS_RESIDUAL_MOLES)+2*slot)*1e6LF;
            if(wanted*double(desired)<=0.0LF){writeDouble(progress(PROGRESS_RESIDUAL_MOLES)+2*slot,wanted*1e-6LF);continue;}
            double pendingAmount=min(abs(wanted),double(abs(desired)));
            double requestedBatches=floor(pendingAmount/double(batchExtent));
            writeDouble(progress(PROGRESS_RESIDUAL_MOLES)+2*slot,(wanted<0.0LF?-pendingAmount:pendingAmount)*1e-6LF);
            int cursor=int(words[workField(FIELD_HEAD)+c]); bool precipDone=false;
            while(pendingAmount>=double(batchExtent)) {
                if(precip){if(precipDone)break;precipDone=true;}
                else {
                    while(cursor>=0 && (int(words[granularField(GRANULAR_MATERIAL)+cursor])!=sm ||
                        readInt64(granularField(GRANULAR_SOLID_VOLUME_SVQ)+2*cursor)<=0l))
                        cursor=int(words[workField(FIELD_NEXT)+cursor]);
                    if(cursor<0)break;
                    solid=cursor;cursor=int(words[workField(FIELD_NEXT)+cursor]);
                }
                requestedBatches=floor(pendingAmount/double(batchExtent));
                int64_t batches=min(abs(desired)/batchExtent,int64_t(min(double(LIMIT),requestedBatches)));
            if (precip) {
                batches = min(batches, min((totalMass - 1l) / batchMass, (oldMass - withdrawnMass) / batchMass));
                double svq = volume / ldexp(double(readInt64(p.header + H_VOLUME_SIGNIFICAND)), headerWord(H_VOLUME_EXPONENT));
                batches = min(batches, max(0l, int64_t(ceil(svq)) - 1l) / batchVolume);
            } else
                batches = min(batches, min(min(solidExtent(solid, rule) / batchExtent,
                                               readInt64(granularField(GRANULAR_SOLID_VOLUME_SVQ) + 2 * solid) / batchVolume),
                                           (readInt64(workField(FIELD_SOLID_SOURCE_MASS) + 2 * solid) -
                                            readInt64(workField(FIELD_SOLID_WITHDRAWN_MASS) + 2 * solid)) /
                                               batchMass));
            if (batches <= 0l) {
                words[progress(PROGRESS_DIRTY_CELLS) + c] = 1u;
                continue;
            }
            double baselineCold = 0.0;
            for (int row = begin; row < end; row++)
                baselineCold += cold(0, row);
            for (int row = int(words[workField(FIELD_HEAD) + c]); row >= 0; row = int(words[workField(FIELD_NEXT) + row]))
                baselineCold += cold(1, row);
            if (baselineCold + transferCold(first, end, solid, rule, batches, precip, totalMass) >
                totalEnergy + potentialWork(c, solid, rule, batches, precip)) {
                int64_t low = 0l, high = batches;
                while (low < high) {
                    int64_t middle = low + (high - low + 1l) / 2l;
                    if (baselineCold + transferCold(first, end, solid, rule, middle, precip, totalMass) <=
                        totalEnergy + potentialWork(c, solid, rule, middle, precip))
                        low = middle;
                    else
                        high = middle - 1l;
                }
                batches = low;
            }
            if (batches == 0l) {
                words[progress(PROGRESS_DIRTY_CELLS) + c] = 1u;
                continue;
            }
            int64_t movedMass = batches * batchMass, movedVolume = batches * batchVolume,
                    extent = batches * batchExtent, prefix = 0l;
            // Exact volume feasibility is checked before touching any source in this group.
            for (int row = first; row < end; row++)
                if (same(first, row)) {
                    int64_t next = prefix + mass(0, row),
                            part = portion(movedVolume, next, totalMass) - portion(movedVolume, prefix, totalMass);
                    if (!volumeFits(row, readInt64(workField(FIELD_LIQUID_DELTA) + 2 * row) + (precip ? -part : part))) {
                        batches = 0l;
                        break;
                    }
                    prefix = next;
                }
            if (batches == 0l) {
                words[progress(PROGRESS_DIRTY_CELLS) + c] = 1u;
                continue;
            }
            double physicalWork = potentialWork(c, solid, rule, batches, precip);
            pendingAmount-=double(batches*batchExtent);
            writeDouble(progress(PROGRESS_RESIDUAL_MOLES)+2*slot,(wanted<0.0LF?-1.0LF:1.0LF)*pendingAmount*1e-6LF);
            if (solid < 0) {
                solid = newDeposit(c, sm);
                if (solid < 0)
                    return;
            }
            int proposal = int(atomicAdd(words[workField(FIELD_CONTROL) + 7], 1u));
            if (proposal >= headerWord(H_PROPOSAL_CAPACITY)) {
                atomicMax(words[workField(FIELD_CONTROL)], 1u);
                return;
            }
            words[workField(FIELD_PROPOSAL_NEXT) + proposal] = words[workField(FIELD_PROPOSAL_HEAD) + c];
            words[workField(FIELD_PROPOSAL_HEAD) + c] = uint(proposal);
            double carried = 0.0;
            if (precip) {
                prefix = 0l;
                for (int row = first; row < end; row++)
                    if (same(first, row)) {
                        int64_t next = prefix + mass(0, row),
                                part = portion(movedMass, next, totalMass) - portion(movedMass, prefix, totalMass);
                        if (mass(0, row) > 0l)
                            carried += readDouble(workField(FIELD_LIQUID_ENERGY) + 2 * row) * (double(part) / double(mass(0, row)));
                        prefix = next;
                    }
            } else if (mass(1, solid) > 0l)
                carried =
                    readDouble(granularField(GRANULAR_INTERNAL_ENERGY) + 2 * solid) * (double(movedMass) / double(mass(1, solid)));
            terms = definitionWord(rule + 10);
            count = definitionWord(rule + 11);
            for (int t = 0; t < count; t++) {
                int s = definitionWord(terms + 2 * t);
                int64_t amount = extent * int64_t(definitionWord(terms + 2 * t + 1)), weight = precip ? 0l : totalMass;
                if (precip)
                    for (int row = first; row < end; row++)
                        if (same(first, row))
                            weight += species(0, row, s);
                prefix = 0l;
                for (int row = first; row < end; row++)
                    if (same(first, row)) {
                        int64_t next = prefix + (precip ? species(0, row, s) : mass(0, row)),
                                part = portion(amount, next, weight) - portion(amount, prefix, weight);
                        speciesAt(0, row, s, species(0, row, s) + (precip ? -part : part));
                        prefix = next;
                    }
            }
            terms = definitionWord(rule + 12);
            count = definitionWord(rule + 13);
            for (int t = 0; t < count; t++) {
                int s = definitionWord(terms + 2 * t);
                speciesAt(1, solid, s,
                          species(1, solid, s) + (precip ? 1l : -1l) * extent * int64_t(definitionWord(terms + 2 * t + 1)));
            }
            prefix = 0l;
            for (int row = first; row < end; row++)
                if (same(first, row)) {
                    int64_t old = mass(0, row), next = prefix + old,
                            part = portion(movedMass, next, totalMass) - portion(movedMass, prefix, totalMass),
                            v = portion(movedVolume, next, totalMass) - portion(movedVolume, prefix, totalMass);
                    writeInt64(workField(FIELD_LIQUID_MASS) + 2 * row, old + (precip ? -part : part));
                    writeInt64(workField(FIELD_LIQUID_DELTA) + 2 * row,
                              readInt64(workField(FIELD_LIQUID_DELTA) + 2 * row) + (precip ? -v : v));
                    prefix = next;
                }
            writeInt64(granularField(GRANULAR_MASS_UNITS) + 2 * solid, mass(1, solid) + (precip ? movedMass : -movedMass));
            writeInt64(granularField(GRANULAR_SOLID_VOLUME_SVQ) + 2 * solid,
                      readInt64(granularField(GRANULAR_SOLID_VOLUME_SVQ) + 2 * solid) + (precip ? movedVolume : -movedVolume));
            if (precip)
                withdrawnMass += movedMass;
            else
                writeInt64(workField(FIELD_SOLID_WITHDRAWN_MASS) + 2 * solid,
                          readInt64(workField(FIELD_SOLID_WITHDRAWN_MASS) + 2 * solid) + movedMass);
            words[progress(PROGRESS_SOURCE_KIND) + proposal] = uint(precip                           ? 0
                                                                    : solid < headerWord(H_PARTICLE_CAPACITY) ? 2
                                                                                                     : 3);
            words[progress(PROGRESS_SOURCE_ROW) + proposal] = uint(precip ? first : solid);
            writeInt64(progress(PROGRESS_MASS_DELTA) + 2 * proposal, precip ? movedMass : -movedMass);
            totalEnergy += physicalWork;
            writeDouble(workField(FIELD_POTENTIAL_WORK) + 2 * c, readDouble(workField(FIELD_POTENTIAL_WORK) + 2 * c) + physicalWork);
            atomicAdd(words[workField(FIELD_CONTROL) + 6], uint(batches));
            changed = true;
            words[progress(PROGRESS_DIRTY_CELLS) + c] = 1u;
            words[progress(PROGRESS_PHASE_MOTION_CELLS) + c] = 1u;
            atomicOr(words[progress(PROGRESS_PHASE_PENDING_SUMMARY)], 1u);
            if(!precip) totalMass=add(totalMass,movedMass);
            }
        }
    }
    int64_t finalMass = 0l;
    for (int row = begin; row < end; row++)
        finalMass = add(finalMass, mass(0, row));
    writeInt64(workField(FIELD_CELL_NEW_MASS) + 2 * c, add(finalMass, gasMass));
    writeDouble(workField(FIELD_CELL_NEW_PE) + 2 * c, potential(c, double(finalMass) * MASS_UNIT_KG));
    if (!changed)
        return;
    atomicAdd(words[workField(FIELD_CONTROL) + 5], 1u);
    postLTE(c, totalEnergy);
}
void measure(int row) {
    if (row >= headerWord(H_SOLID_CAPACITY))
        return;
    int count = 0;
    for (int s = 0; s < headerWord(H_SPECIES_COUNT); s++)
        if (species(1, row, s) > 0l)
            count++;
    words[workField(FIELD_SOLID_COUNTS) + row] = uint(count);
    if (row < int(words[granularField(GRANULAR_COUNTS)]) ||
        row >= headerWord(H_PARTICLE_CAPACITY) &&
            row - headerWord(H_PARTICLE_CAPACITY) < min(headerWord(H_DEPOSIT_CAPACITY), int(words[granularField(GRANULAR_COUNTS) + 1])) ||
        row >= headerWord(H_PARTICLE_CAPACITY) + headerWord(H_DEPOSIT_CAPACITY))
        writeDouble(workField(FIELD_SOLID_NEW_ENERGY) + 2 * row, readDouble(granularField(GRANULAR_INTERNAL_ENERGY) + 2 * row));
}
void capacityStatus() {
    int need = int(words[workField(FIELD_SOLID_OFFSETS) + headerWord(H_SOLID_CAPACITY)]);
    words[workField(FIELD_CONTROL) + 3] = uint(need);
    if (need > headerWord(H_SOLID_SPECIES_CAPACITY))
        atomicMax(words[workField(FIELD_CONTROL)], 1u);
    if (words[workField(FIELD_CONTROL)] == 0u)
        words[workField(FIELD_CONTROL)] = 2u;
}
void scatter(int row) {
    if (words[workField(FIELD_CONTROL)] != 2u || row >= headerWord(H_SOLID_CAPACITY))
        return;
    int at = int(words[workField(FIELD_SOLID_OFFSETS) + row]);
    for (int s = 0; s < headerWord(H_SPECIES_COUNT); s++) {
        int64_t speciesAmount = species(1, row, s);
        if (speciesAmount > 0l) {
            words[workField(FIELD_SOLID_HANDLES) + at] = uint(s);
            writeInt64(workField(FIELD_SOLID_AMOUNTS) + 2 * at, speciesAmount);
            at++;
        }
    }
}
void phaseStatus() {
    int base = int(words[headerWord(H_PHASE_ROWS_HEADER) + 8 + 19]);
    words[workField(FIELD_CONTROL) + 2] = words[base + 2];
    words[workField(FIELD_CONTROL) + 8] = words[base + 3];
    if (words[base] == 1u)
        words[workField(FIELD_CONTROL)] = 1u;
}
ivec3 shape() { return gridShape(); }
ivec3 axisUnit(int axis) { ivec3 q=ivec3(0);q[axis]=1;return q; }
int faceBase(int axis) { return gridFaceOffset(axis); }
int cellId(ivec3 q) { return gridCell(q); }
void faceCells(int id,out int axis,out int a,out int b) { ivec3 e=gridFaceEndpoints(id);a=e.x;b=e.y;axis=e.z; }
int cellFace(int c,int axis,int side) { return gridFace(c,2*axis+side); }
double oldMass(int c) {
    return c < 0 ? 0.0LF : double(readInt64(workField(FIELD_CELL_OLD_MASS) + 2 * c)) * MASS_UNIT_KG;
}
double newMass(int c) {
    return c < 0 ? 0.0LF : double(readInt64(workField(FIELD_CELL_NEW_MASS) + 2 * c)) * MASS_UNIT_KG;
}
double ambientFaceMass(int id, int a, int b) {
    return (a < 0 || b < 0) && headerWord(H_FACE_GEOMETRY) >= 0 && readDouble(headerWord(H_FACE_GEOMETRY) + 8 * id + 4) > 0.0LF
        ? double(readInt64(p.header + H_AMBIENT_MASS)) * MASS_UNIT_KG : 0.0LF;
}
double faceVelocity(int id, int axis, int a, int b) {
    double faceMass = .5LF * (oldMass(a) + oldMass(b) + ambientFaceMass(id, a, b));
    return faceMass > 0.0 ? readDouble(liquidField(16 + axis) + 2 * (id - faceBase(axis))) / faceMass : 0.0LF;
}
bool openFace(int id, int a, int b) {
    return headerWord(H_FACE_GEOMETRY) < 0 ? a >= 0 && b >= 0 : readDouble(headerWord(H_FACE_GEOMETRY) + 8 * id + 4) > 0.0;
}
double incomingVelocity(int proposal, int axis) {
    int kind = int(words[progress(PROGRESS_SOURCE_KIND) + proposal]),
        row = int(words[progress(PROGRESS_SOURCE_ROW) + proposal]);
    return kind == 2 ? readDouble(granularField(GRANULAR_VELOCITY) + 6 * row + 2 * axis) : 0.0LF;
}
void phaseFace(int id) {
    if (words[workField(FIELD_CONTROL)] != 2u)
        return;
    int axis, a, b;
    faceCells(id, axis, a, b);
    if (!activeFace(id)) {
        writeDouble(workField(FIELD_FACE_MOMENTUM) + 2 * id, readDouble(liquidField(16 + axis) + 2 * (id - faceBase(axis))));
        writeDouble(workField(FIELD_FACE_OLD_K) + 2 * id, 0.0LF);
        writeDouble(workField(FIELD_FACE_NEW_K) + 2 * id, 0.0LF);
        writeDouble(workField(FIELD_FACE_HEAT) + 4 * id, 0.0LF);
        writeDouble(workField(FIELD_FACE_HEAT) + 4 * id + 2, 0.0LF);
        return;
    }
    int cells[2] = int[2](a, b);
    double removed[2] = double[2](0.0LF, 0.0LF), incomingP = 0.0;
    double ambient = ambientFaceMass(id, a, b);
    double beforeMass = .5LF * (oldMass(a) + oldMass(b) + ambient), afterMass = .5LF * (newMass(a) + newMass(b) + ambient),
           before = faceVelocity(id, axis, a, b);
    for (int side = 0; side < 2; side++)
        if (cells[side] >= 0)
            for (int q = int(words[workField(FIELD_PROPOSAL_HEAD) + cells[side]]); q >= 0;
                 q = int(words[workField(FIELD_PROPOSAL_NEXT) + q])) {
                int64_t change = readInt64(progress(PROGRESS_MASS_DELTA) + 2 * q);
                double part = .5LF * double(abs(change)) * MASS_UNIT_KG;
                if (change > 0l)
                    removed[side] += part;
                else
                    incomingP += part * incomingVelocity(q, axis);
            }
    double remaining = max(0.0LF, beforeMass - removed[0] - removed[1]), momentum = remaining * before + incomingP;
    bool opened = openFace(id, a, b);
    double velocity = opened && afterMass > 0.0 ? momentum / afterMass : 0.0LF;
    if (!opened || afterMass == 0.0)
        momentum = 0.0LF;
    writeDouble(workField(FIELD_FACE_MOMENTUM) + 2 * id, momentum);
    writeDouble(workField(FIELD_FACE_OLD_K) + 2 * id, .5LF * beforeMass * before * before);
    writeDouble(workField(FIELD_FACE_NEW_K) + 2 * id, .5LF * afterMass * velocity * velocity);
    for (int side = 0; side < 2; side++) {
        int c = cells[side];
        double heat = 0.0;
        if (c >= 0) {
            double kept = max(0.0LF, .5LF * oldMass(c) - removed[side]), difference = before - velocity;
            heat = .5LF * (kept + .5LF * ambient) * difference * difference + .5LF * removed[side] * before * before;
            for (int q = int(words[workField(FIELD_PROPOSAL_HEAD) + c]); q >= 0; q = int(words[workField(FIELD_PROPOSAL_NEXT) + q])) {
                int64_t change = readInt64(progress(PROGRESS_MASS_DELTA) + 2 * q);
                if (change < 0l) {
                    difference = incomingVelocity(q, axis) - velocity;
                    heat += .25LF * double(-change) * MASS_UNIT_KG * difference * difference;
                }
            }
        }
        writeDouble(workField(FIELD_FACE_HEAT) + 4 * id + 2 * side, heat);
    }
}
void postMechanical(int c) {
    if (!activeCell(c))
        return;
    if (words[workField(FIELD_CONTROL)] != 2u)
        return;
    double heat = 0.0;
    dvec3 impulse = dvec3(0);
    for (int axis = 0; axis < 3; axis++)
        for (int side = 0; side < 2; side++) {
            int id = cellFace(c, axis, side), component, a, b;
            faceCells(id, component, a, b);
            heat += readDouble(workField(FIELD_FACE_HEAT) + 4 * id + 2 * (side == 0 ? 1 : 0));
            double before = faceVelocity(id, axis, a, b), removed = 0.0, incomingP = 0.0;
            for (int q = int(words[workField(FIELD_PROPOSAL_HEAD) + c]); q >= 0; q = int(words[workField(FIELD_PROPOSAL_NEXT) + q])) {
                int64_t change = readInt64(progress(PROGRESS_MASS_DELTA) + 2 * q);
                if (change > 0l)
                    removed += .5LF * double(change) * MASS_UNIT_KG;
                else
                    incomingP += .5LF * double(-change) * MASS_UNIT_KG * incomingVelocity(q, axis);
            }
            impulse[axis] += removed * before;
            if (!openFace(id, a, b))
                impulse[axis] += max(0.0LF, .5LF * oldMass(c) - removed) * before + incomingP;
        }
    for (int axis = 0; axis < 3; axis++)
        writeDouble(workField(FIELD_WALL_IMPULSE) + 6 * c + 2 * axis, impulse[axis]);
    if (heat > 0.0) {
        double energy = heat;
        for (int r = int(words[liquidField(LIQUID_CELL_OFFSETS) + c]); r < int(words[liquidField(LIQUID_CELL_OFFSETS) + c + 1]); r++)
            energy += readDouble(workField(FIELD_LIQUID_ENERGY) + 2 * r);
        for (int r = int(words[workField(FIELD_HEAD) + c]); r >= 0; r = int(words[workField(FIELD_NEXT) + r]))
            energy += readDouble(granularField(GRANULAR_INTERNAL_ENERGY) + 2 * r);
        postLTE(c, energy);
    }
}
void snapshotSolid(int row) {
    if (words[workField(FIELD_CONTROL)] != 2u)
        return;
    bool liveParticle = row < int(words[granularField(GRANULAR_COUNTS)]),
         deposit = row >= headerWord(H_PARTICLE_CAPACITY) &&
                   row - headerWord(H_PARTICLE_CAPACITY) < min(headerWord(H_DEPOSIT_CAPACITY), int(words[granularField(GRANULAR_COUNTS) + 1])),
         audit = row >= headerWord(H_PARTICLE_CAPACITY) + headerWord(H_DEPOSIT_CAPACITY);
    if (liveParticle || deposit || audit)
        writeDouble(workField(FIELD_SOLID_NEW_ENERGY) + 2 * row, readDouble(granularField(GRANULAR_INTERNAL_ENERGY) + 2 * row));
    if (liveParticle) {
        double v2 = 0.0;
        for (int axis = 0; axis < 3; axis++) {
            double v = readDouble(granularField(GRANULAR_VELOCITY) + 6 * row + 2 * axis);
            v2 += v * v;
        }
        writeDouble(workField(FIELD_SOLID_NEW_K) + 2 * row, .5LF * double(mass(1, row)) * MASS_UNIT_KG * v2);
    }
}
void publish(int id) {
    if (words[workField(FIELD_CONTROL)] != 2u)
        return;
    if (id < headerWord(H_FACE_COUNT)) {
        int axis = id < faceBase(1) ? 0 : id < faceBase(2) ? 1 : 2;
        writeDouble(liquidField(16 + axis) + 2 * (id - faceBase(axis)), readDouble(workField(FIELD_FACE_MOMENTUM) + 2 * id));
    }
    if (id <= headerWord(H_SOLID_CAPACITY))
        words[granularField(GRANULAR_SPECIES_OFFSETS) + id] = words[workField(FIELD_SOLID_OFFSETS) + id];
    if (id < int(words[workField(FIELD_SOLID_OFFSETS) + headerWord(H_SOLID_CAPACITY)])) {
        words[granularField(GRANULAR_SPECIES_HANDLES) + id] = words[workField(FIELD_SOLID_HANDLES) + id];
        writeInt64(granularField(GRANULAR_SPECIES_AMOUNTS) + 2 * id, readInt64(workField(FIELD_SOLID_AMOUNTS) + 2 * id));
    }
    if (id < headerWord(H_SOLID_CAPACITY)) {
        int64_t sm = 0l;
        for (int s = 0; s < headerWord(H_SPECIES_COUNT); s++) {
            int64_t speciesAmount = species(1, id, s);
            if (speciesAmount > 0l) {
                int64_t unit = readInt64(headerWord(H_DEFINITIONS) + definitionWord(1) + 5 * s + 1);
                if (unit > 0l && speciesAmount > LIMIT / unit) {
                    reportInvalid();
                    return;
                }
                sm = add(sm, speciesAmount * unit);
            }
        }
        writeInt64(granularField(GRANULAR_MASS_RESIDUAL_UNITS) + 2 * id, mass(1, id) - sm);
        if (words[workField(FIELD_SOLID_COUNTS) + id] > 0u)
            words[granularField(GRANULAR_MIXTURE_PRESENT) + id] = 1u;
    }
    if (id == 0)
        words[granularField(GRANULAR_COUNTS) + 2] = words[workField(FIELD_SOLID_OFFSETS) + headerWord(H_SOLID_CAPACITY)];
}
bool activeCell(int cell) {
    return headerWord(H_ACTIVITY_CELLS) < 0 || words[headerWord(H_ACTIVITY_CELLS) + cell] != 0u;
}
bool activeFace(int face) {
    return headerWord(H_ACTIVITY_FACES) < 0 || words[headerWord(H_ACTIVITY_FACES) + face] != 0u;
}
void main() {
    int id = int((gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x) * 128u + gl_LocalInvocationID.x);
    if (id >= p.count)
        return;
    if (p.stage == STAGE_INITIALIZE) {
        initialize(id);
        return;
    }
    if (errors != 0u)
        return;
    if (p.stage == STAGE_IMPORT_PENDING)
        importPending(id);
    else if (p.stage == STAGE_IMPORT_ROWS)
        importRows(id);
    else if (p.stage == STAGE_REACT_CELL)
        cell(id);
    else if (p.stage == STAGE_MEASURE)
        measure(id);
    else if (p.stage == STAGE_CAPACITY_STATUS)
        capacityStatus();
    else if (p.stage == STAGE_SCATTER)
        scatter(id);
    else if (p.stage == STAGE_PUBLISH)
        publish(id);
    else if (p.stage == STAGE_PHASE_FACE)
        phaseFace(id);
    else if (p.stage == STAGE_POST_MECHANICAL)
        postMechanical(id);
    else if (p.stage == STAGE_SNAPSHOT_SOLID)
        snapshotSolid(id);
    else if (p.stage == STAGE_PHASE_STATUS)
        phaseStatus();
}
