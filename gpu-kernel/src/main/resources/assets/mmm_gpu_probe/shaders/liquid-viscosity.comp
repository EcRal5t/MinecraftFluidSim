#version 450
#extension GL_ARB_gpu_shader_fp64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
layout(local_size_x=128) in;
layout(binding=0,std430) readonly buffer Source {uint source[];};
layout(binding=1,std430) buffer Candidate {uint words[];};
layout(binding=2,std430) buffer Errors {uint errors;};
layout(push_constant) uniform Params {int header;int stage;int colour;int count;double h;double dt;} p;
const int MU=0,CARRIER=1,EXTRAP=2,WALL_AREA=3,STRESS_HEAT=4,WALL_HEAT=5,CONTACT_HEAT=6,CONTACT_WORK=7,
 CELL_HEAT=8,CELL_WORK=9,SOURCE_V=10,SOURCE_K=11,FINAL_K=12,FIXED_IMPULSE=13,WALL_IMPULSE=14,
 BODY_IMPULSE=15,BODY_WORK=16,MAT_OFFSETS=17,SEGMENTS=18;
int h(int i){return int(words[p.header+i]);}int at(int field){return h(48+field);}int stockField(int f){return h(24+f);}
int n(){return h(3);}ivec3 shape(){return ivec3(h(0),h(1),h(2));}
double num(int a){return packDouble2x32(uvec2(words[a],words[a+1]));}
double oldNum(int a){return packDouble2x32(uvec2(source[a],source[a+1]));}
void store(int a,double value){if(isnan(value)||isinf(value))atomicOr(errors,32768u);uvec2 bits=unpackDouble2x32(value);words[a]=bits.x;words[a+1]=bits.y;}
double read(int field,int i){return num(at(field)+2*i);}void write(int field,int i,double value){store(at(field)+2*i,value);}
void add(int field,int i,double value){write(field,i,read(field,i)+value);}
int get(int field,int i){return int(words[at(field)+i]);}void put(int field,int i,int value){words[at(field)+i]=uint(value);}
double cell(int c,int field){return c<0?0.0:num(h(5)+2*(4*c+field));}
double face(int f,int field){return num(h(6)+2*(4*f+field));}
void velocity(int f,double value){store(h(6)+2*(4*f+1),value);}
bool inside(ivec3 c){return all(greaterThanEqual(c,ivec3(0)))&&all(lessThan(c,shape()));}
int index(ivec3 c){return inside(c)?(c.z*h(1)+c.y)*h(0)+c.x:-1;}
ivec3 position(int c){return ivec3(c%h(0),c/h(0)%h(1),c/(h(0)*h(1)));}
int xFaces(){return (h(0)+1)*h(1)*h(2);}int yFaces(){return h(0)*(h(1)+1)*h(2);}
int axisOf(int f){return f<xFaces()?0:f<xFaces()+yFaces()?1:2;}
int faceAt(ivec3 c,int axis){ivec3 dims=shape();dims[axis]++;return (axis==0?0:axis==1?xFaces():xFaces()+yFaces())+(c.z*dims.y+c.y)*dims.x+c.x;}
ivec2 faceCells(int f){int axis=axisOf(f),local=f-(axis==0?0:axis==1?xFaces():xFaces()+yFaces());ivec3 dims=shape();dims[axis]++;
 ivec3 b=ivec3(local%dims.x,local/dims.x%dims.y,local/(dims.x*dims.y)),a=b;a[axis]--;return ivec2(index(a),index(b));}
bool wet(int c){return c>=0&&cell(c,0)>0.0&&cell(c,1)>0.0;}
bool enabled(int f){return f>=0&&face(f,0)>0.0&&face(f,2)>0.0&&(h(9)<0||words[h(9)+f]!=0u);}
bool solid(ivec3 micro){ivec3 dims=2*shape();if(any(lessThan(micro,ivec3(0)))||any(greaterThanEqual(micro,dims)))return true;
 int c=index(micro/2),bit=(micro.x&1)+2*(micro.y&1)+4*(micro.z&1);return (words[h(7)+c]&(1u<<bit))!=0u;}
double harmonic(double a,double b){double lo=min(a,b),hi=max(a,b);return lo/(.5+.5*lo/hi);}
// Exact local exponential damping, evaluated in double precision without float exp.
double blend(double x){
 if(x<1e-4)return x*(1.0-x*(.5-x*(1.0/6.0-x*(1.0/24.0-x/120.0))));
 if(x>745.0)return 1.0;int e=int(round(-x/0.6931471805599453094LF));double r=-x-double(e)*0.6931471805599453094LF,t=1.0,sum=1.0;
 for(int k=1;k<=18;k++){t*=r/double(k);sum+=t;}return 1.0-ldexp(sum,e);
}
void prepareCell(int c){
 write(CELL_HEAT,c,0.0);write(CELL_WORK,c,0.0);write(MU,c,0.0);put(CARRIER,c,-1);put(EXTRAP,c,0);
 for(int a=0;a<3;a++){write(WALL_AREA,3*c+a,0.0);write(FIXED_IMPULSE,3*c+a,0.0);write(STRESS_HEAT,3*c+a,0.0);write(STRESS_HEAT,3*n()+3*c+a,0.0);}
 if(!wet(c))return;
 int first=int(source[stockField(1)+c]),last=int(source[stockField(1)+c+1]),material=-1;double largest=-1.0;
 for(int row=first;row<last;row++){double volume=oldNum(stockField(15)+2*row);if(volume>largest){largest=volume;material=int(source[stockField(2)+row]);}}
 if(material<0||material>=h(11)){atomicOr(errors,32768u);return;}
 double temperature=num(h(8)+2*c);int begin=get(MAT_OFFSETS,material),end=get(MAT_OFFSETS,material+1),segment=begin;
 if(begin==end||!(temperature>0.0)){atomicOr(errors,32768u);return;}
 put(EXTRAP,c,temperature<read(SEGMENTS,4*begin)||temperature>read(SEGMENTS,4*(end-1)+1)?1:0);
 while(segment+1<end&&temperature>read(SEGMENTS,4*segment+1))segment++;
 double lo=read(SEGMENTS,4*segment),hi=read(SEGMENTS,4*segment+1),t=clamp((temperature-lo)/(hi-lo),0.0,1.0);
 double mu=mix(read(SEGMENTS,4*segment+2),read(SEGMENTS,4*segment+3),t);write(MU,c,mu);put(CARRIER,c,material);
 ivec3 base=2*position(c);dvec3 area=dvec3(0.0);
 if(h(10)!=0)for(int bit=0;bit<8;bit++)if((words[h(7)+c]&(1u<<bit))==0u){ivec3 m=base+ivec3(bit&1,(bit>>1)&1,(bit>>2)&1);
  for(int a=0;a<3;a++){ivec3 e=ivec3(0);e[a]=1;area[a]+=(solid(m-e)?.25:0.0)+(solid(m+e)?.25:0.0);}}
 for(int a=0;a<3;a++)write(WALL_AREA,3*c+a,area[a]);
}
void prepareFace(int f){double v=face(f,1);write(SOURCE_V,f,v);write(SOURCE_K,f,.5*face(f,0)*v*v);
 write(WALL_HEAT,f,0.0);write(WALL_IMPULSE,f,0.0);write(CONTACT_HEAT,f,0.0);write(CONTACT_WORK,f,0.0);}
void strain(int owner,int row,ivec4 ids,dvec4 coefficients,double conductance){
 if(!(conductance>0.0))return;double rate=0.0,inverse=0.0;dvec3 fixedCoefficients=dvec3(0.0);
 for(int i=0;i<4;i++)if(enabled(ids[i])){double b=coefficients[i];rate+=b*face(ids[i],1);inverse+=b*b/face(ids[i],0);fixedCoefficients[axisOf(ids[i])]+=b;}
 if(inverse==0.0||rate==0.0)return;double impulse=blend(p.dt*conductance*inverse)*rate/inverse;
 add(STRESS_HEAT,row,max(0.0,impulse*(rate-.5*impulse*inverse)));
 for(int i=0;i<4;i++)if(enabled(ids[i]))velocity(ids[i],face(ids[i],1)-impulse*coefficients[i]/face(ids[i],0));
 for(int a=0;a<3;a++)add(FIXED_IMPULSE,3*owner+a,impulse*fixedCoefficients[a]);
}
void normal(int c){if(!wet(c))return;int axis=p.colour/2;if((position(c)[axis]&1)!=(p.colour&1))return;
 ivec3 pos=position(c),e=ivec3(0);e[axis]=1;
 strain(c,3*c+axis,ivec4(faceAt(pos+e,axis),faceAt(pos,axis),-1,-1),dvec4(1,-1,0,0),2.0*read(MU,c)*p.h*min(cell(c,0),cell(c,2)));
}
ivec2 shearAxes(int pair){return pair==0?ivec2(0,1):pair==1?ivec2(0,2):ivec2(1,2);}
void shear(int c){int code=p.colour-6,pair=code/4;ivec2 ab=shearAxes(pair);ivec3 pos=position(c),ea=ivec3(0),eb=ivec3(0);ea[ab.x]=1;eb[ab.y]=1;
 if((pos[ab.x]&1)!=((code%4)&1)||(pos[ab.y]&1)!=((code%4)>>1))return;
 ivec4 cells=ivec4(index(pos-ea-eb),index(pos-ea),index(pos-eb),c);for(int i=0;i<4;i++)if(!wet(cells[i]))return;
 ivec4 ids=ivec4(faceAt(pos,ab.x),faceAt(pos-eb,ab.x),faceAt(pos,ab.y),faceAt(pos-ea,ab.y));double area=1.0;
 for(int i=0;i<4;i++)area=min(area,enabled(ids[i])?face(ids[i],2):0.0);if(area==0.0)return;
 double mu=harmonic(harmonic(read(MU,cells.x),read(MU,cells.y)),harmonic(read(MU,cells.z),read(MU,cells.w)));
 strain(c,3*n()+3*c+pair,ids,dvec4(1,-1,1,-1),mu*p.h*area);
}
double wallConductance(int c,int tangent){if(!wet(c)||h(10)==0)return 0.0;double area=0.0;for(int a=0;a<3;a++)if(a!=tangent)area+=read(WALL_AREA,3*c+a);
 return read(MU,c)*p.h*area/min(cell(c,0),cell(c,2));}
void wall(int f){if(!enabled(f))return;ivec2 cells=faceCells(f);int axis=axisOf(f);double conductance=wallConductance(cells.x,axis)+wallConductance(cells.y,axis),v=face(f,1),mass=face(f,0);
 if(conductance==0.0||v==0.0)return;double impulse=mass*blend(p.dt*conductance/mass)*v;
 velocity(f,v-impulse/mass);add(WALL_HEAT,f,max(0.0,impulse*(v-.5*impulse/mass)));add(WALL_IMPULSE,f,impulse);
}
void prescribed(int f){
 if(h(12)>=0){int first=int(words[h(12)+f]),last=int(words[h(12)+f+1]);
  if(first<0||last<first||last>h(16)){atomicOr(errors,32768u);return;}
  ivec2 cells=faceCells(f);double mu=0.0,samples=0.0;for(int i=0;i<2;i++)if(wet(cells[i])){mu+=read(MU,cells[i]);samples++;}
  for(int contact=first;contact<last;contact++){
   if(!enabled(f)||samples==0.0)continue;
   int body=int(words[h(13)+contact]);double distance=num(h(14)+2*contact);if(body<0||body>=h(17)||distance<0.0){atomicOr(errors,32768u);continue;}
   double target=num(h(15)+2*(3*body+axisOf(f))),before=face(f,1),mass=face(f,0),conductance=mu/samples*distance;
   double after=before+blend(p.dt*conductance/mass)*(target-before),delta=after-before,impulse=mass*delta,work=target*impulse;
   velocity(f,after);write(BODY_IMPULSE,contact,-impulse);write(BODY_WORK,contact,work);
   add(CONTACT_WORK,f,work);add(CONTACT_HEAT,f,max(0.0,impulse*(target-before-.5*delta)));
  }
 }
 double v=face(f,1);write(FINAL_K,f,.5*face(f,0)*v*v);
}
void gather(int c){if(!wet(c))return;double heat=0.0,work=0.0;ivec3 pos=position(c);
 for(int a=0;a<3;a++)heat+=read(STRESS_HEAT,3*c+a);
 for(int pair=0;pair<3;pair++){ivec2 ab=shearAxes(pair);for(int corner=0;corner<4;corner++){ivec3 edge=pos;edge[ab.x]+=corner&1;edge[ab.y]+=(corner>>1)&1;int owner=index(edge);if(owner>=0)heat+=.25*read(STRESS_HEAT,3*n()+3*owner+pair);}}
 for(int side=0;side<6;side++){
  int axis=side/2;ivec3 fp=pos;if((side&1)!=0)fp[axis]++;int f=faceAt(fp,axis);ivec2 adjacent=faceCells(f);
  double conductance=wallConductance(adjacent.x,axis)+wallConductance(adjacent.y,axis);
  if(conductance>0.0)heat+=read(WALL_HEAT,f)*wallConductance(c,axis)/conductance;
  double ma=cell(adjacent.x,1),mb=cell(adjacent.y,1),first=ma+mb>0.0?ma/(ma+mb):0.0;
  double faceHeat=read(CONTACT_HEAT,f),faceWork=read(CONTACT_WORK,f);
  heat+=adjacent.x==c?faceHeat*first:faceHeat-faceHeat*first;work+=adjacent.x==c?faceWork*first:faceWork-faceWork*first;
 }
 write(CELL_HEAT,c,heat);write(CELL_WORK,c,work);
}
void main(){int id=int((gl_WorkGroupID.y*gl_NumWorkGroups.x+gl_WorkGroupID.x)*128u+gl_LocalInvocationID.x);if(id>=p.count||errors!=0u)return;
 if(p.stage==0)prepareCell(id);else if(p.stage==1)prepareFace(id);else if(p.stage==2){if(p.colour<6)normal(id);else if(p.colour<18)shear(id);else wall(id);}
 else if(p.stage==3)prescribed(id);else if(p.stage==4)gather(id);else if(p.stage==5){write(BODY_IMPULSE,id,0.0);write(BODY_WORK,id,0.0);}
}
