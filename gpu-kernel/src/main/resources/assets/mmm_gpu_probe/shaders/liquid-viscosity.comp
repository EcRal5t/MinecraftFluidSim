#version 450
#extension GL_ARB_gpu_shader_fp64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
layout(local_size_x = 128) in;
layout(binding = 0, std430) readonly buffer Source {
    uint source[];
};
layout(binding = 1, std430) buffer Candidate {
    uint words[];
};
layout(binding = 2, std430) buffer Errors {
    uint errors;
};
layout(constant_id=0) const int pipelineStage=0;
layout(push_constant) uniform Params {
    int header;
    int alignment;
    int reserved;
    int count;
    double h;
    double dt;
}
p;
// HOST_LAYOUT
// SPATIAL_GRID
// SERIES_CONDUCTANCE_LIBRARY
const int GEOMETRY_RECORD_STRIDE = 4;
const int VISCOSITY_SEGMENT_STRIDE = 4;
const int SEGMENT_MIN_TEMPERATURE = 0;
const int SEGMENT_MAX_TEMPERATURE = 1;
const int SEGMENT_MIN_VISCOSITY = 2;
const int SEGMENT_MAX_VISCOSITY = 3;
const uint INVALID_VISCOSITY_ERROR = 32768u;
const int CELL_VOLUME = 0;
const int CELL_MASS = 1;
const int CELL_CAPACITY = 2;
const int FACE_MASS = 0;
const int FACE_VELOCITY = 1;
const int FACE_OPEN_AREA = 2;
const int FACE_LIQUID_AREA = 3;
// Header and field offsets are 32-bit words. Candidate values use binary64 pairs.
int headerWord(int field) {
    return int(words[p.header + field]);
}
int fieldOffset(int field) {
    return headerWord(WORK_FIELDS + field);
}
int stockField(int field) {
    return headerWord(STOCK_FIELDS + field);
}
int cellCount() {
    return headerWord(H_CELL_COUNT);
}

double candidateDouble(int address) {
    return packDouble2x32(uvec2(words[address], words[address + 1]));
}
double sourceDouble(int address) {
    return packDouble2x32(uvec2(source[address], source[address + 1]));
}
void writeCandidateDouble(int address, double value) {
    if (isnan(value) || isinf(value))
        atomicOr(errors, INVALID_VISCOSITY_ERROR);
    uvec2 bits = unpackDouble2x32(value);
    words[address] = bits.x;
    words[address + 1] = bits.y;
}
double readDoubleField(int field, int index) {
    return candidateDouble(fieldOffset(field) + 2 * index);
}
void writeDoubleField(int field, int index, double value) {
    writeCandidateDouble(fieldOffset(field) + 2 * index, value);
}
int readIntField(int field, int index) {
    return int(words[fieldOffset(field) + index]);
}
void writeIntField(int field, int index, int value) {
    words[fieldOffset(field) + index] = uint(value);
}

// Cell and MAC face geometry each occupy four doubles per element; velocity is m/s.
double cellValue(int cellIndex, int field) {
    return cellIndex < 0 ? 0.0 : candidateDouble(headerWord(H_CELLS) + 2 * (GEOMETRY_RECORD_STRIDE * cellIndex + field));
}
double faceValue(int faceIndex, int field) {
    return candidateDouble(headerWord(H_FACES) + 2 * (GEOMETRY_RECORD_STRIDE * faceIndex + field));
}
void writeFaceVelocity(int faceIndex, double value) {
    writeCandidateDouble(headerWord(H_FACES) + 2 * (GEOMETRY_RECORD_STRIDE * faceIndex + FACE_VELOCITY), value);
}
int cellIndex(ivec3 c) {
    return gridCell(c);
}
ivec3 cellPosition(int c) {
    return gridPosition(c);
}
int axisOf(int f) {
    return gridFaceEndpoints(f).z;
}
int faceAt(ivec3 c, int axis) {
    return gridFaceAt(c,axis);
}
ivec2 faceCells(int f) {
    return gridFaceEndpoints(f).xy;
}
bool liquidGeometry(int c) {
    return c >= 0 && (headerWord(H_ACTIVITY_CELLS) < 0 || words[headerWord(H_ACTIVITY_CELLS) + c] != 0u) && cellValue(c, CELL_VOLUME) > 0.0;
}
bool wet(int c) {
    return liquidGeometry(c) && readDoubleField(FIELD_MU, c) > 0.0LF;
}
bool enabled(int f) {
    return f >= 0 && faceValue(f, FACE_MASS) > 0.0 && faceValue(f, FACE_OPEN_AREA) > 0.0 && (headerWord(H_ACTIVITY) < 0 || words[headerWord(H_ACTIVITY) + f] != 0u);
}
double harmonic(double a, double b) {
    return a == 0.0LF || b == 0.0LF ? 0.0LF : seriesConductance(2.0LF,a,1.0LF,b,1.0LF);
}
// Horizontal bed and free space act in parallel; vertical flow crosses them in series.
// A fully covered cell has Kozeny-Carman permeability k = d² phi³ / (180 (1-phi)²).
dvec3 bedConductance(int cell, double mu) {
    int offsets=headerWord(H_BED_OFFSETS);
    if(offsets<0)return dvec3(0.0);
    int entries=headerWord(H_BED_ENTRIES),particleCapacity=headerWord(H_BED_PARTICLES);
    double bulk=0.0, weightedResistance=0.0;
    for(int i=int(words[offsets+cell]);i<int(words[offsets+cell+1]);i++) {
        int entry=int(words[entries+i]),deposit=entry-8*particleCapacity;
        if(deposit<0)continue;
        int row=particleCapacity+deposit,volAddress=headerWord(H_BED_VOLUME)+2*row;
        uint64_t units=uint64_t(words[volAddress])|(uint64_t(words[volAddress+1])<<32);
        double phi=double(uintBitsToFloat(words[headerWord(H_BED_POROSITY)+deposit]));
        int material=int(words[headerWord(H_BED_MATERIAL)+row]);
        double diameter=candidateDouble(headerWord(H_BED_PROPERTIES)+2*(7*material+1));
        if(!(phi>0.0 && phi<1.0 && diameter>0.0)) { atomicOr(errors,INVALID_VISCOSITY_ERROR);return dvec3(0.0); }
        double volume=double(units)/134217728.0/(1.0-phi);
        double permeability=diameter*diameter*phi*phi*phi/(180.0*(1.0-phi)*(1.0-phi));
        bulk+=volume; weightedResistance+=volume/permeability;
    }
    if(!(bulk>0.0 && weightedResistance>0.0))return dvec3(0.0);
    uint open=(~words[headerWord(H_BED_MASKS)+cell])&255u;
    double volume=double(bitCount(open))*.125*p.h*p.h*p.h;
    if(!(volume>0.0))return dvec3(0.0);
    double fraction=clamp(bulk/volume,0.0,1.0),freeK=p.h*p.h/12.0,bedK=bulk/weightedResistance;
    double gap=1.0-fraction;
    // A narrowing free channel loses permeability with the square of its height.
    double horizontal=gap*gap*gap*freeK+fraction*bedK;
    double vertical=1.0/((1.0-fraction)/freeK+fraction/bedK);
    double saturation=cellValue(cell,CELL_CAPACITY)>0.0?clamp(cellValue(cell,CELL_VOLUME)/cellValue(cell,CELL_CAPACITY),0.0,1.0):0.0;
    double scale=.5*mu*volume*saturation;
    return scale*max(dvec3(0.0),dvec3(1.0/horizontal,1.0/vertical,1.0/horizontal)-1.0/freeK);
}
// Evaluate each liquid carrier at its own temperature, then volume-average the
// stresses represented by this cell's shared velocity. Carrier stocks remain distinct.
void prepareCell(int c, bool refresh) {
    writeDoubleField(FIELD_MU, c, 0.0);
    writeIntField(FIELD_EXTRAPOLATED, c, 0);
    if (!refresh) {
        writeDoubleField(FIELD_SOURCE_CELL_HEAT, c, 0.0);
        writeDoubleField(FIELD_SOURCE_CELL_WORK, c, 0.0);
        for (int axis = 0; axis < 3; axis++) {
            writeDoubleField(FIELD_WALL_CONDUCTANCE, 3 * c + axis, 0.0);
            writeDoubleField(FIELD_BED_CONDUCTANCE, 3 * c + axis, 0.0);
            writeDoubleField(FIELD_CELL_FIXED_IMPULSE, 3 * c + axis, 0.0);
            writeDoubleField(FIELD_STRESS_HEAT, 3 * c + axis, 0.0);
            writeDoubleField(FIELD_STRESS_HEAT, 3 * cellCount() + 3 * c + axis, 0.0);
        }
    }
    if (!refresh && !liquidGeometry(c))
        return;

    int first = int(source[stockField(STOCK_CELL_OFFSETS) + c]);
    int last = int(source[stockField(STOCK_CELL_OFFSETS) + c + 1]);
    double weightedViscosity = 0.0, totalVolume = 0.0;
    bool extrapolated = false;
    for (int row = first; row < last; row++) {
        double volume = sourceDouble(stockField(STOCK_NUMERIC_VOLUMES) + 2 * row);
        int massWord = stockField(STOCK_MASS_UNITS) + 2 * row;
        if (volume <= 0.0 || (source[massWord] == 0u && source[massWord + 1] == 0u))
            continue;
        int material = int(source[stockField(STOCK_MATERIALS) + row]);
        if (material < 0 || material >= headerWord(H_MATERIAL_COUNT)) {
            atomicOr(errors, INVALID_VISCOSITY_ERROR);
            return;
        }
        double temperature = candidateDouble((refresh ? p.reserved : headerWord(H_TEMPERATURE)) + 2 * row);
        int begin = readIntField(FIELD_MATERIAL_OFFSETS, material);
        int end = readIntField(FIELD_MATERIAL_OFFSETS, material + 1);
        int segment = begin;
        if (begin == end || !(temperature > 0.0)) {
            atomicOr(errors, INVALID_VISCOSITY_ERROR);
            return;
        }
        extrapolated = extrapolated ||
            temperature < readDoubleField(FIELD_VISCOSITY_SEGMENTS, VISCOSITY_SEGMENT_STRIDE * begin + SEGMENT_MIN_TEMPERATURE) ||
            temperature > readDoubleField(FIELD_VISCOSITY_SEGMENTS, VISCOSITY_SEGMENT_STRIDE * (end - 1) + SEGMENT_MAX_TEMPERATURE);
        while (segment + 1 < end && temperature > readDoubleField(FIELD_VISCOSITY_SEGMENTS, VISCOSITY_SEGMENT_STRIDE * segment + SEGMENT_MAX_TEMPERATURE))
            segment++;
        double lo = readDoubleField(FIELD_VISCOSITY_SEGMENTS, VISCOSITY_SEGMENT_STRIDE * segment + SEGMENT_MIN_TEMPERATURE);
        double hi = readDoubleField(FIELD_VISCOSITY_SEGMENTS, VISCOSITY_SEGMENT_STRIDE * segment + SEGMENT_MAX_TEMPERATURE);
        double t = clamp((temperature - lo) / (hi - lo), 0.0, 1.0);
        double viscosity = mix(readDoubleField(FIELD_VISCOSITY_SEGMENTS, VISCOSITY_SEGMENT_STRIDE * segment + SEGMENT_MIN_VISCOSITY),
                               readDoubleField(FIELD_VISCOSITY_SEGMENTS, VISCOSITY_SEGMENT_STRIDE * segment + SEGMENT_MAX_VISCOSITY), t);
        if (material == headerWord(H_AQUEOUS_MATERIAL) && headerWord(H_WATER_SPECIES) >= 0 &&
                source[stockField(STOCK_MIXTURE_PRESENT) + row] != 0u) {
            uint64_t water = uint64_t(0), ethanol = uint64_t(0), sodium = uint64_t(0), chloride = uint64_t(0), salt = uint64_t(0);
            bool known = true;
            int speciesFirst = int(source[stockField(STOCK_SPECIES_OFFSETS) + row]);
            int speciesLast = int(source[stockField(STOCK_SPECIES_OFFSETS) + row + 1]);
            for (int item = speciesFirst; item < speciesLast; item++) {
                int species = int(source[stockField(STOCK_SPECIES_HANDLES) + item]);
                int address = stockField(STOCK_SPECIES_AMOUNTS) + 2 * item;
                uint64_t amount = uint64_t(source[address]) | (uint64_t(source[address + 1]) << 32);
                if (amount == uint64_t(0)) continue;
                if (species == headerWord(H_WATER_SPECIES)) water += amount;
                else if (species == headerWord(H_ETHANOL_SPECIES)) ethanol += amount;
                else if (species == headerWord(H_SODIUM_SPECIES)) sodium += amount;
                else if (species == headerWord(H_CHLORIDE_SPECIES)) chloride += amount;
                else if (species == headerWord(H_SALT_SPECIES)) salt += amount;
                else known = false;
            }
            if (known && sodium == chloride && (water > uint64_t(0) || (ethanol > uint64_t(0) && salt == uint64_t(0)))) {
                double mass = double(uint64_t(source[massWord]) | (uint64_t(source[massWord + 1]) << 32)) * 1e-10LF;
                double fraction = clamp(double(ethanol) * 1e-6LF * candidateDouble(p.header+H_ETHANOL_MOLAR_MASS) / mass, 0.0LF, 1.0LF);
                viscosity = mix(viscosity, candidateDouble(p.header+H_ETHANOL_VISCOSITY), fraction);
                double saltMoles = (double(sodium) + double(salt)) * 1e-6;
                double molality = water > uint64_t(0) ? saltMoles / (double(water) * 1e-6 * candidateDouble(p.header+H_WATER_MOLAR_MASS)) : 0.0;
                double molarity = saltMoles / (volume * p.h * p.h * p.h * 1000.0);
                if (saltMoles > 0.0 && candidateDouble(p.header+H_SALT_MAX_MOLALITY)>0.0LF) {
                    viscosity *= 1.0 + candidateDouble(p.header+H_SALT_A) * sqrt(molarity) + candidateDouble(p.header+H_SALT_B) * molarity;
                    extrapolated = extrapolated || molality > candidateDouble(p.header+H_SALT_MAX_MOLALITY) || abs(temperature - candidateDouble(p.header+H_SALT_REFERENCE_TEMPERATURE)) > candidateDouble(p.header+H_SALT_TEMPERATURE_TOLERANCE);
                }
            } else {
                extrapolated = true;
            }
        }
        weightedViscosity += volume * viscosity;
        totalVolume += volume;
    }
    if (!(totalVolume > 0.0))
        return;
    double mu = weightedViscosity / totalVolume;
    writeIntField(FIELD_EXTRAPOLATED, c, extrapolated ? 1 : 0);
    writeDoubleField(FIELD_MU, c, mu);
    dvec3 bed=bedConductance(c,mu);

    // The common PLIC geometry supplies only wetted fixed walls and their effective distances.
    // Split each cell's tangential drag equally between its two MAC velocity samples.
    for (int tangent = 0; tangent < 3; tangent++) {
        double sum = 0.0;
        if (headerWord(H_NO_SLIP) != 0)
            for (int axis = 0; axis < 3; axis++)
                if (axis != tangent)
                    for (int side = 0; side < 2; side++)
                        sum += candidateDouble(headerWord(H_WALL_GEOMETRY) + 2 * (12 * c + 2 * (2 * axis + side) + 1));
        writeDoubleField(FIELD_WALL_CONDUCTANCE, 3 * c + tangent, .5 * mu * p.h * sum);
        writeDoubleField(FIELD_BED_CONDUCTANCE, 3 * c + tangent, bed[tangent]);
    }
}
void prepareFace(int f) {
    double v = faceValue(f, FACE_VELOCITY);
    writeDoubleField(FIELD_SOURCE_FACE_VELOCITY, f, v);
    writeDoubleField(FIELD_SOURCE_FACE_K, f, .5 * faceValue(f, FACE_MASS) * v * v);
    writeDoubleField(FIELD_FACE_INVERSE_MASS, f, enabled(f) ? 1.0 / faceValue(f, FACE_MASS) : 0.0);
    writeDoubleField(FIELD_WALL_HEAT, f, 0.0);
    writeDoubleField(FIELD_WALL_FACE_IMPULSE, f, 0.0);
    writeDoubleField(FIELD_CONTACT_FACE_HEAT, f, 0.0);
    writeDoubleField(FIELD_CONTACT_FACE_WORK, f, 0.0);
}
void compileStrain(int row, ivec4 ids, double conductance) {
    if (!(conductance > 0.0))
        return;
    int present = 0;
    double rate = 0.0;
    for (int i = 0; i < 4; i++)
        if (ids[i] >= 0 && readDoubleField(FIELD_FACE_INVERSE_MASS, ids[i]) > 0.0) {
            present++;
            rate += (i % 2 == 0 ? 1.0 : -1.0) * readDoubleField(FIELD_SOURCE_FACE_VELOCITY, ids[i]);
        }
    if (present == 0)
        return;
    writeIntField(FIELD_STRAIN_CLASS, row, row >= 3 * cellCount() ? 4 : present);
    writeDoubleField(FIELD_STRAIN_CONDUCTANCE, row, conductance);
    writeDoubleField(FIELD_STRESS_HEAT, row, rate);
}
ivec2 shearAxes(int pair) {
    return pair == 0 ? ivec2(0, 1) : pair == 1 ? ivec2(0, 2) : ivec2(1, 2);
}
ivec4 strainFaces(int row) {
    bool normal = row < 3 * cellCount();
    int local = normal ? row : row - 3 * cellCount(), kind = local % 3;
    ivec3 pos = cellPosition(local / 3);
    if (normal) {
        ivec3 e = ivec3(0);
        e[kind] = 1;
        return ivec4(faceAt(pos + e, kind), faceAt(pos, kind), -1, -1);
    }
    ivec2 ab = shearAxes(kind);
    ivec3 ea = ivec3(0), eb = ivec3(0);
    ea[ab.x] = 1;
    eb[ab.y] = 1;
    return ivec4(faceAt(pos, ab.x), faceAt(pos - eb, ab.x), faceAt(pos, ab.y), faceAt(pos - ea, ab.y));
}
void compileCellStrain(int id) {
    int c = id / 6, kind = id % 6, row = kind < 3 ? 3 * c + kind : 3 * cellCount() + 3 * c + kind - 3;
    writeDoubleField(FIELD_STRAIN_CONDUCTANCE, row, 0.0);
    writeIntField(FIELD_STRAIN_CLASS, row, 0);
    if (!wet(c))
        return;
    if (kind < 3) {
        int axis = kind;
        compileStrain(3 * c + axis, ivec4(gridFace(c, 2*axis+1), gridFace(c, 2*axis), -1, -1),
                      2.0 * readDoubleField(FIELD_MU, c) * p.h * min(cellValue(c, CELL_VOLUME), cellValue(c, CELL_CAPACITY)));
        return;
    }
    int pair = kind - 3;
    ivec2 ab = shearAxes(pair);
    int minusA = gridNeighbor(c,2*ab.x), minusB = gridNeighbor(c,2*ab.y);
    if (minusA < 0 || minusB < 0) return;
    ivec4 cells = ivec4(gridNeighbor(minusA,2*ab.y), minusA, minusB, c);
    for (int i = 0; i < 4; i++)
        if (!wet(cells[i]))
            return;
    ivec4 ids = ivec4(gridFace(c,2*ab.x), gridFace(minusB,2*ab.x),
                      gridFace(c,2*ab.y), gridFace(minusA,2*ab.y));
    double area = 1.0;
    for (int i = 0; i < 4; i++)
        area = min(area, enabled(ids[i]) ? faceValue(ids[i], FACE_OPEN_AREA) : 0.0);
    if (area == 0.0)
        return;
    double mu = harmonic(harmonic(readDoubleField(FIELD_MU, cells.x), readDoubleField(FIELD_MU, cells.y)),
                         harmonic(readDoubleField(FIELD_MU, cells.z), readDoubleField(FIELD_MU, cells.w)));
    compileStrain(3 * cellCount() + 3 * c + pair, ids, mu * p.h * area);
}
double wallConductance(int c, int tangent) {
    return c < 0 ? 0.0 : readDoubleField(FIELD_WALL_CONDUCTANCE, 3 * c + tangent);
}
void gather(int c) {
    if (!wet(c))
        return;
    double heat = 0.0, work = 0.0;
    ivec3 pos = cellPosition(c);
    for (int a = 0; a < 3; a++)
        heat += readDoubleField(FIELD_STRESS_HEAT, 3 * c + a);
    for (int pair = 0; pair < 3; pair++) {
        ivec2 ab = shearAxes(pair);
        for (int corner = 0; corner < 4; corner++) {
            int owner = c;
            if ((corner & 1) != 0) owner = gridNeighbor(owner,2*ab.x+1);
            if ((corner & 2) != 0) {
                if (owner >= 0) owner = gridNeighbor(owner,2*ab.y+1);
                else { ivec3 edge=pos; edge[ab.x]++; edge[ab.y]++; owner=cellIndex(edge); }
            }
            if (owner >= 0)
                heat += .25 * readDoubleField(FIELD_STRESS_HEAT, 3 * cellCount() + 3 * owner + pair);
        }
    }
    for (int side = 0; side < 6; side++) {
        int axis = side / 2;
        int f = gridFace(c, side);
        ivec2 adjacent = faceCells(f);
        double conductance = wallConductance(adjacent.x, axis) + wallConductance(adjacent.y, axis);
        if (conductance > 0.0)
            heat += readDoubleField(FIELD_WALL_HEAT, f) * wallConductance(c, axis) / conductance;
        double ma = cellValue(adjacent.x, CELL_MASS), mb = cellValue(adjacent.y, CELL_MASS), first = ma + mb > 0.0 ? ma / (ma + mb) : 0.0;
        double faceHeat = readDoubleField(FIELD_CONTACT_FACE_HEAT, f), faceWork = readDoubleField(FIELD_CONTACT_FACE_WORK, f);
        heat += adjacent.x == c ? faceHeat * first : faceHeat - faceHeat * first;
        work += adjacent.x == c ? faceWork * first : faceWork - faceWork * first;
    }
    writeDoubleField(FIELD_SOURCE_CELL_HEAT, c, heat);
    writeDoubleField(FIELD_SOURCE_CELL_WORK, c, work);
}

// Each MAC face meets two normal strains and two shear strains per transverse axis.
// Incidence is implicit in the grid; source rates remain immutable during the face update.
void faceStrains(int f, out int rows[6], out double signs[6]) {
    int axis = axisOf(f);ivec3 pos=gridFacePosition(f);
    ivec2 adjacent=faceCells(f);int a=adjacent.x,b=adjacent.y;
    rows[0] = a < 0 ? -1 : 3 * a + axis;
    rows[1] = b < 0 ? -1 : 3 * b + axis;
    signs[0] = 1.0;
    signs[1] = -1.0;
    int at = 2;
    for (int other = 0; other < 3; other++)
        if (other != axis) {
            int pair = min(axis, other) == 0 ? (max(axis, other) == 1 ? 0 : 1) : 2;
            int first = b, second;
            if (b >= 0) second = gridNeighbor(b,2*other+1);
            else { ivec3 far=pos; far[other]++; second=cellIndex(far); }
            rows[at] = first < 0 ? -1 : 3 * cellCount() + 3 * first + pair;
            rows[at + 1] = second < 0 ? -1 : 3 * cellCount() + 3 * second + pair;
            signs[at] = 1.0;
            signs[at + 1] = -1.0;
            at += 2;
        }
}
int strainSize(int row) {
    return readIntField(FIELD_STRAIN_CLASS, row) & 7;
}
ivec2 prescribedRange(int f) {
    if (headerWord(H_CONTACT_FACE_OFFSETS) < 0)
        return ivec2(0);
    int first = int(words[headerWord(H_CONTACT_FACE_OFFSETS) + f]), last = int(words[headerWord(H_CONTACT_FACE_OFFSETS) + f + 1]);
    if (first < 0 || last < first || last > headerWord(H_CONTACT_CAPACITY)) {
        atomicOr(errors, INVALID_VISCOSITY_ERROR);
        return ivec2(0);
    }
    return ivec2(first, last);
}
double contactMu(ivec2 cells) {
    double mu = 0.0, samples = 0.0;
    for (int i = 0; i < 2; i++)
        if (wet(cells[i])) {
            mu += readDoubleField(FIELD_MU, cells[i]);
            samples++;
        }
    return samples > 0.0 ? mu / samples : 0.0;
}
double contactConductance(int contact, double mu) {
    int body = int(words[headerWord(H_CONTACT_BODY_HANDLES) + contact]);
    double distance = candidateDouble(headerWord(H_CONTACT_AREA_OVER_DISTANCE) + 2 * contact);
    if (body < 0 || body >= headerWord(H_BODY_COUNT) || distance < 0.0) {
        atomicOr(errors, INVALID_VISCOSITY_ERROR);
        return 0.0;
    }
    return mu * distance;
}
double contactVelocity(int contact, int axis) {
    return candidateDouble(headerWord(H_CONTACT_VELOCITIES) + 2 * contact);
}
void prepareFaceScale(int f) {
    if (!enabled(f)) {
        writeDoubleField(FIELD_FACE_SCALE, f, 0.0);
        return;
    }
    int rows[6];
    double signs[6];
    faceStrains(f, rows, signs);
    precise double assigned = 0.0;
    for (int i = 0; i < 6; i++)
        if (rows[i] >= 0) {
            double g = readDoubleField(FIELD_STRAIN_CONDUCTANCE, rows[i]);
            if (g > 0.0)
                assigned += p.dt * g * double(strainSize(rows[i]));
        }
    ivec2 cells = faceCells(f);
    int axis = axisOf(f);
    assigned += p.dt * (wallConductance(cells.x, axis) + wallConductance(cells.y, axis));
    ivec2 contacts = prescribedRange(f);
    double mu = contacts.x < contacts.y ? contactMu(cells) : 0.0;
    for (int contact = contacts.x; contact < contacts.y; contact++)
        assigned += p.dt * contactConductance(contact, mu);
    double mass = faceValue(f, FACE_MASS);
    writeDoubleField(FIELD_FACE_SCALE, f, mass / (mass + assigned));
}

void scaleStrain(int row) {
    double g = readDoubleField(FIELD_STRAIN_CONDUCTANCE, row);
    if (g <= 0.0)
        return;
    ivec4 faces = strainFaces(row);
    double scale = 1.0;
    for (int i = 0; i < 4; i++)
        if (faces[i] >= 0 && readDoubleField(FIELD_FACE_INVERSE_MASS, faces[i]) > 0.0)
            scale = min(scale, readDoubleField(FIELD_FACE_SCALE, faces[i]));
    writeDoubleField(FIELD_STRAIN_CONDUCTANCE, row, g * scale);
}

void applyFace(int f) {
    double before = readDoubleField(FIELD_SOURCE_FACE_VELOCITY, f), mass = faceValue(f, FACE_MASS);
    if (!enabled(f)) {
        writeDoubleField(FIELD_FINAL_FACE_K, f, readDoubleField(FIELD_SOURCE_FACE_K, f));
        return;
    }
    int rows[6], sizes[6];
    double signs[6], weights[6], rates[6];
    faceStrains(f, rows, signs);
    precise double assigned = 0.0;
    double impulse = 0.0;
    for (int i = 0; i < 6; i++) {
        double g = rows[i] < 0 ? 0.0 : readDoubleField(FIELD_STRAIN_CONDUCTANCE, rows[i]);
        sizes[i] = g > 0.0 ? strainSize(rows[i]) : 1;
        rates[i] = g > 0.0 ? readDoubleField(FIELD_STRESS_HEAT, rows[i]) : 0.0;
        weights[i] = p.dt * g * double(sizes[i]);
        assigned += weights[i];
        impulse -= signs[i] * p.dt * g * rates[i];
    }
    ivec2 cells = faceCells(f);
    int axis = axisOf(f);
    double scale = readDoubleField(FIELD_FACE_SCALE, f);
    double wallG = wallConductance(cells.x, axis) + wallConductance(cells.y, axis), wallWeight = p.dt * wallG * scale;
    assigned += wallWeight;
    impulse -= wallWeight * before;
    ivec2 contacts = prescribedRange(f);
    double mu = contacts.x < contacts.y ? contactMu(cells) : 0.0, work = 0.0, contactHeat = 0.0;
    for (int contact = contacts.x; contact < contacts.y; contact++) {
        double g = contactConductance(contact, mu) * scale;
        if (g == 0.0)
            continue;
        double target = contactVelocity(contact, axis), rate = before - target, j = -p.dt * g * rate, w = target * j;
        assigned += p.dt * g;
        impulse += j;
        work += w;
        contactHeat += .5 * p.dt * g * rate * rate;
        writeDoubleField(FIELD_CONTACT_IMPULSE, contact, -j);
        writeDoubleField(FIELD_CONTACT_WORK, contact, w);
    }
    double after = before + impulse / mass, difference = before - after;
    // Finite shared stresses leave nonnegative mass for kinetic mixing.
    double mixing = .5 * (mass - assigned) * difference * difference;
    for (int i = 0; i < 6; i++)
        if (weights[i] > 0.0) {
            double d = before - signs[i] * rates[i] / double(sizes[i]) - after;
            mixing += .5 * weights[i] * d * d;
        }
    mixing += .5 * wallWeight * after * after;
    for (int contact = contacts.x; contact < contacts.y; contact++) {
        double g = contactConductance(contact, mu) * scale;
        if (g == 0.0)
            continue;
        double d = contactVelocity(contact, axis) - after;
        mixing += .5 * p.dt * g * d * d;
    }
    writeFaceVelocity(f, after);
    writeDoubleField(FIELD_FINAL_FACE_K, f, .5 * mass * after * after);
    writeDoubleField(FIELD_WALL_FACE_IMPULSE, f, wallWeight * before);
    writeDoubleField(FIELD_WALL_HEAT, f, .5 * wallWeight * before * before);
    writeDoubleField(FIELD_CONTACT_FACE_WORK, f, work);
    writeDoubleField(FIELD_CONTACT_FACE_HEAT, f, contactHeat + mixing);
}
void applyStrainHeat(int c) {
    dvec3 fixedImpulse = dvec3(0.0);
    for (int kind = 0; kind < 6; kind++) {
        int row = kind < 3 ? 3 * c + kind : 3 * cellCount() + 3 * c + kind - 3;
        double g = readDoubleField(FIELD_STRAIN_CONDUCTANCE, row);
        double rate = g > 0.0 ? readDoubleField(FIELD_STRESS_HEAT, row) : 0.0, impulse = p.dt * g * rate;
        writeDoubleField(FIELD_STRESS_HEAT, row, .5 * impulse * rate);
        if (g == 0.0)
            continue;
        ivec4 ids = strainFaces(row);
        ivec3 coefficient = ivec3(0);
        for (int i = 0; i < 4; i++)
            if (ids[i] >= 0 && readDoubleField(FIELD_FACE_INVERSE_MASS, ids[i]) > 0.0)
                coefficient[axisOf(ids[i])] += i % 2 == 0 ? 1 : -1;
        fixedImpulse += impulse * dvec3(coefficient);
    }
    for (int axis = 0; axis < 3; axis++)
        writeDoubleField(FIELD_CELL_FIXED_IMPULSE, 3 * c + axis, fixedImpulse[axis]);
}
// Each dispatch advances one phase; work arrays carry heat, work and impulse between phases.
void main() {
    int id = int((gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x) * 128u + gl_LocalInvocationID.x);
    if (id >= p.count || errors != 0u)
        return;
    if (pipelineStage == STAGE_PREPARE_CELLS)
        prepareCell(id, false);
    else if (pipelineStage == STAGE_REFRESH_MATERIAL)
        prepareCell(id, true);
    else if (pipelineStage == STAGE_PREPARE_FACES)
        prepareFace(id);
    else if (pipelineStage == STAGE_GATHER_HEAT)
        gather(id);
    else if (pipelineStage == STAGE_CLEAR_CONTACTS) {
        writeDoubleField(FIELD_CONTACT_IMPULSE, id, 0.0);
        writeDoubleField(FIELD_CONTACT_WORK, id, 0.0);
    } else if (pipelineStage == STAGE_COMPILE_CELL_STRAIN)
        compileCellStrain(id);
    else if (pipelineStage == STAGE_PREPARE_FACE_SCALE)
        prepareFaceScale(id);
    else if (pipelineStage == STAGE_SCALE_STRAINS)
        scaleStrain(id);
    else if (pipelineStage == STAGE_APPLY_FACES)
        applyFace(id);
    else if (pipelineStage == STAGE_APPLY_STRAIN_HEAT)
        applyStrainHeat(id);
}
