#version 450
#extension GL_ARB_gpu_shader_fp64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
layout(local_size_x=128) in;
layout(binding=0,std430) readonly buffer Source {uint source[];};
layout(binding=1,std430) buffer Candidate {uint words[];};
layout(binding=2,std430) buffer Errors {uint errors;};
layout(push_constant) uniform Params {int header;int stage;int count;} p;
int h(int i){return int(words[p.header+i]);}int src(int f){return h(16+f);}int dst(int f){return h(40+f);}
double value(int a){return packDouble2x32(uvec2(words[a],words[a+1]));}
void store(int a,double v){if(isnan(v)||isinf(v))atomicOr(errors,65536u);uvec2 bits=unpackDouble2x32(v);words[a]=bits.x;words[a+1]=bits.y;}
int64_t oldQuantity(int a){return int64_t(uint64_t(source[a])|(uint64_t(source[a+1])<<32));}
int64_t quantity(int a){return int64_t(uint64_t(words[a])|(uint64_t(words[a+1])<<32));}
int64_t addMass(int64_t a,int64_t b){if(b<int64_t(0)||a>int64_t(0x7fffffffffffffffUL)-b){atomicOr(errors,65536u);return a;}return a+b;}
int incomingSource(int c,int slot){if(slot==0)return c;ivec3 at=ivec3(c%h(0),c/h(0)%h(1),c/(h(0)*h(1)));int axis=(slot-1)/2;
 at[axis]+=(slot&1)!=0?1:-1;if(at[axis]<0||at[axis]>=ivec3(h(0),h(1),h(2))[axis])return -1;return (at.z*h(1)+at.y)*h(0)+at.x;}
void split(int cell){
 int first=int(source[src(1)+cell]),last=int(source[src(1)+cell+1]);int64_t total=int64_t(0),accepted=int64_t(0);int finalRoute=-1;
 for(int stock=first;stock<last;stock++){total=addMass(total,oldQuantity(src(8)+2*stock));for(int route=int(words[h(10)+stock]);route<int(words[h(10)+stock+1]);route++){
  int64_t mass=quantity(h(6)+2*route);accepted=addMass(accepted,mass);if(mass>int64_t(0))finalRoute=route;store(h(7)+2*route,0.0);}}
 double heat=value(h(5)+2*cell);if(accepted!=total||heat<0.0||(heat>0.0&&total==int64_t(0))){atomicOr(errors,65536u);return;}if(heat==0.0)return;
 double remaining=heat;
 for(int stock=first;stock<last;stock++)for(int route=int(words[h(10)+stock]);route<int(words[h(10)+stock+1]);route++){int64_t mass=quantity(h(6)+2*route);if(mass==int64_t(0))continue;
  double part=route==finalRoute?remaining:heat*(double(mass)/double(total));store(h(7)+2*route,part);remaining-=part;}
}
void gatherAndPost(int cell){
 double heat=0.0;
 for(int slot=0;slot<7;slot++){int from=incomingSource(cell,slot);if(from<0)continue;
  for(int stock=int(source[src(1)+from]);stock<int(source[src(1)+from+1]);stock++)for(int route=int(words[h(10)+stock]);route<int(words[h(10)+stock+1]);route++)if(int(words[h(12)+route])==slot)heat+=value(h(7)+2*route);}
 store(h(8)+2*cell,heat);
 int first=int(words[dst(1)+cell]),last=int(words[dst(1)+cell+1]),lastStock=-1;int64_t total=int64_t(0);
 for(int stock=first;stock<last;stock++){int64_t mass=quantity(dst(8)+2*stock);total=addMass(total,mass);if(mass>int64_t(0))lastStock=stock;}
 if(heat!=0.0&&lastStock<0){atomicOr(errors,65536u);return;}double remaining=heat;
 for(int stock=first;stock<last;stock++){int64_t mass=quantity(dst(8)+2*stock);if(mass==int64_t(0)||heat==0.0)continue;
  double part=stock==lastStock?remaining:heat*(double(mass)/double(total));remaining-=part;
  double before=value(dst(9)+2*stock),after=before+part;store(dst(9)+2*stock,after);store(h(9)+4*stock,after);store(h(9)+4*stock+2,-before);}
}
void main(){int id=int((gl_WorkGroupID.y*gl_NumWorkGroups.x+gl_WorkGroupID.x)*128u+gl_LocalInvocationID.x);if(id>=p.count||errors!=0u)return;
 if(p.stage==0){store(h(9)+4*id,0.0);store(h(9)+4*id+2,0.0);}else if(p.stage==1)split(id);else gatherAndPost(id);
}
