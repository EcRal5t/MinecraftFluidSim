#version 450
#extension GL_ARB_gpu_shader_fp64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
const int STAGE_CLEAR_ENERGY_CHANGES = 0;
const int STAGE_SPLIT_HEAT = 1;
const uint ERROR_MECHANICAL_ENERGY = 65536u;
// HOST_LAYOUT
// SPATIAL_GRID
layout(local_size_x=128) in;
layout(binding=0,std430) readonly buffer Source {uint source[];};
layout(binding=1,std430) buffer Candidate {uint words[];};
layout(binding=2,std430) buffer Errors {uint errors;};
layout(push_constant) uniform Params {int header;int stage;int count;} p;
int headerValue(int i){return int(words[p.header+i]);}int src(int f){return headerValue(H_SOURCE_FIELDS+f);}int dst(int f){return headerValue(H_TARGET_FIELDS+f);}
double value(int a){return packDouble2x32(uvec2(words[a],words[a+1]));}
void store(int a,double v){if(isnan(v)||isinf(v))atomicOr(errors,ERROR_MECHANICAL_ENERGY);uvec2 bits=unpackDouble2x32(v);words[a]=bits.x;words[a+1]=bits.y;}
int64_t oldQuantity(int a){return int64_t(uint64_t(source[a])|(uint64_t(source[a+1])<<32));}
int64_t quantity(int a){return int64_t(uint64_t(words[a])|(uint64_t(words[a+1])<<32));}
int64_t addMass(int64_t a,int64_t b){if(b<int64_t(0)||a>int64_t(0x7fffffffffffffffUL)-b){atomicOr(errors,ERROR_MECHANICAL_ENERGY);return a;}return a+b;}
int incomingSource(int c,int slot){return slot==0?c:gridNeighbor(c,(slot-1)^1);}
void splitSourceHeat(int cell){
 int first=int(source[src(L_CELL_OFFSETS)+cell]),last=int(source[src(L_CELL_OFFSETS)+cell+1]);int64_t total=int64_t(0),accepted=int64_t(0);int finalRoute=-1;
 for(int stock=first;stock<last;stock++){total=addMass(total,oldQuantity(src(L_MASS_UNITS)+2*stock));for(int route=int(words[headerValue(H_ROUTE_OFFSETS)+stock]);route<int(words[headerValue(H_ROUTE_OFFSETS)+stock+1]);route++){
  int64_t mass=quantity(headerValue(H_ROUTE_MASS)+2*route);accepted=addMass(accepted,mass);if(mass>int64_t(0))finalRoute=route;store(headerValue(H_ROUTE_HEAT)+2*route,0.0);}}
 double heat=value(headerValue(H_SOURCE_HEAT)+2*cell);if(accepted!=total||heat<0.0||(heat>0.0&&total==int64_t(0))){atomicOr(errors,ERROR_MECHANICAL_ENERGY);return;}if(heat==0.0)return;
 double remaining=heat;
 for(int stock=first;stock<last;stock++)for(int route=int(words[headerValue(H_ROUTE_OFFSETS)+stock]);route<int(words[headerValue(H_ROUTE_OFFSETS)+stock+1]);route++){int64_t mass=quantity(headerValue(H_ROUTE_MASS)+2*route);if(mass==int64_t(0))continue;
  double part=route==finalRoute?remaining:heat*(double(mass)/double(total));store(headerValue(H_ROUTE_HEAT)+2*route,part);remaining-=part;}
}
void gatherAndPostHeat(int cell){
 double heat=0.0;
 for(int slot=0;slot<7;slot++){int from=incomingSource(cell,slot);if(from<0)continue;
  for(int stock=int(source[src(L_CELL_OFFSETS)+from]);stock<int(source[src(L_CELL_OFFSETS)+from+1]);stock++)for(int route=int(words[headerValue(H_ROUTE_OFFSETS)+stock]);route<int(words[headerValue(H_ROUTE_OFFSETS)+stock+1]);route++)if(int(words[headerValue(H_ROUTE_SLOTS)+route])==slot)heat+=value(headerValue(H_ROUTE_HEAT)+2*route);}
 store(headerValue(H_CELL_HEAT)+2*cell,heat);
 int first=int(words[dst(L_CELL_OFFSETS)+cell]),last=int(words[dst(L_CELL_OFFSETS)+cell+1]),lastStock=-1;int64_t total=int64_t(0);
 for(int stock=first;stock<last;stock++){int64_t mass=quantity(dst(L_MASS_UNITS)+2*stock);total=addMass(total,mass);if(mass>int64_t(0))lastStock=stock;}
 if(heat!=0.0&&lastStock<0){atomicOr(errors,ERROR_MECHANICAL_ENERGY);return;}double remaining=heat;
 for(int stock=first;stock<last;stock++){int64_t mass=quantity(dst(L_MASS_UNITS)+2*stock);if(mass==int64_t(0)||heat==0.0)continue;
  double part=stock==lastStock?remaining:heat*(double(mass)/double(total));remaining-=part;
  double before=value(dst(L_ENERGY_BITS)+2*stock),after=before+part;store(dst(L_ENERGY_BITS)+2*stock,after);store(headerValue(H_ENERGY_CHANGES)+4*stock,after);store(headerValue(H_ENERGY_CHANGES)+4*stock+2,-before);}
}
void main(){int id=int((gl_WorkGroupID.y*gl_NumWorkGroups.x+gl_WorkGroupID.x)*128u+gl_LocalInvocationID.x);if(id>=p.count||errors!=0u)return;
 if(p.stage==STAGE_CLEAR_ENERGY_CHANGES){store(headerValue(H_ENERGY_CHANGES)+4*id,0.0);store(headerValue(H_ENERGY_CHANGES)+4*id+2,0.0);}else if(p.stage==STAGE_SPLIT_HEAT)splitSourceHeat(id);else gatherAndPostHeat(id);
}
