#version 450
#extension GL_ARB_gpu_shader_fp64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
layout(local_size_x = 128) in;
layout(binding = 0, std430) readonly buffer Source {
    uint sourceWords[];
};
layout(binding = 1, std430) buffer Candidate {
    uint candidateWords[];
};
layout(binding = 2, std430) buffer Errors {
    uint errors;
};
layout(push_constant) uniform Params {
    int header;
    int stage;
    int count;
}
p;

// DYADIC_LIBRARY
// HOST_LAYOUT
// SPATIAL_GRID
const uint ERROR_INVALID_INVENTORY = 32u;
const uint ERROR_INSUFFICIENT_CAPACITY = 64u;

const int DYADIC_DESCRIPTOR_WORDS = 5;
const int DYADIC_OFFSET = 1;
const int DYADIC_COUNT = 2;
const int DYADIC_EXPONENT = 3;
const int DYADIC_SIGN = 4;

const int64_t MAX_LONG = int64_t(0x7fffffffffffffffUL);
int headerWord(int field) {
    return int(candidateWords[p.header + field]);
}
int sourceField(int field) {
    return headerWord(SOURCE_FIELDS + field);
}
int targetField(int field) {
    return headerWord(TARGET_FIELDS + field);
}
int routeField(int field) {
    return headerWord(ROUTE_FIELDS + field);
}
int routeIndex(int stock, int slot) {
    uint mask = candidateWords[routeField(ROUTE_SOURCE_MASKS) + stock];
    return (mask & (1u << slot)) == 0u
               ? -1
               : int(candidateWords[routeField(ROUTE_SOURCE_OFFSETS) + stock]) + bitCount(mask & ((1u << slot) - 1u));
}
uint dyadicWord(int bank, int index) {
    return bank == 0 ? sourceWords[index] : candidateWords[index];
}
void dyadicWrite(int index, uint value) {
    candidateWords[index] = value;
}
int64_t longAt(int word) {
    return int64_t(uint64_t(candidateWords[word]) | (uint64_t(candidateWords[word + 1]) << 32));
}
void putLong(int word, int64_t value) {
    candidateWords[word] = uint(value);
    candidateWords[word + 1] = uint(uint64_t(value) >> 32);
}
double doubleAt(int word) {
    return packDouble2x32(uvec2(candidateWords[word], candidateWords[word + 1]));
}
void putDouble(int word, double value) {
    uvec2 bits = unpackDouble2x32(value);
    candidateWords[word] = bits.x;
    candidateWords[word + 1] = bits.y;
}
int64_t addQuantity(int64_t sum, int64_t value) {
    if (value < int64_t(0) || sum > MAX_LONG - value) {
        atomicOr(errors, ERROR_INVALID_INVENTORY);
        return sum;
    }
    return sum + value;
}

void clearStock(int stock) {
    if (stock == 0)
        candidateWords[targetField(STOCK_VOLUME_OFFSETS) + headerWord(H_STOCK_CAPACITY)] = uint(4 * headerWord(H_STOCK_CAPACITY));
    candidateWords[targetField(STOCK_VOLUME_OFFSETS) + stock] = uint(4 * stock);
    candidateWords[targetField(STOCK_VOLUME_COUNTS) + stock] = 0u;
    candidateWords[targetField(STOCK_VOLUME_EXPONENTS) + stock] = 0u;
    putLong(targetField(STOCK_MASS_UNITS) + 2 * stock, 0l);
    putDouble(targetField(STOCK_ENERGY_BITS) + 2 * stock, 0.0);
    putLong(targetField(STOCK_MASS_RESIDUAL_UNITS) + 2 * stock, 0l);
    putDouble(targetField(STOCK_NUMERIC_VOLUMES) + 2 * stock, 0.0);
    candidateWords[targetField(STOCK_MIXTURE_PRESENT) + stock] = 0u;
    if (stock >= headerWord(H_SLOT_COUNT)) {
        candidateWords[targetField(STOCK_MATERIALS) + stock] = 0u;
        candidateWords[targetField(STOCK_SUPPORT_MASKS) + stock] = 0u;
    }
    candidateWords[headerWord(H_SPECIES_COUNTS) + stock] = 0u;
    for (int i = 0; i < 7; i++) {
        putDouble(headerWord(H_ENERGY_REMAINDERS) + 14 * stock + 2 * i, 0.0);
    }
}

int memberCount(int stock) {
    int cell=stock/headerWord(H_MATERIAL_COUNT);
    return 1+int(candidateWords[headerWord(H_ROUTE_OFFSETS)+cell+1])-int(candidateWords[headerWord(H_ROUTE_OFFSETS)+cell]);
}
void member(int stock,int ordinal,out int sourceSlot,out int direction,out int entry) {
    int cell=stock/headerWord(H_MATERIAL_COUNT),material=stock%headerWord(H_MATERIAL_COUNT);
    if(ordinal==0){sourceSlot=stock;direction=0;}
    else {int index=int(candidateWords[headerWord(H_ROUTE_OFFSETS)+cell])+ordinal-1;
        sourceSlot=int(candidateWords[headerWord(H_ROUTE_SOURCES)+index])*headerWord(H_MATERIAL_COUNT)+material;
        direction=int(candidateWords[headerWord(H_ROUTE_SIDES)+index])+1;}
    entry=routeIndex(sourceSlot,direction);
    if(entry>=0 && int(candidateWords[routeField(ROUTE_VOLUME_DESCRIPTORS)+DYADIC_DESCRIPTOR_WORDS*entry+DYADIC_SIGN])<=0)entry=-1;
}
DyadicTerm memberVolume(int stock,int ordinal){
    int slot,direction,entry;member(stock,ordinal,slot,direction,entry);
    if(entry<0)return DyadicTerm(1,0,0,0,0);
    int a=routeField(ROUTE_VOLUME_DESCRIPTORS)+DYADIC_DESCRIPTOR_WORDS*entry;
    return DyadicTerm(int(candidateWords[a]),int(candidateWords[a+1]),int(candidateWords[a+2]),int(candidateWords[a+3]),int(candidateWords[a+4]));
}
int mergeSpecies(int stock,int outputStart,bool writing,out int64_t representedMass){
    representedMass=int64_t(0);int count=0,last=-1,n=memberCount(stock);
    while(true){
        int next=2147483647;bool found=false;
        for(int i=0;i<n;i++){
            int slot,direction,entry;member(stock,i,slot,direction,entry);if(entry<0)continue;
            int begin=int(sourceWords[sourceField(STOCK_SPECIES_OFFSETS)+slot]),end=int(sourceWords[sourceField(STOCK_SPECIES_OFFSETS)+slot+1]);
            for(int s=begin;s<end;s++){
                int handle=int(sourceWords[sourceField(STOCK_SPECIES_HANDLES)+s]);
                if(handle>last && longAt(routeField(ROUTE_SPECIES_AMOUNTS)+2*(7*s+direction))>0l){next=min(next,handle);found=true;break;}
            }
        }
        if(!found)break;int64_t amount=0l;
        for(int i=0;i<n;i++){
            int slot,direction,entry;member(stock,i,slot,direction,entry);if(entry<0)continue;
            int begin=int(sourceWords[sourceField(STOCK_SPECIES_OFFSETS)+slot]),end=int(sourceWords[sourceField(STOCK_SPECIES_OFFSETS)+slot+1]);
            for(int s=begin;s<end;s++)if(int(sourceWords[sourceField(STOCK_SPECIES_HANDLES)+s])==next){
                amount=addQuantity(amount,longAt(routeField(ROUTE_SPECIES_AMOUNTS)+2*(7*s+direction)));break;
            }
        }
        if(writing){candidateWords[targetField(STOCK_SPECIES_HANDLES)+outputStart+count]=uint(next);
            putLong(targetField(STOCK_SPECIES_AMOUNTS)+2*(outputStart+count),amount);
            int64_t unit=longAt(headerWord(H_SPECIES_MASS)+2*next);
            if(unit<0l || (unit>0l && amount>MAX_LONG/unit))atomicOr(errors,ERROR_INVALID_INVENTORY);
            else representedMass=addQuantity(representedMass,amount*unit);
        }
        last=next;count++;
    }
    return count;
}
void gatherVolume(int stock){
    int n=memberCount(stock),minimum=2147483647;int64_t highest=int64_t(-9223372036854775807L);
    for(int i=0;i<n;i++){DyadicTerm t=memberVolume(stock,i);if(!dyadicPresent(t))continue;
        minimum=min(minimum,t.exponent);uint top=dyadicWord(t.bank,t.offset+t.count-1);
        highest=max(highest,int64_t(t.exponent)+32l*int64_t(t.count-1)+int64_t(findMSB(top)));}
    if(minimum==2147483647)return;
    if(highest-int64_t(minimum)>int64_t(DYADIC_MAX_SIGNIFICAND_BITS+31)){atomicOr(errors,ERROR_INVALID_INVENTORY);return;}
    int limit=int((highest-int64_t(minimum))/32l)+2,first=-1,last=-1,shift=0;uint top=0u;uint64_t carry=0ul;
    for(int pos=0;pos<limit;pos++){
        uint64_t sum=carry;for(int i=0;i<n;i++)sum+=uint64_t(dyadicAlignedWord(memberVolume(stock,i),pos,minimum));
        uint value=uint(sum);carry=sum>>32;
        if(value!=0u){if(first<0){first=pos;shift=findLSB(value);}last=pos;top=value;}
    }
    if(first<0)return;
    int64_t bits=32l*int64_t(last-first)+int64_t(findMSB(top)-shift+1),exp=int64_t(minimum)+32l*int64_t(first)+int64_t(shift);
    if(bits>int64_t(DYADIC_MAX_SIGNIFICAND_BITS)||exp>2147483647l||exp<(-2147483647l-1l)){atomicOr(errors,ERROR_INVALID_INVENTORY);return;}
    uint count=uint((bits+31l)>>5),offset=count<=4u?4u*uint(stock):atomicAdd(candidateWords[targetField(STOCK_VOLUME_OFFSETS)+headerWord(H_STOCK_CAPACITY)],count);
    candidateWords[targetField(STOCK_VOLUME_OFFSETS)+stock]=offset;candidateWords[targetField(STOCK_VOLUME_COUNTS)+stock]=count;
    candidateWords[targetField(STOCK_VOLUME_EXPONENTS)+stock]=uint(int(exp));
    if(offset>uint(headerWord(H_LIMB_CAPACITY))||count>uint(headerWord(H_LIMB_CAPACITY))-offset)return;
    carry=0ul;uint previous=0u;
    for(int pos=0;pos<=last+1;pos++){
        uint64_t sum=carry;for(int i=0;i<n;i++)sum+=uint64_t(dyadicAlignedWord(memberVolume(stock,i),pos,minimum));
        uint value=uint(sum);carry=sum>>32;
        if(pos>first){int outputIndex=pos-first-1;if(uint(outputIndex)<count)
            candidateWords[targetField(STOCK_VOLUME_LIMBS)+int(offset)+outputIndex]=shift==0?previous:(previous>>shift)|(value<<(32-shift));}
        previous=value;
    }
}
void gatherSlot(int stock){
    int cell=stock/headerWord(H_MATERIAL_COUNT),n=memberCount(stock);int64_t mass=0l;uint mixture=0u;precise double energy=0.0;
    candidateWords[targetField(STOCK_SUPPORT_MASKS)+stock]=(~candidateWords[headerWord(H_FIXED_MASK)+cell])&255u;
    for(int i=0;i<n;i++){
        int slot,direction,entry;member(stock,i,slot,direction,entry);if(entry<0)continue;
        mass=addQuantity(mass,longAt(routeField(ROUTE_MASS_UNITS)+2*entry));mixture|=candidateWords[routeField(ROUTE_MIXTURE_PRESENT)+entry];
        precise double part=doubleAt(routeField(ROUTE_ENERGY_BITS)+2*entry),next=energy+part,virtualPart=next-energy;
        putDouble(headerWord(H_ENERGY_REMAINDERS)+2*(7*slot+direction),(energy-(next-virtualPart))+(part-virtualPart));
        if(isnan(part)||isinf(part)||isnan(next)||isinf(next))atomicOr(errors,ERROR_INVALID_INVENTORY);energy=next;
    }
    gatherVolume(stock);putLong(targetField(STOCK_MASS_UNITS)+2*stock,mass);putDouble(targetField(STOCK_ENERGY_BITS)+2*stock,energy);
    candidateWords[targetField(STOCK_MIXTURE_PRESENT)+stock]=mixture;int64_t unused;
    candidateWords[headerWord(H_SPECIES_COUNTS)+stock]=uint(mergeSpecies(stock,0,false,unused));
}

uint volumeWord(int begin, int count, int index) {
    return index >= 0 && index < count ? candidateWords[targetField(STOCK_VOLUME_LIMBS) + begin + index] : 0u;
}

// One ties-to-even conversion of the exact canonical significand, including subnormal doubles.
// Canonical odd significands provide the sticky bit without scanning all discarded low limbs.
double numericVolume(int begin, int count, int exponent) {
    if (count == 0)
        return 0.0;
    int bits = 32 * (count - 1) + findMSB(volumeWord(begin, count, count - 1)) + 1;
    int64_t highest = int64_t(exponent) + int64_t(bits - 1);
    if (highest > int64_t(1023)) {
        atomicOr(errors, ERROR_INVALID_INVENTORY);
        return 0.0;
    }
    if (highest < int64_t(-1075))
        return 0.0;
    int unit = int(max(int64_t(-1074), highest - int64_t(52)));
    int64_t discarded = int64_t(unit) - int64_t(exponent);
    if (discarded <= int64_t(0)) {
        uint64_t value = uint64_t(volumeWord(begin, count, 0)) | (uint64_t(volumeWord(begin, count, 1)) << 32);
        return ldexp(double(value), exponent);
    }
    int at = int(discarded >> 5), shift = int(discarded & int64_t(31));
    uint low = volumeWord(begin, count, at) >> shift, high = volumeWord(begin, count, at + 1) >> shift;
    if (shift != 0) {
        low |= volumeWord(begin, count, at + 1) << (32 - shift);
        high |= volumeWord(begin, count, at + 2) << (32 - shift);
    }
    uint64_t rounded = uint64_t(low) | (uint64_t(high) << 32);
    int guard = int(discarded - int64_t(1));
    bool halfway = (volumeWord(begin, count, guard / 32) & (1u << (guard & 31))) != 0u;
    if (halfway && (discarded > int64_t(1) || (rounded & uint64_t(1)) != uint64_t(0)))
        rounded++;
    double value = ldexp(double(rounded), unit);
    if (isnan(value) || isinf(value))
        atomicOr(errors, ERROR_INVALID_INVENTORY);
    return value;
}

void finishStock(int stock) {
    uint actual = uint(headerWord(H_SLOT_COUNT));
    uint species = candidateWords[targetField(STOCK_SPECIES_OFFSETS) + headerWord(H_STOCK_CAPACITY)],
         limbs = candidateWords[targetField(STOCK_VOLUME_OFFSETS) + headerWord(H_STOCK_CAPACITY)];
    if (stock == 0) {
        candidateWords[targetField(STOCK_COUNTS)] = actual;
        candidateWords[targetField(STOCK_COUNTS) + 1] = species;
        candidateWords[targetField(STOCK_COUNTS) + 2] = limbs;
    }
    if (actual > uint(headerWord(H_STOCK_CAPACITY)) || species > uint(headerWord(H_SPECIES_CAPACITY)) ||
        limbs > uint(headerWord(H_LIMB_CAPACITY))) {
        atomicOr(errors, ERROR_INSUFFICIENT_CAPACITY);
        return;
    }
    if ((errors & (16u | ERROR_INVALID_INVENTORY)) != 0u)
        return;
    if (uint(stock) >= actual)
        return;
    if (candidateWords[targetField(STOCK_VOLUME_COUNTS) + stock] == 0u) {
        if (longAt(targetField(STOCK_MASS_UNITS) + 2 * stock) != 0l || candidateWords[headerWord(H_SPECIES_COUNTS) + stock] != 0u ||
            doubleAt(targetField(STOCK_ENERGY_BITS) + 2 * stock) != 0.0) {
            atomicOr(errors, ERROR_INVALID_INVENTORY);
            return;
        }
        candidateWords[targetField(STOCK_VOLUME_COUNTS) + stock] = 0u;
        candidateWords[targetField(STOCK_VOLUME_EXPONENTS) + stock] = 0u;
        candidateWords[targetField(STOCK_SUPPORT_MASKS) + stock] = 0u;
        candidateWords[targetField(STOCK_MIXTURE_PRESENT) + stock] = 0u;
        putLong(targetField(STOCK_MASS_RESIDUAL_UNITS) + 2 * stock, 0l);
        putDouble(targetField(STOCK_NUMERIC_VOLUMES) + 2 * stock, 0.0);
        return;
    }
    int exponent = int(candidateWords[targetField(STOCK_VOLUME_EXPONENTS) + stock]);
    int begin = int(candidateWords[targetField(STOCK_VOLUME_OFFSETS) + stock]),
        end = begin + int(candidateWords[targetField(STOCK_VOLUME_COUNTS) + stock]);
    putDouble(targetField(STOCK_NUMERIC_VOLUMES) + 2 * stock, numericVolume(begin, end - begin, exponent));
    int64_t represented;
    mergeSpecies(stock, int(candidateWords[targetField(STOCK_SPECIES_OFFSETS) + stock]), true, represented);
    int64_t mass = longAt(targetField(STOCK_MASS_UNITS) + 2 * stock);
    putLong(targetField(STOCK_MASS_RESIDUAL_UNITS) + 2 * stock,
            candidateWords[targetField(STOCK_MIXTURE_PRESENT) + stock] != 0u ? mass - represented : int64_t(0));
}

void main() {
    int index = int((gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x) * 128u + gl_LocalInvocationID.x);
    if (index >= p.count || errors != 0u)
        return;
    if (p.stage == STAGE_CLEAR_STOCK)
        clearStock(index);
    else if (p.stage == STAGE_GATHER_SLOT)
        gatherSlot(index);
    else
        finishStock(index);
}
