#version 450
#extension GL_ARB_gpu_shader_fp64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
layout(local_size_x = 128) in;
layout(binding = 0, std430) readonly buffer Source {
    uint sourceWords[];
};
layout(binding = 1, std430) buffer Candidate {
    uint candidateWords[];
};
layout(binding = 2, std430) buffer Errors {
    uint errors;
};
layout(push_constant) uniform Params {
    int header;
    int stage;
    int count;
}
p;

// DYADIC_LIBRARY
// HOST_LAYOUT
const uint ERROR_INVALID_INVENTORY = 32u;
const uint ERROR_INSUFFICIENT_CAPACITY = 64u;

const int DYADIC_DESCRIPTOR_WORDS = 5;
const int DYADIC_OFFSET = 1;
const int DYADIC_COUNT = 2;
const int DYADIC_EXPONENT = 3;
const int DYADIC_SIGN = 4;

const int64_t MAX_LONG = int64_t(0x7fffffffffffffffUL);
int headerWord(int field) {
    return int(candidateWords[p.header + field]);
}
int sourceField(int field) {
    return headerWord(SOURCE_FIELDS + field);
}
int targetField(int field) {
    return headerWord(TARGET_FIELDS + field);
}
int routeField(int field) {
    return headerWord(ROUTE_FIELDS + field);
}
int routeIndex(int stock, int slot) {
    uint mask = candidateWords[routeField(ROUTE_SOURCE_MASKS) + stock];
    return (mask & (1u << slot)) == 0u
               ? -1
               : int(candidateWords[routeField(ROUTE_SOURCE_OFFSETS) + stock]) + bitCount(mask & ((1u << slot) - 1u));
}
uint dyadicWord(int bank, int index) {
    return bank == 0 ? sourceWords[index] : candidateWords[index];
}
void dyadicWrite(int index, uint value) {
    candidateWords[index] = value;
}
int64_t longAt(int word) {
    return int64_t(uint64_t(candidateWords[word]) | (uint64_t(candidateWords[word + 1]) << 32));
}
void putLong(int word, int64_t value) {
    candidateWords[word] = uint(value);
    candidateWords[word + 1] = uint(uint64_t(value) >> 32);
}
double doubleAt(int word) {
    return packDouble2x32(uvec2(candidateWords[word], candidateWords[word + 1]));
}
void putDouble(int word, double value) {
    uvec2 bits = unpackDouble2x32(value);
    candidateWords[word] = bits.x;
    candidateWords[word + 1] = bits.y;
}
int64_t addQuantity(int64_t sum, int64_t value) {
    if (value < int64_t(0) || sum > MAX_LONG - value) {
        atomicOr(errors, ERROR_INVALID_INVENTORY);
        return sum;
    }
    return sum + value;
}

void clearStock(int stock) {
    if (stock == 0)
        candidateWords[targetField(STOCK_VOLUME_OFFSETS) + headerWord(H_STOCK_CAPACITY)] = uint(4 * headerWord(H_STOCK_CAPACITY));
    candidateWords[targetField(STOCK_VOLUME_OFFSETS) + stock] = uint(4 * stock);
    candidateWords[targetField(STOCK_VOLUME_COUNTS) + stock] = 0u;
    candidateWords[targetField(STOCK_VOLUME_EXPONENTS) + stock] = 0u;
    putLong(targetField(STOCK_MASS_UNITS) + 2 * stock, 0l);
    putDouble(targetField(STOCK_ENERGY_BITS) + 2 * stock, 0.0);
    putLong(targetField(STOCK_MASS_RESIDUAL_UNITS) + 2 * stock, 0l);
    putDouble(targetField(STOCK_NUMERIC_VOLUMES) + 2 * stock, 0.0);
    candidateWords[targetField(STOCK_MIXTURE_PRESENT) + stock] = 0u;
    if (stock >= headerWord(H_SLOT_COUNT)) {
        candidateWords[targetField(STOCK_MATERIALS) + stock] = 0u;
        candidateWords[targetField(STOCK_SUPPORT_MASKS) + stock] = 0u;
    }
    candidateWords[headerWord(H_SPECIES_COUNTS) + stock] = 0u;
    for (int i = 0; i < 7; i++)
        candidateWords[headerWord(H_MEMBERS) + 7 * stock + i] = uint(-1);
    for (int i = 0; i < 7; i++) {
        putDouble(headerWord(H_ENERGY_REMAINDERS) + 14 * stock + 2 * i, 0.0);
    }
}

void sourceNeighbors(int targetSlot, out int sourceSlots[7], out int routeDirections[7]) {
    int material = targetSlot % headerWord(H_MATERIAL_COUNT), cellId = targetSlot / headerWord(H_MATERIAL_COUNT);
    ivec3 gridSize = ivec3(headerWord(H_SIZE_X), headerWord(H_SIZE_Y), headerWord(H_SIZE_Z)),
          coordinates = ivec3(cellId % gridSize.x, cellId / gridSize.x % gridSize.y, cellId / (gridSize.x * gridSize.y));
    for (int i = 0; i < 7; i++) {
        sourceSlots[i] = -1;
        routeDirections[i] = 0;
        ivec3 neighborCoordinates = coordinates;
        if (i > 0) {
            int side = i - 1;
            neighborCoordinates[side / 2] += (side & 1) == 0 ? -1 : 1;
            routeDirections[i] = (side ^ 1) + 1;
        }
        if (any(lessThan(neighborCoordinates, ivec3(0))) || any(greaterThanEqual(neighborCoordinates, gridSize)))
            continue;
        sourceSlots[i] = ((neighborCoordinates.z * gridSize.y + neighborCoordinates.y) * gridSize.x + neighborCoordinates.x) * headerWord(H_MATERIAL_COUNT) + material;
    }
}
int seekSpecies(int speciesEntry, int speciesEnd, int routeDirection) {
    while (speciesEntry < speciesEnd) {
        int64_t amount = longAt(routeField(ROUTE_SPECIES_AMOUNTS) + 2 * (7 * speciesEntry + routeDirection));
        if (amount > int64_t(0))
            break;
        if (amount < int64_t(0))
            atomicOr(errors, ERROR_INVALID_INVENTORY);
        speciesEntry++;
    }
    return speciesEntry;
}

// Each accepted route has sorted, unique species handles. Seven-way merge preserves that order.
int mergeSpecies(int stock, int members[7], int outputStart, bool writing, out int64_t representedMass) {
    int speciesCursors[7], speciesEnds[7], sourceSlots[7], routeDirections[7];
    representedMass = int64_t(0);
    if (sourceWords[sourceField(STOCK_COUNTS) + 1] == 0u)
        return 0;
    sourceNeighbors(stock, sourceSlots, routeDirections);
    for (int i = 0; i < 7; i++) {
        speciesCursors[i] = members[i] < 0 ? 0 : int(sourceWords[sourceField(STOCK_SPECIES_OFFSETS) + sourceSlots[i]]);
        speciesEnds[i] = members[i] < 0 ? 0 : int(sourceWords[sourceField(STOCK_SPECIES_OFFSETS) + sourceSlots[i] + 1]);
        speciesCursors[i] = seekSpecies(speciesCursors[i], speciesEnds[i], routeDirections[i]);
    }
    int count = 0;
    while (true) {
        int speciesHandle = 2147483647;
        bool found = false;
        for (int i = 0; i < 7; i++)
            if (speciesCursors[i] < speciesEnds[i]) {
                speciesHandle = min(speciesHandle, int(sourceWords[sourceField(STOCK_SPECIES_HANDLES) + speciesCursors[i]]));
                found = true;
            }
        if (!found)
            break;
        int64_t amount = int64_t(0);
        for (int i = 0; i < 7; i++)
            if (speciesCursors[i] < speciesEnds[i] && int(sourceWords[sourceField(STOCK_SPECIES_HANDLES) + speciesCursors[i]]) == speciesHandle) {
                amount =
                    addQuantity(amount, longAt(routeField(ROUTE_SPECIES_AMOUNTS) + 2 * (7 * speciesCursors[i] + routeDirections[i])));
                speciesCursors[i] = seekSpecies(speciesCursors[i] + 1, speciesEnds[i], routeDirections[i]);
            }
        if (writing) {
            candidateWords[targetField(STOCK_SPECIES_HANDLES) + outputStart + count] = uint(speciesHandle);
            putLong(targetField(STOCK_SPECIES_AMOUNTS) + 2 * (outputStart + count), amount);
            int64_t massPerQuantum = longAt(headerWord(H_SPECIES_MASS) + 2 * speciesHandle);
            if (massPerQuantum < int64_t(0) || (massPerQuantum > int64_t(0) && amount > MAX_LONG / massPerQuantum))
                atomicOr(errors, ERROR_INVALID_INVENTORY);
            else
                representedMass = addQuantity(representedMass, amount * massPerQuantum);
        }
        count++;
    }
    return count;
}

// Publish exact volumes in the same invocation that reads the accepted routes.
// Overflow demand is accumulated even when this candidate has insufficient limb capacity.
void gatherVolume(int stock, DyadicTerm items[7]) {
    int count, exponent;
    uvec4 limbs;
    if (dyadicPositiveSum(items, 7, count, exponent, limbs)) {
        candidateWords[targetField(STOCK_VOLUME_COUNTS) + stock] = uint(count);
        candidateWords[targetField(STOCK_VOLUME_EXPONENTS) + stock] = uint(exponent);
        for (int word = 0; word < count; word++)
            candidateWords[targetField(STOCK_VOLUME_LIMBS) + 4 * stock + word] = limbs[word];
        return;
    }
    DyadicMeasure result = dyadicMeasure(items, 7);
    if (result.status == DYADIC_ZERO)
        return;
    if (result.status != DYADIC_POSITIVE) {
        atomicOr(errors, ERROR_INVALID_INVENTORY);
        return;
    }
    uint countWords = uint(result.words),
         offset = countWords <= 4u
                      ? 4u * uint(stock)
                      : atomicAdd(candidateWords[targetField(STOCK_VOLUME_OFFSETS) + headerWord(H_STOCK_CAPACITY)], countWords);
    candidateWords[targetField(STOCK_VOLUME_OFFSETS) + stock] = offset;
    candidateWords[targetField(STOCK_VOLUME_COUNTS) + stock] = countWords;
    candidateWords[targetField(STOCK_VOLUME_EXPONENTS) + stock] = uint(result.exponent);
    // Finish publishes the complete allocator demand and rejects the private candidate.
    // No global error is raised here, so all rows still contribute their true overflow sizes.
    if (offset > uint(headerWord(H_LIMB_CAPACITY)) || countWords > uint(headerWord(H_LIMB_CAPACITY)) - offset)
        return;
    dyadicWriteSum(items, 7, result, targetField(STOCK_VOLUME_LIMBS) + int(offset));
}

void gatherStock(int stock, int cellId, int members[7]) {
    candidateWords[targetField(STOCK_SUPPORT_MASKS) + stock] = (~candidateWords[headerWord(H_FIXED_MASK) + cellId]) & 255u;
    int64_t massUnits = int64_t(0);
    uint mixturePresent = 0u;
    precise double energy = 0.0;
    DyadicTerm volumeTerms[7];
    for (int i = 0; i < 7; i++) {
        volumeTerms[i] = DyadicTerm(1, 0, 0, 0, 0);
        int routeEntry = members[i];
        candidateWords[headerWord(H_MEMBERS) + 7 * stock + i] = uint(routeEntry);
        if (routeEntry < 0)
            continue;
        massUnits = addQuantity(massUnits, longAt(routeField(ROUTE_MASS_UNITS) + 2 * routeEntry));
        mixturePresent |= candidateWords[routeField(ROUTE_MIXTURE_PRESENT) + routeEntry];
        precise double routeEnergy = doubleAt(routeField(ROUTE_ENERGY_BITS) + 2 * routeEntry);
        precise double nextEnergy = energy + routeEnergy;
        precise double virtualValue = nextEnergy - energy;
        precise double remainder = (energy - (nextEnergy - virtualValue)) + (routeEnergy - virtualValue);
        putDouble(headerWord(H_ENERGY_REMAINDERS) + 14 * stock + 2 * i, remainder);
        energy = nextEnergy;
        if (isnan(routeEnergy) || isinf(routeEnergy) || isnan(nextEnergy) || isinf(nextEnergy))
            atomicOr(errors, ERROR_INVALID_INVENTORY);
        int descriptorAddress = routeField(ROUTE_VOLUME_DESCRIPTORS) + DYADIC_DESCRIPTOR_WORDS * routeEntry;
        volumeTerms[i] = DyadicTerm(int(candidateWords[descriptorAddress]), int(candidateWords[descriptorAddress + DYADIC_OFFSET]),
                              int(candidateWords[descriptorAddress + DYADIC_COUNT]), int(candidateWords[descriptorAddress + DYADIC_EXPONENT]),
                              int(candidateWords[descriptorAddress + DYADIC_SIGN]));
    }
    gatherVolume(stock, volumeTerms);
    putLong(targetField(STOCK_MASS_UNITS) + 2 * stock, massUnits);
    putDouble(targetField(STOCK_ENERGY_BITS) + 2 * stock, energy);
    candidateWords[targetField(STOCK_MIXTURE_PRESENT) + stock] = mixturePresent;
    int64_t unused;
    candidateWords[headerWord(H_SPECIES_COUNTS) + stock] = uint(mergeSpecies(stock, members, 0, false, unused));
}

// Fixed slots gather the same material from the retained route and six actual neighbors.
void gatherSlot(int targetSlot) {
    int routeEntries[7], sourceSlots[7], routeDirections[7];
    sourceNeighbors(targetSlot, sourceSlots, routeDirections);
    for (int i = 0; i < 7; i++) {
        routeEntries[i] = -1;
        if (sourceSlots[i] < 0)
            continue;
        int routeEntry = routeIndex(sourceSlots[i], routeDirections[i]);
        if (routeEntry < 0)
            continue;
        int volumeSign = int(candidateWords[routeField(ROUTE_VOLUME_DESCRIPTORS) + DYADIC_DESCRIPTOR_WORDS * routeEntry + DYADIC_SIGN]);
        if (volumeSign < 0) {
            atomicOr(errors, ERROR_INVALID_INVENTORY);
            return;
        }
        if (volumeSign > 0)
            routeEntries[i] = routeEntry;
    }
    gatherStock(targetSlot, targetSlot / headerWord(H_MATERIAL_COUNT), routeEntries);
}
uint volumeWord(int begin, int count, int index) {
    return index >= 0 && index < count ? candidateWords[targetField(STOCK_VOLUME_LIMBS) + begin + index] : 0u;
}

// One ties-to-even conversion of the exact canonical significand, including subnormal doubles.
// Canonical odd significands provide the sticky bit without scanning all discarded low limbs.
double numericVolume(int begin, int count, int exponent) {
    if (count == 0)
        return 0.0;
    int bits = 32 * (count - 1) + findMSB(volumeWord(begin, count, count - 1)) + 1;
    int64_t highest = int64_t(exponent) + int64_t(bits - 1);
    if (highest > int64_t(1023)) {
        atomicOr(errors, ERROR_INVALID_INVENTORY);
        return 0.0;
    }
    if (highest < int64_t(-1075))
        return 0.0;
    int unit = int(max(int64_t(-1074), highest - int64_t(52)));
    int64_t discarded = int64_t(unit) - int64_t(exponent);
    if (discarded <= int64_t(0)) {
        uint64_t value = uint64_t(volumeWord(begin, count, 0)) | (uint64_t(volumeWord(begin, count, 1)) << 32);
        return ldexp(double(value), exponent);
    }
    int at = int(discarded >> 5), shift = int(discarded & int64_t(31));
    uint low = volumeWord(begin, count, at) >> shift, high = volumeWord(begin, count, at + 1) >> shift;
    if (shift != 0) {
        low |= volumeWord(begin, count, at + 1) << (32 - shift);
        high |= volumeWord(begin, count, at + 2) << (32 - shift);
    }
    uint64_t rounded = uint64_t(low) | (uint64_t(high) << 32);
    int guard = int(discarded - int64_t(1));
    bool halfway = (volumeWord(begin, count, guard / 32) & (1u << (guard & 31))) != 0u;
    if (halfway && (discarded > int64_t(1) || (rounded & uint64_t(1)) != uint64_t(0)))
        rounded++;
    double value = ldexp(double(rounded), unit);
    if (isnan(value) || isinf(value))
        atomicOr(errors, ERROR_INVALID_INVENTORY);
    return value;
}

void finishStock(int stock) {
    uint actual = uint(headerWord(H_SLOT_COUNT));
    uint species = candidateWords[targetField(STOCK_SPECIES_OFFSETS) + headerWord(H_STOCK_CAPACITY)],
         limbs = candidateWords[targetField(STOCK_VOLUME_OFFSETS) + headerWord(H_STOCK_CAPACITY)];
    if (stock == 0) {
        candidateWords[targetField(STOCK_COUNTS)] = actual;
        candidateWords[targetField(STOCK_COUNTS) + 1] = species;
        candidateWords[targetField(STOCK_COUNTS) + 2] = limbs;
    }
    if (actual > uint(headerWord(H_STOCK_CAPACITY)) || species > uint(headerWord(H_SPECIES_CAPACITY)) ||
        limbs > uint(headerWord(H_LIMB_CAPACITY))) {
        atomicOr(errors, ERROR_INSUFFICIENT_CAPACITY);
        return;
    }
    if ((errors & (16u | ERROR_INVALID_INVENTORY)) != 0u)
        return;
    if (uint(stock) >= actual)
        return;
    if (candidateWords[targetField(STOCK_VOLUME_COUNTS) + stock] == 0u) {
        if (longAt(targetField(STOCK_MASS_UNITS) + 2 * stock) != 0l || candidateWords[headerWord(H_SPECIES_COUNTS) + stock] != 0u ||
            doubleAt(targetField(STOCK_ENERGY_BITS) + 2 * stock) != 0.0) {
            atomicOr(errors, ERROR_INVALID_INVENTORY);
            return;
        }
        candidateWords[targetField(STOCK_VOLUME_COUNTS) + stock] = 0u;
        candidateWords[targetField(STOCK_VOLUME_EXPONENTS) + stock] = 0u;
        candidateWords[targetField(STOCK_SUPPORT_MASKS) + stock] = 0u;
        candidateWords[targetField(STOCK_MIXTURE_PRESENT) + stock] = 0u;
        putLong(targetField(STOCK_MASS_RESIDUAL_UNITS) + 2 * stock, 0l);
        putDouble(targetField(STOCK_NUMERIC_VOLUMES) + 2 * stock, 0.0);
        return;
    }
    int exponent = int(candidateWords[targetField(STOCK_VOLUME_EXPONENTS) + stock]);
    int begin = int(candidateWords[targetField(STOCK_VOLUME_OFFSETS) + stock]),
        end = begin + int(candidateWords[targetField(STOCK_VOLUME_COUNTS) + stock]);
    putDouble(targetField(STOCK_NUMERIC_VOLUMES) + 2 * stock, numericVolume(begin, end - begin, exponent));
    int members[7];
    for (int i = 0; i < 7; i++)
        members[i] = int(candidateWords[headerWord(H_MEMBERS) + 7 * stock + i]);
    int64_t represented;
    mergeSpecies(stock, members, int(candidateWords[targetField(STOCK_SPECIES_OFFSETS) + stock]), true, represented);
    int64_t mass = longAt(targetField(STOCK_MASS_UNITS) + 2 * stock);
    putLong(targetField(STOCK_MASS_RESIDUAL_UNITS) + 2 * stock,
            candidateWords[targetField(STOCK_MIXTURE_PRESENT) + stock] != 0u ? mass - represented : int64_t(0));
}

void main() {
    int index = int((gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x) * 128u + gl_LocalInvocationID.x);
    if (index >= p.count || (errors != 0u && p.stage != STAGE_FINISH_STOCK))
        return;
    if (p.stage == STAGE_CLEAR_STOCK)
        clearStock(index);
    else if (p.stage == STAGE_GATHER_SLOT)
        gatherSlot(index);
    else
        finishStock(index);
}
