#version 450
#extension GL_ARB_gpu_shader_fp64 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_ballot : require

const int STAGE_COUNT_SOURCE_EDGES = 0;
const int STAGE_FINALIZE_SOURCE_COUNTS = 1;
const int STAGE_COUNT_LONG_SOURCE_EDGES = 3;
const int STAGE_WRITE_LONG_SOURCE_EDGES = 4;
const int STAGE_SCHEDULE_LONG_SOURCE_ROWS = 5;
const uint ERROR_PRESSURE_GRAPH = 1048576u;
const int PRELUDE_SOURCE_ROW_COUNT = 0;
const int PRELUDE_LIQUID_ROW_COUNT = 1;
const int PRELUDE_LIQUID_STARTS_WORD = 2;
const int PRELUDE_LIQUID_COLUMNS_WORD = 3;
const int PRELUDE_LIQUID_VALUES_WORD = 4;
const int PRELUDE_ROW_IDENTITIES_WORD = 5;
const int PRELUDE_CONTROL_WORD = 8;
const int PRELUDE_GAS_OFFSETS_WORD = 10;
const int PRELUDE_GAS_PEERS_WORD = 11;
const int PRELUDE_GAS_WEIGHTS_WORD = 12;
const int PRELUDE_GAS_DIAGONAL_WORD = 13;
const int PRELUDE_PHYSICAL_ROWS = 14;
layout(local_size_x=128) in;
layout(binding=0,std430) buffer Arena { uint arena[]; };
layout(binding=1,std430) buffer Prelude { uint preludeWords[]; };
layout(binding=2,std430) buffer Graph { uint graph[]; };
layout(binding=3,std430) buffer Errors { uint errors; };
layout(push_constant) uniform Params { int stage; int count; } p;
/*FIELDS*/
shared uint counts[128];shared uint cursor;
shared double diagonals[128],magnitudes[128];
int preludeField(int f){return int(preludeWords[32+f]);}int graphField(int f){return int(graph[16+f]);}
double readArenaDouble(int at){return packDouble2x32(uvec2(arena[at],arena[at+1]));}
void putDouble(int at,double v){uvec2 w=unpackDouble2x32(v);graph[at]=w.x;graph[at+1]=w.y;}
int sourceRowCount(){return int(preludeWords[PRELUDE_SOURCE_ROW_COUNT]);}int liquidRowCount(){return int(preludeWords[PRELUDE_LIQUID_ROW_COUNT]);}
bool rowEnabled(int i){return i>=0&&i<sourceRowCount()&&int(arena[int(preludeWords[PRELUDE_ROW_IDENTITIES_WORD])+i])>=0;}
bool isGasRow(int row){return liquidRowCount()>=0&&row>=liquidRowCount();}
int rowStart(int row){return isGasRow(row)?int(arena[int(preludeWords[PRELUDE_GAS_OFFSETS_WORD])+row-liquidRowCount()]):int(arena[int(preludeWords[PRELUDE_LIQUID_STARTS_WORD])+row]);}
int rowEnd(int row){return isGasRow(row)?int(arena[int(preludeWords[PRELUDE_GAS_OFFSETS_WORD])+row-liquidRowCount()+1]):int(arena[int(preludeWords[PRELUDE_LIQUID_STARTS_WORD])+row+1]);}
int peerAt(int e,bool isGas){return int(arena[int(preludeWords[isGas?PRELUDE_GAS_PEERS_WORD:PRELUDE_LIQUID_COLUMNS_WORD])+e]);}
double valueAt(int e,bool isGas){return (isGas?-1.0:1.0)*readArenaDouble(int(preludeWords[isGas?PRELUDE_GAS_WEIGHTS_WORD:PRELUDE_LIQUID_VALUES_WORD])+2*e);}
void finishDiagonal(int row,double diagonal,double total){
    int compact=int(preludeWords[preludeField(P_PREFIX)+row]);putDouble(graphField(L_DIAGONAL)+2*compact,diagonal);
    if(!(diagonal>0.0)||isnan(diagonal)||isinf(diagonal)){atomicOr(errors,ERROR_PRESSURE_GRAPH);return;}
    atomicMax(graph[4],floatBitsToUint(float((diagonal+total)/diagonal))+1u);
}
void longRow(int row,int lane){
    bool isGas=isGasRow(row);int first=rowStart(row),last=rowEnd(row);
    if(p.stage==STAGE_COUNT_LONG_SOURCE_EDGES){
        uint count=0u;for(int e=first+lane;e<last;e+=128){int peer=peerAt(e,isGas);if(peer!=row&&rowEnabled(peer)&&valueAt(e,isGas)!=0.0)count++;}
        counts[lane]=count;barrier();for(int stride=64;stride>0;stride/=2){if(lane<stride)counts[lane]+=counts[lane+stride];barrier();}
        if(lane==0)preludeWords[preludeField(P_DEGREE)+row]=counts[0];return;
    }
    if(lane==0)cursor=preludeWords[preludeField(P_EDGE_OFFSETS)+row];barrier();
    double diagonal=lane==0&&isGas?readArenaDouble(int(preludeWords[PRELUDE_GAS_DIAGONAL_WORD])+2*(row-liquidRowCount())):0.0,total=0.0;
    for(int base=first;base<last;base+=128){
        int e=base+lane,peer=-1;double v=0.0;if(e<last){peer=peerAt(e,isGas);v=valueAt(e,isGas);}
        bool valid=peer!=row&&rowEnabled(peer)&&v!=0.0;
        uvec4 ballot=subgroupBallot(valid);uint baseSlot=0u;
        if(subgroupElect())baseSlot=atomicAdd(cursor,subgroupBallotBitCount(ballot));
        baseSlot=subgroupBroadcastFirst(baseSlot);
        if(valid){int slot=int(baseSlot+subgroupBallotExclusiveBitCount(ballot));graph[graphField(L_COLUMNS)+slot]=preludeWords[preludeField(P_PREFIX)+peer];putDouble(graphField(L_VALUES)+2*slot,v);total+=abs(v);}
        if(peer==row)diagonal+=v;
    }
    diagonals[lane]=diagonal;magnitudes[lane]=total;barrier();
    for(int stride=64;stride>0;stride/=2){if(lane<stride){diagonals[lane]+=diagonals[lane+stride];magnitudes[lane]+=magnitudes[lane+stride];}barrier();}
    if(lane==0)finishDiagonal(row,diagonals[0],magnitudes[0]);
}
void main(){
    int row=int(gl_GlobalInvocationID.x),lane=int(gl_LocalInvocationID.x);
    if(p.stage==STAGE_SCHEDULE_LONG_SOURCE_ROWS){if(row==0){int at=preludeField(P_DISPATCH);preludeWords[at]=preludeWords[preludeField(P_LONG_COUNT)];preludeWords[at+1]=1u;preludeWords[at+2]=1u;}return;}
    if(p.stage==STAGE_FINALIZE_SOURCE_COUNTS){if(row==0){
        uint count=preludeWords[preludeField(P_PREFIX)+sourceRowCount()];preludeWords[preludeField(P_ACTUAL)]=count;preludeWords[preludeField(P_ACTUAL)+1]=preludeWords[preludeField(P_EDGE_OFFSETS)+sourceRowCount()];
        int at=preludeField(P_PRESSURE_DISPATCH);preludeWords[at]=max(1u,(count+255u)/256u);preludeWords[at+1]=1u;preludeWords[at+2]=1u;
        if(preludeWords[PRELUDE_PHYSICAL_ROWS]==0u){uvec2 value=unpackDouble2x32(double(count));int control=int(preludeWords[PRELUDE_CONTROL_WORD])+28;arena[control]=value.x;arena[control+1]=value.y;}
    }return;}
    if(p.stage==STAGE_COUNT_LONG_SOURCE_EDGES||p.stage==STAGE_WRITE_LONG_SOURCE_EDGES){row=int(preludeWords[preludeField(P_LONG_ROWS)+int(gl_WorkGroupID.x)]);longRow(row,lane);return;}
    if(row>=sourceRowCount())return;bool enabled=rowEnabled(row);
    if(p.stage==STAGE_COUNT_SOURCE_EDGES){
        int degree=0;if(enabled){bool isGas=isGasRow(row);int first=rowStart(row),last=rowEnd(row);
            if(last-first>32){uint slot=atomicAdd(preludeWords[preludeField(P_LONG_COUNT)],1u);preludeWords[preludeField(P_LONG_ROWS)+int(slot)]=uint(row);}
            else for(int e=first;e<last;e++){int peer=peerAt(e,isGas);if(peer!=row&&rowEnabled(peer)&&valueAt(e,isGas)!=0.0)degree++;}
        }
        preludeWords[preludeField(P_FLAGS)+row]=enabled?1u:0u;preludeWords[preludeField(P_DEGREE)+row]=uint(degree);return;
    }
    if(!enabled)return;
    int compact=int(preludeWords[preludeField(P_PREFIX)+row]),slot=int(preludeWords[preludeField(P_EDGE_OFFSETS)+row]);
    graph[graphField(L_ROW_KEY)+compact]=uint(row);graph[graphField(L_STARTS)+compact]=uint(slot);
    if(compact==int(preludeWords[preludeField(P_ACTUAL)])-1)graph[graphField(L_STARTS)+compact+1]=preludeWords[preludeField(P_ACTUAL)+1];
    bool isGas=isGasRow(row);int first=rowStart(row),last=rowEnd(row);if(last-first>32)return;
    double diagonal=isGas?readArenaDouble(int(preludeWords[PRELUDE_GAS_DIAGONAL_WORD])+2*(row-liquidRowCount())):0.0,total=0.0;
    for(int e=first;e<last;e++){int peer=peerAt(e,isGas);double value=valueAt(e,isGas);
        if(peer==row)diagonal+=value;else if(rowEnabled(peer)&&value!=0.0){graph[graphField(L_COLUMNS)+slot]=preludeWords[preludeField(P_PREFIX)+peer];putDouble(graphField(L_VALUES)+2*slot,value);total+=abs(value);slot++;}
    }
    finishDiagonal(row,diagonal,total);
}
