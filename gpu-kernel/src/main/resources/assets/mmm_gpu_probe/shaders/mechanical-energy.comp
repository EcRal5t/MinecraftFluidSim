#version 450
#extension GL_ARB_gpu_shader_fp64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
layout(local_size_x=128) in;
layout(binding=0,std430) readonly buffer Source { uint sourceWords[]; };
layout(binding=1,std430) buffer Candidate { uint words[]; };
layout(binding=2,std430) buffer Errors { uint errors; };
layout(push_constant) uniform Params { int header; int stage; double cellSize; double gravity; } p;
shared dvec4 partial[128];
int h(int i){return int(words[p.header+i]);}
int src(int i){return h(40+i);}int dst(int i){return h(64+i);}
double value(int at){return packDouble2x32(uvec2(words[at],words[at+1]));}
double oldValue(int at){return packDouble2x32(uvec2(sourceWords[at],sourceWords[at+1]));}
int64_t mass(int at){return int64_t(uint64_t(words[at])|(uint64_t(words[at+1])<<32));}
void store(int at,double x){if(isnan(x)||isinf(x))atomicOr(errors,65536u);uvec2 bits=unpackDouble2x32(x);words[at]=bits.x;words[at+1]=bits.y;}
dvec2 twoSum(double a,double b){precise double sum=a+b;precise double virtualB=sum-a;precise double error=(a-(sum-virtualB))+(b-virtualB);return dvec2(sum,error);}
dvec2 add(dvec2 a,double b){dvec2 s=twoSum(a.x,b);return twoSum(s.x,s.y+a.y);}
dvec2 add(dvec2 a,dvec2 b){return add(add(a,b.x),b.y);}
dvec4 combine(dvec4 a,dvec4 b){return dvec4(add(a.xy,b.xy),a.zw+b.zw);}
dvec4 data(int base,int item){int at=base+8*item;return dvec4(value(at),value(at+2),value(at+4),value(at+6));}
void storeData(int base,int item,dvec4 x){for(int i=0;i<4;i++)store(base+8*item+2*i,x[i]);}
ivec3 shape(){return ivec3(h(0),h(1),h(2));}
ivec3 unit(int axis){ivec3 result=ivec3(0);result[axis]=1;return result;}
int cell(ivec3 q){return any(lessThan(q,ivec3(0)))||any(greaterThanEqual(q,shape()))?-1:(q.z*h(1)+q.y)*h(0)+q.x;}
int base(int axis){return axis==0?0:(h(0)+1)*h(1)*h(2)+(axis==2?h(0)*(h(1)+1)*h(2):0);}
int face(ivec3 q,int axis){ivec3 s=shape()+unit(axis);return base(axis)+(q.z*s.y+q.y)*s.x+q.x;}
double oldMass(int c){return c<0?0.0:double(mass(h(9)+4*c));}
void faceTerms(int index){
    int axis=index<base(1)?0:index<base(2)?1:2,local=index-base(axis);
    double m=value(h(8)+8*index),u=value(h(8)+8*index+2),momentum=oldValue(src(16+axis)+2*local);
    store(h(20)+4*index,m>0.0?.5*momentum*(momentum/m):0.0);
    store(h(20)+4*index+2,-.5*m*u*u);
}
void potentialTerms(int stock){
    store(h(21)+4*stock,0.0);store(h(21)+4*stock+2,0.0);
    if(stock>=int(sourceWords[src(0)]))return;
    store(h(21)+4*stock,double(mass(h(10)+2*(7*stock+3)))*1e-10*p.gravity*p.cellSize);
    store(h(21)+4*stock+2,-double(mass(h(10)+2*(7*stock+4)))*1e-10*p.gravity*p.cellSize);
}
void vertex(int index){
    dvec2 exchange=dvec2(0.0);double capacity=0.0,available=0.0;
    if(index<h(3)){
        ivec3 pos=ivec3(index%h(0),index/h(0)%h(1),index/(h(0)*h(1)));
        for(int axis=0;axis<3;axis++)for(int side=0;side<2;side++){
            ivec3 at=pos+(side==0?ivec3(0):unit(axis));int f=face(at,axis),a=cell(at-unit(axis)),b=cell(at);
            double ma=oldMass(a),mb=oldMass(b),total=ma+mb;if(total<=0.0)continue;
            dvec2 full=twoSum(value(h(20)+4*f),value(h(20)+4*f+2));
            dvec2 first=full*(ma/total),share=side==0?add(full,-first):first;
            exchange=add(exchange,share);
        }
        for(int stock=int(sourceWords[src(1)+index]);stock<int(sourceWords[src(1)+index+1]);stock++){
            exchange=add(exchange,value(h(21)+4*stock));exchange=add(exchange,value(h(21)+4*stock+2));
        }
        for(int stock=int(words[dst(1)+index]);stock<int(words[dst(1)+index+1]);stock++){
            capacity+=value(h(16)+2*stock);available+=max(0.0,value(dst(9)+2*stock)-value(h(17)+2*stock));
        }
    }else if(h(11)>=0){int gas=index-h(3);exchange=-dvec2(value(h(11)+4*gas),value(h(11)+4*gas+2));}
    storeData(h(22),index,dvec4(exchange,capacity,available));
    int count=int(words[h(15)+index]);words[h(23)+index]=uint((count+127)/128);
}
void mapBlocks(int root){
    int begin=int(words[h(24)+root]),end=int(words[h(24)+root+1]);
    for(int i=begin;i<end;i++)words[h(25)+i]=uint(root);
    if(root==0){uint blocks=words[h(24)+h(4)];words[h(29)]=min(blocks,65535u);words[h(29)+1]=(blocks+65534u)/65535u;words[h(29)+2]=1u;}
}
void reduceBlock(int block,int lane){
    int blocks=int(words[h(24)+h(4)]);dvec4 item=dvec4(0.0);
    if(block<blocks){
        int root=int(words[h(25)+block]),begin=int(words[h(13)+root]),end=int(words[h(13)+root+1]);
        int cursor=begin+128*(block-int(words[h(24)+root]))+lane;
        if(cursor<end)item=data(h(22),int(words[h(14)+cursor]));
    }
    partial[lane]=item;barrier();
    for(int stride=64;stride>0;stride/=2){if(lane<stride)partial[lane]=combine(partial[lane],partial[lane+stride]);barrier();}
    if(lane==0&&block<blocks)storeData(h(26),block,partial[0]);
}
void reduceBody(int root){
    dvec4 total=dvec4(0.0);dvec2 weights=dvec2(0.0),residual=dvec2(0.0);
    for(int block=int(words[h(24)+root]);block<int(words[h(24)+root+1]);block++){
        dvec4 part=data(h(26),block);total.xy=add(total.xy,part.xy);
        dvec2 next=weights+part.zw,delta=next-weights;residual+=(weights-(next-delta))+(part.zw-delta);weights=next;
    }
    total.zw=weights+residual;storeData(h(27),root,total);
    double work=total.x+total.y;
    if((work!=0.0&&total.z<=0.0)||-work>total.w)atomicOr(errors,65536u);
}
void postCell(int index){
    int root=int(words[h(12)+index]);dvec4 body=data(h(27),root);double work=body.x+body.y;
    if(work==0.0)return;
    bool cooling=work<0.0;double total=cooling?body.w:body.z;
    for(int stock=int(words[dst(1)+index]);stock<int(words[dst(1)+index+1]);stock++){
        double before=value(dst(9)+2*stock),cold=value(h(17)+2*stock);
        double weight=cooling?max(0.0,before-cold):value(h(16)+2*stock);
        if(weight==0.0)continue;
        double share=work*(weight/total),after=max(cold,before+share);
        dvec2 change=twoSum(after,-before);store(dst(9)+2*stock,after);
        store(h(28)+4*stock,change.x);store(h(28)+4*stock+2,change.y);
    }
}
void main(){
    int block=int(gl_WorkGroupID.y*gl_NumWorkGroups.x+gl_WorkGroupID.x),lane=int(gl_LocalInvocationID.x),item=block*128+lane;
    if(p.stage==4){reduceBlock(block,lane);return;}
    if(errors!=0u)return;
    if(p.stage==0){if(item<h(5))faceTerms(item);}
    else if(p.stage==1){if(item<h(6))potentialTerms(item);}
    else if(p.stage==2){if(item<h(4))vertex(item);}
    else if(p.stage==3){if(item<h(4))mapBlocks(item);}
    else if(p.stage==5){if(item<h(4))reduceBody(item);}
    else if(p.stage==6){if(item<h(7)){store(h(28)+4*item,0.0);store(h(28)+4*item+2,0.0);}}
    else if(item<h(3))postCell(item);
}
