#version 450
#extension GL_ARB_gpu_shader_fp64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
const int ROUTE_DOWN = 3;
const int ROUTE_UP = 4;
const double MASS_UNIT_KG = 1e-10;
const int STAGE_FACE_TERMS = 0;
const int STAGE_POTENTIAL_TERMS = 1;
const int STAGE_VERTEX_TERMS = 2;
const int STAGE_MAP_BLOCKS = 3;
const int STAGE_REDUCE_BLOCK = 4;
const int STAGE_REDUCE_BODY = 5;
const int STAGE_CLEAR_ENERGY_CHANGES = 6;
const int STAGE_POST_CELL = 7;
const int STAGE_PARTICLE_TERMS = 8;
const int STAGE_POST_GRANULAR = 9;
const int STAGE_POST_GAS = 10;
const uint ERROR_MECHANICAL_ENERGY = 65536u;
// HOST_LAYOUT
// LOCAL_GAS_GRID
layout(local_size_x=128) in;
layout(binding=0,std430) readonly buffer Source { uint sourceWords[]; };
layout(binding=1,std430) buffer Candidate { uint words[]; };
layout(binding=2,std430) buffer Errors { uint errors; };
layout(push_constant) uniform Params { int header; int stage; double cellSize; double gravity; } p;
shared dvec4 partial[128];
shared dvec2 weightErrors[128];
int headerValue(int i){return int(words[p.header+i]);}
int sourceFieldOffset(int i){return headerValue(H_SOURCE_FIELDS+i);}int targetFieldOffset(int i){return headerValue(H_TARGET_FIELDS+i);}
double readDouble(int at){return packDouble2x32(uvec2(words[at],words[at+1]));}
double readSourceDouble(int at){return packDouble2x32(uvec2(sourceWords[at],sourceWords[at+1]));}
int64_t readMassUnits(int at){return int64_t(uint64_t(words[at])|(uint64_t(words[at+1])<<32));}
#define H_SOURCE_EOS H_GAS_EOS
int headerWord(int i){return headerValue(i);}
int sourceEosWord(int i){return int(words[headerValue(H_GAS_EOS)+i]);}
bool isFinite(double x){return !isnan(x)&&!isinf(x);}
void reportInvalid(){atomicOr(errors,ERROR_MECHANICAL_ENERGY);}
// GAS_CALORIC_MATERIAL
void writeDouble(int at,double x){if(isnan(x)||isinf(x))atomicOr(errors,ERROR_MECHANICAL_ENERGY);uvec2 bits=unpackDouble2x32(x);words[at]=bits.x;words[at+1]=bits.y;}
dvec2 twoSum(double a,double b){precise double sum=a+b;precise double virtualB=sum-a;precise double error=(a-(sum-virtualB))+(b-virtualB);return dvec2(sum,error);}
dvec2 add(dvec2 a,double b){dvec2 s=twoSum(a.x,b);return twoSum(s.x,s.y+a.y);}
dvec2 add(dvec2 a,dvec2 b){return add(add(a,b.x),b.y);}
dvec4 combine(dvec4 a,dvec4 b){return dvec4(add(a.xy,b.xy),a.zw+b.zw);}
dvec4 readEnergyTerms(int base,int item){int at=base+8*item;return dvec4(readDouble(at),readDouble(at+2),readDouble(at+4),readDouble(at+6));}
void writeEnergyTerms(int base,int item,dvec4 x){for(int i=0;i<4;i++)writeDouble(base+8*item+2*i,x[i]);}
ivec3 shape(){return ivec3(headerValue(H_SIZE_X),headerValue(H_SIZE_Y),headerValue(H_SIZE_Z));}
ivec3 unit(int axis){ivec3 result=ivec3(0);result[axis]=1;return result;}
int cell(ivec3 q){return any(lessThan(q,ivec3(0)))||any(greaterThanEqual(q,shape()))?-1:(q.z*headerValue(H_SIZE_Y)+q.y)*headerValue(H_SIZE_X)+q.x;}
int faceAxisOffset(int axis){return axis==0?0:(headerValue(H_SIZE_X)+1)*headerValue(H_SIZE_Y)*headerValue(H_SIZE_Z)+(axis==2?headerValue(H_SIZE_X)*(headerValue(H_SIZE_Y)+1)*headerValue(H_SIZE_Z):0);}
int faceIndex(ivec3 q,int axis){ivec3 s=shape()+unit(axis);return faceAxisOffset(axis)+(q.z*s.y+q.y)*s.x+q.x;}
double sourceCellMass(int c){return c<0?0.0:double(readMassUnits(headerValue(H_CELL_MASS)+4*c));}
void faceTerms(int index){
    int axis=index<faceAxisOffset(1)?0:index<faceAxisOffset(2)?1:2,localFace=index-faceAxisOffset(axis);
    if(headerValue(H_ACTIVITY_FACES)>=0&&words[headerValue(H_ACTIVITY_FACES)+index]==0u){writeDouble(headerValue(H_FACE_TERMS)+4*index,0.0);writeDouble(headerValue(H_FACE_TERMS)+4*index+2,0.0);return;}
    double faceMass=readDouble(headerValue(H_PROJECTED_FACES)+8*index),projectedVelocity=readDouble(headerValue(H_PROJECTED_FACES)+8*index+2),momentum=readSourceDouble(sourceFieldOffset(L_MOMENTUM_X+axis)+2*localFace);
    writeDouble(headerValue(H_FACE_TERMS)+4*index,headerValue(H_SOURCE_FACE_K)>=0?readDouble(headerValue(H_SOURCE_FACE_K)+2*index):faceMass>0.0?.5*momentum*(momentum/faceMass):0.0);
    writeDouble(headerValue(H_FACE_TERMS)+4*index+2,-.5*faceMass*projectedVelocity*projectedVelocity);
}
int64_t routeMass(int stock,int slot){uint mask=words[headerValue(H_ROUTE_MASKS)+stock];if((mask&(1u<<slot))==0u)return int64_t(0);int routeIndex=int(words[headerValue(H_ROUTE_OFFSETS)+stock])+bitCount(mask&((1u<<slot)-1u));return readMassUnits(headerValue(H_ROUTE_MASS)+2*routeIndex);}
void potentialTerms(int stock){
    writeDouble(headerValue(H_POTENTIAL_TERMS)+4*stock,0.0);writeDouble(headerValue(H_POTENTIAL_TERMS)+4*stock+2,0.0);
    if(stock>=int(sourceWords[sourceFieldOffset(L_COUNTS)]))return;
    writeDouble(headerValue(H_POTENTIAL_TERMS)+4*stock,double(routeMass(stock,ROUTE_DOWN))*MASS_UNIT_KG*p.gravity*p.cellSize);
    writeDouble(headerValue(H_POTENTIAL_TERMS)+4*stock+2,-double(routeMass(stock,ROUTE_UP))*MASS_UNIT_KG*p.gravity*p.cellSize);
}
void gasPotential(int index){
    if(headerValue(H_GAS_POTENTIAL)<0||index>=headerValue(H_GAS_CAPACITY))return;
    double down=0.0,up=0.0;int components=headerValue(H_GAS_COMPONENTS);
    for(int c=0;c<components;c++){
        int downRoute=localGasRouteIndex(index,c,2,headerValue(H_CELLS),components);
        int upRoute=localGasRouteIndex(index,c,3,headerValue(H_CELLS),components);
        down+=double(readMassUnits(headerValue(H_GAS_ROUTE_MASS)+2*downRoute))*MASS_UNIT_KG*p.gravity*p.cellSize;
        up-=double(readMassUnits(headerValue(H_GAS_ROUTE_MASS)+2*upRoute))*MASS_UNIT_KG*p.gravity*p.cellSize;
    }
    writeDouble(headerValue(H_GAS_POTENTIAL)+4*index,down);writeDouble(headerValue(H_GAS_POTENTIAL)+4*index+2,up);
}
void particleTerms(int index){
    writeDouble(headerValue(H_GRAIN_CHANGES)+4*index,0.0);writeDouble(headerValue(H_GRAIN_CHANGES)+4*index+2,0.0);
    if(index>=headerValue(H_PARTICLE_CAPACITY))return;
    for(int i=0;i<4;i++)writeDouble(headerValue(H_GRAIN_TERMS)+8*index+2*i,0.0);
    if(index>=int(words[headerValue(H_GRAIN_COUNTS)]))return;
    double gravitationalForce=double(readMassUnits(headerValue(H_GRAIN_MASS)+2*index))*MASS_UNIT_KG*p.gravity;
    writeDouble(headerValue(H_GRAIN_TERMS)+8*index,readDouble(headerValue(H_SOURCE_K)+2*index));writeDouble(headerValue(H_GRAIN_TERMS)+8*index+2,-readDouble(headerValue(H_FINAL_K)+2*index));
    writeDouble(headerValue(H_GRAIN_TERMS)+8*index+4,gravitationalForce*readDouble(headerValue(H_SOURCE_Y)+2*index));writeDouble(headerValue(H_GRAIN_TERMS)+8*index+6,-gravitationalForce*readDouble(headerValue(H_FINAL_Y)+2*index));
}
double gasCapacity(int gas){return readDouble(headerValue(H_GAS_STATES)+18*gas+6);}
double gasAvailable(int gas){
    int offsets=sourceEosWord(GAS_FIELDS+GAS_ROW_COMPONENT_OFFSETS),mass=sourceEosWord(GAS_FIELDS+GAS_MASS_UNITS),
        handles=sourceEosWord(GAS_FIELDS+GAS_COMPONENT_HANDLES),speciesOffsets=sourceEosWord(GAS_FIELDS+GAS_COMPONENT_SPECIES_OFFSETS),
        speciesHandles=sourceEosWord(GAS_FIELDS+GAS_SPECIES_HANDLES),speciesAmounts=sourceEosWord(GAS_FIELDS+GAS_SPECIES_AMOUNTS);
    double cold=0.0;int first=int(words[offsets+gas]),last=int(words[offsets+gas+1]);
    for(int component=first;component<last;component++){
        int64_t massUnits=readMassUnits(mass+2*component);if(massUnits<=int64_t(0))continue;
        int handle=int(words[handles+component]);double specific,capacity;material(handle,readDouble(p.header+120),specific,capacity);
        cold+=double(massUnits)*MASS_UNIT_KG*specific;
        for(int entry=int(words[speciesOffsets+component]);entry<int(words[speciesOffsets+component+1]);entry++){
            int64_t amount=readMassUnits(speciesAmounts+2*entry);if(amount==int64_t(0))continue;
            int species=int(words[speciesHandles+entry]);cold+=double(amount)*readDouble(sourceEosWord(GAS_H_SPECIES_REFERENCE)+2*(handle*sourceEosWord(GAS_H_SPECIES_STRIDE)+species));
        }
    }
    return max(0.0,readDouble(headerValue(H_GAS_ENERGY)+2*gas)-cold);
}
void computeVertexTerms(int index){
    dvec2 exchange=dvec2(0.0);double heatCapacity=0.0,availableThermalEnergy=0.0;
    if(index<headerValue(H_CELLS)){
        if(headerValue(H_ACTIVITY_CELLS)>=0&&words[headerValue(H_ACTIVITY_CELLS)+index]==0u){writeEnergyTerms(headerValue(H_VERTEX_DATA),index,dvec4(0.0));int count=int(words[headerValue(H_BODY_COUNTS)+index]);words[headerValue(H_BLOCK_COUNTS)+index]=uint((count+127)/128);return;}
        ivec3 position=ivec3(index%headerValue(H_SIZE_X),index/headerValue(H_SIZE_X)%headerValue(H_SIZE_Y),index/(headerValue(H_SIZE_X)*headerValue(H_SIZE_Y)));
        for(int axis=0;axis<3;axis++)for(int side=0;side<2;side++){
            ivec3 facePosition=position+(side==0?ivec3(0):unit(axis));int face=faceIndex(facePosition,axis),leftCell=cell(facePosition-unit(axis)),rightCell=cell(facePosition);
            double leftMass=sourceCellMass(leftCell),rightMass=sourceCellMass(rightCell),totalMass=leftMass+rightMass;if(totalMass<=0.0)continue;
            dvec2 faceExchange=twoSum(readDouble(headerValue(H_FACE_TERMS)+4*face),readDouble(headerValue(H_FACE_TERMS)+4*face+2));
            dvec2 leftShare=faceExchange*(leftMass/totalMass),cellShare=side==0?add(faceExchange,-leftShare):leftShare;
            exchange=add(exchange,cellShare);
        }
        for(int stock=int(sourceWords[sourceFieldOffset(L_CELL_OFFSETS)+index]);stock<int(sourceWords[sourceFieldOffset(L_CELL_OFFSETS)+index+1]);stock++){
            exchange=add(exchange,readDouble(headerValue(H_POTENTIAL_TERMS)+4*stock));exchange=add(exchange,readDouble(headerValue(H_POTENTIAL_TERMS)+4*stock+2));
        }
        for(int stock=int(words[targetFieldOffset(L_CELL_OFFSETS)+index]);stock<int(words[targetFieldOffset(L_CELL_OFFSETS)+index+1]);stock++){
            heatCapacity+=readDouble(headerValue(H_HEAT_CAPACITY)+2*stock);availableThermalEnergy+=max(0.0,readDouble(targetFieldOffset(L_ENERGY_BITS)+2*stock)-readDouble(headerValue(H_COLD_ENERGY)+2*stock));
        }
        if(headerValue(H_DEPOSIT_CAPACITY)>0)for(int cursor=int(words[headerValue(H_GRAIN_OFFSETS)+index]);cursor<int(words[headerValue(H_GRAIN_OFFSETS)+index+1]);cursor++){
            int entry=int(words[headerValue(H_GRAIN_ENTRIES)+cursor]);if(entry<8*headerValue(H_PARTICLE_CAPACITY))continue;
            int row=headerValue(H_PARTICLE_CAPACITY)+entry-8*headerValue(H_PARTICLE_CAPACITY);
            heatCapacity+=readDouble(headerValue(H_GRAIN_HEAT_CAPACITY)+2*row);availableThermalEnergy+=max(0.0,readDouble(headerValue(H_GRAIN_ENERGY)+2*row)-readDouble(headerValue(H_GRAIN_COLD_ENERGY)+2*row));
        }
        if(headerValue(H_SOURCE_ELASTIC)>=0){exchange=add(exchange,readDouble(headerValue(H_SOURCE_ELASTIC)+14*index));exchange=add(exchange,-readDouble(headerValue(H_TARGET_ELASTIC)+14*index));}
        if(headerValue(H_SOURCE_HEAT)>=0)exchange=add(exchange,-readDouble(headerValue(H_SOURCE_HEAT)+2*index));
        if(headerValue(H_EXTERNAL_WORK)>=0)exchange=add(exchange,readDouble(headerValue(H_EXTERNAL_WORK)+2*index));
    }else if(index<headerValue(H_CELLS)+headerValue(H_GAS_CAPACITY)){
        int gas=index-headerValue(H_CELLS);
        if(headerValue(H_GAS_POTENTIAL)>=0)exchange=twoSum(readDouble(headerValue(H_GAS_POTENTIAL)+4*gas),readDouble(headerValue(H_GAS_POTENTIAL)+4*gas+2));
        if(headerValue(H_GAS_WORK)>=0)exchange=add(exchange,-readDouble(headerValue(H_GAS_WORK)+2*gas));
        if(headerValue(H_GAS_EXTERNAL_WORK)>=0)exchange=add(exchange,readDouble(headerValue(H_GAS_EXTERNAL_WORK)+2*gas));
        if(headerValue(H_GAS_ENERGY)>=0&&gas<int(words[headerValue(H_GAS_COUNTS)])){
            heatCapacity=gasCapacity(gas);availableThermalEnergy=gasAvailable(gas);
        }
    }
    else{
        int particle=index-headerValue(H_CELLS)-headerValue(H_GAS_CAPACITY);
        if(particle<int(words[headerValue(H_GRAIN_COUNTS)])){
            for(int i=0;i<4;i++)exchange=add(exchange,readDouble(headerValue(H_GRAIN_TERMS)+8*particle+2*i));
            if(headerValue(H_GRAIN_SOURCE_HEAT)>=0)exchange=add(exchange,-readDouble(headerValue(H_GRAIN_SOURCE_HEAT)+2*particle));
            if(headerValue(H_GRAIN_EXTERNAL_WORK)>=0)exchange=add(exchange,readDouble(headerValue(H_GRAIN_EXTERNAL_WORK)+2*particle));
            heatCapacity=readDouble(headerValue(H_GRAIN_HEAT_CAPACITY)+2*particle);availableThermalEnergy=max(0.0,readDouble(headerValue(H_GRAIN_ENERGY)+2*particle)-readDouble(headerValue(H_GRAIN_COLD_ENERGY)+2*particle));
        }
    }
    writeEnergyTerms(headerValue(H_VERTEX_DATA),index,dvec4(exchange,heatCapacity,availableThermalEnergy));
    int count=int(words[headerValue(H_BODY_COUNTS)+index]);words[headerValue(H_BLOCK_COUNTS)+index]=uint((count+127)/128);
}
void mapBlocks(int root){
    int begin=int(words[headerValue(H_BLOCK_OFFSETS)+root]),end=int(words[headerValue(H_BLOCK_OFFSETS)+root+1]);
    for(int i=begin;i<end;i++)words[headerValue(H_BLOCK_ROOTS)+i]=uint(root);
    if(root==0){uint blocks=words[headerValue(H_BLOCK_OFFSETS)+headerValue(H_VERTICES)];words[headerValue(H_DISPATCH)]=min(blocks,65535u);words[headerValue(H_DISPATCH)+1]=(blocks+65534u)/65535u;words[headerValue(H_DISPATCH)+2]=1u;}
}
void reduceBlock(int block,int lane){
    int blocks=int(words[headerValue(H_BLOCK_OFFSETS)+headerValue(H_VERTICES)]);dvec4 item=dvec4(0.0);
    if(block<blocks){
        int root=int(words[headerValue(H_BLOCK_ROOTS)+block]),begin=int(words[headerValue(H_BODY_OFFSETS)+root]),end=int(words[headerValue(H_BODY_OFFSETS)+root+1]);
        int cursor=begin+128*(block-int(words[headerValue(H_BLOCK_OFFSETS)+root]))+lane;
        if(cursor<end)item=readEnergyTerms(headerValue(H_VERTEX_DATA),int(words[headerValue(H_BODY_MEMBERS)+cursor]));
    }
    partial[lane]=item;barrier();
    for(int stride=64;stride>0;stride/=2){if(lane<stride)partial[lane]=combine(partial[lane],partial[lane+stride]);barrier();}
    if(lane==0&&block<blocks)writeEnergyTerms(headerValue(H_PARTIALS),block,partial[0]);
}
void reduceBody(int block,int lane){
    int blocks=int(words[headerValue(H_BLOCK_OFFSETS)+headerValue(H_VERTICES)]);if(block>=blocks)return;
    int root=int(words[headerValue(H_BLOCK_ROOTS)+block]);
    // One workgroup owns each nonempty body. The existing block dispatch also covers isolated cells.
    if(block!=int(words[headerValue(H_BLOCK_OFFSETS)+root]))return;
    dvec4 total=dvec4(0.0);dvec2 weights=dvec2(0.0),residual=dvec2(0.0);
    for(int cursor=block+lane;cursor<int(words[headerValue(H_BLOCK_OFFSETS)+root+1]);cursor+=128){
        dvec4 part=readEnergyTerms(headerValue(H_PARTIALS),cursor);total.xy=add(total.xy,part.xy);
        dvec2 next=weights+part.zw,delta=next-weights;residual+=(weights-(next-delta))+(part.zw-delta);weights=next;
    }
    partial[lane]=dvec4(total.xy,weights);weightErrors[lane]=residual;barrier();
    for(int stride=64;stride>0;stride/=2){
        if(lane<stride){
            partial[lane].xy=add(partial[lane].xy,partial[lane+stride].xy);
            dvec2 capacity=add(dvec2(partial[lane].z,weightErrors[lane].x),dvec2(partial[lane+stride].z,weightErrors[lane+stride].x));
            dvec2 available=add(dvec2(partial[lane].w,weightErrors[lane].y),dvec2(partial[lane+stride].w,weightErrors[lane+stride].y));
            partial[lane].zw=dvec2(capacity.x,available.x);weightErrors[lane]=dvec2(capacity.y,available.y);
        }
        barrier();
    }
    if(lane==0){
        total=partial[0];total.zw+=weightErrors[0];writeEnergyTerms(headerValue(H_BODY_DATA),root,total);
        double work=total.x+total.y;
        if((work!=0.0&&total.z<=0.0)||-work>total.w)atomicOr(errors,ERROR_MECHANICAL_ENERGY);
    }
}
void postCell(int index){
    if(headerValue(H_ACTIVITY_CELLS)>=0&&words[headerValue(H_ACTIVITY_CELLS)+index]==0u)return;
    int root=int(words[headerValue(H_BODY_PARENTS)+index]);dvec4 body=readEnergyTerms(headerValue(H_BODY_DATA),root);double work=body.x+body.y;
    if(work==0.0)return;
    bool cooling=work<0.0;double totalWeight=cooling?body.w:body.z;
    for(int stock=int(words[targetFieldOffset(L_CELL_OFFSETS)+index]);stock<int(words[targetFieldOffset(L_CELL_OFFSETS)+index+1]);stock++){
        double initialEnergy=readDouble(targetFieldOffset(L_ENERGY_BITS)+2*stock),minimumEnergy=readDouble(headerValue(H_COLD_ENERGY)+2*stock);
        double thermalWeight=cooling?max(0.0,initialEnergy-minimumEnergy):readDouble(headerValue(H_HEAT_CAPACITY)+2*stock);
        if(thermalWeight==0.0)continue;
        double energyShare=work*(thermalWeight/totalWeight),finalEnergy=max(minimumEnergy,initialEnergy+energyShare);
        dvec2 change=twoSum(finalEnergy,-initialEnergy);writeDouble(targetFieldOffset(L_ENERGY_BITS)+2*stock,finalEnergy);
        writeDouble(headerValue(H_ENERGY_CHANGES)+4*stock,change.x);writeDouble(headerValue(H_ENERGY_CHANGES)+4*stock+2,change.y);
    }
}
void postGranular(int row){
    int vertex;
    if(row<headerValue(H_PARTICLE_CAPACITY)){if(row>=int(words[headerValue(H_GRAIN_COUNTS)]))return;vertex=headerValue(H_CELLS)+headerValue(H_GAS_CAPACITY)+row;}
    else{int deposit=row-headerValue(H_PARTICLE_CAPACITY);if(deposit>=int(words[headerValue(H_GRAIN_COUNTS)+1]))return;vertex=int(words[headerValue(H_DEPOSIT_CELL)+deposit]);}
    int root=int(words[headerValue(H_BODY_PARENTS)+vertex]);dvec4 body=readEnergyTerms(headerValue(H_BODY_DATA),root);double work=body.x+body.y;
    if(work==0.0)return;double initialEnergy=readDouble(headerValue(H_GRAIN_ENERGY)+2*row),minimumEnergy=readDouble(headerValue(H_GRAIN_COLD_ENERGY)+2*row);
    double thermalWeight=work<0.0?max(0.0,initialEnergy-minimumEnergy):readDouble(headerValue(H_GRAIN_HEAT_CAPACITY)+2*row),totalWeight=work<0.0?body.w:body.z;
    if(thermalWeight==0.0)return;double finalEnergy=max(minimumEnergy,initialEnergy+work*(thermalWeight/totalWeight));
    dvec2 change=twoSum(finalEnergy,-initialEnergy);writeDouble(headerValue(H_GRAIN_ENERGY)+2*row,finalEnergy);
    writeDouble(headerValue(H_GRAIN_CHANGES)+4*row,change.x);writeDouble(headerValue(H_GRAIN_CHANGES)+4*row+2,change.y);
}
void postGas(int gas){
    writeDouble(headerValue(H_GAS_ENERGY_CHANGES)+4*gas,0.0);writeDouble(headerValue(H_GAS_ENERGY_CHANGES)+4*gas+2,0.0);
    if(gas>=int(words[headerValue(H_GAS_COUNTS)]))return;int root=int(words[headerValue(H_BODY_PARENTS)+headerValue(H_CELLS)+gas]);dvec4 body=readEnergyTerms(headerValue(H_BODY_DATA),root);double work=body.x+body.y;
    if(work==0.0)return;double initialEnergy=readDouble(headerValue(H_GAS_ENERGY)+2*gas),minimumEnergy=initialEnergy-readEnergyTerms(headerValue(H_VERTEX_DATA),headerValue(H_CELLS)+gas).w,thermalWeight=work<0.0?readEnergyTerms(headerValue(H_VERTEX_DATA),headerValue(H_CELLS)+gas).w:gasCapacity(gas),totalWeight=work<0.0?body.w:body.z;
    if(thermalWeight==0.0)return;double finalEnergy=max(minimumEnergy,initialEnergy+work*(thermalWeight/totalWeight));dvec2 change=twoSum(finalEnergy,-initialEnergy);writeDouble(headerValue(H_GAS_ENERGY)+2*gas,finalEnergy);writeDouble(headerValue(H_GAS_ENERGY_CHANGES)+4*gas,change.x);writeDouble(headerValue(H_GAS_ENERGY_CHANGES)+4*gas+2,change.y);
}
void main(){
    int block=int(gl_WorkGroupID.y*gl_NumWorkGroups.x+gl_WorkGroupID.x),lane=int(gl_LocalInvocationID.x),item=block*128+lane;
    if(p.stage==STAGE_REDUCE_BLOCK){reduceBlock(block,lane);return;}
    if(p.stage==STAGE_REDUCE_BODY){reduceBody(block,lane);return;}
    if(errors!=0u)return;
    if(p.stage==STAGE_FACE_TERMS){if(item<headerValue(H_FACES))faceTerms(item);}
    else if(p.stage==STAGE_POTENTIAL_TERMS){if(item<headerValue(H_SOURCE_STOCK_CAPACITY))potentialTerms(item);gasPotential(item);}
    else if(p.stage==STAGE_VERTEX_TERMS){if(item<headerValue(H_VERTICES))computeVertexTerms(item);}
    else if(p.stage==STAGE_MAP_BLOCKS){if(item<headerValue(H_VERTICES))mapBlocks(item);}
    else if(p.stage==STAGE_CLEAR_ENERGY_CHANGES){if(item<headerValue(H_TARGET_STOCK_CAPACITY)){writeDouble(headerValue(H_ENERGY_CHANGES)+4*item,0.0);writeDouble(headerValue(H_ENERGY_CHANGES)+4*item+2,0.0);}}
    else if(p.stage==STAGE_POST_CELL){if(item<headerValue(H_CELLS))postCell(item);}
    else if(p.stage==STAGE_PARTICLE_TERMS){if(item<headerValue(H_PARTICLE_CAPACITY)+headerValue(H_DEPOSIT_CAPACITY))particleTerms(item);}
    else if(p.stage==STAGE_POST_GRANULAR){if(item<headerValue(H_PARTICLE_CAPACITY)+headerValue(H_DEPOSIT_CAPACITY))postGranular(item);}
    else if(p.stage==STAGE_POST_GAS){if(item<headerValue(H_GAS_CAPACITY))postGas(item);}
}
