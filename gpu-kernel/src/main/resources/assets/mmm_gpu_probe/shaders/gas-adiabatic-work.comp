#version 450
#extension GL_ARB_gpu_shader_fp64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
layout(local_size_x = 128) in;
layout(binding = 0, std430) buffer Candidate {
    uint words[];
};
layout(binding = 1, std430) buffer Errors {
    uint errors;
};
layout(push_constant) uniform Params {
    int header;
    int workHeader;
    int count;
}
p;
// HOST_LAYOUT
const uint ERROR_INVALID_STATE = 32768u;
const double LN2 = 0.693147180559945309417232121458176568LF;
int headerWord(int index) {
    return int(words[p.header + index]);
}
int workHeaderWord(int index) {
    return int(words[p.workHeader + index]);
}
int gasField(int field) {
    return headerWord(GAS_FIELDS + field);
}
double readDouble(int at) {
    return packDouble2x32(uvec2(words[at], words[at + 1]));
}
void writeDouble(int at, double value) {
    uvec2 bits = unpackDouble2x32(value);
    words[at] = bits.x;
    words[at + 1] = bits.y;
}
int64_t readInt64(int at) {
    return int64_t(uint64_t(words[at]) | (uint64_t(words[at + 1]) << 32));
}
bool isFinite(double value) {
    return !isnan(value) && !isinf(value);
}
void reportInvalid() {
    atomicOr(errors, ERROR_INVALID_STATE);
}
void addCompensated(inout double sum, inout double correction, double value) {
    precise double adjusted = value - correction;
    precise double next = sum + adjusted;
    correction = (next - sum) - adjusted;
    sum = next;
}
void twoSum(double a, double b, out double sum, out double error) {
    precise double s = a + b;
    precise double back = s - a;
    precise double remainder = (a - (s - back)) + (b - back);
    sum = s;
    error = remainder;
}
// GAS_CALORIC_FUNCTIONS

// Double-only elementary functions. Range reduction keeps |z| <= 1/3.
// The atanh series truncation is < 2e-24; binary64 arithmetic determines accuracy.
double twiceAtanh(double z) {
    precise double square = z * z, term = z, sum = z;
    for (int k = 3; k <= 49; k += 2) {
        term *= square;
        sum += term / double(k);
    }
    return 2.0LF * sum;
}
double logRatio(double first, double second) {
    double relative = (first - second) / second;
    if (isFinite(relative) && abs(relative) < 0.5LF)
        return twiceAtanh(relative / (2.0LF + relative));
    int ea, eb;
    double a = frexp(first, ea), b = frexp(second, eb);
    return double(ea - eb) * LN2 + twiceAtanh((a - b) / (a + b));
}
// |reduced exponent| <= ln(2)/2. The degree-18 Taylor remainder is < 2e-26.
// frexp/ldexp keep a finite scaled result when exp(exponent) alone would overflow.
double scaledExponential(double scale, double exponent) {
    if (!isFinite(exponent) || exponent > 4096.0LF)
        return packDouble2x32(uvec2(0u, 0x7ff00000u));
    if (exponent < -4096.0LF)
        return 0.0LF;
    int originalExponent;
    double mantissa = frexp(scale, originalExponent);
    int shift = int(round(exponent / LN2));
    precise double reduced = exponent - double(shift) * LN2;
    precise double term = 1.0LF, value = 1.0LF;
    for (int k = 1; k <= 18; k++) {
        term *= reduced / double(k);
        value += term;
    }
    int finalExponent = originalExponent + shift;
    double product = mantissa * value;
    int normalization;
    product = frexp(product, normalization);
    finalExponent += normalization;
    if (finalExponent > 1024)
        return packDouble2x32(uvec2(0u, 0x7ff00000u));
    // The model requires normal positive temperatures; its caller checks the lower limit.
    if (finalExponent < -1021)
        return 0.0LF;
    return ldexp(product, finalExponent);
}
void solve(int node) {
    if (node >= p.count)
        return;
    writeDouble(workHeaderWord(WORK_H_CANDIDATE_ENERGY) + 2 * node, 0.0);
    writeDouble(workHeaderWord(WORK_H_CANDIDATE_TEMPERATURE) + 2 * node, 0.0);
    writeDouble(workHeaderWord(WORK_H_WORK) + 4 * node, 0.0);
    writeDouble(workHeaderWord(WORK_H_WORK) + 4 * node + 2, 0.0);
    if (errors != 0u)
        return;
    int actual = int(words[gasField(GAS_COUNTS)]);
    if (actual < 0 || actual > headerWord(GAS_H_NODE_CAPACITY)) {
        reportInvalid();
        return;
    }
    if (node >= actual)
        return;
    double initialEnergy = readDouble(gasField(GAS_INTERNAL_ENERGY) + 2 * node),
           temperature = readDouble(headerWord(GAS_H_STATES) + 18 * node);
    if (!isFinite(initialEnergy) || !isFinite(temperature) || temperature < readDouble(p.header + GAS_H_MINIMUM_TEMPERATURE)) {
        reportInvalid();
        return;
    }
    int mode = int(words[workHeaderWord(WORK_H_MECHANICAL_MODES) + node]);
    if (mode < 0 || mode > 1) {
        reportInvalid();
        return;
    }
    writeDouble(workHeaderWord(WORK_H_CANDIDATE_ENERGY) + 2 * node, initialEnergy);
    writeDouble(workHeaderWord(WORK_H_CANDIDATE_TEMPERATURE) + 2 * node, temperature);
    int first, last;
    double anchor, mass, r;
    if (!inventory(node, first, last, anchor, mass, r))
        return;
    if (first == last) {
        if (initialEnergy != 0.0)
            reportInvalid();
        return;
    }
    if (words[gasField(GAS_ENERGY_PRESENT)] == 0u) {
        reportInvalid();
        return;
    }
    // The fixed-temperature reservoir carries compression heat in the isothermal profile.
    if (mode == 0 || headerWord(GAS_H_ISOTHERMAL) != 0)
        return;
    double oldVolume = readDouble(headerWord(GAS_H_NODE_VOLUMES) + 2 * node),
           futureVolume = readDouble(workHeaderWord(WORK_H_FUTURE_VOLUMES) + 2 * node);
    if (!(isFinite(oldVolume) && oldVolume > 0.0 && isFinite(futureVolume) && futureVolume > 0.0)) {
        reportInvalid();
        return;
    }
    if (oldVolume == futureVolume)
        return;
    double entropy = r * logRatio(oldVolume, futureVolume);
    if (!isFinite(entropy)) {
        reportInvalid();
        return;
    }
    bool heating = entropy >= 0.0;
    double remaining = abs(entropy), deltaEnergy = 0.0, correction = 0.0;
    while (remaining > 0.0) {
        double boundary, capacity = capacityAndBoundary(first, last, temperature, heating, boundary);
        if (!(isFinite(capacity) && capacity > 0.0)) {
            reportInvalid();
            return;
        }
        double interval =
            isFinite(boundary) ? capacity * abs(logRatio(boundary, temperature)) : packDouble2x32(uvec2(0u, 0x7ff00000u));
        double next;
        if (remaining <= interval) {
            next = scaledExponential(temperature, (heating ? remaining : -remaining) / capacity);
            if (!isFinite(next) || next < readDouble(p.header + GAS_H_MINIMUM_TEMPERATURE)) {
                reportInvalid();
                return;
            }
            next = heating ? clamp(next, temperature, boundary) : clamp(next, boundary, temperature);
            remaining = 0.0;
        } else {
            if (!(isFinite(boundary) && (heating ? boundary > temperature : boundary < temperature) && interval > 0.0)) {
                reportInvalid();
                return;
            }
            next = boundary;
            remaining -= interval;
        }
        addCompensated(deltaEnergy, correction, capacity * (next - temperature));
        temperature = next;
    }
    precise double finalEnergy = initialEnergy + deltaEnergy;
    double work, remainder;
    twoSum(finalEnergy, -initialEnergy, work, remainder);
    if (!(isFinite(finalEnergy) && isFinite(work) && isFinite(remainder))) {
        reportInvalid();
        return;
    }
    writeDouble(workHeaderWord(WORK_H_CANDIDATE_ENERGY) + 2 * node, finalEnergy);
    writeDouble(workHeaderWord(WORK_H_CANDIDATE_TEMPERATURE) + 2 * node, temperature);
    writeDouble(workHeaderWord(WORK_H_WORK) + 4 * node, work);
    writeDouble(workHeaderWord(WORK_H_WORK) + 4 * node + 2, remainder);
}
void main() {
    solve(int((gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x) * 128 + gl_LocalInvocationID.x));
}
