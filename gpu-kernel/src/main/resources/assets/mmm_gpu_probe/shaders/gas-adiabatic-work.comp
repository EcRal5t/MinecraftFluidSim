#version 450
#extension GL_ARB_gpu_shader_fp64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
layout(local_size_x=128) in;
layout(binding=0,std430) buffer Candidate { uint words[]; };
layout(binding=1,std430) buffer Errors { uint errors; };
layout(push_constant) uniform Params { int header;int workHeader;int count; } p;
const int COUNTS=0,ROW_OFFSETS=3,COMPONENTS=4,NANOS=5,MASS=6,SPECIES_OFFSETS=8,
          SPECIES_HANDLES=9,SPECIES_AMOUNTS=10,ENERGY_PRESENT=11,ENERGY=12;
const double LN2=0.693147180559945309417232121458176568LF;
int h(int index) { return int(words[p.header+index]); }
int wh(int index) { return int(words[p.workHeader+index]); }
int gas(int field) { return h(16+field); }
double number(int at) { return packDouble2x32(uvec2(words[at],words[at+1])); }
void putNumber(int at,double value) { uvec2 bits=unpackDouble2x32(value);words[at]=bits.x;words[at+1]=bits.y; }
int64_t integer(int at) { return int64_t(uint64_t(words[at])|(uint64_t(words[at+1])<<32)); }
bool finite(double value) { return !isnan(value)&&!isinf(value); }
void invalid() { atomicOr(errors,32768u); }
void addCompensated(inout double sum,inout double correction,double value) {
    precise double adjusted=value-correction;precise double next=sum+adjusted;
    correction=(next-sum)-adjusted;sum=next;
}
void twoSum(double a,double b,out double sum,out double error) {
    precise double s=a+b;precise double back=s-a;
    precise double remainder=(a-(s-back))+(b-back);sum=s;error=remainder;
}
// GAS_CALORIC_FUNCTIONS

// Double-only elementary functions. Range reduction keeps |z| <= 1/3.
// The atanh series truncation is < 2e-24; binary64 arithmetic determines accuracy.
double twiceAtanh(double z) {
    precise double square=z*z,term=z,sum=z;
    for(int k=3;k<=49;k+=2) {term*=square;sum+=term/double(k);}
    return 2.0LF*sum;
}
double logRatio(double first,double second) {
    double relative=(first-second)/second;
    if(finite(relative)&&abs(relative)<0.5LF)return twiceAtanh(relative/(2.0LF+relative));
    int ea,eb;double a=frexp(first,ea),b=frexp(second,eb);
    return double(ea-eb)*LN2+twiceAtanh((a-b)/(a+b));
}
// |reduced exponent| <= ln(2)/2. The degree-18 Taylor remainder is < 2e-26.
// frexp/ldexp keep a finite scaled result when exp(exponent) alone would overflow.
double scaledExponential(double scale,double exponent) {
    if(!finite(exponent)||exponent>4096.0LF)return packDouble2x32(uvec2(0u,0x7ff00000u));
    if(exponent< -4096.0LF)return 0.0LF;
    int originalExponent;double mantissa=frexp(scale,originalExponent);
    int shift=int(round(exponent/LN2));
    precise double reduced=exponent-double(shift)*LN2;
    precise double term=1.0LF,value=1.0LF;
    for(int k=1;k<=18;k++){term*=reduced/double(k);value+=term;}
    int finalExponent=originalExponent+shift;
    double product=mantissa*value;int normalization;product=frexp(product,normalization);
    finalExponent+=normalization;
    if(finalExponent>1024)return packDouble2x32(uvec2(0u,0x7ff00000u));
    // The model requires normal positive temperatures; its caller checks the lower limit.
    if(finalExponent< -1021)return 0.0LF;
    return ldexp(product,finalExponent);
}
void solve(int node) {
    if(node>=p.count)return;
    putNumber(wh(2)+2*node,0.0);putNumber(wh(3)+2*node,0.0);
    putNumber(wh(4)+4*node,0.0);putNumber(wh(4)+4*node+2,0.0);
    if(errors!=0u)return;
    int actual=int(words[gas(COUNTS)]);
    if(actual<0||actual>h(0)){invalid();return;}if(node>=actual)return;
    double initialEnergy=number(gas(ENERGY)+2*node),temperature=number(h(9)+18*node);
    if(!finite(initialEnergy)||!finite(temperature)||temperature<number(p.header+34)){invalid();return;}
    int mode=int(words[wh(1)+node]);if(mode<0||mode>1){invalid();return;}
    putNumber(wh(2)+2*node,initialEnergy);putNumber(wh(3)+2*node,temperature);
    int first,last;double anchor,mass,r;
    if(!inventory(node,first,last,anchor,mass,r))return;
    if(first==last) {if(initialEnergy!=0.0)invalid();return;}
    if(words[gas(ENERGY_PRESENT)]==0u){invalid();return;}
    if(mode==0)return;
    double oldVolume=number(h(3)+2*node),futureVolume=number(wh(0)+2*node);
    if(!(finite(oldVolume)&&oldVolume>0.0&&finite(futureVolume)&&futureVolume>0.0)){invalid();return;}
    if(oldVolume==futureVolume)return;
    double entropy=r*logRatio(oldVolume,futureVolume);
    if(!finite(entropy)){invalid();return;}
    bool heating=entropy>=0.0;double remaining=abs(entropy),deltaEnergy=0.0,correction=0.0;
    while(remaining>0.0) {
        double boundary,capacity=capacityAndBoundary(first,last,temperature,heating,boundary);
        if(!(finite(capacity)&&capacity>0.0)){invalid();return;}
        double interval=finite(boundary)?capacity*abs(logRatio(boundary,temperature)):
                packDouble2x32(uvec2(0u,0x7ff00000u));
        double next;
        if(remaining<=interval) {
            next=scaledExponential(temperature,(heating?remaining:-remaining)/capacity);
            if(!finite(next)||next<number(p.header+34)){invalid();return;}
            next=heating?clamp(next,temperature,boundary):clamp(next,boundary,temperature);
            remaining=0.0;
        } else {
            if(!(finite(boundary)&&(heating?boundary>temperature:boundary<temperature)&&interval>0.0)){invalid();return;}
            next=boundary;remaining-=interval;
        }
        addCompensated(deltaEnergy,correction,capacity*(next-temperature));temperature=next;
    }
    precise double finalEnergy=initialEnergy+deltaEnergy;
    double work,remainder;twoSum(finalEnergy,-initialEnergy,work,remainder);
    if(!(finite(finalEnergy)&&finite(work)&&finite(remainder))){invalid();return;}
    putNumber(wh(2)+2*node,finalEnergy);putNumber(wh(3)+2*node,temperature);
    putNumber(wh(4)+4*node,work);putNumber(wh(4)+4*node+2,remainder);
}
void main() { solve(int((gl_WorkGroupID.y*gl_NumWorkGroups.x+gl_WorkGroupID.x)*128+gl_LocalInvocationID.x)); }
