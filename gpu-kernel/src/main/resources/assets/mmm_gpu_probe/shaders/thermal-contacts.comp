void scatterSample(int id){if(id>=liveSamples())return;int cell=int(words[workField(FIELD_SAMPLE_CELL)+id]),slot=int(atomicAdd(words[workField(FIELD_CELL_CURSORS)+cell],1u)),at=int(words[workField(FIELD_CELL_OFFSETS)+cell])+slot;words[workField(FIELD_CELL_SAMPLES)+at]=uint(id);}
