void deviceEdges(int point,bool writing,inout int count){
 int cell=int(words[f(SC)+point]),mask=int(words[f(SM)+point]),a=int(words[f(SO)+point]),fam=family(a);double k=number(f(KC)+2*a),v=fraction(point)*.125LF;
 for(int at=int(words[f(PO)+cell]);at<int(words[f(PO)+cell+1]);at++){
  int port=int(words[f(PR)+at]),device=int(words[h(141)+port]),b=ownerFor(deviceBase()+device);if(b<0){invalid();continue;}
  int direction=int(words[h(143)+port]),axis=direction/2,side=direction&1;double area=0.0;
  for(int bit=0;bit<8;bit++)if(((bit>>axis)&1)==side&&(mask&(1<<bit))!=0){
   double covered=number(f(COVER)+2*(8*h(4)+24*port+8*fam+bit)),solidCovered=number(f(COVER)+2*(8*h(4)+24*port+16+bit));
   if(covered<=0.0)continue;double dry=dryPort(cell,bit,axis,side),pore=h(149)<0?.125LF*double(bitCount(uint(openMask(cell)))):number(h(149)+8*cell+4);
   double porosity=pore/(.125LF*double(bitCount(uint(openMask(cell)))));
   double physical=fam==0?(.25LF-dry)*porosity:fam==1?dry*porosity:.25LF*min(1.0LF,solidCovered/.125LF);area+=physical*v/covered;
  }
