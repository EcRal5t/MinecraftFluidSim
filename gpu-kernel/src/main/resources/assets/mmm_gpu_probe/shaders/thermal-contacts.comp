   int other=int(words[workField(FIELD_CELL_SAMPLES)+at]);if(other<=id)continue;
   exchangePair(owner,int(words[workField(FIELD_SAMPLE_OWNER)+other]),sameConductance(id,other),dt);
  }
  for(int axis=0;axis<3;axis++){
   int cellB=neighbor(cell,axis,1);if(cellB<0)continue;
   for(int at=int(words[workField(FIELD_CELL_OFFSETS)+cellB]);at<int(words[workField(FIELD_CELL_OFFSETS)+cellB+1]);at++){
    int other=int(words[workField(FIELD_CELL_SAMPLES)+at]);
    exchangePair(owner,int(words[workField(FIELD_SAMPLE_OWNER)+other]),crossConductance(id,other,axis),dt);
   }
  }
  if(headerWord(H_DEVICE_COUNTS)>=0)for(int at=int(words[workField(FIELD_PORT_OFFSETS)+cell]);at<int(words[workField(FIELD_PORT_OFFSETS)+cell+1]);at++){
   int port=int(words[workField(FIELD_PORT_ROWS)+at]),other=ownerFor(deviceBase()+int(words[headerWord(H_PORT_DEVICE)+port]));
   if(other<0){reportInvalid();continue;}exchangePair(owner,other,deviceConductance(id,port),dt);
  }
 }
 for(int bath=int(words[workField(FIELD_BATH_OFFSETS)+id]);bath<int(words[workField(FIELD_BATH_OFFSETS)+id+1]);bath++){
  double g=readDouble(workField(FIELD_BATH_G)+2*bath);
  if(p.step==0){addOwnerValue(CONDUCTION_DEGREE,owner,g);continue;}
  double temperature=readDouble(workField(FIELD_BATH_T)+2*bath);
  double denominator=1.0LF+dt*readDouble(conductionField(CONDUCTION_DEGREE)+2*owner);
  precise double q=g*(temperature-readDouble(conductionField(CONDUCTION_TEMPERATURE)+2*owner))*dt/denominator;
  if(q!=0.0LF)addOwnerValue(CONDUCTION_FLUX,owner,q);
  writeDouble(conductionField(CONDUCTION_RESERVOIR_CHANGE)+2*bath*conductionHeaderWord(5),q);
 }
}
void spatialDispatch(){
 bool run=errors==0u;
 int groups=run?(liveSamples()+127)/128:0;
 words[workField(FIELD_MF_DISPATCH)]=uint(min(groups,65535));words[workField(FIELD_MF_DISPATCH)+1]=uint(max(1,(groups+65534)/65535));words[workField(FIELD_MF_DISPATCH)+2]=1u;
}
void graphInitialize(int row){if(row<headerWord(H_CONDUCTION_OWNER_CAPACITY)){words[conductionField(CONDUCTION_DEGREE_COUNTS)+row]=0u;words[conductionField(CONDUCTION_DEGREE_CURSORS)+row]=0u;}if(row==0){words[headerWord(H_CONDUCTION_HEADER)+7]=1u;words[conductionField(CONDUCTION_MODE)+1]=0u;words[headerWord(H_CONDUCTION_COUNTS)+2]=0u;}}
void publish(int owner){if(owner>=liveOwners())return;int kind=int(words[workField(FIELD_OWNER_KIND)+owner]),row=int(words[workField(FIELD_OWNER_INDEX)+owner]);double value=readDouble(headerWord(H_CONDUCTION_ENERGY)+2*owner);
 int address=(kind==0?headerWord(H_LIQUID_ENERGY):kind==1?headerWord(H_GAS_ENERGY):kind==2?headerWord(H_GRANULAR_ENERGY):kind==3?headerWord(H_COHERENT_ENERGY):headerWord(H_DEVICE_ENERGY))+2*row;
 if(kind==4){double old=readDouble(address);writeDouble(headerWord(H_DEVICE_ENERGY_CHANGE)+4*row,value);writeDouble(headerWord(H_DEVICE_ENERGY_CHANGE)+4*row+2,-old);if(readQuantity(address)!=readQuantity(headerWord(H_CONDUCTION_ENERGY)+2*owner)){uint64_t generation=readQuantity(headerWord(H_DEVICE_REQUEST_GENERATION)+2*row)+uint64_t(1);words[headerWord(H_DEVICE_GENERATION)+2*row]=uint(generation);words[headerWord(H_DEVICE_GENERATION)+2*row+1]=uint(generation>>32);}}
 writeDouble(address,value);
}
void main(){int block=int(gl_WorkGroupID.y*gl_NumWorkGroups.x+gl_WorkGroupID.x),lane=int(gl_LocalInvocationID.x),id=128*block+lane;
if(id>=p.count)return;
 if(p.stage==STAGE_SPATIAL_DISPATCH){if(id==0)spatialDispatch();return;}
 if(p.stage==STAGE_PREPARE_SPATIAL_FLUX){if(errors!=0u||id>=liveSamples())return;spatialFlux(id);return;}
 if(p.stage==STAGE_WRITE_BATHS){writeBaths(id);return;}if(p.stage==STAGE_INITIALIZE_GRAPH){graphInitialize(id);return;}
 if(p.stage==STAGE_UPDATE_MODE_REQUIREMENT){if(id==0)words[workField(FIELD_REQUIREMENTS)+4]=max(words[workField(FIELD_REQUIREMENTS)+4],words[conductionField(CONDUCTION_MODE)+1]);return;}
 if(p.stage==STAGE_SAVE_MODE_REQUIREMENT){if(id==0)words[workField(FIELD_REQUIREMENTS)+4]=words[conductionField(CONDUCTION_MODE)+1];return;}if(p.stage==STAGE_CLEAR){clear(id);return;}if(p.stage==STAGE_PREPARE_OWNER){prepareOwner(id);return;}if(p.stage==STAGE_PREPARE_TERMS){prepareTerms(id);return;}if(p.stage==STAGE_WRITE_CONTACTS){writeContacts(id);return;}if(errors!=0u)return;
 if(p.stage==STAGE_FLAG_OWNER)flagOwner(id);else if(p.stage==STAGE_FLAG_SAMPLE)flagSample(id);else if(p.stage==STAGE_PREPARE_SAMPLE)prepareSample(id);else if(p.stage==STAGE_SCATTER_SAMPLE)scatterSample(id);else if(p.stage==STAGE_COVERAGE)coverage(id);else if(p.stage==STAGE_COUNT_CONTACTS)contacts(id,false);else if(p.stage==STAGE_PUBLISH)publish(id);else if(p.stage==STAGE_COUNT_PORTS)portCount(id);else if(p.stage==STAGE_SCATTER_PORTS)portScatter(id);else if(p.stage==STAGE_COUNT_BATHS)countBaths(id);else if(p.stage==STAGE_PROJECT_CONTACT_GEOMETRY)projectContactGeometry(id);
}
