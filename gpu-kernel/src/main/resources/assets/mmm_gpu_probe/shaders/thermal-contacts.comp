void contacts(int point,bool writing){
 if(point>=liveSamples())return;int cell=int(words[f(SC)+point]),mask=int(words[f(SM)+point]),owner=int(words[f(SO)+point]),count=0;double fp=fraction(point),kp=number(f(KC)+2*owner),hcell=cellSize();
 if(kp==0.0){if(!writing)words[f(EC)+point]=0u;return;}
 for(int at=int(words[f(CO)+cell]);at<int(words[f(CO)+cell+1]);at++){
  int q=int(words[f(CS)+at]);if(q<=point||words[f(SO)+q]==uint(owner))continue;double kq=number(f(KC)+2*int(words[f(SO)+q]));
  double area=.125LF*double(bitCount(uint(mask)&words[f(SM)+q]))*double(pow(float(min(fp,fraction(q))),2.0/3.0));edge(point,q,2.0LF*harmonic(kp,kq)*hcell*area,0.0,writing,count);
