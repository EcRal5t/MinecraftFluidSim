 if(id<h(132)){put(h(140)+4*id,0.0);put(h(140)+4*id+2,0.0);}
 if(id<h(106))words[f(TERMS)+id]=0u;
 if(id<h(8)){words[f(EC)+id]=0u;words[f(SF)+id]=0u;}
 if(id<h(4)){words[f(CC)+id]=0u;words[f(CU)+id]=0u;words[f(PC)+id]=0u;words[f(PU)+id]=0u;}
 if(id==0){for(int i=0;i<4;i++)words[f(REQ)+i]=0u;for(int i=0;i<3;i++)words[h(96)+i]=0u;
  if(liveLiquid()<0||liveLiquid()>h(0)||liveGas()<0||liveGas()>h(1)||liveParticle()<0||liveParticle()>h(2)||liveDeposit()<0||liveDeposit()>h(3)||liveCoherent()<0||liveCoherent()>h(45)||liveDevice()<0||liveDevice()>h(132)||livePorts()<0||livePorts()>h(147))invalid();}
}
void flagOwner(int id){int kind,row;bool exists;ownerAddress(id,kind,row,exists);words[f(OF)+id]=exists&&hasMass(kind,row)?1u:0u;}
void prepareOwner(int candidate){
 if(candidate==0){int n=liveOwners();words[f(REQ)]=uint(n);words[h(96)]=uint(n);if(n>h(106))atomicOr(errors,64u);}
 if(words[f(OF)+candidate]==0u)return;int owner=int(words[f(OP)+candidate]);if(owner>=h(106))return;
 int kind,row;bool exists;ownerAddress(candidate,kind,row,exists);words[f(OK)+owner]=uint(kind);words[f(OI)+owner]=uint(row);
 double energy=0.0,temperature=0.0,k=0.0;int terms=1;
 if(kind==0){energy=number(h(22)+2*row);temperature=number(h(23)+2*row);k=number(f(K)+2*material(kind,int(words[h(18)+row])));}
 else if(kind==2){energy=number(h(36)+2*row);temperature=number(h(37)+2*row);k=number(f(K)+2*material(kind,int(words[h(33)+row])));}
 else if(kind==4){energy=number(h(134)+2*row);temperature=number(h(137)+2*row);k=number(f(K)+2*material(kind,int(words[h(136)+row])));}
 else if(kind==3){energy=number(h(113)+2*row);temperature=number(h(114)+2*row);k=number(f(K)+2*material(kind,int(words[h(110)+row])));}
 else{energy=number(h(28)+2*row);temperature=number(h(29)+18*row);terms=0;double total=0.0;
  for(int c=int(words[h(24)+row]);c<int(words[h(24)+row+1]);c++){double n=double(quantity(h(26)+2*c));k+=n*number(f(K)+2*material(kind,int(words[h(25)+c])));total+=n;if(quantity(h(27)+2*c)>uint64_t(0))terms++;}k/=total;}
 if(!(finite(energy)&&finite(temperature)&&temperature>0.0&&finite(k)&&k>=0.0&&terms>0)){invalid();return;}
