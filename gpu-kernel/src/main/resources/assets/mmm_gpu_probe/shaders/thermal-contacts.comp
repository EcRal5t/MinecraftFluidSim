 if(id<headerWord(H_LIQUID_CAPACITY)){owner=ownerFor(id);if(owner<0)return;cell=liquidCell(id);if(cell<0){reportInvalid();return;}mask=int(words[headerWord(H_LIQUID_SUPPORT_MASKS)+id]);if(mask==0)mask=openMask(cell);volume=readDouble(headerWord(H_LIQUID_VOLUMES)+2*id);return;}
