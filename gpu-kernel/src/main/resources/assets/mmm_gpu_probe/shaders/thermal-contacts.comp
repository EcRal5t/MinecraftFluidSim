 if(id<8*headerWord(H_PARTICLE_CAPACITY)){int particle=id/8,slot=id%8;owner=ownerFor(headerWord(H_LIQUID_CAPACITY)+headerWord(H_GAS_CAPACITY)+particle);if(owner<0)return;cell=int(words[headerWord(H_GRANULAR_SUPPORT_CELLS)+8*particle+slot]);uint64_t q=readQuantity(headerWord(H_GRANULAR_SUPPORT_QUOTAS)+2*(8*particle+slot));if(q==uint64_t(0)){owner=-1;return;}if(cell<0||cell>=headerWord(H_CELL_COUNT)){reportInvalid();owner=-1;return;}mask=openMask(cell);volume=double(q)/16777216.0LF;return;}
