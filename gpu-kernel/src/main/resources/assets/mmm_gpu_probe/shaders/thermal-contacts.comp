   double g=number(f(BG)+2*bath);precise double q=g*(number(f(BT)+2*bath)-number(cf(16)+2*owner))*dt;
   if(p.stage==43){double oldQ=number(cf(25)+2*bath*ch(5));delta=mfAdd(delta,q-oldQ);put(cf(25)+2*bath*ch(5),q);}else{degree=mfAdd(degree,g);delta=mfAdd(delta,q);}if(preparing)put(cf(25)+2*bath*ch(5),q);
  }
