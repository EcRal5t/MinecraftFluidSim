int material(int kind,int handle){int count=kind==0?h(41):kind==1?h(42):kind==2?h(43):kind==3?h(44):h(47),map=kind==0?f(LM):kind==1?f(GM):kind==2?f(PM):kind==3?f(CM):f(DM);
 if(handle<0||handle>=count){invalid();return 0;}return int(words[map+handle]);}
void ownerAddress(int candidate,out int kind,out int row,out bool exists){
 kind=0;row=candidate;exists=row<liveLiquid();
 if(candidate>=h(0)){kind=1;row=candidate-h(0);exists=row<liveGas();}
 if(candidate>=h(0)+h(1)){kind=2;row=candidate-h(0)-h(1);exists=row<h(2)?row<liveParticle():row-h(2)<liveDeposit();}
