dvec2 mfAdd(dvec2 a,double b){precise double next=a.x+b,v=next-a.x,error=(a.x-(next-v))+(b-v);precise double lo=error+a.y,sum=next+lo,virtualLo=sum-next;return dvec2(sum,(next-(sum-virtualLo))+(lo-virtualLo));}
void pairFlux(int owner,int other,double g,double dt,inout dvec2 degree,inout dvec2 delta){
 if(owner==other||g==0.0)return;if(!(finite(g)&&g>0.0)){invalid();return;}
 int a=min(owner,other),b=max(owner,other);
 precise double difference=number(cf(16)+2*b)-number(cf(16)+2*a);
 precise double q=g*difference*dt;
 degree=mfAdd(degree,g);delta=mfAdd(delta,owner==a?q:-q);
}
void spatialFlux(int id,bool preparing){
 int mode=int(words[cf(26)]);
 if(!preparing&&!(mode>0&&mode<=ch(5)&&p.step<mode&&!(mode==1&&p.step==0)))return;
 double dt=preparing?p.dt:p.dt/double(mode);dvec2 degree=dvec2(0.0),delta=dvec2(0.0);
 if(id<h(8)){
  if(id>=liveSamples())return;int owner=int(words[f(SO)+id]),cell=int(words[f(SC)+id]);
  if(number(f(KC)+2*owner)>0.0){
   for(int at=int(words[f(CO)+cell]);at<int(words[f(CO)+cell+1]);at++){
    int q=int(words[f(CS)+at]);if(q==id||int(words[f(SO)+q])==owner)continue;
    pairFlux(owner,int(words[f(SO)+q]),sameConductance(min(id,q),max(id,q)),dt,degree,delta);
   }
   for(int axis=0;axis<3;axis++)for(int side=0;side<2;side++){
    int other=neighbor(cell,axis,side);if(other<0)continue;
    for(int at=int(words[f(CO)+other]);at<int(words[f(CO)+other+1]);at++){
     int q=int(words[f(CS)+at]),b=int(words[f(SO)+q]);if(b==owner)continue;
     double g=side==1?crossConductance(id,q,axis):crossConductance(q,id,axis);pairFlux(owner,b,g,dt,degree,delta);
    }
   }
   if(h(133)>=0)for(int at=int(words[f(PO)+cell]);at<int(words[f(PO)+cell+1]);at++){
    int port=int(words[f(PR)+at]),b=ownerFor(deviceBase()+int(words[h(141)+port]));if(b<0){invalid();continue;}
    pairFlux(owner,b,deviceConductance(id,port),dt,degree,delta);
   }
  }
  for(int bath=int(words[f(BO)+id]);bath<int(words[f(BO)+id+1]);bath++){
   double g=number(f(BG)+2*bath);precise double q=g*(number(f(BT)+2*bath)-number(cf(16)+2*owner))*dt;
   degree=mfAdd(degree,g);delta=mfAdd(delta,q);put(cf(25)+2*(bath*ch(5)+(preparing?0:p.step)),q);
  }
 }else{
  int port=id-h(8);if(port>=livePorts())return;int owner=ownerFor(deviceBase()+int(words[h(141)+port]));if(owner<0)return;
  int cell=int(words[h(142)+port]);
  for(int at=int(words[f(CO)+cell]);at<int(words[f(CO)+cell+1]);at++){
   int point=int(words[f(CS)+at]);pairFlux(owner,int(words[f(SO)+point]),deviceConductance(point,port),dt,degree,delta);
  }
 }
 int target=f(MF_DATA)+8*id;if(preparing){put(target,degree.x);put(target+2,degree.y);}put(target+4,delta.x);put(target+6,delta.y);
}
void bathSummary(int block,int lane){
 int id=128*block+lane,count=int(words[cf(26)+1]);double huge=1.7976931348623157e308LF;
 double t=id<count?number(f(BT)+2*id):0.0;mfBounds[lane]=id<count?dvec4(t,t,0.0,0.0):dvec4(huge,-huge,0.0,0.0);barrier();
 for(int width=64;width>0;width/=2){if(lane<width){mfBounds[lane].x=min(mfBounds[lane].x,mfBounds[lane+width].x);mfBounds[lane].y=max(mfBounds[lane].y,mfBounds[lane+width].y);}barrier();}
 if(lane==0)for(int i=0;i<4;i++)put(cf(30)+2*(4*block+i),mfBounds[0][i]);
}
void spatialDispatch(){
 int mode=int(words[cf(26)]);bool run=errors==0u&&(p.step<0||(mode>0&&mode<=ch(5)&&p.step<mode&&!(mode==1&&p.step==0)));
 int groups=run?(liveSamples()+livePorts()+127)/128:0;
 words[f(MF_DISPATCH)]=uint(min(groups,65535));words[f(MF_DISPATCH)+1]=uint(max(1,(groups+65534)/65535));words[f(MF_DISPATCH)+2]=1u;
}
