  int other=neighbor(id,axis,1),base=f(FAC)+2*(15*id+5*axis),lowBits=(1<<axis)-1;double sum=0.0;bool reciprocal=true;
  for(int port=0;port<4;port++){
   double inverse=0.0;
   if(other>=0){int bit=(port&lowBits)|((port&~lowBits)<<1)|(1<<axis);
    double covered=max(number(f(COVER)+2*(8*id+bit)),number(f(COVER)+2*(8*other+(bit^(1<<axis)))));if(covered>0.0){inverse=1.0LF/covered;if(!(finite(inverse)&&inverse>0.0))inverse=-covered;}
   }
   put(base+2*port,inverse);if(inverse<0.0)reciprocal=false;else sum+=inverse;
  }
  put(base+8,reciprocal&&finite(sum)?sum:-1.0);
 }
 if(id<livePorts()){
  int cell=int(words[h(142)+id]),direction=int(words[h(143)+id]),axis=direction/2,side=direction&1,open=bitCount(uint(openMask(cell)));
  double pore=h(149)<0?.125LF*double(open):number(h(149)+8*cell+4),porosity=open==0?0.0:pore/(.125LF*double(open));
  for(int bit=0;bit<8;bit++){
   int base=f(COVER)+2*(8*h(4)+24*id+bit);
   double liquid=number(base),gas=number(base+16),solid=number(base+32);
   double liquidWeight=0.0,gasWeight=0.0,solidWeight=0.0;
   if(((bit>>axis)&1)==side&&open>0){
    double dry=dryPort(cell,bit,axis,side);
    if(liquid>0.0){liquidWeight=(.25LF-dry)*porosity*.125LF/liquid;if(!finite(liquidWeight))liquidWeight=-liquid;}
    if(gas>0.0){gasWeight=dry*porosity*.125LF/gas;if(!finite(gasWeight))gasWeight=-gas;}
    if(solid>0.0){solidWeight=(.25LF*min(1.0LF,solid/.125LF))*.125LF/solid;if(!finite(solidWeight))solidWeight=-solid;}
   }
   put(base,liquidWeight);put(base+16,gasWeight);put(base+32,solidWeight);
  }
 }
}
