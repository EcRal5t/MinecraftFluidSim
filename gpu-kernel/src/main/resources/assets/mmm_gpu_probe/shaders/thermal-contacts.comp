  int other=neighbor(cell,axis,1);if(other>=0)for(int at=int(words[f(CO)+other]);at<int(words[f(CO)+other+1]);at++){
   int q=int(words[f(CS)+at]);if(words[f(SO)+q]==uint(owner))continue;double fq=fraction(q),area=0.0;
   for(int bit=0;bit<8;bit++)if(((bit>>axis)&1)!=0&&(mask&(1<<bit))!=0&&(words[f(SM)+q]&(1u<<(bit^(1<<axis))))!=0u){double total=max(number(f(COVER)+2*(8*cell+bit)),number(f(COVER)+2*(8*other+(bit^(1<<axis)))));if(total>0.0)area+=.25LF*fp*fq/total;}
   edge(point,q,harmonic(kp,number(f(KC)+2*int(words[f(SO)+q])))*hcell*area,0.0,writing,count);
  }
