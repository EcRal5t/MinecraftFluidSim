}
void scatterSample(int id){if(id>=liveSamples())return;int cell=int(words[f(SC)+id]),at=int(words[f(CO)+cell]+atomicAdd(words[f(CU)+cell],1u));words[f(CS)+at]=uint(id);}
double fraction(int point){return number(f(SV)+2*point)/(.125LF*double(bitCount(words[f(SM)+point])));}
int family(int owner){int kind=int(words[f(OK)+owner]);return kind<2?kind:2;}
void coverage(int cell){double sums[32];for(int i=0;i<32;i++)sums[i]=0.0;
 for(int at=int(words[f(CO)+cell]);at<int(words[f(CO)+cell+1]);at++){
  int point=int(words[f(CS)+at]),mask=int(words[f(SM)+point]),fam=family(int(words[f(SO)+point]));double portion=fraction(point);
  for(int bit=0;bit<8;bit++)if((mask&(1<<bit))!=0){sums[bit]+=portion;if(h(133)>=0&&words[f(PC)+cell]>0u)sums[8+8*fam+bit]+=portion*.125LF;}
 }
 for(int bit=0;bit<8;bit++)put(f(COVER)+2*(8*cell+bit),sums[bit]);
 if(h(133)>=0)for(int at=int(words[f(PO)+cell]);at<int(words[f(PO)+cell+1]);at++){
  int port=int(words[f(PR)+at]);for(int i=0;i<24;i++)put(f(COVER)+2*(8*h(4)+24*port+i),sums[8+i]);
 }
}
double harmonic(double a,double b){if(a==0.0||b==0.0)return 0.0;double lo=min(a,b),hi=max(a,b);return lo*(2.0LF/(1.0LF+lo/hi));}
ivec3 shape(){return ivec3(h(5),h(6),h(7));}ivec3 xyz(int cell){ivec3 s=shape();return ivec3(cell%s.x,cell/s.x%s.y,cell/(s.x*s.y));}
int neighbor(int cell,int axis,int side){ivec3 q=xyz(cell),s=shape();q[axis]+=side==0?-1:1;if(any(lessThan(q,ivec3(0)))||any(greaterThanEqual(q,s)))return -1;return (q.z*s.y+q.y)*s.x+q.x;}
double blocked(int cell,int axis,int side){if(h(13)>=0)return 1.0LF-number(h(13)+2*(6*cell+2*axis+side));int other=neighbor(cell,axis,side);if(other<0)return 1.0;
 int a=openMask(cell),b=openMask(other),ports=0;for(int bit=0;bit<8;bit++)if(((bit>>axis)&1)==side&&(a&(1<<bit))!=0&&(b&(1<<(bit^(1<<axis))))!=0)ports++;return 1.0LF-double(ports)*.25LF;}
int clipPort(inout vec2 polygon[8],int count,vec3 plane){
 vec2 next[8],previous=polygon[count-1];float before=dot(plane.xy,previous)-plane.z;int n=0;
 for(int i=0;i<count;i++){vec2 point=polygon[i];float d=dot(plane.xy,point)-plane.z;if((d>=0)!=(before>=0))next[n++]=mix(previous,point,before/(before-d));if(d>=0)next[n++]=point;previous=point;before=d;}
 for(int i=0;i<n;i++)polygon[i]=next[i];return n;
}
double dryPort(int cell,int bit,int axis,int side){
 if(h(148)<0)return 0.0;double pore=number(h(149)+8*cell+4),fill=number(h(149)+8*cell+6);
 if(fill>0.0&&fill<1.0&&fill<=.015625&&pore>0.0)return .25;
 double microPore=pore/double(bitCount(uint(openMask(cell)))),fraction=microPore>0.0?number(h(150)+2*(8*cell+bit))/microPore:1.0;
 if(fraction<=0.0)return .25;if(fraction>=1.0)return 0.0;
