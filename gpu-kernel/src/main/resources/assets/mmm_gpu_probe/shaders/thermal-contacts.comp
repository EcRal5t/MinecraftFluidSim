  if(p.stage==41){atomicOr(words[f(IMEX_FLAGS)+otherPoint],1u);if(imexFast(other)){atomicOr(words[cf(53)+owner],1u);degree.x+=1.0;}}
  else if(imexFast(other)){frozenG[2*imexCursor]=g;frozenG[2*imexCursor+1]=double(other);imexCursor++;}
  return;
 }
 if(p.stage==43){
  int a=min(owner,other),b=max(owner,other);double oldA=number(cf(2)+2*a),oldB=number(cf(2)+2*b);
  double newA=imexFast(a)?number(cf(16)+2*a):oldA,newB=imexFast(b)?number(cf(16)+2*b):oldB;
  precise double oldQ=g*(oldB-oldA)*dt,newQ=g*(newB-newA)*dt;
  delta=mfAdd(delta,owner==a?newQ-oldQ:oldQ-newQ);return;
 }
