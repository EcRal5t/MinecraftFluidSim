void prepareTerms(int candidate){
 if(candidate==0){uint total=words[h(99)+h(106)];words[f(REQ)+1]=total;words[h(96)+1]=total;if(total>uint(h(107)))atomicOr(errors,64u);}
 if(errors!=0u||words[h(99)+h(106)]>uint(h(107))||words[f(OF)+candidate]==0u)return;int owner=int(words[f(OP)+candidate]);if(owner>=h(106))return;
 int kind,row;bool exists;ownerAddress(candidate,kind,row,exists);int outAt=int(words[h(99)+owner]);
 if(kind!=1){int handle=int(words[(kind==0?h(18):kind==2?h(33):kind==3?h(110):h(136))+row]);words[h(100)+outAt]=uint(material(kind,handle));put(h(101)+2*outAt,double(quantity((kind==0?h(21):kind==2?h(35):kind==3?h(112):h(135))+2*row))*1e-10LF);}
 else for(int c=int(words[h(24)+row]);c<int(words[h(24)+row+1]);c++)if(quantity(h(27)+2*c)>uint64_t(0)){
  words[h(100)+outAt]=uint(material(kind,int(words[h(25)+c])));put(h(101)+2*outAt,double(quantity(h(27)+2*c))*1e-10LF);outAt++;}
}
int liquidCell(int row){int lo=0,hi=h(4);while(lo<hi){int mid=(lo+hi)/2;if(int(words[h(17)+mid+1])<=row)lo=mid+1;else hi=mid;}return lo<h(4)?lo:-1;}
void sampleAddress(int id,out int owner,out int cell,out int mask,out double volume){
 owner=-1;cell=-1;mask=0;volume=0.0;
 if(id<h(0)){owner=ownerFor(id);if(owner<0)return;cell=liquidCell(id);if(cell<0){invalid();return;}mask=int(words[h(19)+id]);if(mask==0)mask=openMask(cell);volume=number(h(20)+2*id);return;}
 id-=h(0);int gasSamples=h(15)<0?0:h(4);
 if(id<gasSamples){cell=id;int node=int(words[h(30)+cell]);if(node<=0)return;owner=ownerFor(h(0)+node-1);mask=int(words[h(32)+cell]);double h3=cellSize()*cellSize()*cellSize();volume=number(h(31)+2*cell)/h3;return;}
 id-=gasSamples;
 if(id<8*h(2)){int particle=id/8,slot=id%8;owner=ownerFor(h(0)+h(1)+particle);if(owner<0)return;cell=int(words[h(38)+8*particle+slot]);uint64_t q=quantity(h(39)+2*(8*particle+slot));if(q==uint64_t(0)){owner=-1;return;}if(cell<0||cell>=h(4)){invalid();owner=-1;return;}mask=openMask(cell);volume=double(q)/16777216.0LF;return;}
 id-=8*h(2);if(id<h(3)){owner=ownerFor(h(0)+h(1)+h(2)+id);if(owner<0)return;cell=int(words[h(40)+id]);if(cell<0||cell>=h(4)){invalid();owner=-1;return;}mask=openMask(cell);volume=double(quantity(h(34)+2*(h(2)+id)))/16777216.0LF;return;}
 id-=h(3);if(id<h(45)){owner=ownerFor(h(0)+h(1)+h(2)+h(3)+id);if(owner<0)return;cell=int(words[h(109)+id]);if(cell<0||cell>=h(4)){invalid();owner=-1;return;}mask=openMask(cell);volume=double(quantity(h(111)+2*id))/16777216.0LF;}
