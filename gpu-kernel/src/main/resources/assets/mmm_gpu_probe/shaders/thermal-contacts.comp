   double temperature=number(h(12)+2*(6*cell+2*axis+side));if(isnan(temperature))continue;if(!(finite(temperature)&&temperature>0.0)){invalid();continue;}
   int pieces=0;for(int bit=0;bit<8;bit++)if(((bit>>axis)&1)==side&&(mask&(1<<bit))!=0)pieces++;
   edge(point,-1,2.0LF*kp*hcell*.25LF*double(pieces)*fp*blocked(cell,axis,side),temperature,writing,count);
  }
