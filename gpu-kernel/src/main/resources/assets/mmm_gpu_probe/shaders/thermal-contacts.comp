  if(!(finite(g)&&g>=0.0)){invalid();continue;}if(g==0.0)continue;
  if(writing){int outAt=int(words[f(EO)+point])+count;if(outAt>=h(108)){atomicOr(errors,64u);return;}words[h(102)+outAt]=uint(min(a,b));words[h(103)+outAt]=uint(max(a,b));put(h(104)+2*outAt,g);put(h(105)+2*outAt,0.0);}count++;
 }
}
void portCount(int id){if(id>=livePorts())return;int cell=int(words[h(142)+id]),device=int(words[h(141)+id]),dir=int(words[h(143)+id]);if(cell<0||cell>=h(4)||device<0||device>=liveDevice()||dir<0||dir>5){invalid();return;}atomicAdd(words[f(PC)+cell],1u);}
void portScatter(int id){if(id>=livePorts())return;int cell=int(words[h(142)+id]);words[f(PR)+words[f(PO)+cell]+atomicAdd(words[f(PU)+cell],1u)]=uint(id);}
void edge(int point,int other,double g,double bath,bool writing,inout int count){
 if(!(finite(g)&&g>=0.0)){invalid();return;}if(g==0.0)return;int a=int(words[f(SO)+point]),b=other<0?-1:int(words[f(SO)+other]);if(a==b)return;
