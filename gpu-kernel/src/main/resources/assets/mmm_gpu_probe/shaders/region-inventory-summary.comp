#version 450
#extension GL_ARB_gpu_shader_fp64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
// HOST_LAYOUT
layout(local_size_x=128) in;
layout(binding=0,std430) readonly buffer Source { uint words[]; };
layout(binding=1,std430) buffer Summary { uint outWords[]; };
layout(push_constant) uniform Params { int stage;int count;int groups;int unused; } p;
shared uint64_t totals[1024];shared double scalars[512];
int h(int i){return int(outWords[i]);}int ch(int header,int i){return int(words[header+i]);}
double num(int a){return packDouble2x32(uvec2(words[a],words[a+1]));}
double outnum(int a){return packDouble2x32(uvec2(outWords[a],outWords[a+1]));}
uint64_t raw(int a){uint64_t x=uint64_t(words[a])|(uint64_t(words[a+1])<<32);if(x>0x7ffffffffffffffful){atomicOr(outWords[H_ERROR],1u);return 0ul;}return x;}
void integer(int a,uint64_t x){outWords[a]=uint(x);outWords[a+1]=uint(x>>32);}
void store(int a,double x){uvec2 v=unpackDouble2x32(x);outWords[a]=v.x;outWords[a+1]=v.y;}
uint64_t sum(uint64_t a,uint64_t b){if(a>0x7ffffffffffffffful-b){atomicOr(outWords[H_ERROR],1u);return 0ul;}return a+b;}
// Caloric inversion reads actual U, material and composition, including a cold-import generation.
// The tables and segment traversal are the same as the resident caloric-state producer.
double temperature(int header,int row){
 double mass=double(raw(ch(header,CAL_MASSES)+2*row))*1e-10;if(mass==0.0)return 0.0;int material=int(words[ch(header,CAL_MATERIALS)+row]);
 double base=mass*num(ch(header,CAL_MATERIAL_REFERENCE)+2*material),energy=num(ch(header,CAL_ENERGIES)+2*row);
 for(int item=int(words[ch(header,CAL_SPECIES_OFFSETS)+row]);item<int(words[ch(header,CAL_SPECIES_OFFSETS)+row+1]);item++){
  int species=int(words[ch(header,CAL_SPECIES_HANDLES)+item]);base+=double(raw(ch(header,CAL_SPECIES_AMOUNTS)+2*item))*num(ch(header,CAL_SPECIES_REFERENCE)+2*(material*ch(header,CAL_SPECIES_STRIDE)+species));
 }
 int first=int(words[ch(header,CAL_SEGMENT_OFFSETS)+material]),last=int(words[ch(header,CAL_SEGMENT_OFFSETS)+material+1])-1,segment=first;
 double t=num(ch(header,CAL_REFERENCE_TEMPERATURE)+2*material),remaining=energy-base;
 while(segment<last&&t>=num(ch(header,CAL_SEGMENT_UPPER)+2*segment))segment++;
 if(remaining>=0.0){for(;;segment++){double capacity=mass*num(ch(header,CAL_SEGMENT_CAPACITY)+2*segment),upper=num(ch(header,CAL_SEGMENT_UPPER)+2*segment),span=(upper-t)*capacity;
  if(segment==last||remaining<span){t+=remaining/capacity;break;}remaining-=span;t=upper;}}
 else{remaining=-remaining;for(;;segment--){double capacity=mass*num(ch(header,CAL_SEGMENT_CAPACITY)+2*segment),lower=segment==first?0.0:num(ch(header,CAL_SEGMENT_UPPER)+2*(segment-1)),span=(t-lower)*capacity;
  if(segment==first||remaining<=span){t-=remaining/capacity;break;}remaining-=span;t=lower;}}
 if(isnan(t)||isinf(t)||t<=0.0)atomicOr(outWords[H_ERROR],2u);return t;
}
void includeTemperature(int header,int row,inout double low,inout double high){if(h(H_THERMAL_BOUND)==0||header<0)return;double t=temperature(header,row);if(t>0.0){low=min(low,t);high=max(high,t);}}
void main(){int lane=int(gl_LocalInvocationID.x),group=int(gl_WorkGroupID.x),id=128*group+lane;
 if(p.stage==0){uint64_t q[8];for(int i=0;i<8;i++)q[i]=0ul;double v=0.0,low=1.0/0.0,high=-1.0/0.0,deviceEnergy=0.0;
  if(id<int(words[h(H_LIQUID_COUNTS)])){v=num(h(H_LIQUID_VOLUMES)+2*id)*outnum(H_CELL_VOLUME);q[0]=raw(h(H_LIQUID_MASS)+2*id);for(int item=int(words[h(H_SPECIES_OFFSETS)+id]);item<int(words[h(H_SPECIES_OFFSETS)+id+1]);item++)q[1]=sum(q[1],raw(h(H_SPECIES_AMOUNTS)+2*item));includeTemperature(h(H_LIQUID_THERMAL),id,low,high);}
  if(h(H_GRAIN_COUNTS)>=0&&(id<h(H_PARTICLE_CAPACITY)?id<int(words[h(H_GRAIN_COUNTS)]):id-h(H_PARTICLE_CAPACITY)<int(words[h(H_GRAIN_COUNTS)+1]))){q[2]=raw(h(H_GRAIN_VOLUME)+2*id);q[3]=raw(h(H_GRAIN_MASS)+2*id);includeTemperature(h(H_GRAIN_THERMAL),id,low,high);}
  if(h(H_COHERENT_COUNTS)>=0&&id<int(words[h(H_COHERENT_COUNTS)])){q[4]=raw(h(H_COHERENT_VOLUME)+2*id);q[5]=raw(h(H_COHERENT_MASS)+2*id);includeTemperature(h(H_COHERENT_THERMAL),id,low,high);}
  if(h(H_GAS_COUNTS)>=0){int nodes=int(words[h(H_GAS_COUNTS)]),componentEnd=int(words[h(H_GAS_COMPONENT_OFFSETS)+nodes]);if(id<componentEnd){q[6]=raw(h(H_GAS_VOLUME)+2*id);q[7]=raw(h(H_GAS_MASS)+2*id);}
   if(h(H_THERMAL_BOUND)!=0&&id<nodes&&words[h(H_GAS_COMPONENT_OFFSETS)+id]!=words[h(H_GAS_COMPONENT_OFFSETS)+id+1]){double t=num(h(H_GAS_THERMAL)+2*(9*id));if(t>0.0){low=min(low,t);high=max(high,t);}}}
  if(h(H_DEVICE_COUNTS)>=0&&id<int(words[h(H_DEVICE_COUNTS)])){deviceEnergy=num(h(H_DEVICE_ENERGY)+2*id);includeTemperature(h(H_DEVICE_THERMAL),id,low,high);}
  for(int i=0;i<8;i++)totals[128*i+lane]=q[i];scalars[lane]=v;scalars[128+lane]=low;scalars[256+lane]=high;scalars[384+lane]=deviceEnergy;barrier();
  for(int stride=64;stride>0;stride>>=1){if(lane<stride){for(int i=0;i<8;i++)totals[128*i+lane]=sum(totals[128*i+lane],totals[128*i+lane+stride]);
   scalars[lane]+=scalars[lane+stride];scalars[128+lane]=min(scalars[128+lane],scalars[128+lane+stride]);scalars[256+lane]=max(scalars[256+lane],scalars[256+lane+stride]);scalars[384+lane]+=scalars[384+lane+stride];}barrier();}
  if(lane==0){for(int i=0;i<8;i++)integer(128+24*group+2*i,totals[128*i]);for(int i=0;i<4;i++)store(128+24*group+16+2*i,scalars[128*i]);}return;
 }
 if(lane<8){uint64_t value=0ul;for(int g=0;g<p.groups;g++){int a=128+24*g+2*lane;value=sum(value,uint64_t(outWords[a])|(uint64_t(outWords[a+1])<<32));}integer(64+2*(lane+O_LIQUID_MASS),value);}
 if(lane<4){double value=lane==1?1.0/0.0:lane==2?-1.0/0.0:0.0;for(int g=0;g<p.groups;g++){double x=outnum(128+24*g+16+2*lane);value=lane==1?min(value,x):lane==2?max(value,x):value+x;}
  store(64+2*(lane==0?O_VOLUME:lane==1?O_MIN_TEMPERATURE:lane==2?O_MAX_TEMPERATURE:O_DEVICE_ENERGY),value);}
 if(lane==0){integer(64+2*O_PARTICLES,h(H_GRAIN_COUNTS)<0?0ul:uint64_t(words[h(H_GRAIN_COUNTS)]));integer(64+2*O_DEPOSITS,h(H_GRAIN_COUNTS)<0?0ul:uint64_t(words[h(H_GRAIN_COUNTS)+1]));integer(64+2*O_COHERENT_GROUPS,h(H_COHERENT_COUNTS)<0?0ul:uint64_t(words[h(H_COHERENT_COUNTS)]));
  integer(64+2*O_GAS_NODES,h(H_GAS_COUNTS)<0?0ul:uint64_t(words[h(H_GAS_COUNTS)]));integer(64+2*O_DEVICES,h(H_DEVICE_COUNTS)<0?0ul:uint64_t(words[h(H_DEVICE_COUNTS)]));integer(64+2*O_LIQUID_STOCKS,uint64_t(words[h(H_LIQUID_COUNTS)]));}
 barrier();if(lane==0)integer(64+2*O_ERROR,uint64_t(outWords[H_ERROR]));
}
