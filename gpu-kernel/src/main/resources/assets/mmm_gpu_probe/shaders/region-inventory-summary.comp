#version 450
#extension GL_ARB_gpu_shader_fp64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
// HOST_LAYOUT
const int WORKGROUP_SIZE = 128;
const int STAGE_REDUCE_ROWS = 0;
const int INVENTORY_FIELD_COUNT = 8;
const int SCALAR_FIELD_COUNT = 4;
const int PARTIAL_WORD_OFFSET = 128;
const int PARTIAL_WORD_STRIDE = 24;
const int SCALAR_WORD_OFFSET = 16;
const int OUTPUT_WORD_OFFSET = 64;
const uint64_t MAXIMUM_INVENTORY = 0x7ffffffffffffffful;
const uint ERROR_INVALID_INVENTORY = 1u;
const uint ERROR_INVALID_TEMPERATURE = 2u;
const double KILOGRAMS_PER_MASS_UNIT = 1e-10;
layout(local_size_x=128) in;
layout(binding=0,std430) readonly buffer Source { uint words[]; };
layout(binding=1,std430) buffer Summary { uint outWords[]; };
layout(push_constant) uniform Params { int stage;int count;int groups;int unused; } params;
shared uint64_t sharedInventoryTotals[1024];shared double sharedScalarTotals[512];
int headerWord(int i){return int(outWords[i]);}int caloricField(int header,int i){return int(words[header+i]);}
double readDouble(int wordOffset){return packDouble2x32(uvec2(words[wordOffset],words[wordOffset+1]));}
double readSummaryDouble(int wordOffset){return packDouble2x32(uvec2(outWords[wordOffset],outWords[wordOffset+1]));}
uint64_t readInventory(int wordOffset){uint64_t storedValue=uint64_t(words[wordOffset])|(uint64_t(words[wordOffset+1])<<32);if(storedValue>MAXIMUM_INVENTORY){atomicOr(outWords[H_ERROR],ERROR_INVALID_INVENTORY);return 0ul;}return storedValue;}
void writeInventory(int wordOffset,uint64_t storedValue){outWords[wordOffset]=uint(storedValue);outWords[wordOffset+1]=uint(storedValue>>32);}
void writeDouble(int wordOffset,double storedValue){uvec2 packedValue=unpackDouble2x32(storedValue);outWords[wordOffset]=packedValue.x;outWords[wordOffset+1]=packedValue.y;}
uint64_t checkedSumInventory(uint64_t firstAmount,uint64_t secondAmount){if(firstAmount>MAXIMUM_INVENTORY-secondAmount){atomicOr(outWords[H_ERROR],ERROR_INVALID_INVENTORY);return 0ul;}return firstAmount+secondAmount;}
// Caloric inversion reads actual U, material and composition, including a cold-import generation.
// The tables and segment traversal are the same as the resident caloric-state producer.
double temperature(int header,int row){
 double mass=double(readInventory(caloricField(header,CAL_MASSES)+2*row))*KILOGRAMS_PER_MASS_UNIT;if(mass==0.0)return 0.0;int material=int(words[caloricField(header,CAL_MATERIALS)+row]);
 double referenceEnergy=mass*readDouble(caloricField(header,CAL_MATERIAL_REFERENCE)+2*material),energy=readDouble(caloricField(header,CAL_ENERGIES)+2*row),ethanol=0.0;
 for(int item=int(words[caloricField(header,CAL_SPECIES_OFFSETS)+row]);item<int(words[caloricField(header,CAL_SPECIES_OFFSETS)+row+1]);item++){
  int species=int(words[caloricField(header,CAL_SPECIES_HANDLES)+item]);
  if(material==caloricField(header,CAL_AQUEOUS_MATERIAL)&&species==caloricField(header,CAL_ETHANOL_SPECIES))ethanol=caloricEthanolMass(mass,double(readInventory(caloricField(header,CAL_SPECIES_AMOUNTS)+2*item)));
  uint64_t amount=readInventory(caloricField(header,CAL_SPECIES_AMOUNTS)+2*item);
  if(amount!=uint64_t(0))referenceEnergy+=double(amount)*readDouble(caloricField(header,CAL_SPECIES_REFERENCE)+2*(material*caloricField(header,CAL_SPECIES_STRIDE)+species));
 }
 int first=int(words[caloricField(header,CAL_SEGMENT_OFFSETS)+material]),last=int(words[caloricField(header,CAL_SEGMENT_OFFSETS)+material+1])-1,segment=first;
 double temperatureK=readDouble(caloricField(header,CAL_REFERENCE_TEMPERATURE)+2*material),remainingEnergy=energy-referenceEnergy;
 while(segment<last&&temperatureK>=readDouble(caloricField(header,CAL_SEGMENT_UPPER)+2*segment))segment++;
 if(remainingEnergy>=0.0){for(;;segment++){double capacity=caloricCapacity(mass,ethanol,readDouble(caloricField(header,CAL_SEGMENT_CAPACITY)+2*segment)),upper=readDouble(caloricField(header,CAL_SEGMENT_UPPER)+2*segment),segmentEnergy=(upper-temperatureK)*capacity;
  if(segment==last||remainingEnergy<segmentEnergy){temperatureK+=remainingEnergy/capacity;break;}remainingEnergy-=segmentEnergy;temperatureK=upper;}}
 else{remainingEnergy=-remainingEnergy;for(;;segment--){double capacity=caloricCapacity(mass,ethanol,readDouble(caloricField(header,CAL_SEGMENT_CAPACITY)+2*segment)),lower=segment==first?0.0:readDouble(caloricField(header,CAL_SEGMENT_UPPER)+2*(segment-1)),segmentEnergy=(temperatureK-lower)*capacity;
  if(segment==first||remainingEnergy<=segmentEnergy){temperatureK-=remainingEnergy/capacity;break;}remainingEnergy-=segmentEnergy;temperatureK=lower;}}
 if(isnan(temperatureK)||isinf(temperatureK)||temperatureK<=0.0)atomicOr(outWords[H_ERROR],ERROR_INVALID_TEMPERATURE);return temperatureK;
}
void includeTemperature(int header,int row,inout double minimumTemperatureK,inout double maximumTemperatureK){if(headerWord(H_THERMAL_BOUND)==0||header<0)return;double temperatureK=temperature(header,row);if(temperatureK>0.0){minimumTemperatureK=min(minimumTemperatureK,temperatureK);maximumTemperatureK=max(maximumTemperatureK,temperatureK);}}
void main(){int lane=int(gl_LocalInvocationID.x),workgroupIndex=int(gl_WorkGroupID.x),rowIndex=WORKGROUP_SIZE*workgroupIndex+lane;
 if(params.stage==STAGE_REDUCE_ROWS){uint64_t inventoryTotals[INVENTORY_FIELD_COUNT];for(int i=0;i<INVENTORY_FIELD_COUNT;i++)inventoryTotals[i]=0ul;double volumeM3=0.0,minimumTemperatureK=1.0/0.0,maximumTemperatureK=-1.0/0.0,deviceEnergy=0.0;
  if(rowIndex<int(words[headerWord(H_LIQUID_COUNTS)])){volumeM3=readDouble(headerWord(H_LIQUID_VOLUMES)+2*rowIndex)*readSummaryDouble(H_CELL_VOLUME);inventoryTotals[0]=readInventory(headerWord(H_LIQUID_MASS)+2*rowIndex);for(int item=int(words[headerWord(H_SPECIES_OFFSETS)+rowIndex]);item<int(words[headerWord(H_SPECIES_OFFSETS)+rowIndex+1]);item++)inventoryTotals[1]=checkedSumInventory(inventoryTotals[1],readInventory(headerWord(H_SPECIES_AMOUNTS)+2*item));includeTemperature(headerWord(H_LIQUID_THERMAL),rowIndex,minimumTemperatureK,maximumTemperatureK);}
  if(headerWord(H_GRAIN_COUNTS)>=0&&(rowIndex<headerWord(H_PARTICLE_CAPACITY)?rowIndex<int(words[headerWord(H_GRAIN_COUNTS)]):rowIndex-headerWord(H_PARTICLE_CAPACITY)<int(words[headerWord(H_GRAIN_COUNTS)+1]))){inventoryTotals[2]=readInventory(headerWord(H_GRAIN_VOLUME)+2*rowIndex);inventoryTotals[3]=readInventory(headerWord(H_GRAIN_MASS)+2*rowIndex);includeTemperature(headerWord(H_GRAIN_THERMAL),rowIndex,minimumTemperatureK,maximumTemperatureK);}
  if(headerWord(H_COHERENT_COUNTS)>=0&&rowIndex<int(words[headerWord(H_COHERENT_COUNTS)])){inventoryTotals[4]=readInventory(headerWord(H_COHERENT_VOLUME)+2*rowIndex);inventoryTotals[5]=readInventory(headerWord(H_COHERENT_MASS)+2*rowIndex);includeTemperature(headerWord(H_COHERENT_THERMAL),rowIndex,minimumTemperatureK,maximumTemperatureK);}
  if(headerWord(H_GAS_COUNTS)>=0){int nodes=int(words[headerWord(H_GAS_COUNTS)]),componentEnd=int(words[headerWord(H_GAS_COMPONENT_OFFSETS)+nodes]);if(rowIndex<componentEnd){inventoryTotals[6]=readInventory(headerWord(H_GAS_VOLUME)+2*rowIndex);inventoryTotals[7]=readInventory(headerWord(H_GAS_MASS)+2*rowIndex);}
   if(headerWord(H_THERMAL_BOUND)!=0&&rowIndex<nodes&&words[headerWord(H_GAS_COMPONENT_OFFSETS)+rowIndex]!=words[headerWord(H_GAS_COMPONENT_OFFSETS)+rowIndex+1]){double temperatureK=readDouble(headerWord(H_GAS_THERMAL)+2*(9*rowIndex));if(temperatureK>0.0){minimumTemperatureK=min(minimumTemperatureK,temperatureK);maximumTemperatureK=max(maximumTemperatureK,temperatureK);}}}
  if(headerWord(H_DEVICE_COUNTS)>=0&&rowIndex<int(words[headerWord(H_DEVICE_COUNTS)])){deviceEnergy=readDouble(headerWord(H_DEVICE_ENERGY)+2*rowIndex);includeTemperature(headerWord(H_DEVICE_THERMAL),rowIndex,minimumTemperatureK,maximumTemperatureK);}
  for(int i=0;i<INVENTORY_FIELD_COUNT;i++)sharedInventoryTotals[WORKGROUP_SIZE*i+lane]=inventoryTotals[i];sharedScalarTotals[lane]=volumeM3;sharedScalarTotals[128+lane]=minimumTemperatureK;sharedScalarTotals[256+lane]=maximumTemperatureK;sharedScalarTotals[384+lane]=deviceEnergy;barrier();
  for(int stride=WORKGROUP_SIZE/2;stride>0;stride>>=1){if(lane<stride){for(int i=0;i<INVENTORY_FIELD_COUNT;i++)sharedInventoryTotals[WORKGROUP_SIZE*i+lane]=checkedSumInventory(sharedInventoryTotals[WORKGROUP_SIZE*i+lane],sharedInventoryTotals[WORKGROUP_SIZE*i+lane+stride]);
   sharedScalarTotals[lane]+=sharedScalarTotals[lane+stride];sharedScalarTotals[128+lane]=min(sharedScalarTotals[128+lane],sharedScalarTotals[128+lane+stride]);sharedScalarTotals[256+lane]=max(sharedScalarTotals[256+lane],sharedScalarTotals[256+lane+stride]);sharedScalarTotals[384+lane]+=sharedScalarTotals[384+lane+stride];}barrier();}
  if(lane==0){for(int i=0;i<INVENTORY_FIELD_COUNT;i++)writeInventory(PARTIAL_WORD_OFFSET+PARTIAL_WORD_STRIDE*workgroupIndex+2*i,sharedInventoryTotals[WORKGROUP_SIZE*i]);for(int i=0;i<SCALAR_FIELD_COUNT;i++)writeDouble(PARTIAL_WORD_OFFSET+PARTIAL_WORD_STRIDE*workgroupIndex+SCALAR_WORD_OFFSET+2*i,sharedScalarTotals[WORKGROUP_SIZE*i]);}return;
 }
 if(lane<INVENTORY_FIELD_COUNT){uint64_t value=0ul;for(int partialGroup=0;partialGroup<params.groups;partialGroup++){int wordOffset=PARTIAL_WORD_OFFSET+PARTIAL_WORD_STRIDE*partialGroup+2*lane;value=checkedSumInventory(value,uint64_t(outWords[wordOffset])|(uint64_t(outWords[wordOffset+1])<<32));}writeInventory(OUTPUT_WORD_OFFSET+2*(lane+O_LIQUID_MASS),value);}
 if(lane<SCALAR_FIELD_COUNT){double value=lane==1?1.0/0.0:lane==2?-1.0/0.0:0.0;for(int partialGroup=0;partialGroup<params.groups;partialGroup++){double storedValue=readSummaryDouble(PARTIAL_WORD_OFFSET+PARTIAL_WORD_STRIDE*partialGroup+SCALAR_WORD_OFFSET+2*lane);value=lane==1?min(value,storedValue):lane==2?max(value,storedValue):value+storedValue;}
  writeDouble(OUTPUT_WORD_OFFSET+2*(lane==0?O_VOLUME:lane==1?O_MIN_TEMPERATURE:lane==2?O_MAX_TEMPERATURE:O_DEVICE_ENERGY),value);}
 if(lane==0){writeInventory(OUTPUT_WORD_OFFSET+2*O_PARTICLES,headerWord(H_GRAIN_COUNTS)<0?0ul:uint64_t(words[headerWord(H_GRAIN_COUNTS)]));writeInventory(OUTPUT_WORD_OFFSET+2*O_DEPOSITS,headerWord(H_GRAIN_COUNTS)<0?0ul:uint64_t(words[headerWord(H_GRAIN_COUNTS)+1]));writeInventory(OUTPUT_WORD_OFFSET+2*O_COHERENT_GROUPS,headerWord(H_COHERENT_COUNTS)<0?0ul:uint64_t(words[headerWord(H_COHERENT_COUNTS)]));
  writeInventory(OUTPUT_WORD_OFFSET+2*O_GAS_NODES,headerWord(H_GAS_COUNTS)<0?0ul:uint64_t(words[headerWord(H_GAS_COUNTS)]));writeInventory(OUTPUT_WORD_OFFSET+2*O_DEVICES,headerWord(H_DEVICE_COUNTS)<0?0ul:uint64_t(words[headerWord(H_DEVICE_COUNTS)]));writeInventory(OUTPUT_WORD_OFFSET+2*O_LIQUID_STOCKS,uint64_t(words[headerWord(H_LIQUID_COUNTS)]));}
 barrier();if(lane==0)writeInventory(OUTPUT_WORD_OFFSET+2*O_ERROR,uint64_t(outWords[H_ERROR]));
}
