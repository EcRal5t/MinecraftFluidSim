#version 450
#extension GL_ARB_gpu_shader_fp64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
layout(local_size_x=128) in;
layout(binding=0,std430) readonly buffer Source { uint words[]; };
layout(binding=1,std430) buffer Summary { uint outWords[]; };
layout(push_constant) uniform Params { int stage;int count;int groups;int unused; } p;
shared uint64_t totals[1024];shared double scalars[512];
int h(int i){return int(outWords[i]);}int ch(int header,int i){return int(words[header+i]);}
double num(int a){return packDouble2x32(uvec2(words[a],words[a+1]));}
double outnum(int a){return packDouble2x32(uvec2(outWords[a],outWords[a+1]));}
uint64_t raw(int a){uint64_t x=uint64_t(words[a])|(uint64_t(words[a+1])<<32);if(x>0x7ffffffffffffffful){atomicOr(outWords[28],1u);return 0ul;}return x;}
void integer(int a,uint64_t x){outWords[a]=uint(x);outWords[a+1]=uint(x>>32);}
void store(int a,double x){uvec2 v=unpackDouble2x32(x);outWords[a]=v.x;outWords[a+1]=v.y;}
uint64_t sum(uint64_t a,uint64_t b){if(a>0x7ffffffffffffffful-b){atomicOr(outWords[28],1u);return 0ul;}return a+b;}
// Caloric inversion reads actual U, material and composition, including a cold-import generation.
// The tables and segment traversal are the same as the resident caloric-state producer.
double temperature(int header,int row){
 double mass=double(raw(ch(header,24)+2*row))*1e-10;if(mass==0.0)return 0.0;int material=int(words[ch(header,18)+row]);
 double base=mass*num(ch(header,3)+2*material),energy=num(ch(header,25)+2*row);
 for(int item=int(words[ch(header,27)+row]);item<int(words[ch(header,27)+row+1]);item++){
  int species=int(words[ch(header,28)+item]);base+=double(raw(ch(header,29)+2*item))*num(ch(header,4)+2*(material*ch(header,2)+species));
 }
 int first=int(words[ch(header,5)+material]),last=int(words[ch(header,5)+material+1])-1,segment=first;
 double t=num(ch(header,8)+2*material),remaining=energy-base;
 while(segment<last&&t>=num(ch(header,6)+2*segment))segment++;
 if(remaining>=0.0){for(;;segment++){double capacity=mass*num(ch(header,7)+2*segment),upper=num(ch(header,6)+2*segment),span=(upper-t)*capacity;
  if(segment==last||remaining<span){t+=remaining/capacity;break;}remaining-=span;t=upper;}}
 else{remaining=-remaining;for(;;segment--){double capacity=mass*num(ch(header,7)+2*segment),lower=segment==first?0.0:num(ch(header,6)+2*(segment-1)),span=(t-lower)*capacity;
  if(segment==first||remaining<=span){t-=remaining/capacity;break;}remaining-=span;t=lower;}}
 if(isnan(t)||isinf(t)||t<=0.0)atomicOr(outWords[28],2u);return t;
}
void includeTemperature(int header,int row,inout double low,inout double high){if(h(25)==0||header<0)return;double t=temperature(header,row);if(t>0.0){low=min(low,t);high=max(high,t);}}
void main(){int lane=int(gl_LocalInvocationID.x),group=int(gl_WorkGroupID.x),id=128*group+lane;
 if(p.stage==0){uint64_t q[8];for(int i=0;i<8;i++)q[i]=0ul;double v=0.0,low=1.0/0.0,high=-1.0/0.0,deviceEnergy=0.0;
  if(id<int(words[h(2)])){v=num(h(3)+2*id)*outnum(32);q[0]=raw(h(4)+2*id);for(int item=int(words[h(5)+id]);item<int(words[h(5)+id+1]);item++)q[1]=sum(q[1],raw(h(6)+2*item));includeTemperature(h(21),id,low,high);}
  if(h(7)>=0&&(id<h(8)?id<int(words[h(7)]):id-h(8)<int(words[h(7)+1]))){q[2]=raw(h(9)+2*id);q[3]=raw(h(10)+2*id);includeTemperature(h(22),id,low,high);}
  if(h(11)>=0&&id<int(words[h(11)])){q[4]=raw(h(12)+2*id);q[5]=raw(h(13)+2*id);includeTemperature(h(23),id,low,high);}
  if(h(14)>=0){int nodes=int(words[h(14)]),componentEnd=int(words[h(15)+nodes]);if(id<componentEnd){q[6]=raw(h(16)+2*id);q[7]=raw(h(17)+2*id);}
   if(h(25)!=0&&id<nodes&&words[h(15)+id]!=words[h(15)+id+1]){double t=num(h(18)+2*(9*id));if(t>0.0){low=min(low,t);high=max(high,t);}}}
  if(h(19)>=0&&id<int(words[h(19)])){deviceEnergy=num(h(20)+2*id);includeTemperature(h(24),id,low,high);}
  for(int i=0;i<8;i++)totals[128*i+lane]=q[i];scalars[lane]=v;scalars[128+lane]=low;scalars[256+lane]=high;scalars[384+lane]=deviceEnergy;barrier();
  for(int stride=64;stride>0;stride>>=1){if(lane<stride){for(int i=0;i<8;i++)totals[128*i+lane]=sum(totals[128*i+lane],totals[128*i+lane+stride]);
   scalars[lane]+=scalars[lane+stride];scalars[128+lane]=min(scalars[128+lane],scalars[128+lane+stride]);scalars[256+lane]=max(scalars[256+lane],scalars[256+lane+stride]);scalars[384+lane]+=scalars[384+lane+stride];}barrier();}
  if(lane==0){for(int i=0;i<8;i++)integer(128+24*group+2*i,totals[128*i]);for(int i=0;i<4;i++)store(128+24*group+16+2*i,scalars[128*i]);}return;
 }
 if(lane<8){uint64_t value=0ul;for(int g=0;g<p.groups;g++){int a=128+24*g+2*lane;value=sum(value,uint64_t(outWords[a])|(uint64_t(outWords[a+1])<<32));}integer(64+2*(lane+1),value);}
 if(lane<4){double value=lane==1?1.0/0.0:lane==2?-1.0/0.0:0.0;for(int g=0;g<p.groups;g++){double x=outnum(128+24*g+16+2*lane);value=lane==1?min(value,x):lane==2?max(value,x):value+x;}
  store(64+2*(lane==0?0:lane==1?14:lane==2?15:16),value);}
 if(lane==0){integer(64+18,h(7)<0?0ul:uint64_t(words[h(7)]));integer(64+20,h(7)<0?0ul:uint64_t(words[h(7)+1]));integer(64+22,h(11)<0?0ul:uint64_t(words[h(11)]));
  integer(64+24,h(14)<0?0ul:uint64_t(words[h(14)]));integer(64+26,h(19)<0?0ul:uint64_t(words[h(19)]));integer(64+36,uint64_t(words[h(2)]));}
 barrier();if(lane==0)integer(64+34,uint64_t(outWords[28]));
}
