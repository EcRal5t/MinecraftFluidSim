 return moved*(materialReference(m)+waterSensible)
   +double(q)*double(n1)*speciesReference(m,s1)+(s2>=0?double(q)*double(n2)*speciesReference(m,s2):0.0LF);
}
int pendingIndex(int anchor,int r){return f(FIELD_PENDING_INDEX)+anchor*h(H_RULES)+r;}
void initialize(int id){
 if(id<h(H_CELLS)*h(H_RULES))words[f(FIELD_PENDING_INDEX)+id]=0xffffffffu;
 if(id<h(H_CELLS)){wr(f(FIELD_MASS_CHANGE)+2*id,0);wr(f(FIELD_PE_CHANGE)+2*id,0);wr(f(FIELD_HEAT_DEPOSIT)+2*id,0);words[f(FIELD_EMPTY_TARGET)+id]=0xffffffffu;for(int a=0;a<3;a++)wr(f(FIELD_MOMENTUM_CHANGE)+2*(3*id+a),0);}
 if(id<h(H_FACES)){wr(f(FIELD_OLD_K)+2*id,0);wr(f(FIELD_NEW_K)+2*id,0);wr(f(FIELD_FACE_P)+2*id,0);wr(f(FIELD_FACE_HEAT)+4*id,0);wr(f(FIELD_FACE_HEAT)+4*id+2,0);}
}
void indexPending(int id){
 if(id>=int(words[h(H_PENDING_COUNT)]))return;
 int anchor=int(words[h(H_PENDING_CELL)+id]),ordinal=int(words[h(H_PENDING_RULE)+id]);
 if(anchor<0||anchor>=h(H_CELLS)||words[h(H_PENDING_SUPPORT)+id]!=1u)return;
 for(int r=0;r<h(H_RULES);r++){int rule=f(FIELD_RULES)+20*r;if(int(words[rule+6])==ordinal&&int(words[h(H_PENDING_MATERIAL)+id])==int(words[rule])){words[pendingIndex(anchor,r)]=uint(id);return;}}
}
int reservePending(int anchor,int r,int material,int ordinal){
 int at=pendingIndex(anchor,r),slot=int(words[at]);if(slot>=0)return slot;
 uint n=atomicAdd(words[h(H_PENDING_COUNT)],1u);
 if(n>=uint(h(H_PENDING_CAPACITY))){atomicOr(errors,ERROR_DIFFUSION);return -1;}
 slot=int(n);words[at]=n;words[h(H_PENDING_CELL)+slot]=uint(anchor);words[h(H_PENDING_MATERIAL)+slot]=uint(material);
 words[h(H_PENDING_SUPPORT)+slot]=1u;words[h(H_PENDING_RULE)+slot]=uint(ordinal);
