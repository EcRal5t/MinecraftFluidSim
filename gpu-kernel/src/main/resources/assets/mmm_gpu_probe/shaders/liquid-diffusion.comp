layout(local_size_x=128) in;
layout(binding=0,std430) buffer Arena { uint words[]; };
layout(binding=0,std430) buffer LongArena { int64_t longs[]; };
layout(binding=1,std430) buffer Errors { uint errors; };
layout(push_constant) uniform Params { int header; int stage; int count; int parity; } p;
// SPATIAL_GRID
// HOST_LAYOUT
// PHASE_ROWS_LIBRARY
const uint ERROR_DIFFUSION=134217728u;
const int64_t MAX_LONG=int64_t(0x7fffffffffffffffUL);
int h(int n){return int(words[p.header+n]);}
int f(int n){return h(WORK_FIELDS+n);}
double rd(int at){return packDouble2x32(uvec2(words[at],words[at+1]));}
void wr(int at,double v){if(isnan(v)||isinf(v))atomicOr(errors,ERROR_DIFFUSION);uvec2 b=unpackDouble2x32(v);words[at]=b.x;words[at+1]=b.y;}
int64_t ri(int at){return int64_t(uint64_t(words[at])|(uint64_t(words[at+1])<<32));}
void wi(int at,int64_t v){words[at]=uint(v);words[at+1]=uint(uint64_t(v)>>32);}
ivec3 shape(){return gridShape();}
ivec3 xyz(int c){return gridPosition(c);}
int cell(ivec3 q){return gridCell(q);}
ivec3 unit(int a){ivec3 q=ivec3(0);q[a]=1;return q;}
int faceBase(int axis){return gridFaceOffset(axis);}
int face(ivec3 q,int axis){return gridFaceAt(q,axis);}
int cellFace(int c,int axis,int side){return gridFace(c,2*axis+side);}
void faceCells(int id,out int axis,out int a,out int b){ivec3 e=gridFaceEndpoints(id);a=e.x;b=e.y;axis=e.z;}
bool activeCell(int c){return h(H_ACTIVE_CELLS)<0||words[h(H_ACTIVE_CELLS)+c]!=0u;}
bool activeFace(int id){return h(H_ACTIVE_FACES)<0||words[h(H_ACTIVE_FACES)+id]!=0u;}
double cvelocity(int c,int axis){return .5LF*(rd(h(H_GEOMETRY)+8*cellFace(c,axis,0)+2)+rd(h(H_GEOMETRY)+8*cellFace(c,axis,1)+2));}
double materialReference(int m){int cal=h(H_CALORIC);return rd(int(words[cal+CAL_MATERIAL_REFERENCE])+2*m);}
double speciesReference(int m,int s){int cal=h(H_CALORIC);int base=int(words[cal+CAL_SPECIES_REFERENCE]),stride=int(words[cal+CAL_SPECIES_STRIDE]);return s<stride?rd(base+2*(m*stride+s)):0.0LF;}
double sensible(int row,int m){double ref=double(phaseRowMass(h(H_ROWS),row))*1e-10LF*materialReference(m);for(int s=0;s<h(H_SPECIES);s++){int64_t amount=phaseRowSpecies(h(H_ROWS),row,s);if(amount!=0l)ref+=double(amount)*speciesReference(m,s);}return phaseRowEnergy(h(H_ROWS),row)-ref;}
double carried(int row,int m,int s1,int s2,int n1,int n2,int64_t q,int64_t units){
 if(q==0l)return 0.0LF;
 int cal=h(H_CALORIC),first=int(words[int(words[cal+CAL_SEGMENT_OFFSETS])+m]),last=int(words[int(words[cal+CAL_SEGMENT_OFFSETS])+m+1])-1;
 double mass=double(phaseRowMass(h(H_ROWS),row))*1e-10LF,remaining=sensible(row,m);
 double capacity=0.0LF,t=caloricStateTemperature(cal,m,mass,0.0LF,remaining,capacity);
 double refT=rd(int(words[cal+CAL_REFERENCE_TEMPERATURE])+2*m),lo=min(refT,t),hi=max(refT,t),waterSensible=0.0;
 for(int i=first;i<=last&&lo<hi;i++){double upper=i==last?hi:min(hi,rd(int(words[cal+CAL_SEGMENT_UPPER])+2*i));if(upper>lo){waterSensible+=(upper-lo)*rd(int(words[cal+CAL_SEGMENT_CAPACITY])+2*i);lo=upper;}}
 if(t<refT)waterSensible=-waterSensible;
