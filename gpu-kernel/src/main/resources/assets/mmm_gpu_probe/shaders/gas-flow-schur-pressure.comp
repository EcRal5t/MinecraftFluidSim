#version 450
#extension GL_ARB_gpu_shader_fp64 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_ballot : require
layout(local_size_x = 128) in;
layout(binding = 0, std430) buffer Arena {
    uint words[];
};
layout(binding = 1, std430) buffer Errors {
    uint errors;
};
layout(push_constant) uniform Params {
    int header;
    int stage;
    int count;
    int unused;
    double duration;
    double ambient;
}
p;
// HOST_LAYOUT
shared dvec4 partial[128];
shared ivec2 firstPeers[128];
shared double solution[256], pivot;
int h(int i) {
    return int(words[p.header + i]);
}
int f(int i) {
    return h(WORK_FIELDS + i);
}
int ff(int i) {
    return int(words[h(H_SOURCE_HEADER) + FLOW_FIELDS + i]);
}
int fh(int i) {
    return int(words[h(H_SOURCE_HEADER) + i]);
}
double number(int at) {
    return packDouble2x32(uvec2(words[at], words[at + 1]));
}
void put(int at, double v) {
    uvec2 b = unpackDouble2x32(v);
    words[at] = b.x;
    words[at + 1] = b.y;
}
int actual() {
    if (h(H_INDIRECT_SOURCE) != 0)
        return int(words[h(H_NODE_COUNT)]);
    int eos = fh(FLOW_H_EOS_HEADER), at = int(words[eos + GAS_FIELDS + GAS_COUNTS]);
    return int(words[at]);
}
int pairs() {
    if (h(H_INDIRECT_SOURCE) != 0)
        return int(words[h(H_PAIR_COUNT)]);
    return int(words[ff(FLOW_HASH_OFFSETS) + fh(FLOW_H_HASH_CAPACITY)]);
}
int cores() {
    return int(words[f(FIELD_CORE_OFFSETS) + h(H_NODE_CAPACITY)]);
}
int groups() {
    return int(words[f(FIELD_LIVE)]);
}
int peer(int row, int pair) {
    int a = int(words[ff(FLOW_PAIR_A) + pair]), b = int(words[ff(FLOW_PAIR_B) + pair]);
    return h(H_INDIRECT_SOURCE) != 0 ? (a == row ? b : a) : (a == row + 1 ? b : a) - 1;
}
double weight(int pair) {
    double g = number(ff(FLOW_PAIR_G) + 2 * pair);
    return h(H_INDIRECT_SOURCE) != 0 ? g : p.duration * g;
}
double sourcePressure(int row) {
    if (h(H_INDIRECT_SOURCE) != 0)
        return number(h(H_INITIAL) + 2 * row) / number(ff(FLOW_DIAGONAL_ROOT) + 2 * row);
    return number(int(words[fh(FLOW_H_EOS_HEADER) + GAS_H_STATES]) + 18 * row + 2);
}
uint lowPriority(int row) {
    uint v = uint(row);
    if (h(H_INDIRECT_SOURCE) == 0)
        return v;
    v ^= v >> 16;
    v *= 0x7feb352du;
    v ^= v >> 15;
    v *= 0x846ca68bu;
    return v ^ (v >> 16);
}
bool precedes(int a, int b) {
    uint x = lowPriority(a), y = lowPriority(b);
    return x < y || (x == y && a < b);
}
uint hashPair(uint a, uint b) {
    uint x = a * 0x9e3779b9u + b * 0x85ebca6bu;
    x ^= x >> 16;
    x *= 0x7feb352du;
    return x ^ (x >> 15);
}
double hypotStable(double a, double b) {
    double high = max(abs(a), abs(b)), low = min(abs(a), abs(b));
    if (high == 0.0)
        return 0.0;
    double q = low / high;
    return high * sqrt(1.0 + q * q);
}
dvec4 reduce(int lane, dvec4 v, bool stats) {
    partial[lane] = v;
    barrier();
    for (int k = 64; k > 0; k /= 2) {
        if (lane < k) {
            dvec4 a = partial[lane], b = partial[lane + k];
            partial[lane] = stats ? dvec4(a.x + b.x, hypotStable(a.y, b.y), max(a.z, b.z), max(a.w, b.w)) : a + b;
        }
        barrier();
    }
    dvec4 result = partial[0];
    barrier();
    return result;
}
void save(int group, dvec4 v) {
    for (int i = 0; i < 4; i++)
        put(f(FIELD_FINAL_PARTIALS) + 8 * group + 2 * i, v[i]);
}
void dispatchAt(int word, int count) {
    words[word] = uint(min(count, 65535));
    words[word + 1] = uint(max(1, (count + 65534) / 65535));
    words[word + 2] = 1u;
}
uint insertPair(int proposal, uint a, uint b) {
    uint slot = hashPair(a, b) & uint(h(H_HASH_CAPACITY) - 1);
    for (int probe = 0; probe < h(H_HASH_CAPACITY); probe++) {
        uint rep = atomicCompSwap(words[f(FIELD_HASH) + int(slot)], 0u, uint(proposal + 1));
        if (rep == 0u ||
            (words[f(FIELD_PROPOSAL_A) + int(rep) - 1] == a && words[f(FIELD_PROPOSAL_B) + int(rep) - 1] == b)) {
            if (rep == 0u) {
                uint group = atomicAdd(words[f(FIELD_LIVE)], 1u);
                words[f(FIELD_HASH_GROUP) + int(slot)] = group;
                words[f(FIELD_GROUP_A) + int(group)] = a;
                words[f(FIELD_GROUP_B) + int(group)] = b;
            }
            return slot;
        }
        slot = (slot + 1u) & uint(h(H_HASH_CAPACITY) - 1);
    }
    atomicOr(errors, 64u);
    return 0u;
}
uint reserveIncident(int address) {
    uvec4 participants = subgroupBallot(true);
    uint first = subgroupBallotFindLSB(participants);
    int sharedAddress = subgroupBroadcastFirst(address);
    uvec4 peers = subgroupBallot(address == sharedAddress);
    uint base = 0u;
    if (gl_SubgroupInvocationID == first)
        base = atomicAdd(words[address], subgroupBallotBitCount(peers));
    base = subgroupBroadcastFirst(base);
    return address == sharedAddress ? base + subgroupBallotExclusiveBitCount(peers) : atomicAdd(words[address], 1u);
}
void main() {
    int lane = int(gl_LocalInvocationID.x), group = int(gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x),
        id = 128 * group + lane, n = actual();
    if (p.stage == 0) {
        if (id < h(H_HASH_CAPACITY)) {
            words[f(FIELD_HASH) + id] = 0u;
        }
        if (id < h(H_PROPOSAL_CAPACITY)) {
            words[f(FIELD_GROUP_COUNTS) + id] = 0u;
            words[f(FIELD_GROUP_CURSORS) + id] = 0u;
            words[f(FIELD_PROPOSAL_A) + id] = 0xffffffffu;
            put(f(FIELD_PROPOSAL_G) + 2 * id, 0.0);
        }
        if (id < h(H_NODE_CAPACITY)) {
            words[f(FIELD_CORE_FLAGS) + id] = 0u;
            words[f(FIELD_ROW_COUNTS) + id] = 0u;
            words[f(FIELD_ROW_CURSORS) + id] = 0u;
            words[f(FIELD_ROWS) + id] = 0xffffffffu;
            words[f(FIELD_META) + id] = 0u;
            words[f(FIELD_META) + h(H_NODE_CAPACITY) + id] = 0u;
            put(f(FIELD_PROBLEM) + 2 * id, 0.0);
            put(f(FIELD_PROBLEM) + 2 * (h(H_NODE_CAPACITY) + id), 0.0);
            put(f(FIELD_PROBLEM) + 2 * (2 * h(H_NODE_CAPACITY) + id), 0.0);
        }
        if (id == 0) {
            words[f(FIELD_LIVE)] = 0u;
            put(f(FIELD_STATE), h(H_INDIRECT_SOURCE) != 0 ? 0.0 : p.ambient);
            for (int i = 0; i < 16; i++)
                put(f(FIELD_CONTROL) + 2 * i, 0.0);
            put(f(FIELD_PROBLEM) + 6 * h(H_NODE_CAPACITY),
                h(H_INDIRECT_SOURCE) != 0 ? number(h(H_TARGET)) : number(ff(FLOW_PROBLEM) + 6 * h(H_NODE_CAPACITY)));
        }
        return;
    }
    if (errors != 0u)
        return;
    if (p.stage == 22) {
        if (id < h(H_NODE_CAPACITY)) {
            words[ff(FLOW_NODE_COUNTS) + id] = 0u;
            words[ff(FLOW_NODE_CURSORS) + id] = 0u;
        }
        if (id < 3)
            words[ff(FLOW_LONG_COUNTS) + id] = 0u;
        return;
    }
    if (p.stage == 23) {
        if (id >= pairs() || number(ff(FLOW_PAIR_G) + 2 * id) <= 0.0)
            return;
        atomicAdd(words[ff(FLOW_NODE_COUNTS) + int(words[ff(FLOW_PAIR_A) + id])], 1u);
        atomicAdd(words[ff(FLOW_NODE_COUNTS) + int(words[ff(FLOW_PAIR_B) + id])], 1u);
        return;
    }
    if (p.stage == 24) {
        if (id >= pairs() || number(ff(FLOW_PAIR_G) + 2 * id) <= 0.0)
            return;
        int a = int(words[ff(FLOW_PAIR_A) + id]), b = int(words[ff(FLOW_PAIR_B) + id]),
            first = int(words[ff(FLOW_NODE_OFFSETS) + a] + atomicAdd(words[ff(FLOW_NODE_CURSORS) + a], 1u)),
            second = int(words[ff(FLOW_NODE_OFFSETS) + b] + atomicAdd(words[ff(FLOW_NODE_CURSORS) + b], 1u));
        words[ff(FLOW_NODE_PAIRS) + first] = uint(id);
        words[ff(FLOW_NODE_PAIRS) + second] = uint(id);
        return;
    }
    if (p.stage == 25) {
        if (id < n && int(words[ff(FLOW_NODE_OFFSETS) + id + 1]) - int(words[ff(FLOW_NODE_OFFSETS) + id]) > 128) {
            uint slot = atomicAdd(words[ff(FLOW_LONG_COUNTS)], 1u);
            words[ff(FLOW_LONG_ROWS) + int(slot)] = uint(id);
        }
        return;
    }
    if (p.stage == 26) {
        if (id == 0)
            dispatchAt(ff(FLOW_DISPATCH) + 18, int(words[ff(FLOW_LONG_COUNTS)]));
        return;
    }
    if (p.stage == 1) {
        if (id >= n)
            return;
        int length = h(H_INDIRECT_SOURCE) != 0
                         ? int(words[ff(FLOW_NODE_OFFSETS) + id + 1]) - int(words[ff(FLOW_NODE_OFFSETS) + id])
                         : int(words[ff(FLOW_STARTS) + id + 1]) - int(words[ff(FLOW_STARTS) + id]);
        if (length > 128)
            return;
        double storage = number(ff(FLOW_STORAGE) + 2 * id), soft = storage, diagonal = storage,
               rhs = h(H_INDIRECT_SOURCE) != 0 ? number(h(H_SOURCE) + 2 * id)
                                               : storage * (sourcePressure(id) - number(f(FIELD_STATE)));
        int degree = 0;
        for (int at = int(words[ff(FLOW_NODE_OFFSETS) + id]); at < int(words[ff(FLOW_NODE_OFFSETS) + id + 1]); at++) {
            int edge = int(words[ff(FLOW_NODE_PAIRS) + at]), other = peer(id, edge);
            double w = weight(edge);
            if (w <= 0.0)
                continue;
            diagonal += w;
            if (other < 0) {
                soft += w;
                rhs += w * (p.ambient - number(f(FIELD_STATE)));
            } else {
                if (degree < 2) {
                    words[f(degree == 0 ? FIELD_PEER_A : FIELD_PEER_B) + id] = uint(other);
                    put(f(degree == 0 ? FIELD_WEIGHT_A : FIELD_WEIGHT_B) + 2 * id, w);
                }
                degree++;
            }
        }
        words[f(FIELD_DEGREE) + id] = uint(degree);
        put(f(FIELD_SOFT) + 2 * id, soft);
        put(f(FIELD_SOURCE) + 2 * id, rhs);
        put(f(FIELD_DIAGONAL) + 2 * id, diagonal);
        return;
    }
    if (p.stage == 21) {
        if (group >= int(words[ff(FLOW_LONG_COUNTS)]))
            return;
        int row = int(words[ff(FLOW_LONG_ROWS) + group]), begin = int(words[ff(FLOW_NODE_OFFSETS) + row]),
            end = int(words[ff(FLOW_NODE_OFFSETS) + row + 1]);
        double storage = number(ff(FLOW_STORAGE) + 2 * row), soft = lane == 0 ? storage : 0.0, diagonal = soft,
               rhs = lane == 0 ? (h(H_INDIRECT_SOURCE) != 0 ? number(h(H_SOURCE) + 2 * row)
                                                            : storage * (sourcePressure(row) - number(f(FIELD_STATE))))
                               : 0.0;
        int degree = 0, first = 2147483647, second = 2147483647;
        for (int at = begin + lane; at < end; at += 128) {
            int edge = int(words[ff(FLOW_NODE_PAIRS) + at]), other = peer(row, edge);
            double w = weight(edge);
            if (w <= 0.0)
                continue;
            diagonal += w;
            if (other < 0) {
                soft += w;
                rhs += w * (p.ambient - number(f(FIELD_STATE)));
            } else {
                degree++;
                if (at < first) {
                    second = first;
                    first = at;
                } else if (at < second)
                    second = at;
            }
        }
        dvec4 sums = reduce(lane, dvec4(soft, rhs, diagonal, double(degree)), false);
        firstPeers[lane] = ivec2(first, second);
        barrier();
        for (int offset = 64; offset > 0; offset /= 2) {
            if (lane < offset) {
                ivec2 a = firstPeers[lane], b = firstPeers[lane + offset];
                firstPeers[lane] = ivec2(min(a.x, b.x), min(max(a.x, b.x), min(a.y, b.y)));
            }
            barrier();
        }
        if (lane == 0) {
            words[f(FIELD_DEGREE) + row] = uint(sums.w);
            put(f(FIELD_SOFT) + 2 * row, sums.x);
            put(f(FIELD_SOURCE) + 2 * row, sums.y);
            put(f(FIELD_DIAGONAL) + 2 * row, sums.z);
            for (int i = 0; i < min(2, int(sums.w)); i++) {
                int edge = int(words[ff(FLOW_NODE_PAIRS) + firstPeers[0][i]]);
                words[f(i == 0 ? FIELD_PEER_A : FIELD_PEER_B) + row] = uint(peer(row, edge));
                put(f(i == 0 ? FIELD_WEIGHT_A : FIELD_WEIGHT_B) + 2 * row, weight(edge));
            }
        }
        return;
    }
    if (p.stage == 2) {
        if (id >= n)
            return;
        int degree = int(words[f(FIELD_DEGREE) + id]);
        bool eliminate = degree <= 2;
        for (int i = 0; i < min(2, degree) && eliminate; i++) {
            int other = int(words[f(i == 0 ? FIELD_PEER_A : FIELD_PEER_B) + id]);
            if (int(words[f(FIELD_DEGREE) + other]) <= 2 && precedes(other, id))
                eliminate = false;
        }
        words[f(FIELD_ELIMINATED) + id] = eliminate ? 1u : 0u;
        words[f(FIELD_CORE_FLAGS) + id] = eliminate ? 0u : 1u;
        return;
    }
    if (p.stage == 3) {
        if (id == 0) {
            dispatchAt(f(FIELD_STATE) + 8, cores());
            put(f(FIELD_STATE) + 4, double(cores()));
        }
        if (id >= n)
            return;
        if (words[f(FIELD_CORE_FLAGS) + id] != 0u) {
            int core = int(words[f(FIELD_CORE_OFFSETS) + id]);
            words[f(FIELD_CORE_NODES) + core] = uint(id);
            words[f(FIELD_CORE_ID) + id] = uint(core);
            words[f(FIELD_ROW_COUNTS) + core] = 1u;
            words[f(FIELD_ROWS) + core] = uint(core);
        } else
            words[f(FIELD_CORE_ID) + id] = 0xffffffffu;
        return;
    }
    if (p.stage == 4) {
        if (group >= cores())
            return;
        int row = int(words[f(FIELD_CORE_NODES) + group]);
        double soft = lane == 0 ? number(f(FIELD_SOFT) + 2 * row) : 0.0,
               rhs = lane == 0 ? number(f(FIELD_SOURCE) + 2 * row) : 0.0;
        for (int at = int(words[ff(FLOW_NODE_OFFSETS) + row]) + lane; at < int(words[ff(FLOW_NODE_OFFSETS) + row + 1]);
             at += 128) {
            int edge = int(words[ff(FLOW_NODE_PAIRS) + at]), other = peer(row, edge);
            if (other >= 0 && words[f(FIELD_ELIMINATED) + other] != 0u) {
                double w = weight(edge), d = number(f(FIELD_DIAGONAL) + 2 * other);
                soft += w * (number(f(FIELD_SOFT) + 2 * other) / d);
                rhs += w * (number(f(FIELD_SOURCE) + 2 * other) / d);
            }
        }
        dvec4 sum = reduce(lane, dvec4(soft, rhs, 0.0, 0.0), false);
        if (lane == 0) {
            put(f(FIELD_CORE_SOFT) + 2 * group, sum.x);
            put(f(FIELD_CORE_SOURCE) + 2 * group, sum.y);
        }
        return;
    }
    if (p.stage == 5) {
        if (id >= h(H_PROPOSAL_CAPACITY))
            return;
        int a = -1, b = -1;
        double g = 0.0;
        if (id < h(H_PAIR_CAPACITY)) {
            if (id < pairs()) {
                int first = int(words[ff(FLOW_PAIR_A) + id]) - (h(H_INDIRECT_SOURCE) != 0 ? 0 : 1),
                    second = int(words[ff(FLOW_PAIR_B) + id]) - (h(H_INDIRECT_SOURCE) != 0 ? 0 : 1);
                if (first >= 0 && second >= 0 && words[f(FIELD_ELIMINATED) + first] == 0u &&
                    words[f(FIELD_ELIMINATED) + second] == 0u) {
                    a = int(words[f(FIELD_CORE_ID) + first]);
                    b = int(words[f(FIELD_CORE_ID) + second]);
                    g = weight(id);
                }
            }
        } else {
            int row = id - h(H_PAIR_CAPACITY);
            if (row < n && words[f(FIELD_ELIMINATED) + row] != 0u && words[f(FIELD_DEGREE) + row] == 2u) {
                a = int(words[f(FIELD_CORE_ID) + int(words[f(FIELD_PEER_A) + row])]);
                b = int(words[f(FIELD_CORE_ID) + int(words[f(FIELD_PEER_B) + row])]);
                g = number(f(FIELD_WEIGHT_A) + 2 * row) *
                    (number(f(FIELD_WEIGHT_B) + 2 * row) / number(f(FIELD_DIAGONAL) + 2 * row));
            }
        }
        if (a > b) {
            int swap = a;
            a = b;
            b = swap;
        }
        words[f(FIELD_PROPOSAL_A) + id] = uint(a);
        words[f(FIELD_PROPOSAL_B) + id] = uint(b);
        put(f(FIELD_PROPOSAL_G) + 2 * id, g);
        return;
    }
    if (p.stage == 6) {
        if (id >= h(H_PROPOSAL_CAPACITY) || int(words[f(FIELD_PROPOSAL_A) + id]) < 0 ||
            number(f(FIELD_PROPOSAL_G) + 2 * id) <= 0.0)
            return;
        uint a = words[f(FIELD_PROPOSAL_A) + id], b = words[f(FIELD_PROPOSAL_B) + id],
             first = subgroupBallotFindLSB(subgroupBallot(true));
        uint commonA = subgroupBroadcastFirst(a), commonB = subgroupBroadcastFirst(b);
        bool sharedPair = a == commonA && b == commonB;
        uint slot = 0u;
        if (!sharedPair || gl_SubgroupInvocationID == first)
            slot = insertPair(id, a, b);
        uint sharedSlot = subgroupBroadcastFirst(slot);
        words[f(FIELD_PROPOSAL_SLOT) + id] = sharedPair ? sharedSlot : slot;
        return;
    }
    if (p.stage == 7) {
        if (id == 0) {
            dispatchAt(f(FIELD_STATE) + 12, groups());
            words[f(FIELD_STATE) + 16] = uint(cores()) | (cores() == actual() ? 0x80000000u : 0u);
            words[f(FIELD_STATE) + 17] = uint(groups());
            words[f(FIELD_STATE) + 20] = uint(cores());
            words[f(FIELD_STATE) + 21] = uint(groups());
        }
        if (id >= h(H_PROPOSAL_CAPACITY) || int(words[f(FIELD_PROPOSAL_A) + id]) < 0 ||
            number(f(FIELD_PROPOSAL_G) + 2 * id) <= 0.0)
            return;
        int index = int(words[f(FIELD_HASH_GROUP) + int(words[f(FIELD_PROPOSAL_SLOT) + id])]);
        words[f(FIELD_PROPOSAL_SLOT) + id] = uint(index);
        reserveIncident(f(FIELD_GROUP_COUNTS) + index);
        return;
    }
    if (p.stage == 8) {
        if (id >= h(H_PROPOSAL_CAPACITY) || int(words[f(FIELD_PROPOSAL_A) + id]) < 0 ||
            number(f(FIELD_PROPOSAL_G) + 2 * id) <= 0.0)
            return;
        int g = int(words[f(FIELD_PROPOSAL_SLOT) + id]),
            at = int(words[f(FIELD_GROUP_OFFSETS) + g] + reserveIncident(f(FIELD_GROUP_CURSORS) + g));
        words[f(FIELD_GROUP_PROPOSALS) + at] = uint(id);
        return;
    }
    if (p.stage == 9) {
        if (group >= groups())
            return;
        double sum = 0.0;
        for (int at = int(words[f(FIELD_GROUP_OFFSETS) + group]) + lane;
             at < int(words[f(FIELD_GROUP_OFFSETS) + group + 1]); at += 128)
            sum += number(f(FIELD_PROPOSAL_G) + 2 * int(words[f(FIELD_GROUP_PROPOSALS) + at]));
        dvec4 result = reduce(lane, dvec4(sum, 0.0, 0.0, 0.0), false);
        if (lane == 0) {
            put(f(FIELD_GROUP_G) + 2 * group, result.x);
            atomicAdd(words[f(FIELD_ROW_COUNTS) + int(words[f(FIELD_GROUP_A) + group])], 1u);
            atomicAdd(words[f(FIELD_ROW_COUNTS) + int(words[f(FIELD_GROUP_B) + group])], 1u);
        }
        return;
    }
    if (p.stage == 10) {
        if (id >= groups())
            return;
        int a = int(words[f(FIELD_GROUP_A) + id]), b = int(words[f(FIELD_GROUP_B) + id]),
            atA = int(words[f(FIELD_STARTS) + a]) + 1 + int(atomicAdd(words[f(FIELD_ROW_CURSORS) + a], 1u)),
            atB = int(words[f(FIELD_STARTS) + b]) + 1 + int(atomicAdd(words[f(FIELD_ROW_CURSORS) + b], 1u));
        double g = number(f(FIELD_GROUP_G) + 2 * id);
        words[f(FIELD_COLUMNS) + atA] = uint(b);
        words[f(FIELD_COLUMNS) + atB] = uint(a);
        put(f(FIELD_VALUES) + 2 * atA, -g);
        put(f(FIELD_VALUES) + 2 * atB, -g);
        words[f(FIELD_DEST_A) + id] = uint(atA);
        words[f(FIELD_DEST_B) + id] = uint(atB);
        return;
    }
    if (p.stage == 11) {
        if (group >= cores())
            return;
        int first = int(words[f(FIELD_STARTS) + group]), last = int(words[f(FIELD_STARTS) + group + 1]);
        double sum = lane == 0 ? number(f(FIELD_CORE_SOFT) + 2 * group) : 0.0;
        for (int at = first + 1 + lane; at < last; at += 128)
            sum -= number(f(FIELD_VALUES) + 2 * at);
        dvec4 result = reduce(lane, dvec4(sum, 0.0, 0.0, 0.0), false);
        if (lane == 0) {
            double root = sqrt(result.x);
            put(f(FIELD_CORE_ROOT) + 2 * group, root);
            words[f(FIELD_COLUMNS) + first] = uint(group);
            put(f(FIELD_VALUES) + 2 * first, 1.0);
            put(f(FIELD_PROBLEM) + 2 * group, number(f(FIELD_CORE_SOURCE) + 2 * group) / root);
            int old = int(words[f(FIELD_CORE_NODES) + group]);
            put(f(FIELD_PROBLEM) + 2 * (2 * h(H_NODE_CAPACITY) + group),
                root * (sourcePressure(old) - number(f(FIELD_STATE))));
        }
        return;
    }
    if (p.stage == 12) {
        if (id >= groups())
            return;
        int a = int(words[f(FIELD_GROUP_A) + id]), b = int(words[f(FIELD_GROUP_B) + id]);
        double g = -number(f(FIELD_GROUP_G) + 2 * id) /
                   (number(f(FIELD_CORE_ROOT) + 2 * a) * number(f(FIELD_CORE_ROOT) + 2 * b));
        put(f(FIELD_VALUES) + 2 * int(words[f(FIELD_DEST_A) + id]), g);
        put(f(FIELD_VALUES) + 2 * int(words[f(FIELD_DEST_B) + id]), g);
        return;
    }
    if (p.stage == 13) {
        if (id < h(H_DENSE_ROWS) * h(H_DENSE_ROWS))
            put(f(FIELD_DENSE) + 2 * id, 0.0);
        return;
    }
    if (p.stage == 14) {
        if (id >= cores())
            return;
        for (int at = int(words[f(FIELD_STARTS) + id]); at < int(words[f(FIELD_STARTS) + id + 1]); at++)
            put(f(FIELD_DENSE) + 2 * (h(H_DENSE_ROWS) * id + int(words[f(FIELD_COLUMNS) + at])),
                number(f(FIELD_VALUES) + 2 * at));
        return;
    }
    if (p.stage == 16) {
        int c = cores(), stride = h(H_DENSE_ROWS);
        for (int i = lane; i < c; i += 128)
            solution[i] = number(f(FIELD_PROBLEM) + 2 * i);
        barrier();
        for (int k = 0; k < c; k++) {
            if (lane == 0)
                pivot = solution[k] / number(f(FIELD_DENSE) + 2 * (stride * k + k));
            barrier();
            for (int i = k + 1 + lane; i < c; i += 128)
                solution[i] -= number(f(FIELD_DENSE) + 2 * (stride * i + k)) * pivot;
            barrier();
            if (lane == 0)
                solution[k] = pivot;
            barrier();
        }
        for (int k = c - 1; k >= 0; k--) {
            if (lane == 0)
                pivot = solution[k] / number(f(FIELD_DENSE) + 2 * (stride * k + k));
            barrier();
            for (int i = lane; i < k; i += 128)
                solution[i] -= number(f(FIELD_DENSE) + 2 * (stride * k + i)) * pivot;
            barrier();
            if (lane == 0)
                solution[k] = pivot;
            barrier();
        }
        for (int i = lane; i < c; i += 128)
            put(f(FIELD_PRESSURE) + 2 * i, solution[i]);
        return;
    }
    if (p.stage == 17) {
        double maximum = 0.0;
        if (id < n) {
            double value;
            if (words[f(FIELD_ELIMINATED) + id] == 0u) {
                int core = int(words[f(FIELD_CORE_ID) + id]);
                value = number(f(FIELD_PRESSURE) + 2 * core) / number(f(FIELD_CORE_ROOT) + 2 * core);
            } else {
                value = number(f(FIELD_SOURCE) + 2 * id);
                for (int i = 0; i < int(words[f(FIELD_DEGREE) + id]); i++) {
                    int old = int(words[f(i == 0 ? FIELD_PEER_A : FIELD_PEER_B) + id]),
                        core = int(words[f(FIELD_CORE_ID) + old]);
                    value += number(f(i == 0 ? FIELD_WEIGHT_A : FIELD_WEIGHT_B) + 2 * id) *
                             (number(f(FIELD_PRESSURE) + 2 * core) / number(f(FIELD_CORE_ROOT) + 2 * core));
                }
                value /= number(f(FIELD_DIAGONAL) + 2 * id);
            }
            double result = number(ff(FLOW_DIAGONAL_ROOT) + 2 * id) * (number(f(FIELD_STATE)) + value);
            put(ff(FLOW_PRESSURE) + 2 * id, result);
            maximum = abs(result);
        }
        dvec4 stats = reduce(lane, dvec4(0.0, 0.0, 0.0, maximum), true);
        if (lane == 0)
            save(group, stats);
        return;
    }
    if (p.stage == 18) {
        double maximum = 0.0;
        for (int i = lane; i < (n + 127) / 128; i += 128)
            maximum = max(maximum, number(f(FIELD_FINAL_PARTIALS) + 8 * i + 6));
        dvec4 stats = reduce(lane, dvec4(0.0, 0.0, 0.0, maximum), true);
        if (lane == 0) {
            put(f(FIELD_CONTROL) + 22, stats.w);
            put(f(FIELD_CONTROL) + 14, 1.0);
        }
        return;
    }
    if (p.stage == 19) {
        double r = 0.0, bound = 0.0;
        if (id < n) {
            double rhs = number(ff(FLOW_PROBLEM) + 2 * id);
            r = rhs - number(ff(FLOW_WORK) + 2 * (2 * h(H_NODE_CAPACITY) + id));
            bound = abs(rhs) + 2.0 * number(f(FIELD_CONTROL) + 22);
        }
        dvec4 stats = reduce(lane, dvec4(r * r, bound, 0.0, 0.0), true);
        if (lane == 0)
            save(group, stats);
        return;
    }
    if (p.stage == 20) {
        dvec4 sum = dvec4(0.0);
        for (int i = lane; i < (n + 127) / 128; i += 128) {
            sum.x += number(f(FIELD_FINAL_PARTIALS) + 8 * i);
            sum.y = hypotStable(sum.y, number(f(FIELD_FINAL_PARTIALS) + 8 * i + 2));
        }
        dvec4 stats = reduce(lane, sum, true);
        if (lane == 0) {
            double rms = sqrt(stats.x / double(max(1, n))),
                   floorValue = (double(n) + 8.0) * 1.1102230246251565e-16LF * stats.y / sqrt(double(max(1, n))),
                   tolerance = max(number(ff(FLOW_PROBLEM) + 6 * h(H_NODE_CAPACITY)), floorValue);
            bool success = !isnan(rms) && !isinf(rms) && rms <= tolerance;
            put(f(FIELD_CONTROL) + 2, rms);
            put(f(FIELD_CONTROL) + 4, success ? 1.0 : 0.0);
            put(f(FIELD_CONTROL) + 6, 0.0);
            put(f(FIELD_CONTROL) + 14, 0.0);
            put(f(FIELD_CONTROL) + 20, tolerance);
            if (!success)
                atomicOr(errors, 4u);
        }
        return;
    }
}
