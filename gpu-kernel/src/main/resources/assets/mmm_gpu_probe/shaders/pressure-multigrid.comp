#version 450
#extension GL_ARB_gpu_shader_fp64 : require

const int STAGE_BUILD_FINE = 0;
const int STAGE_BUILD_COARSE = 1;
const int STAGE_LOAD_FINE = 2;
const int STAGE_RESTRICT_RESIDUAL = 3;
const int STAGE_SOLVE_COARSE = 4;
const int STAGE_PROLONG_AND_SMOOTH = 6;
const int STAGE_STORE_CORRECTION = 7;
const int STAGE_FACTOR_COARSE = 8;
const int STAGE_INVERT_COARSE = 9;
const int STAGE_SCHEDULE_APPLY = 10;
const int STAGE_CLEAR_ACTIVE_ROWS = 11;
const int CONTROL_RUN = 3;
const double DOUBLE_EPSILON = 2.22044604925031308085e-16LF;
layout(local_size_x=128) in;
layout(binding=0,std430) readonly buffer Starts { int starts[]; };
layout(binding=1,std430) readonly buffer Columns { int columns[]; };
layout(binding=2,std430) readonly buffer Values { double values[]; };
layout(binding=3,std430) readonly buffer Rows { int rows[]; };
layout(binding=4,std430) buffer Work { double work[]; };
layout(binding=5,std430) readonly buffer Control { double control[]; };
layout(binding=6,std430) buffer Hierarchy { double hierarchy[]; };
layout(binding=7,std430) buffer Dispatch { uint dispatchWords[]; };
layout(push_constant) uniform Params {
    int topology; int schedule; int levelCount; int stage;
    int base; int peerBase; int peerTopology; int unusedY; int unusedZ; int fineCount; int pressureStride; int factor;
    int applyDispatch;
} p;
shared double coarseCorrection[64];
shared float coarseProjected[64];
const float OMEGA=0.66666666666666666667;

int spatialWord(int at){return int(dispatchWords[at]);}
// SPATIAL_ADDRESS
int count(int shape){return gridCellsAt(shape);}
int indexOf(ivec3 at,int shape){return gridCellAt(shape,at);}
ivec3 coordinate(int row,int shape){return gridPositionAt(shape,row);}
bool inside(ivec3 at,int shape){return gridCellAt(shape,at)>=0;}
ivec3 adjacent(ivec3 at,int side) { at[side/2]+=(side&1)==0?-1:1;return at; }
int matrixEntryIndex(int base,int row,int entry) { return base+7*row+entry; }
int residualIndex(int base,int n,int row) { return 2*base+14*n+row; }
int correctionIndex(int base,int n,int row) { return 2*base+15*n+row; }
int temporaryIndex(int base,int n,int row) { return 2*base+16*n+row; }
int activeBase(int base,int n){return 2*base+14*n+2*((3*n+1)/2);}
int levelDoubles(int n){return 7*n+(3*n+1)/2+(n+2)/2;}
float vectorValue(int at){return uintBitsToFloat(dispatchWords[at]);}
void writeVector(int at,float value){dispatchWords[at]=floatBitsToUint(value);}
double diagonal(int base,int row) { return hierarchy[matrixEntryIndex(base,row,0)]; }
float scaled(int base,int row,float rhs) {
    float d=float(diagonal(base,row));return d>0.0?OMEGA*rhs/d:0.0;
}
float product(int base,int shape,int row,int vectorOffset) {
    precise float result=float(diagonal(base,row))*vectorValue(vectorOffset+row);
    ivec3 at=coordinate(row,shape);
    for(int side=0;side<6;side++) {
        ivec3 next=adjacent(at,side);
        if(inside(next,shape))result+=float(hierarchy[matrixEntryIndex(base,row,side+1)])*vectorValue(vectorOffset+indexOf(next,shape));
    }
    return result;
}

void buildFine(int row) {
    for(int entry=0;entry<7;entry++)hierarchy[matrixEntryIndex(p.base,row,entry)]=0.0;
    if(rows[row]<0)return;
    ivec3 at=coordinate(row,p.topology);
    for(int edge=starts[row];edge<starts[row+1];edge++) {
        int column=columns[edge];double value=values[edge];
        if(column==row)hierarchy[matrixEntryIndex(p.base,row,0)]+=value;
        else if(column<p.fineCount&&rows[column]>=0) {
            ivec3 difference=coordinate(column,p.topology)-at;
            int axis=difference.x!=0?0:difference.y!=0?1:2;
            int side=2*axis+(difference[axis]>0?1:0);
            hierarchy[matrixEntryIndex(p.base,row,side+1)]+=value;
        }
    }
}

// Constant prolongation and summed restriction give exactly A_coarse = P^T A_fine P.
void buildCoarse(int row) {
    double entries[7];for(int entry=0;entry<7;entry++)entries[entry]=0.0;
    ivec3 at=coordinate(row,p.topology),origin=2*at;
    for(int child=0;child<8;child++) {
        ivec3 fine=origin+ivec3(child&1,(child>>1)&1,(child>>2)&1);
        if(!inside(fine,p.peerTopology))continue;
        int fineRow=indexOf(fine,p.peerTopology);
        entries[0]+=diagonal(p.peerBase,fineRow);
        for(int side=0;side<6;side++) {
            ivec3 next=adjacent(fine,side);
            if(!inside(next,p.peerTopology))continue;
            double value=hierarchy[matrixEntryIndex(p.peerBase,fineRow,side+1)];
            if(all(equal(next/2,at)))entries[0]+=value;
            else entries[side+1]+=value;
        }
    }
    for(int entry=0;entry<7;entry++)hierarchy[matrixEntryIndex(p.base,row,entry)]=entry==0?max(0.0,entries[entry]):entries[entry];
}

void loadFine(int row,int n) {
    float rhs=float(work[row]);
    writeVector(residualIndex(p.base,n,row),rhs);
    writeVector(temporaryIndex(p.base,n,row),scaled(p.base,row,rhs));
}

void restrictResidual(int row,int n) {
    ivec3 origin=2*coordinate(row,p.topology);int fineN=count(p.peerTopology);
    precise float rhs=0.0;
    for(int child=0;child<8;child++) {
        ivec3 fine=origin+ivec3(child&1,(child>>1)&1,(child>>2)&1);
        if(!inside(fine,p.peerTopology))continue;
        int fineRow=indexOf(fine,p.peerTopology);
        rhs+=vectorValue(residualIndex(p.peerBase,fineN,fineRow))-product(p.peerBase,p.peerTopology,fineRow,temporaryIndex(p.peerBase,fineN,0));
    }
    writeVector(residualIndex(p.base,n,row),rhs);
    writeVector(temporaryIndex(p.base,n,row),scaled(p.base,row,rhs));
}

// Factor the small Galerkin operator once per assembled physical matrix. The diagonal floor scales
// with the dot-product roundoff bound; it regularizes only this preconditioner, never the solve.
void factorCoarse(int row,int n){
    if(row<n){
        for(int column=0;column<n;column++)hierarchy[p.factor+row*n+column]=0.0;
        hierarchy[p.factor+row*n+row]=diagonal(p.base,row);
        ivec3 at=coordinate(row,p.topology);
        for(int side=0;side<6;side++){ivec3 next=adjacent(at,side);if(inside(next,p.topology))
            hierarchy[p.factor+row*n+indexOf(next,p.topology)]=hierarchy[matrixEntryIndex(p.base,row,side+1)];}
    }
    memoryBarrierBuffer();barrier();
    for(int column=0;column<n;column++){
        if(row==column){
            double d=diagonal(p.base,row),sum=d;
            for(int j=0;j<column;j++){double entry=hierarchy[p.factor+row*n+j];sum-=entry*entry;}
            double pivot=d>0.0?sqrt(max(sum,double(n)*DOUBLE_EPSILON*d)):1.0;
            coarseCorrection[column]=pivot;hierarchy[p.factor+row*n+column]=pivot;
        }
        memoryBarrierBuffer();barrier();
        if(row<n&&row>column){
            double sum=hierarchy[p.factor+row*n+column];
            for(int j=0;j<column;j++)sum-=hierarchy[p.factor+row*n+j]*hierarchy[p.factor+column*n+j];
            hierarchy[p.factor+row*n+column]=sum/coarseCorrection[column];
        }
        memoryBarrierBuffer();barrier();
    }
}
// Build F=L^-1 in FP64, then retain its FP32 entries. Applying F^T F preserves the
// positive factorization and needs one shared-vector barrier per V-cycle.
void invertCoarse(int row,int columnIndex,int n){
    if(row<n)coarseCorrection[row]=row==columnIndex?1.0:0.0;barrier();
    for(int column=0;column<n;column++){
        if(row==column)coarseCorrection[row]/=hierarchy[p.factor+row*n+row];barrier();
        if(row<n&&row>column)coarseCorrection[row]-=hierarchy[p.factor+row*n+column]*coarseCorrection[column];barrier();
    }
    if(row<n)writeVector(2*(p.factor+n*n)+row*n+columnIndex,float(coarseCorrection[row]));
}
void solveCoarse(int row,int n){
    int inverseBase=2*(p.factor+n*n);precise float projected=0.0;
    if(row<n)for(int column=0;column<=row;column++)
        projected+=vectorValue(inverseBase+row*n+column)*vectorValue(residualIndex(p.base,n,column));
    if(row<n)coarseProjected[row]=projected;barrier();
    if(row>=n)return;precise float result=0.0;
    for(int column=row;column<n;column++)result+=vectorValue(inverseBase+column*n+row)*coarseProjected[column];
    writeVector(correctionIndex(p.base,n,row),result);
}
void scheduleApply(){
    for(int level=0;level<p.levelCount;level++){
        int base=spatialWord(p.schedule+2*level),n=spatialWord(p.schedule+2*level+1),at=p.applyDispatch+4*level;
        dispatchWords[at]=control[CONTROL_RUN]!=0.0?uint((dispatchWords[activeBase(base,n)]+127u)/128u):0u;
        dispatchWords[at+1]=1u;dispatchWords[at+2]=1u;dispatchWords[at+3]=0u;
    }
}

float lifted(int row,int n){
    int coarseRow=indexOf(coordinate(row,p.topology)/2,p.peerTopology);
    precise float value=vectorValue(temporaryIndex(p.base,n,row))+vectorValue(correctionIndex(p.peerBase,count(p.peerTopology),coarseRow));
    return value;
}
void prolongAndSmooth(int row,int n){
    precise float current=lifted(row,n),productValue=float(diagonal(p.base,row))*current;
    ivec3 pos=coordinate(row,p.topology);
    for(int side=0;side<6;side++){
        ivec3 next=adjacent(pos,side);if(inside(next,p.topology))
            productValue+=float(hierarchy[matrixEntryIndex(p.base,row,side+1)])*lifted(indexOf(next,p.topology),n);
    }
    writeVector(correctionIndex(p.base,n,row),current+scaled(p.base,row,vectorValue(residualIndex(p.base,n,row))-productValue));
}

void main() {
    if(p.stage==STAGE_CLEAR_ACTIVE_ROWS){if(gl_GlobalInvocationID.x==0u)dispatchWords[activeBase(p.base,count(p.topology))]=0u;return;}
    if(p.stage==STAGE_SCHEDULE_APPLY){if(gl_GlobalInvocationID.x==0u)scheduleApply();return;}
    // These values are uniform over every workgroup, including the barrier-bearing coarse solve.
    if(control[CONTROL_RUN]==0.0)return;
    int row=int(gl_GlobalInvocationID.x),n=count(p.topology);
    if(p.stage==STAGE_SOLVE_COARSE){solveCoarse(row,n);return;}
    if(p.stage==STAGE_FACTOR_COARSE){factorCoarse(row,n);return;}
    if(p.stage==STAGE_INVERT_COARSE){invertCoarse(int(gl_LocalInvocationID.x),int(gl_WorkGroupID.x),n);return;}
    if(p.stage==STAGE_LOAD_FINE||p.stage==STAGE_RESTRICT_RESIDUAL||p.stage==STAGE_PROLONG_AND_SMOOTH||p.stage==STAGE_STORE_CORRECTION){int activeList=activeBase(p.base,n);if(row>=int(dispatchWords[activeList]))return;row=int(dispatchWords[activeList+1+row]);}
    if(row>=n)return;
    if(p.stage==STAGE_BUILD_FINE||p.stage==STAGE_BUILD_COARSE){
        writeVector(residualIndex(p.base,n,row),0.0);writeVector(temporaryIndex(p.base,n,row),0.0);writeVector(correctionIndex(p.base,n,row),0.0);
        if(p.stage==STAGE_BUILD_FINE){work[3*p.pressureStride+row]=0.0;buildFine(row);}else buildCoarse(row);
        if(diagonal(p.base,row)>0.0){int activeList=activeBase(p.base,n);uint slot=atomicAdd(dispatchWords[activeList],1u);dispatchWords[activeList+1+int(slot)]=uint(row);}
    }
    else if(p.stage==STAGE_LOAD_FINE)loadFine(row,n);
    else if(p.stage==STAGE_RESTRICT_RESIDUAL)restrictResidual(row,n);
    else if(p.stage==STAGE_PROLONG_AND_SMOOTH)prolongAndSmooth(row,n);
    else if(p.stage==STAGE_STORE_CORRECTION)work[3*p.pressureStride+row]=double(vectorValue(correctionIndex(p.base,n,row)));
}
