#version 450
#extension GL_ARB_gpu_shader_fp64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
const double MASS_UNIT_KG = 1e-10;
const double SOLID_VOLUME_QUANTA_PER_CELL = 16777216.0;
const int STAGE_CLEAR_FACES = 0;
const int STAGE_PARTICLE_FACES = 1;
const int STAGE_SCATTER_FACES = 2;
const int STAGE_COMPUTE_APERTURE = 3;
const int STAGE_PREPARE_DRAG = 4;
const int STAGE_CLEAR_COUPLED_TERMS = 5;
const int STAGE_INITIALIZE_ROWS = 6;
const int STAGE_FLUID_INCIDENCE = 7;
const int STAGE_PARTICLE_INCIDENCE = 8;
const int STAGE_PUBLISH_FACES = 9;
const int STAGE_PUBLISH_PARTICLES = 10;
const int STAGE_CLAMP_PRESSURE = 11;
const uint ERROR_GRANULAR_PRESSURE = 1048576u;
layout(local_size_x = 128) in;
layout(binding = 0, std430) buffer Arena {
    uint words[];
};
layout(binding = 1, std430) buffer Errors {
    uint errors;
};
layout(push_constant) uniform Params {
    int header;
    int stage;
    double cellSize;
    double duration;
    double gravity;
}
p;
// SPATIAL_GRID
// HOST_LAYOUT
int headerValue(int i) {
    return int(words[p.header + i]);
}
int sh(int f) {
    return headerValue(STATE_FIELDS + f);
}
int fieldOffset(int f) {
    return headerValue(WORK_FIELDS + f);
}
int jh(int i) {
    return int(words[headerValue(H_COUPLED_HEADER) + i]);
}
int ja(int f) {
    return jh(COUPLED_FIELDS + f);
}
int readFieldInt(int f, int i) {
    return int(words[fieldOffset(f) + i]);
}
void writeFieldInt(int f, int i, int v) {
    words[fieldOffset(f) + i] = uint(v);
}
double readDouble(int a) {
    return packDouble2x32(uvec2(words[a], words[a + 1]));
}
void writeNumber(int a, double x) {
    uvec2 v = unpackDouble2x32(x);
    words[a] = v.x;
    words[a + 1] = v.y;
}
double read(int f, int i) {
    return readDouble(fieldOffset(f) + 2 * i);
}
void write(int f, int i, double x) {
    writeNumber(fieldOffset(f) + 2 * i, x);
}
int64_t readInt64(int a) {
    return int64_t(uint64_t(words[a]) | (uint64_t(words[a + 1]) << 32));
}
double particleMass(int parcel) {
    return double(readInt64(sh(GRANULAR_MASS_UNITS) + 2 * parcel)) * MASS_UNIT_KG;
}
double face(int f, int q) {
    return readDouble(headerValue(H_FACES) + 2 * (4 * f + q));
}
void faceWrite(int f, int q, double x) {
    writeNumber(headerValue(H_FACES) + 2 * (4 * f + q), x);
}
double cell(int c, int q) {
    return readDouble(headerValue(H_CELLS) + 2 * (4 * c + q));
}
bool finite(double x) {
    return !isnan(x) && !isinf(x);
}
void reportInvalidState() {
    atomicOr(errors, ERROR_GRANULAR_PRESSURE);
}
int actual() {
    return int(words[sh(GRANULAR_COUNTS)]);
}
int nx() {
    return gridFaceCount(0);
}
int ny() {
    return gridFaceCount(1);
}
bool activeCell(int c) {
    return headerValue(H_ACTIVITY_CELLS) < 0 || words[headerValue(H_ACTIVITY_CELLS) + c] != 0u;
}
bool activeFace(int f) {
    return headerValue(H_ACTIVITY_FACES) < 0 || words[headerValue(H_ACTIVITY_FACES) + f] != 0u;
}
bool activeParticle(int parcel) {
    dvec3 x = dvec3(readDouble(sh(GRANULAR_POSITION) + 6 * parcel), readDouble(sh(GRANULAR_POSITION) + 6 * parcel + 2),
                    readDouble(sh(GRANULAR_POSITION) + 6 * parcel + 4));
    ivec3 q = clamp(ivec3(floor(x / p.cellSize)), ivec3(0), ivec3(headerValue(H_SIZE_X), headerValue(H_SIZE_Y), headerValue(H_SIZE_Z)) - 1);
    int c=gridCell(q);return c>=0&&activeCell(c);
}
ivec2 cellsOf(int f) {
    return gridFaceEndpoints(f).xy;
}
int faceAt(int axis, ivec3 c) {
    return gridFaceAt(c,axis);
}
double mixture(int cell, int quantity) {
    return readDouble(headerValue(H_MIXTURE_STATES) + 2 * (7 * cell + quantity));
}
bool pressureCell(int c) {
    return c >= 0 && activeCell(c) && cell(c, 1) > 0.0 && cell(c, 2) > 0.0;
}
int pressureRow(int c) { return pressureCell(c) ? c : -1; }
void term(int e, int row, int velocity, double coefficient) {
    if (row < 0 || coefficient == 0.0)
        return;
    words[ja(COUPLED_TERM_ROW) + e] = uint(row);
    words[ja(COUPLED_TERM_VELOCITY) + e] = uint(velocity);
    writeNumber(ja(COUPLED_TERM_COEFFICIENT) + 2 * e, coefficient);
}
double logDouble(double x) {
    int e;
    double m = frexp(x, e);
    if (m < .7071067811865475244LF) {
        m *= 2.0;
        e--;
    }
    double z = (m - 1.0) / (m + 1.0), square = z * z, power = z, result = z;
    for (int k = 3; k <= 25; k += 2) {
        power *= square;
        result += power / double(k);
    }
    return 2.0 * result + double(e) * .6931471805599453094LF;
}
double expDouble(double x) {
    int e = int(round(x / .6931471805599453094LF));
    double r = x - double(e) * .6931471805599453094LF, t = 1.0, result = 1.0;
    for (int k = 1; k <= 18; k++) {
        t *= r / double(k);
        result += t;
    }
    return ldexp(result, e);
}
void clearFace(int f) {
    writeFieldInt(FIELD_FACE_COUNTS, f, 0);
    writeFieldInt(FIELD_FACE_CURSORS, f, 0);
}
void particleFaces(int parcel) {
    for (int slot = 0; slot < 24; slot++) {
        writeFieldInt(FIELD_FACE_IDS, 24 * parcel + slot, -1);
        write(FIELD_FACE_SHARES, 24 * parcel + slot, 0.0);
        write(FIELD_DRAG_WEIGHTS, 24 * parcel + slot, 0.0);
    }
    if (parcel >= actual())
        return;
    dvec3 position = dvec3(readDouble(sh(GRANULAR_POSITION) + 6 * parcel), readDouble(sh(GRANULAR_POSITION) + 6 * parcel + 2),
                           readDouble(sh(GRANULAR_POSITION) + 6 * parcel + 4));
    dvec3 velocity = dvec3(readDouble(sh(GRANULAR_VELOCITY) + 6 * parcel), readDouble(sh(GRANULAR_VELOCITY) + 6 * parcel + 2),
                           readDouble(sh(GRANULAR_VELOCITY) + 6 * parcel + 4));
    write(FIELD_SOURCE_K, parcel, .5 * particleMass(parcel) * dot(velocity, velocity));
    write(FIELD_SOURCE_Y, parcel, position.y);
    for (int axis = 0; axis < 3; axis++) {
        write(FIELD_SOURCE_VELOCITY, 3 * parcel + axis, velocity[axis]);
        dvec3 grid = position / p.cellSize - .5;
        grid[axis] += .5;
        ivec3 base = ivec3(floor(grid)), dims = ivec3(headerValue(H_SIZE_X), headerValue(H_SIZE_Y), headerValue(H_SIZE_Z));
        dims[axis]++;
        dvec3 f = grid - dvec3(base);
        double total = 0.0;
        for (int slot = 0; slot < 8; slot++) {
            int e = 24 * parcel + 8 * axis + slot;
            ivec3 delta = ivec3(slot & 1, (slot >> 1) & 1, (slot >> 2) & 1), c = base + delta;
            if (any(lessThan(c, ivec3(0))) || any(greaterThanEqual(c, dims)))
                continue;
            int faceId = faceAt(axis, c);if(faceId<0)continue;
            dvec3 a = mix(1.0 - f, f, bvec3(delta));
            double weight = a.x * a.y * a.z * face(faceId, 2);
            if (weight <= 0.0)
                continue;
            writeFieldInt(FIELD_FACE_IDS, e, faceId);
            write(FIELD_FACE_SHARES, e, weight);
            write(FIELD_DRAG_WEIGHTS, e, a.x * a.y * a.z);
            total += weight;
            atomicAdd(words[fieldOffset(FIELD_FACE_COUNTS) + faceId], 1u);
        }
        if (total > 0.0)
            for (int slot = 0; slot < 8; slot++) {
                int e = 24 * parcel + 8 * axis + slot;
                write(FIELD_FACE_SHARES, e,
                      read(FIELD_FACE_SHARES, e) * double(readInt64(sh(GRANULAR_SOLID_VOLUME_SVQ) + 2 * parcel)) /
                          SOLID_VOLUME_QUANTA_PER_CELL / total);
            }
    }
}
void scatterFace(int e) {
    int f = readFieldInt(FIELD_FACE_IDS, e);
    if (f < 0)
        return;
    int slot = int(atomicAdd(words[fieldOffset(FIELD_FACE_CURSORS) + f], 1u));
    writeFieldInt(FIELD_FACE_ENTRIES, readFieldInt(FIELD_FACE_OFFSETS, f) + slot, e);
}
void aperture(int f) {
    double total = 0.0;
    for (int i = readFieldInt(FIELD_FACE_OFFSETS, f); i < readFieldInt(FIELD_FACE_OFFSETS, f + 1); i++)
        total += read(FIELD_FACE_SHARES, readFieldInt(FIELD_FACE_ENTRIES, i));
    write(FIELD_FACE_SOLID_VOLUME, f, total);
    ivec2 c = cellsOf(f);
    double pore = 0.0, geometric = face(f, 2);
    if (c.x >= 0 && c.y >= 0) {
        double a = double(bitCount((~words[headerValue(H_MASKS) + c.x]) & 255u)) * .125,
               b = double(bitCount((~words[headerValue(H_MASKS) + c.y]) & 255u)) * .125;
        double x = double(readInt64(headerValue(H_FIXED_SVQ) + 2 * c.x)) / SOLID_VOLUME_QUANTA_PER_CELL,
               y = double(readInt64(headerValue(H_FIXED_SVQ) + 2 * c.y)) / SOLID_VOLUME_QUANTA_PER_CELL;
        double fraction = (a > 0.0 && b > 0.0 && x < a && y < b) ? clamp((x + y) / (a + b), 0.0, 1.0) : 1.0;
        pore = max(0.0, geometric * (1.0 - fraction) -
                            (headerValue(H_ENTITY_FACE_AREA) < 0 ? 0.0 : readDouble(headerValue(H_ENTITY_FACE_AREA) + 2 * f)));
    } else if (c.x >= 0 || c.y >= 0) {
        pore = max(0.0, geometric - (headerValue(H_ENTITY_FACE_AREA) < 0 ? 0.0 : readDouble(headerValue(H_ENTITY_FACE_AREA) + 2 * f)));
    }
    write(FIELD_FIXED_PORE, f, pore);
    double liquid = max(0.0, pore - total);
    faceWrite(f, 2, liquid);
    faceWrite(f, 3, min(face(f, 3), liquid));
}
void prepareDrag(int parcel) {
    if (parcel >= actual()) {
        write(FIELD_DRAG_RESISTANCE, parcel, 0.0);
        return;
    }
    dvec3 fluid = dvec3(0.0),
          velocity = dvec3(read(FIELD_SOURCE_VELOCITY, 3 * parcel), read(FIELD_SOURCE_VELOCITY, 3 * parcel + 1),
                           read(FIELD_SOURCE_VELOCITY, 3 * parcel + 2));
    for (int axis = 0; axis < 3; axis++) {
        double sum = 0.0;
        int last = -1;
        for (int slot = 0; slot < 8; slot++) {
            int e = 24 * parcel + 8 * axis + slot, f = readFieldInt(FIELD_FACE_IDS, e);
            double w = f >= 0 && activeFace(f) && activeParticle(parcel) && face(f, 2) > 0.0
                           ? read(FIELD_DRAG_WEIGHTS, e) * face(f, 0)
                           : 0.0;
            write(FIELD_DRAG_WEIGHTS, e, w);
            sum += w;
            if (w > 0.0)
                last = e;
        }
        double remaining = 1.0;
        for (int slot = 0; slot < 8; slot++) {
            int e = 24 * parcel + 8 * axis + slot, f = readFieldInt(FIELD_FACE_IDS, e);
            double w = read(FIELD_DRAG_WEIGHTS, e), share = w > 0.0 ? (e == last ? remaining : w / sum) : 0.0;
            write(FIELD_DRAG_WEIGHTS, e, share);
            remaining -= share;
            if (share > 0.0)
                fluid[axis] += share * face(f, 1);
        }
    }
    double wet = 0.0, density = 0.0, viscosity = 0.0, svq = double(readInt64(sh(GRANULAR_SOLID_VOLUME_SVQ) + 2 * parcel));
    for (int i = 0; i < 8; i++) {
        int c = int(words[sh(GRANULAR_SUPPORT_CELLS) + 8 * parcel + i]);
        double weight = double(readInt64(sh(GRANULAR_SUPPORT_QUOTAS) + 2 * (8 * parcel + i))) / svq;
        if (c < 0 || weight <= 0.0 || cell(c, 0) <= 0.0 || cell(c, 2) <= 0.0 || mixture(c, Q_LIQUID_DENSITY) <= 0.0)
            continue;
        double portion = weight * min(1.0, cell(c, 0) / cell(c, 2));
        wet += portion;
        density += portion * mixture(c, Q_LIQUID_DENSITY);
        viscosity += portion * readDouble(headerValue(H_VISCOSITY) + 2 * c);
    }
    double resistance = 0.0;
    if (wet > 0.0) {
        density /= wet;
        viscosity /= wet;
        int material = int(words[sh(GRANULAR_MATERIAL) + parcel]);
        double diameter = read(FIELD_DIAMETERS, material), slip = length(velocity - fluid);
        double reynolds = density * diameter * slip / viscosity,
               factor = max(1.0 + (reynolds > 0.0 ? .15 * expDouble(.687 * logDouble(reynolds)) : 0.0),
                            .44 * reynolds / 24.0);
        double grains = (svq / 134217728.0) / (3.14159265358979323846LF * diameter * diameter * diameter / 6.0) * wet;
        resistance = 3.0 * 3.14159265358979323846LF * viscosity * diameter * grains * factor;
        if (!(finite(resistance) && resistance > 0.0)) {
            reportInvalidState();
            return;
        }
    }
    write(FIELD_DRAG_RESISTANCE, parcel, resistance);
}
void initializeRow(int row) {
    int count = headerValue(H_LIQUID_COUNT);
    bool enabled = row < count && pressureCell(row);
    double reference = enabled ? mixture(row, Q_PRESSURE) : 0.0;
    double storage = enabled ? mixture(row, Q_PRESSURE_COMPLIANCE)/(p.duration*p.duration) : 0.0;
    if (!finite(reference) || reference < 0.0 || !finite(storage) || storage < 0.0) reportInvalidState();
    if (row >= count) {
        int entry = 7 * count + row - count;
        words[jh(COUPLED_H_STARTS) + row] = uint(entry);
        words[jh(COUPLED_H_COLUMNS) + entry] = uint(row);
        writeNumber(jh(COUPLED_H_VALUES) + 2 * entry, 1.0);
        writeNumber(jh(COUPLED_H_PROBLEM) + 2 * (jh(COUPLED_H_ROW_COUNT) + row), 0.0);
    }
    if (row == jh(COUPLED_H_ROW_COUNT) - 1)
        words[jh(COUPLED_H_STARTS) + row + 1] = uint(7 * count + jh(COUPLED_H_ROW_COUNT) - count);
    writeNumber(ja(COUPLED_REFERENCE) + 2 * row, reference);
    writeNumber(ja(COUPLED_STORAGE) + 2 * row, storage);
    writeNumber(ja(COUPLED_ROW_SOURCE) + 2 * row, 0.0);
    words[ja(COUPLED_ROW_ENABLED) + row] = enabled ? 1u : 0u;
}
void fluidIncidence(int f) {
    if (!activeFace(f)) {
        writeNumber(ja(COUPLED_INVERSE_MASS) + 2 * f, 0.0);
        writeNumber(ja(COUPLED_PREDICTED_VELOCITY) + 2 * f, face(f, 1));
        writeNumber(ja(COUPLED_FIXED_REFERENCE_FORCE) + 2 * f, 0.0);
        return;
    }
    ivec2 cells = cellsOf(f);
    int a = pressureRow(cells.x), b = pressureRow(cells.y);
    double coefficient = face(f, 2) / p.cellSize, mass = face(f, 0);
    term(2 * f, a, f, coefficient);
    term(2 * f + 1, b, f, -coefficient);
    double inverse = mass > 0.0 && face(f, 2) > 0.0 ? p.cellSize * p.cellSize * p.cellSize / mass : 0.0;
    writeNumber(ja(COUPLED_INVERSE_MASS) + 2 * f, inverse);
    writeNumber(ja(COUPLED_PREDICTED_VELOCITY) + 2 * f, face(f, 1));
    double exterior = 101325.0;
    writeNumber(ja(COUPLED_FIXED_REFERENCE_FORCE) + 2 * f,
                ((cells.x < 0 ? exterior : 0.0) - (cells.y < 0 ? exterior : 0.0)) * coefficient);
}
void particleIncidence(int parcel) {
    for (int axis = 0; axis < 3; axis++) {
        int velocity = headerValue(H_FACE_COUNT) + 3 * parcel + axis,
            dragRow = headerValue(H_LIQUID_COUNT) + 3 * parcel + axis;
        writeNumber(ja(COUPLED_INVERSE_MASS) + 2 * velocity, 0.0);
        writeNumber(ja(COUPLED_PREDICTED_VELOCITY) + 2 * velocity, 0.0);
        writeNumber(ja(COUPLED_FIXED_REFERENCE_FORCE) + 2 * velocity, 0.0);
        if (parcel >= actual() || !activeParticle(parcel))
            continue;
        double mass = particleMass(parcel), inverse = p.cellSize * p.cellSize * p.cellSize / mass, affine = 0.0;
        writeNumber(ja(COUPLED_INVERSE_MASS) + 2 * velocity, inverse);
        writeNumber(ja(COUPLED_PREDICTED_VELOCITY) + 2 * velocity,
                    read(FIELD_SOURCE_VELOCITY, 3 * parcel + axis) - (axis == 1 ? p.gravity * p.duration : 0.0));
        int row[16], count = 0;
        double coefficient[16];
        for (int slot = 0; slot < 8; slot++) {
            int e = 24 * parcel + 8 * axis + slot, f = readFieldInt(FIELD_FACE_IDS, e);
            if (f < 0 || !activeFace(f))
                continue;
            ivec2 c = cellsOf(f);
            double volume = read(FIELD_FACE_SOLID_VOLUME, f),
                   area = volume > 0.0 ? min(read(FIELD_FIXED_PORE, f), volume) * read(FIELD_FACE_SHARES, e) / volume
                                       : 0.0;
            if (area == 0.0)
                continue;
            for (int side = 0; side < 2; side++) {
                int r = pressureRow(c[side]);
                double value = (side == 0 ? 1.0 : -1.0) * area / p.cellSize;
                if (r < 0) {
                    if (c[side] < 0) affine += value * 101325.0;
                    continue;
                }
                int index = -1;
                for (int i = 0; i < count; i++)
                    if (row[i] == r)
                        index = i;
                if (index < 0) {
                    index = count++;
                    row[index] = r;
                    coefficient[index] = 0.0;
                }
                coefficient[index] += value;
            }
        }
        int base = 2 * headerValue(H_FACE_COUNT) + 75 * parcel + 25 * axis;
        for (int i = 0; i < count; i++) {
            term(base + i, row[i], velocity, coefficient[i]);
            if (coefficient[i] != 0.0)
                atomicOr(words[ja(COUPLED_ROW_ENABLED) + row[i]], 1u);
        }
        writeNumber(ja(COUPLED_FIXED_REFERENCE_FORCE) + 2 * velocity, affine);
        bool hasCarrier = false;
        for (int slot = 0; slot < 8; slot++)
            if (read(FIELD_DRAG_WEIGHTS, 24 * parcel + 8 * axis + slot) > 0.0)
                hasCarrier = true;
        double resistance = read(FIELD_DRAG_RESISTANCE, parcel);
        if (resistance > 0.0 && hasCarrier) {
            words[ja(COUPLED_ROW_ENABLED) + dragRow] = 1u;
            writeNumber(ja(COUPLED_STORAGE) + 2 * dragRow, p.cellSize / (p.duration * resistance));
            for (int slot = 0; slot < 8; slot++) {
                int e = 24 * parcel + 8 * axis + slot;
                double w = read(FIELD_DRAG_WEIGHTS, e);
                if (w > 0.0)
                    term(base + 16 + slot, dragRow, readFieldInt(FIELD_FACE_IDS, e), -w / p.cellSize);
            }
            term(base + 24, dragRow, velocity, 1.0 / p.cellSize);
        }
    }
}
void publishFace(int f) {
    if (!activeFace(f))
        return;
    double v = readDouble(ja(COUPLED_PROJECTED_VELOCITY) + 2 * f);
    faceWrite(f, 1, v);
}
void publishParticle(int parcel) {
    if (parcel >= actual())
        return;
    if (!activeParticle(parcel)) {
        write(FIELD_PROJECTED_K, parcel, read(FIELD_SOURCE_K, parcel));
        write(FIELD_FINAL_K, parcel, read(FIELD_SOURCE_K, parcel));
        write(FIELD_FINAL_Y, parcel, read(FIELD_SOURCE_Y, parcel));
        write(FIELD_DRAG_HEAT, parcel, 0.0);
        for (int axis = 0; axis < 3; axis++)
            write(FIELD_DRAG_IMPULSE, 3 * parcel + axis, 0.0);
        return;
    }
    double kinetic = 0.0, slipSquared = 0.0;
    for (int axis = 0; axis < 3; axis++) {
        int velocity = headerValue(H_FACE_COUNT) + 3 * parcel + axis,
            row = headerValue(H_LIQUID_COUNT) + 3 * parcel + axis;
        double v = readDouble(ja(COUPLED_PROJECTED_VELOCITY) + 2 * velocity), carrier = 0.0;
        writeNumber(sh(GRANULAR_VELOCITY) + 2 * (3 * parcel + axis), v);
        kinetic += v * v;
        for (int slot = 0; slot < 8; slot++) {
            int e = 24 * parcel + 8 * axis + slot;
            double w = read(FIELD_DRAG_WEIGHTS, e);
            if (w > 0.0)
                carrier += w * readDouble(ja(COUPLED_PROJECTED_VELOCITY) + 2 * readFieldInt(FIELD_FACE_IDS, e));
        }
        double slip = v - carrier;
        if (words[ja(COUPLED_ROW_ENABLED) + row] != 0u)
            slipSquared += slip * slip;
        write(FIELD_DRAG_IMPULSE, 3 * parcel + axis,
              p.duration * p.cellSize * p.cellSize * readDouble(jh(COUPLED_H_PRESSURE) + 2 * row));
    }
    write(FIELD_PROJECTED_K, parcel, .5 * particleMass(parcel) * kinetic);
    write(FIELD_FINAL_K, parcel, .5 * particleMass(parcel) * kinetic);
    write(FIELD_FINAL_Y, parcel, read(FIELD_SOURCE_Y, parcel));
    write(FIELD_DRAG_HEAT, parcel, p.duration * read(FIELD_DRAG_RESISTANCE, parcel) * slipSquared);
}
void main() {
    int id = int((gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x) * 128 + gl_LocalInvocationID.x);
    if (p.stage == STAGE_CLEAR_FACES && id < headerValue(H_FACE_COUNT))
        clearFace(id);
    else if (p.stage == STAGE_PARTICLE_FACES && id < headerValue(H_PARTICLE_CAPACITY))
        particleFaces(id);
    else if (p.stage == STAGE_SCATTER_FACES && id < 24 * headerValue(H_PARTICLE_CAPACITY))
        scatterFace(id);
    else if (p.stage == STAGE_COMPUTE_APERTURE && id < headerValue(H_FACE_COUNT))
        aperture(id);
    else if (p.stage == STAGE_PREPARE_DRAG && id < headerValue(H_PARTICLE_CAPACITY))
        prepareDrag(id);
    else if (p.stage == STAGE_CLEAR_COUPLED_TERMS && id < jh(COUPLED_H_TERM_COUNT))
        words[ja(COUPLED_TERM_ROW) + id] = uint(-1);
    else if (p.stage == STAGE_INITIALIZE_ROWS && id < jh(COUPLED_H_ROW_COUNT))
        initializeRow(id);
    else if (p.stage == STAGE_FLUID_INCIDENCE && id < headerValue(H_FACE_COUNT))
        fluidIncidence(id);
    else if (p.stage == STAGE_PARTICLE_INCIDENCE && id < headerValue(H_PARTICLE_CAPACITY))
        particleIncidence(id);
    else if (p.stage == STAGE_PUBLISH_FACES && id < headerValue(H_FACE_COUNT))
        publishFace(id);
    else if (p.stage == STAGE_PUBLISH_PARTICLES && id < headerValue(H_PARTICLE_CAPACITY))
        publishParticle(id);
    else if (p.stage == STAGE_CLAMP_PRESSURE && id < headerValue(H_LIQUID_COUNT) && pressureCell(id)) {
        double reference = mixture(id, Q_PRESSURE), increment = readDouble(jh(COUPLED_H_PRESSURE) + 2 * id);
        writeNumber(jh(COUPLED_H_PRESSURE) + 2 * id, clamp(increment, -reference, MIXTURE_PRESSURE_LIMIT-reference));
    }
}
