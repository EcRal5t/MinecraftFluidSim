#version 450
#extension GL_ARB_gpu_shader_fp64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

const uint ERROR_INVALID_QUANTITY = 32u;
const uint ERROR_INSUFFICIENT_CAPACITY = 64u;
const double MASS_UNIT_KG = 1e-10LF;
const int ROUTE_COUNT = 7;
layout(local_size_x = 128) in;
layout(binding = 0, std430) readonly buffer Source {
    uint sourceWords[];
};
layout(binding = 1, std430) buffer Candidate {
    uint candidateWords[];
};
layout(binding = 2, std430) buffer Errors {
    uint errors;
};
layout(push_constant) uniform Params {
    int header;
    int stage;
    int count;
}
p;
// HOST_LAYOUT

int h(int index) {
    return int(candidateWords[p.header + index]);
}
int src(int field) {
    return h(SOURCE_FIELDS + field);
}
int route(int field) {
    return h(ROUTE_FIELDS + field);
}
int routeIndex(int stock, int part) {
    int first = int(candidateWords[route(ROUTE_SOURCE_OFFSETS) + stock]);
    return first + part < int(candidateWords[route(ROUTE_SOURCE_OFFSETS) + stock + 1]) ? first + part : -1;
}
uint readWord(int bank, int index) {
    return bank == 0 ? sourceWords[index] : candidateWords[index];
}
int64_t readLong(int bank, int index) {
    return int64_t(uint64_t(readWord(bank, index)) | (uint64_t(readWord(bank, index + 1)) << 32));
}
double readDouble(int bank, int index) {
    return packDouble2x32(uvec2(readWord(bank, index), readWord(bank, index + 1)));
}
void putLong(int index, int64_t value) {
    candidateWords[index] = uint(value);
    candidateWords[index + 1] = uint(uint64_t(value) >> 32);
}
void putDouble(int index, double value) {
    uvec2 bits = unpackDouble2x32(value);
    candidateWords[index] = bits.x;
    candidateWords[index + 1] = bits.y;
}
bool finite(double value) {
    return !isnan(value) && !isinf(value);
}
struct Volume {
    int bank;
    int begin;
    int count;
    int exponent;
};
uint limb(Volume value, int index) {
    return index < 0 || index >= value.count ? 0u : readWord(value.bank, value.begin + index);
}
Volume sourceVolume(int stock) {
    int first = int(sourceWords[src(STOCK_VOLUME_OFFSETS) + stock]),
        count = int(sourceWords[src(STOCK_VOLUME_COUNTS) + stock]);
    return Volume(0, src(STOCK_VOLUME_LIMBS) + first, count, int(sourceWords[src(STOCK_VOLUME_EXPONENTS) + stock]));
}
Volume routeVolume(int entry) {
    int at = route(ROUTE_VOLUME_DESCRIPTORS) + 5 * entry;
    return Volume(int(candidateWords[at]), int(candidateWords[at + 1]), int(candidateWords[at + 2]),
                  int(candidateWords[at + 3]));
}
int64_t highest(Volume value) {
    return int64_t(value.exponent) + int64_t(32 * (value.count - 1) + findMSB(limb(value, value.count - 1)));
}
uint aligned(Volume value, int index, int minimum) {
    int64_t shift = int64_t(value.exponent) - int64_t(minimum);
    int relative = index - int(shift >> 5), bits = int(shift & int64_t(31));
    uint result = limb(value, relative) << bits;
    if (bits != 0)
        result |= limb(value, relative - 1) >> (32 - bits);
    return result;
}
bool greaterVolume(Volume left, Volume right) {
    int64_t a = highest(left), b = highest(right);
    if (a != b)
        return a > b;
    int minimum = min(left.exponent, right.exponent), top = int((a - int64_t(minimum)) >> 5);
    for (int i = top; i >= 0; i--) {
        uint x = aligned(left, i, minimum), y = aligned(right, i, minimum);
        if (x != y)
            return x > y;
    }
    return false;
}
double normalizedHead(Volume value) {
    return double(limb(value, value.count - 1)) +
           double(limb(value, value.count - 2)) * 2.3283064365386962890625e-10LF +
           double(limb(value, value.count - 3)) * 5.4210108624275221700372640043497e-20LF;
}
double volumeFraction(Volume part, Volume whole) {
    int64_t power = int64_t(part.exponent) - int64_t(whole.exponent) + int64_t(32 * (part.count - whole.count));
    if (power < int64_t(-1106))
        return 0.0;
    if (power > int64_t(1106))
        return 1.0;
    return clamp(ldexp(normalizedHead(part) / normalizedHead(whole), int(power)), 0.0LF, 1.0LF);
}

int volumeFractions(int stock, out double fractions[ROUTE_COUNT], out bool enabled[ROUTE_COUNT]) {
    Volume whole = sourceVolume(stock);
    int owner = -1;
    if (whole.count == 0)
        return -1;
    for (int i = 0; i < ROUTE_COUNT; i++) {
        int entry = routeIndex(stock, i),
            sign = entry < 0 ? 0 : int(candidateWords[route(ROUTE_VOLUME_DESCRIPTORS) + 5 * entry + 4]);
        enabled[i] = sign > 0;
        fractions[i] = 0.0;
        if (sign < 0)
            atomicOr(errors, ERROR_INVALID_QUANTITY);
        if (enabled[i]) {
            Volume part = routeVolume(entry);
            if (owner < 0 || greaterVolume(part, routeVolume(routeIndex(stock, owner))))
                owner = i;
            fractions[i] = volumeFraction(part, whole);
        }
    }
    if (owner < 0)
        atomicOr(errors, ERROR_INVALID_QUANTITY);
    return owner;
}

int64_t share(int64_t total, double fraction, int64_t remaining) {
    precise double amount = double(total) * fraction;
    if (amount >= 9223372036854775808.0LF)
        return remaining;
    return min(remaining, int64_t(max(0.0LF, amount)));
}
void distribute(int64_t total, double fractions[ROUTE_COUNT], int owner, out int64_t amounts[ROUTE_COUNT]) {
    int64_t remaining = total;
    for (int i = 0; i < ROUTE_COUNT; i++)
        if (i != owner) {
            amounts[i] = share(total, fractions[i], remaining);
            remaining -= amounts[i];
        }
    amounts[owner] = remaining;
}

int massFractions(int stock, int volumeOwner, double volumeShares[ROUTE_COUNT], bool enabled[ROUTE_COUNT], out int64_t masses[ROUTE_COUNT],
                  out double fractions[ROUTE_COUNT]) {
    int64_t total = readLong(0, src(STOCK_MASS_UNITS) + 2 * stock);
    if (total < int64_t(0)) {
        atomicOr(errors, ERROR_INVALID_QUANTITY);
        return -1;
    }
    distribute(total, volumeShares, volumeOwner, masses);
    int owner = volumeOwner;
    if (total > int64_t(0))
        for (int i = 0; i < ROUTE_COUNT; i++)
            if (masses[i] > masses[owner])
                owner = i;
    for (int i = 0; i < ROUTE_COUNT; i++) {
        fractions[i] = total == int64_t(0) ? volumeShares[i] : double(masses[i]) / double(total);
        if (routeIndex(stock, i) >= 0) {
            putLong(route(ROUTE_MASS_UNITS) + 2 * (routeIndex(stock, i)), masses[i]);
            candidateWords[route(ROUTE_MIXTURE_PRESENT) + routeIndex(stock, i)] =
                enabled[i] ? sourceWords[src(STOCK_MIXTURE_PRESENT) + stock] : 0u;
        }
    }
    return owner;
}

// Grow an ascending, nonoverlapping expansion using error-free TwoSum; at most eight inputs are added.
void expand(inout double terms[8], inout int count, double value) {
    precise double current = value;
    int nextCount = 0;
    for (int i = 0; i < count; i++) {
        precise double other = terms[i];
        precise double next = current + other;
        precise double virtualValue = next - current;
        precise double error = (current - (next - virtualValue)) + (other - virtualValue);
        if (error != 0.0)
            terms[nextCount++] = error;
        current = next;
    }
    if (current != 0.0)
        terms[nextCount++] = current;
    count = nextCount;
}

void writeQuantities(int stock) {
    for (int i = 0; i < 8; i++)
        putDouble(h(H_ENERGY_REMAINDERS) + 16 * stock + 2 * i, 0.0);
    uint required = uint(ROUTE_COUNT) * sourceWords[src(STOCK_COUNTS) + 1];
    if (stock == 0)
        candidateWords[h(H_SPECIES_REQUIRED)] = required;
    if (required > uint(h(H_SPECIES_CAPACITY))) {
        atomicOr(errors, ERROR_INSUFFICIENT_CAPACITY);
        return;
    }
    if (uint(stock) >= sourceWords[src(STOCK_COUNTS)])
        return;
    double volumeShares[ROUTE_COUNT], fractions[ROUTE_COUNT];
    bool enabled[ROUTE_COUNT];
    int64_t masses[ROUTE_COUNT];
    int volumeOwner = volumeFractions(stock, volumeShares, enabled);
    if (volumeOwner < 0)
        return;
    int owner = massFractions(stock, volumeOwner, volumeShares, enabled, masses, fractions);
    if (owner < 0)
        return;
    int64_t totalMass = readLong(0, src(STOCK_MASS_UNITS) + 2 * stock);
    int material = int(sourceWords[src(STOCK_MATERIALS) + stock]);
    double materialReference = readDouble(1, h(H_MATERIAL_REFERENCE) + 2 * material);
    precise double sourceReference = double(totalMass) * MASS_UNIT_KG * materialReference;
    precise double references[ROUTE_COUNT];
    for (int i = 0; i < ROUTE_COUNT; i++) {
        references[i] = double(masses[i]) * MASS_UNIT_KG * materialReference;
    }
    int begin = int(sourceWords[src(STOCK_SPECIES_OFFSETS) + stock]),
        end = int(sourceWords[src(STOCK_SPECIES_OFFSETS) + stock + 1]);
    for (int entry = begin; entry < end; entry++) {
        int handle = int(sourceWords[src(STOCK_SPECIES_HANDLES) + entry]);
        int64_t total = readLong(0, src(STOCK_SPECIES_AMOUNTS) + 2 * entry);
        if (total < int64_t(0)) {
            atomicOr(errors, ERROR_INVALID_QUANTITY);
            return;
        }
        int64_t amounts[ROUTE_COUNT];
        distribute(total, fractions, owner, amounts);
        double reference = readDouble(1, h(H_SPECIES_REFERENCE) + 2 * (material * h(H_SPECIES_STRIDE) + handle));
        if (total != 0l) sourceReference += double(total) * reference;
        uint mask = candidateWords[route(ROUTE_SOURCE_MASKS) + stock];
        for (int dir = 0; dir < ROUTE_COUNT; dir++)
            if ((mask & (1u << dir)) == 0u)
                putLong(route(ROUTE_SPECIES_AMOUNTS) + 2 * (ROUTE_COUNT * entry + dir), 0l);
        // i is a compact volume part; fixed species amounts are indexed by its real spatial direction.
        for (int i = 0; i < ROUTE_COUNT; i++) {
            int part = routeIndex(stock, i);
            if (part < 0)
                continue;
            int dir = int(candidateWords[route(ROUTE_SLOTS) + part]);
            putLong(route(ROUTE_SPECIES_AMOUNTS) + 2 * (ROUTE_COUNT * entry + dir), amounts[i]);
            if (amounts[i] > int64_t(0))
                references[i] += double(amounts[i]) * reference;
        }
    }
    double sourceEnergy = readDouble(0, src(STOCK_ENERGY_BITS) + 2 * stock);
    precise double sensible = sourceEnergy - sourceReference;
    precise double energies[ROUTE_COUNT];
    for (int i = 0; i < ROUTE_COUNT; i++)
        energies[i] = 0.0;
    if (totalMass > int64_t(0)) {
        precise double sum = 0.0, error = 0.0;
        for (int i = 0; i < ROUTE_COUNT; i++)
            if (i != owner) {
                if (masses[i] > int64_t(0))
                    energies[i] = references[i] + sensible * fractions[i];
                precise double corrected = energies[i] - error, next = sum + corrected;
                error = (next - sum) - corrected;
                sum = next;
            }
        energies[owner] = sourceEnergy - sum;
    }
    bool valid = finite(sourceEnergy) && finite(sourceReference);
    for (int i = 0; i < ROUTE_COUNT; i++) {
        valid = valid && finite(energies[i]);
        if (routeIndex(stock, i) >= 0)
            putDouble(route(ROUTE_ENERGY_BITS) + 2 * routeIndex(stock, i), energies[i]);
    }
    if (!valid) {
        atomicOr(errors, ERROR_INVALID_QUANTITY);
        return;
    }
    precise double remainders[8];
    int count = 0;
    for (int i = 0; i < ROUTE_COUNT; i++)
        expand(remainders, count, energies[i]);
    expand(remainders, count, -sourceEnergy);
    for (int i = 0; i < 8; i++)
        putDouble(h(H_ENERGY_REMAINDERS) + 16 * stock + 2 * i, i < count ? remainders[i] : 0.0);
}

void main() {
    int index = int((gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x) * 128u + gl_LocalInvocationID.x);
    if (index >= p.count || errors != 0u)
        return;
    writeQuantities(index);
}
