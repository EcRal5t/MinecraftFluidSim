#version 450
#extension GL_ARB_gpu_shader_fp64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
// HOST_LAYOUT
const int DISPLAY_SPECIES_COUNT = 4;
const int DISPLAY_BUCKET_COUNT = 5;
const int OTHER_SPECIES_BUCKET = 4;
const int PARTICLE_SUPPORT_COUNT = 8;
const int GAS_THERMAL_WORD_STRIDE = 18;
const int GAS_DISPLAY_WORD_STRIDE = 3;
const int CHEMICAL_DISPLAY_WORD_STRIDE = 4;
const uint MISSING_TEMPERATURE = 65535u;
const uint MISSING_PH = 255u;
const int MATERIAL_PHASE_MASK = 65535;
const int MATERIAL_AQUEOUS_FLAG = 65536;
const double TEMPERATURE_ENCODING_SCALE = 16.0;
const double MINIMUM_ENCODED_TEMPERATURE = 1.0;
const double MAXIMUM_ENCODED_TEMPERATURE = 65534.0;
const double MAXIMUM_ENCODED_FRACTION = 255.0;
const int FRACTION_UNIT_COUNT = 255;
const double SOLID_VOLUME_QUANTA_PER_CELL = 16777216.0;
const double ATMOSPHERIC_PRESSURE_PA = 101325.0;
const double PASCALS_PER_DISPLAY_UNIT = 10.0;
const double CHEMICAL_QUANTA_PER_MOLE = 1e6;
const double CUBIC_METRES_PER_LITRE = 1e-3;
const double NEUTRAL_PH = 7.0;
const double PH_ENCODING_SCALE = 10.0;
layout(local_size_x=128)in;
layout(binding=0,std430)readonly buffer Arena{uint sourceWords[];};
layout(binding=1,std430)buffer Display{uint displayWords[];};
layout(push_constant)uniform Params{int count;int unused;double cellVolume;}params;
int headerWord(int i){return int(displayWords[i]);}
int64_t readInteger(int a){return int64_t(uint64_t(sourceWords[a])|(uint64_t(sourceWords[a+1])<<32));}
double readDouble(int a){return packDouble2x32(uvec2(sourceWords[a],sourceWords[a+1]));}
uint encodeTemperature(double temperatureK){return uint(clamp(floor(temperatureK*TEMPERATURE_ENCODING_SCALE+.5),MINIMUM_ENCODED_TEMPERATURE,MAXIMUM_ENCODED_TEMPERATURE));}
void main(){int cellIndex=int(gl_GlobalInvocationID.x);
 if(cellIndex<headerWord(H_CELLS)){
  int first=int(sourceWords[headerWord(H_CELL_OFFSETS)+cellIndex]),end=int(sourceWords[headerWord(H_CELL_OFFSETS)+cellIndex+1]);
  if(headerWord(H_SPECIES_COUNT)>0){double largestAmounts[DISPLAY_SPECIES_COUNT];int largestSpecies[DISPLAY_SPECIES_COUNT];for(int i=0;i<DISPLAY_SPECIES_COUNT;i++){largestAmounts[i]=0.0;largestSpecies[i]=-1;}double total=0.0;
   for(int speciesIndex=0;speciesIndex<headerWord(H_SPECIES_COUNT);speciesIndex++){double amount=0.0;for(int rowIndex=first;rowIndex<end;rowIndex++)for(int speciesEntry=int(sourceWords[headerWord(H_SPECIES_OFFSETS)+rowIndex]);speciesEntry<int(sourceWords[headerWord(H_SPECIES_OFFSETS)+rowIndex+1]);speciesEntry++)if(int(sourceWords[headerWord(H_SPECIES_HANDLES)+speciesEntry])==speciesIndex)amount+=double(readInteger(headerWord(H_SPECIES_AMOUNTS)+2*speciesEntry));
    total+=amount;if(amount<=0.0)continue;for(int i=0;i<DISPLAY_SPECIES_COUNT;i++)if(amount>largestAmounts[i]){for(int j=DISPLAY_SPECIES_COUNT-1;j>i;j--){largestAmounts[j]=largestAmounts[j-1];largestSpecies[j]=largestSpecies[j-1];}largestAmounts[i]=amount;largestSpecies[i]=speciesIndex;break;}}
   double buckets[DISPLAY_BUCKET_COUNT],fractionRemainders[DISPLAY_BUCKET_COUNT];int encodedFractions[DISPLAY_BUCKET_COUNT];double otherSpeciesAmount=total;for(int i=0;i<DISPLAY_SPECIES_COUNT;i++){buckets[i]=largestAmounts[i];otherSpeciesAmount-=largestAmounts[i];}buckets[OTHER_SPECIES_BUCKET]=max(0.0,otherSpeciesAmount);int assigned=0;
   for(int i=0;i<DISPLAY_BUCKET_COUNT;i++){double scaledFraction=total>0.0?MAXIMUM_ENCODED_FRACTION*buckets[i]/total:0.0;encodedFractions[i]=int(floor(scaledFraction));assigned+=encodedFractions[i];fractionRemainders[i]=scaledFraction-double(encodedFractions[i]);}
   for(int k=assigned;k<FRACTION_UNIT_COUNT&&total>0.0;k++){int best=0;for(int i=1;i<DISPLAY_BUCKET_COUNT;i++)if(fractionRemainders[i]>fractionRemainders[best])best=i;encodedFractions[best]++;fractionRemainders[best]=-1.0;}
   int outputOffset=headerWord(H_CHEMICAL_OUTPUT)+CHEMICAL_DISPLAY_WORD_STRIDE*cellIndex;displayWords[outputOffset]=(uint(largestSpecies[0])&65535u)|(uint(largestSpecies[1])<<16);displayWords[outputOffset+1]=(uint(largestSpecies[2])&65535u)|(uint(largestSpecies[3])<<16);
   displayWords[outputOffset+2]=uint(encodedFractions[0])|(uint(encodedFractions[1])<<8)|(uint(encodedFractions[2])<<16)|(uint(encodedFractions[3])<<24);displayWords[outputOffset+3]=uint(encodedFractions[OTHER_SPECIES_BUCKET]);
   for(int phase=0;phase<headerWord(H_PHASE_COUNT);phase++){double volume=0.0,acid=0.0,base=0.0;
    for(int rowIndex=first;rowIndex<end;rowIndex++){int table=int(displayWords[headerWord(H_MATERIAL_TABLE)+int(sourceWords[headerWord(H_MATERIALS)+rowIndex])]);if((table&MATERIAL_PHASE_MASK)!=phase||(table&MATERIAL_AQUEOUS_FLAG)==0)continue;volume+=readDouble(headerWord(H_VOLUMES)+2*rowIndex)*params.cellVolume;
     for(int speciesEntry=int(sourceWords[headerWord(H_SPECIES_OFFSETS)+rowIndex]);speciesEntry<int(sourceWords[headerWord(H_SPECIES_OFFSETS)+rowIndex+1]);speciesEntry++){int species=int(sourceWords[headerWord(H_SPECIES_HANDLES)+speciesEntry]);if(species==headerWord(H_HYDROGEN))acid+=double(readInteger(headerWord(H_SPECIES_AMOUNTS)+2*speciesEntry));if(species==headerWord(H_HYDROXIDE))base+=double(readInteger(headerWord(H_SPECIES_AMOUNTS)+2*speciesEntry));}}
    uint encodedPh=MISSING_PH;if(volume>0.0){double strength=min(NEUTRAL_PH,double(log(float(1.0+abs(acid-base)/(CHEMICAL_QUANTA_PER_MOLE*CUBIC_METRES_PER_LITRE*volume))))/log(10.0));encodedPh=uint(floor(PH_ENCODING_SCALE*(acid>=base?NEUTRAL_PH-strength:NEUTRAL_PH+strength)+.5));}displayWords[headerWord(H_PH_OUTPUT)+phase*headerWord(H_CELLS)+cellIndex]=encodedPh;
   }
  }
  if(headerWord(H_LIQUID_TEMPERATURE)>=0){double heatCapacity=readDouble(headerWord(H_LIQUID_CAPACITY)+2*cellIndex),temperatureMoment=heatCapacity*readDouble(headerWord(H_LIQUID_TEMPERATURE)+2*cellIndex),coherentVolumeSvq=0.0;
   if(headerWord(H_COHERENT_OFFSETS)>=0)for(int memberIndex=int(sourceWords[headerWord(H_COHERENT_OFFSETS)+cellIndex]);memberIndex<int(sourceWords[headerWord(H_COHERENT_OFFSETS)+cellIndex+1]);memberIndex++){int rowIndex=int(sourceWords[headerWord(H_COHERENT_MEMBERS)+memberIndex]);double carrierHeatCapacity=readDouble(headerWord(H_COHERENT_CAPACITY)+2*rowIndex);heatCapacity+=carrierHeatCapacity;temperatureMoment+=carrierHeatCapacity*readDouble(headerWord(H_COHERENT_TEMPERATURE)+2*rowIndex);coherentVolumeSvq+=double(readInteger(headerWord(H_COHERENT_VOLUME)+2*rowIndex));}
   if(headerWord(H_GRAIN_OFFSETS)>=0)for(int memberIndex=int(sourceWords[headerWord(H_GRAIN_OFFSETS)+cellIndex]);memberIndex<int(sourceWords[headerWord(H_GRAIN_OFFSETS)+cellIndex+1]);memberIndex++){int entry=int(sourceWords[headerWord(H_GRAIN_ENTRIES)+memberIndex]);bool isParticleSupport=entry<PARTICLE_SUPPORT_COUNT*headerWord(H_PARTICLE_CAPACITY);int row=isParticleSupport?entry/PARTICLE_SUPPORT_COUNT:headerWord(H_PARTICLE_CAPACITY)+entry-PARTICLE_SUPPORT_COUNT*headerWord(H_PARTICLE_CAPACITY);double fraction=isParticleSupport?double(readInteger(headerWord(H_GRAIN_SUPPORT)+2*entry))/double(readInteger(headerWord(H_GRAIN_VOLUME)+2*row)):1.0;double carrierHeatCapacity=readDouble(headerWord(H_GRAIN_CAPACITY)+2*row)*fraction;heatCapacity+=carrierHeatCapacity;temperatureMoment+=carrierHeatCapacity*readDouble(headerWord(H_GRAIN_TEMPERATURE)+2*row);}
   uint flags=(heatCapacity>0.0?1u:0u)|(coherentVolumeSvq>0.0?2u:0u);displayWords[headerWord(H_THERMAL_OUTPUT)+cellIndex]=(heatCapacity>0.0?encodeTemperature(temperatureMoment/heatCapacity):MISSING_TEMPERATURE)|(uint(clamp(floor(MAXIMUM_ENCODED_FRACTION*coherentVolumeSvq/SOLID_VOLUME_QUANTA_PER_CELL+.5),0.0,255.0))<<16)|(flags<<24);
  }
 }
 if(headerWord(H_GAS_COUNTS)>=0&&cellIndex<headerWord(H_GAS_CAPACITY)){int outputOffset=headerWord(H_GAS_OUTPUT)+GAS_DISPLAY_WORD_STRIDE*cellIndex;if(cellIndex<int(sourceWords[headerWord(H_GAS_COUNTS)])){displayWords[outputOffset]=8u*uint(cellIndex);displayWords[outputOffset+1]=encodeTemperature(readDouble(headerWord(H_GAS_THERMAL)+GAS_THERMAL_WORD_STRIDE*cellIndex));displayWords[outputOffset+2]=uint(int(clamp(floor((readDouble(headerWord(H_GAS_THERMAL)+GAS_THERMAL_WORD_STRIDE*cellIndex+2)-ATMOSPHERIC_PRESSURE_PA)/PASCALS_PER_DISPLAY_UNIT+.5),-2147483648.0,2147483647.0)));}else{displayWords[outputOffset]=0u;displayWords[outputOffset+1]=0u;displayWords[outputOffset+2]=0u;}}
}
