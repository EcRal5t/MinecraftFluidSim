layout(push_constant,std430) uniform Params {
    int stage; int nx; int ny; int nz;
    int particleCount; int iteration; int pressureIterations; int flags;
    float dt; float h; float gravity; float rho; int solver;
    int levelNx; int levelNy; int levelNz; int levelOffset;
    int otherNx; int otherNy; int otherNz; int otherOffset; int mgPackedCount; float pressureTolerance;
} pc;

int cellCount() { return pc.nx * pc.ny * pc.nz; }
int coarseNx() { return (pc.nx + 1) / 2; }
int coarseNy() { return (pc.ny + 1) / 2; }
int coarseNz() { return (pc.nz + 1) / 2; }
int coarseCount() { return coarseNx() * coarseNy() * coarseNz(); }
int uCount() { return (pc.nx + 1) * pc.ny * pc.nz; }
int vCount() { return pc.nx * (pc.ny + 1) * pc.nz; }
int wCount() { return pc.nx * pc.ny * (pc.nz + 1); }
bool insideCell(ivec3 c) { return all(greaterThanEqual(c, ivec3(0))) && all(lessThan(c, ivec3(pc.nx,pc.ny,pc.nz))); }
int ci(ivec3 c) { return c.x + pc.nx * (c.y + pc.ny * c.z); }
bool insideCoarse(ivec3 c) { return all(greaterThanEqual(c, ivec3(0))) && all(lessThan(c, ivec3(coarseNx(),coarseNy(),coarseNz()))); }
int coarseCi(ivec3 c) { return c.x + coarseNx() * (c.y + coarseNy() * c.z); }
int ui(ivec3 f) { return f.x + (pc.nx + 1) * (f.y + pc.ny * f.z); }
int vi(ivec3 f) { return f.x + pc.nx * (f.y + (pc.ny + 1) * f.z); }
int wi(ivec3 f) { return f.x + pc.nx * (f.y + pc.ny * f.z); }
bool fluid(ivec3 c) { return insideCell(c) && solids.value[ci(c)] == 0u && pressureFluid.value[ci(c)] != 0u; }
bool solid(ivec3 c) { return !insideCell(c) || solids.value[ci(c)] != 0u; }
bool coarseFluid(ivec3 c) { return insideCoarse(c) && (coarseMask.value[coarseCi(c)] & 1u) != 0u; }
ivec3 mghCurrentDims() { return ivec3(pc.levelNx,pc.levelNy,pc.levelNz); }
ivec3 mghOtherDims() { return ivec3(pc.otherNx,pc.otherNy,pc.otherNz); }
bool mghCurrentInside(ivec3 c) { return all(greaterThanEqual(c,ivec3(0)))&&all(lessThan(c,mghCurrentDims())); }
bool mghOtherInside(ivec3 c) { return all(greaterThanEqual(c,ivec3(0)))&&all(lessThan(c,mghOtherDims())); }
int mghCurrentCi(ivec3 c) { return pc.levelOffset+c.x+pc.levelNx*(c.y+pc.levelNy*c.z); }
int mghOtherCi(ivec3 c) { return pc.otherOffset+c.x+pc.otherNx*(c.y+pc.otherNy*c.z); }
bool mghCurrentFluid(ivec3 c) { return mghCurrentInside(c)&&(coarseMask.value[mghCurrentCi(c)]&1u)!=0u; }
bool mghOtherFluid(ivec3 c) { return mghOtherInside(c)&&(coarseMask.value[mghOtherCi(c)]&1u)!=0u; }
bool validU(ivec3 f) { return f.x > 0 && f.x < pc.nx && f.y >= 0 && f.y < pc.ny && f.z >= 0 && f.z < pc.nz && !solid(f + ivec3(-1,0,0)) && !solid(f); }
bool validV(ivec3 f) { return f.y > 0 && f.y < pc.ny && f.x >= 0 && f.x < pc.nx && f.z >= 0 && f.z < pc.nz && !solid(f + ivec3(0,-1,0)) && !solid(f); }
bool validW(ivec3 f) { return f.z > 0 && f.z < pc.nz && f.x >= 0 && f.x < pc.nx && f.y >= 0 && f.y < pc.ny && !solid(f + ivec3(0,0,-1)) && !solid(f); }

float triWeight(ivec3 corner, vec3 p) {
    vec3 d = abs(p - vec3(corner));
    return max(0.0, 1.0-d.x) * max(0.0, 1.0-d.y) * max(0.0, 1.0-d.z);
}

void splatDensity(vec3 q, float volume) {
    ivec3 base = ivec3(floor(q)); float sum = 0.0;
    for (int z=0;z<2;z++) for(int y=0;y<2;y++) for(int x=0;x<2;x++) {
        ivec3 c=base+ivec3(x,y,z); if(insideCell(c) && !solid(c)) sum += triWeight(c,q);
    }
    if(sum<=0.0) return;
    for (int z=0;z<2;z++) for(int y=0;y<2;y++) for(int x=0;x<2;x++) {
        ivec3 c=base+ivec3(x,y,z); if(insideCell(c) && !solid(c)) atomicAdd(density.value[ci(c)], volume*triWeight(c,q)/sum);
    }
}

float pressureKernelWeight(float coordinate,int cell) {
    float distance=abs(coordinate-(float(cell)+0.5));if(distance<=0.25)return 1.0;if(distance>=0.75)return 0.0;
    float transition=(distance-0.25)*2.0;return 1.0-transition*transition*(3.0-2.0*transition);
}
void splatPressureVolume(vec3 q,float volume) {
    ivec3 center=ivec3(floor(q));ivec3 neighbor=ivec3(q.x-float(center.x)<0.5?center.x-1:center.x+1,q.y-float(center.y)<0.5?center.y-1:center.y+1,q.z-float(center.z)<0.5?center.z-1:center.z+1);
    float centerX=pressureKernelWeight(q.x,center.x),centerY=pressureKernelWeight(q.y,center.y),centerZ=pressureKernelWeight(q.z,center.z);
    float neighborX=pressureKernelWeight(q.x,neighbor.x),neighborY=pressureKernelWeight(q.y,neighbor.y),neighborZ=pressureKernelWeight(q.z,neighbor.z);float available=0.0;
    for(int oz=0;oz<2;oz++)for(int oy=0;oy<2;oy++)for(int ox=0;ox<2;ox++){ivec3 c=ivec3(ox==0?center.x:neighbor.x,oy==0?center.y:neighbor.y,oz==0?center.z:neighbor.z);float weight=(ox==0?centerX:neighborX)*(oy==0?centerY:neighborY)*(oz==0?centerZ:neighborZ);if(insideCell(c)&&!solid(c)&&weight>0.0)available+=weight;}
    if(!(available>0.0))return;float scale=volume/available;
    for(int oz=0;oz<2;oz++)for(int oy=0;oy<2;oy++)for(int ox=0;ox<2;ox++){ivec3 c=ivec3(ox==0?center.x:neighbor.x,oy==0?center.y:neighbor.y,oz==0?center.z:neighbor.z);float weight=(ox==0?centerX:neighborX)*(oy==0?centerY:neighborY)*(oz==0?centerZ:neighborZ);if(insideCell(c)&&!solid(c)&&weight>0.0)atomicAdd(pressureVolume.value[ci(c)],weight*scale);}
}

void splatU(vec3 q,float velocity,float particleVolume) {
    ivec3 base=ivec3(floor(q)); float sum=0.0;
    for(int z=0;z<2;z++)for(int y=0;y<2;y++)for(int x=0;x<2;x++){ivec3 f=base+ivec3(x,y,z);if(validU(f))sum+=triWeight(f,q);}
    if(sum<=0.0)return;
    for(int z=0;z<2;z++)for(int y=0;y<2;y++)for(int x=0;x<2;x++){ivec3 f=base+ivec3(x,y,z);if(validU(f)){float a=particleVolume*triWeight(f,q)/sum;atomicAdd(u.value[ui(f)],velocity*a);atomicAdd(uw.value[ui(f)],a);}}
}
void splatV(vec3 q,float velocity,float particleVolume) {
    ivec3 base=ivec3(floor(q)); float sum=0.0;
    for(int z=0;z<2;z++)for(int y=0;y<2;y++)for(int x=0;x<2;x++){ivec3 f=base+ivec3(x,y,z);if(validV(f))sum+=triWeight(f,q);}
    if(sum<=0.0)return;
    for(int z=0;z<2;z++)for(int y=0;y<2;y++)for(int x=0;x<2;x++){ivec3 f=base+ivec3(x,y,z);if(validV(f)){float a=particleVolume*triWeight(f,q)/sum;atomicAdd(v.value[vi(f)],velocity*a);atomicAdd(vw.value[vi(f)],a);}}
}
void splatW(vec3 q,float velocity,float particleVolume) {
    ivec3 base=ivec3(floor(q)); float sum=0.0;
    for(int z=0;z<2;z++)for(int y=0;y<2;y++)for(int x=0;x<2;x++){ivec3 f=base+ivec3(x,y,z);if(validW(f))sum+=triWeight(f,q);}
    if(sum<=0.0)return;
    for(int z=0;z<2;z++)for(int y=0;y<2;y++)for(int x=0;x<2;x++){ivec3 f=base+ivec3(x,y,z);if(validW(f)){float a=particleVolume*triWeight(f,q)/sum;atomicAdd(w.value[wi(f)],velocity*a);atomicAdd(ww.value[wi(f)],a);}}
}

float sampleU(vec3 q,bool oldField) { ivec3 b=ivec3(floor(q));float s=0.0,a=0.0;for(int z=0;z<2;z++)for(int y=0;y<2;y++)for(int x=0;x<2;x++){ivec3 f=b+ivec3(x,y,z);if(validU(f)&&uw.value[ui(f)]>0.0){float k=triWeight(f,q);s+=(oldField?uold.value[ui(f)]:u.value[ui(f)])*k;a+=k;}}return a>0.0?s/a:0.0; }
float sampleV(vec3 q,bool oldField) { ivec3 b=ivec3(floor(q));float s=0.0,a=0.0;for(int z=0;z<2;z++)for(int y=0;y<2;y++)for(int x=0;x<2;x++){ivec3 f=b+ivec3(x,y,z);if(validV(f)&&vw.value[vi(f)]>0.0){float k=triWeight(f,q);s+=(oldField?vold.value[vi(f)]:v.value[vi(f)])*k;a+=k;}}return a>0.0?s/a:0.0; }
float sampleW(vec3 q,bool oldField) { ivec3 b=ivec3(floor(q));float s=0.0,a=0.0;for(int z=0;z<2;z++)for(int y=0;y<2;y++)for(int x=0;x<2;x++){ivec3 f=b+ivec3(x,y,z);if(validW(f)&&ww.value[wi(f)]>0.0){float k=triWeight(f,q);s+=(oldField?wold.value[wi(f)]:w.value[wi(f)])*k;a+=k;}}return a>0.0?s/a:0.0; }

bool pressureAnchor(ivec3 c){return insideCell(c)&&uint(ci(c))==pressureSolveState.value[7];}
bool pressureUnknown(ivec3 c){return fluid(c)&&!pressureAnchor(c);}
float pressureAt(ivec3 c) {
    if(!pressureUnknown(c))return 0.0;int cell=ci(c);return pc.solver==0&&((pc.pressureIterations&1)!=0)?pb.value[cell]:pa.value[cell];
}
float positiveSquare(float value){float positive=max(0.0,value);return positive*positive;}
float positiveCube(float value){float positive=max(0.0,value);return positive*positive*positive;}
float unitCubeLiquidFraction(vec3 normal,float offset){
    vec3 magnitude=abs(normal);float transformed=offset;if(normal.x<0.0)transformed+=magnitude.x;if(normal.y<0.0)transformed+=magnitude.y;if(normal.z<0.0)transformed+=magnitude.z;float result;
    if(magnitude.x>1e-10&&magnitude.y>1e-10&&magnitude.z>1e-10)result=(positiveCube(transformed)-positiveCube(transformed-magnitude.x)-positiveCube(transformed-magnitude.y)-positiveCube(transformed-magnitude.z)+positiveCube(transformed-magnitude.x-magnitude.y)+positiveCube(transformed-magnitude.x-magnitude.z)+positiveCube(transformed-magnitude.y-magnitude.z)-positiveCube(transformed-magnitude.x-magnitude.y-magnitude.z))/(6.0*magnitude.x*magnitude.y*magnitude.z);
    else if(magnitude.x>1e-10&&magnitude.y>1e-10)result=(positiveSquare(transformed)-positiveSquare(transformed-magnitude.x)-positiveSquare(transformed-magnitude.y)+positiveSquare(transformed-magnitude.x-magnitude.y))/(2.0*magnitude.x*magnitude.y);
    else if(magnitude.x>1e-10&&magnitude.z>1e-10)result=(positiveSquare(transformed)-positiveSquare(transformed-magnitude.x)-positiveSquare(transformed-magnitude.z)+positiveSquare(transformed-magnitude.x-magnitude.z))/(2.0*magnitude.x*magnitude.z);
    else if(magnitude.y>1e-10&&magnitude.z>1e-10)result=(positiveSquare(transformed)-positiveSquare(transformed-magnitude.y)-positiveSquare(transformed-magnitude.z)+positiveSquare(transformed-magnitude.y-magnitude.z))/(2.0*magnitude.y*magnitude.z);
    else{float length=max(magnitude.x,max(magnitude.y,magnitude.z));result=length<=1e-10?(transformed>=0.0?1.0:0.0):transformed/length;}return clamp(result,0.0,1.0);
}
float solvePlaneOffset(vec3 normal,float fraction){
    float minimum=min(0.0,normal.x)+min(0.0,normal.y)+min(0.0,normal.z),maximum=max(0.0,normal.x)+max(0.0,normal.y)+max(0.0,normal.z);float target=clamp(fraction,0.0,1.0);if(target<=0.0)return minimum;if(target>=1.0)return maximum;
    float lower=minimum,upper=maximum;for(int iteration=0;iteration<32;iteration++){float middle=0.5*(lower+upper);if(unitCubeLiquidFraction(normal,middle)<target)lower=middle;else upper=middle;}return 0.5*(lower+upper);
}
float pressureFraction(ivec3 c){return insideCell(c)&&!solid(c)?clamp(pressureVolume.value[ci(c)],0.0,1.0):0.0;}
float sampledPressureFraction(ivec3 c,float fallback){return !insideCell(c)||solid(c)?fallback:pressureFraction(c);}
void pressureClassifyStage(uint id){
	if(id>=uint(cellCount()))return;int ix=int(id)%pc.nx;int yz=int(id)/pc.nx;ivec3 c=ivec3(ix,yz%pc.ny,yz/pc.ny);float fraction=pressureFraction(c);vec4 geometry=interfaceGeometry.value[id];pressureFluid.value[id]=!solid(c)&&fraction>0.5&&(fraction>=1.0-1e-6||geometry.w>0.5*(geometry.x+geometry.y+geometry.z))?1u:0u;
}
void pressureGeometryStage(uint id){
	if(id>=uint(cellCount()))return;int ix=int(id)%pc.nx;int yz=int(id)/pc.nx;ivec3 c=ivec3(ix,yz%pc.ny,yz/pc.ny);interfaceGeometry.value[id]=vec4(0.0);float center=pressureFraction(c);if(solid(c)||!(center>0.0)||center>=1.0-1e-6)return;
	vec3 normal=-vec3(sampledPressureFraction(c+ivec3(1,0,0),center)-sampledPressureFraction(c+ivec3(-1,0,0),center),sampledPressureFraction(c+ivec3(0,1,0),center)-sampledPressureFraction(c+ivec3(0,-1,0),center),sampledPressureFraction(c+ivec3(0,0,1),center)-sampledPressureFraction(c+ivec3(0,0,-1),center));float lengthSquared=dot(normal,normal);
	if(lengthSquared<=1e-10){normal=vec3((insideCell(c+ivec3(1,0,0))&&!solid(c+ivec3(1,0,0))&&pressureFraction(c+ivec3(1,0,0))<=0.5?1.0:0.0)-(insideCell(c+ivec3(-1,0,0))&&!solid(c+ivec3(-1,0,0))&&pressureFraction(c+ivec3(-1,0,0))<=0.5?1.0:0.0),(insideCell(c+ivec3(0,1,0))&&!solid(c+ivec3(0,1,0))&&pressureFraction(c+ivec3(0,1,0))<=0.5?1.0:0.0)-(insideCell(c+ivec3(0,-1,0))&&!solid(c+ivec3(0,-1,0))&&pressureFraction(c+ivec3(0,-1,0))<=0.5?1.0:0.0),(insideCell(c+ivec3(0,0,1))&&!solid(c+ivec3(0,0,1))&&pressureFraction(c+ivec3(0,0,1))<=0.5?1.0:0.0)-(insideCell(c+ivec3(0,0,-1))&&!solid(c+ivec3(0,0,-1))&&pressureFraction(c+ivec3(0,0,-1))<=0.5?1.0:0.0));lengthSquared=dot(normal,normal);}
    normal=lengthSquared<=1e-10?vec3(0.0,1.0,0.0):normal*inversesqrt(lengthSquared);interfaceGeometry.value[id]=vec4(normal,solvePlaneOffset(normal,center));
}
float interfaceTheta(ivec3 fluidCell,ivec3 direction){
    int cell=ci(fluidCell);float fraction=pressureFraction(fluidCell),distance;if(fraction>=1.0-1e-6)distance=0.5;else{vec4 geometry=interfaceGeometry.value[cell];float outward=dot(geometry.xyz,vec3(direction));if(!(outward>1e-6))return 1.0;distance=(geometry.w-0.5*(geometry.x+geometry.y+geometry.z))/outward;}ivec3 neighbor=fluidCell+direction;if(insideCell(neighbor))distance+=pressureFraction(neighbor);return min(distance,1.0);
}
float pressureFaceCoefficient(ivec3 fluidCell,ivec3 neighbor){if(solid(neighbor))return 0.0;if(fluid(neighbor))return 1.0;return 1.0/interfaceTheta(fluidCell,neighbor-fluidCell);}
float pressureDifference(ivec3 first,ivec3 second,ivec3 direction){bool firstFluid=fluid(first),secondFluid=fluid(second);if(firstFluid&&secondFluid)return pressureAt(second)-pressureAt(first);if(firstFluid)return-pressureAt(first)/interfaceTheta(first,direction);return pressureAt(second)/interfaceTheta(second,-direction);}
float matrixDiagonal(ivec3 c) {
    ivec3 offsets[6]=ivec3[6](ivec3(-1,0,0),ivec3(1,0,0),ivec3(0,-1,0),ivec3(0,1,0),ivec3(0,0,-1),ivec3(0,0,1));float diagonal=0.0;
    for(int n=0;n<6;n++)diagonal+=pressureFaceCoefficient(c,c+offsets[n]);return diagonal;
}
void diagnosticAdd(uint index,float amount) {
    uint previous=diagnostics.value[index];
    for(;;){uint next=floatBitsToUint(uintBitsToFloat(previous)+amount);uint observed=atomicCompSwap(diagnostics.value[index],previous,next);if(observed==previous)return;previous=observed;}
}
void pressureSolveAdd(uint index,float amount){uint previous=pressureSolveState.value[index];for(;;){uint next=floatBitsToUint(uintBitsToFloat(previous)+amount);uint observed=atomicCompSwap(pressureSolveState.value[index],previous,next);if(observed==previous)return;previous=observed;}}
void transferStateAdd(uint index,float amount){uint previous=transferState.value[index];for(;;){uint next=floatBitsToUint(uintBitsToFloat(previous)+amount);uint observed=atomicCompSwap(transferState.value[index],previous,next);if(observed==previous)return;previous=observed;}}
bool finiteFloat(float value){return !isnan(value)&&!isinf(value);}
bool pressureSolveActive(){return pressureSolveState.value[1]==0u&&pressureSolveState.value[15]==0u;}
bool pressureVerificationActive(){return pressureSolveState.value[1]==4u&&pressureSolveState.value[15]==0u;}

void pressureStepBeginStage(uint id){if(id==0u){for(int index=0;index<16;index++)pressureSolveState.value[index]=0u;pressureSolveState.value[7]=0xffffffffu;}}
void pressureStateClearStage(uint id){if(id==0u){uint failed=pressureSolveState.value[15];for(int index=0;index<15;index++)pressureSolveState.value[index]=0u;pressureSolveState.value[7]=0xffffffffu;pressureSolveState.value[15]=failed;diagnostics.value[7]=0u;diagnostics.value[8]=0u;diagnostics.value[9]=0u;diagnostics.value[10]=0u;diagnostics.value[11]=0u;diagnostics.value[12]=0u;}}
void pressureTopologyStage(uint id){
