    if(c.x+1<pc.nx&&local.x>pc.h-radius&&solid(c+ivec3(1,0,0))){p.x=float(c.x)*pc.h+contactMaximum;vel.x=min(0.0,vel.x);}
    if(c.y>0&&local.y<radius&&solid(c+ivec3(0,-1,0))){p.y=float(c.y)*pc.h+contactMinimum;vel.y=max(0.0,vel.y);}
    if(c.y+1<pc.ny&&local.y>pc.h-radius&&solid(c+ivec3(0,1,0))){p.y=float(c.y)*pc.h+contactMaximum;vel.y=min(0.0,vel.y);}
